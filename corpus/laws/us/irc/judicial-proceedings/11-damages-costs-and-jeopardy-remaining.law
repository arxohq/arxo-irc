// Stage 2 — remaining parts of §§7429–7435: §7429(c),(e); §7430(d)-(f);
// §7431(e)-(h); §7432 (failure to release lien); §7433(c),(d)(2),(e) and
// §7433A (collection contractors); §7434 (fraudulent information
// returns); §7435 (compromise for information from tax advisers); §7426(h)
// grounds (damages action) and the payment-authority clauses common to
// §§7426(h)(3), 7430(d)(1), 7432(c), 7433(c), 7435(c).
//
// METHOD NOTE. A statutory cause of action of a private person is a
// POWER of that person whose `valid_when` folds the statutory grounds (the
// mental element is a DECISION-0194 judgment with the court as authority)
// and whose effect is the institutional "action maintainable" relation.
// "Greater of A or B" / "lesser of A or B" are two strict-comparison rules
// each (never a max/min builtin). "Payable out of funds appropriated
// under 31 U.S.C. 1304" is one institutional effect keyed to the section
// whose claim it is. Mitigation (§7433(d)(2), §7432(d)(2)) is a court
// determination of an AMOUNT: `external judgment relation` carrying a
// Money argument; the net damages are computed from it and cap rules read
// the net sum.
//
// JUDGMENT CALLS AND GAPS. "In the court's discretion, reasonable
// attorneys' fees" (§7434(b)(3)) enters as a court-determined amount.
// "Reasonable procedures" (§7432(e)) is left inside the duty's fact.
// "As soon as practicable" (§7431(e)) names no day count: the notice duty
// has an open window and can never be VIOLATED (TECH-GAPS G2902).

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7426_H,
    IRC_S7429_C,
    IRC_S7429_E,
    IRC_S7430_D,
    IRC_S7430_E,
    IRC_S7430_F,
    IRC_S7431_E,
    IRC_S7431_G,
    IRC_S7431_H,
    IRC_S7432_A,
    IRC_S7432_B,
    IRC_S7432_C,
    IRC_S7432_D,
    IRC_S7432_E,
    IRC_S7433A_A,
    IRC_S7433A_B,
    IRC_S7433_C,
    IRC_S7433_D,
    IRC_S7433_E,
    IRC_S7434_A,
    IRC_S7434_B,
    IRC_S7434_C,
    IRC_S7434_D,
    IRC_S7434_E,
    IRC_S7435_A,
    IRC_S7435_B,
    IRC_S7435_C,
    IRC_S7435_D,
    IRC_S7435_E,
    IRC_S7435_F,
    Lien,
    Notice,
    Organ,
    Person,
    Proceeding,
    collection_administrative_remedies_exhausted,
    collection_damages_claimed,
    collection_damages_suit_within_limitation,
    court_commences_proceeding,
    irs_disregard_found_in_7426_action,
    jeopardy_court_determination_made,
    jeopardy_review_suit_permitted,
};

const BankruptcyCourt: Organ = entity_ref("urn:us:irc:judicial_proceedings:clir#BankruptcyCourt") {
    label en unofficial "the bankruptcy court (a unit of the district court for the purposes of §7433(e))";
}

// ============================================================================
// §7429(c) — Extension of the 20-day determination period
// ============================================================================

pub relation taxpayer_requests_determination_extension(pr: Proceeding, p: Person) kind empirical {
    label en official "the taxpayer requests an extension of the 20-day period set forth in subsection (b)(2)";
}
external judgment relation extension_reasonable_grounds_established(pr: Proceeding, p: Person) {
    authority DistrictCourt;
    label en official "the taxpayer establishes reasonable grounds why such extension should be granted";
}
pub relation court_extends_jeopardy_determination_to(pr: Proceeding, p: Person, newDeadline: Date) kind empirical;
pub relation jeopardy_extension_within_40_days(pr: Proceeding, p: Person, newDeadline: Date) kind institutional {
    label en unofficial "the requested extension is after the 20th day and not more than 40 additional days (the 60th day) after the proceeding was commenced";
}
@source(IRC_S7429_C, relation = formalizes, coverage = exact, quote = "If the taxpayer requests an extension of the 20-day period set forth in subsection (b)(2) and establishes reasonable grounds why such extension should be granted, the court may grant an extension of not more than 40 additional days.")
pub rule S7429cExtensionGrounds defeasible {
    label en official "If the taxpayer requests an extension of the 20-day period set forth in subsection (b)(2) and establishes reasonable grounds why such extension should be granted, the court may grant an extension of not more than 40 additional days.";
    for pr: Proceeding;
    for p: Person;
    for commencedOn: Date;
    for newDeadline: Date;
    when taxpayer_requests_determination_extension(pr, p)
        and extension_reasonable_grounds_established(pr, p)
        and court_commences_proceeding(pr, commencedOn)
        and court_extends_jeopardy_determination_to(pr, p, newDeadline)
        and newDeadline > add_calendar_period(commencedOn, 20 calendar_day)
        and newDeadline <= add_calendar_period(commencedOn, 60 calendar_day);
    then jeopardy_extension_within_40_days(pr, p, newDeadline);
}
pub relation jeopardy_determination_deadline_extended(pr: Proceeding, p: Person, newDeadline: Date) kind institutional;
@source(IRC_S7429_C, relation = formalizes, coverage = exact, quote = "the court may grant an extension of not more than 40 additional days.")
pub rule S7429cExtensionPowerRule defeasible {
    label en official "the court may grant an extension of not more than 40 additional days.";
    for pr: Proceeding;
    for p: Person;
    for newDeadline: Date;
    when court_extends_jeopardy_determination_to(pr, p, newDeadline);
    then power S7429cGrantExtension {
        holder us.irc.core::DistrictCourt;
        over p;
        exercise court_extends_jeopardy_determination_to(pr, p, newDeadline);
        valid_when jeopardy_extension_within_40_days(pr, p, newDeadline);
        effect jeopardy_determination_deadline_extended(pr, p, newDeadline);
    };
}
@source(IRC_S7429_C, relation = formalizes, coverage = exact, quote = "the court may grant an extension of not more than 40 additional days.")
pub rule S7429cExtendedDeterminationDutyRule defeasible {
    label en official "the court may grant an extension of not more than 40 additional days.";
    for pr: Proceeding;
    for p: Person;
    for commencedOn: Date;
    for newDeadline: Date;
    when jeopardy_review_suit_permitted(pr, p)
        and court_commences_proceeding(pr, commencedOn)
        and jeopardy_determination_deadline_extended(pr, p, newDeadline);
    then duty S7429cCourtDeterminationDutyExtended {
        bearer us.irc.core::DistrictCourt;
        beneficiary p;
        goal achievement {
            condition jeopardy_court_determination_made(pr, newDeadline);
            window [commencedOn, newDeadline];
        }
    };
}

// ============================================================================
// §7429(e) — Venue; transfer from the Tax Court
// ============================================================================

pub relation civil_action_commenced_outside_1402a_district(pr: Proceeding, p: Person) kind empirical {
    label en official "a civil action in a district court under subsection (b) commenced in a judicial district other than the one described in section 1402(a)(1) or (2) of title 28, United States Code";
}
pub relation jeopardy_review_action_in_district_court(pr: Proceeding, p: Person) kind empirical;
@source(IRC_S7429_E, relation = formalizes, coverage = exact, quote = "A civil action in a district court under subsection (b) shall be commenced only in the judicial district described in section 1402(a)(1) or (2) of title 28, United States Code.")
pub rule S7429e1VenueProhibitionRule strict {
    label en official "A civil action in a district court under subsection (b) shall be commenced only in the judicial district described in section 1402(a)(1) or (2) of title 28, United States Code.";
    for pr: Proceeding;
    for p: Person;
    when jeopardy_review_action_in_district_court(pr, p);
    then prohibition S7429e1CommenceOnlyInProperDistrict {
        bearer p;
        action civil_action_commenced_outside_1402a_district(pr, p);
        window [-infinity, infinity];
    };
}
external judgment relation want_of_jurisdiction_under_7429b2_found(pr: Proceeding) {
    authority TaxCourt;
    label en official "such court finds that there is want of jurisdiction because of the jurisdiction provisions of subsection (b)(2)";
}
external judgment relation transfer_in_interest_of_justice(pr: Proceeding) {
    authority TaxCourt;
    label en official "such court determines it is in the interest of justice";
}
pub relation jeopardy_action_filed_with_tax_court_on(pr: Proceeding, on: Date) kind empirical;
pub relation jeopardy_action_transferred_to_district_court(pr: Proceeding) kind empirical;
pub relation tax_court_transfer_required(pr: Proceeding) kind institutional;
@source(IRC_S7429_E, relation = formalizes, coverage = exact, quote = "If a civil action is filed under subsection (b) with the Tax Court and such court finds that there is want of jurisdiction because of the jurisdiction provisions of subsection (b)(2), then the Tax Court shall, if such court determines it is in the interest of justice, transfer the civil action to the district court in which the action could have been brought at the time such action was filed.")
pub rule S7429e2TransferGrounds defeasible {
    label en official "If a civil action is filed under subsection (b) with the Tax Court and such court finds that there is want of jurisdiction because of the jurisdiction provisions of subsection (b)(2), then the Tax Court shall, if such court determines it is in the interest of justice, transfer the civil action to the district court in which the action could have been brought at the time such action was filed.";
    for pr: Proceeding;
    for filedOn: Date;
    when jeopardy_action_filed_with_tax_court_on(pr, filedOn)
        and want_of_jurisdiction_under_7429b2_found(pr)
        and transfer_in_interest_of_justice(pr);
    then tax_court_transfer_required(pr);
}
@source(IRC_S7429_E, relation = formalizes, coverage = exact, quote = "then the Tax Court shall, if such court determines it is in the interest of justice, transfer the civil action to the district court in which the action could have been brought at the time such action was filed.")
pub rule S7429e2TransferDutyRule defeasible {
    label en official "then the Tax Court shall, if such court determines it is in the interest of justice, transfer the civil action to the district court in which the action could have been brought at the time such action was filed.";
    for pr: Proceeding;
    when tax_court_transfer_required(pr);
    then duty S7429e2TransferToDistrictCourt {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition jeopardy_action_transferred_to_district_court(pr);
            window [-infinity, infinity];
        }
    };
}
pub relation transferred_action_treated_as_filed_on(pr: Proceeding, on: Date) kind institutional;
@source(IRC_S7429_E, relation = formalizes, coverage = exact, quote = "Any civil action so transferred shall proceed as if such action had been filed in the district court to which such action is transferred on the date on which such action was actually filed in the Tax Court from which such action is transferred.")
pub rule S7429e2TransferredActionFilingDate strict {
    label en official "Any civil action so transferred shall proceed as if such action had been filed in the district court to which such action is transferred on the date on which such action was actually filed in the Tax Court from which such action is transferred.";
    for pr: Proceeding;
    for filedOn: Date;
    when jeopardy_action_transferred_to_district_court(pr)
        and jeopardy_action_filed_with_tax_court_on(pr, filedOn);
    then transferred_action_treated_as_filed_on(pr, filedOn);
}

// ============================================================================
// Payment authority: claims payable out of funds appropriated under
// 31 U.S.C. 1304 (§7426(h)(3), §7430(d)(1), §7432(c), §7433(c), §7435(c))
// ============================================================================

pub relation claim_pursuant_to_section(pr: Proceeding, section: Text, amount: Money) kind empirical {
    label en unofficial "a claim or award pursuant to the named section of this chapter";
}
pub relation payable_out_of_1304_funds(pr: Proceeding, section: Text, amount: Money) kind institutional {
    label en unofficial "the claim is payable out of funds appropriated under section 1304 of title 31, United States Code";
}
@source(IRC_S7426_H, relation = formalizes, coverage = exact, quote = "Claims pursuant to this section shall be payable out of funds appropriated under section 1304 of title 31, United States Code.")
pub rule S7426h3PaymentAuthority strict {
    label en official "Claims pursuant to this section shall be payable out of funds appropriated under section 1304 of title 31, United States Code.";
    for pr: Proceeding;
    for amount: Money;
    when claim_pursuant_to_section(pr, "7426", amount);
    then payable_out_of_1304_funds(pr, "7426", amount);
}
@source(IRC_S7430_D, relation = formalizes, coverage = exact, quote = "An award for reasonable administrative costs shall be payable out of funds appropriated under section 1304 of title 31, United States Code.")
pub rule S7430d1PaymentAuthority strict {
    label en official "An award for reasonable administrative costs shall be payable out of funds appropriated under section 1304 of title 31, United States Code.";
    for pr: Proceeding;
    for amount: Money;
    when claim_pursuant_to_section(pr, "7430", amount);
    then payable_out_of_1304_funds(pr, "7430", amount);
}
@source(IRC_S7432_C, relation = formalizes, coverage = exact, quote = "Claims pursuant to this section shall be payable out of funds appropriated under section 1304 of title 31, United States Code.")
pub rule S7432cPaymentAuthority strict {
    label en official "Claims pursuant to this section shall be payable out of funds appropriated under section 1304 of title 31, United States Code.";
    for pr: Proceeding;
    for amount: Money;
    when claim_pursuant_to_section(pr, "7432", amount);
    then payable_out_of_1304_funds(pr, "7432", amount);
}
@source(IRC_S7433_C, relation = formalizes, coverage = exact, quote = "Claims pursuant to this section shall be payable out of funds appropriated under section 1304 of title 31, United States Code.")
pub rule S7433cPaymentAuthority strict {
    label en official "Claims pursuant to this section shall be payable out of funds appropriated under section 1304 of title 31, United States Code.";
    for pr: Proceeding;
    for amount: Money;
    when claim_pursuant_to_section(pr, "7433", amount);
    then payable_out_of_1304_funds(pr, "7433", amount);
}
@source(IRC_S7435_C, relation = formalizes, coverage = exact, quote = "Claims pursuant to this section shall be payable out of funds appropriated under section 1304 of title 31, United States Code.")
pub rule S7435cPaymentAuthority strict {
    label en official "Claims pursuant to this section shall be payable out of funds appropriated under section 1304 of title 31, United States Code.";
    for pr: Proceeding;
    for amount: Money;
    when claim_pursuant_to_section(pr, "7435", amount);
    then payable_out_of_1304_funds(pr, "7435", amount);
}

// ============================================================================
// §7430(d)(2), (e), (f) — Payment, multiple actions, right of appeal
// ============================================================================

pub relation tax_court_litigation_costs_award(pr: Proceeding, amount: Money) kind empirical {
    label en official "An award for reasonable litigation costs ... in the case of the Tax Court";
}
pub relation tax_court_costs_award_payable_as_district_court_award(pr: Proceeding, amount: Money) kind institutional;
@source(IRC_S7430_D, relation = formalizes, coverage = exact, quote = "An award for reasonable litigation costs shall be payable in the case of the Tax Court in the same manner as such an award by a district court.")
pub rule S7430d2TaxCourtAwardPayableAsDistrictCourt strict {
    label en official "An award for reasonable litigation costs shall be payable in the case of the Tax Court in the same manner as such an award by a district court.";
    for pr: Proceeding;
    for amount: Money;
    when tax_court_litigation_costs_award(pr, amount);
    then tax_court_costs_award_payable_as_district_court_award(pr, amount);
}
pub relation actions_could_have_been_joined(pr: Proceeding, other: Proceeding) kind empirical {
    label en official "multiple actions which could have been joined or consolidated, or a case or cases involving a return or returns of the same taxpayer (including joint returns of married individuals) which could have been joined in a single court proceeding in the same court";
}
external judgment relation joinder_inappropriate_in_courts_discretion(pr: Proceeding, other: Proceeding) {
    authority DistrictCourt;
    label en official "the court in which such action is brought determines, in its discretion, that it would be inappropriate to treat such actions or cases as joined or consolidated";
}
pub relation treated_as_one_court_proceeding(pr: Proceeding, other: Proceeding) kind institutional;
@source(IRC_S7430_E, relation = formalizes, coverage = exact, quote = "such actions or cases shall be treated as 1 court proceeding regardless of whether such joinder or consolidation actually occurs")
pub rule S7430eMultipleActionsOneProceeding defeasible {
    label en official "such actions or cases shall be treated as 1 court proceeding regardless of whether such joinder or consolidation actually occurs";
    for pr: Proceeding;
    for other: Proceeding;
    when actions_could_have_been_joined(pr, other);
    then treated_as_one_court_proceeding(pr, other);
    unless joinder_inappropriate_in_courts_discretion(pr, other) and actions_could_have_been_joined(pr, other);
}
pub relation costs_order_entered_in_court_proceeding(pr: Proceeding) kind empirical {
    label en official "An order granting or denying (in whole or in part) an award for reasonable litigation or administrative costs under subsection (a) in a court proceeding";
}
pub relation costs_order_appealable_as_decision(pr: Proceeding) kind institutional;
@source(IRC_S7430_F, relation = formalizes, coverage = exact, quote = "may be incorporated as a part of the decision or judgment in the court proceeding and shall be subject to appeal in the same manner as the decision or judgment.")
pub rule S7430f1OrderAppealableAsDecision strict {
    label en official "may be incorporated as a part of the decision or judgment in the court proceeding and shall be subject to appeal in the same manner as the decision or judgment.";
    for pr: Proceeding;
    when costs_order_entered_in_court_proceeding(pr);
    then costs_order_appealable_as_decision(pr);
}
pub relation irs_costs_decision_notice_mailed_certified(n: Notice, p: Person) kind empirical {
    label en official "the Secretary sends by certified or registered mail a notice of such decision to the petitioner";
}
pub relation costs_review_petition_window_end(n: Notice, p: Person, lastDay: Date) kind institutional {
    label en unofficial "the petition for Tax Court review of the Service's costs decision must be filed before the 91st day after the date of mailing, i.e. on or before the 90th day";
}
@source(IRC_S7430_F, relation = formalizes, coverage = exact, quote = "If the Secretary sends by certified or registered mail a notice of such decision to the petitioner, no proceeding in the Tax Court may be initiated under this paragraph unless such petition is filed before the 91st day after the date of such mailing.")
pub rule S7430f2ReviewPetitionWindow defeasible {
    label en official "If the Secretary sends by certified or registered mail a notice of such decision to the petitioner, no proceeding in the Tax Court may be initiated under this paragraph unless such petition is filed before the 91st day after the date of such mailing.";
    for n: Notice;
    for p: Person;
    for mailedOn: Date;
    when irs_costs_decision_notice_mailed_certified(n, p)
        and us.irc.core::mailed_on(n, mailedOn);
    then costs_review_petition_window_end(n, p, add_calendar_period(mailedOn, 90 calendar_day));
}
pub relation costs_review_petition_filed_on(n: Notice, p: Person, on: Date) kind empirical;
pub relation costs_review_petition_timely(n: Notice, p: Person, on: Date) kind institutional;
@source(IRC_S7430_F, relation = formalizes, coverage = exact, quote = "no proceeding in the Tax Court may be initiated under this paragraph unless such petition is filed before the 91st day after the date of such mailing.")
pub rule S7430f2ReviewPetitionTimely defeasible {
    label en official "no proceeding in the Tax Court may be initiated under this paragraph unless such petition is filed before the 91st day after the date of such mailing.";
    for n: Notice;
    for p: Person;
    for on: Date;
    for lastDay: Date;
    when costs_review_petition_window_end(n, p, lastDay)
        and costs_review_petition_filed_on(n, p, on)
        and on <= lastDay;
    then costs_review_petition_timely(n, p, on);
}
pub relation tax_court_costs_review_initiated(n: Notice, p: Person) kind institutional;
@source(IRC_S7430_F, relation = formalizes, coverage = exact, quote = "A decision granting or denying (in whole or in part) an award for reasonable administrative costs under subsection (a) by the Internal Revenue Service shall be subject to the filing of a petition for review with the Tax Court")
pub rule S7430f2ReviewPetitionPowerRule defeasible {
    label en official "A decision granting or denying (in whole or in part) an award for reasonable administrative costs under subsection (a) by the Internal Revenue Service shall be subject to the filing of a petition for review with the Tax Court";
    for n: Notice;
    for p: Person;
    for on: Date;
    when costs_review_petition_filed_on(n, p, on);
    then power S7430f2PetitionTaxCourtForCostsReview {
        holder p;
        exercise costs_review_petition_filed_on(n, p, on);
        valid_when costs_review_petition_timely(n, p, on);
        effect tax_court_costs_review_initiated(n, p);
    };
}
pub relation tax_court_order_on_costs_review_petition(pr: Proceeding) kind empirical {
    label en official "An order of the Tax Court disposing of a petition under paragraph (2)";
}
pub relation costs_review_order_reviewable_as_decision_limited_to_matters_determined(pr: Proceeding) kind institutional;
@source(IRC_S7430_F, relation = formalizes, coverage = exact, quote = "An order of the Tax Court disposing of a petition under paragraph (2) shall be reviewable in the same manner as a decision of the Tax Court, but only with respect to the matters determined in such order.")
pub rule S7430f3OrderReviewableAsDecision strict {
    label en official "An order of the Tax Court disposing of a petition under paragraph (2) shall be reviewable in the same manner as a decision of the Tax Court, but only with respect to the matters determined in such order.";
    for pr: Proceeding;
    when tax_court_order_on_costs_review_petition(pr);
    then costs_review_order_reviewable_as_decision_limited_to_matters_determined(pr);
}

// ============================================================================
// §7431(e)-(h) — Notification of unlawful inspection; extension to §3406 and
// §6311(e)
// ============================================================================

pub relation person_criminally_charged_with_unauthorized_inspection(taxpayer: Person, act_id: Person) kind empirical {
    label en official "any person is criminally charged by indictment or information with inspection or disclosure of a taxpayer's return or return information in violation of paragraph (1) or (2) of section 7213(a), section 7213A(a), or subparagraph (B) of section 1030(a)(2) of title 18, United States Code";
}
pub relation disciplinary_determination_proposed_for_unauthorized_inspection(taxpayer: Person, act_id: Person) kind empirical {
    label en official "the Internal Revenue Service or a Federal or State agency (upon notice to the Secretary by such Federal or State agency) proposes an administrative determination as to disciplinary or adverse action against an employee arising from the employee's unauthorized inspection or disclosure of the taxpayer's return or return information";
}
pub relation taxpayer_notified_with_date_and_rights(taxpayer: Person, act_id: Person) kind empirical {
    label en official "The notice described in this subsection shall include the date of the unauthorized inspection or disclosure and the rights of the taxpayer under such administrative determination";
}
@source(IRC_S7431_E, relation = formalizes, coverage = exact, quote = "the Secretary shall notify such taxpayer as soon as practicable of such inspection or disclosure.")
pub rule S7431eNotifyOnChargeDutyRule strict {
    label en official "the Secretary shall notify such taxpayer as soon as practicable of such inspection or disclosure.";
    for taxpayer: Person;
    for act_id: Person;
    when person_criminally_charged_with_unauthorized_inspection(taxpayer, act_id);
    then duty S7431eNotifyTaxpayerOfChargedInspection {
        bearer us.irc.core::Secretary;
        beneficiary taxpayer;
        goal achievement {
            condition taxpayer_notified_with_date_and_rights(taxpayer, act_id);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7431_E, relation = formalizes, coverage = exact, quote = "The Secretary shall also notify such taxpayer if the Internal Revenue Service or a Federal or State agency (upon notice to the Secretary by such Federal or State agency) proposes an administrative determination as to disciplinary or adverse action against an employee arising from the employee's unauthorized inspection or disclosure of the taxpayer's return or return information.")
pub rule S7431eNotifyOnDisciplineDutyRule strict {
    label en official "The Secretary shall also notify such taxpayer if the Internal Revenue Service or a Federal or State agency (upon notice to the Secretary by such Federal or State agency) proposes an administrative determination as to disciplinary or adverse action against an employee arising from the employee's unauthorized inspection or disclosure of the taxpayer's return or return information.";
    for taxpayer: Person;
    for act_id: Person;
    when disciplinary_determination_proposed_for_unauthorized_inspection(taxpayer, act_id);
    then duty S7431eNotifyTaxpayerOfProposedDiscipline {
        bearer us.irc.core::Secretary;
        beneficiary taxpayer;
        goal achievement {
            condition taxpayer_notified_with_date_and_rights(taxpayer, act_id);
            window [-infinity, infinity];
        }
    };
}
pub relation information_obtained_under_3406(info: Person) kind empirical {
    label en official "any information obtained under section 3406 (including information with respect to any payee certification failure under subsection (d) thereof)";
}
pub relation treated_as_return_information_for_7431(info: Person) kind institutional;
@source(IRC_S7431_G, relation = formalizes, coverage = exact, quote = "any information obtained under section 3406 (including information with respect to any payee certification failure under subsection (d) thereof) shall be treated as return information")
pub rule S7431g1Section3406InformationIsReturnInformation strict {
    label en official "any information obtained under section 3406 (including information with respect to any payee certification failure under subsection (d) thereof) shall be treated as return information";
    for info: Person;
    when information_obtained_under_3406(info);
    then treated_as_return_information_for_7431(info);
}
pub relation use_of_3406_information_outside_permitted_purposes(act_id: Person) kind empirical {
    label en official "any inspection or use of such information other than for purposes of meeting any requirement under section 3406 or (subject to the safeguards set forth in section 6103) for purposes permitted under section 6103";
}
pub relation treated_as_violation_of_6103_for_7431(act_id: Person) kind institutional;
@source(IRC_S7431_G, relation = formalizes, coverage = exact, quote = "any inspection or use of such information other than for purposes of meeting any requirement under section 3406 or (subject to the safeguards set forth in section 6103) for purposes permitted under section 6103 shall be treated as a violation of section 6103.")
pub rule S7431g2ImproperUseIsSection6103Violation strict {
    label en official "any inspection or use of such information other than for purposes of meeting any requirement under section 3406 or (subject to the safeguards set forth in section 6103) for purposes permitted under section 6103 shall be treated as a violation of section 6103.";
    for act_id: Person;
    when use_of_3406_information_outside_permitted_purposes(act_id);
    then treated_as_violation_of_6103_for_7431(act_id);
}
pub relation section_reference_extended_for_7431(base: Text, extendedTo: Text) kind institutional {
    label en unofficial "for purposes of §7431, a reference to the base section is treated as including the extended section";
}
@source(IRC_S7431_G, relation = formalizes, coverage = exact, quote = "For purposes of subsection (b), the reference to section 6103 shall be treated as including a reference to section 3406.")
rule S7431gReference3406 strict {
    label en official "For purposes of subsection (b), the reference to section 6103 shall be treated as including a reference to section 3406.";
    then section_reference_extended_for_7431("6103", "3406");
}
@source(IRC_S7431_H, relation = formalizes, coverage = exact, quote = "For purposes of this section, any reference to section 6103 shall be treated as including a reference to section 6311(e).")
rule S7431hReference6311e strict {
    label en official "For purposes of this section, any reference to section 6103 shall be treated as including a reference to section 6311(e).";
    then section_reference_extended_for_7431("6103", "6311(e)");
}

// ============================================================================
// §7432 — Civil damages for failure to release lien
// ============================================================================

external judgment relation lien_release_failure_knowing_or_negligent(pr: Proceeding, taxpayer: Person, lien: Lien) {
    authority DistrictCourt;
    label en official "any officer or employee of the Internal Revenue Service knowingly, or by reason of negligence, fails to release a lien under section 6325 on property of the taxpayer";
}
pub relation lien_release_administrative_remedies_exhausted(pr: Proceeding, taxpayer: Person) kind empirical {
    label en official "the plaintiff has exhausted the administrative remedies available to such plaintiff within the Internal Revenue Service";
}
pub relation lien_release_right_accrued_on(pr: Proceeding, taxpayer: Person, on: Date) kind empirical;
pub relation lien_release_action_filed_on(pr: Proceeding, taxpayer: Person, on: Date) kind empirical;
pub relation lien_release_action_within_2_years(pr: Proceeding, taxpayer: Person) kind institutional;
@source(IRC_S7432_D, relation = formalizes, coverage = exact, quote = "an action to enforce liability created under this section may be brought without regard to the amount in controversy and may be brought only within 2 years after the date the right of action accrues.")
pub rule S7432d3WithinTwoYears defeasible {
    label en official "an action to enforce liability created under this section may be brought without regard to the amount in controversy and may be brought only within 2 years after the date the right of action accrues.";
    for pr: Proceeding;
    for taxpayer: Person;
    for accruedOn: Date;
    for filedOn: Date;
    when lien_release_right_accrued_on(pr, taxpayer, accruedOn)
        and lien_release_action_filed_on(pr, taxpayer, filedOn)
        and add_calendar_period(accruedOn, 2 calendar_year) >= filedOn;
    then lien_release_action_within_2_years(pr, taxpayer);
}
pub relation lien_release_damages_grounds(pr: Proceeding, taxpayer: Person, lien: Lien) kind institutional {
    label en unofficial "single atom folding §7432(a) (knowing or negligent failure), (d)(1) (exhaustion) and (d)(3) (2-year period) for the power's valid_when";
}
@source(IRC_S7432_A, relation = formalizes, coverage = exact, quote = "If any officer or employee of the Internal Revenue Service knowingly, or by reason of negligence, fails to release a lien under section 6325 on property of the taxpayer, such taxpayer may bring a civil action for damages against the United States in a district court of the United States.")
pub rule S7432GroundsRule defeasible {
    label en official "If any officer or employee of the Internal Revenue Service knowingly, or by reason of negligence, fails to release a lien under section 6325 on property of the taxpayer, such taxpayer may bring a civil action for damages against the United States in a district court of the United States.";
    for pr: Proceeding;
    for taxpayer: Person;
    for lien: Lien;
    when lien_release_failure_knowing_or_negligent(pr, taxpayer, lien)
        and lien_release_administrative_remedies_exhausted(pr, taxpayer)
        and lien_release_action_within_2_years(pr, taxpayer);
    then lien_release_damages_grounds(pr, taxpayer, lien);
}
pub relation lien_release_action_brought(pr: Proceeding, taxpayer: Person, lien: Lien) kind empirical;
pub relation lien_release_action_permitted(pr: Proceeding, taxpayer: Person, lien: Lien) kind institutional;
@source(IRC_S7432_A, relation = formalizes, coverage = exact, quote = "such taxpayer may bring a civil action for damages against the United States in a district court of the United States.")
pub rule S7432ActionPowerRule defeasible {
    label en official "such taxpayer may bring a civil action for damages against the United States in a district court of the United States.";
    for pr: Proceeding;
    for taxpayer: Person;
    for lien: Lien;
    when lien_release_action_brought(pr, taxpayer, lien);
    then power S7432BringLienReleaseDamagesAction {
        holder taxpayer;
        exercise lien_release_action_brought(pr, taxpayer, lien);
        valid_when lien_release_damages_grounds(pr, taxpayer, lien);
        effect lien_release_action_permitted(pr, taxpayer, lien);
    };
}
pub relation lien_release_damages_claimed(pr: Proceeding, taxpayer: Person, actualDirect: Money, actionCosts: Money) kind empirical {
    label en official "actual, direct economic damages sustained by the plaintiff which, but for the actions of the defendant, would not have been sustained, plus the costs of the action";
}
external judgment relation lien_release_damages_mitigable(pr: Proceeding, taxpayer: Person, amount: Money) {
    authority DistrictCourt;
    label en official "such damages which could have reasonably been mitigated by the plaintiff";
}
pub relation lien_release_mitigation_determined(pr: Proceeding, taxpayer: Person) kind institutional;
rule S7432MitigationDeterminedBridge strict {
    for pr: Proceeding;
    for taxpayer: Person;
    for amount: Money;
    when lien_release_damages_mitigable(pr, taxpayer, amount);
    then lien_release_mitigation_determined(pr, taxpayer);
}
pub relation lien_release_damages_awarded(pr: Proceeding, taxpayer: Person, amount: Money) kind institutional;
@source(IRC_S7432_B, relation = formalizes, coverage = exact, quote = "the defendant shall be liable to the plaintiff in an amount equal to the sum of—")
pub rule S7432bAwardNoMitigation defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the sum of—";
    for pr: Proceeding;
    for taxpayer: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    when lien_release_damages_claimed(pr, taxpayer, actualDirect, actionCosts)
        and not_known(lien_release_mitigation_determined(pr, taxpayer));
    then lien_release_damages_awarded(pr, taxpayer, actualDirect + actionCosts);
}
@source(IRC_S7432_D, relation = formalizes, coverage = exact, quote = "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.")
pub rule S7432dMitigationReducesActual defeasible {
    label en official "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.";
    for pr: Proceeding;
    for taxpayer: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    for mitigable: Money;
    when lien_release_damages_claimed(pr, taxpayer, actualDirect, actionCosts)
        and lien_release_damages_mitigable(pr, taxpayer, mitigable)
        and mitigable <= actualDirect;
    then lien_release_damages_awarded(pr, taxpayer, (actualDirect - mitigable) + actionCosts);
}
@source(IRC_S7432_D, relation = formalizes, coverage = exact, quote = "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.")
pub rule S7432dMitigationExceedsActual defeasible {
    label en official "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.";
    for pr: Proceeding;
    for taxpayer: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    for mitigable: Money;
    when lien_release_damages_claimed(pr, taxpayer, actualDirect, actionCosts)
        and lien_release_damages_mitigable(pr, taxpayer, mitigable)
        and mitigable > actualDirect;
    then lien_release_damages_awarded(pr, taxpayer, actionCosts);
}
pub relation lien_release_notice_procedures_prescribed_by_regulation(taxpayer: Person) kind empirical {
    label en official "The Secretary shall by regulation prescribe reasonable procedures for a taxpayer to notify the Secretary of the failure to release a lien under section 6325 on property of the taxpayer";
}
pub relation lien_release_failure_procedures_needed(taxpayer: Person) kind empirical {
    label en unofficial "a taxpayer's failure to release a lien under §6325 on his property is a matter for which the procedures of §7432(e) are to exist";
}
@source(IRC_S7432_E, relation = formalizes, coverage = exact, quote = "The Secretary shall by regulation prescribe reasonable procedures for a taxpayer to notify the Secretary of the failure to release a lien under section 6325 on property of the taxpayer.")
pub rule S7432eProceduresDutyRule strict {
    label en official "The Secretary shall by regulation prescribe reasonable procedures for a taxpayer to notify the Secretary of the failure to release a lien under section 6325 on property of the taxpayer.";
    for taxpayer: Person;
    when lien_release_failure_procedures_needed(taxpayer);
    then duty S7432ePrescribeNoticeProcedures {
        bearer us.irc.core::Secretary;
        beneficiary taxpayer;
        goal maintenance {
            condition lien_release_notice_procedures_prescribed_by_regulation(taxpayer);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §7433(d)(2) — Mitigation of damages (collection damages)
// ============================================================================

external judgment relation collection_damages_mitigable(p: Person, act_id: Person, amount: Money) {
    authority DistrictCourt;
    label en official "such damages which could have reasonably been mitigated by the plaintiff";
}
pub relation collection_damages_mitigation_determined(p: Person, act_id: Person) kind institutional;
rule S7433MitigationDeterminedBridge strict {
    for p: Person;
    for act_id: Person;
    for amount: Money;
    when collection_damages_mitigable(p, act_id, amount);
    then collection_damages_mitigation_determined(p, act_id);
}
pub relation collection_damages_sum(p: Person, act_id: Person, total: Money) kind institutional {
    label en unofficial "the sum of (1) actual, direct economic damages (net of the amount that could reasonably have been mitigated, §7433(d)(2)) and (2) the costs of the action, to which the §7433(b) cap is applied";
}
@source(IRC_S7433_D, relation = formalizes, coverage = exact, quote = "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.")
pub rule S7433SumNoMitigation defeasible {
    label en official "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.";
    for p: Person;
    for act_id: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    when collection_damages_claimed(p, act_id, actualDirect, actionCosts)
        and not_known(collection_damages_mitigation_determined(p, act_id));
    then collection_damages_sum(p, act_id, actualDirect + actionCosts);
}
@source(IRC_S7433_D, relation = formalizes, coverage = exact, quote = "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.")
pub rule S7433SumMitigationReduces defeasible {
    label en official "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.";
    for p: Person;
    for act_id: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    for mitigable: Money;
    when collection_damages_claimed(p, act_id, actualDirect, actionCosts)
        and collection_damages_mitigable(p, act_id, mitigable)
        and mitigable <= actualDirect;
    then collection_damages_sum(p, act_id, (actualDirect - mitigable) + actionCosts);
}
@source(IRC_S7433_D, relation = formalizes, coverage = exact, quote = "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.")
pub rule S7433SumMitigationExceedsActual defeasible {
    label en official "The amount of damages awarded under subsection (b)(1) shall be reduced by the amount of such damages which could have reasonably been mitigated by the plaintiff.";
    for p: Person;
    for act_id: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    for mitigable: Money;
    when collection_damages_claimed(p, act_id, actualDirect, actionCosts)
        and collection_damages_mitigable(p, act_id, mitigable)
        and mitigable > actualDirect;
    then collection_damages_sum(p, act_id, actionCosts);
}

// ============================================================================
// §7426(h) — Grounds of the damages action (the caps are in module 09)
// ============================================================================

pub relation levy_damages_action_brought(pr: Proceeding, plaintiff: Person) kind empirical;
pub relation levy_damages_grounds(pr: Proceeding, plaintiff: Person, officer: Person, act_id: Person) kind institutional {
    label en unofficial "the §7426(h)(1) finding of reckless, intentional or negligent disregard, together with the §7433(d) rules that §7426(h)(2) makes applicable: exhaustion of administrative remedies and the 2-year period";
}
pub relation levy_damages_suit_filed_on(p: Person, act_id: Person, on: Date) kind empirical;
@source(IRC_S7426_H, relation = formalizes, coverage = exact, quote = "The rules of section 7433(d) shall apply for purposes of this subsection.")
pub rule S7426h2GroundsRule defeasible {
    label en official "The rules of section 7433(d) shall apply for purposes of this subsection.";
    for pr: Proceeding;
    for plaintiff: Person;
    for officer: Person;
    for act_id: Person;
    for filedOn: Date;
    when irs_disregard_found_in_7426_action(pr, officer)
        and collection_administrative_remedies_exhausted(plaintiff, pr)
        and collection_damages_suit_within_limitation(plaintiff, act_id, filedOn);
    then levy_damages_grounds(pr, plaintiff, officer, act_id);
}
pub relation levy_damages_action_permitted(pr: Proceeding, plaintiff: Person) kind institutional;
@source(IRC_S7426_H, relation = formalizes, coverage = exact, quote = "there is a finding that any officer or employee of the Internal Revenue Service recklessly or intentionally, or by reason of negligence, disregarded any provision of this title the defendant shall be liable to the plaintiff")
pub rule S7426h1DamagesPowerRule defeasible {
    label en official "there is a finding that any officer or employee of the Internal Revenue Service recklessly or intentionally, or by reason of negligence, disregarded any provision of this title the defendant shall be liable to the plaintiff";
    for pr: Proceeding;
    for plaintiff: Person;
    for officer: Person;
    for act_id: Person;
    when levy_damages_action_brought(pr, plaintiff)
        and levy_damages_grounds(pr, plaintiff, officer, act_id);
    then power S7426hBringDamagesAction {
        holder plaintiff;
        exercise levy_damages_action_brought(pr, plaintiff);
        valid_when levy_damages_grounds(pr, plaintiff, officer, act_id);
        effect levy_damages_action_permitted(pr, plaintiff);
    };
}

// ============================================================================
// §7433(e) — Bankruptcy-stay and discharge violations
// ============================================================================

external judgment relation willful_violation_of_bankruptcy_stay_or_discharge(pr: Proceeding, taxpayer: Person, officer: Person) {
    authority BankruptcyCourt;
    label en official "any officer or employee of the Internal Revenue Service willfully violates any provision of section 362 (relating to automatic stay) or 524 (relating to effect of discharge) of title 11, United States Code (or any successor provision), or any regulation promulgated under such provision";
}
pub relation collection_of_federal_tax_of_taxpayer(pr: Proceeding, taxpayer: Person) kind empirical {
    label en official "in connection with any collection of Federal tax with respect to a taxpayer";
}
pub relation bankruptcy_damages_petition_filed(pr: Proceeding, taxpayer: Person) kind empirical;
pub relation bankruptcy_damages_grounds(pr: Proceeding, taxpayer: Person) kind institutional;
@source(IRC_S7433_E, relation = formalizes, coverage = exact, quote = "If, in connection with any collection of Federal tax with respect to a taxpayer, any officer or employee of the Internal Revenue Service willfully violates any provision of section 362 (relating to automatic stay) or 524 (relating to effect of discharge) of title 11, United States Code (or any successor provision), or any regulation promulgated under such provision, such taxpayer may petition the bankruptcy court to recover damages against the United States.")
pub rule S7433e1GroundsRule defeasible {
    label en official "If, in connection with any collection of Federal tax with respect to a taxpayer, any officer or employee of the Internal Revenue Service willfully violates any provision of section 362 (relating to automatic stay) or 524 (relating to effect of discharge) of title 11, United States Code (or any successor provision), or any regulation promulgated under such provision, such taxpayer may petition the bankruptcy court to recover damages against the United States.";
    for pr: Proceeding;
    for taxpayer: Person;
    for officer: Person;
    when collection_of_federal_tax_of_taxpayer(pr, taxpayer)
        and willful_violation_of_bankruptcy_stay_or_discharge(pr, taxpayer, officer);
    then bankruptcy_damages_grounds(pr, taxpayer);
}
pub relation bankruptcy_damages_petition_permitted(pr: Proceeding, taxpayer: Person) kind institutional;
@source(IRC_S7433_E, relation = formalizes, coverage = exact, quote = "such taxpayer may petition the bankruptcy court to recover damages against the United States.")
pub rule S7433e1PetitionPowerRule defeasible {
    label en official "such taxpayer may petition the bankruptcy court to recover damages against the United States.";
    for pr: Proceeding;
    for taxpayer: Person;
    when bankruptcy_damages_petition_filed(pr, taxpayer);
    then power S7433e1PetitionBankruptcyCourtForDamages {
        holder taxpayer;
        exercise bankruptcy_damages_petition_filed(pr, taxpayer);
        valid_when bankruptcy_damages_grounds(pr, taxpayer);
        effect bankruptcy_damages_petition_permitted(pr, taxpayer);
    };
}
pub relation other_remedy_for_bankruptcy_violation_damages_sought(pr: Proceeding, taxpayer: Person) kind empirical;
pub relation section_362h_stay_violation_action(pr: Proceeding, taxpayer: Person) kind empirical {
    label en official "an action under section 362(h) of such title 11 for a violation of a stay provided by section 362 of such title";
}
@source(IRC_S7433_E, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), notwithstanding section 105 of such title 11, such petition shall be the exclusive remedy for recovering damages resulting from such actions.")
pub rule S7433e2AExclusiveRemedyRule defeasible {
    label en official "Except as provided in subparagraph (B), notwithstanding section 105 of such title 11, such petition shall be the exclusive remedy for recovering damages resulting from such actions.";
    for pr: Proceeding;
    for taxpayer: Person;
    when bankruptcy_damages_petition_permitted(pr, taxpayer);
    then immunity S7433e2AExclusiveRemedyImmunity {
        holder us.irc.core::Secretary;
        protected_effect other_remedy_for_bankruptcy_violation_damages_sought(pr, taxpayer);
        window [-infinity, infinity];
    };
    unless section_362h_stay_violation_action(pr, taxpayer) and bankruptcy_damages_petition_permitted(pr, taxpayer);
}
pub relation costs_in_362h_action_incurred_on(pr: Proceeding, taxpayer: Person, on: Date) kind empirical;
pub relation bankruptcy_petition_filed_on(taxpayer: Person, on: Date) kind empirical;
pub relation administrative_costs_awardable_in_362h_action(pr: Proceeding, taxpayer: Person) kind institutional {
    label en unofficial "administrative costs in a §362(h) action may be awarded only under §7430 and only if incurred on or after the date that the bankruptcy petition is filed";
}
@source(IRC_S7433_E, relation = formalizes, coverage = exact, quote = "(ii) administrative costs may be awarded only if incurred on or after the date that the bankruptcy petition is filed.")
pub rule S7433e2BiiAdministrativeCostsTiming defeasible {
    label en official "(ii) administrative costs may be awarded only if incurred on or after the date that the bankruptcy petition is filed.";
    for pr: Proceeding;
    for taxpayer: Person;
    for incurredOn: Date;
    for petitionOn: Date;
    when section_362h_stay_violation_action(pr, taxpayer)
        and costs_in_362h_action_incurred_on(pr, taxpayer, incurredOn)
        and bankruptcy_petition_filed_on(taxpayer, petitionOn)
        and incurredOn >= petitionOn;
    then administrative_costs_awardable_in_362h_action(pr, taxpayer);
}

// ============================================================================
// §7433A — Qualified tax collection contractors
// ============================================================================

pub relation performs_services_under_qualified_tax_collection_contract(contractor: Person) kind empirical {
    label en official "any person performing services under a qualified tax collection contract (as defined in section 6306(b))";
}
pub relation treated_as_irs_employee_for_7433(contractor: Person) kind institutional;
@source(IRC_S7433A_A, relation = formalizes, coverage = exact, quote = "section 7433 shall apply to the acts and omissions of any person performing services under a qualified tax collection contract (as defined in section 6306(b)) to the same extent and in the same manner as if such person were an employee of the Internal Revenue Service.")
pub rule S7433AContractorTreatedAsEmployee strict {
    label en official "section 7433 shall apply to the acts and omissions of any person performing services under a qualified tax collection contract (as defined in section 6306(b)) to the same extent and in the same manner as if such person were an employee of the Internal Revenue Service.";
    for contractor: Person;
    when performs_services_under_qualified_tax_collection_contract(contractor);
    then treated_as_irs_employee_for_7433(contractor);
}
pub relation section_7433_action_by_reason_of_7433A(pr: Proceeding, contractor: Person) kind empirical;
pub relation action_lies_against_contractor_not_united_states(pr: Proceeding, contractor: Person) kind institutional;
@source(IRC_S7433A_B, relation = formalizes, coverage = exact, quote = "(1) Any civil action brought under section 7433 by reason of this section shall be brought against the person who entered into the qualified tax collection contract with the Secretary and shall not be brought against the United States.")
pub rule S7433Ab1ActionAgainstContractor strict {
    label en official "(1) Any civil action brought under section 7433 by reason of this section shall be brought against the person who entered into the qualified tax collection contract with the Secretary and shall not be brought against the United States.";
    for pr: Proceeding;
    for contractor: Person;
    when section_7433_action_by_reason_of_7433A(pr, contractor)
        and treated_as_irs_employee_for_7433(contractor);
    then action_lies_against_contractor_not_united_states(pr, contractor);
}
pub relation contractor_liable_for_damages_and_costs(pr: Proceeding, contractor: Person) kind institutional;
@source(IRC_S7433A_B, relation = formalizes, coverage = exact, quote = "(2) Such person and not the United States shall be liable for any damages and costs determined in such civil action.")
pub rule S7433Ab2ContractorLiable strict {
    label en official "(2) Such person and not the United States shall be liable for any damages and costs determined in such civil action.";
    for pr: Proceeding;
    for contractor: Person;
    when section_7433_action_by_reason_of_7433A(pr, contractor)
        and treated_as_irs_employee_for_7433(contractor);
    then contractor_liable_for_damages_and_costs(pr, contractor);
}
pub relation contractor_action_not_exclusive_remedy(pr: Proceeding, contractor: Person) kind institutional;
@source(IRC_S7433A_B, relation = formalizes, coverage = exact, quote = "(3) Such civil action shall not be an exclusive remedy with respect to such person.")
pub rule S7433Ab3NotExclusiveRemedy strict {
    label en official "(3) Such civil action shall not be an exclusive remedy with respect to such person.";
    for pr: Proceeding;
    for contractor: Person;
    when section_7433_action_by_reason_of_7433A(pr, contractor);
    then contractor_action_not_exclusive_remedy(pr, contractor);
}
pub relation section_7433_subsection_inapplicable_to_contractor(pr: Proceeding, subsection: Text) kind institutional;
@source(IRC_S7433A_B, relation = formalizes, coverage = exact, quote = "(4) Subsections (c), (d)(1), and (e) of section 7433 shall not apply.")
pub rule S7433Ab4SubsectionCInapplicable strict {
    label en official "(4) Subsections (c), (d)(1), and (e) of section 7433 shall not apply.";
    for pr: Proceeding;
    for contractor: Person;
    when section_7433_action_by_reason_of_7433A(pr, contractor);
    then section_7433_subsection_inapplicable_to_contractor(pr, "(c)");
}
@source(IRC_S7433A_B, relation = formalizes, coverage = exact, quote = "(4) Subsections (c), (d)(1), and (e) of section 7433 shall not apply.")
pub rule S7433Ab4SubsectionD1Inapplicable strict {
    label en official "(4) Subsections (c), (d)(1), and (e) of section 7433 shall not apply.";
    for pr: Proceeding;
    for contractor: Person;
    when section_7433_action_by_reason_of_7433A(pr, contractor);
    then section_7433_subsection_inapplicable_to_contractor(pr, "(d)(1)");
}
@source(IRC_S7433A_B, relation = formalizes, coverage = exact, quote = "(4) Subsections (c), (d)(1), and (e) of section 7433 shall not apply.")
pub rule S7433Ab4SubsectionEInapplicable strict {
    label en official "(4) Subsections (c), (d)(1), and (e) of section 7433 shall not apply.";
    for pr: Proceeding;
    for contractor: Person;
    when section_7433_action_by_reason_of_7433A(pr, contractor);
    then section_7433_subsection_inapplicable_to_contractor(pr, "(e)");
}

// ============================================================================
// §7434 — Civil damages for fraudulent filing of information returns
// ============================================================================

external judgment relation information_return_willfully_fraudulent(pr: Proceeding, payee: Person, filer: Person) {
    authority DistrictCourt;
    label en official "any person willfully files a fraudulent information return with respect to payments purported to be made to any other person";
}
pub relation filed_information_return_for_payments_to(payee: Person, filer: Person) kind empirical;
pub relation information_return_action_brought(pr: Proceeding, payee: Person, filer: Person) kind empirical;
pub relation information_return_damages_action_permitted(pr: Proceeding, payee: Person, filer: Person) kind institutional;
@source(IRC_S7434_A, relation = formalizes, coverage = exact, quote = "If any person willfully files a fraudulent information return with respect to payments purported to be made to any other person, such other person may bring a civil action for damages against the person so filing such return.")
pub rule S7434aActionPowerRule defeasible {
    label en official "If any person willfully files a fraudulent information return with respect to payments purported to be made to any other person, such other person may bring a civil action for damages against the person so filing such return.";
    for pr: Proceeding;
    for payee: Person;
    for filer: Person;
    when information_return_action_brought(pr, payee, filer)
        and filed_information_return_for_payments_to(payee, filer);
    then power S7434aSueForFraudulentInformationReturn {
        holder payee;
        over filer;
        exercise information_return_action_brought(pr, payee, filer);
        valid_when information_return_willfully_fraudulent_grounds(pr, payee, filer);
        effect information_return_damages_action_permitted(pr, payee, filer);
    };
}
pub relation information_return_willfully_fraudulent_grounds(pr: Proceeding, payee: Person, filer: Person) kind institutional;
@source(IRC_S7434_A, relation = formalizes, coverage = exact, quote = "If any person willfully files a fraudulent information return with respect to payments purported to be made to any other person")
pub rule S7434aGrounds defeasible {
    label en official "If any person willfully files a fraudulent information return with respect to payments purported to be made to any other person";
    for pr: Proceeding;
    for payee: Person;
    for filer: Person;
    when information_return_willfully_fraudulent(pr, payee, filer)
        and filed_information_return_for_payments_to(payee, filer);
    then information_return_willfully_fraudulent_grounds(pr, payee, filer);
}
pub relation information_return_damages_claimed(pr: Proceeding, payee: Person, actual: Money, costs: Money, fees: Money) kind empirical {
    label en official "any actual damages sustained by the plaintiff as a proximate result of the filing of the fraudulent information return (including any costs attributable to resolving deficiencies asserted as a result of such filing), the costs of the action, and, in the court's discretion, reasonable attorneys' fees";
}
pub relation information_return_damages_awarded(pr: Proceeding, payee: Person, amount: Money) kind institutional;
@source(IRC_S7434_B, relation = formalizes, coverage = exact, quote = "the defendant shall be liable to the plaintiff in an amount equal to the greater of $5,000 or the sum of—")
pub rule S7434bAwardSumAboveMinimum defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the greater of $5,000 or the sum of—";
    for pr: Proceeding;
    for payee: Person;
    for actual: Money;
    for costs: Money;
    for fees: Money;
    when information_return_damages_claimed(pr, payee, actual, costs, fees)
        and ((actual + costs) + fees) > 5000.00 USD;
    then information_return_damages_awarded(pr, payee, (actual + costs) + fees);
}
@source(IRC_S7434_B, relation = formalizes, coverage = exact, quote = "the defendant shall be liable to the plaintiff in an amount equal to the greater of $5,000 or the sum of—")
pub rule S7434bAwardMinimum5000 defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the greater of $5,000 or the sum of—";
    for pr: Proceeding;
    for payee: Person;
    for actual: Money;
    for costs: Money;
    for fees: Money;
    when information_return_damages_claimed(pr, payee, actual, costs, fees)
        and ((actual + costs) + fees) <= 5000.00 USD;
    then information_return_damages_awarded(pr, payee, 5000.00 USD);
}
pub relation fraudulent_information_return_filed_on(pr: Proceeding, filer: Person, on: Date) kind empirical;
pub relation fraudulent_return_discoverable_on(pr: Proceeding, filer: Person, on: Date) kind empirical {
    label en official "the date such fraudulent information return would have been discovered by exercise of reasonable care";
}
pub relation information_return_action_filed_on(pr: Proceeding, filer: Person, on: Date) kind empirical;
pub relation information_return_limitation_end(pr: Proceeding, filer: Person, lastDay: Date) kind institutional {
    label en unofficial "the later of 6 years after the filing of the fraudulent information return and 1 year after the date it would have been discovered by exercise of reasonable care";
}
@source(IRC_S7434_C, relation = formalizes, coverage = exact, quote = "(1) 6 years after the date of the filing of the fraudulent information return, or")
pub rule S7434cSixYearsLater defeasible {
    label en official "(1) 6 years after the date of the filing of the fraudulent information return, or";
    for pr: Proceeding;
    for filer: Person;
    for filedOn: Date;
    for discoveredOn: Date;
    when fraudulent_information_return_filed_on(pr, filer, filedOn)
        and fraudulent_return_discoverable_on(pr, filer, discoveredOn)
        and add_calendar_period(filedOn, 6 calendar_year) >= add_calendar_period(discoveredOn, 1 calendar_year);
    then information_return_limitation_end(pr, filer, add_calendar_period(filedOn, 6 calendar_year));
}
@source(IRC_S7434_C, relation = formalizes, coverage = exact, quote = "(2) 1 year after the date such fraudulent information return would have been discovered by exercise of reasonable care.")
pub rule S7434cOneYearAfterDiscoveryLater defeasible {
    label en official "(2) 1 year after the date such fraudulent information return would have been discovered by exercise of reasonable care.";
    for pr: Proceeding;
    for filer: Person;
    for filedOn: Date;
    for discoveredOn: Date;
    when fraudulent_information_return_filed_on(pr, filer, filedOn)
        and fraudulent_return_discoverable_on(pr, filer, discoveredOn)
        and add_calendar_period(filedOn, 6 calendar_year) < add_calendar_period(discoveredOn, 1 calendar_year);
    then information_return_limitation_end(pr, filer, add_calendar_period(discoveredOn, 1 calendar_year));
}
pub relation information_return_action_timely(pr: Proceeding, filer: Person) kind institutional;
@source(IRC_S7434_C, relation = formalizes, coverage = exact, quote = "an action to enforce the liability created under this section may be brought without regard to the amount in controversy and may be brought only within the later of—")
pub rule S7434cActionTimely defeasible {
    label en official "an action to enforce the liability created under this section may be brought without regard to the amount in controversy and may be brought only within the later of—";
    for pr: Proceeding;
    for filer: Person;
    for lastDay: Date;
    for filedOn: Date;
    when information_return_limitation_end(pr, filer, lastDay)
        and information_return_action_filed_on(pr, filer, filedOn)
        and filedOn <= lastDay;
    then information_return_action_timely(pr, filer);
}
pub relation complaint_copy_provided_to_irs_on(pr: Proceeding, on: Date) kind empirical;
@source(IRC_S7434_D, relation = formalizes, coverage = exact, quote = "Any person bringing an action under subsection (a) shall provide a copy of the complaint to the Internal Revenue Service upon the filing of such complaint with the court.")
pub rule S7434dCopyOfComplaintDutyRule strict {
    label en official "Any person bringing an action under subsection (a) shall provide a copy of the complaint to the Internal Revenue Service upon the filing of such complaint with the court.";
    for pr: Proceeding;
    for payee: Person;
    for filer: Person;
    for filedOn: Date;
    when information_return_action_brought(pr, payee, filer)
        and information_return_action_filed_on(pr, filer, filedOn);
    then duty S7434dProvideCopyOfComplaintToIrs {
        bearer payee;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition complaint_copy_provided_to_irs_on(pr, filedOn);
            window [filedOn, filedOn];
        }
    };
}
pub relation decision_includes_finding_of_correct_amount(pr: Proceeding) kind empirical {
    label en official "The decision of the court awarding damages includes a finding of the correct amount which should have been reported in the information return";
}
pub relation court_awards_damages_under_7434(pr: Proceeding) kind empirical;
@source(IRC_S7434_E, relation = formalizes, coverage = exact, quote = "The decision of the court awarding damages in an action brought under subsection (a) shall include a finding of the correct amount which should have been reported in the information return.")
pub rule S7434eFindingDutyRule strict {
    label en official "The decision of the court awarding damages in an action brought under subsection (a) shall include a finding of the correct amount which should have been reported in the information return.";
    for pr: Proceeding;
    when court_awards_damages_under_7434(pr);
    then duty S7434eIncludeFindingOfCorrectAmount {
        bearer us.irc.core::DistrictCourt;
        goal achievement {
            condition decision_includes_finding_of_correct_amount(pr);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §7435 — Civil damages for unauthorized compromise (tax advisers)
// ============================================================================

pub relation officer_compromised_adviser_tax_for_information(pr: Proceeding, taxpayer: Person) kind empirical {
    label en official "any officer or employee of the United States intentionally compromises the determination or collection of any tax due from an attorney, certified public accountant, or enrolled agent representing a taxpayer in exchange for information conveyed by the taxpayer to the attorney, certified public accountant, or enrolled agent for purposes of obtaining advice concerning the taxpayer's tax liability";
}
pub relation information_conveyed_to_perpetrate_fraud_or_crime(pr: Proceeding, taxpayer: Person) kind empirical {
    label en official "information conveyed to an attorney, certified public accountant, or enrolled agent for the purpose of perpetrating a fraud or crime";
}
pub relation compromise_action_grounds(pr: Proceeding, taxpayer: Person) kind institutional;
@source(IRC_S7435_F, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to information conveyed to an attorney, certified public accountant, or enrolled agent for the purpose of perpetrating a fraud or crime.")
@source(IRC_S7435_A, relation = formalizes, coverage = exact, quote = "If any officer or employee of the United States intentionally compromises the determination or collection of any tax due from an attorney, certified public accountant, or enrolled agent representing a taxpayer in exchange for information conveyed by the taxpayer to the attorney, certified public accountant, or enrolled agent for purposes of obtaining advice concerning the taxpayer's tax liability")
pub rule S7435aGrounds defeasible {
    label en official "If any officer or employee of the United States intentionally compromises the determination or collection of any tax due from an attorney, certified public accountant, or enrolled agent representing a taxpayer in exchange for information conveyed by the taxpayer to the attorney, certified public accountant, or enrolled agent for purposes of obtaining advice concerning the taxpayer's tax liability";
    for pr: Proceeding;
    for taxpayer: Person;
    when officer_compromised_adviser_tax_for_information(pr, taxpayer);
    then compromise_action_grounds(pr, taxpayer);
    unless information_conveyed_to_perpetrate_fraud_or_crime(pr, taxpayer) and officer_compromised_adviser_tax_for_information(pr, taxpayer);
}
pub relation compromise_action_brought(pr: Proceeding, taxpayer: Person) kind empirical;
pub relation compromise_action_permitted(pr: Proceeding, taxpayer: Person) kind institutional;
@source(IRC_S7435_A, relation = formalizes, coverage = exact, quote = "such taxpayer may bring a civil action for damages against the United States in a district court of the United States.")
pub rule S7435aActionPowerRule defeasible {
    label en official "such taxpayer may bring a civil action for damages against the United States in a district court of the United States.";
    for pr: Proceeding;
    for taxpayer: Person;
    when compromise_action_brought(pr, taxpayer);
    then power S7435aBringCompromiseDamagesAction {
        holder taxpayer;
        exercise compromise_action_brought(pr, taxpayer);
        valid_when compromise_action_grounds(pr, taxpayer);
        effect compromise_action_permitted(pr, taxpayer);
    };
}
pub relation compromise_other_remedy_sought(pr: Proceeding, taxpayer: Person) kind empirical;
@source(IRC_S7435_A, relation = formalizes, coverage = exact, quote = "Such civil action shall be the exclusive remedy for recovering damages resulting from such actions.")
pub rule S7435aExclusiveRemedyRule defeasible {
    label en official "Such civil action shall be the exclusive remedy for recovering damages resulting from such actions.";
    for pr: Proceeding;
    for taxpayer: Person;
    when compromise_action_permitted(pr, taxpayer);
    then immunity S7435aExclusiveRemedyImmunity {
        holder us.irc.core::Secretary;
        protected_effect compromise_other_remedy_sought(pr, taxpayer);
        window [-infinity, infinity];
    };
}
pub relation compromise_damages_claimed(pr: Proceeding, taxpayer: Person, actualDirect: Money, actionCosts: Money, excludedPenaltiesAndSanctions: Money) kind empirical {
    label en official "actual, direct economic damages sustained by the plaintiff as a proximate result of the information disclosure, and the costs of the action; damages do not include the taxpayer's liability for civil or criminal penalties, or other losses attributable to incarceration or the imposition of other criminal sanctions";
}
pub relation compromise_damages_sum(pr: Proceeding, taxpayer: Person, total: Money) kind institutional;
@source(IRC_S7435_B, relation = formalizes, coverage = exact, quote = "Damages shall not include the taxpayer's liability for any civil or criminal penalties, or other losses attributable to incarceration or the imposition of other criminal sanctions.")
pub rule S7435bDamagesSumExcludingPenalties strict {
    label en official "Damages shall not include the taxpayer's liability for any civil or criminal penalties, or other losses attributable to incarceration or the imposition of other criminal sanctions.";
    for pr: Proceeding;
    for taxpayer: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    for excluded: Money;
    when compromise_damages_claimed(pr, taxpayer, actualDirect, actionCosts, excluded)
        and excluded <= actualDirect;
    then compromise_damages_sum(pr, taxpayer, (actualDirect - excluded) + actionCosts);
}
pub relation compromise_damages_awarded(pr: Proceeding, taxpayer: Person, amount: Money) kind institutional;
@source(IRC_S7435_B, relation = formalizes, coverage = exact, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $500,000 or the sum of—")
pub rule S7435bCapApplies strict {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $500,000 or the sum of—";
    for pr: Proceeding;
    for taxpayer: Person;
    for total: Money;
    when compromise_damages_sum(pr, taxpayer, total)
        and total > 500000.00 USD;
    then compromise_damages_awarded(pr, taxpayer, 500000.00 USD);
}
@source(IRC_S7435_B, relation = formalizes, coverage = exact, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $500,000 or the sum of—")
pub rule S7435bUnderCap strict {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $500,000 or the sum of—";
    for pr: Proceeding;
    for taxpayer: Person;
    for total: Money;
    when compromise_damages_sum(pr, taxpayer, total)
        and total <= 500000.00 USD;
    then compromise_damages_awarded(pr, taxpayer, total);
}
pub relation compromise_actions_discoverable_on(pr: Proceeding, taxpayer: Person, on: Date) kind empirical {
    label en official "the date the actions creating such liability would have been discovered by exercise of reasonable care";
}
pub relation compromise_action_filed_on(pr: Proceeding, taxpayer: Person, on: Date) kind empirical;
pub relation compromise_action_timely(pr: Proceeding, taxpayer: Person) kind institutional;
@source(IRC_S7435_D, relation = formalizes, coverage = exact, quote = "an action to enforce liability created under this section may be brought without regard to the amount in controversy and may be brought only within 2 years after the date the actions creating such liability would have been discovered by exercise of reasonable care.")
pub rule S7435dTwoYearsAfterDiscovery defeasible {
    label en official "an action to enforce liability created under this section may be brought without regard to the amount in controversy and may be brought only within 2 years after the date the actions creating such liability would have been discovered by exercise of reasonable care.";
    for pr: Proceeding;
    for taxpayer: Person;
    for discoveredOn: Date;
    for filedOn: Date;
    when compromise_actions_discoverable_on(pr, taxpayer, discoveredOn)
        and compromise_action_filed_on(pr, taxpayer, filedOn)
        and add_calendar_period(discoveredOn, 2 calendar_year) >= filedOn;
    then compromise_action_timely(pr, taxpayer);
}
pub relation commissioner_certifies_ongoing_investigation_on(pr: Proceeding, taxpayer: Person, on: Date) kind empirical {
    label en official "a certification by the Commissioner or the Commissioner's delegate that there is an ongoing investigation or prosecution of the taxpayer";
}
pub relation compromise_proceedings_stayed(pr: Proceeding) kind empirical;
@source(IRC_S7435_E, relation = formalizes, coverage = exact, quote = "the district court before which an action under this section is pending shall stay all proceedings with respect to such action pending the conclusion of the investigation or prosecution.")
pub rule S7435eMandatoryStayDutyRule strict {
    label en official "the district court before which an action under this section is pending shall stay all proceedings with respect to such action pending the conclusion of the investigation or prosecution.";
    for pr: Proceeding;
    for taxpayer: Person;
    for certifiedOn: Date;
    when commissioner_certifies_ongoing_investigation_on(pr, taxpayer, certifiedOn);
    then duty S7435eStayProceedings {
        bearer us.irc.core::DistrictCourt;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition compromise_proceedings_stayed(pr);
            window [certifiedOn, infinity];
        }
    };
}
