// Stage 2c (IRC-07, A05). Section 1017 (discharge of indebtedness: basis
// reduction), section 1060 (allocation of consideration in applicable asset
// acquisitions) and section 1061 (partnership interests held in connection
// with the performance of services).
//
// Modelling notes.
//  * §1017(a)/(b)(1): which properties absorb the reduction is set by
//    regulations (EXTERNAL_DEPENDENCY); the module computes the amount of the
//    reduction and the ceiling, not the allocation among properties.
//  * §1017(b)(4): the order of reduction (depreciable, then farmland, then
//    other) is an ordered running allocation (TECH-GAPS G2315); the module
//    classifies each property into its tier.
//  * §1060(a): the allocation "in the same manner as under §338(b)(5)" is the
//    class I-VII residual method, an order-dependent allocation with FMV caps
//    (TECH-GAPS G2316); the binding-agreement rule is executable.

// =============================================================================
// §1017: discharge of indebtedness — basis reduction
// =============================================================================

use self::{
    Asset,
    IRC_S1017_A,
    IRC_S1017_B,
    IRC_S1017_C,
    IRC_S1017_D,
    IRC_S1060_A,
    IRC_S1060_B,
    IRC_S1060_C,
    IRC_S1060_D,
    IRC_S1060_E,
    IRC_S1061_A,
    IRC_S1061_C,
    IRC_S1061_D,
    Person,
    TaxableYear,
    Transaction,
};

pub relation discharge_excluded_under_108a(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1017(a)(1): an amount is excluded from gross income under section 108(a) (discharge of indebtedness)";
}
pub relation portion_applied_to_reduce_basis_108(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1017(a)(2): the portion of the excluded amount which under section 108(b)(2)(E), (b)(5) or (c)(1) is to be applied to reduce basis";
}
pub relation discharge_in_title_11_or_insolvency(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1017(b)(2): a discharge to which subparagraph (A) or (B) of section 108(a)(1) applies (title 11 case or insolvency)";
}
pub relation election_under_108b5_made(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1017(b)(2), last sentence: the reduction is by reason of an election under section 108(b)(5)";
}
pub relation aggregate_basis_of_property_after_discharge(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1017(b)(2)(A): the aggregate of the bases of the property held by the taxpayer immediately after the discharge";
}
pub relation aggregate_liabilities_after_discharge(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1017(b)(2)(B): the aggregate of the liabilities of the taxpayer immediately after the discharge";
}
pub relation basis_reduction_ceiling_1017b2(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1017(b)(2): the reduction in basis does not exceed the excess of aggregate basis over aggregate liabilities immediately after the discharge";
}
@source(IRC_S1017_B, relation = formalizes, coverage = partial, quote = "the reduction in basis under subsection (a) of this section shall not exceed the excess of—")
rule BasisReductionCeilingPositiveRule(p: Person, y: TaxableYear, bases: Money, liabilities: Money) defeasible {
    label en official "section 1017(b)(2)";
    when discharge_in_title_11_or_insolvency(p, y);
    when aggregate_basis_of_property_after_discharge(p, y, bases);
    when aggregate_liabilities_after_discharge(p, y, liabilities);
    when bases > liabilities;
    then basis_reduction_ceiling_1017b2(p, y, bases - liabilities);
}
rule BasisReductionCeilingZeroRule(p: Person, y: TaxableYear, bases: Money, liabilities: Money) defeasible {
    label en official "section 1017(b)(2): the ceiling is zero when liabilities are at least the bases";
    when discharge_in_title_11_or_insolvency(p, y);
    when aggregate_basis_of_property_after_discharge(p, y, bases);
    when aggregate_liabilities_after_discharge(p, y, liabilities);
    when bases <= liabilities;
    then basis_reduction_ceiling_1017b2(p, y, 0.00 USD);
}
pub relation section_1017_basis_reduction_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1017(a), (b)(1)-(2): the amount of the basis reduction to be applied to property held at the beginning of the following taxable year";
}
@source(IRC_S1017_A, relation = formalizes, coverage = partial, quote = "then such portion shall be applied in reduction of the basis of any property held by the taxpayer at the beginning of the taxable year following the taxable year in which the discharge occurs.")
rule BasisReductionUncappedRule(p: Person, y: TaxableYear, ex: Money, portion: Money) defeasible {
    label en official "section 1017(a): the reduction is the portion of the excluded amount to be applied to basis (no (b)(2) ceiling applies outside title 11 / insolvency discharges, or under a section 108(b)(5) election)";
    when discharge_excluded_under_108a(p, y, ex);
    when portion_applied_to_reduce_basis_108(p, y, portion);
    when not_known(discharge_in_title_11_or_insolvency(p, y));
    then section_1017_basis_reduction_amount(p, y, portion);
}
rule BasisReductionElectionExemptFromCeilingRule(p: Person, y: TaxableYear, ex: Money, portion: Money) defeasible {
    label en official "section 1017(b)(2), last sentence: a section 108(b)(5) election is not subject to the ceiling";
    when discharge_excluded_under_108a(p, y, ex);
    when portion_applied_to_reduce_basis_108(p, y, portion);
    when discharge_in_title_11_or_insolvency(p, y);
    when election_under_108b5_made(p, y);
    then section_1017_basis_reduction_amount(p, y, portion);
}
rule BasisReductionCappedRule(p: Person, y: TaxableYear, ex: Money, portion: Money, ceiling: Money) defeasible {
    label en official "section 1017(b)(2): the reduction is the lesser of the portion and the ceiling";
    when discharge_excluded_under_108a(p, y, ex);
    when portion_applied_to_reduce_basis_108(p, y, portion);
    when discharge_in_title_11_or_insolvency(p, y);
    when basis_reduction_ceiling_1017b2(p, y, ceiling);
    when not_known(election_under_108b5_made(p, y));
    then section_1017_basis_reduction_amount(p, y, min(portion, ceiling));
}

// (b)(3): depreciable property
pub relation property_held_at_beginning_of_year_after_discharge(p: Person, y: TaxableYear, a: Asset) kind empirical {
    label en official "section 1017(a): property held by the taxpayer at the beginning of the taxable year following the taxable year of the discharge";
}
pub relation property_subject_to_depreciation_allowance(a: Asset) kind empirical {
    label en official "section 1017(b)(3)(B): property of a character subject to the allowance for depreciation";
}
pub relation reduction_would_reduce_depreciation_or_amortization(a: Asset) kind empirical {
    label en official "section 1017(b)(3)(B): a basis reduction under subsection (a) will reduce the depreciation or amortization otherwise allowable for the period immediately following the reduction";
}
pub relation partnership_interest_proportionate_depreciable_share(a: Asset) kind empirical {
    label en official "section 1017(b)(3)(C): a partnership interest, to the extent of the partner's proportionate interest in the partnership's depreciable property, when the partnership's basis is correspondingly reduced";
}
pub relation subsidiary_stock_with_consented_basis_reduction(a: Asset) kind empirical {
    label en official "section 1017(b)(3)(D): stock of a subsidiary in a consolidated group, to the extent the subsidiary consents to a corresponding reduction in the basis of its depreciable property";
}
pub relation real_property_described_in_1221a1(a: Asset) kind empirical {
    label en official "section 1017(b)(3)(E)(i): real property described in section 1221(a)(1)";
}
pub relation election_1017b3e_made_on_return_for_discharge_year(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1017(b)(3)(E)(ii): the election is made on the return for the taxable year of the discharge (or at another time regulations permit)";
}
pub relation election_1017b3e_to_include_inventory_real_property(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1017(b)(3)(E)(i): the taxpayer elects that depreciable property includes real property described in section 1221(a)(1)";
}
pub relation inventory_real_property_treated_as_depreciable(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1017(b)(3)(E): depreciable property includes real property described in section 1221(a)(1)";
}
@source(IRC_S1017_B, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer, for purposes of this section, the term \"depreciable property\" includes any real property which is described in section 1221(a)(1).")
rule Section1017b3eElectionPower(p: Person, y: TaxableYear) strict {
    label en official "section 1017(b)(3)(E): the taxpayer's election widens the class of depreciable property; valid when made on the return for the discharge year (revocable only with the Secretary's consent)";
    when election_1017b3e_to_include_inventory_real_property(p, y);
    then power Section1017b3eElection {
        holder p;
        over y;
        exercise election_1017b3e_to_include_inventory_real_property(p, y);
        valid_when election_1017b3e_timely(p, y);
        effect create(inventory_real_property_treated_as_depreciable(p, y));
        window [@1993-08-10, infinity);
    };
}
relation election_1017b3e_timely(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "single-atom helper for valid_when (§130.3)";
}
@source(IRC_S1017_B, relation = formalizes, coverage = partial, quote = "An election under clause (i) shall be made on the taxpayer's return for the taxable year in which the discharge occurs or at such other time as may be permitted in regulations prescribed by the Secretary.")
rule Election1017b3eTimelyRule(p: Person, y: TaxableYear) defeasible {
    label en official "section 1017(b)(3)(E)(ii)";
    when election_1017b3e_made_on_return_for_discharge_year(p, y);
    then election_1017b3e_timely(p, y);
}
pub relation depreciable_property_1017(p: Person, y: TaxableYear, a: Asset) kind institutional {
    label en official "section 1017(b)(3): depreciable property for the basis reduction";
}
@source(IRC_S1017_B, relation = formalizes, coverage = exact, quote = "the term \"depreciable property\" means any property of a character subject to the allowance for depreciation, but only if a basis reduction under subsection (a) will reduce the amount of depreciation or amortization which otherwise would be allowable for the period immediately following such reduction.")
rule DepreciablePropertyRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(3)(B)";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when property_subject_to_depreciation_allowance(a);
    when reduction_would_reduce_depreciation_or_amortization(a);
    then depreciable_property_1017(p, y, a);
}
@source(IRC_S1017_B, relation = formalizes, coverage = partial, quote = "any interest of a partner in a partnership shall be treated as depreciable property to the extent of such partner's proportionate interest in the depreciable property held by such partnership.")
rule DepreciablePartnershipInterestRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(3)(C): a partnership interest counts as depreciable property to the extent of the proportionate interest, with a corresponding partnership basis reduction (asserted as one case fact)";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when partnership_interest_proportionate_depreciable_share(a);
    then depreciable_property_1017(p, y, a);
}
@source(IRC_S1017_B, relation = formalizes, coverage = partial, quote = "such stock shall be treated as depreciable property to the extent that such subsidiary consents to a corresponding reduction in the basis of its depreciable property.")
rule DepreciableSubsidiaryStockRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(3)(D): consolidated-group subsidiary stock counts as depreciable property to the extent of the subsidiary's consented reduction";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when subsidiary_stock_with_consented_basis_reduction(a);
    then depreciable_property_1017(p, y, a);
}
rule DepreciableInventoryRealPropertyRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(3)(E): real property described in section 1221(a)(1) counts when the election is in effect";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when real_property_described_in_1221a1(a);
    when inventory_real_property_treated_as_depreciable(p, y);
    then depreciable_property_1017(p, y, a);
}
pub relation reduction_under_108b5_or_108c1(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1017(b)(3)(A): the amount is to be applied to reduce basis under section 108(b)(5) or (c)(1)";
}
pub relation basis_reduction_may_reduce_asset_1017b3a(p: Person, y: TaxableYear, a: Asset) kind institutional {
    label en official "section 1017(b)(3)(A): an amount under section 108(b)(5) or (c)(1) reduces only the basis of depreciable property";
}
@source(IRC_S1017_B, relation = formalizes, coverage = exact, quote = "shall be applied only to reduce the basis of depreciable property held by the taxpayer.")
rule OnlyDepreciablePropertyReducedRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(3)(A)";
    when reduction_under_108b5_or_108c1(p, y);
    when depreciable_property_1017(p, y, a);
    then basis_reduction_may_reduce_asset_1017b3a(p, y, a);
}

// (b)(4): qualified farm indebtedness — the tier of each property
pub enum FarmBasisReductionTier {
    FirstDepreciableQualifiedProperty;
    SecondFarmlandQualifiedProperty;
    ThirdOtherQualifiedProperty;
    label en official "the order of reduction of qualified property (section 1017(b)(4)(A)(ii)(I)-(III))";
}
pub relation qualified_property_108g3c(a: Asset) kind empirical {
    label en official "section 1017(b)(4)(B): qualified property as defined in section 108(g)(3)(C)";
}
pub relation land_used_in_farming_business(a: Asset) kind empirical {
    label en official "section 1017(b)(4)(A)(ii)(II): land used or held for use in the trade or business of farming";
}
pub relation farm_indebtedness_reduction_tier(p: Person, y: TaxableYear, a: Asset, tier: FarmBasisReductionTier) kind institutional {
    label en official "section 1017(b)(4)(A): qualified farm indebtedness reduces qualified property only, depreciable property first, then farmland, then other";
}
@source(IRC_S1017_B, relation = formalizes, coverage = partial, quote = "(I) First the basis of qualified property which is depreciable property.")
rule FarmTierFirstRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(4)(A)(ii)(I)";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when qualified_property_108g3c(a);
    when depreciable_property_1017(p, y, a);
    then farm_indebtedness_reduction_tier(p, y, a, FirstDepreciableQualifiedProperty);
}
@source(IRC_S1017_B, relation = formalizes, coverage = partial, quote = "(II) Second the basis of qualified property which is land used or held for use in the trade or business of farming.")
rule FarmTierSecondRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(4)(A)(ii)(II)";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when qualified_property_108g3c(a);
    when land_used_in_farming_business(a);
    when not_known(depreciable_property_1017(p, y, a));
    then farm_indebtedness_reduction_tier(p, y, a, SecondFarmlandQualifiedProperty);
}
@source(IRC_S1017_B, relation = formalizes, coverage = partial, quote = "(III) Then the basis of other qualified property.")
rule FarmTierThirdRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(4)(A)(ii)(III)";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when qualified_property_108g3c(a);
    when not_known(depreciable_property_1017(p, y, a));
    when not_known(land_used_in_farming_business(a));
    then farm_indebtedness_reduction_tier(p, y, a, ThirdOtherQualifiedProperty);
}

// (c): exempt property and non-disposition
pub relation property_treated_as_exempt_under_522(p: Person, a: Asset) kind empirical {
    label en official "section 1017(c)(1): property which the debtor treats as exempt property under section 522 of title 11";
}
pub relation discharge_under_108a1A(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1017(c)(1): an amount excluded under section 108(a)(1)(A) (title 11 case)";
}
pub relation basis_of_asset_exempt_from_reduction_1017c(p: Person, y: TaxableYear, a: Asset) kind institutional {
    label en official "section 1017(c)(1): no reduction is made in the basis of exempt property under section 522";
}
@source(IRC_S1017_C, relation = formalizes, coverage = exact, quote = "no reduction in basis shall be made under this section in the basis of property which the debtor treats as exempt property under section 522 of title 11 of the United States Code.")
rule ExemptPropertyNotReducedRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(c)(1)";
    when discharge_under_108a1A(p, y);
    when property_treated_as_exempt_under_522(p, a);
    then basis_of_asset_exempt_from_reduction_1017c(p, y, a);
}
pub relation reduction_in_basis_under_1017(t: Transaction) kind empirical {
    label en official "section 1017(c)(2): a reduction in basis under this section";
}
pub relation section_1017_reduction_not_a_disposition(t: Transaction) kind institutional {
    label en official "section 1017(c)(2): the reduction is not treated as a disposition for purposes of this title";
}
@source(IRC_S1017_C, relation = formalizes, coverage = exact, quote = "For purposes of this title, a reduction in basis under this section shall not be treated as a disposition.")
rule ReductionNotADispositionRule(t: Transaction) strict {
    label en official "section 1017(c)(2)";
    when reduction_in_basis_under_1017(t);
    then section_1017_reduction_not_a_disposition(t);
}

// (d): recapture treatment
pub relation property_neither_1245_nor_1250(a: Asset) kind empirical {
    label en official "section 1017(d)(1)(A): the property is neither section 1245 property nor section 1250 property";
}
pub relation property_basis_reduced_under_1017(a: Asset, amount: Money) kind empirical {
    label en official "section 1017(d)(1): the property's basis is reduced under this section by the amount";
}
pub relation treated_as_section_1245_property_1017d(a: Asset) kind institutional {
    label en official "section 1017(d)(1)(A): the property is treated as section 1245 property";
}
pub relation reduction_treated_as_depreciation_deduction_1017d(a: Asset, amount: Money) kind institutional {
    label en official "section 1017(d)(1)(B): any reduction under this section is treated as a deduction allowed for depreciation";
}
@source(IRC_S1017_D, relation = formalizes, coverage = exact, quote = "any property the basis of which is reduced under this section and which is neither section 1245 property nor section 1250 property shall be treated as section 1245 property, and")
rule ReducedPropertyTreatedAsSection1245Rule(a: Asset, amount: Money) defeasible {
    label en official "section 1017(d)(1)(A)";
    when property_basis_reduced_under_1017(a, amount);
    when property_neither_1245_nor_1250(a);
    then treated_as_section_1245_property_1017d(a);
}
@source(IRC_S1017_D, relation = formalizes, coverage = exact, quote = "any reduction under this section shall be treated as a deduction allowed for depreciation.")
rule ReductionTreatedAsDepreciationRule(a: Asset, amount: Money) defeasible {
    label en official "section 1017(d)(1)(B)";
    when property_basis_reduced_under_1017(a, amount);
    then reduction_treated_as_depreciation_deduction_1017d(a, amount);
}

// =============================================================================
// §1060: applicable asset acquisitions
// =============================================================================

pub relation transfer_of_assets_constituting_a_trade_or_business(t: Transaction) kind empirical {
    label en official "section 1060(c)(1): a transfer (directly or indirectly) of assets which constitute a trade or business";
}
pub relation transferee_basis_determined_wholly_by_consideration_paid(t: Transaction) kind empirical {
    label en official "section 1060(c)(2): the transferee's basis in the assets is determined wholly by reference to the consideration paid";
}
pub relation applicable_asset_acquisition(t: Transaction) kind institutional {
    label en official "section 1060(c): an applicable asset acquisition";
}
@source(IRC_S1060_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"applicable asset acquisition\" means any transfer (whether directly or indirectly)—")
rule ApplicableAssetAcquisitionRule(t: Transaction) defeasible {
    label en official "section 1060(c)(1)-(2); the last sentence (section 1031 applying to a portion does not defeat) holds because no section 1031 fact is read";
    when transfer_of_assets_constituting_a_trade_or_business(t);
    when transferee_basis_determined_wholly_by_consideration_paid(t);
    then applicable_asset_acquisition(t);
}
pub relation transferor_of(t: Transaction, p: Person) kind empirical {
    label en unofficial "the transferor in the acquisition";
}
pub relation transferee_of(t: Transaction, p: Person) kind empirical {
    label en unofficial "the transferee in the acquisition";
}
pub relation written_agreement_on_allocation_or_asset_value(t: Transaction) kind empirical {
    label en official "section 1060(a): the transferee and transferor agree in writing as to the allocation of any consideration, or as to the fair market value of any of the assets";
}
external judgment relation secretary_determines_allocation_agreement_inappropriate_1060a(t: Transaction) {
    authority Secretary;
    label en official "the Secretary determines that the allocation (or fair market value) is not appropriate (section 1060(a), second sentence)";
}
pub relation allocation_agreement_binding_1060a(t: Transaction) kind institutional {
    label en official "section 1060(a): the written agreement is binding on both the transferee and the transferor";
}
@source(IRC_S1060_A, relation = formalizes, coverage = partial, quote = "such agreement shall be binding on both the transferee and transferor unless the Secretary determines that such al")
rule AllocationAgreementBindingRule(t: Transaction) defeasible {
    label en official "section 1060(a): binding unless the Secretary determines the allocation inappropriate (DECISION-0194: external judgment, authority Secretary)";
    when applicable_asset_acquisition(t);
    when written_agreement_on_allocation_or_asset_value(t);
    unless secretary_determines_allocation_agreement_inappropriate_1060a(t);
    then allocation_agreement_binding_1060a(t);
}
pub relation section_197_intangibles_consideration(t: Transaction, amount: Money) kind empirical {
    label en official "section 1060(b)(1): the amount of the consideration received for the assets which is allocated to section 197 intangibles";
}
pub relation applicable_asset_acquisition_information_furnished(t: Transaction, p: Person) kind empirical {
    label en official "section 1060(b): the person furnished the required information to the Secretary";
}
@source(IRC_S1060_B, relation = formalizes, coverage = partial, quote = "the transferor and transferee in an applicable asset acquisition shall, at such times and in such manner as may be provided in such regulations, furnish to the Secretary the following information:")
rule TransferorInformationDuty(t: Transaction, p: Person) defeasible {
    label en official "section 1060(b): the transferor must furnish the information; time and manner are by regulations (EXTERNAL_DEPENDENCY), so the window is unbounded";
    when applicable_asset_acquisition(t);
    when transferor_of(t, p);
    then duty TransferorInformationDutyPosition {
        bearer p;
        beneficiary p;
        goal achievement {
            condition applicable_asset_acquisition_information_furnished(t, p);
            window [-infinity, infinity];
        }
    };
}
rule TransfereeInformationDuty(t: Transaction, p: Person) defeasible {
    label en official "section 1060(b): the transferee must furnish the information";
    when applicable_asset_acquisition(t);
    when transferee_of(t, p);
    then duty TransfereeInformationDutyPosition {
        bearer p;
        beneficiary p;
        goal achievement {
            condition applicable_asset_acquisition_information_furnished(t, p);
            window [-infinity, infinity];
        }
    };
}
pub relation partnership_distribution_or_interest_transfer_with_section_755(t: Transaction) kind empirical {
    label en official "section 1060(d): a distribution of partnership property or a transfer of a partnership interest to which section 755 applies";
}
pub relation treated_as_applicable_asset_acquisition_for_reporting_1060d2(t: Transaction) kind institutional {
    label en official "section 1060(d)(2): if section 755 applies, the distribution or transfer is treated as an applicable asset acquisition for purposes of subsection (b)";
}
@source(IRC_S1060_D, relation = formalizes, coverage = partial, quote = "(2) if section 755 applies, such distribution or transfer (as the case may be) shall be treated as an applicable asset acquisition for purposes of subsection (b).")
rule Section1060dReportingRule(t: Transaction) defeasible {
    label en official "section 1060(d)(2)";
    when partnership_distribution_or_interest_transfer_with_section_755(t);
    then treated_as_applicable_asset_acquisition_for_reporting_1060d2(t);
}
pub relation owner_interest_share_before_transfer(o: Person, ent: Person, share: Decimal) kind empirical {
    label en official "section 1060(e)(2)(A): the share (by value) of the interests in the entity held by the person immediately before the transfer, with section 318 (or similar principles) attribution (case-supplied share)";
}
pub const Section1060TenPercentThreshold: Decimal = 0.10 {
    label en official "10 percent or more (by value) (section 1060(e)(2)(A))";
};
pub relation ten_percent_owner_1060e(o: Person, ent: Person) kind institutional {
    label en official "section 1060(e)(2)(A): a 10-percent owner of the entity";
}
@source(IRC_S1060_E, relation = formalizes, coverage = exact, quote = "The term \"10-percent owner\" means, with respect to any entity, any person who holds 10 percent or more (by value) of the interests in such entity immediately before the transfer.")
rule TenPercentOwnerRule(o: Person, ent: Person, share: Decimal) defeasible {
    label en official "section 1060(e)(2)(A)";
    when owner_interest_share_before_transfer(o, ent, share);
    when share >= Section1060TenPercentThreshold;
    then ten_percent_owner_1060e(o, ent);
}
pub relation ten_percent_owner_transfers_interest_in_entity(t: Transaction, o: Person, ent: Person, transferee: Person) kind empirical {
    label en official "section 1060(e)(1)(A): a 10-percent owner transfers an interest in the entity to the transferee";
}
pub relation owner_or_related_person_enters_side_agreement_with_transferee(t: Transaction, o: Person) kind empirical {
    label en official "section 1060(e)(1)(B): the owner (or a related person) enters into an employment contract, covenant not to compete, royalty or lease agreement, or other agreement with the transferee in connection with the transfer";
}
pub relation side_agreement_information_furnished(t: Transaction, p: Person) kind empirical {
    label en official "section 1060(e)(1): the person furnished the information the Secretary requires";
}
@source(IRC_S1060_E, relation = formalizes, coverage = partial, quote = "such owner and the transferee shall, at such time and in such manner as the Secretary may prescribe, furnish such information as the Secretary may require.")
rule TenPercentOwnerReportingOwnerDuty(t: Transaction, o: Person, ent: Person, transferee: Person) defeasible {
    label en official "section 1060(e)(1): the 10-percent owner furnishes the information; time and manner are prescribed by the Secretary (EXTERNAL_DEPENDENCY)";
    when ten_percent_owner_transfers_interest_in_entity(t, o, ent, transferee);
    when ten_percent_owner_1060e(o, ent);
    when owner_or_related_person_enters_side_agreement_with_transferee(t, o);
    then duty TenPercentOwnerInformationDutyPosition {
        bearer o;
        beneficiary o;
        goal achievement {
            condition side_agreement_information_furnished(t, o);
            window [-infinity, infinity];
        }
    };
}
rule TenPercentOwnerReportingTransfereeDuty(t: Transaction, o: Person, ent: Person, transferee: Person) defeasible {
    label en official "section 1060(e)(1): the transferee furnishes the information";
    when ten_percent_owner_transfers_interest_in_entity(t, o, ent, transferee);
    when ten_percent_owner_1060e(o, ent);
    when owner_or_related_person_enters_side_agreement_with_transferee(t, o);
    then duty TransfereeSideAgreementInformationDutyPosition {
        bearer transferee;
        beneficiary transferee;
        goal achievement {
            condition side_agreement_information_furnished(t, transferee);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// §1061: partnership interests held in connection with the performance of services
// =============================================================================

pub relation net_ltcg_on_applicable_interests_one_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1061(a)(1): the taxpayer's net long-term capital gain with respect to applicable partnership interests for the year";
}
pub relation net_ltcg_on_applicable_interests_three_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1061(a)(2): the net long-term capital gain computed by applying section 1222(3) and (4) with 3 years substituted for 1 year";
}
pub relation holds_applicable_partnership_interest_during_year(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1061(a): one or more applicable partnership interests are held by the taxpayer at any time during the taxable year";
}
pub relation section_1061_short_term_recharacterization(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1061(a): the excess treated as short-term capital gain, notwithstanding section 83 or a section 83(b) election";
}
@source(IRC_S1061_A, relation = formalizes, coverage = exact, quote = "shall be treated as short-term capital gain, notwithstanding section 83 or any election in effect under section 83(b).")
rule Section1061RecharacterizationRule(p: Person, y: TaxableYear, one_year: Money, three_year: Money) defeasible {
    label en official "section 1061(a): (1) minus (2), when positive";
    when holds_applicable_partnership_interest_during_year(p, y);
    when net_ltcg_on_applicable_interests_one_year(p, y, one_year);
    when net_ltcg_on_applicable_interests_three_year(p, y, three_year);
    when one_year > three_year;
    then section_1061_short_term_recharacterization(p, y, one_year - three_year);
}
rule Section1061NoExcessRule(p: Person, y: TaxableYear, one_year: Money, three_year: Money) defeasible {
    label en official "section 1061(a): no recharacterization when the three-year computation is not smaller";
    when holds_applicable_partnership_interest_during_year(p, y);
    when net_ltcg_on_applicable_interests_one_year(p, y, one_year);
    when net_ltcg_on_applicable_interests_three_year(p, y, three_year);
    when one_year <= three_year;
    then section_1061_short_term_recharacterization(p, y, 0.00 USD);
}
pub relation interest_transferred_or_held_for_substantial_services_in_applicable_trade_or_business(p: Person, pi: Asset) kind empirical {
    label en official "section 1061(c)(1): an interest in a partnership which is transferred to (or held by) the taxpayer in connection with the performance of substantial services by the taxpayer or a related person in an applicable trade or business";
}
pub relation activity_raises_or_returns_capital(p: Person) kind empirical {
    label en official "section 1061(c)(2)(A): the activity consists of raising or returning capital";
}
pub relation activity_invests_in_or_develops_specified_assets(p: Person) kind empirical {
    label en official "section 1061(c)(2)(B): the activity consists of investing in (or disposing of, or identifying) specified assets, or developing specified assets";
}
pub relation activity_regular_continuous_and_substantial(p: Person) kind empirical {
    label en official "section 1061(c)(2): the activity is conducted on a regular, continuous and substantial basis, in one or more entities";
}
pub relation applicable_trade_or_business_1061(p: Person) kind institutional {
    label en official "section 1061(c)(2): an applicable trade or business";
}
@source(IRC_S1061_C, relation = formalizes, coverage = exact, quote = "The term \"applicable trade or business\" means any activity conducted on a regular, continuous, and substantial basis which, regardless of whether the activity is conducted in one or more entities, consists, in whole or in part, of—")
rule ApplicableTradeOrBusinessRule(p: Person) defeasible {
    label en official "section 1061(c)(2)(A)-(B)";
    when activity_regular_continuous_and_substantial(p);
    when activity_raises_or_returns_capital(p);
    when activity_invests_in_or_develops_specified_assets(p);
    then applicable_trade_or_business_1061(p);
}
pub relation interest_held_by_corporation_1061c4a(pi: Asset) kind empirical {
    label en official "section 1061(c)(4)(A): the interest is directly or indirectly held by a corporation";
}
pub relation capital_interest_commensurate_with_contribution_or_taxed_value(pi: Asset) kind empirical {
    label en official "section 1061(c)(4)(B): a capital interest providing a right to share in capital commensurate with the capital contributed, or with the value subject to tax under section 83";
}
pub relation employee_of_other_non_applicable_business_serving_only_it(p: Person) kind empirical {
    label en official "section 1061(c)(1), second sentence: an interest held by a person employed by another entity conducting a trade or business (other than an applicable trade or business) who only provides services to that entity";
}
pub relation applicable_partnership_interest(p: Person, pi: Asset) kind institutional {
    label en official "section 1061(c): an applicable partnership interest";
}
@source(IRC_S1061_C, relation = formalizes, coverage = partial, quote = "the term \"applicable partnership interest\" means any interest in a partnership which, directly or indirectly, is transferred to (or is held by) the taxpayer in connection with the performance of substantial services by the taxpayer, or any other related person, in any applicable trade or business.")
rule ApplicablePartnershipInterestRule(p: Person, pi: Asset) defeasible {
    label en official "section 1061(c)(1) with the (c)(4) exclusions and the employee carve-out";
    when interest_transferred_or_held_for_substantial_services_in_applicable_trade_or_business(p, pi);
    when not_known(interest_held_by_corporation_1061c4a(pi));
    when not_known(capital_interest_commensurate_with_contribution_or_taxed_value(pi));
    when not_known(employee_of_other_non_applicable_business_serving_only_it(p));
    then applicable_partnership_interest(p, pi);
}
pub relation holds_interest_not_constituting_applicable_trade_or_business_property(p: Person) kind empirical {
    label en official "section 1061(c)(5)(A): the person holds an interest in the partnership which does not constitute property held in connection with an applicable trade or business";
}
pub relation actively_engaged_or_related_to_person_providing_substantial_services(p: Person) kind empirical {
    label en official "section 1061(c)(5)(B): the person is (or has been) actively engaged, or is (or was) related to a person engaged, in providing the substantial services";
}
pub relation third_party_investor(p: Person) kind institutional {
    label en official "section 1061(c)(5): a third party investor";
}
@source(IRC_S1061_C, relation = formalizes, coverage = exact, quote = "The term \"third party investor\" means a person who—")
rule ThirdPartyInvestorRule(p: Person) defeasible {
    label en official "section 1061(c)(5)(A)-(B)";
    when holds_interest_not_constituting_applicable_trade_or_business_property(p);
    when not_known(actively_engaged_or_related_to_person_providing_substantial_services(p));
    then third_party_investor(p);
}
pub relation transfers_applicable_interest_to_related_person(p: Person, pi: Asset, transferee: Person) kind empirical {
    label en official "section 1061(d)(1): the taxpayer transfers an applicable partnership interest, directly or indirectly, to a person related to the taxpayer";
}
pub relation transferee_is_family_member_318a1(p: Person, transferee: Person) kind institutional {
    label en official "section 1061(d)(2)(A): the person is a member of the taxpayer's family within the meaning of section 318(a)(1); derived in 53-wire9-owner-contracts.law from the family relations of `us.irc.corporations`, a case may still assert it directly";
}
pub relation transferee_performed_service_in_same_applicable_business_within_window(p: Person, transferee: Person) kind empirical {
    label en official "section 1061(d)(2)(B): the person performed a service within the current calendar year or the preceding three calendar years in an applicable trade or business in which or for which the taxpayer performed a service";
}
pub relation related_for_1061d(p: Person, transferee: Person) kind institutional {
    label en official "section 1061(d)(2): a person related to the taxpayer";
}
@source(IRC_S1061_D, relation = formalizes, coverage = partial, quote = "(A) the person is a member of the taxpayer's family within the meaning of section 318(a)(1), or")
rule RelatedFamilyRule(p: Person, transferee: Person) defeasible {
    label en official "section 1061(d)(2)(A)";
    when transferee_is_family_member_318a1(p, transferee);
    then related_for_1061d(p, transferee);
}
@source(IRC_S1061_D, relation = formalizes, coverage = partial, quote = "(B) the person performed a service within the current calendar year or the preceding three calendar years in any applicable trade or business in which or for which the taxpayer performed a service.")
rule RelatedServiceRule(p: Person, transferee: Person) defeasible {
    label en official "section 1061(d)(2)(B)";
    when transferee_performed_service_in_same_applicable_business_within_window(p, transferee);
    then related_for_1061d(p, transferee);
}
pub relation ltcg_on_interest_from_assets_held_not_more_than_3_years(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1061(d)(1)(A): the taxpayer's long-term capital gains with respect to the interest for the year attributable to the sale or exchange of any asset held for not more than 3 years, as allocable to the interest";
}
pub relation short_term_amount_under_1061a_for_transfer(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1061(d)(1)(B): any amount treated as short-term capital gain under subsection (a) with respect to the transfer of the interest";
}
pub relation section_1061_related_transfer_inclusion(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1061(d)(1): the amount included in gross income as short-term capital gain on a transfer to a related person";
}
@source(IRC_S1061_D, relation = formalizes, coverage = exact, quote = "the taxpayer shall include in gross income (as short term capital gain) the excess (if any) of—")
rule Section1061RelatedTransferInclusionRule(p: Person, pi: Asset, transferee: Person, y: TaxableYear, short_hold: Money, already: Money) defeasible {
    label en official "section 1061(d)(1): (A) minus (B), when positive";
    when transfers_applicable_interest_to_related_person(p, pi, transferee);
    when related_for_1061d(p, transferee);
    when ltcg_on_interest_from_assets_held_not_more_than_3_years(p, y, short_hold);
    when short_term_amount_under_1061a_for_transfer(p, y, already);
    when short_hold > already;
    then section_1061_related_transfer_inclusion(p, y, short_hold - already);
}
rule Section1061RelatedTransferNoExcessRule(p: Person, pi: Asset, transferee: Person, y: TaxableYear, short_hold: Money, already: Money) defeasible {
    label en official "section 1061(d)(1): nothing is included when (B) is at least (A)";
    when transfers_applicable_interest_to_related_person(p, pi, transferee);
    when related_for_1061d(p, transferee);
    when ltcg_on_interest_from_assets_held_not_more_than_3_years(p, y, short_hold);
    when short_term_amount_under_1061a_for_transfer(p, y, already);
    when short_hold <= already;
    then section_1061_related_transfer_inclusion(p, y, 0.00 USD);
}

// =============================================================================
// §1017(b)(1): regulation reader (IRC-G/G4, CFR wiring 27.09.2026)
// =============================================================================
// The amount of the reduction and the particular properties are determined
// under regulations (Treas. Reg. 1.1017-1, pinned phase-0 as
// us.cfr.t26_1_1017_1 — addressable, rule-less, not yet a dependency;
// registry/lock gap recorded in cfr-wire STATUS). One case-selected relation
// names the regulation-determined allocation; one rule derives the statutory
// consequence. Existing amount/ceiling rules above are untouched (parallel).
// Coverage row 26/1017/b/1/u1 stays EXTERNAL_DEPENDENCY (flip only after
// execution, owner gate step 6).

relation regulation_determines_reduction_properties_1017b1(p: Person, y: TaxableYear, a: Asset) kind empirical {
    label en official "section 1017(b)(1): the regulation determines that this property's basis is reduced for the discharge year (case-selected: the content of 26 CFR 1.1017-1 enters as case facts)";
}
pub relation property_basis_reduced_under_regulation_1017b1(p: Person, y: TaxableYear, a: Asset) kind institutional {
    label en official "section 1017(b)(1): this property's basis is reduced under the regulation-determined allocation";
}
@source(IRC_S1017_B, relation = formalizes, coverage = partial, quote = "The amount of reduction to be applied under subsection (a) (not in excess of the portion referred to in subsection (a)), and the particular properties the bases of which are to be reduced, shall be determined under regulations prescribed by the Secretary.")
rule S1017B1ReductionPropertiesByRegulation(p: Person, y: TaxableYear, a: Asset) strict {
    label en official "section 1017(b)(1): the regulation-determined property absorbs the reduction";
    when regulation_determines_reduction_properties_1017b1(p, y, a);
    then property_basis_reduced_under_regulation_1017b1(p, y, a);
}
