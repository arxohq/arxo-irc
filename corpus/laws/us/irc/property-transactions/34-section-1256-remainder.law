// Stage 3 (IRC-07, A05). Section 1256 remainder (module 08 carries the mark-to-market
// gain and loss, the 40/60 character and the mixed-straddle election): (a)(2) subsequent
// realization, (a)(4) all-section-1256 straddles, (b) and (g) the contract kinds and
// their definitions, (c) terminations, (d)(3)-(4) the persistence and the mixed straddle,
// (e)(2)-(4) hedging transactions, syndicates and the hedging-loss limit, and (f) the
// character rules.
//
// Method. The contract kind is derived from the (g) definitions; module 08's entity
// Section1256Contract stays the entity a case asserts, and the derived relation
// section_1256_contract_by_definition is exposed for it. The hedging-transaction test
// (e)(2)-(3) is added as an exclusion to the mark-to-market rules of module 08.

// =============================================================================
// (g)(7), (8): qualified board or exchange, options dealer
// =============================================================================

use self::{
    Asset,
    IRC_S1256_A,
    IRC_S1256_B,
    IRC_S1256_C,
    IRC_S1256_D,
    IRC_S1256_E,
    IRC_S1256_F,
    IRC_S1256_G,
    Person,
    Section1256Contract,
    Section1256LongTermFraction,
    Section1256ShortTermFraction,
    TaxableYear,
    section_1256_mark_to_market_loss,
    section_1256_mixed_straddle_election_in_effect,
};

pub relation national_securities_exchange_registered_with_sec(x: Person) kind empirical {
    label en official "section 1256(g)(7)(A): a national securities exchange which is registered with the Securities and Exchange Commission";
}
pub relation domestic_board_of_trade_designated_contract_market(x: Person) kind empirical {
    label en official "section 1256(g)(7)(B): a domestic board of trade designated as a contract market by the Commodity Futures Trading Commission";
}
pub relation other_market_with_rules_determined_adequate_by_secretary(x: Person) kind empirical {
    label en official "section 1256(g)(7)(C): any other exchange, board of trade or market which the Secretary determines has rules adequate to carry out the purposes of the section (a determination of the Secretary)";
}
pub relation qualified_board_or_exchange_1256(x: Person) kind institutional {
    label en official "section 1256(g)(7): a qualified board or exchange";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "(A) a national securities exchange which is registered with the Securities and Exchange Commission,")
rule QualifiedBoardNationalRule(x: Person) defeasible {
    label en official "section 1256(g)(7)(A)";
    when national_securities_exchange_registered_with_sec(x);
    then qualified_board_or_exchange_1256(x);
}
rule QualifiedBoardContractMarketRule(x: Person) defeasible {
    label en official "section 1256(g)(7)(B)";
    when domestic_board_of_trade_designated_contract_market(x);
    then qualified_board_or_exchange_1256(x);
}
rule QualifiedBoardSecretaryRule(x: Person) defeasible {
    label en official "section 1256(g)(7)(C)";
    when other_market_with_rules_determined_adequate_by_secretary(x);
    then qualified_board_or_exchange_1256(x);
}
pub relation registered_market_maker_or_specialist_in_listed_options(p: Person) kind empirical {
    label en official "section 1256(g)(8)(A): a person registered with an appropriate national securities exchange as a market maker or specialist in listed options";
}
pub relation secretary_determines_similar_functions_to_options_dealer(p: Person) kind empirical {
    label en official "section 1256(g)(8)(B): where the Secretary makes a determination under (7)(C), a person whom the Secretary determines performs functions similar to those of persons described in (A) (a determination of the Secretary)";
}
pub relation options_dealer_1256g8(p: Person) kind institutional {
    label en official "section 1256(g)(8): an options dealer";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "The term \"options dealer\" means any person registered with an appropriate national securities exchange as a market maker or specialist in listed options.")
rule OptionsDealerRegisteredRule(p: Person) defeasible {
    label en official "section 1256(g)(8)(A)";
    when registered_market_maker_or_specialist_in_listed_options(p);
    then options_dealer_1256g8(p);
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "In any case in which the Secretary makes a determination under subparagraph (C) of paragraph (7), the term \"options dealer\" also includes any person whom the Secretary determines performs functions similar to the persons described in subparagraph (A).")
rule OptionsDealerDeterminedRule(p: Person) defeasible {
    label en official "section 1256(g)(8)(B)";
    when secretary_determines_similar_functions_to_options_dealer(p);
    then options_dealer_1256g8(p);
}

// =============================================================================
// (g)(1)-(6), (9): the contract kinds
// =============================================================================

pub relation contract_requires_marking_to_market_system(a: Asset) kind empirical {
    label en official "section 1256(g)(1)(A): the amount required to be deposited and the amount which may be withdrawn depends on a system of marking to market";
}
pub relation contract_traded_on_board(a: Asset, board: Person) kind empirical {
    label en official "the contract is traded on, or subject to the rules of, the board or exchange";
}
pub relation regulated_futures_contract_1256(a: Asset) kind institutional {
    label en official "section 1256(g)(1): a regulated futures contract";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "(B) which is traded on or subject to the rules of a qualified board or exchange.")
rule RegulatedFuturesRule(a: Asset, board: Person) defeasible {
    label en official "section 1256(g)(1)(A)-(B)";
    when contract_requires_marking_to_market_system(a);
    when contract_traded_on_board(a, board);
    when qualified_board_or_exchange_1256(board);
    then regulated_futures_contract_1256(a);
}
pub relation fx_contract_settles_in_currency_traded_in_regulated_futures(a: Asset) kind empirical {
    label en official "section 1256(g)(2)(A)(i): the contract requires delivery of, or its settlement depends on the value of, a foreign currency in which positions are also traded through regulated futures contracts";
}
pub relation fx_contract_traded_in_interbank_market(a: Asset) kind empirical {
    label en official "section 1256(g)(2)(A)(ii): the contract is traded in the interbank market";
}
pub relation fx_contract_at_arms_length_price_by_interbank_reference(a: Asset) kind empirical {
    label en official "section 1256(g)(2)(A)(iii): the contract is entered into at arm's length at a price determined by reference to the price in the interbank market";
}
pub relation fx_contract_excluded_by_regulation(a: Asset) kind empirical {
    label en official "section 1256(g)(2)(B): the contract (or its type) is excluded by regulations as inconsistent with the purposes (EXTERNAL_DEPENDENCY)";
}
pub relation foreign_currency_contract_1256(a: Asset) kind institutional {
    label en official "section 1256(g)(2): a foreign currency contract";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "The term \"foreign currency contract\" means a contract—")
rule ForeignCurrencyContractRule(a: Asset) defeasible {
    label en official "section 1256(g)(2)(A)(i)-(iii), unless excluded by regulation under (B)";
    when fx_contract_settles_in_currency_traded_in_regulated_futures(a);
    when fx_contract_traded_in_interbank_market(a);
    when fx_contract_at_arms_length_price_by_interbank_reference(a);
    when not_known(fx_contract_excluded_by_regulation(a));
    then foreign_currency_contract_1256(a);
}
pub relation option_other_than_right_to_acquire_stock_from_issuer(a: Asset) kind empirical {
    label en official "section 1256(g)(5): an option other than a right to acquire stock from the issuer";
}
pub relation listed_option_1256(a: Asset) kind institutional {
    label en official "section 1256(g)(5): a listed option";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "The term \"listed option\" means any option (other than a right to acquire stock from the issuer) which is traded on (or subject to the rules of) a qualified board or exchange.")
rule ListedOptionRule(a: Asset, board: Person) defeasible {
    label en official "section 1256(g)(5)";
    when option_other_than_right_to_acquire_stock_from_issuer(a);
    when contract_traded_on_board(a, board);
    when qualified_board_or_exchange_1256(board);
    then listed_option_1256(a);
}
pub relation option_to_buy_or_sell_stock(a: Asset) kind empirical {
    label en official "section 1256(g)(6)(A): an option to buy or sell stock";
}
pub relation option_value_determined_by_reference_to_stock(a: Asset) kind empirical {
    label en official "section 1256(g)(6)(B): an option the value of which is determined directly or indirectly by reference to any stock";
}
pub relation option_value_determined_by_reference_to_narrow_based_index(a: Asset) kind empirical {
    label en official "section 1256(g)(6)(B): an option the value of which is determined by reference to a narrow-based security index (section 3(a)(55) of the Securities Exchange Act of 1934)";
}
pub relation option_on_group_of_stocks_not_narrow_based(a: Asset) kind empirical {
    label en official "section 1256(g)(6), last part: an option on a group of stocks whose group does not meet the requirements for a narrow-based security index";
}
pub relation equity_option_1256(a: Asset) kind institutional {
    label en official "section 1256(g)(6): an equity option";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "(A) to buy or sell stock, or")
rule EquityOptionStockRule(a: Asset) defeasible {
    label en official "section 1256(g)(6)(A)";
    when option_to_buy_or_sell_stock(a);
    then equity_option_1256(a);
}
rule EquityOptionValueRule(a: Asset) defeasible {
    label en official "section 1256(g)(6)(B), stock limb, unless the group fails the narrow-based test";
    when option_value_determined_by_reference_to_stock(a);
    when not_known(option_on_group_of_stocks_not_narrow_based(a));
    then equity_option_1256(a);
}
rule EquityOptionIndexRule(a: Asset) defeasible {
    label en official "section 1256(g)(6)(B), narrow-based index limb";
    when option_value_determined_by_reference_to_narrow_based_index(a);
    then equity_option_1256(a);
}
pub relation nonequity_option_1256(a: Asset) kind institutional {
    label en official "section 1256(g)(3): a nonequity option - a listed option which is not an equity option";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "The term \"nonequity option\" means any listed option which is not an equity option.")
rule NonequityOptionRule(a: Asset) defeasible {
    label en official "section 1256(g)(3)";
    when listed_option_1256(a);
    when not_known(equity_option_1256(a));
    then nonequity_option_1256(a);
}
pub relation option_purchased_or_granted_by_dealer_in_normal_course(a: Asset, dealer: Person) kind empirical {
    label en official "section 1256(g)(4)(B): the option is purchased or granted by the options dealer in the normal course of his activity of dealing in options";
}
pub relation option_listed_on_board_where_dealer_registered(a: Asset, dealer: Person) kind empirical {
    label en official "section 1256(g)(4)(C): the option is listed on the qualified board or exchange on which the options dealer is registered";
}
pub relation dealer_equity_option_1256(a: Asset, dealer: Person) kind institutional {
    label en official "section 1256(g)(4): a dealer equity option";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "The term \"dealer equity option\" means, with respect to an options dealer, any listed option which—")
rule DealerEquityOptionRule(a: Asset, dealer: Person) defeasible {
    label en official "section 1256(g)(4)(A)-(C)";
    when options_dealer_1256g8(dealer);
    when listed_option_1256(a);
    when equity_option_1256(a);
    when option_purchased_or_granted_by_dealer_in_normal_course(a, dealer);
    when option_listed_on_board_where_dealer_registered(a, dealer);
    then dealer_equity_option_1256(a, dealer);
}
pub relation securities_futures_contract_1234B(a: Asset) kind empirical {
    label en official "section 1256(g)(9)(C): a securities futures contract within the meaning of section 1234B, or an option on such a contract";
}
pub relation secretary_determines_dealer_in_securities_futures(dealer: Person) kind empirical {
    label en official "section 1256(g)(9)(B): the Secretary determines that the person performs, with respect to such contracts or options, functions similar to those of options dealers (a determination of the Secretary)";
}
pub relation dealer_in_securities_futures(dealer: Person) kind institutional {
    label en official "section 1256(g)(9)(B): a person treated as a dealer in securities futures contracts";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), a person shall be treated as a dealer in securities futures contracts or options on such contracts if the Secretary determines that such person performs, with respect to such contracts or options, as the case may be, functions similar to the functions performed by persons described in paragraph (8)(A).")
rule DealerInSecuritiesFuturesRule(dealer: Person) defeasible {
    label en official "section 1256(g)(9)(B)";
    when secretary_determines_dealer_in_securities_futures(dealer);
    then dealer_in_securities_futures(dealer);
}
pub relation contract_entered_by_dealer_in_normal_course(a: Asset, dealer: Person) kind empirical {
    label en official "section 1256(g)(9)(A)(i): the contract is entered into by the dealer (an option is purchased or granted by the dealer) in the normal course of his activity of dealing in such contracts or options";
}
pub relation dealer_securities_futures_contract_1256(a: Asset, dealer: Person) kind institutional {
    label en official "section 1256(g)(9): a dealer securities futures contract";
}
@source(IRC_S1256_G, relation = formalizes, coverage = exact, quote = "(ii) is traded on a qualified board or exchange.")
rule DealerSecuritiesFuturesRule(a: Asset, dealer: Person, board: Person) defeasible {
    label en official "section 1256(g)(9)(A)(i)-(ii)";
    when securities_futures_contract_1234B(a);
    when contract_entered_by_dealer_in_normal_course(a, dealer);
    when contract_traded_on_board(a, board);
    when qualified_board_or_exchange_1256(board);
    then dealer_securities_futures_contract_1256(a, dealer);
}
rule DealerSecuritiesFuturesByDeterminationRule(a: Asset, dealer: Person, board: Person) defeasible {
    label en official "section 1256(g)(9)(A)-(B): a dealer by the Secretary's determination";
    when securities_futures_contract_1234B(a);
    when dealer_in_securities_futures(dealer);
    when contract_entered_by_dealer_in_normal_course(a, dealer);
    when contract_traded_on_board(a, board);
    when qualified_board_or_exchange_1256(board);
    then dealer_securities_futures_contract_1256(a, dealer);
}

// =============================================================================
// (b): the section 1256 contract and its exclusions
// =============================================================================

pub relation swap_or_similar_agreement_1256b2B(a: Asset) kind empirical {
    label en official "section 1256(b)(2)(B): an interest rate swap, currency swap, basis swap, interest rate cap or floor, commodity swap, equity swap, equity index swap, credit default swap, or similar agreement";
}
pub relation securities_futures_not_dealer_1256b2A(a: Asset) kind institutional {
    label en official "section 1256(b)(2)(A): a securities futures contract, or an option on such a contract, that is not a dealer securities futures contract";
}
rule SecuritiesFuturesExcludedRule(a: Asset) defeasible {
    label en official "section 1256(b)(2)(A)";
    when securities_futures_contract_1234B(a);
    when not_known(is_dealer_securities_futures(a));
    then securities_futures_not_dealer_1256b2A(a);
}
pub relation is_dealer_securities_futures(a: Asset) kind institutional {
    label en unofficial "the contract is a dealer securities futures contract of some dealer";
}
rule IsDealerSecuritiesFuturesRule(a: Asset, dealer: Person) defeasible {
    label en unofficial "helper";
    when dealer_securities_futures_contract_1256(a, dealer);
    then is_dealer_securities_futures(a);
}
pub relation excluded_from_section_1256_contract(a: Asset) kind institutional {
    label en official "section 1256(b)(2): the contract is excluded from the term section 1256 contract";
}
@source(IRC_S1256_B, relation = formalizes, coverage = exact, quote = "(A) any securities futures contract or option on such a contract unless such contract or option is a dealer securities futures contract, or")
rule ExcludedSecuritiesFuturesRule(a: Asset) defeasible {
    label en official "section 1256(b)(2)(A)";
    when securities_futures_not_dealer_1256b2A(a);
    then excluded_from_section_1256_contract(a);
}
@source(IRC_S1256_B, relation = formalizes, coverage = exact, quote = "(B) any interest rate swap, currency swap, basis swap, interest rate cap, interest rate floor, commodity swap, equity swap, equity index swap, credit default swap, or similar agreement.")
rule ExcludedSwapRule(a: Asset) defeasible {
    label en official "section 1256(b)(2)(B)";
    when swap_or_similar_agreement_1256b2B(a);
    then excluded_from_section_1256_contract(a);
}
pub relation section_1256_contract_by_definition(a: Asset) kind institutional {
    label en official "section 1256(b)(1): a regulated futures contract, foreign currency contract, nonequity option, dealer equity option or dealer securities futures contract, other than the (b)(2) exclusions";
}
@source(IRC_S1256_B, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"section 1256 contract\" means—")
rule Contract1256FuturesRule(a: Asset) defeasible {
    label en official "section 1256(b)(1)(A)";
    when regulated_futures_contract_1256(a);
    when not_known(excluded_from_section_1256_contract(a));
    then section_1256_contract_by_definition(a);
}
rule Contract1256ForeignCurrencyRule(a: Asset) defeasible {
    label en official "section 1256(b)(1)(B)";
    when foreign_currency_contract_1256(a);
    when not_known(excluded_from_section_1256_contract(a));
    then section_1256_contract_by_definition(a);
}
rule Contract1256NonequityOptionRule(a: Asset) defeasible {
    label en official "section 1256(b)(1)(C)";
    when nonequity_option_1256(a);
    when not_known(excluded_from_section_1256_contract(a));
    then section_1256_contract_by_definition(a);
}
rule Contract1256DealerEquityOptionRule(a: Asset, dealer: Person) defeasible {
    label en official "section 1256(b)(1)(D)";
    when dealer_equity_option_1256(a, dealer);
    when not_known(excluded_from_section_1256_contract(a));
    then section_1256_contract_by_definition(a);
}
rule Contract1256DealerSecuritiesFuturesRule(a: Asset, dealer: Person) defeasible {
    label en official "section 1256(b)(1)(E)";
    when dealer_securities_futures_contract_1256(a, dealer);
    when not_known(excluded_from_section_1256_contract(a));
    then section_1256_contract_by_definition(a);
}

// =============================================================================
// (a)(2), (a)(4)
// =============================================================================

pub relation subsequent_realized_gain_on_1256_contract(p: Person, c: Section1256Contract, amount: Money) kind empirical {
    label en official "the gain subsequently realized on a section 1256 contract that was marked to market in a prior year";
}
pub relation prior_mark_to_market_gain_taken_into_account(p: Person, c: Section1256Contract, amount: Money) kind empirical {
    label en official "section 1256(a)(2): the gain taken into account for the contract by reason of paragraph (1)";
}
pub relation adjusted_subsequent_gain_1256a2(p: Person, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(a)(2): proper adjustment - the subsequent gain less the gain already taken into account";
}
@source(IRC_S1256_A, relation = formalizes, coverage = exact, quote = "(2) proper adjustment shall be made in the amount of any gain or loss subsequently realized for gain or loss taken into account by reason of paragraph (1),")
rule AdjustedSubsequentGainRule(p: Person, c: Section1256Contract, realized: Money, prior: Money) defeasible {
    label en official "section 1256(a)(2): gain above the amount already taken";
    when subsequent_realized_gain_on_1256_contract(p, c, realized);
    when prior_mark_to_market_gain_taken_into_account(p, c, prior);
    when realized > prior;
    then adjusted_subsequent_gain_1256a2(p, c, realized - prior);
}
pub relation adjusted_subsequent_loss_1256a2(p: Person, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(a)(2): the gain already taken exceeds the subsequent gain, so a loss results";
}
rule AdjustedSubsequentLossRule(p: Person, c: Section1256Contract, realized: Money, prior: Money) defeasible {
    label en official "section 1256(a)(2): a subsequent gain below the gain already taken is a loss";
    when subsequent_realized_gain_on_1256_contract(p, c, realized);
    when prior_mark_to_market_gain_taken_into_account(p, c, prior);
    when realized < prior;
    then adjusted_subsequent_loss_1256a2(p, c, prior - realized);
}
pub relation subsequent_realized_loss_on_1256_contract(p: Person, c: Section1256Contract, amount: Money) kind empirical {
    label en official "the loss subsequently realized on a section 1256 contract that was marked to market in a prior year";
}
pub relation prior_mark_to_market_loss_taken_into_account(p: Person, c: Section1256Contract, amount: Money) kind empirical {
    label en official "section 1256(a)(2): the loss taken into account for the contract by reason of paragraph (1)";
}
rule AdjustedSubsequentLossOfLossRule(p: Person, c: Section1256Contract, realized: Money, prior: Money) defeasible {
    label en official "section 1256(a)(2): a loss above the loss already taken";
    when subsequent_realized_loss_on_1256_contract(p, c, realized);
    when prior_mark_to_market_loss_taken_into_account(p, c, prior);
    when realized > prior;
    then adjusted_subsequent_loss_1256a2(p, c, realized - prior);
}
rule AdjustedSubsequentGainOfLossRule(p: Person, c: Section1256Contract, realized: Money, prior: Money) defeasible {
    label en official "section 1256(a)(2): a loss below the loss already taken is a gain";
    when subsequent_realized_loss_on_1256_contract(p, c, realized);
    when prior_mark_to_market_loss_taken_into_account(p, c, prior);
    when realized < prior;
    then adjusted_subsequent_gain_1256a2(p, c, prior - realized);
}
pub relation straddle_positions_all_1256_contracts(s: Asset) kind empirical {
    label en official "section 1256(a)(4): all the offsetting positions making up the straddle consist of section 1256 contracts to which the section applies";
}
pub relation straddle_not_part_of_larger_straddle(s: Asset) kind empirical {
    label en official "section 1256(a)(4): the straddle is not part of a larger straddle";
}
pub relation sections_1092_and_263g_not_applicable_to_straddle(s: Asset) kind institutional {
    label en official "section 1256(a)(4): sections 1092 and 263(g) do not apply with respect to the straddle";
}
@source(IRC_S1256_A, relation = formalizes, coverage = exact, quote = "(4) if all the offsetting positions making up any straddle consist of section 1256 contracts to which this section applies (and such straddle is not part of a larger straddle), sections 1092 and 263(g) shall not apply with respect to such straddle.")
rule Straddle1256OnlyRule(s: Asset) defeasible {
    label en official "section 1256(a)(4)";
    when straddle_positions_all_1256_contracts(s);
    when straddle_not_part_of_larger_straddle(s);
    then sections_1092_and_263g_not_applicable_to_straddle(s);
}

// =============================================================================
// (c): terminations and transfers
// =============================================================================

pub relation contract_terminated_or_transferred_in_year(p: Person, c: Section1256Contract, y: TaxableYear) kind empirical {
    label en official "section 1256(c)(1): the taxpayer's obligation (or rights) with respect to the section 1256 contract terminated (or transferred) during the year by offsetting, delivery, exercise, assignment, lapse, or otherwise";
}
pub relation fair_market_value_at_termination(p: Person, c: Section1256Contract, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1256(c)(3): the fair market value at the time of the termination (or transfer)";
}
pub relation basis_at_termination(p: Person, c: Section1256Contract, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's basis in the contract immediately before the termination";
}
pub relation termination_gain_1256c(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(c)(1), (3): the gain on the termination or transfer, as if sold for fair market value";
}
@source(IRC_S1256_C, relation = formalizes, coverage = exact, quote = "The rules of paragraphs (1), (2), and (3) of subsection (a) shall also apply to the termination (or transfer) during the taxable year of the taxpayer's obligation (or rights) with respect to a section 1256 contract by offsetting, by taking or making delivery, by exercise or being exercised, by assignment or being assigned, by lapse, or otherwise.")
rule TerminationGainRule(p: Person, c: Section1256Contract, y: TaxableYear, fmv: Money, basis: Money) defeasible {
    label en official "section 1256(c)(1), (3)";
    when contract_terminated_or_transferred_in_year(p, c, y);
    when fair_market_value_at_termination(p, c, y, fmv);
    when basis_at_termination(p, c, y, basis);
    when fmv > basis;
    then termination_gain_1256c(p, y, c, fmv - basis);
}
pub relation termination_loss_1256c(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(c)(1), (3): the loss on the termination or transfer, as if sold for fair market value";
}
rule TerminationLossRule(p: Person, c: Section1256Contract, y: TaxableYear, fmv: Money, basis: Money) defeasible {
    label en official "section 1256(c)(1), (3)";
    when contract_terminated_or_transferred_in_year(p, c, y);
    when fair_market_value_at_termination(p, c, y, fmv);
    when basis_at_termination(p, c, y, basis);
    when fmv < basis;
    then termination_loss_1256c(p, y, c, basis - fmv);
}
pub relation termination_short_term_character(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(c)(1) with (a)(3)(A): 40 percent of the termination gain or loss is short-term";
}
pub relation termination_long_term_character(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(c)(1) with (a)(3)(B): 60 percent of the termination gain or loss is long-term";
}
rule TerminationGainShortTermRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(c)(1) with (a)(3)(A)";
    when termination_gain_1256c(p, y, c, amount);
    when not_known(section_1256_mixed_straddle_election_in_effect(p, y));
    then termination_short_term_character(p, y, c, amount * Section1256ShortTermFraction);
}
rule TerminationGainLongTermRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(c)(1) with (a)(3)(B)";
    when termination_gain_1256c(p, y, c, amount);
    when not_known(section_1256_mixed_straddle_election_in_effect(p, y));
    then termination_long_term_character(p, y, c, amount * Section1256LongTermFraction);
}
rule TerminationLossShortTermRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(c)(1) with (a)(3)(A)";
    when termination_loss_1256c(p, y, c, amount);
    when not_known(section_1256_mixed_straddle_election_in_effect(p, y));
    then termination_short_term_character(p, y, c, amount * Section1256ShortTermFraction);
}
rule TerminationLossLongTermRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(c)(1) with (a)(3)(B)";
    when termination_loss_1256c(p, y, c, amount);
    when not_known(section_1256_mixed_straddle_election_in_effect(p, y));
    then termination_long_term_character(p, y, c, amount * Section1256LongTermFraction);
}
pub relation contracts_in_straddle(c1: Section1256Contract, c2: Section1256Contract) kind empirical {
    label en official "section 1256(c)(2)(A): the two section 1256 contracts are part of a straddle (section 1092(c))";
}
pub relation taxpayer_takes_delivery_or_exercises(p: Person, c: Section1256Contract, on: Date) kind empirical {
    label en official "section 1256(c)(2)(B): the taxpayer takes delivery under or exercises the contract on the date";
}
pub relation contract_deemed_terminated_on(p: Person, c: Section1256Contract, on: Date) kind institutional {
    label en official "section 1256(c)(2): each of the other contracts in the straddle is treated as terminated on the day the taxpayer took delivery";
}
@source(IRC_S1256_C, relation = formalizes, coverage = exact, quote = "then, for purposes of this section, each of the other such contracts shall be treated as terminated on the day on which the taxpayer took delivery.")
rule DeemedTerminationRule(p: Person, delivered: Section1256Contract, other: Section1256Contract, on: Date) defeasible {
    label en official "section 1256(c)(2)";
    when contracts_in_straddle(delivered, other);
    when taxpayer_takes_delivery_or_exercises(p, delivered, on);
    then contract_deemed_terminated_on(p, other, on);
}

// =============================================================================
// (d)(3), (d)(4): persistence of the election and the mixed straddle
// =============================================================================

pub relation year_begins_1256(y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year";
}
pub relation secretary_consents_to_revoke_1256d(p: Person, on: Date) kind empirical {
    label en official "section 1256(d)(3): the Secretary consents to the revocation of the election, effective from the taxable year beginning on the date";
}
pub relation revocation_reached_1256d(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "a consented revocation is effective on or before the beginning of the year";
}
rule RevocationReachedRule(p: Person, y: TaxableYear, begins: Date, revoked: Date) defeasible {
    label en unofficial "helper";
    when year_begins_1256(y, begins);
    when secretary_consents_to_revoke_1256d(p, revoked);
    when revoked <= begins;
    then revocation_reached_1256d(p, y);
}
pub relation mixed_straddle_election_applies_to_year(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1256(d)(3): the election applies to the taxable year for which made and to all subsequent years unless the Secretary consents to a revocation";
}
@source(IRC_S1256_D, relation = formalizes, coverage = exact, quote = "An election under paragraph (1) shall apply to the taxpayer's taxable year for which made and to all subsequent taxable years, unless the Secretary consents to a revocation of such election.")
rule ElectionYearRule1256(p: Person, y: TaxableYear) defeasible {
    label en official "section 1256(d)(3): the year for which made";
    when section_1256_mixed_straddle_election_in_effect(p, y);
    then mixed_straddle_election_applies_to_year(p, y);
}
rule ElectionLaterYearRule1256(p: Person, y0: TaxableYear, y: TaxableYear, start: Date, begins: Date) defeasible {
    label en official "section 1256(d)(3): all subsequent taxable years until a consented revocation";
    when section_1256_mixed_straddle_election_in_effect(p, y0);
    when year_begins_1256(y0, start);
    when year_begins_1256(y, begins);
    when begins > start;
    when not_known(revocation_reached_1256d(p, y));
    then mixed_straddle_election_applies_to_year(p, y);
}
pub relation straddle_total_positions(s: Asset, n: Integer) kind empirical {
    label en official "the number of positions of the straddle";
}
pub relation straddle_section_1256_positions(s: Asset, n: Integer) kind empirical {
    label en official "section 1256(d)(4)(A): the number of positions of the straddle that are section 1256 contracts";
}
pub relation all_positions_identified_before_deadline(s: Asset) kind empirical {
    label en official "section 1256(d)(4)(B): each position of the straddle is clearly identified, before the close of the day on which the first section 1256 contract of the straddle is acquired (or such earlier time as the Secretary prescribes), as part of the straddle";
}
pub relation mixed_straddle_1256d4(s: Asset) kind institutional {
    label en official "section 1256(d)(4): a mixed straddle";
}
@source(IRC_S1256_D, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"mixed straddle\" means any straddle (as defined in section 1092(c))—")
rule MixedStraddleRule(s: Asset, total: Integer, contracts: Integer) defeasible {
    label en official "section 1256(d)(4)(A)-(B): at least one, but not all, positions are section 1256 contracts, and all are identified in time";
    when straddle_total_positions(s, total);
    when straddle_section_1256_positions(s, contracts);
    when contracts >= 1;
    when contracts < total;
    when all_positions_identified_before_deadline(s);
    then mixed_straddle_1256d4(s);
}

// =============================================================================
// (e)(2)-(4): hedging transactions
// =============================================================================

pub relation hedging_transaction_by_1221b2A(p: Person, c: Section1256Contract) kind empirical {
    label en official "section 1256(e)(2): the transaction is a hedging transaction as defined in section 1221(b)(2)(A)";
}
pub relation transaction_entered_into_on(p: Person, c: Section1256Contract, on: Date) kind empirical {
    label en official "the day on which the transaction was entered into";
}
pub relation identified_as_hedging_on(p: Person, c: Section1256Contract, on: Date) kind empirical {
    label en official "the day on which the taxpayer clearly identified the transaction as a hedging transaction";
}
pub relation entered_by_or_for_syndicate(p: Person, c: Section1256Contract) kind empirical {
    label en official "section 1256(e)(3)(A): the transaction is entered into by or for a syndicate";
}
pub relation hedging_transaction_1256e2(p: Person, c: Section1256Contract) kind institutional {
    label en official "section 1256(e)(2): a hedging transaction identified before the close of the day it was entered into, other than a syndicate transaction";
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"hedging transaction\" means any hedging transaction (as defined in section 1221(b)(2)(A)) if, before the close of the day on which such transaction was entered into (or such earlier time as the Secretary may prescribe by regulations), the taxpayer clearly identifies such transaction as being a hedging transaction.")
rule HedgingTransactionRule(p: Person, c: Section1256Contract, entered: Date, identified: Date) defeasible {
    label en official "section 1256(e)(2), with the (e)(3)(A) syndicate exclusion";
    when hedging_transaction_by_1221b2A(p, c);
    when transaction_entered_into_on(p, c, entered);
    when identified_as_hedging_on(p, c, identified);
    when identified <= entered;
    when not_known(entered_by_or_for_syndicate(p, c));
    then hedging_transaction_1256e2(p, c);
}
pub relation entity_loss_share_to_limited_partners(e: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "section 1256(e)(3)(B): the share of the entity's losses for the year that is allocable to limited partners or limited entrepreneurs (section 461(k)(4))";
}
pub relation entity_is_corporation_not_s_corporation(e: Person) kind empirical {
    label en official "section 1256(e)(3)(B): the entity is a corporation which is not an S corporation";
}
pub relation syndicate_1256e3B(e: Person, y: TaxableYear) kind institutional {
    label en official "section 1256(e)(3)(B): a syndicate - a partnership or other entity (other than a corporation which is not an S corporation) with more than 35 percent of its losses allocable to limited partners or limited entrepreneurs";
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"syndicate\" means any partnership or other entity (other than a corporation which is not an S corporation) if more than 35 percent of the losses of such entity during the taxable year are allocable to limited partners or limited entrepreneurs (within the meaning of section 461(k)(4)).")
rule SyndicateRule(e: Person, y: TaxableYear, share: Decimal) defeasible {
    label en official "section 1256(e)(3)(B)";
    when entity_loss_share_to_limited_partners(e, y, share);
    when share > 0.35;
    when not_known(entity_is_corporation_not_s_corporation(e));
    then syndicate_1256e3B(e, y);
}
pub relation interest_holder_actively_participates_at_all_times(holder: Person, e: Person) kind empirical {
    label en official "section 1256(e)(3)(C)(i): the interest is held by an individual who actively participates at all times during the period in the management of the entity";
}
pub relation holder_is_spouse_child_grandchild_or_parent_of_active_participant(holder: Person, e: Person) kind empirical {
    label en official "section 1256(e)(3)(C)(ii): the interest is held by the spouse, child (a legally adopted child counts as a child by blood), grandchild or parent of an individual who actively participates at all times in the management";
}
pub relation holder_actively_participated_for_at_least_5_years(holder: Person, e: Person) kind empirical {
    label en official "section 1256(e)(3)(C)(iii): the interest is held by an individual who actively participated in the management of the entity for a period of not less than 5 years";
}
pub relation holder_is_estate_of_active_participant_or_family_member(holder: Person, e: Person) kind empirical {
    label en official "section 1256(e)(3)(C)(iv): the interest is held by the estate of an individual who actively participated in the management, or by the estate of an individual described in (ii)";
}
pub relation secretary_determines_active_participation_treatment(holder: Person, e: Person) kind empirical {
    label en official "section 1256(e)(3)(C)(v): the Secretary determines that the interest should be treated as held by an individual who actively participates and that the entity and interest are not used for tax avoidance (a determination of the Secretary)";
}
pub relation interest_not_held_by_limited_partner_1256e3C(holder: Person, e: Person) kind institutional {
    label en official "section 1256(e)(3)(C): the interest is not treated as held by a limited partner or a limited entrepreneur";
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "(i) for any period if during such period such interest is held by an individual who actively participates at all times during such period in the management of such entity,")
rule NotLimitedPartnerActiveRule(holder: Person, e: Person) defeasible {
    label en official "section 1256(e)(3)(C)(i)";
    when interest_holder_actively_participates_at_all_times(holder, e);
    then interest_not_held_by_limited_partner_1256e3C(holder, e);
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "(ii) for any period if during such period such interest is held by the spouse, children, grandchildren, and parents of an individual who actively participates at all times during such period in the management of such entity,")
rule NotLimitedPartnerFamilyRule(holder: Person, e: Person) defeasible {
    label en official "section 1256(e)(3)(C)(ii), with the last sentence on adopted children";
    when holder_is_spouse_child_grandchild_or_parent_of_active_participant(holder, e);
    then interest_not_held_by_limited_partner_1256e3C(holder, e);
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "(iii) if such interest is held by an individual who actively participated in the management of such entity for a period of not less than 5 years,")
rule NotLimitedPartnerFiveYearsRule(holder: Person, e: Person) defeasible {
    label en official "section 1256(e)(3)(C)(iii)";
    when holder_actively_participated_for_at_least_5_years(holder, e);
    then interest_not_held_by_limited_partner_1256e3C(holder, e);
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "(iv) if such interest is held by the estate of an individual who actively participated in the management of such entity or is held by the estate of an individual if with respect to such individual such interest was at any time described in clause (ii), or")
rule NotLimitedPartnerEstateRule(holder: Person, e: Person) defeasible {
    label en official "section 1256(e)(3)(C)(iv)";
    when holder_is_estate_of_active_participant_or_family_member(holder, e);
    then interest_not_held_by_limited_partner_1256e3C(holder, e);
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "(v) if the Secretary determines (by regulations or otherwise) that such interest should be treated as held by an individual who actively participates in the management of such entity, and that such entity and such interest are not used (or to be used) for tax–avoidance purposes.")
rule NotLimitedPartnerSecretaryRule(holder: Person, e: Person) defeasible {
    label en official "section 1256(e)(3)(C)(v)";
    when secretary_determines_active_participation_treatment(holder, e);
    then interest_not_held_by_limited_partner_1256e3C(holder, e);
}
// (e)(4)
pub relation hedging_deductions_for_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1256(e)(4)(D)(i): the deductions allowable for the year attributable to hedging transactions (determined without regard to subparagraph (A)(i))";
}
pub relation hedging_income_for_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1256(e)(4)(D)(ii): the income received or accrued during the year from hedging transactions";
}
pub relation hedging_loss_1256e4D(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1256(e)(4)(D): the hedging loss - the excess of the deductions attributable to hedging transactions over the income from them";
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "(i) the deductions allowable under this chapter for the taxable year attributable to hedging transactions (determined without regard to subparagraph (A)(i)), over")
rule HedgingLossRule(p: Person, y: TaxableYear, deductions: Money, income: Money) defeasible {
    label en official "section 1256(e)(4)(D)";
    when hedging_deductions_for_year(p, y, deductions);
    when hedging_income_for_year(p, y, income);
    when deductions > income;
    then hedging_loss_1256e4D(p, y, deductions - income);
}
pub relation taxable_income_attributable_to_hedged_business(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1256(e)(4)(A)(i): the taxable income of the limited partner or entrepreneur for the year attributable to the trade or business in which the hedging transactions were entered into (determined without regard to the hedging loss)";
}
pub relation aggregate_unrecognized_hedging_gains(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1256(e)(4)(B), (E): the aggregate unrecognized gains (section 1092(a)(3)) from hedging transactions as of the close of the year attributable to the trade or business";
}
pub relation hedging_property_is_stock_or_securities(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1256(e)(4)(C): the hedging transactions relate to stock or securities";
}
pub relation taxpayer_described_in_465a1(p: Person) kind empirical {
    label en official "section 1256(e)(4)(C): the taxpayer is described in section 465(a)(1)";
}
pub relation hedging_loss_limit_applies_1256e4(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1256(e)(4)(C): the paragraph applies - to hedging transactions relating to stock or securities, and otherwise only to a taxpayer described in section 465(a)(1)";
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "In the case of any hedging transaction relating to property other than stock or securities, this paragraph shall apply only in the case of a taxpayer described in section 465(a)(1).")
rule LimitAppliesStockRule(p: Person, y: TaxableYear) defeasible {
    label en official "section 1256(e)(4)(C): stock or securities";
    when hedging_property_is_stock_or_securities(p, y);
    then hedging_loss_limit_applies_1256e4(p, y);
}
rule LimitAppliesOtherRule(p: Person, y: TaxableYear, deductions: Money) defeasible {
    label en official "section 1256(e)(4)(C): other property, a taxpayer described in section 465(a)(1)";
    when hedging_deductions_for_year(p, y, deductions);
    when not_known(hedging_property_is_stock_or_securities(p, y));
    when taxpayer_described_in_465a1(p);
    then hedging_loss_limit_applies_1256e4(p, y);
}
pub relation limitable_hedging_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1256(e)(4)(B): the part of the hedging loss that does not exceed the aggregate unrecognized gains - the part subject to the limit";
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "Subparagraph (A)(i) shall not apply to any hedging loss to the extent that such loss exceeds the aggregate unrecognized gains from hedging transactions as of the close of the taxable year attributable to the trade or business in which the hedging transactions were entered into.")
rule LimitableLossCappedRule(p: Person, y: TaxableYear, loss: Money, gains: Money) defeasible {
    label en official "section 1256(e)(4)(B): the loss above the unrecognized gains escapes the limit";
    when hedging_loss_1256e4D(p, y, loss);
    when aggregate_unrecognized_hedging_gains(p, y, gains);
    when hedging_loss_limit_applies_1256e4(p, y);
    when loss > gains;
    then limitable_hedging_loss(p, y, gains);
}
rule LimitableLossWholeRule(p: Person, y: TaxableYear, loss: Money, gains: Money) defeasible {
    label en official "section 1256(e)(4)(B): the loss does not exceed the unrecognized gains";
    when hedging_loss_1256e4D(p, y, loss);
    when aggregate_unrecognized_hedging_gains(p, y, gains);
    when hedging_loss_limit_applies_1256e4(p, y);
    when loss <= gains;
    then limitable_hedging_loss(p, y, loss);
}
pub relation hedging_loss_allowed_1256e4(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1256(e)(4)(A)(i), (B): the hedging loss allowed - the part above the unrecognized gains in full, and the limitable part to the extent of the taxable income attributable to the business";
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "Any hedging loss for a taxable year which is allocable to any limited partner or limited entrepreneur (within the meaning of paragraph (3)) shall be allowed only to the extent of the taxable income of such limited partner or entrepreneur for such taxable year attributable to the trade or business in which the hedging transactions were entered into.")
rule HedgingLossAllowedRule(p: Person, y: TaxableYear, loss: Money, limitable: Money, income: Money) defeasible {
    label en official "section 1256(e)(4)(A)(i), (B)";
    when hedging_loss_1256e4D(p, y, loss);
    when limitable_hedging_loss(p, y, limitable);
    when taxable_income_attributable_to_hedged_business(p, y, income);
    when income >= limitable;
    then hedging_loss_allowed_1256e4(p, y, loss);
}
rule HedgingLossPartlyAllowedRule(p: Person, y: TaxableYear, loss: Money, limitable: Money, income: Money) defeasible {
    label en official "section 1256(e)(4)(A)(i), (B): the limitable part is cut back to the taxable income";
    when hedging_loss_1256e4D(p, y, loss);
    when limitable_hedging_loss(p, y, limitable);
    when taxable_income_attributable_to_hedged_business(p, y, income);
    when income < limitable;
    then hedging_loss_allowed_1256e4(p, y, loss - limitable + income);
}
pub relation hedging_loss_carried_to_next_year_1256e4(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1256(e)(4)(A)(ii): the hedging loss disallowed is treated as a deduction attributable to a hedging transaction allowable in the first succeeding taxable year";
}
@source(IRC_S1256_E, relation = formalizes, coverage = exact, quote = "Any hedging loss disallowed under clause (i) shall be treated as a deduction attributable to a hedging transaction allowable in the first succeeding taxable year.")
rule HedgingLossCarriedRule(p: Person, y: TaxableYear, limitable: Money, income: Money) defeasible {
    label en official "section 1256(e)(4)(A)(ii)";
    when limitable_hedging_loss(p, y, limitable);
    when taxable_income_attributable_to_hedged_business(p, y, income);
    when income < limitable;
    then hedging_loss_carried_to_next_year_1256e4(p, y, limitable - income);
}

// =============================================================================
// (f): character
// =============================================================================

pub relation property_was_at_any_time_identified_as_hedge_1256e2(p: Person, a: Asset) kind empirical {
    label en official "section 1256(f)(1): the property was at any time personal property (section 1092(d)(1)) identified under subsection (e)(2) by the taxpayer as part of a hedging transaction";
}
pub relation gain_not_capital_by_1256f1(p: Person, a: Asset) kind institutional {
    label en official "section 1256(f)(1): gain from the property shall in no event be considered gain from the sale or exchange of a capital asset";
}
@source(IRC_S1256_F, relation = formalizes, coverage = exact, quote = "For purposes of this title, gain from any property shall in no event be considered as gain from the sale or exchange of a capital asset if such property was at any time personal property (as defined in section 1092(d)(1)) identified under subsection (e)(2) by the taxpayer as being part of a hedging transaction.")
rule GainNotCapitalRule(p: Person, a: Asset) defeasible {
    label en official "section 1256(f)(1)";
    when property_was_at_any_time_identified_as_hedge_1256e2(p, a);
    then gain_not_capital_by_1256f1(p, a);
}
pub relation gain_or_loss_would_be_ordinary_apart_from_a3(p: Person, y: TaxableYear, c: Section1256Contract) kind empirical {
    label en official "section 1256(f)(2): the gain or loss would, but for paragraph (3) of subsection (a), be ordinary income or loss";
}
pub relation a3_not_applicable_to_ordinary_gain_or_loss(p: Person, y: TaxableYear, c: Section1256Contract) kind institutional {
    label en official "section 1256(f)(2): paragraph (3) of subsection (a) does not apply to gain or loss that would be ordinary";
}
@source(IRC_S1256_F, relation = formalizes, coverage = exact, quote = "Paragraph (3) of subsection (a) shall not apply to any gain or loss which, but for such paragraph, would be ordinary income or loss.")
rule A3NotApplicableOrdinaryRule(p: Person, y: TaxableYear, c: Section1256Contract) defeasible {
    label en official "section 1256(f)(2)";
    when gain_or_loss_would_be_ordinary_apart_from_a3(p, y, c);
    then a3_not_applicable_to_ordinary_gain_or_loss(p, y, c);
}
pub relation contract_held_for_hedging_property_with_ordinary_loss(p: Person, c: Section1256Contract) kind empirical {
    label en official "section 1256(f)(3)(B): the contract is held for purposes of hedging property if any loss on that property in the taxpayer's hands would be ordinary loss";
}
pub relation trading_gain_or_loss_is_capital_1256f3(p: Person, y: TaxableYear, c: Section1256Contract) kind institutional {
    label en official "section 1256(f)(3)(A): gain or loss from trading of section 1256 contracts is treated as gain or loss from the sale or exchange of a capital asset (not to the extent held for hedging property with ordinary loss, (B))";
}
pub relation trading_of_contract_in_year(p: Person, y: TaxableYear, c: Section1256Contract) kind empirical {
    label en official "the taxpayer trades the section 1256 contract in the year";
}
@source(IRC_S1256_F, relation = formalizes, coverage = exact, quote = "For purposes of this title, gain or loss from trading of section 1256 contracts shall be treated as gain or loss from the sale or exchange of a capital asset.")
rule TradingCapitalRule(p: Person, y: TaxableYear, c: Section1256Contract) defeasible {
    label en official "section 1256(f)(3)(A) unless (B) applies";
    when trading_of_contract_in_year(p, y, c);
    when not_known(contract_held_for_hedging_property_with_ordinary_loss(p, c));
    then trading_gain_or_loss_is_capital_1256f3(p, y, c);
}
pub relation dealing_activity_disregarded_for_character_1256f3C(p: Person) kind empirical {
    label en official "section 1256(f)(3)(C): the taxpayer is actively engaged in dealing in or trading section 1256 contracts related to the property, which is not taken into account in determining whether gain or loss on the property is ordinary";
}
pub relation dealing_in_1256_contracts_not_a_character_factor(p: Person) kind institutional {
    label en official "section 1256(f)(3)(C): the fact of dealing in or trading related section 1256 contracts is not taken into account";
}
@source(IRC_S1256_F, relation = formalizes, coverage = exact, quote = "For purposes of determining whether gain or loss with respect to any property is ordinary income or loss, the fact that the taxpayer is actively engaged in dealing in or trading section 1256 contracts related to such property shall not be taken into account.")
rule DealingDisregardedRule(p: Person) defeasible {
    label en official "section 1256(f)(3)(C)";
    when dealing_activity_disregarded_for_character_1256f3C(p);
    then dealing_in_1256_contracts_not_a_character_factor(p);
}
pub relation dealer_option_or_futures_gain_allocable_to_limited_partner(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind empirical {
    label en official "section 1256(f)(4): the gain (or loss) with respect to a dealer equity option or dealer securities futures contract allocable to a limited partner or limited entrepreneur (section 1256(e)(3))";
}
pub relation dealer_lp_gain_short_term_1256f4(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(f)(4)(A)-(B): paragraph (a)(3) does not apply; all such gains or losses are short-term";
}
@source(IRC_S1256_F, relation = formalizes, coverage = exact, quote = "(B) all such gains or losses shall be treated as short-term capital gains or losses, as the case may be.")
rule DealerLpShortTermRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(f)(4)";
    when dealer_option_or_futures_gain_allocable_to_limited_partner(p, y, c, amount);
    then dealer_lp_gain_short_term_1256f4(p, y, c, amount);
}
pub relation wash_sale_section_1091_inapplicable_1256f5(p: Person, y: TaxableYear, c: Section1256Contract) kind institutional {
    label en official "section 1256(f)(5): section 1091 does not apply to any loss taken into account by reason of subsection (a)(1)";
}
@source(IRC_S1256_F, relation = formalizes, coverage = exact, quote = "Section 1091 (relating to loss from wash sales of stock or securities) shall not apply to any loss taken into account by reason of paragraph (1) of subsection (a).")
rule WashSaleInapplicableRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(f)(5)";
    when section_1256_mark_to_market_loss(p, y, c, amount);
    then wash_sale_section_1091_inapplicable_1256f5(p, y, c);
}
