// Property transactions -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): sections 1250(a)(2)(B)
// (last sentence) and 1060(d)(1).
//
// SECTION 1250(a)(2)(B), last sentence (G6896). Clauses (i), (ii) and (iii) do not apply to the additional depreciation of
// subsection (b)(4) (the section 167(k) rehabilitation depreciation); that piece takes clause (iv), the rest of the 1970-75
// additional depreciation takes the first of clauses (i), (ii), (iii) that applies and, failing all, clause (iv). Module 35's
// TierTwoRule applies ONE percentage to min(d2, e - d1) of the whole; when a (b)(4) piece is asserted it is displaced (a
// `not_known` guard) by TierTwoSplitRule below.
// JUDGMENT CALL (a legal choice that the text does not make): the cap e - d1 is allocated between the two pieces
// PRO RATA to their amounts (neither piece is preferred by the order in which the cap is consumed); the alternatives (the
// (b)(4) piece first, or the other piece first) are readings that change the result and are named here, not chosen.
//
// SECTION 1060(d)(1) (G6898). The seven-class residual chain of module 50 starts from `Alloc1WithinRule` and
// `Alloc1CappedRule`, whose only guard is `applicable_asset_acquisition`; the chain of the later classes is unguarded and reads the
// same case relations. The scope of (d)(1) (a partnership distribution or transfer with section 755) is added as a second guard
// of the class I pair, so the chain is not duplicated; the value of section 197 intangibles for section 755 is the sum of the
// class VI and class VII allocations.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

use self::{
    Asset,
    IRC_S1060_D,
    IRC_S1250_A,
    Person,
    PhaseDownSchedule1250,
    Transaction,
    additional_depreciation_1970_to_1975,
    additional_depreciation_after_1975,
    alloc_class_1_1060,
    binding_contract_july_24_1969,
    class_allocation_1060,
    class_fair_market_value_1060,
    depreciation_deduction_for_rehabilitation_167k_allowed,
    disposition_on_or_after_1970_1_1,
    excess_of_realized_over_basis_1250,
    full_months_for_percentage,
    hud_insured_or_assisted_housing_with_1039b1B_restrictions,
    phase_down_percentage,
    rehabilitation_percentage_1250,
    residential_rental_property_167j2B,
    section_1060a_limited_to_197_value_for_755_1060d1,
    section_1250a2_ordinary_income,
    total_consideration_for_applicable_assets_1060,
};

pub relation additional_depreciation_1970_to_1975_b4(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "section 1250(a)(2)(B), last sentence: the part of the additional depreciation attributable to periods after December 31, 1969 and before January 1, 1976 that is described in subsection (b)(4) (the section 167(k) rehabilitation depreciation) — case-asserted, at most the whole 1970-75 amount";
}
pub relation has_b4_piece_1970_to_1975(p: Person, a: Asset) kind institutional {
    label en official "a (b)(4) piece of the 1970-75 additional depreciation is asserted for the property (bridge for the absence test)";
}
rule HasB4Piece1970To1975(p: Person, a: Asset, amount: Money) defeasible {
    label en official "bridge for the absence test";
    when additional_depreciation_1970_to_1975_b4(p, a, amount);
    then has_b4_piece_1970_to_1975(p, a);
}
pub relation applicable_percentage_1250a2_other_piece(a: Asset, pct: Decimal) kind institutional {
    label en official "section 1250(a)(2)(B): the applicable percentage of the 1970-75 additional depreciation other than the (b)(4) piece: the first of clauses (i), (ii), (iii) that applies, and failing all, clause (iv)";
}
@source(IRC_S1250_A, relation = formalizes, coverage = exact, quote = "(i) in the case of section 1250 property disposed of pursuant to a written contract which was, on July 24, 1969, and at all times thereafter, binding on the owner of the property, 100 percent minus 1 percentage point for each full month the property was held after the date the property was held 20 full months;")
rule A2OtherPieceContractRule(a: Asset, n: Integer, pct: Decimal) defeasible {
    label en official "section 1250(a)(2)(B)(i) for the piece other than (b)(4)";
    when binding_contract_july_24_1969(a);
    when full_months_for_percentage(a, n);
    when phase_down_percentage(a, After20FullMonths, n, pct);
    then applicable_percentage_1250a2_other_piece(a, pct);
}
rule A2OtherPieceHousingRule(a: Asset, n: Integer, pct: Decimal) defeasible {
    label en official "section 1250(a)(2)(B)(ii) for the piece other than (b)(4)";
    when hud_insured_or_assisted_housing_with_1039b1B_restrictions(a);
    when not_known(binding_contract_july_24_1969(a));
    when full_months_for_percentage(a, n);
    when phase_down_percentage(a, After20FullMonths, n, pct);
    then applicable_percentage_1250a2_other_piece(a, pct);
}
rule A2OtherPieceResidentialRule(a: Asset, n: Integer, pct: Decimal) defeasible {
    label en official "section 1250(a)(2)(B)(iii) for the piece other than (b)(4)";
    when residential_rental_property_167j2B(a);
    when not_known(binding_contract_july_24_1969(a));
    when not_known(hud_insured_or_assisted_housing_with_1039b1B_restrictions(a));
    when full_months_for_percentage(a, n);
    when phase_down_percentage(a, After100FullMonths, n, pct);
    then applicable_percentage_1250a2_other_piece(a, pct);
}
rule A2OtherPieceRehabRule(a: Asset, pct: Decimal) defeasible {
    label en official "section 1250(a)(2)(B)(iv) for the piece other than (b)(4), when none of (i)-(iii) applies";
    when depreciation_deduction_for_rehabilitation_167k_allowed(a);
    when rehabilitation_percentage_1250(a, pct);
    when not_known(binding_contract_july_24_1969(a));
    when not_known(hud_insured_or_assisted_housing_with_1039b1B_restrictions(a));
    when not_known(residential_rental_property_167j2B(a));
    then applicable_percentage_1250a2_other_piece(a, pct);
}
pub relation cap_portion_of_other_piece_1250a2(p: Person, t: Transaction, a: Asset, amount: Money) kind institutional {
    label en official "section 1250(a)(2)(A), last sentence of (B): the part of the cap min(d2, e - d1) allocated to the piece other than (b)(4), pro rata to the amounts of the pieces (JUDGMENT CALL); cents HALF_UP";
}
rule CapPortionOfOtherPiece1250a2(p: Person, t: Transaction, a: Asset, d1: Money, d2: Money, b4: Money, e: Money) defeasible {
    label en official "min(d2, e - d1) x (d2 - b4) / d2";
    when additional_depreciation_after_1975(p, a, d1);
    when additional_depreciation_1970_to_1975(p, a, d2);
    when additional_depreciation_1970_to_1975_b4(p, a, b4);
    when excess_of_realized_over_basis_1250(p, t, e);
    when e > d1;
    when d2 > 0.00 USD;
    when b4 <= d2;
    then cap_portion_of_other_piece_1250a2(p, t, a, div_round(min(d2, e - d1) * ((d2 - b4) / 1.00 USD), d2 / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S1250_A, relation = formalizes, coverage = exact, quote = "Clauses (i), (ii), and (iii) shall not apply with respect to the additional depreciation described in subsection (b)(4).")
rule TierTwoSplitRule(p: Person, t: Transaction, a: Asset, d1: Money, d2: Money, e: Money, pct_other: Decimal, pct_b4: Decimal, portion_other: Money) defeasible {
    label en official "section 1250(a)(2)(A)-(B) with the last sentence: the (b)(4) piece takes clause (iv), the other piece its own clause; the cap e - d1 is shared pro rata (JUDGMENT CALL)";
    when disposition_on_or_after_1970_1_1(t);
    when applicable_percentage_1250a2_other_piece(a, pct_other);
    when rehabilitation_percentage_1250(a, pct_b4);
    when additional_depreciation_after_1975(p, a, d1);
    when additional_depreciation_1970_to_1975(p, a, d2);
    when excess_of_realized_over_basis_1250(p, t, e);
    when cap_portion_of_other_piece_1250a2(p, t, a, portion_other);
    then section_1250a2_ordinary_income(p, t, round(portion_other * pct_other, 2, "HALF_UP") + round((min(d2, e - d1) - portion_other) * pct_b4, 2, "HALF_UP"));
}

// ---- section 1060(d)(1) ----

@source(IRC_S1060_D, quote = "(1) the rules of subsection (a) shall apply but only for purposes of determining the value of section 197 intangibles for purposes of applying section 755, and")
rule Alloc1WithinFor755Rule(t: Transaction, cons: Money, fmv: Money) defeasible {
    label en official "section 1060(d)(1): class I takes the whole consideration when it does not exceed its value, for a section 755 distribution or transfer";
    when section_1060a_limited_to_197_value_for_755_1060d1(t);
    when total_consideration_for_applicable_assets_1060(t, cons);
    when class_fair_market_value_1060(t, 1, fmv);
    when cons <= fmv;
    then alloc_class_1_1060(t, cons);
}
@source(IRC_S1060_D, quote = "(1) the rules of subsection (a) shall apply but only for purposes of determining the value of section 197 intangibles for purposes of applying section 755, and")
rule Alloc1CappedFor755Rule(t: Transaction, cons: Money, fmv: Money) defeasible {
    label en official "section 1060(d)(1): class I takes its fair market value when the consideration exceeds it, for a section 755 distribution or transfer";
    when section_1060a_limited_to_197_value_for_755_1060d1(t);
    when total_consideration_for_applicable_assets_1060(t, cons);
    when class_fair_market_value_1060(t, 1, fmv);
    when cons > fmv;
    then alloc_class_1_1060(t, fmv);
}
pub relation section_197_intangibles_value_for_755_1060d1(t: Transaction, amount: Money) kind institutional {
    label en official "section 1060(d)(1): the value of section 197 intangibles for section 755: the classes VI and VII allocations of the residual method";
}
@source(IRC_S1060_D, quote = "(1) the rules of subsection (a) shall apply but only for purposes of determining the value of section 197 intangibles for purposes of applying section 755, and")
rule Section197ValueFor755Rule(t: Transaction, six: Money, seven: Money) defeasible {
    label en official "class VI + class VII (section 197 intangibles) of the residual method, for a section 755 distribution or transfer";
    when section_1060a_limited_to_197_value_for_755_1060d1(t);
    when class_allocation_1060(t, 6, six);
    when class_allocation_1060(t, 7, seven);
    then section_197_intangibles_value_for_755_1060d1(t, six + seven);
}
