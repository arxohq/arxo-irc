// Stage 3b (IRC-07, A05). Conditions that earlier stages left as one case-asserted fact and that
// are now derived from their elements: section 1042(b)(4), (e)(3), (f)(2); section 1058(a);
// section 1059(c)(3)(C), (d)(5); section 1092(c)(4)(E); section 1277(c); section 1276(b)(2) (the
// constant-yield amount over the module 39 adjusted-issue-price chain); section 1278(a)(1)(D);
// section 1313(a)(3); section 1396(d)(2); section 1014(e)(2), (f)(1)(B); section 1015(d)(4).
//
// Method. Each derived relation sits beside the case fact it refines. Where an earlier module read
// the case fact, the earlier rule now also reads a not_known guard on the derived relation (or the
// derived relation feeds a parallel rule with the same head), so an existing scenario keeps its
// result. Money and dates are case-supplied; the derivations are comparisons and sums.

// =============================================================================
// Section 1042(b)(4), (e)(3), (f)(2)
// =============================================================================

use self::{
    Asset,
    DebtInstrument,
    Determination,
    IRC_S1014_E,
    IRC_S1014_F,
    IRC_S1015_D,
    IRC_S1042_B,
    IRC_S1042_E,
    IRC_S1042_F,
    IRC_S1058_A,
    IRC_S1059_C,
    IRC_S1059_D,
    IRC_S1092_C,
    IRC_S1236_C,
    IRC_S1276_B,
    IRC_S1277_C,
    IRC_S1278_A,
    IRC_S1313_A,
    IRC_S1396_D,
    Person,
    QualifiedSecuritiesSale,
    Section1042MinimumOwnership,
    ShareDividend,
    StraddlePosition,
    TaxableYear,
    Transaction,
    acquired_at_original_issue,
    bond_held_by,
    buyer_owns_stock_percentage_after_sale,
    chapter_11_value_determined_1014f3,
    constant_interest_rate_election_in_effect,
    dividend_received,
    dividend_received_by_taxpayer_or_1059c3C_person,
    gift_basis_for_gain,
    gift_basis_for_gain_after_gift_tax,
    interest_included_in_gross_income_1277c2,
    interest_paid_on_carrying_debt_1277c1,
    issue_price,
    market_discount_allocable_to_year,
    market_discount_basis_after_acquisition,
    net_direct_interest_expense_deduction_disallowed,
    rolled_adjusted_issue_price_1272a4,
    section_1042_requirements_met,
    sold_to_esop_or_worker_cooperative,
    tax_exempt_obligation,
    verified_consent_statement_filed,
};

pub relation qualified_securities_acquired_on_1042(t: QualifiedSecuritiesSale, on: Date) kind empirical {
    label en official "section 1042(b)(4): the date the taxpayer's holding of the qualified securities began";
}
pub relation qualified_securities_sale_date_1042(t: QualifiedSecuritiesSale, on: Date) kind empirical {
    label en official "section 1042(b)(4): the date of the sale (the time as of which the holding period is determined)";
}
pub relation holding_period_at_least_3_years_1042b4(t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(b)(4): the holding period of the qualified securities is at least 3 years, determined from the dates";
}
@source(IRC_S1042_B, relation = formalizes, coverage = exact, quote = "The taxpayer's holding period with respect to the qualified securities is at least 3 years (determined as of the time of the sale)")
rule ThreeYearHoldingFromDatesRule(t: QualifiedSecuritiesSale, acquired: Date, sold: Date) defeasible {
    label en official "section 1042(b)(4): the sale is on or after the third anniversary of the acquisition";
    when qualified_securities_acquired_on_1042(t, acquired);
    when qualified_securities_sale_date_1042(t, sold);
    when sold >= add_calendar_period(acquired, 3 calendar_year);
    then holding_period_at_least_3_years_1042b4(t);
}
rule Section1042RequirementsMetByDatesRule(t: QualifiedSecuritiesSale, share: Decimal) defeasible {
    label en official "section 1042(b)(1)-(4): the requirements met with the holding period derived from dates";
    when sold_to_esop_or_worker_cooperative(t);
    when buyer_owns_stock_percentage_after_sale(t, share);
    when share >= Section1042MinimumOwnership;
    when verified_consent_statement_filed(t);
    when holding_period_at_least_3_years_1042b4(t);
    then section_1042_requirements_met(t);
}
pub relation reorganization_transfer_of_replacement_property(t: QualifiedSecuritiesSale, a: Asset) kind empirical {
    label en official "section 1042(e)(3)(A): a transfer of qualified replacement property in a reorganization (within the meaning of section 368)";
}
pub relation electing_person_owns_control_of_acquiring_or_acquired_corporation(t: QualifiedSecuritiesSale) kind empirical {
    label en official "section 1042(e)(3)(A): the person making the election owns stock representing control in the acquiring or acquired corporation";
}
pub relation replacement_property_is_substituted_basis_in_transferees_hands(t: QualifiedSecuritiesSale, a: Asset) kind empirical {
    label en official "section 1042(e)(3)(A): the property is substituted basis property in the hands of the transferee";
}
pub relation transfer_by_death_of_electing_person(t: QualifiedSecuritiesSale, a: Asset) kind empirical {
    label en official "section 1042(e)(3)(B): a transfer by reason of the death of the person making the election";
}
pub relation transfer_by_gift_1042(t: QualifiedSecuritiesSale, a: Asset) kind empirical {
    label en official "section 1042(e)(3)(C): a transfer by gift";
}
pub relation transfer_in_transaction_to_which_1042a_applies(t: QualifiedSecuritiesSale, a: Asset) kind empirical {
    label en official "section 1042(e)(3)(D): a transfer in a transaction to which section 1042(a) applies";
}
pub relation transfer_excepted_derived_1042e3(t: QualifiedSecuritiesSale, a: Asset) kind institutional {
    label en official "section 1042(e)(3): paragraph (1) does not apply to the transfer (derived from its four grounds)";
}
@source(IRC_S1042_E, relation = formalizes, coverage = exact, quote = "unless the person making the election under subsection (a)(1) owns stock representing control in the acquiring or acquired corporation and such property is substituted basis property in the hands of the transferee")
rule ExceptedReorganizationRule(t: QualifiedSecuritiesSale, a: Asset) defeasible {
    label en official "section 1042(e)(3)(A): a reorganization transfer with control and substituted basis";
    when reorganization_transfer_of_replacement_property(t, a);
    when electing_person_owns_control_of_acquiring_or_acquired_corporation(t);
    when replacement_property_is_substituted_basis_in_transferees_hands(t, a);
    then transfer_excepted_derived_1042e3(t, a);
}
@source(IRC_S1042_E, relation = formalizes, coverage = exact, quote = "by reason of the death of the person making such election")
rule ExceptedDeathRule(t: QualifiedSecuritiesSale, a: Asset) defeasible {
    label en official "section 1042(e)(3)(B): a transfer by reason of death";
    when transfer_by_death_of_electing_person(t, a);
    then transfer_excepted_derived_1042e3(t, a);
}
rule ExceptedGiftRule(t: QualifiedSecuritiesSale, a: Asset) defeasible {
    label en official "section 1042(e)(3)(C): a transfer by gift";
    when transfer_by_gift_1042(t, a);
    then transfer_excepted_derived_1042e3(t, a);
}
rule Excepted1042aRule(t: QualifiedSecuritiesSale, a: Asset) defeasible {
    label en official "section 1042(e)(3)(D): a transfer in a transaction to which section 1042(a) applies";
    when transfer_in_transaction_to_which_1042a_applies(t, a);
    then transfer_excepted_derived_1042e3(t, a);
}
pub relation election_in_effect_on_gain_1042f(t: QualifiedSecuritiesSale) kind empirical {
    label en official "section 1042(f): gain is realized on the sale of qualified securities and an election under subsection (a) is in effect";
}
pub relation assessment_permitted_notwithstanding_other_law_1042f2(t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(f)(2): the deficiency may be assessed before the 3-year period expires notwithstanding any other law";
}
@source(IRC_S1042_F, relation = formalizes, coverage = exact, quote = "such deficiency may be assessed before the expiration of such 3-year period notwithstanding the provisions of any other law or rule of law which would otherwise prevent such assessment")
rule AssessmentNotwithstanding1042fRule(t: QualifiedSecuritiesSale) defeasible {
    label en official "section 1042(f)(2): assessment is permitted notwithstanding other law";
    when election_in_effect_on_gain_1042f(t);
    then assessment_permitted_notwithstanding_other_law_1042f2(t);
}

// =============================================================================
// Section 1058(a); section 1236(c)
// =============================================================================

pub relation share_of_stock_or_certificate_or_interest_in_corporation_1236c(a: Asset) kind empirical {
    label en official "section 1236(c): a share of stock in a corporation, a certificate of stock or an interest in a corporation";
}
pub relation note_bond_debenture_or_evidence_of_indebtedness_1236c(a: Asset) kind empirical {
    label en official "section 1236(c): a note, bond, debenture or evidence of indebtedness";
}
pub relation right_to_subscribe_or_purchase_security_1236c(a: Asset) kind empirical {
    label en official "section 1236(c): an evidence of an interest in, or right to subscribe to or purchase, any of the foregoing";
}
pub relation security_1236c(a: Asset) kind institutional {
    label en official "section 1236(c): the term securities";
}
@source(IRC_S1236_C, relation = formalizes, coverage = partial, quote = "any share of stock in any corporation, certificate of stock or interest in any corporation")
rule Security1236cStockRule(a: Asset) strict {
    label en official "section 1236(c): stock, certificates and corporate interests are securities";
    when share_of_stock_or_certificate_or_interest_in_corporation_1236c(a);
    then security_1236c(a);
}
rule Security1236cDebtRule(a: Asset) strict {
    label en official "section 1236(c): notes, bonds and debentures are securities";
    when note_bond_debenture_or_evidence_of_indebtedness_1236c(a);
    then security_1236c(a);
}
rule Security1236cRightRule(a: Asset) strict {
    label en official "section 1236(c): rights to subscribe or purchase are securities";
    when right_to_subscribe_or_purchase_security_1236c(a);
    then security_1236c(a);
}
pub relation securities_lending_agreement_meets_1058b(t: Transaction) kind empirical {
    label en official "section 1058(a): the transfer is pursuant to an agreement which meets the requirements of subsection (b)";
}
pub relation rights_exchanged_for_identical_securities_1058(t: Transaction, p: Person, returned: Asset, transferred: Asset) kind empirical {
    label en official "section 1058(a): the taxpayer exchanges its rights under the agreement for securities identical to those transferred";
}
pub relation transfers_securities_under_agreement_1058(t: Transaction, p: Person, transferred: Asset) kind empirical {
    label en official "section 1058(a): the taxpayer transfers securities under the agreement";
}
pub relation identical_securities_1058(returned: Asset, transferred: Asset) kind empirical {
    label en official "section 1058(a): the returned securities are identical to the securities transferred";
}
pub relation return_leg_nonrecognition_1058a(t: Transaction, p: Person) kind institutional {
    label en official "section 1058(a): no gain or loss is recognized on the exchange of rights under the agreement for identical securities";
}
@source(IRC_S1058_A, relation = formalizes, coverage = exact, quote = "or on the exchange of rights under such agreement by that taxpayer for securities identical to the securities transferred by that taxpayer")
rule ReturnLegNonrecognitionRule(t: Transaction, p: Person, returned: Asset, transferred: Asset) defeasible {
    label en official "section 1058(a): the return exchange of rights for identical securities is not a recognition event";
    when securities_lending_agreement_meets_1058b(t);
    when transfers_securities_under_agreement_1058(t, p, transferred);
    when security_1236c(transferred);
    when rights_exchanged_for_identical_securities_1058(t, p, returned, transferred);
    when identical_securities_1058(returned, transferred);
    then return_leg_nonrecognition_1058a(t, p);
}

// =============================================================================
// Section 1059(c)(3)(C), (d)(5)
// =============================================================================

pub relation basis_of_stock_in_others_hands_by_reference_to_taxpayers(p: Person, q: Person, share: Asset) kind empirical {
    label en official "section 1059(c)(3)(C)(i): the basis of the stock in the hands of q is determined in whole or in part by reference to the taxpayer's basis";
}
pub relation basis_of_stock_in_taxpayers_hands_by_reference_to_others(p: Person, q: Person, share: Asset) kind empirical {
    label en official "section 1059(c)(3)(C)(ii): the basis of the stock in the hands of the taxpayer is determined in whole or in part by reference to q's basis";
}
pub relation person_described_derived_1059c3C(p: Person, q: Person) kind institutional {
    label en official "section 1059(c)(3)(C): a person whose basis in the stock is linked to the taxpayer's (derived from the basis links)";
}
@source(IRC_S1059_C, relation = formalizes, coverage = exact, quote = "the basis of such stock in the hands of such person is determined in whole or in part by reference to the basis of such stock in the hands of the taxpayer")
rule LinkedPersonBasisRule(p: Person, q: Person, share: Asset) defeasible {
    label en official "section 1059(c)(3)(C)(i): q's basis refers to the taxpayer's";
    when basis_of_stock_in_others_hands_by_reference_to_taxpayers(p, q, share);
    then person_described_derived_1059c3C(p, q);
}
rule LinkedPersonReverseBasisRule(p: Person, q: Person, share: Asset) defeasible {
    label en official "section 1059(c)(3)(C)(ii): the taxpayer's basis refers to q's";
    when basis_of_stock_in_taxpayers_hands_by_reference_to_others(p, q, share);
    then person_described_derived_1059c3C(p, q);
}
rule DividendReceivedByDerivedLinkedPersonRule(p: Person, q: Person, share: Asset, dv: ShareDividend, amount: Money) defeasible {
    label en official "section 1059(c)(3): a dividend received by a derived linked person counts with the taxpayer's";
    when person_described_derived_1059c3C(p, q);
    when dividend_received(dv, q, share, amount);
    then dividend_received_by_taxpayer_or_1059c3C_person(p, share, dv);
}
pub relation dividend_declared_on(dv: ShareDividend, on: Date) kind empirical {
    label en official "section 1059(d)(5): the date the corporation declares the dividend";
}
pub relation dividend_announced_on(dv: ShareDividend, on: Date) kind empirical {
    label en official "section 1059(d)(5): the date the corporation announces the dividend";
}
pub relation dividend_agreed_on(dv: ShareDividend, on: Date) kind empirical {
    label en official "section 1059(d)(5): the date the corporation agrees to the amount or payment of the dividend";
}
pub relation dividend_announcement_date_1059d5(dv: ShareDividend, on: Date) kind institutional {
    label en official "section 1059(d)(5): the dividend announcement date - the earliest of the declaration, announcement and agreement dates";
}
@source(IRC_S1059_D, relation = formalizes, coverage = exact, quote = "the date on which the corporation declares, announces, or agrees to the amount or payment of such dividend, whichever is the earliest")
rule AnnouncementDateDeclaredRule(dv: ShareDividend, a: Date, b: Date, c: Date) defeasible {
    label en official "section 1059(d)(5): the declaration date when it is earliest";
    when dividend_declared_on(dv, a);
    when dividend_announced_on(dv, b);
    when dividend_agreed_on(dv, c);
    when a <= b;
    when a <= c;
    then dividend_announcement_date_1059d5(dv, a);
}
rule AnnouncementDateAnnouncedRule(dv: ShareDividend, a: Date, b: Date, c: Date) defeasible {
    label en official "section 1059(d)(5): the announcement date when it is earliest";
    when dividend_declared_on(dv, a);
    when dividend_announced_on(dv, b);
    when dividend_agreed_on(dv, c);
    when b < a;
    when b <= c;
    then dividend_announcement_date_1059d5(dv, b);
}
rule AnnouncementDateAgreedRule(dv: ShareDividend, a: Date, b: Date, c: Date) defeasible {
    label en official "section 1059(d)(5): the agreement date when it is earliest";
    when dividend_declared_on(dv, a);
    when dividend_announced_on(dv, b);
    when dividend_agreed_on(dv, c);
    when c < a;
    when c < b;
    then dividend_announcement_date_1059d5(dv, c);
}

// =============================================================================
// Section 1092(c)(4)(E)
// =============================================================================

pub relation covered_call_options_closed_or_stock_disposed_at_loss_1092c4Ei(p: Person, a: StraddlePosition, b: StraddlePosition, y: TaxableYear) kind empirical {
    label en official "section 1092(c)(4)(E)(i): the qualified covered call options are closed or the stock is disposed of at a loss during the taxable year";
}
pub relation stock_gain_included_in_later_year_1092c4Eii(p: Person, a: StraddlePosition, b: StraddlePosition) kind empirical {
    label en official "section 1092(c)(4)(E)(ii): gain on disposition of the stock to be purchased under the options is included in gross income in a later taxable year";
}
pub relation stock_or_option_held_30_days_after_closing_1092c4Eiii(p: Person, a: StraddlePosition, b: StraddlePosition) kind empirical {
    label en official "section 1092(c)(4)(E)(iii): the stock or option was held by the taxpayer for 30 days or more after the closing or disposition";
}
pub relation covered_call_disqualification_derived_1092c4E(p: Person, a: StraddlePosition, b: StraddlePosition, y: TaxableYear) kind institutional {
    label en official "section 1092(c)(4)(E): subparagraph (A) does not apply to the straddle (all three conditions, derived)";
}
@source(IRC_S1092_C, relation = formalizes, coverage = partial, quote = "the qualified covered call options referred to in such subparagraph are closed or the stock is disposed of at a loss during any taxable year")
rule CoveredCallDisqualificationRule(p: Person, a: StraddlePosition, b: StraddlePosition, y: TaxableYear) defeasible {
    label en official "section 1092(c)(4)(E): closed or loss disposal, later-year gain, and no 30-day holding disqualify the exclusion";
    when covered_call_options_closed_or_stock_disposed_at_loss_1092c4Ei(p, a, b, y);
    when stock_gain_included_in_later_year_1092c4Eii(p, a, b);
    when not_known(stock_or_option_held_30_days_after_closing_1092c4Eiii(p, a, b));
    then covered_call_disqualification_derived_1092c4E(p, a, b, y);
}

// =============================================================================
// Section 1277(c)
// =============================================================================

pub relation taxpayer_is_bank_585a2(taxpayer: Person) kind empirical {
    label en official "section 1277(c): the taxpayer is a financial institution which is a bank (as defined in section 585(a)(2))";
}
pub relation bank_interest_described_under_291e1Bii_principles(bond: DebtInstrument, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "section 1277(c): for a bank, whether the interest is described in paragraph (1) is determined under principles similar to section 291(e)(1)(B)(ii) (an adjudicated determination)";
}
pub relation short_sale_expenses_1277c(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1277(c): short sale expenses, treated as interest under rules similar to section 265(a)(5)";
}
pub relation interest_counted_for_1277c1(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(c)(1): the interest on indebtedness incurred or continued to purchase or carry the bond, with short sale expenses treated as interest (a bank counts it only where described)";
}
@source(IRC_S1277_C, relation = formalizes, coverage = exact, quote = "the amount of interest paid or accrued during the taxable year on indebtedness which is incurred or continued to purchase or carry such bond")
rule InterestCountedNonBankRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, paid: Money, short_sale: Money) defeasible {
    label en official "section 1277(c)(1): interest plus short sale expenses (non-bank)";
    when interest_paid_on_carrying_debt_1277c1(bond, taxpayer, y, paid);
    when short_sale_expenses_1277c(bond, taxpayer, y, short_sale);
    when not_known(taxpayer_is_bank_585a2(taxpayer));
    then interest_counted_for_1277c1(bond, taxpayer, y, paid + short_sale);
}
rule InterestCountedBankDescribedRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, paid: Money, short_sale: Money) defeasible {
    label en official "section 1277(c)(1): a bank counts interest determined to be described under the 291(e)(1)(B)(ii) principles";
    when interest_paid_on_carrying_debt_1277c1(bond, taxpayer, y, paid);
    when short_sale_expenses_1277c(bond, taxpayer, y, short_sale);
    when taxpayer_is_bank_585a2(taxpayer);
    when bank_interest_described_under_291e1Bii_principles(bond, taxpayer, y);
    then interest_counted_for_1277c1(bond, taxpayer, y, paid + short_sale);
}
rule InterestCountedBankNotDescribedRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, paid: Money, short_sale: Money) defeasible {
    label en official "section 1277(c)(1): a bank counts only the short sale expenses where the interest is not described";
    when interest_paid_on_carrying_debt_1277c1(bond, taxpayer, y, paid);
    when short_sale_expenses_1277c(bond, taxpayer, y, short_sale);
    when taxpayer_is_bank_585a2(taxpayer);
    when not_known(bank_interest_described_under_291e1Bii_principles(bond, taxpayer, y));
    then interest_counted_for_1277c1(bond, taxpayer, y, short_sale);
}
pub relation net_direct_interest_expense_computed_1277c(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(c): the excess of the interest counted under paragraph (1) over the interest (including original issue discount) includible under paragraph (2)";
}
@source(IRC_S1277_C, relation = formalizes, coverage = exact, quote = "the aggregate amount of interest (including original issue discount) includible in gross income for the taxable year with respect to such bond")
rule NetDirectInterestComputedRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, counted: Money, included: Money) defeasible {
    label en official "section 1277(c): the excess of counted interest over included interest";
    when interest_counted_for_1277c1(bond, taxpayer, y, counted);
    when interest_included_in_gross_income_1277c2(bond, taxpayer, y, included);
    when counted > included;
    then net_direct_interest_expense_computed_1277c(bond, taxpayer, y, counted - included);
}
rule NetDirectInterestComputedNoneRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, counted: Money, included: Money) defeasible {
    label en official "section 1277(c): no net direct interest expense when the included interest is at least the counted interest";
    when interest_counted_for_1277c1(bond, taxpayer, y, counted);
    when interest_included_in_gross_income_1277c2(bond, taxpayer, y, included);
    when counted <= included;
    then net_direct_interest_expense_computed_1277c(bond, taxpayer, y, 0.00 USD);
}
rule NetDirectInterestDisallowedComputedWithinRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, expense: Money, allocable: Money) defeasible {
    label en official "section 1277(a): computed expense not exceeding the allocable market discount is disallowed";
    when net_direct_interest_expense_computed_1277c(bond, taxpayer, y, expense);
    when market_discount_allocable_to_year(bond, taxpayer, y, allocable);
    when not_known(tax_exempt_obligation(bond));
    when expense <= allocable;
    then net_direct_interest_expense_deduction_disallowed(bond, taxpayer, y, expense);
}
rule NetDirectInterestDisallowedComputedCappedRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, expense: Money, allocable: Money) defeasible {
    label en official "section 1277(a): computed expense above the allocable market discount is disallowed only up to it";
    when net_direct_interest_expense_computed_1277c(bond, taxpayer, y, expense);
    when market_discount_allocable_to_year(bond, taxpayer, y, allocable);
    when not_known(tax_exempt_obligation(bond));
    when expense > allocable;
    then net_direct_interest_expense_deduction_disallowed(bond, taxpayer, y, allocable);
}

// =============================================================================
// Section 1276(b)(2): the constant-yield amount
// =============================================================================

pub relation constant_yield_deemed_instrument_1276b2(bond: DebtInstrument, deemed: DebtInstrument) kind empirical {
    label en official "section 1276(b)(2)(A): the bond as if originally issued on the acquisition date for an issue price equal to the taxpayer's basis (the case supplies the deemed instrument's yield and periodic interest)";
}
pub relation deemed_issue_price_1276b2A(deemed: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1276(b)(2)(A)(ii): the deemed issue price equals the taxpayer's basis immediately after acquisition";
}
rule DeemedIssuePriceRule(bond: DebtInstrument, deemed: DebtInstrument, basis: Money) defeasible {
    label en official "section 1276(b)(2)(A)(ii): issue price equal to the basis";
    when constant_yield_deemed_instrument_1276b2(bond, deemed);
    when market_discount_basis_after_acquisition(bond, basis);
    then deemed_issue_price_1276b2A(deemed, basis);
}
pub relation constant_yield_accrued_market_discount_1276b2(bond: DebtInstrument, taxpayer: Person, periods_held: Integer, amount: Money) kind institutional {
    label en official "section 1276(b)(2)(A): the accrued market discount - the increase in the deemed instrument's adjusted issue price over the periods held (the module 39 chain, up to five periods)";
}
rule DeemedInstrumentIssuePriceRule(deemed: DebtInstrument, basis: Money) defeasible {
    label en official "section 1276(b)(2)(A)(ii): the deemed instrument's issue price for the section 1272(a)(4) chain";
    when deemed_issue_price_1276b2A(deemed, basis);
    then issue_price(deemed, basis);
}
@source(IRC_S1276_B, relation = formalizes, coverage = exact, quote = "the accrued market discount on such bond shall be the aggregate amount which would have been includible in the gross income of the taxpayer under section 1272(a)")
rule ConstantYieldAccruedRule(bond: DebtInstrument, taxpayer: Person, deemed: DebtInstrument, n: Integer, aip: Money, basis: Money) defeasible {
    label en official "section 1276(b)(2)(A): the increase in the deemed instrument's adjusted issue price over the periods held";
    when constant_interest_rate_election_in_effect(bond, taxpayer);
    when constant_yield_deemed_instrument_1276b2(bond, deemed);
    when deemed_issue_price_1276b2A(deemed, basis);
    when rolled_adjusted_issue_price_1272a4(deemed, n, aip);
    when n >= 2;
    then constant_yield_accrued_market_discount_1276b2(bond, taxpayer, n - 1, aip - basis);
}

// =============================================================================
// Section 1278(a)(1)(D)
// =============================================================================

pub relation basis_determined_under_1012_1278a1Dii(bond: DebtInstrument, taxpayer: Person) kind empirical {
    label en official "section 1278(a)(1)(D)(ii)(I): the taxpayer's basis in the bond is determined under section 1012";
}
pub relation basis_less_than_issue_price_1278a1Dii(bond: DebtInstrument, taxpayer: Person) kind empirical {
    label en official "section 1278(a)(1)(D)(ii)(II): the basis is less than the issue price of the bond determined under subpart A of part V";
}
pub relation bond_issued_in_reorganization_for_bond_with_market_discount(bond: DebtInstrument) kind empirical {
    label en official "section 1278(a)(1)(D)(iii): the bond is issued pursuant to a plan of reorganization (section 368(a)(1)) in exchange for another bond having market discount";
}
pub relation prior_bond_issued_on_or_before_1984_07_18_same_terms(bond: DebtInstrument) kind empirical {
    label en official "section 1278(a)(1)(D)(iii): solely for section 1276, the other bond was issued on or before July 18, 1984 and the new bond has the same term and interest rate";
}
pub relation transferor_acquired_bond_at_original_issue_1278a1Div(bond: DebtInstrument, taxpayer: Person) kind empirical {
    label en official "section 1278(a)(1)(D)(iv): the taxpayer's adjusted basis is determined by reference to the basis in the hands of a person who acquired the bond at its original issue";
}
pub relation original_issue_exception_applies_1278a1D(bond: DebtInstrument, taxpayer: Person) kind institutional {
    label en official "section 1278(a)(1)(D)(ii)-(iii): clause (i) does not apply to the bond";
}
@source(IRC_S1278_A, relation = formalizes, coverage = exact, quote = "the basis of the taxpayer in such bond is determined under section 1012")
rule OriginalIssueExceptionBelowIssuePriceRule(bond: DebtInstrument, taxpayer: Person) defeasible {
    label en official "section 1278(a)(1)(D)(ii): a bond acquired for less than its issue price is not excluded";
    when basis_determined_under_1012_1278a1Dii(bond, taxpayer);
    when basis_less_than_issue_price_1278a1Dii(bond, taxpayer);
    then original_issue_exception_applies_1278a1D(bond, taxpayer);
}
@source(IRC_S1278_A, relation = formalizes, coverage = exact, quote = "Clause (i) shall not apply to any bond issued pursuant to a plan of reorganization (within the meaning of section 368(a)(1)) in exchange for another bond having market discount")
rule OriginalIssueExceptionReorganizationRule(bond: DebtInstrument, taxpayer: Person) defeasible {
    label en official "section 1278(a)(1)(D)(iii): a bond issued in a reorganization in exchange for a discount bond is not excluded";
    when bond_issued_in_reorganization_for_bond_with_market_discount(bond);
    when bond_held_by(bond, taxpayer);
    then original_issue_exception_applies_1278a1D(bond, taxpayer);
}
pub relation original_issue_exclusion_applies_1278a1D(bond: DebtInstrument, taxpayer: Person) kind institutional {
    label en official "section 1278(a)(1)(D)(i), (iv): the bond is treated as acquired at original issue, so it is not a market discount bond";
}
@source(IRC_S1278_A, relation = formalizes, coverage = exact, quote = "such bond shall be treated as acquired by the taxpayer at its original issue")
rule OriginalIssueExclusionDirectRule(bond: DebtInstrument, taxpayer: Person) defeasible {
    label en official "section 1278(a)(1)(D)(i): a bond acquired at original issue is excluded unless an exception applies";
    when acquired_at_original_issue(bond, taxpayer);
    when not_known(original_issue_exception_applies_1278a1D(bond, taxpayer));
    then original_issue_exclusion_applies_1278a1D(bond, taxpayer);
}
rule OriginalIssueExclusionTransferredBasisRule(bond: DebtInstrument, taxpayer: Person) defeasible {
    label en official "section 1278(a)(1)(D)(iv): a bond with basis derived from an original-issue acquirer is treated as acquired at original issue";
    when transferor_acquired_bond_at_original_issue_1278a1Div(bond, taxpayer);
    when not_known(original_issue_exception_applies_1278a1D(bond, taxpayer));
    then original_issue_exclusion_applies_1278a1D(bond, taxpayer);
}

// =============================================================================
// Section 1313(a)(3): final disposition of a refund claim
// =============================================================================

pub relation claim_item_allowed_on(d: Determination, on: Date) kind empirical {
    label en official "section 1313(a)(3)(A): the date of allowance of refund or credit";
}
pub relation notice_of_disallowance_by_offsetting_items_mailed_on(d: Determination, on: Date) kind empirical {
    label en official "section 1313(a)(3)(A): the date of mailing notice of disallowance (by reason of offsetting items) of the claim";
}
pub relation time_for_suit_expired_on(d: Determination, on: Date) kind empirical {
    label en official "section 1313(a)(3)(B): the date the time for instituting suit expires";
}
pub relation suit_instituted_before_expiration(d: Determination) kind empirical {
    label en official "section 1313(a)(3)(B): suit is instituted before the expiration of the time";
}
pub relation claim_finally_disposed_on_1313a3(d: Determination, on: Date) kind institutional {
    label en official "section 1313(a)(3): the date the claim for refund is deemed finally disposed of by the Secretary";
}
@source(IRC_S1313_A, relation = formalizes, coverage = exact, quote = "as to items with respect to which the claim was allowed, on the date of allowance of refund or credit")
rule DisposedOnAllowanceRule(d: Determination, on: Date) defeasible {
    label en official "section 1313(a)(3)(A): items allowed - the date of allowance";
    when claim_item_allowed_on(d, on);
    then claim_finally_disposed_on_1313a3(d, on);
}
rule DisposedOnOffsetNoticeRule(d: Determination, on: Date) defeasible {
    label en official "section 1313(a)(3)(A): the date of mailing notice of disallowance by reason of offsetting items";
    when notice_of_disallowance_by_offsetting_items_mailed_on(d, on);
    then claim_finally_disposed_on_1313a3(d, on);
}
@source(IRC_S1313_A, relation = formalizes, coverage = exact, quote = "on expiration of the time for instituting suit with respect thereto (unless suit is instituted before the expiration of such time)")
rule DisposedOnSuitExpiryRule(d: Determination, on: Date) defeasible {
    label en official "section 1313(a)(3)(B): items disallowed - the expiration of the time for suit unless suit is instituted";
    when time_for_suit_expired_on(d, on);
    when not_known(suit_instituted_before_expiration(d));
    then claim_finally_disposed_on_1313a3(d, on);
}

// =============================================================================
// Section 1396(d)(2): the exclusions
// =============================================================================

pub relation employee_of_1396(employee: Person, employer: Person) kind empirical {
    label en official "the individual is an employee of the employer";
}
pub relation individual_described_in_51i1_ABC(employee: Person) kind empirical {
    label en official "section 1396(d)(2)(A): an individual described in subparagraph (A), (B) or (C) of section 51(i)(1)";
}
pub relation five_percent_owner_416i1B(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(2)(B): a 5-percent owner (as defined in section 416(i)(1)(B))";
}
pub relation employed_at_144c6B_facility(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(2)(D): employed at a facility described in section 144(c)(6)(B)";
}
pub relation employed_in_farming_business(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(2)(E): employed in a trade or business the principal activity of which is farming (section 2032A(e)(5)(A) or (B))";
}
pub relation farming_assets_owned_bases_or_fmv(employer: Person, amount: Money) kind empirical {
    label en official "section 1396(d)(2)(E)(i): the aggregate unadjusted bases (or, if greater, the fair market value) of the assets owned by the employer used in such a business, at the close of the taxable year";
}
pub relation farming_assets_leased_value(employer: Person, amount: Money) kind empirical {
    label en official "section 1396(d)(2)(E)(ii): the aggregate value of assets leased by the employer used in such a business";
}
pub const Section1396FarmingAssetThreshold: Money = 500000.00 USD {
    label en official "$500,000 (section 1396(d)(2)(E))";
};
pub relation employee_excluded_derived_1396d2(employee: Person, employer: Person) kind institutional {
    label en official "section 1396(d)(2): the individual is not a qualified zone employee (derived from the exclusions other than the 90-day rule)";
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "any individual described in subparagraph (A), (B), or (C) of section 51(i)(1)")
rule ExclusionSection51iRule(employee: Person, employer: Person) defeasible {
    label en official "section 1396(d)(2)(A): a section 51(i)(1) individual";
    when individual_described_in_51i1_ABC(employee);
    when employee_of_1396(employee, employer);
    then employee_excluded_derived_1396d2(employee, employer);
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "any 5-percent owner (as defined in section 416(i)(1)(B))")
rule ExclusionFivePercentOwnerRule(employee: Person, employer: Person) defeasible {
    label en official "section 1396(d)(2)(B): a 5-percent owner";
    when five_percent_owner_416i1B(employee, employer);
    then employee_excluded_derived_1396d2(employee, employer);
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "any individual employed by the employer at any facility described in section 144(c)(6)(B)")
rule ExclusionFacilityRule(employee: Person, employer: Person) defeasible {
    label en official "section 1396(d)(2)(D): employed at a section 144(c)(6)(B) facility";
    when employed_at_144c6B_facility(employee, employer);
    then employee_excluded_derived_1396d2(employee, employer);
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "exceeds $500,000")
rule ExclusionFarmingRule(employee: Person, employer: Person, owned: Money, leased: Money) defeasible {
    label en official "section 1396(d)(2)(E): employed in farming where owned and leased assets exceed $500,000";
    when employed_in_farming_business(employee, employer);
    when farming_assets_owned_bases_or_fmv(employer, owned);
    when farming_assets_leased_value(employer, leased);
    when (owned + leased) > Section1396FarmingAssetThreshold;
    then employee_excluded_derived_1396d2(employee, employer);
}

// =============================================================================
// Section 1014(e)(2), (f)(1)(B); section 1015(d)(4)
// =============================================================================

pub relation fair_market_value_on_gift_to_decedent(a: Asset, amount: Money) kind empirical {
    label en official "section 1014(e)(2)(A): the fair market value of the property on the day it was transferred to the decedent by gift";
}
pub relation adjusted_basis_on_gift_to_decedent(a: Asset, amount: Money) kind empirical {
    label en official "section 1014(e)(2)(A): the property's adjusted basis";
}
pub relation appreciated_property_1014e2A(a: Asset) kind institutional {
    label en official "section 1014(e)(2)(A): appreciated property - the value on the gift day exceeds the adjusted basis";
}
@source(IRC_S1014_E, relation = formalizes, coverage = exact, quote = "The term \"appreciated property\" means any property if the fair market value of such property on the day it was transferred to the decedent by gift exceeds its adjusted basis")
rule AppreciatedPropertyRule(a: Asset, fmv: Money, basis: Money) defeasible {
    label en official "section 1014(e)(2)(A): the value exceeds the basis";
    when fair_market_value_on_gift_to_decedent(a, fmv);
    when adjusted_basis_on_gift_to_decedent(a, basis);
    when fmv > basis;
    then appreciated_property_1014e2A(a);
}
pub relation decedents_adjusted_basis_before_death_1014e(a: Asset, amount: Money) kind empirical {
    label en official "section 1014(e)(1): the adjusted basis of the property in the hands of the decedent immediately before death";
}
pub relation donor_entitled_share_of_estate_sale_proceeds_1014e2B(a: Asset, donor: Person, share: Decimal) kind empirical {
    label en official "section 1014(e)(2)(B): the extent to which the donor (or the donor's spouse) is entitled to the proceeds of a sale by the estate or a grantor trust";
}
pub relation basis_rule_on_estate_sale_1014e2B(a: Asset, donor: Person, amount: Money) kind institutional {
    label en official "section 1014(e)(2)(B): the donor's basis follows the decedent's adjusted basis to the extent of the donor's entitlement to the sale proceeds (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1014_E, relation = formalizes, coverage = exact, quote = "rules similar to the rules of paragraph (1) shall apply to the extent the donor of such property (or the spouse of such donor) is entitled to the proceeds from such sale")
rule EstateSaleBasisRule(a: Asset, donor: Person, basis: Money, share: Decimal) defeasible {
    label en official "section 1014(e)(2)(B): an estate or trust sale of appreciated gift property";
    when appreciated_property_1014e2A(a);
    when decedents_adjusted_basis_before_death_1014e(a, basis);
    when donor_entitled_share_of_estate_sale_proceeds_1014e2B(a, donor, share);
    then basis_rule_on_estate_sale_1014e2B(a, donor, round(basis * share, 2, "HALF_UP"));
}
pub relation statement_value_6035a(a: Asset, amount: Money) kind empirical {
    label en official "section 1014(f)(1)(B): the value of the property identified in a statement furnished under section 6035(a)";
}
pub relation inclusion_increased_estate_tax_liability_1014f2(a: Asset) kind empirical {
    label en official "section 1014(f)(2): the property's inclusion in the estate increased the chapter 11 liability (reduced by credits)";
}
pub relation basis_ceiling_1014f1(a: Asset, amount: Money) kind institutional {
    label en official "section 1014(f)(1): the basis may not exceed the final chapter 11 value or, failing that, the section 6035(a) statement value";
}
@source(IRC_S1014_F, relation = formalizes, coverage = exact, quote = "in the case of property not described in subparagraph (A) and with respect to which a statement has been furnished under section 6035(a) identifying the value of such property, such value")
rule BasisCeilingStatementRule(a: Asset, statement: Money) defeasible {
    label en official "section 1014(f)(1)(B): the statement value where no final value has been determined";
    when inclusion_increased_estate_tax_liability_1014f2(a);
    when statement_value_6035a(a, statement);
    when not_known(chapter_11_value_determined_1014f3(a));
    then basis_ceiling_1014f1(a, statement);
}
pub relation final_value_for_ceiling_1014f1A(a: Asset, amount: Money) kind empirical {
    label en official "section 1014(f)(1)(A): the final value determined for chapter 11 purposes";
}
@source(IRC_S1014_F, relation = formalizes, coverage = exact, quote = "in the case of property the final value of which has been determined for purposes of the tax imposed by chapter 11 on the estate of such decedent, such value")
rule BasisCeilingFinalValueRule(a: Asset, final_value: Money) defeasible {
    label en official "section 1014(f)(1)(A): the final value when determined";
    when inclusion_increased_estate_tax_liability_1014f2(a);
    when chapter_11_value_determined_1014f3(a);
    when final_value_for_ceiling_1014f1A(a, final_value);
    then basis_ceiling_1014f1(a, final_value);
}
pub relation gift_tax_basis_increase_treated_as_1016a_adjustment_1015d4(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "section 1015(d)(4): the increase in basis for gift tax paid is treated as an adjustment under section 1016(a)";
}
@source(IRC_S1015_D, relation = formalizes, coverage = exact, quote = "an increase in basis under paragraph (1) shall be treated as an adjustment under section 1016(a)")
rule GiftTaxIncreaseIs1016aAdjustmentRule(p: Person, a: Asset, donor_basis: Money, after: Money) defeasible {
    label en official "section 1015(d)(4): the gift-tax increase is a section 1016(a) adjustment";
    when gift_basis_for_gain(p, a, donor_basis);
    when gift_basis_for_gain_after_gift_tax(p, a, after);
    when after > donor_basis;
    then gift_tax_basis_increase_treated_as_1016a_adjustment_1015d4(p, a, after - donor_basis);
}
