// Stage 3b (IRC-07, A05). Section 1223 tacking to a bounded depth. Modules 05 gave one and two
// hops through per-hop relations; this module replaces the depth limit by an unrolled chain of
// acquisition dates (LDC-E4102: a rule concluding acquired_on from acquired_on is a
// predicate-level cycle, so each chain step is its own predicate).
//
// Method. `tack_link_1223(p, old, new)` collects every tacking source ((1) exchanges, (3) wash sales,
// (4) section 307, (7) and (14) contracts, (11)-(13) nonrecognition sales). `tack_date_k` is the
// acquisition date carried k steps along the links (k = 0..5, JUDGMENT: a sixth step needs
// another predicate); the earliest carried date decides the holding period, so `long_term` reads
// every slot. (2) carries the prior holder's date into the slot 0 of the transferee. (5), (10) are
// rules of their own.

use self::{
    Asset,
    IRC_S1223,
    Person,
    Transaction,
    acquired_on,
    acquired_substantially_identical_stock_or_securities,
    capital_asset,
    decedent_died_on,
    disposed_on,
    exchange_with_substituted_basis,
    involuntary_conversion,
    long_term,
    section_1256_contract_by_definition,
    securities_futures_contract_definition_met_1234Bc,
    substituted_basis_from,
};

pub relation tack_link_1223(p: Person, old_asset: Asset, new_asset: Asset) kind institutional {
    label en unofficial "section 1223: the holding period of old_asset is included in the holding period of new_asset";
}
rule LinkFromSubstitutedExchangeRule(p: Person, old_asset: Asset, new_asset: Asset) defeasible {
    label en official "section 1223(1): a substituted-basis exchange links the assets";
    when exchange_with_substituted_basis(p, old_asset, new_asset);
    then tack_link_1223(p, old_asset, new_asset);
}
pub relation same_basis_in_whole_or_part_1223(p: Person, old_asset: Asset, new_asset: Asset) kind empirical {
    label en official "section 1223(1): under the chapter the property has the same basis in whole or in part in the taxpayer's hands as the property exchanged";
}
pub relation property_acquired_by_conversion(t: Transaction, new_asset: Asset) kind empirical {
    label en official "section 1223(1)(A): the property acquired on the involuntary conversion";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "an involuntary conversion described in section 1033 shall be considered an exchange of the property converted for the property acquired")
rule LinkFromInvoluntaryConversionCapitalRule(p: Person, t: Transaction, old_asset: Asset, new_asset: Asset) defeasible {
    label en official "section 1223(1)(A): a section 1033 conversion is an exchange of the converted property for the property acquired (capital asset)";
    when involuntary_conversion(t, p, old_asset);
    when property_acquired_by_conversion(t, new_asset);
    when same_basis_in_whole_or_part_1223(p, old_asset, new_asset);
    when capital_asset(p, old_asset);
    then tack_link_1223(p, old_asset, new_asset);
}
pub relation old_asset_was_section_1231_property_at_exchange(p: Person, old_asset: Asset) kind empirical {
    label en official "section 1223(1): the property exchanged was property described in section 1231 at the time of the exchange (a case fact; the derived section_1231b_property reads long_term and would make a cycle)";
}
rule LinkFromInvoluntaryConversionSection1231Rule(p: Person, t: Transaction, old_asset: Asset, new_asset: Asset) defeasible {
    label en official "section 1223(1)(A): a section 1033 conversion is an exchange (section 1231 property)";
    when involuntary_conversion(t, p, old_asset);
    when property_acquired_by_conversion(t, new_asset);
    when same_basis_in_whole_or_part_1223(p, old_asset, new_asset);
    when old_asset_was_section_1231_property_at_exchange(p, old_asset);
    then tack_link_1223(p, old_asset, new_asset);
}
pub relation section_355_distribution_of(t: Transaction, p: Person, old_asset: Asset, new_asset: Asset) kind empirical {
    label en official "section 1223(1)(B): a distribution to which section 355 (or so much of section 356 as relates to section 355) applies";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "a distribution to which section 355 (or so much of section 356 as relates to section 355) applies shall be treated as an exchange")
rule LinkFromSection355Rule(p: Person, t: Transaction, old_asset: Asset, new_asset: Asset) defeasible {
    label en official "section 1223(1)(B): a section 355 distribution is treated as an exchange";
    when section_355_distribution_of(t, p, old_asset, new_asset);
    when same_basis_in_whole_or_part_1223(p, old_asset, new_asset);
    when capital_asset(p, old_asset);
    then tack_link_1223(p, old_asset, new_asset);
}
pub relation loss_disallowed_on_sale_under_1091(p: Person, old_asset: Asset) kind empirical {
    label en official "section 1223(3): the loss on the sale of the stock or securities was disallowed under section 1091";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "there shall be included the period for which he held the stock or securities the loss from the sale or other disposition of which was not deductible")
rule LinkFromWashSaleRule(p: Person, old_asset: Asset, new_asset: Asset, on: Date) defeasible {
    label en official "section 1223(3): the replacement stock or securities include the holding period of those sold at a disallowed loss";
    when acquired_substantially_identical_stock_or_securities(p, old_asset, new_asset, on);
    when loss_disallowed_on_sale_under_1091(p, old_asset);
    then tack_link_1223(p, old_asset, new_asset);
}
pub relation stock_or_rights_received_on_distribution(p: Person, old_stock: Asset, new_asset: Asset) kind empirical {
    label en official "section 1223(4): stock or rights received on a distribution with respect to the stock in the distributing corporation";
}
pub relation basis_determined_under_307(p: Person, new_asset: Asset) kind empirical {
    label en official "section 1223(4): the basis of the stock or rights is determined under section 307";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "there shall (under regulations prescribed by the Secretary) be included the period for which he held the stock in the distributing corporation before the receipt of such stock or rights upon such distribution")
rule LinkFromSection307Rule(p: Person, old_stock: Asset, new_asset: Asset) defeasible {
    label en official "section 1223(4): stock or rights with a section 307 basis include the holding period of the distributing-corporation stock";
    when stock_or_rights_received_on_distribution(p, old_stock, new_asset);
    when basis_determined_under_307(p, new_asset);
    then tack_link_1223(p, old_stock, new_asset);
}
pub relation commodity_acquired_in_satisfaction_of_contract(p: Person, contract: Asset, commodity: Asset) kind empirical {
    label en official "section 1223(7): a commodity acquired in satisfaction of a commodity futures contract";
}
pub relation futures_contract_was_capital_asset_1223(p: Person, contract: Asset) kind empirical {
    label en official "section 1223(7), (14): the contract was a capital asset in the taxpayer's hands";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "there shall be included the period for which he held the commodity futures contract if such commodity futures contract was a capital asset in his hands")
rule LinkFromCommodityFuturesRule(p: Person, contract: Asset, commodity: Asset) defeasible {
    label en official "section 1223(7): the commodity includes the contract's holding period (a contract other than a section 1256 contract)";
    when commodity_acquired_in_satisfaction_of_contract(p, contract, commodity);
    when futures_contract_was_capital_asset_1223(p, contract);
    when not_known(section_1256_contract_by_definition(contract));
    then tack_link_1223(p, contract, commodity);
}
pub relation security_acquired_in_satisfaction_of_securities_futures_contract(p: Person, contract: Asset, security: Asset) kind empirical {
    label en official "section 1223(14): the security to which a securities futures contract relates is acquired in satisfaction of the contract";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "there shall be included the period for which the taxpayer held such contract if such contract was a capital asset in the hands of the taxpayer")
rule LinkFromSecuritiesFuturesRule(p: Person, contract: Asset, security: Asset) defeasible {
    label en official "section 1223(14): the security includes the securities futures contract's holding period (a contract other than a section 1256 contract)";
    when security_acquired_in_satisfaction_of_securities_futures_contract(p, contract, security);
    when securities_futures_contract_definition_met_1234Bc(contract);
    when futures_contract_was_capital_asset_1223(p, contract);
    when not_known(section_1256_contract_by_definition(contract));
    then tack_link_1223(p, contract, security);
}
pub relation replacement_from_nonrecognition_sale_1042(p: Person, sold_asset: Asset, replacement: Asset) kind empirical {
    label en official "section 1223(11): qualified replacement property whose acquisition resulted under section 1042 in nonrecognition of gain on the sale of qualified securities";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "there shall be included the period for which such qualified securities had been held by the taxpayer")
rule LinkFromSection1042Rule(p: Person, sold_asset: Asset, replacement: Asset) defeasible {
    label en official "section 1223(11): the qualified replacement property includes the qualified securities' holding period";
    when replacement_from_nonrecognition_sale_1042(p, sold_asset, replacement);
    then tack_link_1223(p, sold_asset, replacement);
}
pub relation replacement_from_nonrecognition_sale_1043(p: Person, sold_asset: Asset, replacement: Asset) kind empirical {
    label en official "section 1223(12): property whose acquisition resulted under section 1043 in nonrecognition of gain on the sale of other property";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "there shall be included the period for which such other property had been held as of the date of such sale")
rule LinkFromSection1043Rule(p: Person, sold_asset: Asset, replacement: Asset) defeasible {
    label en official "section 1223(12): the property includes the holding period of the property sold";
    when replacement_from_nonrecognition_sale_1043(p, sold_asset, replacement);
    then tack_link_1223(p, sold_asset, replacement);
}
pub relation replacement_from_nonrecognition_sale_1045_or_1397B(p: Person, sold_asset: Asset, replacement: Asset) kind empirical {
    label en official "section 1223(13): property whose acquisition resulted under section 1045 or 1397B in nonrecognition of gain on the sale of other property";
}
pub relation determination_for_1202_a2_or_c2A(replacement: Asset) kind empirical {
    label en official "section 1223(13): the determination is for purposes of subsection (a)(2) or (c)(2)(A) of section 1202";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "Except for purposes of subsections (a)(2) and (c)(2)(A) of section 1202")
rule LinkFromSection1045Or1397BRule(p: Person, sold_asset: Asset, replacement: Asset) defeasible {
    label en official "section 1223(13): rollover property includes the holding period of the property sold, except for section 1202(a)(2) and (c)(2)(A)";
    when replacement_from_nonrecognition_sale_1045_or_1397B(p, sold_asset, replacement);
    when not_known(determination_for_1202_a2_or_c2A(replacement));
    then tack_link_1223(p, sold_asset, replacement);
}

// chain of carried acquisition dates (slot k = k links back)
pub relation tack_date_0(p: Person, a: Asset, d: Date) kind institutional {
    label en unofficial "section 1223: the asset's own acquisition date (slot 0), or the prior holder's date under (2)";
}
rule TackDate0OwnRule(p: Person, a: Asset, d: Date) defeasible {
    label en official "section 1223: the taxpayer's own acquisition date";
    when acquired_on(p, a, d);
    then tack_date_0(p, a, d);
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "there shall be included the period for which such property was held by any other person")
rule TackDate0PriorHolderRule(p: Person, a: Asset, prior: Person, d: Date) defeasible {
    label en official "section 1223(2): the prior holder's period is included where the basis is the same in whole or part as in the other person's hands";
    when substituted_basis_from(p, a, prior);
    when acquired_on(prior, a, d);
    then tack_date_0(p, a, d);
}
pub relation tack_date_1(p: Person, a: Asset, d: Date) kind institutional {
    label en unofficial "section 1223: the acquisition date carried 1 link(s) back";
}
rule TackDate1Rule(p: Person, old_asset: Asset, a: Asset, d: Date) defeasible {
    label en official "section 1223: the acquisition date of the property 1 link(s) back is included";
    when tack_link_1223(p, old_asset, a);
    when tack_date_0(p, old_asset, d);
    then tack_date_1(p, a, d);
}
pub relation tack_date_2(p: Person, a: Asset, d: Date) kind institutional {
    label en unofficial "section 1223: the acquisition date carried 2 link(s) back";
}
rule TackDate2Rule(p: Person, old_asset: Asset, a: Asset, d: Date) defeasible {
    label en official "section 1223: the acquisition date of the property 2 link(s) back is included";
    when tack_link_1223(p, old_asset, a);
    when tack_date_1(p, old_asset, d);
    then tack_date_2(p, a, d);
}
pub relation tack_date_3(p: Person, a: Asset, d: Date) kind institutional {
    label en unofficial "section 1223: the acquisition date carried 3 link(s) back";
}
rule TackDate3Rule(p: Person, old_asset: Asset, a: Asset, d: Date) defeasible {
    label en official "section 1223: the acquisition date of the property 3 link(s) back is included";
    when tack_link_1223(p, old_asset, a);
    when tack_date_2(p, old_asset, d);
    then tack_date_3(p, a, d);
}
pub relation tack_date_4(p: Person, a: Asset, d: Date) kind institutional {
    label en unofficial "section 1223: the acquisition date carried 4 link(s) back";
}
rule TackDate4Rule(p: Person, old_asset: Asset, a: Asset, d: Date) defeasible {
    label en official "section 1223: the acquisition date of the property 4 link(s) back is included";
    when tack_link_1223(p, old_asset, a);
    when tack_date_3(p, old_asset, d);
    then tack_date_4(p, a, d);
}
pub relation tack_date_5(p: Person, a: Asset, d: Date) kind institutional {
    label en unofficial "section 1223: the acquisition date carried 5 link(s) back";
}
rule TackDate5Rule(p: Person, old_asset: Asset, a: Asset, d: Date) defeasible {
    label en official "section 1223: the acquisition date of the property 5 link(s) back is included";
    when tack_link_1223(p, old_asset, a);
    when tack_date_4(p, old_asset, d);
    then tack_date_5(p, a, d);
}
pub relation tacked_acquisition_date_1223(p: Person, a: Asset, d: Date) kind institutional {
    label en official "section 1223: an acquisition date that starts the holding period of the asset (own or carried by tacking, up to five links)";
}
rule TackedDateUnion0Rule(p: Person, a: Asset, d: Date) defeasible {
    label en official "section 1223: the slot 0 date starts a holding period";
    when tack_date_0(p, a, d);
    then tacked_acquisition_date_1223(p, a, d);
}
rule TackedDateUnion1Rule(p: Person, a: Asset, d: Date) defeasible {
    label en official "section 1223: the slot 1 date starts a holding period";
    when tack_date_1(p, a, d);
    then tacked_acquisition_date_1223(p, a, d);
}
rule TackedDateUnion2Rule(p: Person, a: Asset, d: Date) defeasible {
    label en official "section 1223: the slot 2 date starts a holding period";
    when tack_date_2(p, a, d);
    then tacked_acquisition_date_1223(p, a, d);
}
rule TackedDateUnion3Rule(p: Person, a: Asset, d: Date) defeasible {
    label en official "section 1223: the slot 3 date starts a holding period";
    when tack_date_3(p, a, d);
    then tacked_acquisition_date_1223(p, a, d);
}
rule TackedDateUnion4Rule(p: Person, a: Asset, d: Date) defeasible {
    label en official "section 1223: the slot 4 date starts a holding period";
    when tack_date_4(p, a, d);
    then tacked_acquisition_date_1223(p, a, d);
}
rule TackedDateUnion5Rule(p: Person, a: Asset, d: Date) defeasible {
    label en official "section 1223: the slot 5 date starts a holding period";
    when tack_date_5(p, a, d);
    then tacked_acquisition_date_1223(p, a, d);
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "In determining the period for which the taxpayer has held property received in an exchange, there shall be included the period for which he held the property exchanged")
rule LongTermViaTackedDateRule(p: Person, a: Asset, t: Transaction, d: Date, disposed: Date) defeasible {
    label en official "section 1223: the holding period exceeds 1 year when any carried acquisition date is more than a year before the disposition";
    when tacked_acquisition_date_1223(p, a, d);
    when disposed_on(p, a, t, disposed);
    when disposed > add_calendar_period(d, 1 calendar_year);
    then long_term(p, a);
}

// (5): rights exercise - the holding period begins on the exercise date only
pub relation stock_acquired_by_exercise_of_rights_on(p: Person, stock: Asset, exercised_on: Date) kind empirical {
    label en official "section 1223(5): stock or securities acquired from a corporation by the exercise of rights to acquire such stock or securities";
}
pub relation holding_period_begins_1223_5(p: Person, stock: Asset, start: Date) kind institutional {
    label en official "section 1223(5): only the period beginning with the date the right to acquire was exercised is included";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "there shall be included only the period beginning with the date on which the right to acquire was exercised")
rule HoldingPeriodBeginsOnExerciseRule(p: Person, stock: Asset, on: Date) defeasible {
    label en official "section 1223(5): the holding period of stock acquired by exercising rights begins on the exercise date";
    when stock_acquired_by_exercise_of_rights_on(p, stock, on);
    then holding_period_begins_1223_5(p, stock, on);
}

// (10): property transferred under section 1040 and sold to a qualified heir within a year of death
pub relation property_acquired_in_1040_transfer(p: Person, a: Asset) kind empirical {
    label en official "section 1223(10)(A): the property is acquired by any person in a transfer to which section 1040 applies";
}
pub relation disposed_to_qualified_heir_2032A_e1(p: Person, a: Asset, decedent: Person) kind empirical {
    label en official "section 1223(10)(C): the sale or disposition is to a qualified heir (as defined in section 2032A(e)(1)) with respect to the decedent";
}
@source(IRC_S1223, relation = formalizes, coverage = exact, quote = "then the person making such sale or other disposition shall be considered to have held such property for more than 1 year")
rule OneYearHeldUnder1040Rule(p: Person, a: Asset, decedent: Person, death_date: Date, sold_on: Date, t: Transaction) defeasible {
    label en official "section 1223(10): section 1040 property sold to a qualified heir within 1 year of death is deemed held for more than 1 year";
    when property_acquired_in_1040_transfer(p, a);
    when decedent_died_on(decedent, death_date);
    when disposed_on(p, a, t, sold_on);
    when sold_on <= add_calendar_period(death_date, 1 calendar_year);
    when disposed_to_qualified_heir_2032A_e1(p, a, decedent);
    then long_term(p, a);
}
