// Sections 1239, 1244, 1256, 1259 scenarios (stage 2). NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

// --- Section 1239 --------------------------------------------------------

test "S1239-01-SALE-TO-CONTROLLED-CORPORATION-ORDINARY-INCOME" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": sale_or_disposition(entity_ref("urn:test:s1239:c1#t"), entity_ref("urn:test:s1239:c1#p"), entity_ref("urn:test:s1239:c1#a"), @2024-06-01) { origin case_input; }
        assert "f1": sale_or_exchange_to(entity_ref("urn:test:s1239:c1#t"), entity_ref("urn:test:s1239:c1#p"), entity_ref("urn:test:s1239:c1#corp")) { origin case_input; }
        assert "f2": us.irc.corporations::constructive_ownership(entity_ref("urn:test:s1239:c1#p"), entity_ref("urn:test:s1239:c1#corp"), 0.75, us.irc.corporations::Actual) { origin case_input; }
        assert "f3": depreciable_in_hands_of_transferee(entity_ref("urn:test:s1239:c1#corp"), entity_ref("urn:test:s1239:c1#a")) { origin case_input; }
        assert "f4": gain_recognized(entity_ref("urn:test:s1239:c1#p"), entity_ref("urn:test:s1239:c1#t"), 40000.00 USD) { origin case_input; }
    }
    // 75% ownership of the corporate transferee exceeds the 50% threshold: related persons, gain is ordinary income.
    evaluate truth(section_1239_ordinary_income(entity_ref("urn:test:s1239:c1#p"), entity_ref("urn:test:s1239:c1#t"), 40000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1239-02-SALE-TO-40-PERCENT-OWNED-CORPORATION-NOT-RELATED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": sale_or_disposition(entity_ref("urn:test:s1239:c2#t"), entity_ref("urn:test:s1239:c2#p"), entity_ref("urn:test:s1239:c2#a"), @2024-06-01) { origin case_input; }
        assert "f1": sale_or_exchange_to(entity_ref("urn:test:s1239:c2#t"), entity_ref("urn:test:s1239:c2#p"), entity_ref("urn:test:s1239:c2#corp")) { origin case_input; }
        assert "f2": us.irc.corporations::constructive_ownership(entity_ref("urn:test:s1239:c2#p"), entity_ref("urn:test:s1239:c2#corp"), 0.40, us.irc.corporations::Actual) { origin case_input; }
        assert "f3": depreciable_in_hands_of_transferee(entity_ref("urn:test:s1239:c2#corp"), entity_ref("urn:test:s1239:c2#a")) { origin case_input; }
        assert "f4": gain_recognized(entity_ref("urn:test:s1239:c2#p"), entity_ref("urn:test:s1239:c2#t"), 40000.00 USD) { origin case_input; }
    }
    // 40% ownership does not exceed the more-than-50% threshold: not a controlled entity, nothing establishes relatedness.
    evaluate truth(section_1239_ordinary_income(entity_ref("urn:test:s1239:c2#p"), entity_ref("urn:test:s1239:c2#t"), 40000.00 USD));
    expect truth_status == NEITHER;
}

test "S1239-03-PECUNIARY-BEQUEST-EXCEPTION-BLOCKS-ORDINARY-INCOME" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": sale_or_disposition(entity_ref("urn:test:s1239:c3#t"), entity_ref("urn:test:s1239:c3#executor"), entity_ref("urn:test:s1239:c3#a"), @2024-06-01) { origin case_input; }
        assert "f1": sale_or_exchange_to(entity_ref("urn:test:s1239:c3#t"), entity_ref("urn:test:s1239:c3#executor"), entity_ref("urn:test:s1239:c3#beneficiary")) { origin case_input; }
        assert "f2": executor_of(entity_ref("urn:test:s1239:c3#executor"), entity_ref("urn:test:s1239:c3#estate")) { origin case_input; }
        assert "f3": estate_beneficiary_1239(entity_ref("urn:test:s1239:c3#beneficiary"), entity_ref("urn:test:s1239:c3#estate")) { origin case_input; }
        assert "f4": depreciable_in_hands_of_transferee(entity_ref("urn:test:s1239:c3#beneficiary"), entity_ref("urn:test:s1239:c3#a")) { origin case_input; }
        assert "f5": gain_recognized(entity_ref("urn:test:s1239:c3#executor"), entity_ref("urn:test:s1239:c3#t"), 40000.00 USD) { origin case_input; }
        assert "f6": sale_in_satisfaction_of_pecuniary_bequest(entity_ref("urn:test:s1239:c3#t")) { origin case_input; }
    }
    evaluate truth(section_1239_ordinary_income(entity_ref("urn:test:s1239:c3#executor"), entity_ref("urn:test:s1239:c3#t"), 40000.00 USD));
    expect truth_status == NEITHER;
}

// --- Section 1244 ---------------------------------------------------------

test "S1244-01-LOSS-WITHIN-50000-LIMIT-ORDINARY" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": domestic_corporation(entity_ref("urn:test:s1244:l1#corp")) { origin case_input; }
        assert "f1": aggregate_capital_received_1244(entity_ref("urn:test:s1244:l1#corp"), @2020-01-01, 800000.00 USD) { origin case_input; }
        assert "f2": issued_for_money_or_property_other_than_stock_and_securities(entity_ref("urn:test:s1244:l1#a"), entity_ref("urn:test:s1244:l1#corp")) { origin case_input; }
        assert "f3": gross_receipts_test_met_1244(entity_ref("urn:test:s1244:l1#corp"), @2024-06-01) { origin case_input; }
        assert "f4": loss_recognized(entity_ref("urn:test:s1244:l1#p"), entity_ref("urn:test:s1244:l1#t"), 30000.00 USD) { origin case_input; }
        assert "f5": us.irc.core::year_of(entity_ref("urn:test:s1244:l1#p"), entity_ref("urn:test:s1244:l1#y")) { origin case_input; }
    }
    evaluate truth(section_1244_ordinary_loss(entity_ref("urn:test:s1244:l1#p"), entity_ref("urn:test:s1244:l1#t"), 30000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

