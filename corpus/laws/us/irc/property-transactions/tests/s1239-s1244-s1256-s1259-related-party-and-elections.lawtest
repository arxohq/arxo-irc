    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": held_at_close_of_year(entity_ref("urn:test:s1256:m2#p"), entity_ref("urn:test:s1256:m2#c"), entity_ref("urn:test:s1256:m2#y")) { origin case_input; }
        assert "f1": fair_market_value_at_year_end(entity_ref("urn:test:s1256:m2#p"), entity_ref("urn:test:s1256:m2#c"), entity_ref("urn:test:s1256:m2#y"), 10000.00 USD) { origin case_input; }
        assert "f2": basis_at_year_end(entity_ref("urn:test:s1256:m2#p"), entity_ref("urn:test:s1256:m2#c"), entity_ref("urn:test:s1256:m2#y"), 4000.00 USD) { origin case_input; }
        assert "f3": identified_as_hedging_transaction(entity_ref("urn:test:s1256:m2#p"), entity_ref("urn:test:s1256:m2#c")) { origin case_input; }
    }
    evaluate truth(section_1256_mark_to_market_gain(entity_ref("urn:test:s1256:m2#p"), entity_ref("urn:test:s1256:m2#y"), entity_ref("urn:test:s1256:m2#c"), 6000.00 USD));
    expect truth_status == NEITHER;
}

test "S1256-03-MIXED-STRADDLE-ELECTION-VALID" {
    given {
        context { legal_time @2024-01-15; decision_time @2024-01-15T09:00:00-05:00; knowledge_time @2024-01-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": elects_mixed_straddle_out_of_1256(entity_ref("urn:test:s1256:e1#p"), entity_ref("urn:test:s1256:e1#y")) { origin case_input; }
        assert "f1": mixed_straddle_election_timely_and_properly_made(entity_ref("urn:test:s1256:e1#p"), entity_ref("urn:test:s1256:e1#y")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1256MixedStraddleElection, VALIDLY_EXERCISED);
    evaluate truth(section_1256_mixed_straddle_election_in_effect(entity_ref("urn:test:s1256:e1#p"), entity_ref("urn:test:s1256:e1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// --- Section 1259 -----------------------------------------------------------

test "S1259-01-SHORT-SALE-AGAINST-THE-BOX-CONSTRUCTIVE-SALE" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": enters_short_sale_of_same_or_substantially_identical(entity_ref("urn:test:s1259:s1#p"), entity_ref("urn:test:s1259:s1#pos"), entity_ref("urn:test:s1259:s1#t"), @2024-06-01) { origin case_input; }
        assert "f1": would_produce_gain_at_fmv(entity_ref("urn:test:s1259:s1#p"), entity_ref("urn:test:s1259:s1#pos"), 25000.00 USD) { origin case_input; }
    }
    evaluate truth(constructive_sale_of_appreciated_financial_position(entity_ref("urn:test:s1259:s1#p"), entity_ref("urn:test:s1259:s1#pos"), entity_ref("urn:test:s1259:s1#t"), @2024-06-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_1259_gain_recognized(entity_ref("urn:test:s1259:s1#p"), entity_ref("urn:test:s1259:s1#pos"), entity_ref("urn:test:s1259:s1#t"), 25000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1259-02-CLOSED-WITHIN-30-DAYS-AND-HELD-60-DAYS-EXCEPTION-APPLIES" {
    given {
        context { legal_time @2025-01-25; decision_time @2025-01-25T09:00:00-05:00; knowledge_time @2025-01-25T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": enters_short_sale_of_same_or_substantially_identical(entity_ref("urn:test:s1259:s2#p"), entity_ref("urn:test:s1259:s2#pos"), entity_ref("urn:test:s1259:s2#t"), @2024-12-01) { origin case_input; }
        assert "f1": would_produce_gain_at_fmv(entity_ref("urn:test:s1259:s2#p"), entity_ref("urn:test:s1259:s2#pos"), 25000.00 USD) { origin case_input; }
        assert "f2": us.irc.core::year_of(entity_ref("urn:test:s1259:s2#p"), entity_ref("urn:test:s1259:s2#y")) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:s1259:s2#y"), @2024-12-31) { origin case_input; }
        assert "f4": transaction_closed_on(entity_ref("urn:test:s1259:s2#t"), @2025-01-25) { origin case_input; }
        assert "f5": held_throughout_60_day_period_from_close(entity_ref("urn:test:s1259:s2#p"), entity_ref("urn:test:s1259:s2#pos"), @2025-01-25) { origin case_input; }
        assert "f6": risk_of_loss_not_diminished_during_60_days(entity_ref("urn:test:s1259:s2#p"), entity_ref("urn:test:s1259:s2#pos"), @2025-01-25) { origin case_input; }
    }
    // closed 25 days after the 2024-12-31 taxable-year close, within the 30-day window: (c)(3)(A) disregards the transaction.
    evaluate truth(constructive_sale_of_appreciated_financial_position(entity_ref("urn:test:s1259:s2#p"), entity_ref("urn:test:s1259:s2#pos"), entity_ref("urn:test:s1259:s2#t"), @2024-12-01));
    expect truth_status == NEITHER;
}
