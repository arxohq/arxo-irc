    }
    evaluate truth(small_business_corporation_1244(entity_ref("urn:test:s1244:l3#corp"), @2020-01-01));
    expect truth_status == NEITHER;
}

// --- Section 1256 ----------------------------------------------------------

test "S1256-01-MARK-TO-MARKET-GAIN-60-40-SPLIT" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": held_at_close_of_year(entity_ref("urn:test:s1256:m1#p"), entity_ref("urn:test:s1256:m1#c"), entity_ref("urn:test:s1256:m1#y")) { origin case_input; }
        assert "f1": fair_market_value_at_year_end(entity_ref("urn:test:s1256:m1#p"), entity_ref("urn:test:s1256:m1#c"), entity_ref("urn:test:s1256:m1#y"), 10000.00 USD) { origin case_input; }
        assert "f2": basis_at_year_end(entity_ref("urn:test:s1256:m1#p"), entity_ref("urn:test:s1256:m1#c"), entity_ref("urn:test:s1256:m1#y"), 4000.00 USD) { origin case_input; }
    }
    // gain = 6000; 40% short-term = 2400, 60% long-term = 3600.
    evaluate truth(section_1256_mark_to_market_gain(entity_ref("urn:test:s1256:m1#p"), entity_ref("urn:test:s1256:m1#y"), entity_ref("urn:test:s1256:m1#c"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_1256_short_term_character(entity_ref("urn:test:s1256:m1#p"), entity_ref("urn:test:s1256:m1#y"), entity_ref("urn:test:s1256:m1#c"), 2400.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_1256_long_term_character(entity_ref("urn:test:s1256:m1#p"), entity_ref("urn:test:s1256:m1#y"), entity_ref("urn:test:s1256:m1#c"), 3600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

