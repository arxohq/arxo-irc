// Section 1092(b)(2) + (a)(2)(D) regulation readers (IRC-G/G4, CFR wiring
// 27.09.2026). Each rule gets a вывод / нет-факта-источника pair: with the
// case-selected regulation fact the statutory consequence derives
// (TRUE_ONLY); without it nothing derives (NEITHER, not a proven negative).
// Expectations come from the statutory text, not from engine output.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1092-CFR-01-CHAPEAU-WITH-METHOD-DERIVES" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": mixed_straddle_offset_method_prescribed_1092b2(entity_ref("urn:test:s1092cfr:1#p"), 1, StraddleByStraddle) { origin case_input; }
    }
    evaluate truth(offsetting_provided_by_regulation_1092b2(entity_ref("urn:test:s1092cfr:1#p"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S1092-CFR-02-CHAPEAU-WITHOUT-METHOD-NEITHER" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
    }
    // no prescribed method asserted — the regulation leg is absent.
    evaluate truth(offsetting_provided_by_regulation_1092b2(entity_ref("urn:test:s1092cfr:2#p"), 1));
    expect truth_status == NEITHER;
}

