test "S1277B1C-01-NET-INTEREST-INCOME-IS-INCLUDED-OVER-PAID" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": interest_paid_on_carrying_debt_1277c1(entity_ref("urn:test:s38:1#b"), entity_ref("urn:test:s38:1#p"), entity_ref("urn:test:s38:1#y"), 1000.00 USD) { origin case_input; }
        assert "f1": interest_included_in_gross_income_1277c2(entity_ref("urn:test:s38:1#b"), entity_ref("urn:test:s38:1#p"), entity_ref("urn:test:s38:1#y"), 3000.00 USD) { origin case_input; }
        assert "f2": disallowed_interest_balance_1277b(entity_ref("urn:test:s38:1#b"), entity_ref("urn:test:s38:1#p"), entity_ref("urn:test:s38:1#y"), 1500.00 USD) { origin case_input; }
        assert "f3": elects_deferral_against_net_interest_income_1277b1(entity_ref("urn:test:s38:1#b"), entity_ref("urn:test:s38:1#p")) { origin case_input; }
    }
    evaluate truth(net_interest_income_1277b1c(entity_ref("urn:test:s38:1#b"), entity_ref("urn:test:s38:1#p"), entity_ref("urn:test:s38:1#y"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

