// Property-transactions WIRE-10 group B scenarios (definitions contracts). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "W10B-PT-07-CORPORATION-TAXPAYER-FROM-DEFINITIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.definitions::corporation(entity_ref("urn:test:w10b:d1#p")) { origin case_input; }
    }
    evaluate truth(corporation_taxpayer(entity_ref("urn:test:w10b:d1#p")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PT-08-CORPORATION-TAXPAYER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": corporation_taxpayer(entity_ref("urn:test:w10b:d2#p")) { origin case_input; }
    }
    evaluate truth(corporation_taxpayer(entity_ref("urn:test:w10b:d2#p")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PT-09-MARRIED-FILING-SEPARATE-FROM-DEFINITIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.definitions::married_for_this_title(entity_ref("urn:test:w10b:d3#p"), entity_ref("urn:test:w10b:d3#y")) { origin case_input; }
        assert "f1": us.irc.definitions::files_separate_return(entity_ref("urn:test:w10b:d3#p"), entity_ref("urn:test:w10b:d3#y")) { origin case_input; }
    }
    evaluate truth(married_filing_separate_return_1202(entity_ref("urn:test:w10b:d3#p"), entity_ref("urn:test:w10b:d3#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PT-10-MARRIED-WITHOUT-A-SEPARATE-RETURN-IS-NOT-DERIVED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.definitions::married_for_this_title(entity_ref("urn:test:w10b:d4#p"), entity_ref("urn:test:w10b:d4#y")) { origin case_input; }
    }
    evaluate truth(married_filing_separate_return_1202(entity_ref("urn:test:w10b:d4#p"), entity_ref("urn:test:w10b:d4#y")));
    expect truth_status == NEITHER;
}

test "W10B-PT-11-JOINT-RETURN-FILED-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": joint_return_filed_1244(entity_ref("urn:test:w10b:d5#p"), entity_ref("urn:test:w10b:d5#y")) { origin case_input; }
    }
    evaluate truth(joint_return_filed_1244(entity_ref("urn:test:w10b:d5#p"), entity_ref("urn:test:w10b:d5#y")));
    expect truth_status == TRUE_ONLY;
}
