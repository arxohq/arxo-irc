// Section 1400Z-2 scenarios (stage 2b, opportunity zones). NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1400Z2-01-DEFERRAL-ELECTION-VALID-WITHIN-180-DAYS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": sale_or_exchange_with_unrelated_person(entity_ref("urn:test:s1400z2:e1#t"), entity_ref("urn:test:s1400z2:e1#p"), entity_ref("urn:test:s1400z2:e1#sold"), @2024-01-01) { origin case_input; }
        assert "f1": invests_in_qualified_opportunity_fund(entity_ref("urn:test:s1400z2:e1#p"), entity_ref("urn:test:s1400z2:e1#t"), entity_ref("urn:test:s1400z2:e1#fund"), @2024-05-01, 40000.00 USD) { origin case_input; }
        assert "f2": elects_section_1400z2_deferral(entity_ref("urn:test:s1400z2:e1#p"), entity_ref("urn:test:s1400z2:e1#t")) { origin case_input; }
        assert "f3": gain_recognized(entity_ref("urn:test:s1400z2:e1#p"), entity_ref("urn:test:s1400z2:e1#t"), 50000.00 USD) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1400z2DeferralElection, VALIDLY_EXERCISED);
    evaluate truth(gain_excluded_under_1400z2a1a(entity_ref("urn:test:s1400z2:e1#p"), entity_ref("urn:test:s1400z2:e1#t"), 40000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1400Z2-02-DEFERRAL-ELECTION-INVALID-INVESTMENT-AFTER-180-DAYS" {
    given {
        context { legal_time @2024-08-01; decision_time @2024-08-01T09:00:00-05:00; knowledge_time @2024-08-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": sale_or_exchange_with_unrelated_person(entity_ref("urn:test:s1400z2:e2#t"), entity_ref("urn:test:s1400z2:e2#p"), entity_ref("urn:test:s1400z2:e2#sold"), @2024-01-01) { origin case_input; }
        assert "f1": invests_in_qualified_opportunity_fund(entity_ref("urn:test:s1400z2:e2#p"), entity_ref("urn:test:s1400z2:e2#t"), entity_ref("urn:test:s1400z2:e2#fund"), @2024-08-01, 40000.00 USD) { origin case_input; }
        assert "f2": elects_section_1400z2_deferral(entity_ref("urn:test:s1400z2:e2#p"), entity_ref("urn:test:s1400z2:e2#t")) { origin case_input; }
        assert "f3": gain_recognized(entity_ref("urn:test:s1400z2:e2#p"), entity_ref("urn:test:s1400z2:e2#t"), 50000.00 USD) { origin case_input; }
    }
    // invested 213 days after the sale, outside the 180-day window.
    evaluate positions();
    expect position(Section1400z2DeferralElection, INVALIDLY_EXERCISED);
}

test "S1400Z2-03-BASIS-STEP-UP-AT-5-YEARS" {
    given {
        context { legal_time @2029-06-01; decision_time @2029-06-01T09:00:00-05:00; knowledge_time @2029-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": investment_acquired_on(entity_ref("urn:test:s1400z2:s1#fund"), entity_ref("urn:test:s1400z2:s1#p"), @2024-01-01) { origin case_input; }
        assert "f1": holding_period_measured_as_of(entity_ref("urn:test:s1400z2:s1#fund"), entity_ref("urn:test:s1400z2:s1#p"), @2029-06-01) { origin case_input; }
        assert "f2": deferred_gain_amount(entity_ref("urn:test:s1400z2:s1#p"), entity_ref("urn:test:s1400z2:s1#fund"), 40000.00 USD) { origin case_input; }
    }
    // 5 years and 5 months held: 5-year test met, 7-year test not.
    evaluate truth(held_at_least_5_years(entity_ref("urn:test:s1400z2:s1#fund"), entity_ref("urn:test:s1400z2:s1#p"), @2029-06-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(basis_step_up_5_year(entity_ref("urn:test:s1400z2:s1#p"), entity_ref("urn:test:s1400z2:s1#fund"), 40000.00 USD, 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(held_at_least_7_years(entity_ref("urn:test:s1400z2:s1#fund"), entity_ref("urn:test:s1400z2:s1#p"), @2029-06-01));
    expect truth_status == NEITHER;
}

test "S1400Z2-04-BASIS-STEP-UP-AT-7-YEARS" {
    given {
        context { legal_time @2031-06-01; decision_time @2031-06-01T09:00:00-05:00; knowledge_time @2031-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": investment_acquired_on(entity_ref("urn:test:s1400z2:s2#fund"), entity_ref("urn:test:s1400z2:s2#p"), @2024-01-01) { origin case_input; }
        assert "f1": holding_period_measured_as_of(entity_ref("urn:test:s1400z2:s2#fund"), entity_ref("urn:test:s1400z2:s2#p"), @2031-06-01) { origin case_input; }
        assert "f2": deferred_gain_amount(entity_ref("urn:test:s1400z2:s2#p"), entity_ref("urn:test:s1400z2:s2#fund"), 40000.00 USD) { origin case_input; }
    }
    evaluate truth(basis_step_up_7_year(entity_ref("urn:test:s1400z2:s2#p"), entity_ref("urn:test:s1400z2:s2#fund"), 40000.00 USD, 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1400Z2-05-TEN-YEAR-ELECTION-FMV-BASIS-ON-SALE" {
    given {
        context { legal_time @2034-06-01; decision_time @2034-06-01T09:00:00-05:00; knowledge_time @2034-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": investment_acquired_on(entity_ref("urn:test:s1400z2:t1#fund"), entity_ref("urn:test:s1400z2:t1#p"), @2024-01-01) { origin case_input; }
        assert "f1": investment_sold_or_exchanged_on(entity_ref("urn:test:s1400z2:t1#fund"), @2034-06-01) { origin case_input; }
        assert "f2": elects_10_year_fmv_basis(entity_ref("urn:test:s1400z2:t1#p"), entity_ref("urn:test:s1400z2:t1#fund"), @2034-06-01) { origin case_input; }
        assert "f3": fair_market_value_of_investment_on(entity_ref("urn:test:s1400z2:t1#fund"), @2034-06-01, 120000.00 USD) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1400z2TenYearFmvElection, VALIDLY_EXERCISED);
    evaluate truth(basis_equals_fmv_on_sale_1400z2c(entity_ref("urn:test:s1400z2:t1#p"), entity_ref("urn:test:s1400z2:t1#fund"), @2034-06-01, 120000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
