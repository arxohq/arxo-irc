// Sections 1276-1278 scenarios (stage 2b, market discount). NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1278-01-MARKET-DISCOUNT-IS-EXCESS-OF-SRPM-OVER-BASIS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s1278:m1#bond"), 100000.00 USD) { origin case_input; }
        assert "f1": market_discount_basis_after_acquisition(entity_ref("urn:test:s1278:m1#bond"), 90000.00 USD) { origin case_input; }
    }
    evaluate truth(market_discount(entity_ref("urn:test:s1278:m1#bond"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1278-02-DE-MINIMIS-MARKET-DISCOUNT-TREATED-AS-ZERO" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s1278:m2#bond"), 100000.00 USD) { origin case_input; }
        assert "f1": market_discount_basis_after_acquisition(entity_ref("urn:test:s1278:m2#bond"), 99900.00 USD) { origin case_input; }
        assert "f2": complete_years_to_maturity_after_acquisition(entity_ref("urn:test:s1278:m2#bond"), 5) { origin case_input; }
    }
    evaluate truth(market_discount_treated_as_zero(entity_ref("urn:test:s1278:m2#bond")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1278-03-BOND-WITH-MARKET-DISCOUNT-IS-MARKET-DISCOUNT-BOND" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s1278:m3#bond"), 100000.00 USD) { origin case_input; }
        assert "f1": market_discount_basis_after_acquisition(entity_ref("urn:test:s1278:m3#bond"), 90000.00 USD) { origin case_input; }
        assert "f2": bond_held_by(entity_ref("urn:test:s1278:m3#bond"), entity_ref("urn:test:s1278:m3#p")) { origin case_input; }
    }
    evaluate truth(market_discount_bond(entity_ref("urn:test:s1278:m3#bond"), entity_ref("urn:test:s1278:m3#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1278-04-ORIGINAL-ISSUE-ACQUISITION-NOT-A-MARKET-DISCOUNT-BOND" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s1278:m4#bond"), 100000.00 USD) { origin case_input; }
        assert "f1": market_discount_basis_after_acquisition(entity_ref("urn:test:s1278:m4#bond"), 90000.00 USD) { origin case_input; }
        assert "f2": bond_held_by(entity_ref("urn:test:s1278:m4#bond"), entity_ref("urn:test:s1278:m4#p")) { origin case_input; }
        assert "f3": acquired_at_original_issue(entity_ref("urn:test:s1278:m4#bond"), entity_ref("urn:test:s1278:m4#p")) { origin case_input; }
    }
    evaluate truth(market_discount_bond(entity_ref("urn:test:s1278:m4#bond"), entity_ref("urn:test:s1278:m4#p")));
    expect truth_status == NEITHER;
}

test "S1276-01-RATABLE-ACCRUAL-HALF-OF-DAYS-HELD" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s1276:r1#bond"), 100000.00 USD) { origin case_input; }
        assert "f1": market_discount_basis_after_acquisition(entity_ref("urn:test:s1276:r1#bond"), 90000.00 USD) { origin case_input; }
        assert "f2": bond_held_by(entity_ref("urn:test:s1276:r1#bond"), entity_ref("urn:test:s1276:r1#p")) { origin case_input; }
        assert "f3": days_held_by_taxpayer(entity_ref("urn:test:s1276:r1#bond"), 500) { origin case_input; }
        assert "f4": days_from_acquisition_to_maturity(entity_ref("urn:test:s1276:r1#bond"), 1000) { origin case_input; }
    }
    // market discount 10,000 * (500/1000) = 5,000.
    evaluate truth(accrued_market_discount(entity_ref("urn:test:s1276:r1#bond"), entity_ref("urn:test:s1276:r1#p"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1276-02-CONSTANT-INTEREST-RATE-ELECTION-SUPPRESSES-RATABLE-ACCRUAL" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s1276:r2#bond"), 100000.00 USD) { origin case_input; }
        assert "f1": market_discount_basis_after_acquisition(entity_ref("urn:test:s1276:r2#bond"), 90000.00 USD) { origin case_input; }
        assert "f2": bond_held_by(entity_ref("urn:test:s1276:r2#bond"), entity_ref("urn:test:s1276:r2#p")) { origin case_input; }
        assert "f3": days_held_by_taxpayer(entity_ref("urn:test:s1276:r2#bond"), 500) { origin case_input; }
        assert "f4": days_from_acquisition_to_maturity(entity_ref("urn:test:s1276:r2#bond"), 1000) { origin case_input; }
        assert "f5": elects_constant_interest_rate_accrual(entity_ref("urn:test:s1276:r2#bond"), entity_ref("urn:test:s1276:r2#p")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1276ConstantInterestRateElection, VALIDLY_EXERCISED);
    evaluate truth(accrued_market_discount(entity_ref("urn:test:s1276:r2#bond"), entity_ref("urn:test:s1276:r2#p"), 5000.00 USD));
    expect truth_status == NEITHER;
}

test "S1276-03-GAIN-WITHIN-ACCRUED-DISCOUNT-IS-ORDINARY-INCOME" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": disposes_of_market_discount_bond(entity_ref("urn:test:s1276:o1#t"), entity_ref("urn:test:s1276:o1#p"), entity_ref("urn:test:s1276:o1#bond"), @2024-06-01) { origin case_input; }
        assert "f1": gain_recognized(entity_ref("urn:test:s1276:o1#p"), entity_ref("urn:test:s1276:o1#t"), 3000.00 USD) { origin case_input; }
        assert "f2": accrued_market_discount(entity_ref("urn:test:s1276:o1#bond"), entity_ref("urn:test:s1276:o1#p"), 5000.00 USD) { origin case_input; }
    }
    evaluate truth(section_1276_ordinary_income(entity_ref("urn:test:s1276:o1#t"), entity_ref("urn:test:s1276:o1#p"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1277-01-INTEREST-EXPENSE-DISALLOWED-WITHIN-ALLOCABLE-DISCOUNT" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": net_direct_interest_expense(entity_ref("urn:test:s1277:i1#bond"), entity_ref("urn:test:s1277:i1#p"), entity_ref("urn:test:s1277:i1#y"), 2000.00 USD) { origin case_input; }
        assert "f1": market_discount_allocable_to_year(entity_ref("urn:test:s1277:i1#bond"), entity_ref("urn:test:s1277:i1#p"), entity_ref("urn:test:s1277:i1#y"), 2500.00 USD) { origin case_input; }
    }
    evaluate truth(net_direct_interest_expense_deduction_disallowed(entity_ref("urn:test:s1277:i1#bond"), entity_ref("urn:test:s1277:i1#p"), entity_ref("urn:test:s1277:i1#y"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
