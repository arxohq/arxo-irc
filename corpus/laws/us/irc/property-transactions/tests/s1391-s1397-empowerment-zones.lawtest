    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1397D-01-QUALIFIED-ZONE-PROPERTY" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": property_subject_to_depreciation_168_or_179(entity_ref("urn:test:s1391:74#a")) { origin case_input; }
        assert "f1": zone_property_acquired_by_purchase_after_designation(entity_ref("urn:test:s1391:74#a")) { origin case_input; }
        assert "f2": zone_property_original_use_with_taxpayer(entity_ref("urn:test:s1391:74#a")) { origin case_input; }
        assert "f3": zone_property_substantially_all_used_in_active_qualified_business(entity_ref("urn:test:s1391:74#a")) { origin case_input; }
    }
    evaluate truth(qualified_zone_property(entity_ref("urn:test:s1391:74#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1397D-02-USED-PROPERTY-NOT-QUALIFIED-ZONE-PROPERTY" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": property_subject_to_depreciation_168_or_179(entity_ref("urn:test:s1391:75#a")) { origin case_input; }
        assert "f1": zone_property_acquired_by_purchase_after_designation(entity_ref("urn:test:s1391:75#a")) { origin case_input; }
        assert "f2": zone_property_substantially_all_used_in_active_qualified_business(entity_ref("urn:test:s1391:75#a")) { origin case_input; }
    }
    evaluate truth(qualified_zone_property(entity_ref("urn:test:s1391:75#a")));
    expect truth_status == NEITHER;
}

