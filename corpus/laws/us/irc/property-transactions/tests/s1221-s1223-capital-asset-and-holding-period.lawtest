// Sections 1221, 1222, 1223 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1221-01-INVESTMENT-PROPERTY-IS-CAPITAL-ASSET" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": held_by(entity_ref("urn:test:s1221:c1#p"), entity_ref("urn:test:s1221:c1#a")) { origin case_input; }
    }
    evaluate truth(capital_asset(entity_ref("urn:test:s1221:c1#p"), entity_ref("urn:test:s1221:c1#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1221-02-INVENTORY-IS-NOT-CAPITAL-ASSET" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": held_by(entity_ref("urn:test:s1221:c2#p"), entity_ref("urn:test:s1221:c2#a")) { origin case_input; }
        assert "f1": inventory_or_stock_in_trade(entity_ref("urn:test:s1221:c2#a")) { origin case_input; }
    }
    evaluate truth(capital_asset(entity_ref("urn:test:s1221:c2#p"), entity_ref("urn:test:s1221:c2#a")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1223-01-HOLDING-PERIOD-EXACTLY-ONE-YEAR-IS-SHORT-TERM" {
    given {
        context { legal_time @2025-01-02; decision_time @2025-01-02T09:00:00-05:00; knowledge_time @2025-01-02T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": acquired_on(entity_ref("urn:test:s1223:h1#p"), entity_ref("urn:test:s1223:h1#a"), @2024-01-02) { origin case_input; }
        assert "f1": disposed_on(entity_ref("urn:test:s1223:h1#p"), entity_ref("urn:test:s1223:h1#a"), entity_ref("urn:test:s1223:h1#t"), @2025-01-02) { origin case_input; }
    }
    // held exactly 1 year (not MORE than 1 year): short-term, long_term does not fire.
    evaluate truth(long_term(entity_ref("urn:test:s1223:h1#p"), entity_ref("urn:test:s1223:h1#a")));
    expect truth_status == NEITHER;
}

test "S1223-02-HOLDING-PERIOD-ONE-YEAR-PLUS-ONE-DAY-IS-LONG-TERM" {
    given {
        context { legal_time @2025-01-03; decision_time @2025-01-03T09:00:00-05:00; knowledge_time @2025-01-03T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": acquired_on(entity_ref("urn:test:s1223:h2#p"), entity_ref("urn:test:s1223:h2#a"), @2024-01-02) { origin case_input; }
        assert "f1": disposed_on(entity_ref("urn:test:s1223:h2#p"), entity_ref("urn:test:s1223:h2#a"), entity_ref("urn:test:s1223:h2#t"), @2025-01-03) { origin case_input; }
    }
    evaluate truth(long_term(entity_ref("urn:test:s1223:h2#p"), entity_ref("urn:test:s1223:h2#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1223-03-ONE-YEAR-AFTER-DEATH-DEEMED-LONG-TERM" {
    given {
        context { legal_time @2024-08-01; decision_time @2024-08-01T09:00:00-05:00; knowledge_time @2024-08-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": decedent_property_basis(entity_ref("urn:test:s1223:d1#p"), entity_ref("urn:test:s1223:d1#a"), 100000.00 USD) { origin case_input; }
        assert "f1": decedent_died_on(entity_ref("urn:test:s1223:d1#decedent"), @2024-02-01) { origin case_input; }
        assert "f2": disposed_on(entity_ref("urn:test:s1223:d1#p"), entity_ref("urn:test:s1223:d1#a"), entity_ref("urn:test:s1223:d1#t"), @2024-08-01) { origin case_input; }
    }
    // sold 6 months after death, well inside 1 year — deemed long-term even without an own holding period.
    evaluate truth(long_term(entity_ref("urn:test:s1223:d1#p"), entity_ref("urn:test:s1223:d1#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1223-04-ONE-HOP-TACKING-FROM-LIKE-KIND-EXCHANGE-LONG-TERM" {
    given {
        context { legal_time @2024-09-01; decision_time @2024-09-01T09:00:00-05:00; knowledge_time @2024-09-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": exchange_with_substituted_basis(entity_ref("urn:test:s1223:k1#p"), entity_ref("urn:test:s1223:k1#old"), entity_ref("urn:test:s1223:k1#new")) { origin case_input; }
        assert "f1": acquired_on(entity_ref("urn:test:s1223:k1#p"), entity_ref("urn:test:s1223:k1#old"), @2023-01-01) { origin case_input; }
        assert "f2": disposed_on(entity_ref("urn:test:s1223:k1#p"), entity_ref("urn:test:s1223:k1#new"), entity_ref("urn:test:s1223:k1#t"), @2024-09-01) { origin case_input; }
    }
    // new asset acquired 2024-06-01 (not asserted — the taxpayer's own holding period in the new asset alone is under a year), but the OLD asset's acquisition (2023-01-01) tacks under (1): more than a year before the 2024-09-01 disposition.
    evaluate truth(long_term(entity_ref("urn:test:s1223:k1#p"), entity_ref("urn:test:s1223:k1#new")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1223-05-TWO-HOP-TACKING-CHAIN-LONG-TERM" {
    given {
        context { legal_time @2024-09-01; decision_time @2024-09-01T09:00:00-05:00; knowledge_time @2024-09-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": exchange_with_substituted_basis(entity_ref("urn:test:s1223:k2#p"), entity_ref("urn:test:s1223:k2#oldest"), entity_ref("urn:test:s1223:k2#mid")) { origin case_input; }
        assert "f1": exchange_with_substituted_basis(entity_ref("urn:test:s1223:k2#p"), entity_ref("urn:test:s1223:k2#mid"), entity_ref("urn:test:s1223:k2#newest")) { origin case_input; }
        assert "f2": acquired_on(entity_ref("urn:test:s1223:k2#p"), entity_ref("urn:test:s1223:k2#oldest"), @2022-01-01) { origin case_input; }
        assert "f3": disposed_on(entity_ref("urn:test:s1223:k2#p"), entity_ref("urn:test:s1223:k2#newest"), entity_ref("urn:test:s1223:k2#t"), @2024-09-01) { origin case_input; }
    }
    // two chained substituted-basis exchanges: the newest asset tacks all the way back to the oldest asset's 2022 acquisition.
    evaluate truth(long_term(entity_ref("urn:test:s1223:k2#p"), entity_ref("urn:test:s1223:k2#newest")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1222-01-NET-CAPITAL-GAIN-FROM-LONG-TERM-GAIN-ONLY" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": long_term_capital_gain(entity_ref("urn:test:s1222:n1#p"), entity_ref("urn:test:s1222:n1#y"), 5000.00 USD) { origin case_input; }
        assert "f1": long_term_capital_loss(entity_ref("urn:test:s1222:n1#p"), entity_ref("urn:test:s1222:n1#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(net_capital_gain(entity_ref("urn:test:s1222:n1#p"), entity_ref("urn:test:s1222:n1#y"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
