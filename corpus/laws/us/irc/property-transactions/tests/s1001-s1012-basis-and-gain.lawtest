// Sections 1001, 1011, 1012 scenarios. NOT EXECUTED (implemented_unverified
// per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1001-01-GAIN-ON-SALE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sale_or_disposition(entity_ref("urn:test:s1001:g1#t"), entity_ref("urn:test:s1001:g1#p"), entity_ref("urn:test:s1001:g1#a"), @2024-06-01) { origin case_input; }
        assert "f1": money_received(entity_ref("urn:test:s1001:g1#t"), 10000.00 USD) { origin case_input; }
        assert "f2": fmv_of_property_received(entity_ref("urn:test:s1001:g1#t"), 0.00 USD) { origin case_input; }
        assert "f3": purchase_price(entity_ref("urn:test:s1001:g1#p"), entity_ref("urn:test:s1001:g1#a"), 6000.00 USD) { origin case_input; }
        assert "f4": basis_as_of(entity_ref("urn:test:s1001:g1#p"), entity_ref("urn:test:s1001:g1#a"), @2024-06-01) { origin case_input; }
    }
    // amount realized 10,000 - adjusted basis 6,000 = gain 4,000; no
    // nonrecognition exception asserted, so the whole gain is recognized.
    evaluate truth(gain_recognized(entity_ref("urn:test:s1001:g1#p"), entity_ref("urn:test:s1001:g1#t"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1001-02-LOSS-ON-SALE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sale_or_disposition(entity_ref("urn:test:s1001:l1#t"), entity_ref("urn:test:s1001:l1#p"), entity_ref("urn:test:s1001:l1#a"), @2024-06-01) { origin case_input; }
        assert "f1": money_received(entity_ref("urn:test:s1001:l1#t"), 4000.00 USD) { origin case_input; }
        assert "f2": fmv_of_property_received(entity_ref("urn:test:s1001:l1#t"), 0.00 USD) { origin case_input; }
        assert "f3": purchase_price(entity_ref("urn:test:s1001:l1#p"), entity_ref("urn:test:s1001:l1#a"), 6000.00 USD) { origin case_input; }
        assert "f4": basis_as_of(entity_ref("urn:test:s1001:l1#p"), entity_ref("urn:test:s1001:l1#a"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(loss_recognized(entity_ref("urn:test:s1001:l1#p"), entity_ref("urn:test:s1001:l1#t"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1012-01-COST-BASIS-DEFAULT" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": purchase_price(entity_ref("urn:test:s1012:c1#p"), entity_ref("urn:test:s1012:c1#a"), 50000.00 USD) { origin case_input; }
    }
    evaluate truth(cost_basis(entity_ref("urn:test:s1012:c1#p"), entity_ref("urn:test:s1012:c1#a"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1012-02-PROPERTY-TAX-EXCLUDED-FROM-COST" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": purchase_price(entity_ref("urn:test:s1012:c2#p"), entity_ref("urn:test:s1012:c2#a"), 50000.00 USD) { origin case_input; }
        assert "f1": real_property_tax_treated_as_imposed_on_taxpayer_at_purchase(entity_ref("urn:test:s1012:c2#p"), entity_ref("urn:test:s1012:c2#a"), 1000.00 USD) { origin case_input; }
    }
    evaluate truth(cost_basis(entity_ref("urn:test:s1012:c2#p"), entity_ref("urn:test:s1012:c2#a"), 49000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1001-03-UNKNOWN-BASIS-UNDETERMINED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sale_or_disposition(entity_ref("urn:test:s1001:u1#t"), entity_ref("urn:test:s1001:u1#p"), entity_ref("urn:test:s1001:u1#a"), @2024-06-01) { origin case_input; }
        assert "f1": money_received(entity_ref("urn:test:s1001:u1#t"), 10000.00 USD) { origin case_input; }
        assert "f2": fmv_of_property_received(entity_ref("urn:test:s1001:u1#t"), 0.00 USD) { origin case_input; }
        // no basis asserted: gain_realized is neither established true nor false.
    }
    evaluate truth(gain_realized(entity_ref("urn:test:s1001:u1#p"), entity_ref("urn:test:s1001:u1#t"), 4000.00 USD));
    expect truth_status == NEITHER;
}
