// Property-transactions WIRE-10 group B scenarios (section 1398(g)(3), (4), (7)). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "W10B-PT-01-1398G3-ESTATE-SUCCEEDS-WHEN-THE-SECTION-APPLIES" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bankruptcy_case_under_chapter_7_or_11(entity_ref("urn:test:w10b:bk1#c"), entity_ref("urn:test:w10b:bk1#d")) { origin case_input; }
        assert "f1": debtor_is_individual(entity_ref("urn:test:w10b:bk1#d")) { origin case_input; }
        assert "f2": bankruptcy_estate_of(entity_ref("urn:test:w10b:bk1#c"), entity_ref("urn:test:w10b:bk1#e")) { origin case_input; }
    }
    evaluate truth(estate_succeeds_to_tax_benefit_recovery_items(entity_ref("urn:test:w10b:bk1#e"), entity_ref("urn:test:w10b:bk1#d")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PT-02-1398G3-NO-SUCCESSION-FOR-A-DISMISSED-CASE" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bankruptcy_case_under_chapter_7_or_11(entity_ref("urn:test:w10b:bk1#c"), entity_ref("urn:test:w10b:bk1#d")) { origin case_input; }
        assert "f1": debtor_is_individual(entity_ref("urn:test:w10b:bk1#d")) { origin case_input; }
        assert "f2": bankruptcy_estate_of(entity_ref("urn:test:w10b:bk1#c"), entity_ref("urn:test:w10b:bk1#e")) { origin case_input; }
        assert "f3": case_dismissed(entity_ref("urn:test:w10b:bk1#c")) { origin case_input; }
    }
    evaluate truth(estate_succeeds_to_tax_benefit_recovery_items(entity_ref("urn:test:w10b:bk1#e"), entity_ref("urn:test:w10b:bk1#d")));
    expect truth_status == NEITHER;
}

