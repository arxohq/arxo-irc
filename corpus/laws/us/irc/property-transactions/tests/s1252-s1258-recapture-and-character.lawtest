test "S1254-01-RECAPTURE-BASE-IS-EXPENDITURES-LESS-617-INCLUSIONS-PLUS-DEPLETION" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": section_1254_property_disposed(entity_ref("urn:test:s1252:13#t"), entity_ref("urn:test:s1252:13#p"), entity_ref("urn:test:s1252:13#prop")) { origin case_input; }
        assert "f1": expenditures_chargeable_or_depletion_in_basis(entity_ref("urn:test:s1252:13#prop")) { origin case_input; }
        assert "f2": expenditures_deducted_under_263_616_617(entity_ref("urn:test:s1252:13#t"), 300000.00 USD) { origin case_input; }
        assert "f3": amounts_included_under_617b1A(entity_ref("urn:test:s1252:13#t"), 20000.00 USD) { origin case_input; }
        assert "f4": depletion_deductions_reducing_basis(entity_ref("urn:test:s1252:13#t"), 50000.00 USD) { origin case_input; }
        assert "f5": value_on_disposition_1254(entity_ref("urn:test:s1252:13#t"), 500000.00 USD) { origin case_input; }
        assert "f6": adjusted_basis_1254(entity_ref("urn:test:s1252:13#t"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(section_1254_recapture_base(entity_ref("urn:test:s1252:13#t"), 330000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

