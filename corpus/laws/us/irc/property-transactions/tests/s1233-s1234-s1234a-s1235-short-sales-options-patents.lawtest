        assert "f1": transfer_of_all_substantial_patent_rights(entity_ref("urn:test:s1235:a1#t"), entity_ref("urn:test:s1235:a1#holder"), entity_ref("urn:test:s1235:a1#patent"), @2024-06-01) { origin case_input; }
        assert "f2": sale_or_exchange_to(entity_ref("urn:test:s1235:a1#t"), entity_ref("urn:test:s1235:a1#holder"), entity_ref("urn:test:s1235:a1#buyer")) { origin case_input; }
    }
    evaluate truth(section_1235_transfer_is_long_term_capital_gain(entity_ref("urn:test:s1235:a1#t"), entity_ref("urn:test:s1235:a1#holder"), entity_ref("urn:test:s1235:a1#patent")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1235-02-TRANSFER-TO-25-PERCENT-OWNED-CORPORATION-NOT-CAPITAL-GAIN" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": created_the_patented_property(entity_ref("urn:test:s1235:c1#holder"), entity_ref("urn:test:s1235:c1#patent")) { origin case_input; }
        assert "f1": transfer_of_all_substantial_patent_rights(entity_ref("urn:test:s1235:c1#t"), entity_ref("urn:test:s1235:c1#holder"), entity_ref("urn:test:s1235:c1#patent"), @2024-06-01) { origin case_input; }
        assert "f2": sale_or_exchange_to(entity_ref("urn:test:s1235:c1#t"), entity_ref("urn:test:s1235:c1#holder"), entity_ref("urn:test:s1235:c1#buyer_corp")) { origin case_input; }
        assert "f3": us.irc.corporations::constructive_ownership(entity_ref("urn:test:s1235:c1#holder"), entity_ref("urn:test:s1235:c1#buyer_corp"), 0.30, us.irc.corporations::Actual) { origin case_input; }
    }
    // 30% ownership exceeds section 1235(c)'s 25%-substituted threshold: related persons, (a) does not apply.
    evaluate truth(section_1235_transfer_is_long_term_capital_gain(entity_ref("urn:test:s1235:c1#t"), entity_ref("urn:test:s1235:c1#holder"), entity_ref("urn:test:s1235:c1#patent")));
    expect truth_status == NEITHER;
}
