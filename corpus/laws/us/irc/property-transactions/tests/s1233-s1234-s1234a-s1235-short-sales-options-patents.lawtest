// Sections 1233, 1234, 1234A, 1235 scenarios (stage 2b). NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1233-01-SHORT-SALE-CLOSED-WITH-CAPITAL-ASSET-IS-CAPITAL" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": short_sale(entity_ref("urn:test:s1233:a1#t"), entity_ref("urn:test:s1233:a1#p"), @2024-01-01) { origin case_input; }
        assert "f1": property_used_to_close_is_capital_asset(entity_ref("urn:test:s1233:a1#t"), entity_ref("urn:test:s1233:a1#p")) { origin case_input; }
    }
    evaluate truth(short_sale_gain_or_loss_is_capital(entity_ref("urn:test:s1233:a1#t"), entity_ref("urn:test:s1233:a1#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1233-02-SHORT-TERM-GAIN-WHEN-SI-PROPERTY-HELD-UNDER-1-YEAR" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": short_sale(entity_ref("urn:test:s1233:b1#t"), entity_ref("urn:test:s1233:b1#p"), @2024-01-01) { origin case_input; }
        assert "f1": property_used_to_close_is_capital_asset(entity_ref("urn:test:s1233:b1#t"), entity_ref("urn:test:s1233:b1#p")) { origin case_input; }
        assert "f2": substantially_identical_property_held_not_more_than_1_year_at_short_sale(entity_ref("urn:test:s1233:b1#t"), entity_ref("urn:test:s1233:b1#p"), entity_ref("urn:test:s1233:b1#si")) { origin case_input; }
        assert "f3": closes_short_sale(entity_ref("urn:test:s1233:b1#t"), entity_ref("urn:test:s1233:b1#closing"), @2024-03-01) { origin case_input; }
    }
    evaluate truth(short_sale_closing_gain_short_term(entity_ref("urn:test:s1233:b1#t"), entity_ref("urn:test:s1233:b1#closing")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

