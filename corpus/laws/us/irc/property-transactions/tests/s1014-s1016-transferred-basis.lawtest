// Sections 1014, 1015, 1016 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1014-01-STEPPED-UP-BASIS-AT-DEATH" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": acquired_by_bequest_devise_or_inheritance(entity_ref("urn:test:s1014:d1#p"), entity_ref("urn:test:s1014:d1#a"), entity_ref("urn:test:s1014:d1#decedent")) { origin case_input; }
        assert "f1": date_of_death_fair_market_value(entity_ref("urn:test:s1014:d1#a"), entity_ref("urn:test:s1014:d1#decedent"), 300000.00 USD) { origin adjudicated; }
    }
    evaluate truth(decedent_property_basis(entity_ref("urn:test:s1014:d1#p"), entity_ref("urn:test:s1014:d1#a"), 300000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1014-02-ONE-YEAR-RULE-NO-STEP-UP" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": appreciated_gift_to_decedent_within_one_year(entity_ref("urn:test:s1014:oy1#a"), entity_ref("urn:test:s1014:oy1#donor"), entity_ref("urn:test:s1014:oy1#decedent"), @2024-01-01, @2024-06-01, 50000.00 USD, 10000.00 USD) { origin case_input; }
        assert "f1": acquired_from_decedent_by_original_donor_or_spouse(entity_ref("urn:test:s1014:oy1#a"), entity_ref("urn:test:s1014:oy1#donor"), entity_ref("urn:test:s1014:oy1#decedent")) { origin case_input; }
        assert "f2": decedent_died_on(entity_ref("urn:test:s1014:oy1#decedent"), @2024-06-01) { origin case_input; }
        assert "f3": decedent_property_basis_before_death(entity_ref("urn:test:s1014:oy1#a"), entity_ref("urn:test:s1014:oy1#decedent"), 10000.00 USD) { origin case_input; }
    }
    // no step-up: basis remains the decedent's carryover basis of $10,000, not the $50,000 FMV.
    evaluate truth(decedent_property_basis(entity_ref("urn:test:s1014:oy1#donor"), entity_ref("urn:test:s1014:oy1#a"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1015-01-GIFT-BASIS-SALE-ABOVE-DONOR-BASIS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": acquired_by_gift(entity_ref("urn:test:s1015:g1#donee"), entity_ref("urn:test:s1015:g1#a"), entity_ref("urn:test:s1015:g1#donor"), @2024-01-01) { origin case_input; }
        assert "f1": donor_adjusted_basis_at_gift(entity_ref("urn:test:s1015:g1#a"), entity_ref("urn:test:s1015:g1#donor"), @2024-01-01, 10000.00 USD) { origin case_input; }
        assert "f2": fair_market_value_at_gift(entity_ref("urn:test:s1015:g1#a"), @2024-01-01, 15000.00 USD) { origin adjudicated; }
    }
    // sale above donor's basis: gain basis = donor's $10,000 (dual basis rule doesn't reduce it, since donor basis < FMV).
    evaluate truth(gift_basis_for_gain(entity_ref("urn:test:s1015:g1#donee"), entity_ref("urn:test:s1015:g1#a"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gift_basis_for_loss(entity_ref("urn:test:s1015:g1#donee"), entity_ref("urn:test:s1015:g1#a"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1015-02-GIFT-BASIS-DUAL-BASIS-LOSS-FLOOR" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": acquired_by_gift(entity_ref("urn:test:s1015:g2#donee"), entity_ref("urn:test:s1015:g2#a"), entity_ref("urn:test:s1015:g2#donor"), @2024-01-01) { origin case_input; }
        assert "f1": donor_adjusted_basis_at_gift(entity_ref("urn:test:s1015:g2#a"), entity_ref("urn:test:s1015:g2#donor"), @2024-01-01, 10000.00 USD) { origin case_input; }
        assert "f2": fair_market_value_at_gift(entity_ref("urn:test:s1015:g2#a"), @2024-01-01, 6000.00 USD) { origin adjudicated; }
    }
    // donor's basis ($10,000) exceeds FMV at gift ($6,000): for LOSS purposes, basis is capped at the $6,000 FMV.
    evaluate truth(gift_basis_for_loss(entity_ref("urn:test:s1015:g2#donee"), entity_ref("urn:test:s1015:g2#a"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gift_basis_for_gain(entity_ref("urn:test:s1015:g2#donee"), entity_ref("urn:test:s1015:g2#a"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1016-01-DEPRECIATION-ADJUSTMENT-REDUCES-BASIS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": basis_as_of(entity_ref("urn:test:s1016:d1#p"), entity_ref("urn:test:s1016:d1#a"), @2024-06-01) { origin case_input; }
        assert "f1": purchase_price(entity_ref("urn:test:s1016:d1#p"), entity_ref("urn:test:s1016:d1#a"), 100000.00 USD) { origin case_input; }
        assert "f2": depreciation_allowed(entity_ref("urn:test:s1016:d1#p"), entity_ref("urn:test:s1016:d1#a"), @2023-12-31, 20000.00 USD) { origin case_input; }
        assert "f3": depreciation_allowable(entity_ref("urn:test:s1016:d1#p"), entity_ref("urn:test:s1016:d1#a"), @2023-12-31, 20000.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.core::adjusted_basis(entity_ref("urn:test:s1016:d1#p"), entity_ref("urn:test:s1016:d1#a"), @2024-06-01, 80000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
