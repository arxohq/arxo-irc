// Sections 1031, 1033, 1041 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1031-01-LIKE-KIND-EXCHANGE-NO-GAIN" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": like_kind_exchange(entity_ref("urn:test:s1031:lk1#t"), entity_ref("urn:test:s1031:lk1#p"), entity_ref("urn:test:s1031:lk1#old"), entity_ref("urn:test:s1031:lk1#new"), @2024-03-01) { origin case_input; }
        assert "f1": real_property(entity_ref("urn:test:s1031:lk1#old")) { origin case_input; }
        assert "f2": real_property(entity_ref("urn:test:s1031:lk1#new")) { origin case_input; }
        assert "f3": us_real_property(entity_ref("urn:test:s1031:lk1#old")) { origin case_input; }
        assert "f4": us_real_property(entity_ref("urn:test:s1031:lk1#new")) { origin case_input; }
        assert "f5": held_for_productive_use_or_investment(entity_ref("urn:test:s1031:lk1#p"), entity_ref("urn:test:s1031:lk1#old")) { origin case_input; }
        assert "f6": held_for_productive_use_or_investment(entity_ref("urn:test:s1031:lk1#p"), entity_ref("urn:test:s1031:lk1#new")) { origin case_input; }
    }
    evaluate truth(nonrecognition_exception_applies(entity_ref("urn:test:s1031:lk1#p"), entity_ref("urn:test:s1031:lk1#t")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gain_recognized(entity_ref("urn:test:s1031:lk1#p"), entity_ref("urn:test:s1031:lk1#t"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1031-02-BOOT-RECOGNIZED-UP-TO-LESSER-OF-GAIN-OR-BOOT" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": like_kind_exchange(entity_ref("urn:test:s1031:b1#t"), entity_ref("urn:test:s1031:b1#p"), entity_ref("urn:test:s1031:b1#old"), entity_ref("urn:test:s1031:b1#new"), @2024-03-01) { origin case_input; }
        assert "f1": real_property(entity_ref("urn:test:s1031:b1#old")) { origin case_input; }
        assert "f2": real_property(entity_ref("urn:test:s1031:b1#new")) { origin case_input; }
        assert "f3": us_real_property(entity_ref("urn:test:s1031:b1#old")) { origin case_input; }
        assert "f4": us_real_property(entity_ref("urn:test:s1031:b1#new")) { origin case_input; }
        assert "f5": held_for_productive_use_or_investment(entity_ref("urn:test:s1031:b1#p"), entity_ref("urn:test:s1031:b1#old")) { origin case_input; }
        assert "f6": held_for_productive_use_or_investment(entity_ref("urn:test:s1031:b1#p"), entity_ref("urn:test:s1031:b1#new")) { origin case_input; }
        assert "f7": gain_realized(entity_ref("urn:test:s1031:b1#p"), entity_ref("urn:test:s1031:b1#t"), 50000.00 USD) { origin case_input; }
        assert "f8": boot_money_received(entity_ref("urn:test:s1031:b1#t"), 20000.00 USD) { origin case_input; }
        assert "f9": boot_other_property_fmv(entity_ref("urn:test:s1031:b1#t"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(gain_recognized(entity_ref("urn:test:s1031:b1#p"), entity_ref("urn:test:s1031:b1#t"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1031-03-LATE-IDENTIFICATION-AFTER-45-DAYS-IS-BOOT" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": relinquished_property_transferred_on(entity_ref("urn:test:s1031:id1#t"), @2024-01-01) { origin case_input; }
        assert "f1": identified_on_or_before(entity_ref("urn:test:s1031:id1#t"), entity_ref("urn:test:s1031:id1#new"), @2024-03-01) { origin case_input; }
    }
    // 2024-03-01 is 60 days after 2024-01-01, past the 45-day identification window.
    evaluate truth(treated_as_not_like_kind_property(entity_ref("urn:test:s1031:id1#t"), entity_ref("urn:test:s1031:id1#new")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

