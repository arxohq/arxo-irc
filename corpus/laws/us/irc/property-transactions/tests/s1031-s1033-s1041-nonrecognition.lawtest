        assert "f1": current_spouse_of(entity_ref("urn:test:s1041:sp1#p"), entity_ref("urn:test:s1041:sp1#spouse")) { origin case_input; }
        assert "f2": transferred_asset_of(entity_ref("urn:test:s1041:sp1#t"), entity_ref("urn:test:s1041:sp1#a")) { origin case_input; }
        assert "f3": transferor_adjusted_basis_at_transfer(entity_ref("urn:test:s1041:sp1#t"), entity_ref("urn:test:s1041:sp1#p"), entity_ref("urn:test:s1041:sp1#a"), @2024-06-01, 40000.00 USD) { origin case_input; }
    }
    evaluate truth(gain_recognized(entity_ref("urn:test:s1041:sp1#p"), entity_ref("urn:test:s1041:sp1#t"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(us.irc.core::adjusted_basis(entity_ref("urn:test:s1041:sp1#spouse"), entity_ref("urn:test:s1041:sp1#a"), @2024-06-01, 40000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1041-02-TRANSFER-TO-NONRESIDENT-ALIEN-SPOUSE-NOT-EXEMPT" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": transfer_to_spouse_or_former_spouse(entity_ref("urn:test:s1041:na1#t"), entity_ref("urn:test:s1041:na1#p"), entity_ref("urn:test:s1041:na1#spouse")) { origin case_input; }
        assert "f1": current_spouse_of(entity_ref("urn:test:s1041:na1#p"), entity_ref("urn:test:s1041:na1#spouse")) { origin case_input; }
        assert "f2": transferee_is_nonresident_alien(entity_ref("urn:test:s1041:na1#t"), entity_ref("urn:test:s1041:na1#spouse")) { origin case_input; }
    }
    // section 1041(d): nonrecognition does not apply; this package's default
    // section 1001(c) rule governs instead (not asserted in this scenario, so UNDETERMINED here).
    evaluate truth(nonrecognition_exception_applies(entity_ref("urn:test:s1041:na1#p"), entity_ref("urn:test:s1041:na1#t")));
    expect truth_status == NEITHER;
}
