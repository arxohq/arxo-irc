}

test "S1033-02-ELECTED-REPLACEMENT-GAIN-LIMITED-TO-EXCESS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": involuntary_conversion(entity_ref("urn:test:s1033:e1#t"), entity_ref("urn:test:s1033:e1#p"), entity_ref("urn:test:s1033:e1#converted")) { origin case_input; }
        assert "f1": converted_into_money_or_dissimilar_property(entity_ref("urn:test:s1033:e1#t"), 100000.00 USD) { origin case_input; }
        assert "f2": elects_to_replace_converted_property(entity_ref("urn:test:s1033:e1#p"), entity_ref("urn:test:s1033:e1#t")) { origin case_input; }
        assert "f3": replacement_property_cost(entity_ref("urn:test:s1033:e1#t"), 90000.00 USD) { origin case_input; }
        assert "f4": disposition_of_converted_property_on(entity_ref("urn:test:s1033:e1#t"), @2024-01-01) { origin case_input; }
        assert "f5": close_of_realization_taxable_year(entity_ref("urn:test:s1033:e1#t"), @2024-12-31) { origin case_input; }
        assert "f6": replacement_purchased_on(entity_ref("urn:test:s1033:e1#t"), @2024-06-01) { origin case_input; }
    }
    // amount realized 100,000 - replacement cost 90,000 = 10,000 recognized gain.
    evaluate truth(gain_recognized(entity_ref("urn:test:s1033:e1#p"), entity_ref("urn:test:s1033:e1#t"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

