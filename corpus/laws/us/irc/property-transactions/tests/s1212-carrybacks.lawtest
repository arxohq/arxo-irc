test "S1212A2B-01-NO-EXPROPRIATION-PORTION-WHEN-NONE-RECORDED" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": corporate_loss_year_net_capital_loss(entity_ref("urn:test:s36:1#p"), entity_ref("urn:test:s36:1#ly"), 100.00 USD) { origin case_input; }
    }
    evaluate truth(expropriation_portion_1212a2B(entity_ref("urn:test:s36:1#p"), entity_ref("urn:test:s36:1#ly"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

