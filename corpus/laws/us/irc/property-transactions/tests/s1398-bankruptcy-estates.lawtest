// Section 1398 scenarios (stage 2b). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1398-01-INDIVIDUAL-DEBTOR-CHAPTER-7-SECTION-APPLIES" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": bankruptcy_case_under_chapter_7_or_11(entity_ref("urn:test:s1398:c1#case"), entity_ref("urn:test:s1398:c1#debtor")) { origin case_input; }
        assert "f1": debtor_is_individual(entity_ref("urn:test:s1398:c1#debtor")) { origin case_input; }
    }
    evaluate truth(section_1398_applies(entity_ref("urn:test:s1398:c1#case"), entity_ref("urn:test:s1398:c1#debtor")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1398-02-DISMISSED-CASE-SECTION-DOES-NOT-APPLY" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": bankruptcy_case_under_chapter_7_or_11(entity_ref("urn:test:s1398:c2#case"), entity_ref("urn:test:s1398:c2#debtor")) { origin case_input; }
        assert "f1": debtor_is_individual(entity_ref("urn:test:s1398:c2#debtor")) { origin case_input; }
        assert "f2": case_dismissed(entity_ref("urn:test:s1398:c2#case")) { origin case_input; }
    }
    evaluate truth(section_1398_applies(entity_ref("urn:test:s1398:c2#case"), entity_ref("urn:test:s1398:c2#debtor")));
    expect truth_status == NEITHER;
}

test "S1398-03-YEAR-TERMINATION-ELECTION-VALID" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": elects_to_terminate_debtors_year(entity_ref("urn:test:s1398:e1#debtor"), entity_ref("urn:test:s1398:e1#case")) { origin case_input; }
        assert "f1": election_made_by_due_date_1398d2d(entity_ref("urn:test:s1398:e1#debtor"), entity_ref("urn:test:s1398:e1#case")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1398DebtorYearTerminationElection, VALIDLY_EXERCISED);
    evaluate truth(debtors_year_terminated_at_commencement(entity_ref("urn:test:s1398:e1#debtor"), entity_ref("urn:test:s1398:e1#case")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1398-04-YEAR-TERMINATION-ELECTION-INVALID-EXEMPT-PROPERTY-ONLY" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": elects_to_terminate_debtors_year(entity_ref("urn:test:s1398:e2#debtor"), entity_ref("urn:test:s1398:e2#case")) { origin case_input; }
        assert "f1": election_made_by_due_date_1398d2d(entity_ref("urn:test:s1398:e2#debtor"), entity_ref("urn:test:s1398:e2#case")) { origin case_input; }
        assert "f2": debtor_has_only_exempt_property(entity_ref("urn:test:s1398:e2#debtor"), entity_ref("urn:test:s1398:e2#case")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1398DebtorYearTerminationElection, INVALIDLY_EXERCISED);
    evaluate truth(debtors_year_terminated_at_commencement(entity_ref("urn:test:s1398:e2#debtor"), entity_ref("urn:test:s1398:e2#case")));
    expect truth_status == NEITHER;
}

test "S1398-05-ESTATE-SUCCEEDS-TO-CAPITAL-LOSS-CARRYOVER" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": bankruptcy_case_under_chapter_7_or_11(entity_ref("urn:test:s1398:g1#case"), entity_ref("urn:test:s1398:g1#debtor")) { origin case_input; }
        assert "f1": debtor_is_individual(entity_ref("urn:test:s1398:g1#debtor")) { origin case_input; }
        assert "f2": bankruptcy_estate_of(entity_ref("urn:test:s1398:g1#case"), entity_ref("urn:test:s1398:g1#estate")) { origin case_input; }
        assert "f3": capital_loss_carryover(entity_ref("urn:test:s1398:g1#debtor"), entity_ref("urn:test:s1398:g1#y1"), entity_ref("urn:test:s1398:g1#y2"), ShortTerm, 4000.00 USD) { origin case_input; }
    }
    evaluate truth(estate_succeeds_to_capital_loss_carryover(entity_ref("urn:test:s1398:g1#estate"), entity_ref("urn:test:s1398:g1#debtor"), entity_ref("urn:test:s1398:g1#y1"), entity_ref("urn:test:s1398:g1#y2"), ShortTerm, 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1398-06-TRANSFER-DEBTOR-TO-ESTATE-NOT-A-DISPOSITION" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": transfer_debtor_to_estate(entity_ref("urn:test:s1398:t1#t"), entity_ref("urn:test:s1398:t1#debtor"), entity_ref("urn:test:s1398:t1#estate"), entity_ref("urn:test:s1398:t1#a")) { origin case_input; }
    }
    evaluate truth(section_1398_transfer_not_a_disposition(entity_ref("urn:test:s1398:t1#t")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
