test "S1043C-01-UNRECOGNIZED-GAIN-IS-GAIN-LESS-RECOGNIZED" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": sale_pursuant_to_certificate_of_divestiture(entity_ref("urn:test:s31:1#t"), entity_ref("urn:test:s31:1#p"), 1000000.00 USD) { origin case_input; }
        assert "f1": seller_is_eligible_person_1043(entity_ref("urn:test:s31:1#p")) { origin case_input; }
        assert "f2": certificate_of_divestiture_valid(entity_ref("urn:test:s31:1#t")) { origin case_input; }
        assert "f3": elects_1043(entity_ref("urn:test:s31:1#t"), entity_ref("urn:test:s31:1#p")) { origin case_input; }
        assert "f4": permitted_property_cost_within_60_days(entity_ref("urn:test:s31:1#t"), 900000.00 USD) { origin case_input; }
        assert "f5": gain_realized(entity_ref("urn:test:s31:1#p"), entity_ref("urn:test:s31:1#t"), 300000.00 USD) { origin case_input; }
    }
    evaluate truth(ordered_basis_regime_gain(entity_ref("urn:test:s31:1#t"), Section1043, 200000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

