// Sections 1311-1314 scenarios (stage 2b, mitigation of limitations). NOT
// EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1312-01-DOUBLE-INCLUSION-CIRCUMSTANCE-CLASSIFIED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": circumstance_of_adjustment(entity_ref("urn:test:s1312:c1#d"), DoubleInclusionOfGrossIncomeItem) { origin case_input; }
    }
    evaluate truth(circumstance_of_adjustment(entity_ref("urn:test:s1312:c1#d"), DoubleInclusionOfGrossIncomeItem));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1311-01-ADJUSTMENT-AUTHORIZED-WHEN-ALL-CONDITIONS-MET" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": circumstance_of_adjustment(entity_ref("urn:test:s1311:a1#d"), DoubleInclusionOfGrossIncomeItem) { origin case_input; }
        assert "f1": correction_prevented_by_other_law(entity_ref("urn:test:s1311:a1#d")) { origin case_input; }
        assert "f2": inconsistent_position_by_secretary(entity_ref("urn:test:s1311:a1#d")) { origin case_input; }
    }
    evaluate truth(mitigation_adjustment_authorized(entity_ref("urn:test:s1311:a1#d")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1311-02-ADJUSTMENT-NOT-AUTHORIZED-WHEN-CORRECTION-NOT-BARRED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": circumstance_of_adjustment(entity_ref("urn:test:s1311:a2#d"), DoubleInclusionOfGrossIncomeItem) { origin case_input; }
        assert "f1": inconsistent_position_by_secretary(entity_ref("urn:test:s1311:a2#d")) { origin case_input; }
    }
    // no correction_prevented_by_other_law asserted.
    evaluate truth(mitigation_adjustment_authorized(entity_ref("urn:test:s1311:a2#d")));
    expect truth_status == NEITHER;
}

test "S1314-01-MITIGATION-ADJUSTMENT-VALID-WITHIN-1-YEAR" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": circumstance_of_adjustment(entity_ref("urn:test:s1314:m1#d"), DoubleInclusionOfGrossIncomeItem) { origin case_input; }
        assert "f1": correction_prevented_by_other_law(entity_ref("urn:test:s1314:m1#d")) { origin case_input; }
        assert "f2": inconsistent_position_by_secretary(entity_ref("urn:test:s1314:m1#d")) { origin case_input; }
        assert "f3": determination_of_kind(entity_ref("urn:test:s1314:m1#d"), FinalCourtDecision, @2024-01-01) { origin case_input; }
        assert "f4": taxpayer_of_determination(entity_ref("urn:test:s1314:m1#d"), entity_ref("urn:test:s1314:m1#p")) { origin case_input; }
        assert "f5": mitigation_adjustment_exercised_on(entity_ref("urn:test:s1314:m1#d"), @2024-08-01) { origin case_input; }
        assert "f6": correct_treatment_tax_difference(entity_ref("urn:test:s1314:m1#d"), 4000.00 USD) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1314MitigationAdjustment, VALIDLY_EXERCISED);
    evaluate truth(mitigation_adjustment_made(entity_ref("urn:test:s1314:m1#d"), entity_ref("urn:test:s1314:m1#p"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1314-02-MITIGATION-ADJUSTMENT-INVALID-AFTER-1-YEAR" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": circumstance_of_adjustment(entity_ref("urn:test:s1314:m2#d"), DoubleInclusionOfGrossIncomeItem) { origin case_input; }
        assert "f1": correction_prevented_by_other_law(entity_ref("urn:test:s1314:m2#d")) { origin case_input; }
        assert "f2": inconsistent_position_by_secretary(entity_ref("urn:test:s1314:m2#d")) { origin case_input; }
        assert "f3": determination_of_kind(entity_ref("urn:test:s1314:m2#d"), FinalCourtDecision, @2024-01-01) { origin case_input; }
        assert "f4": taxpayer_of_determination(entity_ref("urn:test:s1314:m2#d"), entity_ref("urn:test:s1314:m2#p")) { origin case_input; }
        assert "f5": mitigation_adjustment_exercised_on(entity_ref("urn:test:s1314:m2#d"), @2025-06-01) { origin case_input; }
        assert "f6": correct_treatment_tax_difference(entity_ref("urn:test:s1314:m2#d"), 4000.00 USD) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1314MitigationAdjustment, INVALIDLY_EXERCISED);
}
