        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": foreign_currency_with_active_interbank_market(entity_ref("urn:test:s1092:43#pos")) { origin case_input; }
    }
    evaluate truth(personal_property_of_actively_traded_type(entity_ref("urn:test:s1092:43#pos")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1092-44-NON-IDENTIFIED-POSITION-NOT-OFFSETTING-WITH-IDENTIFIED-STRADDLE-POSITION" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": offsetting_by_substantial_diminution(entity_ref("urn:test:s1092:44#p"), entity_ref("urn:test:s1092:44#a"), entity_ref("urn:test:s1092:44#b")) { origin case_input; }
        assert "f1": position_ordered_pair_1092(entity_ref("urn:test:s1092:44#a"), entity_ref("urn:test:s1092:44#b")) { origin case_input; }
        assert "f2": part_of_identified_straddle(entity_ref("urn:test:s1092:44#b")) { origin case_input; }
        assert "f3": position_held_by(entity_ref("urn:test:s1092:44#p"), entity_ref("urn:test:s1092:44#a")) { origin case_input; }
        assert "f4": position_held_by(entity_ref("urn:test:s1092:44#p"), entity_ref("urn:test:s1092:44#b")) { origin case_input; }
        assert "f5": personal_property_of_actively_traded_type(entity_ref("urn:test:s1092:44#a")) { origin case_input; }
        assert "f6": personal_property_of_actively_traded_type(entity_ref("urn:test:s1092:44#b")) { origin case_input; }
    }
    evaluate truth(straddle_1092(entity_ref("urn:test:s1092:44#p"), entity_ref("urn:test:s1092:44#a"), entity_ref("urn:test:s1092:44#b")));
    expect truth_status == NEITHER;
}

test "S1092-45-BOTH-POSITIONS-OUTSIDE-IDENTIFIED-STRADDLE-STILL-OFFSETTING" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": offsetting_by_substantial_diminution(entity_ref("urn:test:s1092:45#p"), entity_ref("urn:test:s1092:45#a"), entity_ref("urn:test:s1092:45#b")) { origin case_input; }
        assert "f1": position_ordered_pair_1092(entity_ref("urn:test:s1092:45#a"), entity_ref("urn:test:s1092:45#b")) { origin case_input; }
        assert "f2": position_held_by(entity_ref("urn:test:s1092:45#p"), entity_ref("urn:test:s1092:45#a")) { origin case_input; }
        assert "f3": position_held_by(entity_ref("urn:test:s1092:45#p"), entity_ref("urn:test:s1092:45#b")) { origin case_input; }
        assert "f4": personal_property_of_actively_traded_type(entity_ref("urn:test:s1092:45#a")) { origin case_input; }
        assert "f5": personal_property_of_actively_traded_type(entity_ref("urn:test:s1092:45#b")) { origin case_input; }
    }
    evaluate truth(straddle_1092(entity_ref("urn:test:s1092:45#p"), entity_ref("urn:test:s1092:45#a"), entity_ref("urn:test:s1092:45#b")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
