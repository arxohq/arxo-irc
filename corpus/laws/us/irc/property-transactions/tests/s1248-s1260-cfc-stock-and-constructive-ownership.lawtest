test "S1248-01-GAIN-INCLUDED-AS-DIVIDEND-TO-EXTENT-OF-NET-EARNINGS" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us_person_1248(entity_ref("urn:test:s1248:1#p")) { origin case_input; }
        assert "f1": us_person_sells_foreign_corporation_stock(entity_ref("urn:test:s1248:1#t"), entity_ref("urn:test:s1248:1#p"), entity_ref("urn:test:s1248:1#corp")) { origin case_input; }
        assert "f2": owned_10_percent_voting_power_while_cfc_in_5_year_period(entity_ref("urn:test:s1248:1#p"), entity_ref("urn:test:s1248:1#corp"), entity_ref("urn:test:s1248:1#t")) { origin case_input; }
        assert "f3": gain_recognized(entity_ref("urn:test:s1248:1#p"), entity_ref("urn:test:s1248:1#t"), 100000.00 USD) { origin case_input; }
        assert "f4": earnings_and_profits_attributable_to_stock(entity_ref("urn:test:s1248:1#t"), 80000.00 USD) { origin case_input; }
        assert "f5": earnings_exclusion_1248d(entity_ref("urn:test:s1248:1#t"), PreviouslyTaxedSection951, 20000.00 USD) { origin case_input; }
        assert "f6": taxpayer_established_earnings_amount_1248h(entity_ref("urn:test:s1248:1#t")) { origin adjudicated; }
    }
    evaluate truth(section_1248_dividend(entity_ref("urn:test:s1248:1#p"), entity_ref("urn:test:s1248:1#t"), 60000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

