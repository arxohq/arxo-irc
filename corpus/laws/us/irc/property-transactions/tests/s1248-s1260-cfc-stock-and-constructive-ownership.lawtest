        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us_person_1248(entity_ref("urn:test:s1248:17#p")) { origin case_input; }
        assert "f1": us_person_sells_foreign_corporation_stock(entity_ref("urn:test:s1248:17#t"), entity_ref("urn:test:s1248:17#p"), entity_ref("urn:test:s1248:17#corp")) { origin case_input; }
        assert "f2": owned_10_percent_voting_power_while_cfc_in_5_year_period(entity_ref("urn:test:s1248:17#p"), entity_ref("urn:test:s1248:17#corp"), entity_ref("urn:test:s1248:17#t")) { origin case_input; }
        assert "f3": gain_recognized(entity_ref("urn:test:s1248:17#p"), entity_ref("urn:test:s1248:17#t"), 100000.00 USD) { origin case_input; }
        assert "f4": earnings_and_profits_attributable_to_stock(entity_ref("urn:test:s1248:17#t"), 80000.00 USD) { origin case_input; }
        assert "f5": earnings_exclusion_1248d(entity_ref("urn:test:s1248:17#t"), PreviouslyTaxedSection951, 20000.00 USD) { origin case_input; }
        assert "f6": taxpayer_established_earnings_amount_1248h(entity_ref("urn:test:s1248:17#t")) { origin adjudicated; }
        assert "f7": domestic_corporation_sells_foreign_stock_held_one_year_or_more(entity_ref("urn:test:s1248:17#t"), entity_ref("urn:test:s1248:17#p")) { origin case_input; }
    }
    evaluate truth(section_1248_dividend_treated_as_dividend_for_245a(entity_ref("urn:test:s1248:17#t"), entity_ref("urn:test:s1248:17#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

