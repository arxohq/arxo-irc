test "S1341-01-DEDUCTION-OVER-3000-MEETS-CONDITIONS" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": item_included_in_prior_year_under_apparent_unrestricted_right(entity_ref("urn:test:s1341:1#p"), entity_ref("urn:test:s1341:1#prior"), 50000.00 USD) { origin case_input; }
        assert "f1": deduction_allowable_because_right_not_established(entity_ref("urn:test:s1341:1#p"), entity_ref("urn:test:s1341:1#y"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(section_1341_conditions_met(entity_ref("urn:test:s1341:1#p"), entity_ref("urn:test:s1341:1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

