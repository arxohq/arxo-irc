test "S1202-07-PER-ISSUER-CAP-DOLLAR-LIMIT-GOVERNS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": aggregate_adjusted_basis_disposed_this_year(entity_ref("urn:test:s1202:p1#p"), entity_ref("urn:test:s1202:p1#corp"), entity_ref("urn:test:s1202:p1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": eligible_gain_taken_into_account_prior_years(entity_ref("urn:test:s1202:p1#p"), entity_ref("urn:test:s1202:p1#corp"), 2000000.00 USD) { origin case_input; }
    }
    // option A = 10,000,000 - 2,000,000 = 8,000,000; option B = 10 * 100,000 = 1,000,000. A governs.
    evaluate truth(per_issuer_cap(entity_ref("urn:test:s1202:p1#p"), entity_ref("urn:test:s1202:p1#corp"), entity_ref("urn:test:s1202:p1#y"), 8000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1202-08-PER-ISSUER-CAP-10X-BASIS-GOVERNS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": aggregate_adjusted_basis_disposed_this_year(entity_ref("urn:test:s1202:p2#p"), entity_ref("urn:test:s1202:p2#corp"), entity_ref("urn:test:s1202:p2#y"), 5000000.00 USD) { origin case_input; }
        assert "f1": eligible_gain_taken_into_account_prior_years(entity_ref("urn:test:s1202:p2#p"), entity_ref("urn:test:s1202:p2#corp"), 9000000.00 USD) { origin case_input; }
    }
    // option A = 10,000,000 - 9,000,000 = 1,000,000; option B = 10 * 5,000,000 = 50,000,000. B governs.
    evaluate truth(per_issuer_cap(entity_ref("urn:test:s1202:p2#p"), entity_ref("urn:test:s1202:p2#corp"), entity_ref("urn:test:s1202:p2#y"), 50000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1202-09-GIFT-TACKS-ACQUISITION-DATE-TO-DONEE" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qsbs_transfer_by_gift(entity_ref("urn:test:s1202:h1#t"), entity_ref("urn:test:s1202:h1#donor"), entity_ref("urn:test:s1202:h1#donee"), entity_ref("urn:test:s1202:h1#stock")) { origin case_input; }
        assert "f1": qsbs_acquired_on(entity_ref("urn:test:s1202:h1#donor"), entity_ref("urn:test:s1202:h1#stock"), @2015-01-01) { origin case_input; }
    }
    evaluate truth(qsbs_acquired_on_via_transfer(entity_ref("urn:test:s1202:h1#donee"), entity_ref("urn:test:s1202:h1#stock"), @2015-01-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
