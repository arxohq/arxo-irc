// Section 1202 scenarios (stage 2b, qualified small business stock). NOT
// EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1202-01-QUALIFIED-SMALL-BUSINESS-AT-50M-CEILING-PRE-OBBBA" {
    given {
        context { legal_time @2020-06-01; decision_time @2020-06-01T09:00:00-05:00; knowledge_time @2020-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qualified_small_business_domestic_c_corp(entity_ref("urn:test:s1202:d1#corp")) { origin case_input; }
        assert "f1": aggregate_gross_assets_before_issuance(entity_ref("urn:test:s1202:d1#corp"), 20000000.00 USD) { origin case_input; }
        assert "f2": aggregate_gross_assets_immediately_after_issuance(entity_ref("urn:test:s1202:d1#corp"), entity_ref("urn:test:s1202:d1#stock"), 30000000.00 USD) { origin case_input; }
        assert "f3": originally_issued_after_19930810(entity_ref("urn:test:s1202:d1#stock")) { origin case_input; }
        assert "f4": stock_issued_on(entity_ref("urn:test:s1202:d1#stock"), @2018-01-01) { origin case_input; }
    }
    evaluate truth(qualified_small_business_at_issuance(entity_ref("urn:test:s1202:d1#corp"), entity_ref("urn:test:s1202:d1#stock")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1202-02-GROSS-ASSETS-EXCEEDING-75M-AFTER-OBBBA-DISQUALIFIES" {
    given {
        context { legal_time @2025-08-01; decision_time @2025-08-01T09:00:00-05:00; knowledge_time @2025-08-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qualified_small_business_domestic_c_corp(entity_ref("urn:test:s1202:d2#corp")) { origin case_input; }
        assert "f1": aggregate_gross_assets_before_issuance(entity_ref("urn:test:s1202:d2#corp"), 60000000.00 USD) { origin case_input; }
        assert "f2": aggregate_gross_assets_immediately_after_issuance(entity_ref("urn:test:s1202:d2#corp"), entity_ref("urn:test:s1202:d2#stock"), 80000000.00 USD) { origin case_input; }
        assert "f3": originally_issued_after_19930810(entity_ref("urn:test:s1202:d2#stock")) { origin case_input; }
        assert "f4": stock_issued_on(entity_ref("urn:test:s1202:d2#stock"), @2025-08-01) { origin case_input; }
    }
    // $80,000,000 immediately after issuance exceeds even the $75,000,000 OBBBA ceiling.
    evaluate truth(qualified_small_business_at_issuance(entity_ref("urn:test:s1202:d2#corp"), entity_ref("urn:test:s1202:d2#stock")));
    expect truth_status == NEITHER;
}

test "S1202-03-ACTIVE-BUSINESS-80-PERCENT-TEST-MET" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qualified_trade_or_business_assets_value(entity_ref("urn:test:s1202:e1#corp"), 850000.00 USD) { origin case_input; }
        assert "f1": total_assets_value(entity_ref("urn:test:s1202:e1#corp"), 1000000.00 USD) { origin case_input; }
    }
    evaluate truth(active_business_80_percent_test_met(entity_ref("urn:test:s1202:e1#corp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1202-04-PRE-2010-ACT-STOCK-100-PERCENT-EXCLUSION" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qsbs_acquired_on(entity_ref("urn:test:s1202:x1#p"), entity_ref("urn:test:s1202:x1#stock"), @2015-01-01) { origin case_input; }
        assert "f1": qsbs_held_years(entity_ref("urn:test:s1202:x1#p"), entity_ref("urn:test:s1202:x1#stock"), 9) { origin case_input; }
    }
    evaluate truth(section_1202_exclusion_percentage(entity_ref("urn:test:s1202:x1#p"), entity_ref("urn:test:s1202:x1#stock"), 1.0));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

