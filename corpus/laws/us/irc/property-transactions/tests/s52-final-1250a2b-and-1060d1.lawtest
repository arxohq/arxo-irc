        assert "f3": excess_of_realized_over_basis_1250(entity_ref("urn:test:s52:3#p"), entity_ref("urn:test:s52:3#t"), 100 USD) { origin case_input; }
        assert "f4": residential_rental_property_167j2B(entity_ref("urn:test:s52:3#a")) { origin case_input; }
        assert "f5": full_months_held_at_disposition(entity_ref("urn:test:s52:3#a"), 120) { origin case_input; }
    }
    evaluate truth(section_1250a2_ordinary_income(entity_ref("urn:test:s52:3#p"), entity_ref("urn:test:s52:3#t"), 80.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
