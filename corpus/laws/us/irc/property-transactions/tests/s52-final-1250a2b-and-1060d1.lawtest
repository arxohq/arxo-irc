    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1250A2B-07-NO-B4-PIECE-THE-ONE-PERCENTAGE-RULE-STANDS" {
    // no (b)(4) piece: 80 percent of min(100, 100) = 80 (module 35, unchanged).
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
