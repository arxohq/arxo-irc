language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";


test "S1250A2B-05-B4-PIECE-TAKES-CLAUSE-IV-THE-REST-CLAUSE-III" {
    // 100 of 1970-75 additional depreciation, 60 of it under (b)(4); cap 100 shared pro rata: other 40 x 80 percent + (b)(4) 60 x 70 percent = 74.
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": disposition_on_or_after_1970_1_1(entity_ref("urn:test:s52:1#t")) { origin case_input; }
        assert "f1": additional_depreciation_after_1975(entity_ref("urn:test:s52:1#p"), entity_ref("urn:test:s52:1#a"), 0 USD) { origin case_input; }
        assert "f2": additional_depreciation_1970_to_1975(entity_ref("urn:test:s52:1#p"), entity_ref("urn:test:s52:1#a"), 100 USD) { origin case_input; }
        assert "f3": excess_of_realized_over_basis_1250(entity_ref("urn:test:s52:1#p"), entity_ref("urn:test:s52:1#t"), 100 USD) { origin case_input; }
        assert "f4": residential_rental_property_167j2B(entity_ref("urn:test:s52:1#a")) { origin case_input; }
        assert "f5": full_months_held_at_disposition(entity_ref("urn:test:s52:1#a"), 120) { origin case_input; }
        assert "f6": additional_depreciation_1970_to_1975_b4(entity_ref("urn:test:s52:1#p"), entity_ref("urn:test:s52:1#a"), 60 USD) { origin case_input; }
        assert "f7": depreciation_deduction_for_rehabilitation_167k_allowed(entity_ref("urn:test:s52:1#a")) { origin case_input; }
        assert "f8": full_months_since_placed_in_service(entity_ref("urn:test:s52:1#a"), 130) { origin case_input; }
    }
    evaluate truth(section_1250a2_ordinary_income(entity_ref("urn:test:s52:1#p"), entity_ref("urn:test:s52:1#t"), 74.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1250A2B-06-CAP-SHARED-PRO-RATA-BETWEEN-THE-PIECES" {
    // cap 50 shared 40:60: other 20 x 80 percent + (b)(4) 30 x 70 percent = 16 + 21 = 37 (JUDGMENT CALL: pro rata).
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
