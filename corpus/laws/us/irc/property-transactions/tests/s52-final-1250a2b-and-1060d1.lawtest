test "S1060D1-01-SECTION-197-VALUE-FOR-SECTION-755-FROM-THE-RESIDUAL-METHOD" {
    // consideration 1000, classes I-V take 600, class VI takes min(400, 250) = 250, class VII 150: the value of section 197 intangibles is 400.
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": partnership_distribution_or_interest_transfer_with_section_755(entity_ref("urn:test:s52:4#t")) { origin case_input; }
        assert "f1": total_consideration_for_applicable_assets_1060(entity_ref("urn:test:s52:4#t"), 1000 USD) { origin case_input; }
        assert "f2": class_fair_market_value_1060(entity_ref("urn:test:s52:4#t"), 1, 100 USD) { origin case_input; }
        assert "f3": class_fair_market_value_1060(entity_ref("urn:test:s52:4#t"), 2, 100 USD) { origin case_input; }
        assert "f4": class_fair_market_value_1060(entity_ref("urn:test:s52:4#t"), 3, 100 USD) { origin case_input; }
        assert "f5": class_fair_market_value_1060(entity_ref("urn:test:s52:4#t"), 4, 100 USD) { origin case_input; }
        assert "f6": class_fair_market_value_1060(entity_ref("urn:test:s52:4#t"), 5, 200 USD) { origin case_input; }
        assert "f7": class_fair_market_value_1060(entity_ref("urn:test:s52:4#t"), 6, 250 USD) { origin case_input; }
    }
    evaluate truth(section_197_intangibles_value_for_755_1060d1(entity_ref("urn:test:s52:4#t"), 400 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
