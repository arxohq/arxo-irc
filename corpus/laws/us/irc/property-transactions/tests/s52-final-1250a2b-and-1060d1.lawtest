        assert "f5": full_months_held_at_disposition(entity_ref("urn:test:s52:2#a"), 120) { origin case_input; }
        assert "f6": additional_depreciation_1970_to_1975_b4(entity_ref("urn:test:s52:2#p"), entity_ref("urn:test:s52:2#a"), 60 USD) { origin case_input; }
        assert "f7": depreciation_deduction_for_rehabilitation_167k_allowed(entity_ref("urn:test:s52:2#a")) { origin case_input; }
