        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": hedging_deductions_for_year(entity_ref("urn:test:s34:76#p"), entity_ref("urn:test:s34:76#y"), 300.00 USD) { origin case_input; }
        assert "f1": hedging_income_for_year(entity_ref("urn:test:s34:76#p"), entity_ref("urn:test:s34:76#y"), 100.00 USD) { origin case_input; }
        assert "f2": hedging_property_is_stock_or_securities(entity_ref("urn:test:s34:76#p"), entity_ref("urn:test:s34:76#y")) { origin case_input; }
        assert "f3": aggregate_unrecognized_hedging_gains(entity_ref("urn:test:s34:76#p"), entity_ref("urn:test:s34:76#y"), 150.00 USD) { origin case_input; }
        assert "f4": taxable_income_attributable_to_hedged_business(entity_ref("urn:test:s34:76#p"), entity_ref("urn:test:s34:76#y"), 120.00 USD) { origin case_input; }
    }
    evaluate truth(hedging_loss_carried_to_next_year_1256e4(entity_ref("urn:test:s34:76#p"), entity_ref("urn:test:s34:76#y"), 30.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

