test "W9-PT-07-PRIOR-YEAR-INCREASED-INCOME-TAX-IS-REQUESTED-FROM-INCOME-INDIVIDUAL" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": prior_taxable_year(entity_ref("urn:test:w9pt:a4#y"), 1, entity_ref("urn:test:w9pt:a4#y1")) { origin case_input; }
        assert "f1": taxable_income_for_1301(entity_ref("urn:test:w9pt:a4#p"), entity_ref("urn:test:w9pt:a4#y1"), 40000.00 USD) { origin case_input; }
        assert "f2": elected_farm_income(entity_ref("urn:test:w9pt:a4#p"), entity_ref("urn:test:w9pt:a4#y"), 30000.00 USD) { origin case_input; }
        assert "f3": us.irc.income_individual::filing_status(entity_ref("urn:test:w9pt:a4#p"), entity_ref("urn:test:w9pt:a4#y1"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:w9pt:a4#y1"), @2023-01-01) { origin case_input; }
    }
    evaluate truth(tax_under_section_1_on(entity_ref("urn:test:w9pt:a4#p"), entity_ref("urn:test:w9pt:a4#y1"), 50000.00 USD, 6939.50 USD));
    expect truth_status == TRUE_ONLY;
}

