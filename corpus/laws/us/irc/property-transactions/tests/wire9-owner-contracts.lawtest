test "W9-PT-04-SECTION-1301-REDUCED-INCOME-TAX-IS-REQUESTED-FROM-INCOME-INDIVIDUAL" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_income_for_1301(entity_ref("urn:test:w9pt:a1#p"), entity_ref("urn:test:w9pt:a1#y"), 90000.00 USD) { origin case_input; }
        assert "f1": elected_farm_income(entity_ref("urn:test:w9pt:a1#p"), entity_ref("urn:test:w9pt:a1#y"), 30000.00 USD) { origin case_input; }
        assert "f2": us.irc.income_individual::filing_status(entity_ref("urn:test:w9pt:a1#p"), entity_ref("urn:test:w9pt:a1#y"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:w9pt:a1#y"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(tax_on_reduced_income(entity_ref("urn:test:w9pt:a1#p"), entity_ref("urn:test:w9pt:a1#y"), 9139.50 USD));
    expect truth_status == TRUE_ONLY;
}

