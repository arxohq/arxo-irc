// Property transactions WIRE-9 owner-contract scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "W9-PT-01-MARRIED-SEPARATE-FILING-STATUS-LIMITS-THE-CAPITAL-LOSS-FLOOR-TO-1500" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:w9pt:m1#p"), entity_ref("urn:test:w9pt:m1#y"), us.irc.income_individual::MarriedSeparate) { origin case_input; }
        assert "f1": capital_losses_for_year(entity_ref("urn:test:w9pt:m1#p"), entity_ref("urn:test:w9pt:m1#y"), 5000.00 USD) { origin case_input; }
        assert "f2": capital_gains_for_year(entity_ref("urn:test:w9pt:m1#p"), entity_ref("urn:test:w9pt:m1#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(capital_loss_allowed(entity_ref("urn:test:w9pt:m1#p"), entity_ref("urn:test:w9pt:m1#y"), 1500.00 USD));
    expect truth_status == TRUE_ONLY;
}

