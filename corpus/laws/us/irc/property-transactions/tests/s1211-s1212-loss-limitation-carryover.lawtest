// Sections 1211, 1212 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1211-01-LOSS-AT-3000-FLOOR-FULLY-ALLOWED" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": short_term_capital_loss(entity_ref("urn:test:s1211:f1#p"), entity_ref("urn:test:s1211:f1#y"), 3000.00 USD) { origin case_input; }
        assert "f1": long_term_capital_loss(entity_ref("urn:test:s1211:f1#p"), entity_ref("urn:test:s1211:f1#y"), 0.00 USD) { origin case_input; }
        assert "f2": short_term_capital_gain(entity_ref("urn:test:s1211:f1#p"), entity_ref("urn:test:s1211:f1#y"), 0.00 USD) { origin case_input; }
        assert "f3": long_term_capital_gain(entity_ref("urn:test:s1211:f1#p"), entity_ref("urn:test:s1211:f1#y"), 0.00 USD) { origin case_input; }
    }
    // $3,000 of loss, no gains: allowed in full, exactly at the floor.
    evaluate truth(capital_loss_allowed(entity_ref("urn:test:s1211:f1#p"), entity_ref("urn:test:s1211:f1#y"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1211-02-LOSS-AT-3001-CAPPED-AT-FLOOR" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": short_term_capital_loss(entity_ref("urn:test:s1211:f2#p"), entity_ref("urn:test:s1211:f2#y"), 3001.00 USD) { origin case_input; }
        assert "f1": long_term_capital_loss(entity_ref("urn:test:s1211:f2#p"), entity_ref("urn:test:s1211:f2#y"), 0.00 USD) { origin case_input; }
        assert "f2": short_term_capital_gain(entity_ref("urn:test:s1211:f2#p"), entity_ref("urn:test:s1211:f2#y"), 0.00 USD) { origin case_input; }
        assert "f3": long_term_capital_gain(entity_ref("urn:test:s1211:f2#p"), entity_ref("urn:test:s1211:f2#y"), 0.00 USD) { origin case_input; }
    }
    // $1 above the floor: only $3,000 allowed this year; $1 carries to next year (section 1212(b)).
    evaluate truth(capital_loss_allowed(entity_ref("urn:test:s1211:f2#p"), entity_ref("urn:test:s1211:f2#y"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1211-03-MARRIED-FILING-SEPARATELY-1500-FLOOR" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": short_term_capital_loss(entity_ref("urn:test:s1211:mfs1#p"), entity_ref("urn:test:s1211:mfs1#y"), 3000.00 USD) { origin case_input; }
        assert "f1": long_term_capital_loss(entity_ref("urn:test:s1211:mfs1#p"), entity_ref("urn:test:s1211:mfs1#y"), 0.00 USD) { origin case_input; }
        assert "f2": short_term_capital_gain(entity_ref("urn:test:s1211:mfs1#p"), entity_ref("urn:test:s1211:mfs1#y"), 0.00 USD) { origin case_input; }
        assert "f3": long_term_capital_gain(entity_ref("urn:test:s1211:mfs1#p"), entity_ref("urn:test:s1211:mfs1#y"), 0.00 USD) { origin case_input; }
        assert "f4": married_filing_separately(entity_ref("urn:test:s1211:mfs1#p"), entity_ref("urn:test:s1211:mfs1#y")) { origin case_input; }
    }
    evaluate truth(capital_loss_allowed(entity_ref("urn:test:s1211:mfs1#p"), entity_ref("urn:test:s1211:mfs1#y"), 1500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1212-01-SHORT-TERM-LOSS-CARRIES-TO-NEXT-YEAR" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": net_short_term_capital_loss(entity_ref("urn:test:s1212:c1#p"), entity_ref("urn:test:s1212:c1#y2024"), 8000.00 USD) { origin case_input; }
        assert "f1": net_long_term_capital_gain(entity_ref("urn:test:s1212:c1#p"), entity_ref("urn:test:s1212:c1#y2024"), 2000.00 USD) { origin case_input; }
        assert "f2": us.irc.core::carryover_from_year(entity_ref("urn:test:s1212:c1#carryover"), entity_ref("urn:test:s1212:c1#y2024")) { origin case_input; }
        assert "f3": us.irc.core::carryover_to_year(entity_ref("urn:test:s1212:c1#carryover"), entity_ref("urn:test:s1212:c1#y2025")) { origin case_input; }
    }
    // excess of $8,000 short-term loss over $2,000 long-term gain = $6,000 carries forward as a short-term loss, unlimited (individuals).
    evaluate truth(capital_loss_carryover(entity_ref("urn:test:s1212:c1#p"), entity_ref("urn:test:s1212:c1#y2024"), entity_ref("urn:test:s1212:c1#y2025"), ShortTerm, 6000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
