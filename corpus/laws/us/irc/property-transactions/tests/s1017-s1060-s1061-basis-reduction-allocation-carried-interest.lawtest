        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": discharge_excluded_under_108a(entity_ref("urn:test:s1017:1#p"), entity_ref("urn:test:s1017:1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": portion_applied_to_reduce_basis_108(entity_ref("urn:test:s1017:1#p"), entity_ref("urn:test:s1017:1#y"), 60000.00 USD) { origin case_input; }
    }
    evaluate truth(section_1017_basis_reduction_amount(entity_ref("urn:test:s1017:1#p"), entity_ref("urn:test:s1017:1#y"), 60000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

