test "S1271-01-RETIREMENT-RECEIPT-IS-EXCHANGE" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": retirement_receipt_by_holder(entity_ref("urn:test:s1271:1#h"), entity_ref("urn:test:s1271:1#i"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(amount_received_in_exchange_on_retirement(entity_ref("urn:test:s1271:1#h"), entity_ref("urn:test:s1271:1#i"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

