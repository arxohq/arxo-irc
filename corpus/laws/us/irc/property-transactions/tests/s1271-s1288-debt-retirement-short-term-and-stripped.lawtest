        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": strip_purchase(entity_ref("urn:test:s1271:44#h"), entity_ref("urn:test:s1271:44#item"), @2025-03-01) { origin case_input; }
        assert "f1": item_fair_market_value_on_purchase(entity_ref("urn:test:s1271:44#item"), 30000.00 USD) { origin case_input; }
        assert "f2": total_fair_market_value_of_purchased_items(entity_ref("urn:test:s1271:44#h"), @2025-03-01, 120000.00 USD) { origin case_input; }
        assert "f3": total_purchase_price_of_items(entity_ref("urn:test:s1271:44#h"), @2025-03-01, 100000.00 USD) { origin case_input; }
        assert "f4": item_stated_redemption_price_or_coupon_amount(entity_ref("urn:test:s1271:44#item"), 25000.00 USD) { origin case_input; }
    }
    evaluate truth(stripped_item_original_issue_discount(entity_ref("urn:test:s1271:44#item"), 0.00 USD));
    expect truth_status == NEITHER;
}

