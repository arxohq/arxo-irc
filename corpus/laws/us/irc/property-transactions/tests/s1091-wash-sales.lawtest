// Section 1091 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1091-01-REPURCHASE-WITHIN-30-DAYS-DISALLOWED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": loss_claimed_on_sale_of_stock_or_securities(entity_ref("urn:test:s1091:w1#t"), entity_ref("urn:test:s1091:w1#p"), entity_ref("urn:test:s1091:w1#a"), @2024-03-01, 2000.00 USD) { origin case_input; }
        assert "f1": acquired_substantially_identical_stock_or_securities(entity_ref("urn:test:s1091:w1#p"), entity_ref("urn:test:s1091:w1#a"), entity_ref("urn:test:s1091:w1#replacement"), @2024-03-15) { origin case_input; }
        assert "f2": quantity_acquired_not_less_than_quantity_sold(entity_ref("urn:test:s1091:w1#p"), entity_ref("urn:test:s1091:w1#a")) { origin case_input; }
    }
    // repurchase 14 days after sale, inside the 61-day window.
    evaluate truth(wash_sale_loss_disallowed(entity_ref("urn:test:s1091:w1#p"), entity_ref("urn:test:s1091:w1#t"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(loss_recognized(entity_ref("urn:test:s1091:w1#p"), entity_ref("urn:test:s1091:w1#t"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1091-02-REPURCHASE-AFTER-31-DAYS-NOT-DISALLOWED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": loss_claimed_on_sale_of_stock_or_securities(entity_ref("urn:test:s1091:w2#t"), entity_ref("urn:test:s1091:w2#p"), entity_ref("urn:test:s1091:w2#a"), @2024-03-01, 2000.00 USD) { origin case_input; }
        assert "f1": acquired_substantially_identical_stock_or_securities(entity_ref("urn:test:s1091:w2#p"), entity_ref("urn:test:s1091:w2#a"), entity_ref("urn:test:s1091:w2#replacement"), @2024-04-02) { origin case_input; }
        assert "f2": quantity_acquired_not_less_than_quantity_sold(entity_ref("urn:test:s1091:w2#p"), entity_ref("urn:test:s1091:w2#a")) { origin case_input; }
    }
    // repurchase 32 days after sale, outside the 30-day-after boundary: no rule fires, disallowance is UNDETERMINED (not FALSE — nothing establishes either way this stage).
    evaluate truth(wash_sale_loss_disallowed(entity_ref("urn:test:s1091:w2#p"), entity_ref("urn:test:s1091:w2#t"), 2000.00 USD));
    expect truth_status == NEITHER;
}

test "S1091-03-REPLACEMENT-BASIS-INCREASED-BY-DISALLOWED-LOSS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": loss_claimed_on_sale_of_stock_or_securities(entity_ref("urn:test:s1091:w3#t"), entity_ref("urn:test:s1091:w3#p"), entity_ref("urn:test:s1091:w3#a"), @2024-03-01, 2000.00 USD) { origin case_input; }
        assert "f1": acquired_substantially_identical_stock_or_securities(entity_ref("urn:test:s1091:w3#p"), entity_ref("urn:test:s1091:w3#a"), entity_ref("urn:test:s1091:w3#replacement"), @2024-03-15) { origin case_input; }
        assert "f2": quantity_acquired_not_less_than_quantity_sold(entity_ref("urn:test:s1091:w3#p"), entity_ref("urn:test:s1091:w3#a")) { origin case_input; }
        assert "f3": us.irc.core::adjusted_basis(entity_ref("urn:test:s1091:w3#p"), entity_ref("urn:test:s1091:w3#a"), @2024-03-01, 8000.00 USD) { origin case_input; }
        assert "f4": stock_disposition_price_1091(entity_ref("urn:test:s1091:w3#t"), 6000.00 USD) { origin case_input; }
        assert "f5": replacement_acquisition_price_1091(entity_ref("urn:test:s1091:w3#t"), entity_ref("urn:test:s1091:w3#replacement"), @2024-03-15, 5000.00 USD) { origin case_input; }
    }
    evaluate truth(wash_sale_replacement_basis(entity_ref("urn:test:s1091:w3#p"), entity_ref("urn:test:s1091:w3#t"), entity_ref("urn:test:s1091:w3#replacement"), @2024-03-15, 7000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
