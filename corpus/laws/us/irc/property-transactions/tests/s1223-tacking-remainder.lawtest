        assert "f2": disposed_to_qualified_heir_2032A_e1(entity_ref("urn:test:s45:43#p"), entity_ref("urn:test:s45:43#a"), entity_ref("urn:test:s45:43#q")) { origin case_input; }
    }
    evaluate truth(long_term(entity_ref("urn:test:s45:43#p"), entity_ref("urn:test:s45:43#a")));
    expect truth_status == NEITHER;
}

test "S1223L10-05-SOLD-ON-THE-ANNIVERSARY-STILL-COVERED" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": property_acquired_in_1040_transfer(entity_ref("urn:test:s45:44#p"), entity_ref("urn:test:s45:44#a")) { origin case_input; }
        assert "f1": decedent_died_on(entity_ref("urn:test:s45:44#q"), @2024-01-15) { origin case_input; }
        assert "f2": disposed_on(entity_ref("urn:test:s45:44#p"), entity_ref("urn:test:s45:44#a"), entity_ref("urn:test:s45:44#t"), @2025-01-15) { origin case_input; }
        assert "f3": disposed_to_qualified_heir_2032A_e1(entity_ref("urn:test:s45:44#p"), entity_ref("urn:test:s45:44#a"), entity_ref("urn:test:s45:44#q")) { origin case_input; }
    }
    evaluate truth(long_term(entity_ref("urn:test:s45:44#p"), entity_ref("urn:test:s45:44#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
