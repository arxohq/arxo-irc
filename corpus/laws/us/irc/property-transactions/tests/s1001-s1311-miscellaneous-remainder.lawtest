// Miscellaneous basis, exchange and mitigation remainder scenarios (stage 3b). NOT EXECUTED (implemented_unverified). Expectations come from the statutory text, not from engine output.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1001B-01-REIMBURSEMENT-EXCLUDED-SELLER-TAXES-INCLUDED" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": disposing_taxpayer_1001b(entity_ref("urn:test:s47:1#t"), entity_ref("urn:test:s47:1#p")) { origin case_input; }
        assert "f1": money_and_property_received_for_1001b(entity_ref("urn:test:s47:1#t"), 500000.00 USD) { origin case_input; }
        assert "f2": reimbursement_for_purchaser_real_property_taxes(entity_ref("urn:test:s47:1#t"), 3000.00 USD) { origin case_input; }
        assert "f3": seller_taxes_paid_by_purchaser(entity_ref("urn:test:s47:1#t"), 1200.00 USD) { origin case_input; }
    }
    evaluate truth(adjusted_amount_realized_1001b(entity_ref("urn:test:s47:1#p"), entity_ref("urn:test:s47:1#t"), 498200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

