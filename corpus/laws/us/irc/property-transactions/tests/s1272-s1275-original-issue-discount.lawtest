test "S1272-03-ONE-PERIOD-CONSTANT-YIELD-ACCRUAL-STEP" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": adjusted_issue_price_at_start_of_period(entity_ref("urn:test:s1272:y1#instr"), 1, 92000.00 USD) { origin case_input; }
        assert "f1": yield_to_maturity(entity_ref("urn:test:s1272:y1#instr"), 0.05) { origin case_input; }
        assert "f2": interest_payable_during_period(entity_ref("urn:test:s1272:y1#instr"), 1, 3000.00 USD) { origin case_input; }
    }
    // increase = 92000 * 0.05 - 3000 = 1600.
    evaluate truth(increase_in_adjusted_issue_price(entity_ref("urn:test:s1272:y1#instr"), 1, 1600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
