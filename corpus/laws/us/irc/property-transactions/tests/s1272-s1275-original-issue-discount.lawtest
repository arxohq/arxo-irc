// Sections 1272-1275 scenarios (stage 2b, original issue discount). NOT
// EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1273-01-OID-IS-EXCESS-OF-SRPM-OVER-ISSUE-PRICE" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s1273:o1#instr"), 100000.00 USD) { origin case_input; }
        assert "f3": price_paid_by_first_buyer(entity_ref("urn:test:s1273:o1#instr"), 92000.00 USD) { origin case_input; }
    }
    evaluate truth(issue_price(entity_ref("urn:test:s1273:o1#instr"), 92000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(original_issue_discount(entity_ref("urn:test:s1273:o1#instr"), 8000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1273-02-DE-MINIMIS-OID-TREATED-AS-ZERO" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s1273:o2#instr"), 100000.00 USD) { origin case_input; }
        assert "f3": price_paid_by_first_buyer(entity_ref("urn:test:s1273:o2#instr"), 99900.00 USD) { origin case_input; }
        assert "f4": complete_years_to_maturity(entity_ref("urn:test:s1273:o2#instr"), 5) { origin case_input; }
    }
    // OID = 100 (0.1% of 100,000); de minimis threshold = 0.25% * 5 years = 1.25% of 100,000 = 1,250. 100 < 1,250: treated as zero.
    evaluate truth(original_issue_discount_treated_as_zero(entity_ref("urn:test:s1273:o2#instr")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

