// Sections 1231, 1245, 1250 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1231-01-NET-GAIN-TREATED-AS-LONG-TERM-CAPITAL" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": section_1231_gain_transaction(entity_ref("urn:test:s1231:g1#p"), entity_ref("urn:test:s1231:g1#y"), entity_ref("urn:test:s1231:g1#t1"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(section_1231_hotchpot_gains_prevail(entity_ref("urn:test:s1231:g1#p"), entity_ref("urn:test:s1231:g1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1231-02-NET-LOSS-TREATED-AS-ORDINARY" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": section_1231_gain_transaction(entity_ref("urn:test:s1231:l1#p"), entity_ref("urn:test:s1231:l1#y"), entity_ref("urn:test:s1231:l1#t1"), 4000.00 USD) { origin case_input; }
        assert "f1": section_1231_loss_transaction(entity_ref("urn:test:s1231:l1#p"), entity_ref("urn:test:s1231:l1#y"), entity_ref("urn:test:s1231:l1#t2"), 9000.00 USD) { origin case_input; }
    }
    evaluate truth(section_1231_hotchpot_losses_prevail(entity_ref("urn:test:s1231:l1#p"), entity_ref("urn:test:s1231:l1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1231-03-RECAPTURE-CAPPED-AT-NONRECAPTURED-LOSSES" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": net_section_1231_gain(entity_ref("urn:test:s1231:r1#p"), entity_ref("urn:test:s1231:r1#y"), 10000.00 USD) { origin case_input; }
        assert "f1": non_recaptured_net_section_1231_losses(entity_ref("urn:test:s1231:r1#p"), entity_ref("urn:test:s1231:r1#y"), 6000.00 USD) { origin case_input; }
    }
    evaluate truth(section_1231_recapture_as_ordinary_income(entity_ref("urn:test:s1231:r1#p"), entity_ref("urn:test:s1231:r1#y"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1245-01-RECAPTURE-LIMITED-TO-DEPRECIATION-TAKEN" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": section_1245_disposition(entity_ref("urn:test:s1245:r1#t"), entity_ref("urn:test:s1245:r1#p"), entity_ref("urn:test:s1245:r1#a"), @2024-06-01) { origin case_input; }
        assert "f1": recomputed_basis(entity_ref("urn:test:s1245:r1#p"), entity_ref("urn:test:s1245:r1#a"), @2024-06-01, 50000.00 USD) { origin case_input; }
        assert "f2": amount_realized(entity_ref("urn:test:s1245:r1#p"), entity_ref("urn:test:s1245:r1#t"), 45000.00 USD) { origin case_input; }
        assert "f3": us.irc.core::adjusted_basis(entity_ref("urn:test:s1245:r1#p"), entity_ref("urn:test:s1245:r1#a"), @2024-06-01, 20000.00 USD) { origin case_input; }
    }
    // lower of recomputed basis ($50,000) or amount realized ($45,000) = $45,000, minus adjusted basis $20,000 = $25,000 ordinary income.
    evaluate truth(section_1245_ordinary_income_recapture(entity_ref("urn:test:s1245:r1#p"), entity_ref("urn:test:s1245:r1#t"), 25000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1245-02-GIFT-DISPOSITION-EXCEPTED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": section_1245_disposition_by_gift(entity_ref("urn:test:s1245:gift1#t")) { origin case_input; }
    }
    evaluate truth(section_1245_recapture_excepted(entity_ref("urn:test:s1245:gift1#t")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1250-01-NO-RECAPTURE-WHEN-STRAIGHT-LINE-USED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": section_1250_property(entity_ref("urn:test:s1250:sl1#a")) { origin case_input; }
        assert "f1": sale_or_disposition(entity_ref("urn:test:s1250:sl1#t"), entity_ref("urn:test:s1250:sl1#p"), entity_ref("urn:test:s1250:sl1#a"), @2024-06-01) { origin case_input; }
        assert "f2": actual_depreciation_adjustments(entity_ref("urn:test:s1250:sl1#p"), entity_ref("urn:test:s1250:sl1#a"), @2024-06-01, 30000.00 USD) { origin case_input; }
        assert "f3": straight_line_depreciation_adjustments(entity_ref("urn:test:s1250:sl1#p"), entity_ref("urn:test:s1250:sl1#a"), @2024-06-01, 30000.00 USD) { origin case_input; }
        assert "f4": long_term(entity_ref("urn:test:s1250:sl1#p"), entity_ref("urn:test:s1250:sl1#a")) { origin case_input; }
        assert "f5": amount_realized(entity_ref("urn:test:s1250:sl1#p"), entity_ref("urn:test:s1250:sl1#t"), 100000.00 USD) { origin case_input; }
        assert "f6": us.irc.core::adjusted_basis(entity_ref("urn:test:s1250:sl1#p"), entity_ref("urn:test:s1250:sl1#a"), @2024-06-01, 40000.00 USD) { origin case_input; }
    }
    // actual depreciation equals straight-line: no additional depreciation, so no section 1250 ordinary income.
    evaluate truth(section_1250_ordinary_income_recapture(entity_ref("urn:test:s1250:sl1#p"), entity_ref("urn:test:s1250:sl1#t"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1250-02-RECAPTURE-LIMITED-TO-ADDITIONAL-DEPRECIATION" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": section_1250_property(entity_ref("urn:test:s1250:ad1#a")) { origin case_input; }
        assert "f1": sale_or_disposition(entity_ref("urn:test:s1250:ad1#t"), entity_ref("urn:test:s1250:ad1#p"), entity_ref("urn:test:s1250:ad1#a"), @2024-06-01) { origin case_input; }
        assert "f2": actual_depreciation_adjustments(entity_ref("urn:test:s1250:ad1#p"), entity_ref("urn:test:s1250:ad1#a"), @2024-06-01, 50000.00 USD) { origin case_input; }
        assert "f3": straight_line_depreciation_adjustments(entity_ref("urn:test:s1250:ad1#p"), entity_ref("urn:test:s1250:ad1#a"), @2024-06-01, 30000.00 USD) { origin case_input; }
        assert "f4": long_term(entity_ref("urn:test:s1250:ad1#p"), entity_ref("urn:test:s1250:ad1#a")) { origin case_input; }
        assert "f5": amount_realized(entity_ref("urn:test:s1250:ad1#p"), entity_ref("urn:test:s1250:ad1#t"), 100000.00 USD) { origin case_input; }
        assert "f6": us.irc.core::adjusted_basis(entity_ref("urn:test:s1250:ad1#p"), entity_ref("urn:test:s1250:ad1#a"), @2024-06-01, 10000.00 USD) { origin case_input; }
    }
    // additional depreciation = 50,000 - 30,000 = 20,000; gain over basis = 100,000 - 10,000 = 90,000; lower is 20,000.
    evaluate truth(section_1250_ordinary_income_recapture(entity_ref("urn:test:s1250:ad1#p"), entity_ref("urn:test:s1250:ad1#t"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
