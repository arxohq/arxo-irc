// Section 1301 scenarios (stage 2b, farm income averaging). NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1301-01-ELECTION-VALID-FOR-FARMER" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": engaged_in_farming_or_fishing_business(entity_ref("urn:test:s1301:e1#p"), entity_ref("urn:test:s1301:e1#y")) { origin case_input; }
        assert "f1": elects_farm_income_averaging(entity_ref("urn:test:s1301:e1#p"), entity_ref("urn:test:s1301:e1#y")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1301FarmIncomeAveragingElection, VALIDLY_EXERCISED);
    evaluate truth(section_1301_election_in_effect(entity_ref("urn:test:s1301:e1#p"), entity_ref("urn:test:s1301:e1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1301-02-TAXABLE-INCOME-REDUCED-BY-ELECTED-FARM-INCOME" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": taxable_income_for_1301(entity_ref("urn:test:s1301:r1#p"), entity_ref("urn:test:s1301:r1#y"), 90000.00 USD) { origin case_input; }
        assert "f1": elected_farm_income(entity_ref("urn:test:s1301:r1#p"), entity_ref("urn:test:s1301:r1#y"), 30000.00 USD) { origin case_input; }
    }
    evaluate truth(taxable_income_reduced_by_farm_income(entity_ref("urn:test:s1301:r1#p"), entity_ref("urn:test:s1301:r1#y"), 60000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1301-03-ELECTED-FARM-INCOME-THIRD" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": elected_farm_income(entity_ref("urn:test:s1301:t1#p"), entity_ref("urn:test:s1301:t1#y"), 30000.00 USD) { origin case_input; }
    }
    evaluate truth(elected_farm_income_third(entity_ref("urn:test:s1301:t1#p"), entity_ref("urn:test:s1301:t1#y"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1301-04-FULL-3-YEAR-AVERAGING-COMPUTATION" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": section_1301_election_in_effect(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y")) { origin case_input; }
        assert "f1": taxable_income_for_1301(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y"), 90000.00 USD) { origin case_input; }
        assert "f2": elected_farm_income(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y"), 30000.00 USD) { origin case_input; }
        assert "f3": tax_under_section_1_on(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y"), 60000.00 USD, 9000.00 USD) { origin case_input; }
        assert "f4": prior_taxable_year(entity_ref("urn:test:s1301:f1#y"), 1, entity_ref("urn:test:s1301:f1#y1")) { origin case_input; }
        assert "f5": prior_taxable_year(entity_ref("urn:test:s1301:f1#y"), 2, entity_ref("urn:test:s1301:f1#y2")) { origin case_input; }
        assert "f6": prior_taxable_year(entity_ref("urn:test:s1301:f1#y"), 3, entity_ref("urn:test:s1301:f1#y3")) { origin case_input; }
        assert "f7": taxable_income_for_1301(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y1"), 40000.00 USD) { origin case_input; }
        assert "f8": taxable_income_for_1301(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y2"), 40000.00 USD) { origin case_input; }
        assert "f9": taxable_income_for_1301(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y3"), 40000.00 USD) { origin case_input; }
        assert "f10": tax_under_section_1_on(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y1"), 50000.00 USD, 7000.00 USD) { origin case_input; }
        assert "f11": tax_under_section_1_on(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y2"), 50000.00 USD, 7000.00 USD) { origin case_input; }
        assert "f12": tax_under_section_1_on(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y3"), 50000.00 USD, 7000.00 USD) { origin case_input; }
        assert "f13": actual_tax_for_prior_year(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y1"), 5000.00 USD) { origin case_input; }
        assert "f14": actual_tax_for_prior_year(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y2"), 5000.00 USD) { origin case_input; }
        assert "f15": actual_tax_for_prior_year(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y3"), 5000.00 USD) { origin case_input; }
    }
    // reduced-income tax 9000; each prior year's increase = 7000 - 5000 = 2000, times 3 = 6000; total = 15000.
    evaluate truth(tax_on_reduced_income(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y"), 9000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(increase_in_tax_for_prior_year(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y"), entity_ref("urn:test:s1301:f1#y1"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_1301_averaging_tax(entity_ref("urn:test:s1301:f1#p"), entity_ref("urn:test:s1301:f1#y"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
