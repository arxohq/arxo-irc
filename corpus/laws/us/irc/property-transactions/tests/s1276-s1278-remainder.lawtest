        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": bond_transferred_in_nonrecognition_transaction(entity_ref("urn:test:s42:39#t"), entity_ref("urn:test:s42:39#p"), entity_ref("urn:test:s42:39#q"), entity_ref("urn:test:s42:39#b")) { origin case_input; }
        assert "f1": basis_determined_under_732a_or_b(entity_ref("urn:test:s42:39#t"), entity_ref("urn:test:s42:39#b")) { origin case_input; }
        assert "f2": transferor_acquired_bond_on(entity_ref("urn:test:s42:39#p"), entity_ref("urn:test:s42:39#b"), @2022-05-01) { origin case_input; }
        assert "f3": transferor_basis_in_bond(entity_ref("urn:test:s42:39#p"), entity_ref("urn:test:s42:39#b"), 92000.00 USD) { origin case_input; }
        assert "f4": gain_recognized_by_transferor_1276c1B(entity_ref("urn:test:s42:39#t"), 1500.00 USD) { origin case_input; }
        assert "f5": oid_or_market_discount_included_by_transferor(entity_ref("urn:test:s42:39#t"), 500.00 USD) { origin case_input; }
    }
    evaluate truth(transferee_deemed_acquisition_date_1276c1A(entity_ref("urn:test:s42:39#q"), entity_ref("urn:test:s42:39#b"), @2022-05-01));
    expect truth_status == TRUE_ONLY;
