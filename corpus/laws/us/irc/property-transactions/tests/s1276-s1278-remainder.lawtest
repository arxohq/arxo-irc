test "S1276D2-01-BASIS-INCREASED-BY-ORDINARY-INCOME-RECOGNIZED" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": stated_redemption_price_at_maturity(entity_ref("urn:test:s42:52#b"), 100000.00 USD) { origin case_input; }
        assert "f1": market_discount_basis_after_acquisition(entity_ref("urn:test:s42:52#b"), 90000.00 USD) { origin case_input; }
        assert "f2": bond_held_by(entity_ref("urn:test:s42:52#b"), entity_ref("urn:test:s42:52#p")) { origin case_input; }
        assert "f3": days_held_by_taxpayer(entity_ref("urn:test:s42:52#b"), 100) { origin case_input; }
        assert "f4": days_from_acquisition_to_maturity(entity_ref("urn:test:s42:52#b"), 400) { origin case_input; }
        assert "f5": disposes_of_market_discount_bond(entity_ref("urn:test:s42:52#t"), entity_ref("urn:test:s42:52#p"), entity_ref("urn:test:s42:52#b"), @2024-06-01) { origin case_input; }
        assert "f6": gain_recognized(entity_ref("urn:test:s42:52#p"), entity_ref("urn:test:s42:52#t"), 1000.00 USD) { origin case_input; }
        assert "f7": us.irc.core::adjusted_basis(entity_ref("urn:test:s42:52#p"), entity_ref("urn:test:s42:52#b"), @2024-06-01, 90000.00 USD) { origin case_input; }
    }
    evaluate truth(basis_adjusted_for_1276a_gain_1276d2(entity_ref("urn:test:s42:52#t"), entity_ref("urn:test:s42:52#p"), entity_ref("urn:test:s42:52#b"), @2024-06-01, 91000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

