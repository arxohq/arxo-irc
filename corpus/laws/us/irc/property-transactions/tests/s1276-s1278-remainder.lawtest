test "S1278A4-01-REVISED-ISSUE-PRICE-ADDS-PRIOR-HOLDER-OID" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": price_paid_by_first_buyer(entity_ref("urn:test:s42:1#b"), 90000.00 USD) { origin case_input; }
        assert "f1": oid_includible_by_prior_holders(entity_ref("urn:test:s42:1#b"), 4000.00 USD) { origin case_input; }
    }
    evaluate truth(revised_issue_price_1278a4(entity_ref("urn:test:s42:1#b"), 94000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

