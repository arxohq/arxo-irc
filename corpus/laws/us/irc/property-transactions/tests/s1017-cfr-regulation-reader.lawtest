// Section 1017(b)(1) regulation reader (IRC-G/G4, CFR wiring 27.09.2026).
// Вывод / нет факта источника: with the regulation-determined allocation
// the property's basis reduction derives (TRUE_ONLY); without it nothing
// derives (NEITHER). Expectations come from the statutory text.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1017-CFR-01-REGULATION-PROPERTIES-DERIVE" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": regulation_determines_reduction_properties_1017b1(entity_ref("urn:test:s1017cfr:1#p"), entity_ref("urn:test:s1017cfr:1#y"), entity_ref("urn:test:s1017cfr:1#a")) { origin case_input; }
    }
    evaluate truth(property_basis_reduced_under_regulation_1017b1(entity_ref("urn:test:s1017cfr:1#p"), entity_ref("urn:test:s1017cfr:1#y"), entity_ref("urn:test:s1017cfr:1#a")));
    expect truth_status == TRUE_ONLY;
}

test "S1017-CFR-02-WITHOUT-REGULATION-NEITHER" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(property_basis_reduced_under_regulation_1017b1(entity_ref("urn:test:s1017cfr:2#p"), entity_ref("urn:test:s1017cfr:2#y"), entity_ref("urn:test:s1017cfr:2#a")));
    expect truth_status == NEITHER;
}
