// Yield-method elections, section 1283(c), required accrual period, tax-exempt strips (sections 1271, 1281-1283, 1286, 1288) scenarios (stage 3). NOT EXECUTED (implemented_unverified). Expectations come from the statutory text, not from engine output.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

test "S1271A3E-01-YIELD-ELECTION-POWER-VALIDLY-EXERCISED-FOR-GOVERNMENT-OBLIGATION" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": obligation_of_us_possession_state_or_dc(entity_ref("urn:test:s30:1#i")) { origin case_input; }
        assert "f1": instrument_fixed_maturity_within_one_year_of_issue(entity_ref("urn:test:s30:1#i")) { origin case_input; }
        assert "f2": elects_yield_method_acquisition_discount(entity_ref("urn:test:s30:1#h"), entity_ref("urn:test:s30:1#i")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1271a3EYieldElection, VALIDLY_EXERCISED);
}

