// Stage 2c (IRC-07, A05). Ordinary-income recapture and character rules of
// part IV of subchapter P not reached earlier: §1252 (farm land, §175
// deductions), §1254 (oil, gas, geothermal and mineral property), §1255
// (§126 payments), §1257 (converted wetland and highly erodible cropland),
// §1258 (conversion transactions), §1236 (dealers in securities), §1237
// (subdivided real property), §1241 (lease cancellations), §§1242-1243 (small
// business investment company losses), §1249 (patents sold to controlled
// foreign corporations); plus the short basis and stock provisions §§1013,
// 1019, 1021, 1032, 1053, 1054.
//
// Modelling notes.
//  * §1258(b)(1): the imputed interest at 120 percent of the applicable rate
//    uses the AFR under §1274(d) and, for an indefinite term, §6621(b) short-
//    term rates compounded daily; the AFR tables are not pinned (TECH-GAPS
//    G289) so the interest amount is case-supplied (G2332).
//  * §1236(d) (floor specialists): the 7th business day of an exchange
//    calendar is not modelled (G2333).

// =============================================================================
// §1252: recapture of soil and water conservation deductions on farm land
// =============================================================================

use self::{
    Asset,
    IRC_S1013,
    IRC_S1019,
    IRC_S1021,
    IRC_S1032_A,
    IRC_S1053,
    IRC_S1054,
    IRC_S1236_A,
    IRC_S1236_B,
    IRC_S1236_E,
    IRC_S1237_A,
    IRC_S1237_B,
    IRC_S1241,
    IRC_S1242,
    IRC_S1243,
    IRC_S1249_A,
    IRC_S1252_A,
    IRC_S1252_TABLE_1,
    IRC_S1254_A,
    IRC_S1255_A,
    IRC_S1257_A,
    IRC_S1257_B,
    IRC_S1257_C,
    IRC_S1258_A,
    IRC_S1258_B,
    IRC_S1258_C,
    IRC_S1258_D,
    Person,
    Transaction,
    gain_recognized,
    loss_recognized,
    nonrecognition_exception_applies,
};

pub relation farm_land_disposal(t: Transaction, p: Person, land: Asset, disposed_on: Date) kind empirical {
    label en official "section 1252(a)(1): farm land is disposed of";
}
pub relation land_acquired_on_1252(p: Person, land: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer acquired the land";
}
pub relation section_175_deductions_for_land(p: Person, land: Asset, amount: Money) kind empirical {
    label en official "section 1252(a)(1)(A): the aggregate of the deductions allowed under section 175 for expenditures made by the taxpayer with respect to the farm land";
}
pub relation value_on_disposition_1252(t: Transaction, amount: Money) kind empirical {
    label en official "section 1252(a)(1)(B)(i): the amount realized (sale, exchange, involuntary conversion) or the fair market value (any other disposition)";
}
pub relation adjusted_basis_of_land_1252(t: Transaction, amount: Money) kind empirical {
    label en official "section 1252(a)(1)(B)(ii): the adjusted basis of the land";
}
pub relation farm_land_1252(p: Person, land: Asset) kind institutional {
    label en official "section 1252(a)(2): land with respect to which deductions have been allowed under section 175";
}
@source(IRC_S1252_A, relation = formalizes, coverage = exact, quote = "the term \"farm land\" means any land with respect to which deductions have been allowed under section 175")
rule FarmLandRule(p: Person, land: Asset, amount: Money) defeasible {
    label en official "section 1252(a)(2)";
    when section_175_deductions_for_land(p, land, amount);
    when amount > 0.00 USD;
    then farm_land_1252(p, land);
}
pub relation section_1252_applicable_percentage(t: Transaction, rate: Decimal) kind institutional {
    label en official "section 1252(a)(3): the applicable percentage by the time the farm land was held (100 / 80 / 60 / 40 / 20 / 0 percent)";
}
@source(IRC_S1252_TABLE_1, relation = formalizes, coverage = partial, quote = "Within 5 years after the date it was acquired / 100 percent.")
rule Percentage100Rule(t: Transaction, p: Person, land: Asset, disposed: Date, acquired: Date) defeasible {
    label en official "section 1252(a)(3): disposed of within 5 years after acquisition";
    when farm_land_disposal(t, p, land, disposed);
    when land_acquired_on_1252(p, land, acquired);
    when disposed <= add_calendar_period(acquired, 5 calendar_year);
    then section_1252_applicable_percentage(t, 1.00);
}
@source(IRC_S1252_TABLE_1, relation = formalizes, coverage = partial, quote = "Within the sixth year after it was acquired / 80 percent.")
rule Percentage80Rule(t: Transaction, p: Person, land: Asset, disposed: Date, acquired: Date) defeasible {
    label en official "section 1252(a)(3): within the sixth year";
    when farm_land_disposal(t, p, land, disposed);
    when land_acquired_on_1252(p, land, acquired);
    when disposed > add_calendar_period(acquired, 5 calendar_year);
    when disposed <= add_calendar_period(acquired, 6 calendar_year);
    then section_1252_applicable_percentage(t, 0.80);
}
@source(IRC_S1252_TABLE_1, relation = formalizes, coverage = partial, quote = "Within the seventh year after it was acquired / 60 percent.")
rule Percentage60Rule(t: Transaction, p: Person, land: Asset, disposed: Date, acquired: Date) defeasible {
    label en official "section 1252(a)(3): within the seventh year";
    when farm_land_disposal(t, p, land, disposed);
    when land_acquired_on_1252(p, land, acquired);
    when disposed > add_calendar_period(acquired, 6 calendar_year);
    when disposed <= add_calendar_period(acquired, 7 calendar_year);
    then section_1252_applicable_percentage(t, 0.60);
}
@source(IRC_S1252_TABLE_1, relation = formalizes, coverage = partial, quote = "Within the eighth year after it was acquired / 40 percent.")
rule Percentage40Rule(t: Transaction, p: Person, land: Asset, disposed: Date, acquired: Date) defeasible {
    label en official "section 1252(a)(3): within the eighth year";
    when farm_land_disposal(t, p, land, disposed);
    when land_acquired_on_1252(p, land, acquired);
    when disposed > add_calendar_period(acquired, 7 calendar_year);
    when disposed <= add_calendar_period(acquired, 8 calendar_year);
    then section_1252_applicable_percentage(t, 0.40);
}
@source(IRC_S1252_TABLE_1, relation = formalizes, coverage = partial, quote = "Within the ninth year after it was acquired / 20 percent.")
rule Percentage20Rule(t: Transaction, p: Person, land: Asset, disposed: Date, acquired: Date) defeasible {
    label en official "section 1252(a)(3): within the ninth year";
    when farm_land_disposal(t, p, land, disposed);
    when land_acquired_on_1252(p, land, acquired);
    when disposed > add_calendar_period(acquired, 8 calendar_year);
    when disposed <= add_calendar_period(acquired, 9 calendar_year);
    then section_1252_applicable_percentage(t, 0.20);
}
pub relation section_1252_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1252(a)(1): the lower of the applicable percentage of the section 175 deductions and the gain, treated as ordinary income";
}
@source(IRC_S1252_A, relation = formalizes, coverage = partial, quote = "the lower of—")
rule Section1252OrdinaryIncomeRule(t: Transaction, p: Person, land: Asset, disposed: Date, acquired: Date, rate: Decimal, deductions: Money, value: Money, basis: Money) defeasible {
    label en official "section 1252(a)(1): min(percentage x deductions, value - basis), for farm land held less than 10 years; the amount is recognized notwithstanding any other provision (cents HALF_UP: JUDGMENT CALL)";
    when farm_land_disposal(t, p, land, disposed);
    when land_acquired_on_1252(p, land, acquired);
    when disposed < add_calendar_period(acquired, 10 calendar_year);
    when farm_land_1252(p, land);
    when section_175_deductions_for_land(p, land, deductions);
    when section_1252_applicable_percentage(t, rate);
    when value_on_disposition_1252(t, value);
    when adjusted_basis_of_land_1252(t, basis);
    when value > basis;
    then section_1252_ordinary_income(t, min(round(deductions * rate, 2, "HALF_UP"), value - basis));
}
rule Section1252NoGainRule(t: Transaction, p: Person, land: Asset, disposed: Date, acquired: Date, value: Money, basis: Money) defeasible {
    label en official "section 1252(a)(1)(B): no excess, no ordinary income";
    when farm_land_disposal(t, p, land, disposed);
    when land_acquired_on_1252(p, land, acquired);
    when disposed < add_calendar_period(acquired, 10 calendar_year);
    when value_on_disposition_1252(t, value);
    when adjusted_basis_of_land_1252(t, basis);
    when value <= basis;
    then section_1252_ordinary_income(t, 0.00 USD);
}

// =============================================================================
// §1254: oil, gas, geothermal and mineral property
// =============================================================================

pub relation section_1254_property_disposed(t: Transaction, p: Person, prop: Asset) kind empirical {
    label en official "section 1254(a)(1): section 1254 property is disposed of";
}
pub relation expenditures_deducted_under_263_616_617(t: Transaction, amount: Money) kind empirical {
    label en official "section 1254(a)(1)(A)(i): expenditures deducted under section 263, 616 or 617 which but for the deduction would have been included in the adjusted basis";
}
pub relation depletion_deductions_reducing_basis(t: Transaction, amount: Money) kind empirical {
    label en official "section 1254(a)(1)(A)(ii): the deductions for depletion under section 611 which reduced the adjusted basis";
}
pub relation amounts_included_under_617b1A(t: Transaction, amount: Money) kind empirical {
    label en official "section 1254(a)(4): amounts included in gross income under section 617(b)(1)(A), by which the expenditures are adjusted";
}
pub relation value_on_disposition_1254(t: Transaction, amount: Money) kind empirical {
    label en official "section 1254(a)(1)(B)(i): the amount realized (sale, exchange, involuntary conversion) or the fair market value (other disposition)";
}
pub relation adjusted_basis_1254(t: Transaction, amount: Money) kind empirical {
    label en official "section 1254(a)(1)(B)(ii): the adjusted basis of the property";
}
pub relation expenditures_chargeable_or_depletion_in_basis(prop: Asset) kind empirical {
    label en official "section 1254(a)(3): expenditures described in (a)(1)(A) are properly chargeable to the property, or its adjusted basis includes depletion adjustments";
}
pub relation section_1254_property(prop: Asset) kind institutional {
    label en official "section 1254(a)(3): section 1254 property (property within section 614 with such expenditures or depletion)";
}
@source(IRC_S1254_A, relation = formalizes, coverage = partial, quote = "The term \"section 1254 property\" means any property (within the meaning of section 614) if—")
rule Section1254PropertyRule(prop: Asset) defeasible {
    label en official "section 1254(a)(3)(A)-(B)";
    when expenditures_chargeable_or_depletion_in_basis(prop);
    then section_1254_property(prop);
}
pub relation section_1254_recapture_base(t: Transaction, amount: Money) kind institutional {
    label en official "section 1254(a)(1)(A): the aggregate of the deducted expenditures (adjusted under (a)(4)) and the depletion deductions";
}
@source(IRC_S1254_A, relation = formalizes, coverage = partial, quote = "The amount of the expenditures referred to in paragraph (1)(A)(i) shall be properly adjusted for amounts included in gross income under section 617(b)(1)(A).")
rule Section1254RecaptureBaseRule(t: Transaction, exp: Money, inc: Money, depletion: Money) defeasible {
    label en official "section 1254(a)(1)(A), (a)(4): expenditures less the section 617(b)(1)(A) inclusions, plus depletion";
    when expenditures_deducted_under_263_616_617(t, exp);
    when amounts_included_under_617b1A(t, inc);
    when depletion_deductions_reducing_basis(t, depletion);
    then section_1254_recapture_base(t, exp - inc + depletion);
}
pub relation section_1254_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1254(a)(1): the lesser of the recapture base and the excess of value over adjusted basis is ordinary income";
}
@source(IRC_S1254_A, relation = formalizes, coverage = partial, quote = "shall be treated as gain which is ordinary income. Such gain shall be recognized notwithstanding any other provision of this subtitle.")
rule Section1254OrdinaryIncomeRule(t: Transaction, p: Person, prop: Asset, base: Money, value: Money, basis: Money) defeasible {
    label en official "section 1254(a)(1): min(base, value - basis) when positive";
    when section_1254_property_disposed(t, p, prop);
    when section_1254_property(prop);
    when section_1254_recapture_base(t, base);
    when value_on_disposition_1254(t, value);
    when adjusted_basis_1254(t, basis);
    when value > basis;
    then section_1254_ordinary_income(t, min(base, value - basis));
}
rule Section1254NoGainRule(t: Transaction, p: Person, prop: Asset, value: Money, basis: Money) defeasible {
    label en official "section 1254(a)(1)(B): no excess, no recapture";
    when section_1254_property_disposed(t, p, prop);
    when section_1254_property(prop);
    when value_on_disposition_1254(t, value);
    when adjusted_basis_1254(t, basis);
    when value <= basis;
    then section_1254_ordinary_income(t, 0.00 USD);
}
pub relation disposition_of_portion_other_than_undivided_interest(t: Transaction) kind empirical {
    label en official "section 1254(a)(2)(A): the disposition of a portion of section 1254 property (other than an undivided interest)";
}
pub relation disposition_of_undivided_interest_share(t: Transaction, share: Decimal) kind empirical {
    label en official "section 1254(a)(2)(B): the share of the property represented by the undivided interest disposed of";
}
external judgment relation expenditures_do_not_relate_to_disposed_portion_per_secretary(t: Transaction) {
    authority Secretary;
    label en official "the taxpayer establishes to the satisfaction of the Secretary that the expenditures do not relate to the portion (or interest) disposed of (section 1254(a)(2), last paragraph)";
}
pub relation section_1254_allocable_base(t: Transaction, amount: Money) kind institutional {
    label en official "section 1254(a)(2): the expenditures or deductions treated as allocable to the portion or undivided interest disposed of";
}
@source(IRC_S1254_A, relation = formalizes, coverage = partial, quote = "the entire amount of the aggregate expenditures or deductions described in paragraph (1)(A) with respect to such property shall be treated as allocable to such portion")
rule Section1254PortionAllocationRule(t: Transaction, base: Money) defeasible {
    label en official "section 1254(a)(2)(A): the entire aggregate is allocable to a portion other than an undivided interest";
    when section_1254_recapture_base(t, base);
    when disposition_of_portion_other_than_undivided_interest(t);
    when not_known(expenditures_do_not_relate_to_disposed_portion_per_secretary(t));
    then section_1254_allocable_base(t, base);
}
@source(IRC_S1254_A, relation = formalizes, coverage = partial, quote = "a proportionate part of the expenditures or deductions described in paragraph (1)(A) with respect to such property shall be treated as allocable to such undivided interest")
rule Section1254UndividedInterestAllocationRule(t: Transaction, base: Money, share: Decimal) defeasible {
    label en official "section 1254(a)(2)(B): a proportionate part (cents HALF_UP: JUDGMENT CALL)";
    when section_1254_recapture_base(t, base);
    when disposition_of_undivided_interest_share(t, share);
    when not_known(expenditures_do_not_relate_to_disposed_portion_per_secretary(t));
    then section_1254_allocable_base(t, round(base * share, 2, "HALF_UP"));
}

// =============================================================================
// §1255: recapture of §126 payments
// =============================================================================

pub relation section_126_property_disposal(t: Transaction, p: Person, prop: Asset, disposed_on: Date) kind empirical {
    label en official "section 1255(a)(1): section 126 property is disposed of";
}
pub relation section_126_payments_received_on(prop: Asset, on: Date) kind empirical {
    label en official "the date of receipt of the payments excluded from gross income under section 126";
}
pub relation section_126_payments_excluded(prop: Asset, amount: Money) kind empirical {
    label en official "section 1255(a)(1)(A): the aggregate payments with respect to the property excluded from gross income under section 126";
}
pub relation value_on_disposition_1255(t: Transaction, amount: Money) kind empirical {
    label en official "section 1255(a)(1)(B)(i): the amount realized or fair market value";
}
pub relation adjusted_basis_1255(t: Transaction, amount: Money) kind empirical {
    label en official "section 1255(a)(1)(B)(ii): the adjusted basis of the property";
}
pub relation section_1255_years_beyond_ten(t: Transaction, k: Integer) kind institutional {
    label en official "section 1255(a)(3): the number of years or parts thereof in excess of 10 years the property was held after receipt of the payments";
}
@source(IRC_S1255_A, relation = formalizes, coverage = partial, quote = "reduced (but not below zero) by 10 percent for each year or part thereof in excess of 10 years such property was held after the date of receipt of the payments.")
rule YearsBeyondTen1Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): more than 10 years and not more than 11: one year or part";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 10 calendar_year);
    when disposed <= add_calendar_period(received, 11 calendar_year);
    then section_1255_years_beyond_ten(t, 1);
}
rule YearsBeyondTen2Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): 11 to 12 years";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 11 calendar_year);
    when disposed <= add_calendar_period(received, 12 calendar_year);
    then section_1255_years_beyond_ten(t, 2);
}
rule YearsBeyondTen3Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): 12 to 13 years";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 12 calendar_year);
    when disposed <= add_calendar_period(received, 13 calendar_year);
    then section_1255_years_beyond_ten(t, 3);
}
rule YearsBeyondTen4Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): more than 13 and not more than 14 years after receipt";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 13 calendar_year);
    when disposed <= add_calendar_period(received, 14 calendar_year);
    then section_1255_years_beyond_ten(t, 4);
}
rule YearsBeyondTen5Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): more than 14 and not more than 15 years after receipt";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 14 calendar_year);
    when disposed <= add_calendar_period(received, 15 calendar_year);
    then section_1255_years_beyond_ten(t, 5);
}
rule YearsBeyondTen6Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): more than 15 and not more than 16 years after receipt";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 15 calendar_year);
    when disposed <= add_calendar_period(received, 16 calendar_year);
    then section_1255_years_beyond_ten(t, 6);
}
rule YearsBeyondTen7Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): more than 16 and not more than 17 years after receipt";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 16 calendar_year);
    when disposed <= add_calendar_period(received, 17 calendar_year);
    then section_1255_years_beyond_ten(t, 7);
}
rule YearsBeyondTen8Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): more than 17 and not more than 18 years after receipt";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 17 calendar_year);
    when disposed <= add_calendar_period(received, 18 calendar_year);
    then section_1255_years_beyond_ten(t, 8);
}
rule YearsBeyondTen9Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): more than 18 and not more than 19 years after receipt";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 18 calendar_year);
    when disposed <= add_calendar_period(received, 19 calendar_year);
    then section_1255_years_beyond_ten(t, 9);
}
rule YearsBeyondTen10OrMoreRule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): more than 19 years after receipt: the percentage is not below zero (ten or more years or parts)";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed > add_calendar_period(received, 19 calendar_year);
    then section_1255_years_beyond_ten(t, 10);
}
pub relation section_1255_applicable_percentage(t: Transaction, rate: Decimal) kind institutional {
    label en official "section 1255(a)(3): 100 percent within 10 years, reduced by 10 percent for each year or part in excess of 10 years";
}
@source(IRC_S1255_A, relation = formalizes, coverage = partial, quote = "the applicable percentage is 100 percent.")
rule Section1255Percentage100Rule(t: Transaction, p: Person, prop: Asset, disposed: Date, received: Date) defeasible {
    label en official "section 1255(a)(3): disposed of not more than 10 years after receipt (exactly 10 years is INTERPRETATION: the text names less than and more than 10 years)";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_received_on(prop, received);
    when disposed <= add_calendar_period(received, 10 calendar_year);
    then section_1255_applicable_percentage(t, 1.00);
}
rule Section1255PercentageReducedRule(t: Transaction, k: Integer) defeasible {
    label en official "section 1255(a)(3): 100 percent less 10 percent per year or part beyond 10 years";
    when section_1255_years_beyond_ten(t, k);
    when k < 10;
    then section_1255_applicable_percentage(t, 1.00 - 0.10 * k);
}
rule Section1255PercentageZeroRule(t: Transaction, k: Integer) defeasible {
    label en official "section 1255(a)(3): not below zero";
    when section_1255_years_beyond_ten(t, k);
    when k >= 10;
    then section_1255_applicable_percentage(t, 0.00);
}
pub relation section_1255_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1255(a)(1): the lower of the applicable percentage of the excluded payments and the excess of value over basis is ordinary income";
}
@source(IRC_S1255_A, relation = formalizes, coverage = partial, quote = "shall be treated as ordinary income. Such gain shall be recognized notwithstanding any other provision of this subtitle")
rule Section1255OrdinaryIncomeRule(t: Transaction, p: Person, prop: Asset, disposed: Date, rate: Decimal, payments: Money, value: Money, basis: Money) defeasible {
    label en official "section 1255(a)(1): min(percentage x payments, value - basis) when positive (cents HALF_UP: JUDGMENT CALL)";
    when section_126_property_disposal(t, p, prop, disposed);
    when section_126_payments_excluded(prop, payments);
    when section_1255_applicable_percentage(t, rate);
    when value_on_disposition_1255(t, value);
    when adjusted_basis_1255(t, basis);
    when value > basis;
    then section_1255_ordinary_income(t, min(round(payments * rate, 2, "HALF_UP"), value - basis));
}

// =============================================================================
// §1257: converted wetland and highly erodible cropland
// =============================================================================

pub relation land_converted_wetland(land: Asset) kind empirical {
    label en official "section 1257(c)(1): converted wetland as defined in section 1201(a)(7) of the Food Security Act of 1985 (16 U.S.C. 3801(7)); external norm asserted";
}
pub relation converted_wetland_held_by_converter_or_farmer(p: Person, land: Asset) kind empirical {
    label en official "section 1257(c)(1)(A)-(B): held by the person whose activities converted it, or by any other person who at any time used it for farming purposes";
}
pub relation land_highly_erodible_cropland(land: Asset) kind empirical {
    label en official "section 1257(c)(2): highly erodible cropland as defined in section 1201(a)(10) of the Food Security Act (16 U.S.C. 3801(10)); external norm asserted";
}
pub relation taxpayer_used_land_for_farming_other_than_grazing(p: Person, land: Asset) kind empirical {
    label en official "section 1257(c)(2): at any time the taxpayer used the land for farming purposes (other than grazing of animals)";
}
pub relation basis_determined_by_reference_to_prior_holder_of_status_land(p: Person, land: Asset, prior: Person) kind empirical {
    label en official "section 1257(c)(3): the person's adjusted basis in the land is determined in whole or in part by reference to its basis in another person's hands";
}
pub relation prior_holder_land_is_converted_wetland_or_cropland(prior: Person, land: Asset) kind empirical {
    label en official "section 1257(c)(3): the land is converted wetland or highly erodible cropland in the hands of the prior holder";
}
pub relation converted_wetland_or_cropland_1257(p: Person, land: Asset) kind institutional {
    label en official "section 1257(c): converted wetland or highly erodible cropland in the person's hands";
}
@source(IRC_S1257_C, relation = formalizes, coverage = partial, quote = "The term \"converted wetland\" means any converted wetland (as defined in section 1201(a)(7) of the Food Security Act of 1985 (16 U.S.C. 3801(7))) held—")
rule ConvertedWetlandRule(p: Person, land: Asset) defeasible {
    label en official "section 1257(c)(1)";
    when land_converted_wetland(land);
    when converted_wetland_held_by_converter_or_farmer(p, land);
    then converted_wetland_or_cropland_1257(p, land);
}
@source(IRC_S1257_C, relation = formalizes, coverage = partial, quote = "if at any time the taxpayer used such land for farming purposes (other than the grazing of animals).")
rule HighlyErodibleCroplandRule(p: Person, land: Asset) defeasible {
    label en official "section 1257(c)(2)";
    when land_highly_erodible_cropland(land);
    when taxpayer_used_land_for_farming_other_than_grazing(p, land);
    then converted_wetland_or_cropland_1257(p, land);
}
@source(IRC_S1257_C, relation = formalizes, coverage = partial, quote = "If any land is converted wetland or highly erodible cropland in the hands of any person, such land shall be treated as converted wetland or highly erodible cropland in the hands of any other person whose adjusted basis in such land is determined (in whole or in part) by reference to the adjusted basis of such land in the hands of such person.")
rule StatusFollowsDerivedBasisRule(p: Person, land: Asset, prior: Person) defeasible {
    label en official "section 1257(c)(3): the status carries to a person with a derived basis";
    when basis_determined_by_reference_to_prior_holder_of_status_land(p, land, prior);
    when prior_holder_land_is_converted_wetland_or_cropland(prior, land);
    then converted_wetland_or_cropland_1257(p, land);
}
pub relation disposition_of_status_land(t: Transaction, p: Person, land: Asset) kind empirical {
    label en official "section 1257(a)-(b): a disposition of converted wetland or highly erodible cropland";
}
pub relation gain_on_status_land(t: Transaction, amount: Money) kind empirical {
    label en official "section 1257(a): the gain on the disposition";
}
pub relation loss_on_status_land(t: Transaction, amount: Money) kind empirical {
    label en official "section 1257(b): the loss recognized on the disposition";
}
pub relation gain_recognized_as_ordinary_under_other_provision(t: Transaction) kind empirical {
    label en official "section 1257(a): the gain is recognized as ordinary income under another provision of part IV (the section does not apply to that extent)";
}
pub relation section_1257_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1257(a): the gain on disposition is ordinary income";
}
pub relation section_1257_long_term_capital_loss(t: Transaction, amount: Money) kind institutional {
    label en official "section 1257(b): the loss on disposition is a long-term capital loss";
}
@source(IRC_S1257_A, relation = formalizes, coverage = partial, quote = "Any gain on the disposition of converted wetland or highly erodible cropland shall be treated as ordinary income.")
rule Section1257GainOrdinaryRule(t: Transaction, p: Person, land: Asset, gain: Money) defeasible {
    label en official "section 1257(a)";
    when disposition_of_status_land(t, p, land);
    when converted_wetland_or_cropland_1257(p, land);
    when gain_on_status_land(t, gain);
    when not_known(gain_recognized_as_ordinary_under_other_provision(t));
    then section_1257_ordinary_income(t, gain);
}
@source(IRC_S1257_B, relation = formalizes, coverage = exact, quote = "Any loss recognized on the disposition of converted wetland or highly erodible cropland shall be treated as a long-term capital loss.")
rule Section1257LossLongTermRule(t: Transaction, p: Person, land: Asset, loss: Money) defeasible {
    label en official "section 1257(b)";
    when disposition_of_status_land(t, p, land);
    when converted_wetland_or_cropland_1257(p, land);
    when loss_on_status_land(t, loss);
    then section_1257_long_term_capital_loss(t, loss);
}

// =============================================================================
// §1258: conversion transactions
// =============================================================================

pub relation gain_on_conversion_transaction_position(t: Transaction, p: Person, amount: Money) kind empirical {
    label en official "section 1258(a)(2): gain recognized on the disposition or other termination of a position held as part of a conversion transaction";
}
pub relation gain_would_be_capital_gain_1258(t: Transaction) kind empirical {
    label en official "section 1258(a)(1): the gain would (but for this section) be treated as gain from the sale or exchange of a capital asset";
}
pub relation expected_return_substantially_all_time_value(t: Transaction) kind empirical {
    label en official "section 1258(c)(1): substantially all of the taxpayer's expected return is attributable to the time value of the net investment";
}
pub relation holds_property_and_contracts_to_sell_contemporaneously(t: Transaction) kind empirical {
    label en official "section 1258(c)(2)(A): holds property and enters into a contract to sell it (or substantially identical property) at a contract price, the property acquired and the contract entered on a substantially contemporaneous basis";
}
pub relation applicable_straddle_1258(t: Transaction) kind empirical {
    label en official "section 1258(c)(2)(B), (d)(1): an applicable straddle: any straddle within section 1092(c) (module 17: straddle_1092)";
}
pub relation marketed_as_producing_capital_gains_from_time_value_transaction(t: Transaction) kind empirical {
    label en official "section 1258(c)(2)(C): any other transaction marketed or sold as producing capital gains from a transaction described in (c)(1)";
}
pub relation transaction_specified_in_regulations_1258(t: Transaction) kind empirical {
    label en official "section 1258(c)(2)(D): any other transaction specified in regulations (EXTERNAL_DEPENDENCY)";
}
pub relation conversion_transaction(t: Transaction) kind institutional {
    label en official "section 1258(c): a conversion transaction";
}
@source(IRC_S1258_C, relation = formalizes, coverage = partial, quote = "(1) substantially all of the taxpayer's expected return from which is attributable to the time value of the taxpayer's net investment in such transaction, and")
rule ConversionTransactionForwardRule(t: Transaction) defeasible {
    label en official "section 1258(c)(1), (2)(A)";
    when expected_return_substantially_all_time_value(t);
    when holds_property_and_contracts_to_sell_contemporaneously(t);
    then conversion_transaction(t);
}
@source(IRC_S1258_C, relation = formalizes, coverage = partial, quote = "(B) an applicable straddle,")
rule ConversionTransactionStraddleRule(t: Transaction) defeasible {
    label en official "section 1258(c)(1), (2)(B)";
    when expected_return_substantially_all_time_value(t);
    when applicable_straddle_1258(t);
    then conversion_transaction(t);
}
@source(IRC_S1258_C, relation = formalizes, coverage = partial, quote = "(C) any other transaction which is marketed or sold as producing capital gains from a transaction described in paragraph (1), or")
rule ConversionTransactionMarketedRule(t: Transaction) defeasible {
    label en official "section 1258(c)(1), (2)(C)";
    when expected_return_substantially_all_time_value(t);
    when marketed_as_producing_capital_gains_from_time_value_transaction(t);
    then conversion_transaction(t);
}
rule ConversionTransactionRegulatoryRule(t: Transaction) defeasible {
    label en official "section 1258(c)(1), (2)(D)";
    when expected_return_substantially_all_time_value(t);
    when transaction_specified_in_regulations_1258(t);
    then conversion_transaction(t);
}
pub relation options_dealer_or_commodities_trader_in_normal_course(t: Transaction) kind empirical {
    label en official "section 1258(d)(5)(A): a transaction of an options dealer in the normal course of dealing in options, or of a commodities trader in the normal course of trading section 1256 contracts";
}
pub relation limited_partner_gain_with_time_value_or_marketed_return(t: Transaction) kind empirical {
    label en official "section 1258(d)(5)(C): gain allocable to a limited partner or limited entrepreneur where (i) substantially all expected return is time value, (ii) marketed as producing capital gains, or (iii) specified in regulations — the dealer/trader exception does not apply";
}
pub relation imputed_interest_at_120_percent_of_applicable_rate(t: Transaction, amount: Money) kind empirical {
    label en official "section 1258(b)(1): the interest which would have accrued on the net investment for the period ending on the disposition (or, if earlier, the date the (c) requirements ceased) at 120 percent of the applicable rate (case-supplied: AFR not pinned, G2332)";
}
pub relation prior_ordinary_income_from_conversion_transaction(t: Transaction, amount: Money) kind empirical {
    label en official "section 1258(b)(2): the amount treated as ordinary income under subsection (a) with respect to any prior disposition of a position held as part of the transaction";
}
pub relation applicable_imputed_income_amount(t: Transaction, amount: Money) kind institutional {
    label en official "section 1258(b): the applicable imputed income amount: imputed interest reduced by the prior ordinary income amounts";
}
@source(IRC_S1258_B, relation = formalizes, coverage = partial, quote = "For purposes of subsection (a), the term \"applicable imputed income amount\" means, with respect to any disposition or other termination referred to in subsection (a), an amount equal to—")
rule ApplicableImputedIncomeAmountRule(t: Transaction, interest: Money, prior: Money) defeasible {
    label en official "section 1258(b)(1) reduced by (b)(2) (stage 3 fix: stage 2c added the prior amount instead of subtracting it); not below zero (JUDGMENT CALL); reductions by regulation (capitalized interest, ordinary income received) are EXTERNAL_DEPENDENCY";
    when imputed_interest_at_120_percent_of_applicable_rate(t, interest);
    when prior_ordinary_income_from_conversion_transaction(t, prior);
    when interest > prior;
    then applicable_imputed_income_amount(t, interest - prior);
}
rule ApplicableImputedIncomeAmountExhaustedRule(t: Transaction, interest: Money, prior: Money) defeasible {
    label en official "section 1258(b): the prior ordinary income exhausts the imputed interest, so the applicable imputed income amount is zero (JUDGMENT CALL: text says reduced by, silent below zero)";
    when imputed_interest_at_120_percent_of_applicable_rate(t, interest);
    when prior_ordinary_income_from_conversion_transaction(t, prior);
    when interest <= prior;
    then applicable_imputed_income_amount(t, 0.00 USD);
}
pub relation section_1258_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1258(a): the gain, to the extent it does not exceed the applicable imputed income amount, is ordinary income";
}
@source(IRC_S1258_A, relation = formalizes, coverage = partial, quote = "such gain (to the extent such gain does not exceed the applicable imputed income amount) shall be treated as ordinary income.")
rule Section1258OrdinaryIncomeRule(t: Transaction, p: Person, gain: Money, imputed: Money) defeasible {
    label en official "section 1258(a): min(gain, applicable imputed income amount), unless the (d)(5) exception applies";
    when conversion_transaction(t);
    when gain_on_conversion_transaction_position(t, p, gain);
    when gain_would_be_capital_gain_1258(t);
    when applicable_imputed_income_amount(t, imputed);
    when not_known(options_dealer_or_commodities_trader_in_normal_course(t));
    then section_1258_ordinary_income(t, min(gain, imputed));
}
@source(IRC_S1258_D, relation = formalizes, coverage = partial, quote = "In the case of any gain from a transaction recognized by an entity which is allocable to a limited partner or limited entrepreneur (within the meaning of section 461(k)(4)), subparagraph (A) shall not apply if—")
rule Section1258LimitedPartnerOverrideRule(t: Transaction, p: Person, gain: Money, imputed: Money) defeasible {
    label en official "section 1258(d)(5)(C): the dealer/trader exception does not shelter a limited partner's allocable gain in the described cases";
    when conversion_transaction(t);
    when gain_on_conversion_transaction_position(t, p, gain);
    when gain_would_be_capital_gain_1258(t);
    when applicable_imputed_income_amount(t, imputed);
    when options_dealer_or_commodities_trader_in_normal_course(t);
    when limited_partner_gain_with_time_value_or_marketed_return(t);
    then section_1258_ordinary_income(t, min(gain, imputed));
}
pub relation position_becomes_part_of_conversion_transaction_with_built_in_loss(t: Transaction, pos: Asset, fmv: Money, basis: Money) kind empirical {
    label en official "section 1258(d)(3): a position with a built-in loss becomes part of a conversion transaction, at the given fair market value and basis";
}
pub relation section_1258_position_taken_into_account_at_fmv(t: Transaction, pos: Asset, amount: Money) kind institutional {
    label en official "section 1258(d)(3)(A)(i): for periods after it becomes part of the transaction the position is taken into account at its fair market value at that time";
}
@source(IRC_S1258_D, relation = formalizes, coverage = partial, quote = "such position shall be taken into account at its fair market value as of the time it became part of such transaction")
rule BuiltInLossPositionAtFmvRule(t: Transaction, pos: Asset, fmv: Money, basis: Money) defeasible {
    label en official "section 1258(d)(3)(A)(i): applies when there is a built-in loss (fair market value below basis)";
    when position_becomes_part_of_conversion_transaction_with_built_in_loss(t, pos, fmv, basis);
    when fmv < basis;
    then section_1258_position_taken_into_account_at_fmv(t, pos, fmv);
}
pub relation section_1258_built_in_loss(t: Transaction, pos: Asset, amount: Money) kind institutional {
    label en official "section 1258(d)(3)(B): the loss which would have been realized if the position had been disposed of at its fair market value when it became part of the transaction";
}
@source(IRC_S1258_D, relation = formalizes, coverage = partial, quote = "the term \"built-in loss\" means the loss (if any) which would have been realized if the position had been disposed of or otherwise terminated at its fair market value as of the time such position became part of the conversion transaction.")
rule BuiltInLossAmountRule(t: Transaction, pos: Asset, fmv: Money, basis: Money) defeasible {
    label en official "section 1258(d)(3)(B)";
    when position_becomes_part_of_conversion_transaction_with_built_in_loss(t, pos, fmv, basis);
    when fmv < basis;
    then section_1258_built_in_loss(t, pos, basis - fmv);
}

// =============================================================================
// §1236: dealers in securities
// =============================================================================

pub relation dealer_sells_security(t: Transaction, dealer: Person, sec: Asset) kind empirical {
    label en official "section 1236(a): gain by a dealer in securities from the sale or exchange of a security";
}
pub relation security_identified_as_investment_by_close_of_acquisition_day(sec: Asset) kind empirical {
    label en official "section 1236(a)(1): before the close of the day of acquisition (or such earlier time as the Secretary prescribes) the security was clearly identified in the dealer's records as held for investment";
}
pub relation security_held_primarily_for_sale_after_identification(sec: Asset) kind empirical {
    label en official "section 1236(a)(2): at any time after the close of that day the security was held by the dealer primarily for sale to customers in the ordinary course";
}
pub relation dealer_gain_is_capital_1236(t: Transaction, dealer: Person) kind institutional {
    label en official "section 1236(a): the dealer's gain may be capital gain";
}
@source(IRC_S1236_A, relation = formalizes, coverage = partial, quote = "Gain by a dealer in securities from the sale or exchange of any security shall in no event be considered as gain from the sale or exchange of a capital asset unless—")
rule DealerGainCapitalRule(t: Transaction, dealer: Person, sec: Asset) defeasible {
    label en official "section 1236(a)(1)-(2)";
    when dealer_sells_security(t, dealer, sec);
    when security_identified_as_investment_by_close_of_acquisition_day(sec);
    when not_known(security_held_primarily_for_sale_after_identification(sec));
    then dealer_gain_is_capital_1236(t, dealer);
}
pub relation security_at_any_time_identified_as_investment(sec: Asset) kind empirical {
    label en official "section 1236(b): at any time the security was clearly identified in the dealer's records as held for investment";
}
pub relation section_582c_bank_loss_rule_applies(t: Transaction) kind empirical {
    label en official "section 1236(b): section 582(c) (bond losses of banks) provides otherwise";
}
pub relation dealer_loss_not_ordinary_1236(t: Transaction, dealer: Person) kind institutional {
    label en official "section 1236(b): the dealer's loss is in no event an ordinary loss";
}
@source(IRC_S1236_B, relation = formalizes, coverage = exact, quote = "in no event be considered as ordinary loss if at any time the security was clearly identified in the dealer's records as a security held for investment.")
rule DealerLossNotOrdinaryRule(t: Transaction, dealer: Person, sec: Asset) defeasible {
    label en official "section 1236(b)";
    when dealer_sells_security(t, dealer, sec);
    when security_at_any_time_identified_as_investment(sec);
    when not_known(section_582c_bank_loss_rule_applies(t));
    then dealer_loss_not_ordinary_1236(t, dealer);
}
pub relation option_identified_as_investment_before_close_of_acquisition_day(opt: Asset) kind empirical {
    label en official "section 1236(e): the option was clearly identified in the dealer's records as held for investment before the close of the day the option was acquired";
}
pub relation security_acquired_by_dealer_under_option(sec: Asset, opt: Asset) kind empirical {
    label en official "section 1236(e): the security was acquired by the dealer pursuant to an option held by the dealer (option includes the right to subscribe to or purchase a security)";
}
pub relation security_treatable_as_held_for_investment_1236e(sec: Asset) kind institutional {
    label en official "section 1236(e): a security acquired under an option may be treated as held for investment only if the option was so identified in time";
}
@source(IRC_S1236_E, relation = formalizes, coverage = exact, quote = "may be treated as held for investment only if the dealer, before the close of the day on which the option was acquired, clearly identified the option on his records as held for investment.")
rule OptionIdentificationRule(sec: Asset, opt: Asset) defeasible {
    label en official "section 1236(e)";
    when security_acquired_by_dealer_under_option(sec, opt);
    when option_identified_as_investment_before_close_of_acquisition_day(opt);
    then security_treatable_as_held_for_investment_1236e(sec);
}

// =============================================================================
// §1237: real property subdivided for sale
// =============================================================================

pub relation lot_sold_from_tract(t: Transaction, p: Person, lot: Asset, tract: Asset) kind empirical {
    label en official "section 1237(a): a lot or parcel which is part of a tract of real property in the hands of the taxpayer is sold";
}
pub relation taxpayer_is_c_corporation_1237(p: Person) kind empirical {
    label en official "section 1237(a): the taxpayer is a C corporation (the section applies to other taxpayers)";
}
pub relation tract_not_previously_held_primarily_for_sale_and_no_other_real_property_so_held(p: Person, tract: Asset) kind empirical {
    label en official "section 1237(a)(1): the tract or any lot had not previously been held primarily for sale to customers (unless covered by this section) and in the same taxable year the taxpayer does not so hold any other real property";
}
pub relation no_substantial_improvement_enhancing_value(tract: Asset) kind empirical {
    label en official "section 1237(a)(2): no substantial improvement that substantially enhances the value is made on the tract by the taxpayer (or attributed persons) or under a contract of sale (an evaluative element, DECISION-0194: adjudicated fact)";
}
pub relation lot_held_at_least_5_years_or_inherited(lot: Asset) kind empirical {
    label en official "section 1237(a)(3): the lot, except real property acquired by inheritance or devise, is held by the taxpayer for a period of 5 years";
}
pub relation section_1237_applies_to_lot(p: Person, lot: Asset, tract: Asset) kind institutional {
    label en official "section 1237(a): the lot is not deemed held primarily for sale solely because of subdivision";
}
@source(IRC_S1237_A, relation = formalizes, coverage = partial, quote = "shall not be deemed to be held primarily for sale to customers in the ordinary course of trade or business at the time of sale solely because of the taxpayer having subdivided such tract for purposes of sale")
rule Section1237AppliesRule(t: Transaction, p: Person, lot: Asset, tract: Asset) defeasible {
    label en official "section 1237(a)(1)-(3), taxpayer other than a C corporation";
    when lot_sold_from_tract(t, p, lot, tract);
    when not_known(taxpayer_is_c_corporation_1237(p));
    when tract_not_previously_held_primarily_for_sale_and_no_other_real_property_so_held(p, tract);
    when no_substantial_improvement_enhancing_value(tract);
    when lot_held_at_least_5_years_or_inherited(lot);
    then section_1237_applies_to_lot(p, lot, tract);
}
pub relation lots_sold_from_tract_through_this_year(tract: Asset, count: Integer) kind empirical {
    label en official "section 1237(b)(1): the number of lots or parcels from the same tract sold or exchanged, counting the sale in the taxable year of the sixth lot";
}
pub relation selling_price_of_lot(t: Transaction, amount: Money) kind empirical {
    label en official "section 1237(b)(1): the selling price of the lot";
}
pub const Section1237ProfitShare: Decimal = 0.05 {
    label en official "5 percent of the selling price (section 1237(b)(1))";
};
pub relation section_1237_deemed_ordinary_gain(t: Transaction, amount: Money) kind institutional {
    label en official "section 1237(b)(1): from the sixth lot on, gain is deemed gain from property held primarily for sale to the extent of 5 percent of the selling price";
}
@source(IRC_S1237_B, relation = formalizes, coverage = exact, quote = "shall be deemed to be gain from the sale of property held primarily for sale to customers in the ordinary course of the trade or business to the extent of 5 percent of the selling price.")
rule Section1237SixthLotRule(t: Transaction, p: Person, lot: Asset, tract: Asset, count: Integer, price: Money) defeasible {
    label en official "section 1237(b)(1): 5 percent of the selling price when more than 5 lots have been sold (cents HALF_UP: JUDGMENT CALL)";
    when section_1237_applies_to_lot(p, lot, tract);
    when lot_sold_from_tract(t, p, lot, tract);
    when lots_sold_from_tract_through_this_year(tract, count);
    when count > 5;
    when selling_price_of_lot(t, price);
    then section_1237_deemed_ordinary_gain(t, round(price * Section1237ProfitShare, 2, "HALF_UP"));
}

// =============================================================================
// §1241, §1242, §1243, §1249
// =============================================================================

pub relation lease_or_distributor_agreement_cancellation_receipt(t: Transaction, p: Person, amount: Money) kind empirical {
    label en official "section 1241: amounts received by a lessee for cancellation of a lease, or by a distributor of goods for cancellation of a distributor's agreement";
}
pub relation distributor_has_substantial_capital_investment(p: Person) kind empirical {
    label en official "section 1241: the distributor has a substantial capital investment in the distributorship (an evaluative element, DECISION-0194)";
}
pub relation cancellation_receipt_is_lessee_receipt(t: Transaction) kind empirical {
    label en official "the receipt is by a lessee for the cancellation of a lease";
}
pub relation amount_treated_as_received_in_exchange(t: Transaction, amount: Money) kind institutional {
    label en official "section 1241: the amount is treated as received in exchange for the lease or agreement";
}
@source(IRC_S1241, relation = formalizes, coverage = partial, quote = "shall be considered as amounts received in exchange for such lease or agreement.")
rule LesseeCancellationExchangeRule(t: Transaction, p: Person, amount: Money) defeasible {
    label en official "section 1241: a lessee's cancellation receipt";
    when lease_or_distributor_agreement_cancellation_receipt(t, p, amount);
    when cancellation_receipt_is_lessee_receipt(t);
    then amount_treated_as_received_in_exchange(t, amount);
}
rule DistributorCancellationExchangeRule(t: Transaction, p: Person, amount: Money) defeasible {
    label en official "section 1241: a distributor's cancellation receipt with a substantial capital investment";
    when lease_or_distributor_agreement_cancellation_receipt(t, p, amount);
    when distributor_has_substantial_capital_investment(p);
    then amount_treated_as_received_in_exchange(t, amount);
}
pub relation loss_on_small_business_investment_company_stock(t: Transaction, p: Person, amount: Money) kind empirical {
    label en official "section 1242(1): a loss on stock in a small business investment company operating under the Small Business Investment Act of 1958";
}
pub relation loss_would_be_capital_loss(t: Transaction) kind empirical {
    label en official "sections 1242(2), 1243(2): the loss would (but for the section) be a loss from the sale or exchange of a capital asset";
}
pub relation sbic_loss_ordinary_1242(t: Transaction, amount: Money) kind institutional {
    label en official "section 1242: the loss is an ordinary loss, attributable to a trade or business for section 172";
}
@source(IRC_S1242, relation = formalizes, coverage = partial, quote = "then such loss shall be treated as an ordinary loss.")
rule Section1242OrdinaryLossRule(t: Transaction, p: Person, amount: Money) defeasible {
    label en official "section 1242";
    when loss_on_small_business_investment_company_stock(t, p, amount);
    when loss_would_be_capital_loss(t);
    then sbic_loss_ordinary_1242(t, amount);
}
pub relation sbic_loss_attributable_to_trade_or_business_1242(t: Transaction) kind institutional {
    label en official "section 1242, last sentence: for section 172 the loss is attributable to a trade or business of the taxpayer";
}
rule Section1242Section172Rule(t: Transaction, amount: Money) defeasible {
    label en official "section 1242: attribution to a trade or business for the net operating loss deduction";
    when sbic_loss_ordinary_1242(t, amount);
    then sbic_loss_attributable_to_trade_or_business_1242(t);
}
pub relation sbic_operating_company_and_conversion_stock_loss(t: Transaction, p: Person, amount: Money) kind empirical {
    label en official "section 1243: a small business investment company loses on stock received under the conversion privilege of convertible debentures acquired under section 304 of the Small Business Investment Act of 1958";
}
pub relation sbic_conversion_loss_ordinary_1243(t: Transaction, amount: Money) kind institutional {
    label en official "section 1243: the loss is an ordinary loss";
}
@source(IRC_S1243, relation = formalizes, coverage = partial, quote = "then such loss shall be treated as an ordinary loss.")
rule Section1243OrdinaryLossRule(t: Transaction, p: Person, amount: Money) defeasible {
    label en official "section 1243";
    when sbic_operating_company_and_conversion_stock_loss(t, p, amount);
    when loss_would_be_capital_loss(t);
    then sbic_conversion_loss_ordinary_1243(t, amount);
}
pub relation sale_of_patent_or_similar_right_to_controlled_foreign_corporation(t: Transaction, p: Person, foreign: Person) kind empirical {
    label en official "section 1249(a): gain from the sale or exchange of a patent, invention, model or design, copyright, secret formula or process, or similar property right to a foreign corporation by a United States person which controls it";
}
pub relation voting_power_share_of_foreign_corporation(p: Person, foreign: Person, share: Decimal) kind empirical {
    label en official "section 1249(b): the direct or indirect ownership of stock possessing the given share of the total combined voting power (section 958(b) attribution applies, case-supplied share)";
}
pub relation gain_would_be_capital_or_1231(t: Transaction) kind empirical {
    label en official "section 1249(a): the gain would (but for the subsection) be gain from the sale or exchange of a capital asset or of section 1231 property";
}
pub relation section_1249_ordinary_income(t: Transaction) kind institutional {
    label en official "section 1249(a): the gain is ordinary income";
}
@source(IRC_S1249_A, relation = formalizes, coverage = exact, quote = "be considered as ordinary income.")
rule Section1249OrdinaryRule(t: Transaction, p: Person, foreign: Person, share: Decimal) defeasible {
    label en official "section 1249: a controlling (more than 50 percent) United States seller";
    when sale_of_patent_or_similar_right_to_controlled_foreign_corporation(t, p, foreign);
    when voting_power_share_of_foreign_corporation(p, foreign, share);
    when share > 0.50;
    when gain_would_be_capital_or_1231(t);
    then section_1249_ordinary_income(t);
}

// =============================================================================
// Short provisions: §1013, §1019, §1021, §1032, §1053, §1054
// =============================================================================

pub relation property_should_have_been_in_last_inventory(a: Asset) kind empirical {
    label en official "section 1013: the property should have been included in the last inventory";
}
pub relation last_inventory_value(a: Asset, amount: Money) kind empirical {
    label en official "section 1013: the last inventory value of the property";
}
pub relation basis_of_omitted_inventory_property(a: Asset, amount: Money) kind institutional {
    label en official "section 1013: the basis is the last inventory value";
}
@source(IRC_S1013, relation = formalizes, coverage = exact, quote = "If the property should have been included in the last inventory, the basis shall be the last inventory value thereof.")
rule OmittedInventoryBasisRule(a: Asset, value: Money) defeasible {
    label en official "section 1013";
    when property_should_have_been_in_last_inventory(a);
    when last_inventory_value(a, value);
    then basis_of_omitted_inventory_property(a, value);
}
pub relation lessor_income_excluded_under_109(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "section 1019: income derived by the lessor from lessee improvements and excludable under section 109";
}
pub relation lessor_basis_adjustment_from_109_income(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "section 1019: neither the basis nor the adjusted basis of the lessor's property is increased or diminished on account of that income";
}
@source(IRC_S1019, relation = formalizes, coverage = partial, quote = "Neither the basis nor the adjusted basis of any portion of real property shall, in the case of the lessor of such property, be increased or diminished")
rule LessorNoBasisAdjustmentRule(p: Person, a: Asset, amount: Money) defeasible {
    label en official "section 1019: the adjustment is zero (the text also says the basis is not changed by the related depreciation timing, not modelled)";
    when lessor_income_excluded_under_109(p, a, amount);
    then lessor_basis_adjustment_from_109_income(p, a, 0.00 USD);
}
pub relation annuity_contract_adjusted_basis_before_floor(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "section 1021: the adjusted basis of an annuity contract that is sold, before the floor";
}
pub relation annuity_contract_sold(t: Transaction, p: Person, a: Asset) kind empirical {
    label en official "section 1021: the sale of an annuity contract";
}
pub relation annuity_contract_sale_basis(t: Transaction, amount: Money) kind institutional {
    label en official "section 1021: the adjusted basis on the sale of an annuity contract is never less than zero";
}
@source(IRC_S1021, relation = formalizes, coverage = exact, quote = "In case of the sale of an annuity contract, the adjusted basis shall in no case be less than zero.")
rule AnnuityBasisFloorRule(t: Transaction, p: Person, a: Asset, basis: Money) defeasible {
    label en official "section 1021 (positive basis unchanged)";
    when annuity_contract_sold(t, p, a);
    when annuity_contract_adjusted_basis_before_floor(p, a, basis);
    when basis >= 0.00 USD;
    then annuity_contract_sale_basis(t, basis);
}
rule AnnuityBasisFloorNegativeRule(t: Transaction, p: Person, a: Asset, basis: Money) defeasible {
    label en official "section 1021: a negative computed basis is zero";
    when annuity_contract_sold(t, p, a);
    when annuity_contract_adjusted_basis_before_floor(p, a, basis);
    when basis < 0.00 USD;
    then annuity_contract_sale_basis(t, 0.00 USD);
}
pub relation corporation_receives_property_for_its_stock(t: Transaction, corp: Person) kind empirical {
    label en official "section 1032(a): a corporation receives money or other property in exchange for its stock (including treasury stock)";
}
pub relation corporation_option_lapse_or_acquisition_or_securities_futures(t: Transaction, corp: Person) kind empirical {
    label en official "section 1032(a), second sentence: a lapse or acquisition of an option with respect to its stock, or a securities futures contract (section 1234B) to buy or sell its stock";
}
@source(IRC_S1032_A, relation = formalizes, coverage = partial, quote = "No gain or loss shall be recognized to a corporation on the receipt of money or other property in exchange for stock (including treasury stock) of such corporation.")
rule Section1032NoGainOrLossRule(t: Transaction, corp: Person) defeasible {
    label en official "section 1032(a), first sentence";
    when corporation_receives_property_for_its_stock(t, corp);
    then nonrecognition_exception_applies(corp, t);
    then gain_recognized(corp, t, 0.00 USD);
    then loss_recognized(corp, t, 0.00 USD);
}
rule Section1032OptionRule(t: Transaction, corp: Person) defeasible {
    label en official "section 1032(a), second sentence: option lapse or acquisition, securities futures";
    when corporation_option_lapse_or_acquisition_or_securities_futures(t, corp);
    then nonrecognition_exception_applies(corp, t);
    then gain_recognized(corp, t, 0.00 USD);
    then loss_recognized(corp, t, 0.00 USD);
}
pub relation property_acquired_before_march_1_1913(a: Asset) kind empirical {
    label en official "section 1053: the property was acquired before March 1, 1913";
}
pub relation basis_adjusted_to_march_1_1913(a: Asset, amount: Money) kind empirical {
    label en official "section 1053: the basis otherwise determined under the subtitle, adjusted under section 1016 for the period before March 1, 1913";
}
pub relation fair_market_value_on_march_1_1913(a: Asset, amount: Money) kind empirical {
    label en official "section 1053: the fair market value of the property as of March 1, 1913";
}
pub relation basis_for_gain_1053(a: Asset, amount: Money) kind institutional {
    label en official "section 1053: the basis for determining gain is the March 1, 1913 fair market value when it exceeds the adjusted basis";
}
@source(IRC_S1053, relation = formalizes, coverage = partial, quote = "then the basis for determining gain shall be such fair market value.")
rule Section1053Rule(a: Asset, basis: Money, fmv: Money) defeasible {
    label en official "section 1053";
    when property_acquired_before_march_1_1913(a);
    when basis_adjusted_to_march_1_1913(a, basis);
    when fair_market_value_on_march_1_1913(a, fmv);
    when basis < fmv;
    then basis_for_gain_1053(a, fmv);
}
pub relation fnma_stock_issued_under_charter_303c(a: Asset) kind empirical {
    label en official "section 1054: a share of stock issued pursuant to section 303(c) of the Federal National Mortgage Association Charter Act (12 U.S.C. 1718)";
}
pub relation capital_contributions_evidenced_by_share(a: Asset, amount: Money) kind empirical {
    label en official "section 1054: the capital contributions evidenced by the share";
}
pub relation required_reduction_charter_303c(a: Asset, amount: Money) kind empirical {
    label en official "section 1054: the amount (if any) required by section 303(c) of the Charter Act to be deducted (case-supplied)";
}
pub relation fnma_share_basis_of_initial_holder(a: Asset, amount: Money) kind institutional {
    label en official "section 1054: the basis of the share in the hands of the initial holder";
}
@source(IRC_S1054, relation = formalizes, coverage = partial, quote = "the basis of such share in the hands of the initial holder shall be an amount equal to the capital contributions evidenced by such share reduced by")
rule FnmaShareBasisRule(a: Asset, contributions: Money, reduction: Money) defeasible {
    label en official "section 1054";
    when fnma_stock_issued_under_charter_303c(a);
    when capital_contributions_evidenced_by_share(a, contributions);
    when required_reduction_charter_303c(a, reduction);
    then fnma_share_basis_of_initial_holder(a, contributions - reduction);
}
