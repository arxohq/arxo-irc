// Property transactions -- WIRE-9 (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// New direct import: `us.irc.income_individual` (acyclic: income_individual does not import this package).
//
// (1) Section 1211(b)(1): `married_filing_separately(p, y)` was asserted directly "pending a typed dependency contract"; it is the filing
//     status MarriedSeparate of `income_individual` (section 1(a)-(d)/(j) filing statuses).
// (2) Section 1301(a): `tax_under_section_1_on(p, y, income, amount)` was an unimplemented parameterized function. `income_individual`
//     (module 69-recomputation-and-bounded-chains.law) answers "the tax of section 1 at a requested income" for a year:
//     this package REQUESTS the two incomes it needs (the taxable income reduced by elected farm income, paragraph (1); the prior year's
//     taxable income increased by one-third of the elected farm income, paragraph (2)) and reads the answer.
//
// (3) Section 1061(d)(2)(A): `transferee_is_family_member_318a1(p, transferee)` -- a member of the taxpayer's family within the meaning of
//     section 318(a)(1) -- is the spouse (other than a legally separated spouse), child, grandchild or parent that `us.irc.corporations`
//     (module 03-attribution, imported since stage 1) records for its section 318(a)(1) attribution. The worklist named `accounting` as
//     owner because the row also mentions sections 475; the family test itself is the corporations package's.
//
// JUDGMENT CALLS. The request rules are `defeasible` because they read this package's own defeasible intermediate values (a strict rule
// cannot read a defeasible producer, LDC-E4103). Both wirings keep the case-fact channel: a case may still assert the placeholders.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

use self::{
    Person,
    TaxableYear,
    married_filing_separately,
    prior_year_taxable_income_increased_by_third,
    tax_under_section_1_on,
    taxable_income_reduced_by_farm_income,
    transferee_is_family_member_318a1,
};

rule W9MarriedFilingSeparatelyFromFilingStatus strict {
    label en official "section 1211(b)(1): a married individual filing a separate return is a taxpayer whose section 1 filing status is MarriedSeparate (owner package `income_individual`)";
    for p: Person;
    for y: TaxableYear;
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::MarriedSeparate);
    then married_filing_separately(p, y);
}

rule W9RequestSection1TaxOnReducedIncome defeasible {
    label en official "section 1301(a)(1): ask income_individual for the tax of section 1 on the taxable income reduced by elected farm income";
    for p: Person;
    for y: TaxableYear;
    for reduced: Money;
    when taxable_income_reduced_by_farm_income(p, y, reduced);
    then us.irc.income_individual::hypothetical_income_request_1(p, y, reduced);
}
rule W9RequestSection1TaxOnIncreasedPriorYearIncome defeasible {
    label en official "section 1301(a)(2): ask income_individual for the tax of section 1 on the prior year's taxable income increased by one-third of the elected farm income";
    for p: Person;
    for prior_y: TaxableYear;
    for increased: Money;
    when prior_year_taxable_income_increased_by_third(p, prior_y, increased);
    then us.irc.income_individual::hypothetical_income_request_1(p, prior_y, increased);
}
rule W9TaxUnderSection1OnFromIncomeIndividual strict {
    label en official "section 1301(a): the tax of section 1 on a hypothetical taxable income is the answer income_individual gives for that request";
    for p: Person;
    for y: TaxableYear;
    for income: Money;
    for tax: Money;
    when us.irc.income_individual::hypothetical_tax_1(p, y, income, tax);
    then tax_under_section_1_on(p, y, income, tax);
}

rule W9TransfereeIsSpouseUnderSection318a1 strict {
    label en official "section 1061(d)(2)(A), section 318(a)(1)(A)(i): the spouse of the taxpayer, other than a spouse legally separated under a decree of divorce or separate maintenance, is a member of the family (owner package `corporations`)";
    for p: us.irc.core::Individual;
    for transferee: us.irc.core::Individual;
    when us.irc.corporations::spouse_of(transferee, p);
    when not_known(us.irc.corporations::legally_separated_spouse(transferee, p));
    then transferee_is_family_member_318a1(p, transferee);
}
rule W9TransfereeIsLinealRelativeUnderSection318a1 strict {
    label en official "section 1061(d)(2)(A), section 318(a)(1)(A)(ii): a child, grandchild or parent of the taxpayer is a member of the family (owner package `corporations`; a legally adopted child is asserted as a child there)";
    for p: us.irc.core::Individual;
    for transferee: us.irc.core::Individual;
    when us.irc.corporations::child_grandchild_or_parent_of(transferee, p);
    then transferee_is_family_member_318a1(p, transferee);
}
