// Stage 2c (IRC-07, A05). Subchapter U (§§1391-1397F): designation of
// empowerment zones and enterprise communities, eligibility criteria,
// definitions, the empowerment zone employment credit, tax-exempt zone
// facility bonds, increased §179 expensing, rollover of gain on qualified
// empowerment zone assets, and the enterprise zone business definitions.
//
// The provisions are expired in large part: designations were made in 1994-
// 2001 windows; the §1397A and §1397B sunsets are December 31, 2020; an
// empowerment zone designation ends no later than December 31, 2025 (§1391(d)).
// The module models the tests and computations as written and the sunset dates
// as rules; whether any zone is still designated on a reading date is a case
// fact. Facts drawn from other norms (census data, section 51 wages, section 168
// property) are case-asserted.

use self::{
    Asset,
    IRC_S1391_B,
    IRC_S1391_C,
    IRC_S1391_D,
    IRC_S1391_E,
    IRC_S1391_G,
    IRC_S1391_H,
    IRC_S1392_A,
    IRC_S1393_A,
    IRC_S1394_B,
    IRC_S1394_C,
    IRC_S1394_F,
    IRC_S1396_A,
    IRC_S1396_C,
    IRC_S1396_D,
    IRC_S1397A_A,
    IRC_S1397B_A,
    IRC_S1397C_B,
    IRC_S1397C_C,
    IRC_S1397D_A,
    Person,
    TaxableYear,
    Transaction,
    employee_excluded_derived_1396d2,
    excluded_short_employment_1396d2C,
    gain_realized,
};

pub entity NominatedArea {
    label en official "a nominated area: an area nominated by local governments and the State for designation under section 1391 (section 1393(a)(6))";
}
pub enum ZoneKind {
    EmpowermentZone;
    EnterpriseCommunity;
    label en official "an empowerment zone or an enterprise community (section 1393(b))";
}

// =============================================================================
// §1393: definitions
// =============================================================================

pub relation area_outside_metropolitan_statistical_area(area: NominatedArea) kind empirical {
    label en official "section 1393(a)(2)(A): outside of a metropolitan statistical area (section 143(k)(2)(B))";
}
pub relation area_determined_rural_by_secretary_of_agriculture(area: NominatedArea) kind empirical {
    label en official "section 1393(a)(2)(B): determined by the Secretary of Agriculture, after consultation with the Secretary of Commerce, to be a rural area";
}
pub relation rural_area_1393(area: NominatedArea) kind institutional {
    label en official "section 1393(a)(2): a rural area";
}
@source(IRC_S1393_A, relation = formalizes, coverage = partial, quote = "(A) outside of a metropolitan statistical area (within the meaning of section 143(k)(2)(B)), or")
rule RuralOutsideMsaRule(area: NominatedArea) defeasible {
    label en official "section 1393(a)(2)(A)";
    when area_outside_metropolitan_statistical_area(area);
    then rural_area_1393(area);
}
rule RuralDeterminedRule(area: NominatedArea) defeasible {
    label en official "section 1393(a)(2)(B)";
    when area_determined_rural_by_secretary_of_agriculture(area);
    then rural_area_1393(area);
}
pub relation area_exists_1393(area: NominatedArea) kind empirical {
    label en unofficial "the area is a nominated area under consideration";
}
pub relation urban_area_1393(area: NominatedArea) kind institutional {
    label en official "section 1393(a)(3): an urban area is an area which is not a rural area";
}
@source(IRC_S1393_A, relation = formalizes, coverage = exact, quote = "The term \"urban area\" means an area which is not a rural area.")
rule UrbanAreaRule(area: NominatedArea) defeasible {
    label en official "section 1393(a)(3)";
    when area_exists_1393(area);
    when not_known(rural_area_1393(area));
    then urban_area_1393(area);
}
pub relation area_within_indian_reservation(area: NominatedArea) kind empirical {
    label en official "section 1393(a)(4): the area is within an Indian reservation (section 168(j)(6))";
}
pub relation area_barred_as_indian_reservation_1393(area: NominatedArea) kind institutional {
    label en official "section 1393(a)(4)(A): no zone or community may include any area within an Indian reservation";
}
@source(IRC_S1393_A, relation = formalizes, coverage = exact, quote = "No empowerment zone or enterprise community may include any area within an Indian reservation.")
rule IndianReservationBarRule(area: NominatedArea) defeasible {
    label en official "section 1393(a)(4)(A)";
    when area_within_indian_reservation(area);
    then area_barred_as_indian_reservation_1393(area);
}
pub enum AppropriateSecretary {
    SecretaryOfHousingAndUrbanDevelopment;
    SecretaryOfAgriculture;
    label en official "the appropriate Secretary (section 1393(a)(1))";
}
pub relation appropriate_secretary_for_area(area: NominatedArea, who: AppropriateSecretary) kind institutional {
    label en official "section 1393(a)(1): HUD for an urban area, Agriculture for a rural area";
}
@source(IRC_S1393_A, relation = formalizes, coverage = exact, quote = "(A) the Secretary of Housing and Urban Development in the case of any nominated area which is located in an urban area, and")
rule AppropriateSecretaryUrbanRule(area: NominatedArea) defeasible {
    label en official "section 1393(a)(1)(A)";
    when urban_area_1393(area);
    then appropriate_secretary_for_area(area, SecretaryOfHousingAndUrbanDevelopment);
}
@source(IRC_S1393_A, relation = formalizes, coverage = exact, quote = "(B) the Secretary of Agriculture in the case of any nominated area which is located in a rural area.")
rule AppropriateSecretaryRuralRule(area: NominatedArea) defeasible {
    label en official "section 1393(a)(1)(B)";
    when rural_area_1393(area);
    then appropriate_secretary_for_area(area, SecretaryOfAgriculture);
}

// =============================================================================
// §1392: eligibility criteria
// =============================================================================

pub relation area_population(area: NominatedArea, n: Integer) kind empirical {
    label en official "section 1392(a)(1): the population of the nominated area (most recent decennial census data, section 1393(a)(9))";
}
pub relation most_populous_city_population(area: NominatedArea, n: Integer) kind empirical {
    label en official "section 1392(a)(1)(A)(ii): the population of the most populous city located within the nominated area";
}
pub relation population_criterion_met_1392a1(area: NominatedArea) kind institutional {
    label en official "section 1392(a)(1): maximum population: an urban area the lesser of 200,000 and the greater of 50,000 and 10 percent of the most populous city; a rural area 30,000";
}
@source(IRC_S1392_A, relation = formalizes, coverage = partial, quote = "(B) in the case of a rural area, 30,000.")
rule PopulationRuralRule(area: NominatedArea, pop: Integer) defeasible {
    label en official "section 1392(a)(1)(B)";
    when rural_area_1393(area);
    when area_population(area, pop);
    when pop <= 30000;
    then population_criterion_met_1392a1(area);
}
@source(IRC_S1392_A, relation = formalizes, coverage = partial, quote = "(i) 200,000, or")
rule PopulationUrbanSmallRule(area: NominatedArea, pop: Integer) defeasible {
    label en official "section 1392(a)(1)(A): urban and not above 50,000 (always within the greater-of limb) and not above 200,000";
    when urban_area_1393(area);
    when area_population(area, pop);
    when pop <= 50000;
    then population_criterion_met_1392a1(area);
}
rule PopulationUrbanCityShareRule(area: NominatedArea, pop: Integer, city: Integer) defeasible {
    label en official "section 1392(a)(1)(A): urban, above 50,000 but within 10 percent of the most populous city and not above 200,000";
    when urban_area_1393(area);
    when area_population(area, pop);
    when most_populous_city_population(area, city);
    when pop > 50000;
    when pop <= 200000;
    when pop * 10 <= city;
    then population_criterion_met_1392a1(area);
}
pub relation area_of_pervasive_poverty_unemployment_and_distress(area: NominatedArea) kind empirical {
    label en official "section 1392(a)(2): the nominated area is one of pervasive poverty, unemployment and general distress (an evaluative element, DECISION-0194: adjudicated fact)";
}
pub relation area_square_miles(area: NominatedArea, n: Integer) kind empirical {
    label en official "section 1392(a)(3)(A): the area in square miles";
}
pub relation boundary_continuous_or_at_most_three_parcels(area: NominatedArea) kind empirical {
    label en official "section 1392(a)(3)(B): the boundary is continuous or, except for a rural area located in more than 1 State, consists of not more than 3 noncontiguous parcels";
}
pub relation states_within_limit(area: NominatedArea) kind empirical {
    label en official "section 1392(a)(3)(C): located entirely within no more than 2 contiguous States (urban) or 3 (rural)";
}
pub relation central_business_district_excluded_or_poor_enough(area: NominatedArea) kind empirical {
    label en official "section 1392(a)(3)(D): the area does not include any part of a central business district unless the poverty rate for each tract in it is at least 35 percent (30 percent in the ... case stated)";
}
pub relation size_and_boundary_criteria_met_1392a3(area: NominatedArea) kind institutional {
    label en official "section 1392(a)(3): size, boundary, State and central-business-district criteria";
}
@source(IRC_S1392_A, relation = formalizes, coverage = partial, quote = "(A) does not exceed 20 square miles if an urban area or 1,000 square miles if a rural area,")
rule SizeUrbanRule(area: NominatedArea, sq: Integer) defeasible {
    label en official "section 1392(a)(3)(A)-(D), urban";
    when urban_area_1393(area);
    when area_square_miles(area, sq);
    when sq <= 20;
    when boundary_continuous_or_at_most_three_parcels(area);
    when states_within_limit(area);
    when central_business_district_excluded_or_poor_enough(area);
    then size_and_boundary_criteria_met_1392a3(area);
}
rule SizeRuralRule(area: NominatedArea, sq: Integer) defeasible {
    label en official "section 1392(a)(3)(A)-(D), rural";
    when rural_area_1393(area);
    when area_square_miles(area, sq);
    when sq <= 1000;
    when boundary_continuous_or_at_most_three_parcels(area);
    when states_within_limit(area);
    when central_business_district_excluded_or_poor_enough(area);
    then size_and_boundary_criteria_met_1392a3(area);
}
pub relation lowest_tract_poverty_rate(area: NominatedArea, rate: Decimal) kind empirical {
    label en official "section 1392(a)(4)(A): the lowest poverty rate among the population census tracts within the nominated area";
}
pub relation share_of_tracts_with_poverty_at_least_25_percent(area: NominatedArea, share: Decimal) kind empirical {
    label en official "section 1392(a)(4)(B): the share of tracts whose poverty rate is at least 25 percent";
}
pub relation share_of_tracts_with_poverty_at_least_35_percent(area: NominatedArea, share: Decimal) kind empirical {
    label en official "section 1392(a)(4)(C): the share of tracts whose poverty rate is at least 35 percent";
}
pub relation poverty_criterion_met_1392a4(area: NominatedArea) kind institutional {
    label en official "section 1392(a)(4): poverty rate at least 20 percent in every tract, at least 25 percent in at least 90 percent of tracts, at least 35 percent in at least 50 percent of tracts";
}
@source(IRC_S1392_A, relation = formalizes, coverage = partial, quote = "(A) for each population census tract within the nominated area is not less than 20 percent,")
rule PovertyCriterionRule(area: NominatedArea, low: Decimal, s25: Decimal, s35: Decimal) defeasible {
    label en official "section 1392(a)(4)(A)-(C) (the (b)(2) five-point reductions for enterprise communities are not applied: G2341)";
    when lowest_tract_poverty_rate(area, low);
    when share_of_tracts_with_poverty_at_least_25_percent(area, s25);
    when share_of_tracts_with_poverty_at_least_35_percent(area, s35);
    when low >= 0.20;
    when s25 >= 0.90;
    when s35 >= 0.50;
    then poverty_criterion_met_1392a4(area);
}
pub relation area_eligible_for_designation_1392(area: NominatedArea) kind institutional {
    label en official "section 1392(a): the nominated area is eligible for designation under section 1391";
}
@source(IRC_S1392_A, relation = formalizes, coverage = partial, quote = "A nominated area shall be eligible for designation under section 1391 only if it meets the following criteria:")
rule AreaEligibleRule(area: NominatedArea) defeasible {
    label en official "section 1392(a)(1)-(4) together, with the Indian reservation bar of section 1393(a)(4)";
    when population_criterion_met_1392a1(area);
    when area_of_pervasive_poverty_unemployment_and_distress(area);
    when size_and_boundary_criteria_met_1392a3(area);
    when poverty_criterion_met_1392a4(area);
    when not_known(area_barred_as_indian_reservation_1393(area));
    then area_eligible_for_designation_1392(area);
}

// =============================================================================
// §1391: designations
// =============================================================================

pub relation nominated_by_local_governments_and_state(area: NominatedArea) kind empirical {
    label en official "section 1391(e)(1): the area is nominated by one or more local governments and the State or States in which it is located";
}
pub relation nominators_have_authority_and_give_assurances(area: NominatedArea) kind empirical {
    label en official "section 1391(e)(2)-(3): the nominators have authority to nominate and to give assurances, and provide written assurances that the strategic plan will be implemented";
}
pub relation secretary_determines_information_reasonably_accurate(area: NominatedArea) kind empirical {
    label en official "section 1391(e)(4): the appropriate Secretary determines that any information furnished is reasonably accurate (a determination of the Secretary, recorded as a fact)";
}
pub relation nominators_certify_no_overlap(area: NominatedArea) kind empirical {
    label en official "section 1391(e)(5): the State and local governments certify that no portion of the area is already in a zone or community or otherwise nominated";
}
pub relation application_meets_1391f(area: NominatedArea) kind empirical {
    label en official "section 1391(f): the application demonstrates eligibility under section 1392, includes the strategic plan with elements (A)-(F), and other information the Secretary requires";
}
pub relation nomination_requirements_met_1391(area: NominatedArea) kind institutional {
    label en official "section 1391(e)-(f): the nomination and application requirements are met";
}
@source(IRC_S1391_E, relation = formalizes, coverage = partial, quote = "No area may be designated under this section unless—")
rule NominationRequirementsRule(area: NominatedArea) defeasible {
    label en official "section 1391(e)(1)-(5) and (f)";
    when nominated_by_local_governments_and_state(area);
    when nominators_have_authority_and_give_assurances(area);
    when secretary_determines_information_reasonably_accurate(area);
    when nominators_certify_no_overlap(area);
    when application_meets_1391f(area);
    then nomination_requirements_met_1391(area);
}
pub relation designation_round(area: NominatedArea, round: Integer) kind empirical {
    label en official "the designation round: 1 = section 1391(a)-(c) (after 1993 and before 1996); 2 = section 1391(g) (before January 1, 1999); 3 = section 1391(h) (before January 1, 2002)";
}
pub relation designation_made_on(area: NominatedArea, on: Date) kind empirical {
    label en official "the date of the designation";
}
pub relation designation_within_statutory_window(area: NominatedArea) kind institutional {
    label en official "section 1391(c), (g)(2), (h)(2): the designation is made within the window of its round";
}
@source(IRC_S1391_C, relation = formalizes, coverage = exact, quote = "A designation may be made under subsection (a) only after 1993 and before 1996.")
rule WindowRound1Rule(area: NominatedArea, on: Date) defeasible {
    label en official "section 1391(c): after 1993 (from January 1, 1994) and before 1996";
    when designation_round(area, 1);
    when designation_made_on(area, on);
    when on >= @1994-01-01;
    when on < @1996-01-01;
    then designation_within_statutory_window(area);
}
@source(IRC_S1391_G, relation = formalizes, coverage = partial, quote = "A designation may be made under this subsection after the date of the enactment of this subsection and before January 1, 1999.")
rule WindowRound2Rule(area: NominatedArea, on: Date) defeasible {
    label en official "section 1391(g)(2): before January 1, 1999 (the lower bound is the enactment of subsection (g), August 5, 1997)";
    when designation_round(area, 2);
    when designation_made_on(area, on);
    when on > @1997-08-05;
    when on < @1999-01-01;
    then designation_within_statutory_window(area);
}
@source(IRC_S1391_H, relation = formalizes, coverage = partial, quote = "A designation may be made under this subsection after the date of the enactment of this subsection and before January 1, 2002.")
rule WindowRound3Rule(area: NominatedArea, on: Date) defeasible {
    label en official "section 1391(h)(2): before January 1, 2002 (the lower bound is the enactment of subsection (h), December 21, 2000)";
    when designation_round(area, 3);
    when designation_made_on(area, on);
    when on > @2000-12-21;
    when on < @2002-01-01;
    then designation_within_statutory_window(area);
}
pub relation designation_counts_by_round_and_kind(round: Integer, kind: ZoneKind, area_kind: Integer, n: Integer) kind empirical {
    label en official "the number of designations made in a round, by zone kind and by area kind (1 = urban, 2 = rural)";
}
pub const EnterpriseCommunitiesAggregateCap: Integer = 95 {
    label en official "95 enterprise communities in the aggregate (section 1391(b)(1))";
};
pub const EnterpriseCommunitiesUrbanCap: Integer = 65 {
    label en official "not more than 65 in urban areas (section 1391(b)(1))";
};
pub const EnterpriseCommunitiesRuralCap: Integer = 30 {
    label en official "not more than 30 in rural areas (section 1391(b)(1), by the aggregate less the urban cap)";
};
pub const EmpowermentZonesFirstRoundCap: Integer = 11 {
    label en official "11 empowerment zones in the aggregate (section 1391(b)(2))";
};
pub relation first_round_enterprise_community_counts(urban: Integer, rural: Integer) kind empirical {
    label en official "the numbers of first-round enterprise communities designated in urban and rural areas";
}
pub relation first_round_enterprise_community_caps_respected(urban: Integer, rural: Integer) kind institutional {
    label en official "section 1391(b)(1): at most 95 in the aggregate and at most 65 urban";
}
@source(IRC_S1391_B, relation = formalizes, coverage = partial, quote = "The appropriate Secretaries may designate in the aggregate 95 nominated areas as enterprise communities under this section")
rule EnterpriseCommunityCapsRule(urban: Integer, rural: Integer) defeasible {
    label en official "section 1391(b)(1)";
    when first_round_enterprise_community_counts(urban, rural);
    when urban + rural <= EnterpriseCommunitiesAggregateCap;
    when urban <= EnterpriseCommunitiesUrbanCap;
    then first_round_enterprise_community_caps_respected(urban, rural);
}
pub relation first_round_empowerment_zone_counts(urban: Integer, rural: Integer) kind empirical {
    label en official "the numbers of first-round empowerment zones designated in urban and rural areas";
}
pub relation first_round_empowerment_zone_caps_respected(urban: Integer, rural: Integer) kind institutional {
    label en official "section 1391(b)(2): at most 11 in the aggregate, at most 8 urban and at most 3 rural";
}
@source(IRC_S1391_B, relation = formalizes, coverage = partial, quote = "The appropriate Secretaries may designate in the aggregate 11 nominated areas as empowerment zones under this section")
rule EmpowermentZoneCapsRule(urban: Integer, rural: Integer) defeasible {
    label en official "section 1391(b)(2)";
    when first_round_empowerment_zone_counts(urban, rural);
    when urban + rural <= EmpowermentZonesFirstRoundCap;
    when urban <= 8;
    when rural <= 3;
    then first_round_empowerment_zone_caps_respected(urban, rural);
}
pub relation designated_as(area: NominatedArea, kind: ZoneKind) kind empirical {
    label en official "the area is designated as an empowerment zone or enterprise community under section 1391";
}
pub relation designation_revoked_on(area: NominatedArea, on: Date) kind institutional {
    label en official "section 1391(d)(1)(C), (d)(2): the date the appropriate Secretary revokes the designation";
}
pub relation revocation_grounds_1391d2(area: NominatedArea) kind empirical {
    label en official "section 1391(d)(2): the local government or State has modified the boundaries of the area, or is not complying substantially with (or fails to make progress toward) the strategic plan benchmarks";
}
pub relation secretary_revokes_designation(area: NominatedArea, on: Date) kind empirical {
    label en official "section 1391(d)(2): the appropriate Secretary revokes the designation on the date";
}
pub relation designation_revoked_1391(area: NominatedArea) kind institutional {
    label en official "section 1391(d)(2): the designation is revoked";
}
@source(IRC_S1391_D, relation = formalizes, coverage = partial, quote = "The appropriate Secretary may revoke the designation under this section of an area if such Secretary determines that the local government or the State in which it is located—")
rule Section1391RevocationPower(area: NominatedArea, on: Date) strict {
    label en official "section 1391(d)(2): the appropriate Secretary may revoke a designation on the stated grounds";
    when secretary_revokes_designation(area, on);
    then power Section1391Revocation {
        holder us.irc.core::Secretary;
        over area;
        exercise secretary_revokes_designation(area, on);
        valid_when revocation_grounds_1391d2(area);
        effect create(designation_revoked_1391(area));
        window [@1993-08-10, infinity);
    };
}
pub relation designation_end_candidate(area: NominatedArea, on: Date) kind institutional {
    label en official "section 1391(d)(1): a date on which the designation would end: (A) December 31, 2025 for an empowerment zone, (B) the termination date in the nomination, (C) the revocation date";
}
pub relation termination_date_in_nomination(area: NominatedArea, on: Date) kind empirical {
    label en official "section 1391(d)(1)(B): the termination date designated by the State and local governments in their nomination";
}
pub const EmpowermentZoneLastDate: Date = @2025-12-31 {
    label en official "December 31, 2025 (section 1391(d)(1)(A)(i))";
};
@source(IRC_S1391_D, relation = formalizes, coverage = partial, quote = "(A)(i) in the case of an empowerment zone, December 31, 2025, or")
rule EndCandidateEmpowermentZoneRule(area: NominatedArea) defeasible {
    label en official "section 1391(d)(1)(A)(i)";
    when designated_as(area, EmpowermentZone);
    then designation_end_candidate(area, EmpowermentZoneLastDate);
}
rule EndCandidateTerminationDateRule(area: NominatedArea, on: Date) defeasible {
    label en official "section 1391(d)(1)(B)";
    when termination_date_in_nomination(area, on);
    then designation_end_candidate(area, on);
}
rule EndCandidateRevocationRule(area: NominatedArea, on: Date) defeasible {
    label en official "section 1391(d)(1)(C)";
    when secretary_revokes_designation(area, on);
    when designation_revoked_1391(area);
    then designation_end_candidate(area, on);
}
pub relation earlier_end_candidate_exists(area: NominatedArea, on: Date) kind institutional {
    label en unofficial "a strictly earlier candidate end date exists (the earliest-of pattern, TECH-GAPS G136)";
}
rule EarlierEndCandidateRule(area: NominatedArea, on: Date, other: Date) defeasible {
    label en unofficial "helper";
    when designation_end_candidate(area, on);
    when designation_end_candidate(area, other);
    when other < on;
    then earlier_end_candidate_exists(area, on);
}
pub relation designation_ends_on(area: NominatedArea, on: Date) kind institutional {
    label en official "section 1391(d)(1): the designation ends on the earliest of the candidate dates";
}
rule DesignationEndsRule(area: NominatedArea, on: Date) defeasible {
    label en official "section 1391(d)(1): earliest candidate";
    when designation_end_candidate(area, on);
    when not_known(earlier_end_candidate_exists(area, on));
    then designation_ends_on(area, on);
}

// =============================================================================
// §1396-§1397: empowerment zone employment credit
// =============================================================================

pub const EmpowermentZoneCreditPercentage: Decimal = 0.20 {
    label en official "the applicable percentage is 20 percent (section 1396(b))";
};
pub const QualifiedZoneWagesAnnualCap: Money = 15000.00 USD {
    label en official "qualified zone wages per employee for a calendar year may not exceed $15,000 (section 1396(c)(2))";
};
pub relation employee_services_substantially_all_in_zone(employee: Person, employer: Person, y: TaxableYear) kind empirical {
    label en official "section 1396(d)(1)(A): substantially all of the services are performed within an empowerment zone in a trade or business of the employer";
}
pub relation employee_principal_abode_in_zone(employee: Person) kind empirical {
    label en official "section 1396(d)(1)(B): the employee's principal place of abode while performing the services is within the empowerment zone";
}
pub relation employee_excluded_under_1396d2(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(2): an individual described in section 51(i)(1)(A)-(C), a 5-percent owner, employed less than 90 days, employed at a section 144(c)(6)(B) facility, or employed in farming where the assets exceed $500,000";
}
pub relation qualified_zone_employee(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 1396(d): a qualified zone employee";
}
@source(IRC_S1396_D, relation = formalizes, coverage = partial, quote = "(B) the principal place of abode of such employee while performing such services is within such empowerment zone.")
rule QualifiedZoneEmployeeRule(employee: Person, employer: Person, y: TaxableYear) defeasible {
    label en official "section 1396(d)(1)-(2)";
    when employee_services_substantially_all_in_zone(employee, employer, y);
    when employee_principal_abode_in_zone(employee);
    when not_known(employee_excluded_under_1396d2(employee, employer));
    when not_known(excluded_short_employment_1396d2C(employee, employer));
    when not_known(employee_excluded_derived_1396d2(employee, employer));
    then qualified_zone_employee(employee, employer, y);
}
pub relation wages_paid_to_employee(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1396(c)(1): wages paid or incurred for services performed while the employee is a qualified zone employee";
}
pub relation wages_taken_into_account_for_section_51_credit(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1396(c)(3): wages taken into account in determining the credit under section 51";
}
pub relation qualified_zone_wages(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1396(c): qualified zone wages: wages, not above $15,000 reduced by the section 51 wages, excluding the section 51 wages themselves";
}
@source(IRC_S1396_C, relation = formalizes, coverage = partial, quote = "the amount of qualified zone wages which may be taken into account for a calendar year shall not exceed $15,000.")
rule QualifiedZoneWagesPositiveRule(employee: Person, employer: Person, y: TaxableYear, wages: Money, w51: Money) defeasible {
    label en official "section 1396(c)(2)-(3): min(wages - section 51 wages, $15,000 - section 51 wages), when positive";
    when qualified_zone_employee(employee, employer, y);
    when wages_paid_to_employee(employee, employer, y, wages);
    when wages_taken_into_account_for_section_51_credit(employee, employer, y, w51);
    when QualifiedZoneWagesAnnualCap > w51;
    when wages > w51;
    then qualified_zone_wages(employee, employer, y, min(wages - w51, QualifiedZoneWagesAnnualCap - w51));
}
rule QualifiedZoneWagesNoneRule(employee: Person, employer: Person, y: TaxableYear, wages: Money, w51: Money) defeasible {
    label en official "section 1396(c)(3): nothing remains when the section 51 wages exhaust the wages or the cap";
    when qualified_zone_employee(employee, employer, y);
    when wages_paid_to_employee(employee, employer, y, wages);
    when wages_taken_into_account_for_section_51_credit(employee, employer, y, w51);
    when QualifiedZoneWagesAnnualCap <= w51;
    then qualified_zone_wages(employee, employer, y, 0.00 USD);
}
pub relation empowerment_zone_employment_credit(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1396(a)-(b): 20 percent of the qualified zone wages (per employee; the credit is part of the section 38 general business credit)";
}
@source(IRC_S1396_A, relation = formalizes, coverage = partial, quote = "the amount of the empowerment zone employment credit determined under this section with respect to any employer for any taxable year is the applicable percentage of the qualified zone wages")
rule EmpowermentZoneCreditRule(employee: Person, employer: Person, y: TaxableYear, wages: Money) defeasible {
    label en official "section 1396(a)-(b) (cents HALF_UP: JUDGMENT CALL)";
    when qualified_zone_wages(employee, employer, y, wages);
    then empowerment_zone_employment_credit(employee, employer, y, round(wages * EmpowermentZoneCreditPercentage, 2, "HALF_UP"));
}

// =============================================================================
// §1397A: increased section 179 expensing; §1397B: rollover
// =============================================================================

pub const Section1397AAdditionalLimit: Money = 35000.00 USD {
    label en official "the section 179(b)(1) limitation is increased by the lesser of $35,000 and the cost of section 179 qualified zone property placed in service (section 1397A(a)(1)(A))";
};
pub relation qualified_zone_property_cost_placed_in_service(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1397A(a)(1)(B): the cost of section 179 property which is qualified zone property placed in service during the taxable year";
}
pub relation enterprise_zone_business_1397a(p: Person) kind empirical {
    label en official "section 1397A(a): the taxpayer is an enterprise zone business";
}
pub relation year_begins_1397a(y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year in which the property is placed in service";
}
pub relation section_179_limitation_increase_1397a(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1397A(a)(1): the increase in the section 179(b)(1) limitation";
}
@source(IRC_S1397A_A, relation = formalizes, coverage = partial, quote = "(1) the limitation under section 179(b)(1) shall be increased by the lesser of—")
rule Section179IncreaseRule(p: Person, y: TaxableYear, cost: Money, start: Date) defeasible {
    label en official "section 1397A(a)(1) and (c): min($35,000, cost), not for property placed in service in taxable years beginning after December 31, 2020";
    when enterprise_zone_business_1397a(p);
    when qualified_zone_property_cost_placed_in_service(p, y, cost);
    when year_begins_1397a(y, start);
    when start <= @2020-12-31;
    then section_179_limitation_increase_1397a(p, y, min(Section1397AAdditionalLimit, cost));
}
pub relation section_179_cost_taken_into_account_1397a(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1397A(a)(2): the amount taken into account under section 179(b)(2) for qualified zone property is 50 percent of its cost";
}
@source(IRC_S1397A_A, relation = formalizes, coverage = exact, quote = "shall be 50 percent of the cost thereof.")
rule Section179FiftyPercentRule(p: Person, y: TaxableYear, cost: Money, start: Date) defeasible {
    label en official "section 1397A(a)(2) and (c) (cents HALF_UP: JUDGMENT CALL)";
    when enterprise_zone_business_1397a(p);
    when qualified_zone_property_cost_placed_in_service(p, y, cost);
    when year_begins_1397a(y, start);
    when start <= @2020-12-31;
    then section_179_cost_taken_into_account_1397a(p, y, round(cost * 50 percent, 2, "HALF_UP"));
}
pub relation sale_of_qualified_empowerment_zone_asset(t: Transaction, p: Person, amount_realized: Money, sale_year_begins: Date) kind empirical {
    label en official "section 1397B(a): a sale of a qualified empowerment zone asset (with the first day of the taxable year of the sale)";
}
pub relation qez_asset_holding_period_months(t: Transaction, months: Integer) kind empirical {
    label en official "section 1397B(a), (b)(5): the holding period of the sold asset, determined without regard to section 1223, in complete months";
}
pub relation elects_1397b(t: Transaction, p: Person) kind empirical {
    label en official "section 1397B(a): the taxpayer elects the application of the section";
}
pub relation qez_replacement_cost_within_60_days(t: Transaction, amount: Money) kind empirical {
    label en official "section 1397B(a)(1): the cost of qualified empowerment zone assets (same zone) purchased during the 60-day period beginning on the date of the sale";
}
pub relation qez_replacement_cost_previously_used(t: Transaction, amount: Money) kind empirical {
    label en official "section 1397B(a)(2): any portion of the cost previously taken into account under this section";
}
pub relation gain_ordinary_or_attributable_to_non_integral_asset(t: Transaction) kind empirical {
    label en official "section 1397B(b)(2): the gain is treated as ordinary income, or is attributable to real property or an intangible asset not an integral part of an enterprise zone business";
}
pub relation section_1397b_recognized_gain(t: Transaction, amount: Money) kind institutional {
    label en official "section 1397B(a): the gain recognized on the sale";
}
@source(IRC_S1397B_A, relation = formalizes, coverage = partial, quote = "In the case of any sale of a qualified empowerment zone asset held by the taxpayer for more than 1 year and with respect to which such taxpayer elects the application of this section")
rule Section1397bRecognizedGainRule(t: Transaction, p: Person, realized: Money, start: Date, months: Integer, cost: Money, used: Money, gain: Money) defeasible {
    label en official "section 1397B(a) with (c): min(gain, amount realized - (cost - previously used)), for sales in taxable years beginning on or before December 31, 2020";
    when sale_of_qualified_empowerment_zone_asset(t, p, realized, start);
    when start <= @2020-12-31;
    when elects_1397b(t, p);
    when qez_asset_holding_period_months(t, months);
    when months > 12;
    when qez_replacement_cost_within_60_days(t, cost);
    when qez_replacement_cost_previously_used(t, used);
    when gain_realized(p, t, gain);
    when not_known(gain_ordinary_or_attributable_to_non_integral_asset(t));
    when realized > cost - used;
    then section_1397b_recognized_gain(t, min(gain, realized - (cost - used)));
}
rule Section1397bFullyReinvestedRule(t: Transaction, p: Person, realized: Money, start: Date, months: Integer, cost: Money, used: Money) defeasible {
    label en official "section 1397B(a): no gain recognized when the net replacement cost is at least the amount realized";
    when sale_of_qualified_empowerment_zone_asset(t, p, realized, start);
    when start <= @2020-12-31;
    when elects_1397b(t, p);
    when qez_asset_holding_period_months(t, months);
    when months > 12;
    when qez_replacement_cost_within_60_days(t, cost);
    when qez_replacement_cost_previously_used(t, used);
    when not_known(gain_ordinary_or_attributable_to_non_integral_asset(t));
    when realized <= cost - used;
    then section_1397b_recognized_gain(t, 0.00 USD);
}

// =============================================================================
// §1394: enterprise zone facility bonds
// =============================================================================

pub const ZoneFacilityBondPerZoneCap: Money = 3000000.00 USD {
    label en official "$3,000,000 with respect to any one empowerment zone or enterprise community (section 1394(c)(1)(A))";
};
pub const ZoneFacilityBondAllZonesCap: Money = 20000000.00 USD {
    label en official "$20,000,000 with respect to all empowerment zones and enterprise communities (section 1394(c)(1)(B))";
};
pub relation outstanding_zone_facility_bonds_for_one_zone(person: Person, amount: Money) kind empirical {
    label en official "section 1394(c)(1): the aggregate outstanding enterprise zone facility bonds allocable to the person for one zone, taking the issue into account";
}
pub relation outstanding_zone_facility_bonds_all_zones(person: Person, amount: Money) kind empirical {
    label en official "section 1394(c)(1): the aggregate outstanding enterprise zone facility bonds allocable to the person for all zones, taking the issue into account";
}
pub relation zone_facility_bond_issue_within_limits_1394c(person: Person) kind institutional {
    label en official "section 1394(c)(1): the issue does not exceed $3,000,000 for one zone and $20,000,000 for all zones";
}
@source(IRC_S1394_C, relation = formalizes, coverage = partial, quote = "Subsection (a) shall not apply to any issue if the aggregate amount of outstanding enterprise zone facility bonds allocable to any person (taking into account such issue) exceeds—")
rule ZoneFacilityBondLimitsRule(person: Person, one_zone: Money, all_zones: Money) defeasible {
    label en official "section 1394(c)(1)(A)-(B)";
    when outstanding_zone_facility_bonds_for_one_zone(person, one_zone);
    when outstanding_zone_facility_bonds_all_zones(person, all_zones);
    when one_zone <= ZoneFacilityBondPerZoneCap;
    when all_zones <= ZoneFacilityBondAllZonesCap;
    then zone_facility_bond_issue_within_limits_1394c(person);
}
pub relation empowerment_zone_population(area: NominatedArea, n: Integer) kind empirical {
    label en official "the population of the empowerment zone";
}
pub relation empowerment_zone_bond_designated_face_amount(area: NominatedArea, amount: Money) kind empirical {
    label en official "section 1394(f)(2)(B): the aggregate face amount of empowerment zone facility bonds designated for the zone";
}
pub relation empowerment_zone_bond_cap(area: NominatedArea, cap: Money) kind institutional {
    label en official "section 1394(f)(2)(B): $60,000,000 for a rural zone; $130,000,000 for an urban zone under 100,000 population; $230,000,000 for an urban zone of at least 100,000";
}
@source(IRC_S1394_F, relation = formalizes, coverage = exact, quote = "(i) $60,000,000 if such zone is in a rural area,")
rule ZoneBondCapRuralRule(area: NominatedArea) defeasible {
    label en official "section 1394(f)(2)(B)(i)";
    when rural_area_1393(area);
    then empowerment_zone_bond_cap(area, 60000000.00 USD);
}
rule ZoneBondCapUrbanSmallRule(area: NominatedArea, pop: Integer) defeasible {
    label en official "section 1394(f)(2)(B)(ii)";
    when urban_area_1393(area);
    when empowerment_zone_population(area, pop);
    when pop < 100000;
    then empowerment_zone_bond_cap(area, 130000000.00 USD);
}
rule ZoneBondCapUrbanLargeRule(area: NominatedArea, pop: Integer) defeasible {
    label en official "section 1394(f)(2)(B)(iii)";
    when urban_area_1393(area);
    when empowerment_zone_population(area, pop);
    when pop >= 100000;
    then empowerment_zone_bond_cap(area, 230000000.00 USD);
}
pub relation designated_bond_within_zone_cap(area: NominatedArea) kind institutional {
    label en official "section 1394(f)(2)(B): the designated face amount does not exceed the zone's cap";
}
rule DesignatedBondWithinCapRule(area: NominatedArea, face: Money, cap: Money) defeasible {
    label en official "section 1394(f)(2)(B)";
    when empowerment_zone_bond_designated_face_amount(area, face);
    when empowerment_zone_bond_cap(area, cap);
    when face <= cap;
    then designated_bond_within_zone_cap(area);
}
pub relation tract_poverty_rate_1394(tract: NominatedArea, rate: Decimal) kind empirical {
    label en official "section 1394(b)(3)(C)(i)(I): the poverty rate of the tract";
}
pub relation tract_income_share_of_statewide_or_metro_median(tract: NominatedArea, share: Decimal) kind empirical {
    label en official "section 1394(b)(3)(C)(i)(II): the tract's median family income as a share of the statewide (or metropolitan area) median";
}
pub relation tract_in_high_migration_rural_county(tract: NominatedArea) kind empirical {
    label en official "section 1394(b)(3)(C)(iv): the tract is in a high migration rural county not located within a metropolitan area (85 percent substituted for 80 percent)";
}
pub relation qualified_low_income_community_1394(tract: NominatedArea) kind institutional {
    label en official "section 1394(b)(3)(C)(i): a population census tract with a poverty rate of at least 20 percent, or a median family income of at most 80 percent (85 percent in a high-migration rural county) of the statewide or metropolitan median";
}
@source(IRC_S1394_B, relation = formalizes, coverage = partial, quote = "(I) the poverty rate for such tract is at least 20 percent, or")
rule QualifiedLowIncomePovertyRule(tract: NominatedArea, rate: Decimal) defeasible {
    label en official "section 1394(b)(3)(C)(i)(I)";
    when tract_poverty_rate_1394(tract, rate);
    when rate >= 0.20;
    then qualified_low_income_community_1394(tract);
}
rule QualifiedLowIncomeIncomeRule(tract: NominatedArea, share: Decimal) defeasible {
    label en official "section 1394(b)(3)(C)(i)(II): at most 80 percent of the median";
    when tract_income_share_of_statewide_or_metro_median(tract, share);
    when not_known(tract_in_high_migration_rural_county(tract));
    when share <= 0.80;
    then qualified_low_income_community_1394(tract);
}
rule QualifiedLowIncomeHighMigrationRule(tract: NominatedArea, share: Decimal) defeasible {
    label en official "section 1394(b)(3)(C)(iv): 85 percent in a high-migration rural county";
    when tract_income_share_of_statewide_or_metro_median(tract, share);
    when tract_in_high_migration_rural_county(tract);
    when share <= 0.85;
    then qualified_low_income_community_1394(tract);
}

// =============================================================================
// §1397C and §1397D: enterprise zone business and qualified zone property
// =============================================================================

pub entity ZoneBusiness : Person {
    label en official "a corporation, partnership or proprietorship tested as an enterprise zone business (section 1397C)";
}
pub relation every_trade_or_business_is_active_qualified_business_in_zone(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(b)(1): every trade or business of the entity is the active conduct of a qualified business within an empowerment zone";
}
pub relation gross_income_share_from_active_business(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "sections 1397C(b)(2), (c)(1): the share of total gross income derived from the active conduct of the business (in a zone for a proprietorship)";
}
pub relation substantial_tangible_property_use_in_zone(b: ZoneBusiness) kind empirical {
    label en official "sections 1397C(b)(3), (c)(2): a substantial portion of the use of tangible property (owned or leased) is within an empowerment zone";
}
pub relation substantial_intangible_property_used_in_business(b: ZoneBusiness) kind empirical {
    label en official "sections 1397C(b)(4), (c)(3): a substantial portion of the intangible property is used in the active conduct of the business";
}
pub relation substantial_employee_services_in_zone(b: ZoneBusiness) kind empirical {
    label en official "sections 1397C(b)(5), (c)(4): a substantial portion of the services performed by employees are performed in an empowerment zone";
}
pub relation employee_share_resident_in_zone(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "sections 1397C(b)(6), (c)(5): the share of employees (including the proprietor) who are residents of an empowerment zone";
}
pub relation collectibles_share_of_property_bases(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "sections 1397C(b)(7), (c)(6): the share of the average aggregate unadjusted bases attributable to collectibles (other than those held primarily for sale to customers)";
}
pub relation nonqualified_financial_property_share(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "sections 1397C(b)(8), (c)(7): the share of the average aggregate unadjusted bases attributable to nonqualified financial property";
}
pub relation zone_business_is_proprietorship(b: ZoneBusiness) kind empirical {
    label en official "the business is carried on by an individual as a proprietorship (section 1397C(c))";
}
pub relation enterprise_zone_business(b: ZoneBusiness) kind institutional {
    label en official "section 1397C(a): a qualified business entity or a qualified proprietorship";
}
@source(IRC_S1397C_B, relation = formalizes, coverage = partial, quote = "the term \"qualified business entity\" means, with respect to any taxable year, any corporation or partnership if for such year—")
rule QualifiedBusinessEntityRule(b: ZoneBusiness, income: Decimal, residents: Decimal, collectibles: Decimal, financial: Decimal) defeasible {
    label en official "section 1397C(b)(1)-(8); the (f) contiguous-property look-through is not applied (G2342)";
    when every_trade_or_business_is_active_qualified_business_in_zone(b);
    when gross_income_share_from_active_business(b, income);
    when income >= 0.50;
    when substantial_tangible_property_use_in_zone(b);
    when substantial_intangible_property_used_in_business(b);
    when substantial_employee_services_in_zone(b);
    when employee_share_resident_in_zone(b, residents);
    when residents >= 0.35;
    when collectibles_share_of_property_bases(b, collectibles);
    when collectibles < 0.05;
    when nonqualified_financial_property_share(b, financial);
    when financial < 0.05;
    when not_known(zone_business_is_proprietorship(b));
    then enterprise_zone_business(b);
}
@source(IRC_S1397C_C, relation = formalizes, coverage = partial, quote = "For purposes of this section, the term \"qualified proprietorship\" means, with respect to any taxable year, any qualified business carried on by an individual as a proprietorship if for such year—")
rule QualifiedProprietorshipRule(b: ZoneBusiness, income: Decimal, residents: Decimal, collectibles: Decimal, financial: Decimal) defeasible {
    label en official "section 1397C(c)(1)-(7)";
    when zone_business_is_proprietorship(b);
    when gross_income_share_from_active_business(b, income);
    when income >= 0.50;
    when substantial_tangible_property_use_in_zone(b);
    when substantial_intangible_property_used_in_business(b);
    when substantial_employee_services_in_zone(b);
    when employee_share_resident_in_zone(b, residents);
    when residents >= 0.35;
    when collectibles_share_of_property_bases(b, collectibles);
    when collectibles < 0.05;
    when nonqualified_financial_property_share(b, financial);
    when financial < 0.05;
    then enterprise_zone_business(b);
}
pub relation property_subject_to_depreciation_168_or_179(a: Asset) kind empirical {
    label en official "section 1397D(a)(1): property to which section 168 applies (or would apply but for section 179)";
}
pub relation zone_property_acquired_by_purchase_after_designation(a: Asset) kind empirical {
    label en official "section 1397D(a)(1)(A): acquired by the taxpayer by purchase (section 179(d)(2)) after the date the designation took effect";
}
pub relation zone_property_original_use_with_taxpayer(a: Asset) kind empirical {
    label en official "section 1397D(a)(1)(B): the original use of the property in the empowerment zone commences with the taxpayer";
}
pub relation zone_property_substantially_all_used_in_active_qualified_business(a: Asset) kind empirical {
    label en official "section 1397D(a)(1)(C): substantially all of the use is in an empowerment zone in the active conduct of a qualified business by the taxpayer";
}
pub relation zone_property_substantially_renovated(a: Asset) kind empirical {
    label en official "section 1397D(a)(2): the property is substantially renovated by the taxpayer, so (A) and (B) are treated as satisfied";
}
pub relation qualified_zone_property(a: Asset) kind institutional {
    label en official "section 1397D(a): qualified zone property";
}
@source(IRC_S1397D_A, relation = formalizes, coverage = partial, quote = "The term \"qualified zone property\" means any property to which section 168 applies (or would apply but for section 179) if—")
rule QualifiedZonePropertyRule(a: Asset) defeasible {
    label en official "section 1397D(a)(1)(A)-(C)";
    when property_subject_to_depreciation_168_or_179(a);
    when zone_property_acquired_by_purchase_after_designation(a);
    when zone_property_original_use_with_taxpayer(a);
    when zone_property_substantially_all_used_in_active_qualified_business(a);
    then qualified_zone_property(a);
}
rule QualifiedZonePropertyRenovatedRule(a: Asset) defeasible {
    label en official "section 1397D(a)(2): substantially renovated property meets (A) and (B)";
    when property_subject_to_depreciation_168_or_179(a);
    when zone_property_substantially_renovated(a);
    when zone_property_substantially_all_used_in_active_qualified_business(a);
    then qualified_zone_property(a);
}
