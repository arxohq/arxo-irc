// Stage 3 (IRC-07, A05). Section 1033 remainder (module 03 carries (a)(1), (a)(2)(A)-(B)
// and (b)(1)-(2)): the conversions the section treats as involuntary ((c), (d), (e)(1),
// (j)), the longer replacement periods ((e)(2), (g)(4), (h)(1)(B)), property deemed similar
// ((f), (g)(1), (h)(1)(A)(ii), (h)(2)), the disaster rules of (h), the related-person limit
// of (i), the assessment periods of (a)(2)(C)-(D) and the basis push-down of (b)(3).
//
// Method. The derived relations that module 03's strict rules read (a treated conversion,
// the replacement period, the (i) limit) are themselves derived by strict rules, so the
// strict rules of module 03 can read them. The two aggregates of (b)(3) (the adjusted bases
// of one class of property) are case totals (the section 111 subset limit).

// =============================================================================
// Conversions treated as involuntary: (c), (d), (e)(1), (j)
// =============================================================================

use self::{
    Asset,
    IRC_S1033_A,
    IRC_S1033_B,
    IRC_S1033_C,
    IRC_S1033_D,
    IRC_S1033_E,
    IRC_S1033_F,
    IRC_S1033_G,
    IRC_S1033_H,
    IRC_S1033_I,
    IRC_S1033_J,
    Person,
    TaxableYear,
    Transaction,
    close_of_realization_taxable_year,
    disposition_of_converted_property_on,
    elects_to_replace_converted_property,
    involuntary_conversion,
    replacement_period_end,
    replacement_period_extended_by_secretary,
    replacement_purchased_on,
};

pub relation reclamation_law_acreage_disposition(t: Transaction, p: Person, a: Asset) kind empirical {
    label en official "section 1033(c): property lying within an irrigation project is sold or otherwise disposed of in order to conform to the acreage limitation provisions of Federal reclamation laws";
}
pub relation livestock_destroyed_or_sold_because_of_disease(t: Transaction, p: Person, a: Asset) kind empirical {
    label en official "section 1033(d): livestock destroyed by or on account of disease, or sold or exchanged because of disease";
}
pub relation livestock_sold_solely_for_weather_conditions(t: Transaction, p: Person, a: Asset) kind empirical {
    label en official "section 1033(e)(1): livestock (other than poultry) held for draft, breeding or dairy purposes sold or exchanged solely on account of drought, flood or other weather-related conditions";
}
pub relation number_sold_in_excess_of_usual_business_practice(t: Transaction, excess: Integer) kind empirical {
    label en official "section 1033(e)(1): the number of animals sold in excess of the number the taxpayer would sell if he followed his usual business practices";
}
pub relation hazard_mitigation_transfer_to_government(t: Transaction, p: Person, a: Asset) kind empirical {
    label en official "section 1033(j): property sold or otherwise transferred to the Federal Government, a State or local government, or an Indian tribal government to implement hazard mitigation under the Stafford Act or the National Flood Insurance Act";
}
pub relation treated_as_involuntary_conversion(t: Transaction, p: Person, converted: Asset) kind institutional {
    label en official "section 1033(a), (c), (d), (e)(1), (j): the disposition is a compulsory or involuntary conversion to which the section applies";
}
rule TreatedBaseRule(t: Transaction, p: Person, converted: Asset) strict {
    label en official "section 1033(a): destruction, theft, seizure, requisition or condemnation, or threat or imminence thereof";
    when involuntary_conversion(t, p, converted);
    then treated_as_involuntary_conversion(t, p, converted);
}
@source(IRC_S1033_C, relation = formalizes, coverage = exact, quote = "For purposes of this subtitle, if property lying within an irrigation project is sold or otherwise disposed of in order to conform to the acreage limitation provisions of Federal reclamation laws, such sale or disposition shall be treated as an involuntary conversion to which this section applies.")
rule TreatedReclamationRule(t: Transaction, p: Person, converted: Asset) strict {
    label en official "section 1033(c)";
    when reclamation_law_acreage_disposition(t, p, converted);
    then treated_as_involuntary_conversion(t, p, converted);
}
@source(IRC_S1033_D, relation = formalizes, coverage = exact, quote = "For purposes of this subtitle, if livestock are destroyed by or on account of disease, or are sold or exchanged because of disease, such destruction or such sale or exchange shall be treated as an involuntary conversion to which this section applies.")
rule TreatedDiseaseRule(t: Transaction, p: Person, converted: Asset) strict {
    label en official "section 1033(d)";
    when livestock_destroyed_or_sold_because_of_disease(t, p, converted);
    then treated_as_involuntary_conversion(t, p, converted);
}
@source(IRC_S1033_E, relation = formalizes, coverage = exact, quote = "For purposes of this subtitle, the sale or exchange of livestock (other than poultry) held by a taxpayer for draft, breeding, or dairy purposes in excess of the number the taxpayer would sell if he followed his usual business practices shall be treated as an involuntary conversion to which this section applies if such livestock are sold or exchanged by the taxpayer solely on account of drought, flood, or other weather-related conditions.")
rule TreatedWeatherLivestockRule(t: Transaction, p: Person, converted: Asset, excess: Integer) strict {
    label en official "section 1033(e)(1): the excess over the usual business practice";
    when livestock_sold_solely_for_weather_conditions(t, p, converted);
    when number_sold_in_excess_of_usual_business_practice(t, excess);
    when excess > 0;
    then treated_as_involuntary_conversion(t, p, converted);
}
@source(IRC_S1033_J, relation = formalizes, coverage = exact, quote = "For purposes of this subtitle, if property is sold or otherwise transferred to the Federal Government, a State or local government, or an Indian tribal government to implement hazard mitigation under the Robert T. Stafford Disaster Relief and Emergency Assistance Act (as in effect on the date of the enactment of this subsection) or the National Flood Insurance Act (as in effect on such date), such sale or transfer shall be treated as an involuntary conversion to which this section applies.")
rule TreatedHazardMitigationRule(t: Transaction, p: Person, converted: Asset) strict {
    label en official "section 1033(j)";
    when hazard_mitigation_transfer_to_government(t, p, converted);
    then treated_as_involuntary_conversion(t, p, converted);
}

// =============================================================================
// Longer replacement periods: (e)(2), (g)(4), (h)(1)(B)
// =============================================================================

pub relation weather_conversion_in_area_designated_for_federal_assistance(t: Transaction) kind empirical {
    label en official "section 1033(e)(2)(A): the weather-related conditions result in the area being designated as eligible for assistance by the Federal Government";
}
pub relation condemnation_of_real_property_1033g1(t: Transaction) kind empirical {
    label en official "section 1033(g)(1): real property (not stock in trade) held for productive use or investment is converted by seizure, requisition or condemnation, or threat or imminence thereof";
}
pub relation principal_residence_converted_in_federally_declared_disaster(t: Transaction) kind empirical {
    label en official "section 1033(h)(1): the taxpayer's principal residence or any of its contents, located in a disaster area, is converted as a result of a federally declared disaster";
}
pub relation replacement_period_years_1033(t: Transaction, years: Integer) kind institutional {
    label en official "section 1033(a)(2)(B)(i), (e)(2)(A), (g)(4), (h)(1)(B): the number of years after the close of the first year of realization - 2, or 3 for condemned real property, or 4 for weather livestock in a designated area and for a principal residence in a federally declared disaster";
}
rule ReplacementYears4WeatherRule(t: Transaction) strict {
    label en official "section 1033(e)(2)(A)";
    when weather_conversion_in_area_designated_for_federal_assistance(t);
    then replacement_period_years_1033(t, 4);
}
rule ReplacementYears4ResidenceRule(t: Transaction) strict {
    label en official "section 1033(h)(1)(B)";
    when principal_residence_converted_in_federally_declared_disaster(t);
    then replacement_period_years_1033(t, 4);
}
rule ReplacementYears3CondemnationRule(t: Transaction) strict {
    label en official "section 1033(g)(4), unless a 4-year period also applies";
    when condemnation_of_real_property_1033g1(t);
    when not_known(weather_conversion_in_area_designated_for_federal_assistance(t));
    when not_known(principal_residence_converted_in_federally_declared_disaster(t));
    then replacement_period_years_1033(t, 3);
}
pub relation longer_replacement_period_applies_1033(t: Transaction) kind institutional {
    label en official "a period longer than 2 years applies";
}
rule LongerPeriodRule(t: Transaction, years: Integer) strict {
    label en unofficial "helper";
    when replacement_period_years_1033(t, years);
    then longer_replacement_period_applies_1033(t);
}
@source(IRC_S1033_G, relation = formalizes, coverage = exact, quote = "In the case of a compulsory or involuntary conversion described in paragraph (1), subsection (a)(2)(B)(i) shall be applied by substituting \"3 years\" for \"2 years\".")
rule ReplacementEndLongerRule(t: Transaction, disposed_on: Date, close_of_year: Date, years: Integer) strict {
    label en official "section 1033(a)(2)(B)(i) with the (e)(2)(A), (g)(4) and (h)(1)(B) years: 3 or 4 years after the close of the first year of realization";
    when disposition_of_converted_property_on(t, disposed_on);
    when close_of_realization_taxable_year(t, close_of_year);
    when replacement_period_years_1033(t, years);
    when years == 3;
    when not_known(replacement_period_extended_by_secretary(t));
    then replacement_period_end(t, disposed_on, add_calendar_period(close_of_year, 3 calendar_year));
}
rule ReplacementEndFourYearsRule(t: Transaction, disposed_on: Date, close_of_year: Date, years: Integer) strict {
    label en official "section 1033(e)(2)(A), (h)(1)(B): 4 years after the close of the first year of realization";
    when disposition_of_converted_property_on(t, disposed_on);
    when close_of_realization_taxable_year(t, close_of_year);
    when replacement_period_years_1033(t, years);
    when years == 4;
    when not_known(replacement_period_extended_by_secretary(t));
    then replacement_period_end(t, disposed_on, add_calendar_period(close_of_year, 4 calendar_year));
}
pub relation regional_extension_by_secretary_date(t: Transaction, on: Date) kind empirical {
    label en official "section 1033(e)(2)(B): the date to which the Secretary extends on a regional basis the replacement period, because the weather-related conditions continue for more than 3 years";
}
pub relation regional_extension_permitted_1033e2B(t: Transaction) kind institutional {
    label en official "section 1033(e)(2)(B): the Secretary may extend the period after the 4-year rule where the conditions continue for more than 3 years";
}
pub relation weather_conditions_continue_more_than_3_years(t: Transaction) kind empirical {
    label en official "section 1033(e)(2)(B): the weather-related conditions continue for more than 3 years";
}
@source(IRC_S1033_E, relation = formalizes, coverage = exact, quote = "The Secretary may extend on a regional basis the period for replacement under this section (after the application of subparagraph (A)) for such additional time as the Secretary determines appropriate if the weather-related conditions which resulted in such application continue for more than 3 years.")
rule RegionalExtensionRule(t: Transaction) defeasible {
    label en official "section 1033(e)(2)(B): a power of the Secretary, exposed as a permitted extension (the date is a case fact)";
    when weather_conversion_in_area_designated_for_federal_assistance(t);
    when weather_conditions_continue_more_than_3_years(t);
    then regional_extension_permitted_1033e2B(t);
}

// =============================================================================
// Property deemed similar or related in service or use: (f), (g)(1), (h)
// =============================================================================

pub relation livestock_conversion_proceeds_not_feasible_to_reinvest_in_livestock(t: Transaction) kind empirical {
    label en official "section 1033(f): because of drought, flood or other weather-related conditions, or soil or other environmental contamination, it is not feasible to reinvest the proceeds of converted livestock in property similar or related in use to the livestock (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation replacement_used_for_farming_purposes(replacement: Asset) kind empirical {
    label en official "section 1033(f): the other property (including real property in the case of contamination) is used for farming purposes";
}
pub relation replacement_treated_as_similar_1033(t: Transaction, replacement: Asset) kind institutional {
    label en official "section 1033(f), (g)(1), (h)(1)(A)(ii)(II), (h)(2): the replacement property is treated as similar or related in service or use to the converted property";
}
@source(IRC_S1033_F, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a), if, because of drought, flood, or other weather-related conditions, or soil contamination or other environmental contamination, it is not feasible for the taxpayer to reinvest the proceeds from compulsorily or involuntarily converted livestock in property similar or related in use to the livestock so converted, other property (including real property in the case of soil contamination or other environmental contamination) used for farming purposes shall be treated as property similar or related in service or use to the livestock so converted.")
rule SimilarFarmPropertyRule(t: Transaction, replacement: Asset) strict {
    label en official "section 1033(f)";
    when livestock_conversion_proceeds_not_feasible_to_reinvest_in_livestock(t);
    when replacement_used_for_farming_purposes(replacement);
    then replacement_treated_as_similar_1033(t, replacement);
}
pub relation replacement_is_like_kind_real_property_held_for_use_or_investment(replacement: Asset) kind empirical {
    label en official "section 1033(g)(1): property of a like kind to be held either for productive use in trade or business or for investment";
}
pub relation replacement_is_purchase_of_stock_for_control_1033a2A(replacement: Asset) kind empirical {
    label en official "section 1033(g)(2): the replacement is the purchase of stock in the acquisition of control of a corporation described in subsection (a)(2)(A)";
}
@source(IRC_S1033_G, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a), if real property (not including stock in trade or other property held primarily for sale) held for productive use in trade or business or for investment is (as the result of its seizure, requisition, or condemnation, or threat or imminence thereof) compulsorily or involuntarily converted, property of a like kind to be held either for productive use in trade or business or for investment shall be treated as property similar or related in service or use to the property so converted.")
rule SimilarLikeKindRealPropertyRule(t: Transaction, replacement: Asset) strict {
    label en official "section 1033(g)(1), (2): like kind real property, but not stock in the acquisition of control";
    when condemnation_of_real_property_1033g1(t);
    when replacement_is_like_kind_real_property_held_for_use_or_investment(replacement);
    when not_known(replacement_is_purchase_of_stock_for_control_1033a2A(replacement));
    then replacement_treated_as_similar_1033(t, replacement);
}
pub relation converted_property_is_outdoor_advertising_display_treated_as_real(a: Asset) kind empirical {
    label en official "section 1033(g)(3): the converted property is an outdoor advertising display (a rigidly assembled sign, display or device permanently affixed to the ground or to a structure, used to display an advertisement to the public) that the taxpayer treats as real property by election";
}
pub relation replacement_is_interest_in_real_property(replacement: Asset) kind empirical {
    label en official "section 1033(g)(3)(D): an interest in real property purchased as replacement for a converted outdoor advertising display (whether or not the same kind of interest)";
}
@source(IRC_S1033_G, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, an interest in real property purchased as replacement property for a compulsorily or involuntarily converted outdoor advertising display defined in subparagraph (C) (and treated by the taxpayer as real property) shall be considered property of a like kind as the property converted without regard to whether the taxpayer's interest in the replacement property is the same kind of interest the taxpayer held in the converted property.")
rule SimilarOutdoorAdvertisingRule(t: Transaction, converted: Asset, replacement: Asset, p: Person) strict {
    label en official "section 1033(g)(3)(D)";
    when treated_as_involuntary_conversion(t, p, converted);
    when converted_property_is_outdoor_advertising_display_treated_as_real(converted);
    when replacement_is_interest_in_real_property(replacement);
    then replacement_treated_as_similar_1033(t, replacement);
}
pub relation elects_outdoor_advertising_as_real_property(p: Person, a: Asset) kind empirical {
    label en official "section 1033(g)(3)(A): the taxpayer elects to treat an outdoor advertising display as real property";
}
pub relation section_179_election_in_effect_for(a: Asset) kind empirical {
    label en official "section 1033(g)(3)(A): an election under section 179(a) is in effect for the property";
}
pub relation outdoor_advertising_election_available_1033g3(p: Person, a: Asset) kind institutional {
    label en unofficial "single-atom helper for valid_when: no section 179(a) election is in effect for the property";
}
rule OutdoorAdvertisingAvailableRule(p: Person, a: Asset) defeasible {
    label en official "section 1033(g)(3)(A), second sentence";
    when elects_outdoor_advertising_as_real_property(p, a);
    when not_known(section_179_election_in_effect_for(a));
    then outdoor_advertising_election_available_1033g3(p, a);
}
pub relation outdoor_advertising_treated_as_real_property_1033g3(p: Person, a: Asset) kind institutional {
    label en official "section 1033(g)(3): the outdoor advertising display is treated as real property for purposes of the chapter";
}
@source(IRC_S1033_G, relation = formalizes, coverage = exact, quote = "A taxpayer may elect, at such time and in such manner as the Secretary may prescribe, to treat property which constitutes an outdoor advertising display as real property for purposes of this chapter.")
rule Section1033g3ElectionPower(p: Person, a: Asset) strict {
    label en official "section 1033(g)(3)(A): the election is a power of the taxpayer over the property (not available with a section 179(a) election)";
    when elects_outdoor_advertising_as_real_property(p, a);
    then power Section1033g3Election {
        holder p;
        over a;
        exercise elects_outdoor_advertising_as_real_property(p, a);
        valid_when outdoor_advertising_election_available_1033g3(p, a);
        effect create(outdoor_advertising_treated_as_real_property_1033g3(p, a));
        window [@1984-07-18, infinity);
    };
}
pub relation revokes_outdoor_advertising_election(p: Person, a: Asset) kind empirical {
    label en official "section 1033(g)(3)(B): the taxpayer revokes the election";
}
pub relation secretary_consented_to_revocation_1033g3B(p: Person, a: Asset) kind empirical {
    label en official "section 1033(g)(3)(B): the Secretary consents to the revocation";
}
pub relation outdoor_advertising_revocation_effective(p: Person, a: Asset) kind institutional {
    label en official "section 1033(g)(3)(B): an election may not be revoked without the consent of the Secretary";
}
@source(IRC_S1033_G, relation = formalizes, coverage = exact, quote = "An election made under subparagraph (A) may not be revoked without the consent of the Secretary.")
rule RevocationWithConsentRule(p: Person, a: Asset) defeasible {
    label en official "section 1033(g)(3)(B)";
    when outdoor_advertising_treated_as_real_property_1033g3(p, a);
    when revokes_outdoor_advertising_election(p, a);
    when secretary_consented_to_revocation_1033g3B(p, a);
    then outdoor_advertising_revocation_effective(p, a);
}
// (h)
pub relation converted_contents_are_unscheduled_personal_property(a: Asset) kind empirical {
    label en official "section 1033(h)(1)(A)(i): the property is personal property that was part of the residence's contents and was not scheduled property for purposes of the insurance";
}
pub relation insurance_proceeds_received_for(t: Transaction, a: Asset) kind empirical {
    label en official "insurance proceeds are received for the property";
}
pub relation no_gain_on_unscheduled_contents_proceeds_1033h1Ai(t: Transaction, a: Asset) kind institutional {
    label en official "section 1033(h)(1)(A)(i): no gain is recognized by reason of the receipt of insurance proceeds for unscheduled personal property that was part of the contents";
}
@source(IRC_S1033_H, relation = formalizes, coverage = exact, quote = "No gain shall be recognized by reason of the receipt of any insurance proceeds for personal property which was part of such contents and which was not scheduled property for purposes of such insurance.")
rule NoGainUnscheduledContentsRule(t: Transaction, a: Asset) defeasible {
    label en official "section 1033(h)(1)(A)(i)";
    when principal_residence_converted_in_federally_declared_disaster(t);
    when converted_contents_are_unscheduled_personal_property(a);
    when insurance_proceeds_received_for(t, a);
    then no_gain_on_unscheduled_contents_proceeds_1033h1Ai(t, a);
}
pub relation other_insurance_proceeds_for_residence_or_contents(t: Transaction) kind empirical {
    label en official "section 1033(h)(1)(A)(ii): insurance proceeds (not described in clause (i)) for the residence or contents";
}
pub relation proceeds_treated_as_single_item_conversion_1033h1Aii(t: Transaction) kind institutional {
    label en official "section 1033(h)(1)(A)(ii)(I): such proceeds are treated as received for the conversion of a single item of property";
}
@source(IRC_S1033_H, relation = formalizes, coverage = exact, quote = "(I) such proceeds shall be treated as received for the conversion of a single item of property, and")
rule CommonFundRule(t: Transaction) strict {
    label en official "section 1033(h)(1)(A)(ii)(I)";
    when principal_residence_converted_in_federally_declared_disaster(t);
    when other_insurance_proceeds_for_residence_or_contents(t);
    then proceeds_treated_as_single_item_conversion_1033h1Aii(t);
}
pub relation replacement_similar_to_residence_or_contents(t: Transaction, replacement: Asset) kind empirical {
    label en official "section 1033(h)(1)(A)(ii)(II): the property is similar or related in service or use to the residence so converted (or its contents)";
}
@source(IRC_S1033_H, relation = formalizes, coverage = exact, quote = "(II) any property which is similar or related in service or use to the residence so converted (or contents thereof) shall be treated for purposes of subsection (a)(2) as property similar or related in service or use to such single item of property.")
rule CommonFundSimilarRule(t: Transaction, replacement: Asset) strict {
    label en official "section 1033(h)(1)(A)(ii)(II)";
    when proceeds_treated_as_single_item_conversion_1033h1Aii(t);
    when replacement_similar_to_residence_or_contents(t, replacement);
    then replacement_treated_as_similar_1033(t, replacement);
}
pub relation trade_or_business_or_investment_property_in_disaster_area_converted(t: Transaction) kind empirical {
    label en official "section 1033(h)(2): property held for productive use in a trade or business or for investment, located in a disaster area, is converted as a result of a federally declared disaster";
}
pub relation replacement_is_tangible_property_of_type_held_for_business_use(replacement: Asset) kind empirical {
    label en official "section 1033(h)(2): tangible property of a type held for productive use in a trade or business";
}
@source(IRC_S1033_H, relation = formalizes, coverage = exact, quote = "If a taxpayer's property held for productive use in a trade or business or for investment is located in a disaster area and is compulsorily or involuntarily converted as a result of a federally declared disaster, tangible property of a type held for productive use in a trade or business shall be treated for purposes of subsection (a) as property similar or related in service or use to the property so converted.")
rule SimilarDisasterBusinessPropertyRule(t: Transaction, replacement: Asset) strict {
    label en official "section 1033(h)(2)";
    when trade_or_business_or_investment_property_in_disaster_area_converted(t);
    when replacement_is_tangible_property_of_type_held_for_business_use(replacement);
    then replacement_treated_as_similar_1033(t, replacement);
}
pub relation residence_not_treated_as_principal_only_because_not_owned(p: Person) kind empirical {
    label en official "section 1033(h)(4): the residence is not treated as a principal residence under section 121 solely because the taxpayer does not own it";
}
pub relation principal_residence_under_section_121(p: Person, residence: Asset) kind empirical {
    label en official "section 1033(h)(4): the residence is the taxpayer's principal residence within the meaning of section 121 (owner: gross-income)";
}
pub relation principal_residence_1033h4(p: Person, residence: Asset) kind institutional {
    label en official "section 1033(h)(4): a principal residence - as in section 121, and a residence not so treated solely because the taxpayer does not own it";
}
rule PrincipalResidenceRule(p: Person, residence: Asset) defeasible {
    label en official "section 1033(h)(4), section 121 limb";
    when principal_residence_under_section_121(p, residence);
    then principal_residence_1033h4(p, residence);
}
pub relation residence_would_be_principal_but_for_ownership(p: Person, residence: Asset) kind empirical {
    label en official "section 1033(h)(4): the residence would be treated as the principal residence but for the taxpayer not owning it";
}
rule PrincipalResidenceNotOwnedRule(p: Person, residence: Asset) defeasible {
    label en official "section 1033(h)(4), non-owner limb";
    when residence_would_be_principal_but_for_ownership(p, residence);
    then principal_residence_1033h4(p, residence);
}

// =============================================================================
// (i): replacement property from a related person
// =============================================================================

pub relation taxpayer_is_c_corporation_1033i(p: Person) kind empirical {
    label en official "section 1033(i)(2)(A): the taxpayer is a C corporation";
}
pub relation partnership_with_c_corporation_owners_over_50_percent(p: Person, share: Decimal) kind empirical {
    label en official "section 1033(i)(2)(B): the share of the capital or profits interest that C corporations own, directly or indirectly (section 707(b)(3)), at the time of the conversion";
}
pub relation realized_gain_on_converted_property_in_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1033(i)(2)(C): the aggregate of the realized gain on the involuntarily converted property (on which there is realized gain) in the taxable year";
}
pub relation taxpayer_is_partner_or_shareholder_of_entity_over_threshold(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1033(i)(2), last sentences: the entity (partnership or S corporation) has realized gain above $100,000 and the taxpayer is a partner or shareholder";
}
pub relation subsection_i_applies_to_taxpayer(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1033(i)(2): the subsection applies to the taxpayer";
}
rule IApplyCCorpRule(p: Person, y: TaxableYear, gain: Money) strict {
    label en official "section 1033(i)(2)(A)";
    when taxpayer_is_c_corporation_1033i(p);
    when realized_gain_on_converted_property_in_year(p, y, gain);
    then subsection_i_applies_to_taxpayer(p, y);
}
rule IApplyPartnershipRule(p: Person, y: TaxableYear, share: Decimal, gain: Money) strict {
    label en official "section 1033(i)(2)(B)";
    when partnership_with_c_corporation_owners_over_50_percent(p, share);
    when share > 0.50;
    when realized_gain_on_converted_property_in_year(p, y, gain);
    then subsection_i_applies_to_taxpayer(p, y);
}
rule IApplyOtherRule(p: Person, y: TaxableYear, gain: Money) strict {
    label en official "section 1033(i)(2)(C): realized gain above $100,000";
    when realized_gain_on_converted_property_in_year(p, y, gain);
    when gain > 100000.00 USD;
    then subsection_i_applies_to_taxpayer(p, y);
}
rule IApplyEntityOwnerRule(p: Person, y: TaxableYear) strict {
    label en official "section 1033(i)(2), last sentences: a partner or shareholder of an entity over the threshold";
    when taxpayer_is_partner_or_shareholder_of_entity_over_threshold(p, y);
    then subsection_i_applies_to_taxpayer(p, y);
}
pub relation replacement_acquired_from_related_person(t: Transaction) kind empirical {
    label en official "section 1033(i)(1): the replacement property or stock is acquired from a person related to the taxpayer (section 267(b) or 707(b)(1))";
}
pub relation related_person_acquired_from_unrelated_in_replacement_period(t: Transaction) kind empirical {
    label en official "section 1033(i)(1), second sentence: the related person acquired the replacement property or stock from an unrelated person during the replacement period";
}
pub relation section_1033a_unavailable_by_related_acquisition(t: Transaction) kind institutional {
    label en official "section 1033(i)(1): subsection (a) does not apply because the replacement property or stock is acquired from a related person";
}
@source(IRC_S1033_I, relation = formalizes, coverage = exact, quote = "If the property which is involuntarily converted is held by a taxpayer to which this subsection applies, subsection (a) shall not apply if the replacement property or stock is acquired from a related person.")
rule UnavailableRule(t: Transaction, p: Person, y: TaxableYear) strict {
    label en official "section 1033(i)(1)";
    when replacement_acquired_from_related_person(t);
    when subsection_i_applies_to_taxpayer(p, y);
    when not_known(related_person_acquired_from_unrelated_in_replacement_period(t));
    then section_1033a_unavailable_by_related_acquisition(t);
}
pub relation taxpayer_and_year_of_conversion(t: Transaction, p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer and the taxable year of the conversion";
}

// =============================================================================
// (a)(2)(C)-(D): assessment
// =============================================================================

pub relation secretary_notified_on(t: Transaction, on: Date) kind empirical {
    label en official "section 1033(a)(2)(C)(i): the date the Secretary is notified by the taxpayer of the replacement of the converted property or of an intention not to replace";
}
pub relation assessment_period_floor_1033a2C(t: Transaction, on: Date) kind institutional {
    label en official "section 1033(a)(2)(C)(i): the statutory period for assessing a deficiency attributable to the gain does not expire before the date 3 years after the notification (the general period is the assessment owner's)";
}
@source(IRC_S1033_A, relation = formalizes, coverage = exact, quote = "(i) the statutory period for the assessment of any deficiency, for any taxable year in which any part of the gain on such conversion is realized, attributable to such gain shall not expire prior to the expiration of 3 years from the date the Secretary is notified by the taxpayer (in such manner as the Secretary may by regulations prescribe) of the replacement of the converted property or of an intention not to replace, and")
rule AssessmentFloorRule(t: Transaction, notified: Date, p: Person) strict {
    label en official "section 1033(a)(2)(C)(i)";
    when elects_to_replace_converted_property(p, t);
    when secretary_notified_on(t, notified);
    then assessment_period_floor_1033a2C(t, add_calendar_period(notified, 3 calendar_year));
}
pub relation assessment_permitted_notwithstanding_6212c(t: Transaction) kind institutional {
    label en official "section 1033(a)(2)(C)(ii): the deficiency may be assessed within the 3-year period notwithstanding section 6212(c) or any other law that would prevent the assessment";
}
@source(IRC_S1033_A, relation = formalizes, coverage = exact, quote = "(ii) such deficiency may be assessed before the expiration of such 3–year period notwithstanding the provisions of section 6212(c) or the provisions of any other law or rule of law which would otherwise prevent such assessment.")
rule AssessmentPermittedRule(t: Transaction, p: Person, on: Date) strict {
    label en official "section 1033(a)(2)(C)(ii)";
    when elects_to_replace_converted_property(p, t);
    when assessment_period_floor_1033a2C(t, on);
    then assessment_permitted_notwithstanding_6212c(t);
}
pub relation last_gain_year_begins(t: Transaction, on: Date) kind empirical {
    label en official "section 1033(a)(2)(D): the beginning of the last taxable year in which any part of the gain upon the conversion is realized";
}
pub relation last_year_assessment_period_ends(t: Transaction, on: Date) kind empirical {
    label en official "section 1033(a)(2)(D): the end of the period within which a deficiency for the last taxable year may be assessed";
}
pub relation earlier_deficiency_assessment_deadline_1033a2D(t: Transaction, on: Date) kind institutional {
    label en official "section 1033(a)(2)(D): a deficiency resulting from the election for a year ending before the last year may be assessed at any time before the assessment period of the last year expires";
}
@source(IRC_S1033_A, relation = formalizes, coverage = exact, quote = "If the election provided in subparagraph (A) is made by the taxpayer and such other property or such stock was purchased before the beginning of the last taxable year in which any part of the gain upon such conversion is realized, any deficiency, to the extent resulting from such election, for any taxable year ending before such last taxable year may be assessed (notwithstanding the provisions of section 6212(c) or 6501 or the provisions of any other law or rule of law which would otherwise prevent such assessment) at any time before the expiration of the period within which a deficiency for such last taxable year may be assessed.")
rule EarlierDeficiencyRule(t: Transaction, p: Person, purchased: Date, begins: Date, ends: Date) strict {
    label en official "section 1033(a)(2)(D)";
    when elects_to_replace_converted_property(p, t);
    when replacement_purchased_on(t, purchased);
    when last_gain_year_begins(t, begins);
    when purchased < begins;
    when last_year_assessment_period_ends(t, ends);
    then earlier_deficiency_assessment_deadline_1033a2D(t, ends);
}

// =============================================================================
// (b)(3): the basis of the property of a corporation whose stock is the replacement
// =============================================================================

pub relation basis_decrease_of_replacement_stock_1033b2(t: Transaction, amount: Money) kind empirical {
    label en official "section 1033(b)(3)(A): the decrease in the basis of the stock under paragraph (2)";
}
pub relation aggregate_adjusted_basis_of_corporate_property_at_control(t: Transaction, amount: Money) kind empirical {
    label en official "section 1033(b)(3)(B): the aggregate adjusted bases of the property held by the corporation at the time the taxpayer acquired control";
}
pub relation taxpayer_adjusted_basis_of_stock_after_decrease(t: Transaction, amount: Money) kind empirical {
    label en official "section 1033(b)(3)(B): the taxpayer's adjusted basis of the stock, determined immediately after the decrease under paragraph (2)";
}
pub relation corporate_basis_reduction_1033b3(t: Transaction, amount: Money) kind institutional {
    label en official "section 1033(b)(3)(A)-(B): the reduction of the basis of the corporation's property - the stock decrease, not below the taxpayer's adjusted basis of the stock (cents exact)";
}
@source(IRC_S1033_B, relation = formalizes, coverage = exact, quote = "If the basis of stock in a corporation is decreased under paragraph (2), an amount equal to such decrease shall also be applied to reduce the basis of property held by the corporation at the time the taxpayer acquired control (as defined in subsection (a)(2)(E)) of such corporation.")
rule CorporateReductionFullRule(t: Transaction, decrease: Money, aggregate: Money, stock: Money) defeasible {
    label en official "section 1033(b)(3)(A): the whole decrease when the aggregate bases stay at or above the stock basis";
    when basis_decrease_of_replacement_stock_1033b2(t, decrease);
    when aggregate_adjusted_basis_of_corporate_property_at_control(t, aggregate);
    when taxpayer_adjusted_basis_of_stock_after_decrease(t, stock);
    when aggregate - decrease >= stock;
    then corporate_basis_reduction_1033b3(t, decrease);
}
@source(IRC_S1033_B, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to the extent that it would (but for this subparagraph) require a reduction in the aggregate adjusted bases of the property of the corporation below the taxpayer's adjusted basis of the stock in the corporation (determined immediately after such basis is decreased under paragraph (2)).")
rule CorporateReductionLimitedRule(t: Transaction, decrease: Money, aggregate: Money, stock: Money) defeasible {
    label en official "section 1033(b)(3)(B): the reduction stops at the stock basis";
    when basis_decrease_of_replacement_stock_1033b2(t, decrease);
    when aggregate_adjusted_basis_of_corporate_property_at_control(t, aggregate);
    when taxpayer_adjusted_basis_of_stock_after_decrease(t, stock);
    when aggregate - decrease < stock;
    when aggregate > stock;
    then corporate_basis_reduction_1033b3(t, aggregate - stock);
}
rule CorporateReductionNoneRule(t: Transaction, decrease: Money, aggregate: Money, stock: Money) defeasible {
    label en official "section 1033(b)(3)(B): the aggregate bases are already at or below the stock basis";
    when basis_decrease_of_replacement_stock_1033b2(t, decrease);
    when aggregate_adjusted_basis_of_corporate_property_at_control(t, aggregate);
    when taxpayer_adjusted_basis_of_stock_after_decrease(t, stock);
    when aggregate <= stock;
    then corporate_basis_reduction_1033b3(t, 0.00 USD);
}
pub relation class_adjusted_basis_total(t: Transaction, class: Integer, amount: Money) kind empirical {
    label en official "section 1033(b)(3)(C), (D): the aggregate adjusted bases (without the reduction) of the corporation's property in the class - 1 similar or related to the converted property, 2 other depreciable property (section 1017(b)(3)(B)), 3 other property (a case total: a sum over the property of the class)";
}
pub relation class1_reduction_1033b3(t: Transaction, amount: Money) kind institutional {
    label en official "section 1033(b)(3)(C)(i): the reduction allocated first to property similar or related in service or use to the converted property, not above its adjusted bases";
}
pub relation class2_reduction_1033b3(t: Transaction, amount: Money) kind institutional {
    label en official "section 1033(b)(3)(C)(ii): the reduction allocated second to depreciable property (section 1017(b)(3)(B)) not in the first class";
}
pub relation class3_reduction_1033b3(t: Transaction, amount: Money) kind institutional {
    label en official "section 1033(b)(3)(C)(iii): the reduction allocated then to other property";
}
@source(IRC_S1033_B, relation = formalizes, coverage = exact, quote = "(i) first to property which is similar or related in service or use to the converted property,")
rule Class1ReductionRule(t: Transaction, r: Money, b1: Money) defeasible {
    label en official "section 1033(b)(3)(C)(i), (D)(i)";
    when corporate_basis_reduction_1033b3(t, r);
    when class_adjusted_basis_total(t, 1, b1);
    then class1_reduction_1033b3(t, min(r, b1));
}
@source(IRC_S1033_B, relation = formalizes, coverage = exact, quote = "(ii) second to depreciable property (as defined in section 1017(b)(3)(B)) not described in clause (i), and")
rule Class2ReductionRule(t: Transaction, r: Money, b2: Money, c1: Money) defeasible {
    label en official "section 1033(b)(3)(C)(ii): what class 1 did not absorb";
    when corporate_basis_reduction_1033b3(t, r);
    when class_adjusted_basis_total(t, 2, b2);
    when class1_reduction_1033b3(t, c1);
    when r > c1;
    then class2_reduction_1033b3(t, min(r - c1, b2));
}
rule Class2NothingRule(t: Transaction, r: Money, c1: Money) defeasible {
    label en official "section 1033(b)(3)(C)(ii): class 1 absorbed everything";
    when corporate_basis_reduction_1033b3(t, r);
    when class1_reduction_1033b3(t, c1);
    when r <= c1;
    then class2_reduction_1033b3(t, 0.00 USD);
}
@source(IRC_S1033_B, relation = formalizes, coverage = exact, quote = "(iii) then to other property.")
rule Class3ReductionRule(t: Transaction, r: Money, b3: Money, c1: Money, c2: Money) defeasible {
    label en official "section 1033(b)(3)(C)(iii): what classes 1 and 2 did not absorb";
    when corporate_basis_reduction_1033b3(t, r);
    when class_adjusted_basis_total(t, 3, b3);
    when class1_reduction_1033b3(t, c1);
    when class2_reduction_1033b3(t, c2);
    when r > c1 + c2;
    then class3_reduction_1033b3(t, min(r - c1 - c2, b3));
}
rule Class3NothingRule(t: Transaction, r: Money, c1: Money, c2: Money) defeasible {
    label en official "section 1033(b)(3)(C)(iii): classes 1 and 2 absorbed everything";
    when corporate_basis_reduction_1033b3(t, r);
    when class1_reduction_1033b3(t, c1);
    when class2_reduction_1033b3(t, c2);
    when r <= c1 + c2;
    then class3_reduction_1033b3(t, 0.00 USD);
}
pub relation class_reduction_1033b3(t: Transaction, class: Integer, amount: Money) kind institutional {
    label en official "section 1033(b)(3)(C): the reduction allocated to the class";
}
rule ClassUnion1Rule(t: Transaction, x: Money) defeasible {
    label en unofficial "helper";
    when class1_reduction_1033b3(t, x);
    then class_reduction_1033b3(t, 1, x);
}
rule ClassUnion2Rule(t: Transaction, x: Money) defeasible {
    label en unofficial "helper";
    when class2_reduction_1033b3(t, x);
    then class_reduction_1033b3(t, 2, x);
}
rule ClassUnion3Rule(t: Transaction, x: Money) defeasible {
    label en unofficial "helper";
    when class3_reduction_1033b3(t, x);
    then class_reduction_1033b3(t, 3, x);
}
pub relation property_basis_dollars_in_class(t: Transaction, item: Asset, class: Integer, dollars: Decimal) kind empirical {
    label en official "section 1033(b)(3)(D)(ii): the adjusted basis of a property of the class (without the reduction), in dollars (a Decimal so that the ratio of two bases is expressible)";
}
pub relation class_total_basis_dollars(t: Transaction, class: Integer, dollars: Decimal) kind empirical {
    label en official "section 1033(b)(3)(D)(ii): the total adjusted bases of the class, in dollars";
}
pub relation property_reduction_1033b3(t: Transaction, item: Asset, amount: Money) kind institutional {
    label en official "section 1033(b)(3)(D)(ii): the class reduction allocated among the class's property in proportion to their adjusted bases (cents HALF_UP: JUDGMENT CALL); no reduction exceeds the property's adjusted basis";
}
@source(IRC_S1033_B, relation = formalizes, coverage = exact, quote = "If more than 1 property is described in a clause of subparagraph (C), the reduction under this paragraph shall be allocated among such property in proportion to the adjusted bases of such property (as so determined).")
rule PropertyReductionRule(t: Transaction, item: Asset, class: Integer, basis: Decimal, total: Decimal, reduction: Money) defeasible {
    label en official "section 1033(b)(3)(D)(ii)";
    when property_basis_dollars_in_class(t, item, class, basis);
    when class_total_basis_dollars(t, class, total);
    when class_reduction_1033b3(t, class, reduction);
    when total > 0.00;
    then property_reduction_1033b3(t, item, div_round(reduction * basis, total, 2, "HALF_UP"));
}
