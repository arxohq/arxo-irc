// Stage 3 (IRC-07, A05). Additions to module 25: the yield-method elections of
// sections 1271(a)(3)(E), 1271(a)(4)(D) and 1283(b)(2) (POWERS of the taxpayer,
// irrevocable), the section 1283(c) substitution of original issue discount for
// acquisition discount and its election, the persistence of the section 1282(b)(2)
// election, the section 1281(b)(2)(B) required accrual period, the rule against
// including amounts previously includible (sections 1271(c), 1283(d)(2)), the
// section 1286(b) similar-basis rule, section 1286(c) (tax-exempt obligations
// stripped of coupons) and section 1288.
//
// The yield to maturity, compounded daily, needs exponentiation, which the language
// lacks: the accrued portion under the yield method is a case fact
// (yield_method_*), used in place of the straight-line share once the election is in
// effect. The election is exercised over the obligation; a later attempt to revoke it
// has no effect ("irrevocable").

// =============================================================================
// §1271(a)(3)(E) and (a)(4)(D): the yield-method elections
// =============================================================================

use self::{
    DebtInstrument,
    IRC_S1271_A,
    IRC_S1271_C,
    IRC_S1281_A,
    IRC_S1281_B,
    IRC_S1282_B,
    IRC_S1283_B,
    IRC_S1283_C,
    IRC_S1286_B,
    IRC_S1286_C,
    IRC_S1288_A,
    IRC_S1288_B,
    Person,
    StrippedItem,
    TaxableYear,
    Transaction,
    accrued_market_discount_not_previously_included,
    acquisition_discount,
    acquisition_premium_fraction,
    adjusted_basis_of_bond_and_coupons_before_disposition,
    daily_portion_of_oid,
    days_from_issue_to_maturity_short_term,
    holder_held_on_day,
    instrument_fixed_maturity_within_one_year_of_issue,
    instrument_held_by_1281,
    item_stated_redemption_price_or_coupon_amount,
    original_issue_discount,
    pass_thru_days_with_20_percent_ownership_by_covered_holders,
    ratable_share_of_acquisition_discount,
    ratable_share_of_original_issue_discount,
    reduced_daily_portion_1272a7,
    retained_item_treated_as_purchased_for_allocated_basis,
    section_1281_accrued_discount_inclusion,
    section_1281_applies,
    section_1281_election_in_effect_1282b2,
    short_term_government_obligation,
    short_term_nongovernment_obligation,
    short_term_obligation_1283,
    stripped_item_original_issue_discount,
    tax_exempt_obligation,
};

pub relation elects_yield_method_acquisition_discount(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "section 1271(a)(3)(E): the taxpayer elects, with respect to the obligation, the yield-to-maturity method (based on cost, compounding daily) for the ratable share of the acquisition discount";
}
pub relation yield_method_election_1271a3E(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "section 1271(a)(3)(E): the election is in effect for the obligation";
}
pub relation yield_election_available_1271a3E(holder: Person, instr: DebtInstrument) kind institutional {
    label en unofficial "single-atom helper for valid_when: the election is made for a short-term Government obligation held by the taxpayer";
}
rule YieldElectionAvailable3ERule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1271(a)(3)(E): the election concerns a short-term Government obligation (subparagraph (E) modifies subparagraph (D) of paragraph (3))";
    when elects_yield_method_acquisition_discount(holder, instr);
    when short_term_government_obligation(instr);
    then yield_election_available_1271a3E(holder, instr);
}
@source(IRC_S1271_A, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer with respect to any obligation, the ratable share of the acquisition discount is the portion of the acquisition discount accruing while the taxpayer held the obligation determined (under regulations prescribed by the Secretary) on the basis of—")
rule Section1271a3EYieldElectionPower(holder: Person, instr: DebtInstrument) strict {
    label en official "section 1271(a)(3)(E): the election is a power of the taxpayer over the obligation";
    when elects_yield_method_acquisition_discount(holder, instr);
    then power Section1271a3EYieldElection {
        holder holder;
        over instr;
        exercise elects_yield_method_acquisition_discount(holder, instr);
        valid_when yield_election_available_1271a3E(holder, instr);
        effect create(yield_method_election_1271a3E(holder, instr));
        window [@1984-07-18, infinity);
    };
}
pub relation yield_method_accrued_acquisition_discount(holder: Person, instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1271(a)(3)(E)(i)-(ii): the portion of the acquisition discount accruing while the taxpayer held the obligation, on the taxpayer's yield to maturity based on cost with daily compounding (computed by the case: no exponentiation in the language)";
}
@source(IRC_S1271_A, relation = formalizes, coverage = exact, quote = "(ii) compounding daily.")
rule RatableShareYieldMethodRule(holder: Person, instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1271(a)(3)(E): the yield-method portion replaces the straight-line ratable share once the election is in effect";
    when yield_method_election_1271a3E(holder, instr);
    when yield_method_accrued_acquisition_discount(holder, instr, amount);
    then ratable_share_of_acquisition_discount(holder, instr, amount);
}
pub relation attempts_to_revoke_yield_election(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "the taxpayer attempts to revoke a yield-method election (sections 1271(a)(3)(E), (a)(4)(D), 1283(b)(2))";
}
pub relation yield_election_revocation_ineffective(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "sections 1271(a)(3)(E), (a)(4)(D), 1283(b)(2)(B): the election, once made with respect to an obligation, is irrevocable; the attempted revocation has no effect";
}
@source(IRC_S1271_A, relation = formalizes, coverage = exact, quote = "An election under this subparagraph, once made with respect to any obligation, shall be irrevocable.")
rule YieldElection3ERevocationIneffectiveRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1271(a)(3)(E), last sentence";
    when yield_method_election_1271a3E(holder, instr);
    when attempts_to_revoke_yield_election(holder, instr);
    then yield_election_revocation_ineffective(holder, instr);
}
pub relation elects_yield_method_original_issue_discount(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "section 1271(a)(4)(D): the taxpayer elects, with respect to the obligation, the yield-to-maturity method (based on the issue price, compounding daily) for the ratable share of the original issue discount";
}
pub relation yield_method_election_1271a4D(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "section 1271(a)(4)(D): the election is in effect for the obligation";
}
pub relation yield_election_available_1271a4D(holder: Person, instr: DebtInstrument) kind institutional {
    label en unofficial "single-atom helper for valid_when: the election is made for a short-term nongovernment obligation";
}
rule YieldElectionAvailable4DRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1271(a)(4)(D): the election concerns a short-term nongovernment obligation";
    when elects_yield_method_original_issue_discount(holder, instr);
    when short_term_nongovernment_obligation(instr);
    then yield_election_available_1271a4D(holder, instr);
}
@source(IRC_S1271_A, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer with respect to any obligation, the ratable share of the original issue discount is the portion of the original issue discount accruing while the taxpayer held the obligation determined (under regulations prescribed by the Secretary) on the basis of—")
rule Section1271a4DYieldElectionPower(holder: Person, instr: DebtInstrument) strict {
    label en official "section 1271(a)(4)(D): the election is a power of the taxpayer over the obligation";
    when elects_yield_method_original_issue_discount(holder, instr);
    then power Section1271a4DYieldElection {
        holder holder;
        over instr;
        exercise elects_yield_method_original_issue_discount(holder, instr);
        valid_when yield_election_available_1271a4D(holder, instr);
        effect create(yield_method_election_1271a4D(holder, instr));
        window [@1984-07-18, infinity);
    };
}
pub relation yield_method_accrued_original_issue_discount(holder: Person, instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1271(a)(4)(D)(i)-(ii): the portion of the original issue discount accruing while the taxpayer held the obligation, on the yield to maturity based on the issue price with daily compounding (computed by the case)";
}
@source(IRC_S1271_A, relation = formalizes, coverage = exact, quote = "(i) the yield to maturity based on the issue price of the obligation, and")
rule RatableShareOidYieldMethodRule(holder: Person, instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1271(a)(4)(D): the yield-method portion replaces the straight-line share once the election is in effect";
    when yield_method_election_1271a4D(holder, instr);
    when yield_method_accrued_original_issue_discount(holder, instr, amount);
    then ratable_share_of_original_issue_discount(holder, instr, amount);
}
@source(IRC_S1271_A, relation = formalizes, coverage = exact, quote = "Any election under this subparagraph, once made with respect to any obligation, shall be irrevocable.")
rule YieldElection4DRevocationIneffectiveRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1271(a)(4)(D), last sentence";
    when yield_method_election_1271a4D(holder, instr);
    when attempts_to_revoke_yield_election(holder, instr);
    then yield_election_revocation_ineffective(holder, instr);
}

// =============================================================================
// §1283(b)(2): the yield-method daily portion; §1283(c): OID in lieu of acquisition discount
// =============================================================================

pub relation elects_yield_method_daily_portion_1283(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "section 1283(b)(2)(A): the taxpayer elects, with respect to the obligation, the daily portion of the acquisition discount on the basis of the taxpayer's yield to maturity based on cost, compounding daily";
}
pub relation yield_method_election_1283b2(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "section 1283(b)(2): the election is in effect for the obligation";
}
pub relation yield_election_available_1283b2(holder: Person, instr: DebtInstrument) kind institutional {
    label en unofficial "single-atom helper for valid_when: the election concerns a short-term obligation";
}
rule YieldElectionAvailable1283Rule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1283(b)(2): a short-term obligation (section 1283(a)(1))";
    when elects_yield_method_daily_portion_1283(holder, instr);
    when short_term_obligation_1283(instr);
    then yield_election_available_1283b2(holder, instr);
}
@source(IRC_S1283_B, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer with respect to any obligation, the daily portion of the acquisition discount for any day is the portion of the acquisition discount accruing on such day determined (under regulations prescribed by the Secretary) on the basis of—")
rule Section1283b2YieldElectionPower(holder: Person, instr: DebtInstrument) strict {
    label en official "section 1283(b)(2)(A): the election is a power of the taxpayer over the obligation";
    when elects_yield_method_daily_portion_1283(holder, instr);
    then power Section1283b2YieldElection {
        holder holder;
        over instr;
        exercise elects_yield_method_daily_portion_1283(holder, instr);
        valid_when yield_election_available_1283b2(holder, instr);
        effect create(yield_method_election_1283b2(holder, instr));
        window [@1984-07-18, infinity);
    };
}
pub relation yield_method_daily_portion_1283(holder: Person, instr: DebtInstrument, day: Date, amount: Money) kind empirical {
    label en official "section 1283(b)(2)(A)(i)-(ii): the portion of the acquisition discount accruing on the day at the taxpayer's yield to maturity based on cost, compounded daily (computed by the case)";
}
pub relation yield_method_daily_portion_elected(holder: Person, instr: DebtInstrument, day: Date, amount: Money) kind institutional {
    label en official "section 1283(b)(2): the daily portion of the day under the elected yield method";
}
@source(IRC_S1283_B, relation = formalizes, coverage = exact, quote = "(i) the taxpayer's yield to maturity based on the taxpayer's cost of acquiring the obligation, and")
rule YieldMethodDailyPortionRule(holder: Person, instr: DebtInstrument, day: Date, amount: Money) defeasible {
    label en official "section 1283(b)(2)(A): the yield-based daily portion once the election is in effect";
    when yield_method_election_1283b2(holder, instr);
    when yield_method_daily_portion_1283(holder, instr, day, amount);
    then yield_method_daily_portion_elected(holder, instr, day, amount);
}
@source(IRC_S1283_B, relation = formalizes, coverage = exact, quote = "An election under subparagraph (A), once made with respect to any obligation, shall be irrevocable.")
rule YieldElection1283RevocationIneffectiveRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1283(b)(2)(B)";
    when yield_method_election_1283b2(holder, instr);
    when attempts_to_revoke_yield_election(holder, instr);
    then yield_election_revocation_ineffective(holder, instr);
}
pub relation yield_method_accrued_in_taxable_year_1283(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1281(a)(1) with the elected yield method: the sum of the yield-based daily portions of the days held in the taxable year (an aggregate the case supplies)";
}
@source(IRC_S1281_A, relation = formalizes, coverage = partial, quote = "(1) there shall be included in the gross income of the holder an amount equal to the sum of the daily portions of the acquisition discount for each day during the taxable year on which such holder held such obligation, and")
rule Section1281InclusionYieldMethodRule(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1281(a)(1) under the section 1283(b)(2) election";
    when section_1281_applies(holder, instr);
    when yield_method_election_1283b2(holder, instr);
    when yield_method_accrued_in_taxable_year_1283(holder, instr, y, amount);
    then section_1281_accrued_discount_inclusion(holder, instr, y, amount);
}
// (c): original issue discount in lieu of acquisition discount for a nongovernment obligation
pub relation elects_no_oid_substitution_1283c2(holder: Person, y: TaxableYear) kind empirical {
    label en official "section 1283(c)(2)(A): the taxpayer elects to have paragraph (1) not apply to all obligations acquired on or after the first day of the first taxable year to which the election applies";
}
pub relation oid_substitution_election_1283c2(holder: Person, y: TaxableYear) kind institutional {
    label en official "section 1283(c)(2): the election is in effect from the taxable year";
}
pub relation oid_substitution_election_available_1283c2(holder: Person, y: TaxableYear) kind institutional {
    label en unofficial "single-atom helper for valid_when: the section places no condition on the electing taxpayer";
}
rule OidSubstitutionElectionAvailableRule(holder: Person, y: TaxableYear) defeasible {
    label en official "section 1283(c)(2)(A): no condition on the taxpayer";
    when elects_no_oid_substitution_1283c2(holder, y);
    then oid_substitution_election_available_1283c2(holder, y);
}
@source(IRC_S1283_C, relation = formalizes, coverage = exact, quote = "A taxpayer may make an election under this paragraph to have paragraph (1) not apply to all obligations acquired by the taxpayer on or after the first day of the first taxable year to which such election applies.")
rule Section1283c2ElectionPower(holder: Person, y: TaxableYear) strict {
    label en official "section 1283(c)(2)(A): the election is a power of the taxpayer over the taxable year";
    when elects_no_oid_substitution_1283c2(holder, y);
    then power Section1283c2Election {
        holder holder;
        over y;
        exercise elects_no_oid_substitution_1283c2(holder, y);
        valid_when oid_substitution_election_available_1283c2(holder, y);
        effect create(oid_substitution_election_1283c2(holder, y));
        window [@1984-07-18, infinity);
    };
}
pub relation election_first_year_begins(holder: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year for which an election of the holder applies";
}
pub relation obligation_acquired_on_1283(holder: Person, instr: DebtInstrument, on: Date) kind empirical {
    label en official "the date on which the holder acquired the obligation";
}
pub relation consent_to_revoke_1283c2_given_on(holder: Person, on: Date) kind empirical {
    label en official "section 1283(c)(2)(B): the Secretary consents to the revocation of the election, effective for obligations acquired on or after the date";
}
pub relation oid_substitution_election_applies_to_obligation(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "section 1283(c)(2): the election applies to the obligation (acquired on or after the first day of the first year to which it applies and before a consented revocation)";
}
pub relation consent_revocation_effective_before(holder: Person, instr: DebtInstrument) kind institutional {
    label en unofficial "a consented revocation date is on or before the acquisition date of the obligation";
}
rule ConsentRevocationEffectiveRule(holder: Person, instr: DebtInstrument, acquired: Date, revoked: Date) defeasible {
    label en unofficial "helper";
    when obligation_acquired_on_1283(holder, instr, acquired);
    when consent_to_revoke_1283c2_given_on(holder, revoked);
    when revoked <= acquired;
    then consent_revocation_effective_before(holder, instr);
}
@source(IRC_S1283_C, relation = formalizes, coverage = exact, quote = "An election under this paragraph shall apply to the taxable year for which it is made and for all subsequent taxable years, unless the taxpayer secures the consent of the Secretary to the revocation of such election.")
rule OidSubstitutionElectionAppliesRule(holder: Person, instr: DebtInstrument, y: TaxableYear, acquired: Date, start: Date) defeasible {
    label en official "section 1283(c)(2)(A)-(B)";
    when oid_substitution_election_1283c2(holder, y);
    when election_first_year_begins(holder, y, start);
    when obligation_acquired_on_1283(holder, instr, acquired);
    when acquired >= start;
    when not_known(consent_revocation_effective_before(holder, instr));
    then oid_substitution_election_applies_to_obligation(holder, instr);
}
pub relation oid_in_lieu_of_acquisition_discount_1283c1(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "section 1283(c)(1): for a short-term obligation that is not a short-term Government obligation, sections 1281 and 1282 take original issue discount into account in lieu of acquisition discount";
}
@source(IRC_S1283_C, relation = formalizes, coverage = exact, quote = "In the case of any short-term obligation which is not a short-term Government obligation (as defined in section 1271(a)(3)(B))—")
rule OidInLieuRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1283(c)(1)(A) unless the (c)(2) election applies";
    when short_term_obligation_1283(instr);
    when not_known(short_term_government_obligation(instr));
    when instrument_held_by_1281(holder, instr);
    when not_known(oid_substitution_election_applies_to_obligation(holder, instr));
    then oid_in_lieu_of_acquisition_discount_1283c1(holder, instr);
}
pub relation discount_for_sections_1281_1282(holder: Person, instr: DebtInstrument, amount: Money) kind institutional {
    label en official "sections 1281, 1282 with section 1283(c)(1)(A): the acquisition discount, or the original issue discount where (c)(1) applies";
}
rule DiscountAcquisitionRule(holder: Person, instr: DebtInstrument, amount: Money) defeasible {
    label en official "sections 1281, 1282: acquisition discount where section 1283(c)(1) does not substitute";
    when acquisition_discount(holder, instr, amount);
    when not_known(oid_in_lieu_of_acquisition_discount_1283c1(holder, instr));
    then discount_for_sections_1281_1282(holder, instr, amount);
}
@source(IRC_S1283_C, relation = formalizes, coverage = exact, quote = "(A) sections 1281 and 1282 shall be applied by taking into account original issue discount in lieu of acquisition discount, and")
rule DiscountOidInLieuRule(holder: Person, instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1283(c)(1)(A)";
    when oid_in_lieu_of_acquisition_discount_1283c1(holder, instr);
    when original_issue_discount(instr, amount);
    then discount_for_sections_1281_1282(holder, instr, amount);
}
pub relation days_held_in_year_oid_in_lieu(holder: Person, instr: DebtInstrument, y: TaxableYear, days: Integer) kind empirical {
    label en official "section 1281(a)(1) with section 1283(c)(1): the days of the taxable year on which the holder held the obligation";
}
@source(IRC_S1283_C, relation = formalizes, coverage = partial, quote = "(B) appropriate adjustments shall be made in the application of subsection (b) of this section.")
rule Section1281InclusionOidInLieuRule(holder: Person, instr: DebtInstrument, y: TaxableYear, oid: Money, days: Integer, total: Integer) defeasible {
    label en official "section 1281(a)(1) with section 1283(c)(1): original issue discount x days held over days from issue to maturity (cents HALF_UP: JUDGMENT CALL)";
    when section_1281_applies(holder, instr);
    when oid_in_lieu_of_acquisition_discount_1283c1(holder, instr);
    when original_issue_discount(instr, oid);
    when days_held_in_year_oid_in_lieu(holder, instr, y, days);
    when days_from_issue_to_maturity_for_1283c1b(instr, total);
    when total > 0;
    then section_1281_accrued_discount_inclusion(holder, instr, y, div_round(oid * days, total * 1.00, 2, "HALF_UP"));
}
pub relation days_from_issue_to_maturity_for_1283c1b(instr: DebtInstrument, days: Integer) kind empirical {
    label en official "section 1283(c)(1)(B): the days from the date of issue to maturity, the denominator of the daily portion of original issue discount (the appropriate adjustment to subsection (b))";
}
pub relation daily_portion_of_original_issue_discount_1283c1b(holder: Person, instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1283(c)(1)(B): the daily portion of the original issue discount - the discount over the days from issue to maturity (cents HALF_UP: JUDGMENT CALL for the appropriate adjustment)";
}
@source(IRC_S1283_C, relation = formalizes, coverage = partial, quote = "(B) appropriate adjustments shall be made in the application of subsection (b) of this section.")
rule DailyPortionOidRule(holder: Person, instr: DebtInstrument, oid: Money, days: Integer) defeasible {
    label en official "section 1283(c)(1)(B): the daily portion is measured from issue rather than from acquisition (JUDGMENT CALL: the text says only \"appropriate adjustments\")";
    when oid_in_lieu_of_acquisition_discount_1283c1(holder, instr);
    when original_issue_discount(instr, oid);
    when days_from_issue_to_maturity_for_1283c1b(instr, days);
    when days > 0;
    then daily_portion_of_original_issue_discount_1283c1b(holder, instr, div_round(oid, days * 1.00, 2, "HALF_UP"));
}

// =============================================================================
// §1282(b)(2)(B): persistence of the election
// =============================================================================

pub relation taxable_year_begins_1282(y: TaxableYear, on: Date) kind empirical {
    label en official "the first day of the taxable year";
}
pub relation section_1282_election_consent_to_revoke_on(holder: Person, on: Date) kind empirical {
    label en official "section 1282(b)(2)(B): the Secretary consents to the revocation of the election effective from the taxable year beginning on the date";
}
pub relation consented_revocation_reached_1282(holder: Person, y: TaxableYear) kind institutional {
    label en unofficial "a consented revocation is effective on or before the beginning of the year";
}
rule ConsentedRevocationReachedRule(holder: Person, y: TaxableYear, begins: Date, revoked: Date) defeasible {
    label en unofficial "helper";
    when taxable_year_begins_1282(y, begins);
    when section_1282_election_consent_to_revoke_on(holder, revoked);
    when revoked <= begins;
    then consented_revocation_reached_1282(holder, y);
}
pub relation section_1281_election_applies_to_year_1282b2(holder: Person, y: TaxableYear) kind institutional {
    label en official "section 1282(b)(2)(B): the election applies to the taxable year for which it is made and for all subsequent taxable years unless the Secretary consents to its revocation";
}
@source(IRC_S1282_B, relation = formalizes, coverage = exact, quote = "An election under this paragraph shall apply to the taxable year for which it is made and for all subsequent taxable years, unless the taxpayer secures the consent of the Secretary to the revocation of such election.")
rule ElectionYearRule(holder: Person, y: TaxableYear) defeasible {
    label en official "section 1282(b)(2)(B): the year for which the election is made";
    when section_1281_election_in_effect_1282b2(holder, y);
    then section_1281_election_applies_to_year_1282b2(holder, y);
}
rule ElectionLaterYearRule(holder: Person, y0: TaxableYear, y: TaxableYear, start: Date, begins: Date) defeasible {
    label en official "section 1282(b)(2)(B): all subsequent taxable years, until a consented revocation";
    when section_1281_election_in_effect_1282b2(holder, y0);
    when taxable_year_begins_1282(y0, start);
    when taxable_year_begins_1282(y, begins);
    when begins > start;
    when not_known(consented_revocation_reached_1282(holder, y));
    then section_1281_election_applies_to_year_1282b2(holder, y);
}

// =============================================================================
// §1281(b)(2)(B): the required accrual period of a pass-thru entity
// =============================================================================

pub relation ownership_test_met_year_begins(holder: Person, on: Date) kind empirical {
    label en official "section 1281(b)(2)(B)(i), (C): the first day of a taxable year of the pass-thru entity (or a predecessor) for which the ownership test of subparagraph (C) is met";
}
pub relation ownership_test_failed_and_consented_year_begins(holder: Person, on: Date) kind empirical {
    label en official "section 1281(b)(2)(B)(ii): the first day of a taxable year for which the ownership test is not met and with respect to which the Secretary consents to the termination of the required accrual period";
}
pub relation earlier_ownership_year_exists(holder: Person, on: Date) kind institutional {
    label en unofficial "a strictly earlier taxable year in which the ownership test is met exists (the earliest-of pattern)";
}
rule EarlierOwnershipYearRule(holder: Person, on: Date, other: Date) defeasible {
    label en unofficial "helper";
    when ownership_test_met_year_begins(holder, on);
    when ownership_test_met_year_begins(holder, other);
    when other < on;
    then earlier_ownership_year_exists(holder, on);
}
pub relation required_accrual_period_begins(holder: Person, on: Date) kind institutional {
    label en official "section 1281(b)(2)(B)(i): the required accrual period begins with the first taxable year for which the ownership test is met";
}
@source(IRC_S1281_B, relation = formalizes, coverage = exact, quote = "(i) which begins with the first taxable year for which the ownership test of subparagraph (C) is met with respect to the pass-thru entity (or a predecessor), and")
rule RequiredAccrualPeriodBeginsRule(holder: Person, on: Date) defeasible {
    label en official "section 1281(b)(2)(B)(i)";
    when ownership_test_met_year_begins(holder, on);
    when not_known(earlier_ownership_year_exists(holder, on));
    then required_accrual_period_begins(holder, on);
}
pub relation termination_after_start_exists(holder: Person, on: Date) kind institutional {
    label en unofficial "a termination date after the start and earlier than the candidate exists";
}
rule EarlierTerminationRule(holder: Person, on: Date, other: Date, start: Date) defeasible {
    label en unofficial "helper for the earliest termination after the start";
    when required_accrual_period_begins(holder, start);
    when ownership_test_failed_and_consented_year_begins(holder, on);
    when ownership_test_failed_and_consented_year_begins(holder, other);
    when other < on;
    when other > start;
    then termination_after_start_exists(holder, on);
}
pub relation required_accrual_period_ends(holder: Person, on: Date) kind institutional {
    label en official "section 1281(b)(2)(B)(ii): the required accrual period ends with the first taxable year after the start for which the test is not met and the Secretary consents to the termination";
}
@source(IRC_S1281_B, relation = formalizes, coverage = exact, quote = "(ii) which ends with the first taxable year after the taxable year referred to in clause (i) for which the ownership test of subparagraph (C) is not met and with respect to which the Secretary consents to the termination of the required accrual period.")
rule RequiredAccrualPeriodEndsRule(holder: Person, on: Date, start: Date) defeasible {
    label en official "section 1281(b)(2)(B)(ii)";
    when required_accrual_period_begins(holder, start);
    when ownership_test_failed_and_consented_year_begins(holder, on);
    when on > start;
    when not_known(termination_after_start_exists(holder, on));
    then required_accrual_period_ends(holder, on);
}
pub relation obligation_acquired_by_pass_thru_on(holder: Person, instr: DebtInstrument, on: Date) kind empirical {
    label en official "the date on which the pass-thru entity acquired the obligation";
}
pub relation acquired_within_required_accrual_period(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "section 1281(b)(2)(A)(ii), (B): the obligation is acquired during the required accrual period";
}
rule AcquiredWithinPeriodOpenRule(holder: Person, instr: DebtInstrument, acquired: Date, start: Date) defeasible {
    label en official "section 1281(b)(2)(B): after the start, while the period has not ended";
    when required_accrual_period_begins(holder, start);
    when obligation_acquired_by_pass_thru_on(holder, instr, acquired);
    when acquired >= start;
    when not_known(required_accrual_period_ended_1281(holder));
    then acquired_within_required_accrual_period(holder, instr);
}
pub relation required_accrual_period_ended_1281(holder: Person) kind institutional {
    label en unofficial "the required accrual period has an end date";
}
rule PeriodEndedFlagRule(holder: Person, end: Date) defeasible {
    label en unofficial "helper";
    when required_accrual_period_ends(holder, end);
    then required_accrual_period_ended_1281(holder);
}
rule AcquiredWithinPeriodClosedRule(holder: Person, instr: DebtInstrument, acquired: Date, start: Date, end: Date) defeasible {
    label en official "section 1281(b)(2)(B): after the start and before the end";
    when required_accrual_period_begins(holder, start);
    when required_accrual_period_ends(holder, end);
    when obligation_acquired_by_pass_thru_on(holder, instr, acquired);
    when acquired >= start;
    when acquired < end;
    then acquired_within_required_accrual_period(holder, instr);
}
rule Section1281PassThruDerivedPeriodRule(holder: Person, instr: DebtInstrument, days: Integer) defeasible {
    label en official "section 1281(b)(2)(A)(ii), (C) with the derived required accrual period";
    when short_term_obligation_1283(instr);
    when acquired_within_required_accrual_period(holder, instr);
    when pass_thru_days_with_20_percent_ownership_by_covered_holders(holder, days);
    when days >= 90;
    then section_1281_applies(holder, instr);
}

// =============================================================================
// §1271(c) and §1283(d)(2): amounts previously includible
// =============================================================================

pub relation gross_amount_under_1271_1272_1281_1286(p: Person, item: DebtInstrument, amount: Money) kind empirical {
    label en official "the amount that section 1271, 1272, 1281 or 1286 would require to be included before the previously-included amount is removed";
}
pub relation amount_previously_includible_in_gross_income(p: Person, item: DebtInstrument, amount: Money) kind empirical {
    label en official "the amount previously includible in gross income";
}
pub relation includible_after_previous_inclusion(p: Person, item: DebtInstrument, amount: Money) kind institutional {
    label en official "sections 1271(c), 1283(d)(2): no inclusion of any amount previously includible in gross income";
}
@source(IRC_S1271_C, relation = formalizes, coverage = exact, quote = "This section and sections 1272 and 1286 shall not require the inclusion of any amount previously includible in gross income.")
rule IncludibleNetOfPreviousRule(p: Person, item: DebtInstrument, gross: Money, prior: Money) defeasible {
    label en official "sections 1271(c), 1283(d)(2): the gross amount less the amount previously includible, not below zero";
    when gross_amount_under_1271_1272_1281_1286(p, item, gross);
    when amount_previously_includible_in_gross_income(p, item, prior);
    when gross > prior;
    then includible_after_previous_inclusion(p, item, gross - prior);
}
rule IncludibleNothingLeftRule(p: Person, item: DebtInstrument, gross: Money, prior: Money) defeasible {
    label en official "sections 1271(c), 1283(d)(2): nothing remains to include";
    when gross_amount_under_1271_1272_1281_1286(p, item, gross);
    when amount_previously_includible_in_gross_income(p, item, prior);
    when gross <= prior;
    then includible_after_previous_inclusion(p, item, 0.00 USD);
}

// =============================================================================
// §1286(b) similar-basis rule, §1286(c) tax-exempt obligations
// =============================================================================

pub relation person_basis_determined_by_reference_to_stripper_basis(t: Transaction, person: Person, item: StrippedItem) kind empirical {
    label en official "section 1286(b), last sentence: the person's basis in the bond or coupon is determined by reference to the basis of the stripper";
}
pub relation allocated_basis_of_item_in_stripper_hands(t: Transaction, item: StrippedItem, amount: Money) kind institutional {
    label en unofficial "the basis allocated to the retained item in the stripper's hands (section 1286(b)(3))";
}
rule AllocatedBasisReadRule(t: Transaction, item: StrippedItem, amount: Money) defeasible {
    label en unofficial "reads the section 1286(b)(4) result";
    when retained_item_treated_as_purchased_for_allocated_basis(t, item, amount);
    then allocated_basis_of_item_in_stripper_hands(t, item, amount);
}
pub relation similar_person_treated_as_purchaser_1286b(t: Transaction, person: Person, item: StrippedItem, amount: Money) kind institutional {
    label en official "section 1286(b), last sentence: a rule similar to paragraph (4) applies to the person whose basis is determined by reference to the stripper's basis - the item is treated as purchased on the disposition date for the allocated basis";
}
@source(IRC_S1286_B, relation = formalizes, coverage = exact, quote = "A rule similar to the rule of paragraph (4) shall apply in the case of any person whose basis in any bond or coupon is determined by reference to the basis of the person described in the preceding sentence.")
rule SimilarPersonTreatedAsPurchaserRule(t: Transaction, person: Person, item: StrippedItem, amount: Money) defeasible {
    label en official "section 1286(b), last sentence";
    when person_basis_determined_by_reference_to_stripper_basis(t, person, item);
    when allocated_basis_of_item_in_stripper_hands(t, item, amount);
    then similar_person_treated_as_purchaser_1286b(t, person, item, amount);
}
pub relation stripped_item_from_tax_exempt_obligation(item: StrippedItem) kind empirical {
    label en official "section 1286(c)(1): the item is a bond or coupon stripped from a tax-exempt obligation (section 1275(a)(3))";
}
pub relation issue_price_at_lower_yield_1286c2(item: StrippedItem, amount: Money) kind empirical {
    label en official "section 1286(c)(2)(B): the issue price that would produce, as of the purchase date, a yield to maturity equal to the lower of the coupon rate of the obligation from which the coupons were separated and the yield to maturity (on the purchase price) of the stripped obligation or coupon - or, on the purchaser's election, the original yield to maturity in place of the coupon rate (computed by the case: no exponentiation in the language)";
}
pub relation purchaser_elects_original_yield_1286c2(item: StrippedItem) kind empirical {
    label en official "section 1286(c)(2), last sentence: the purchaser elects to apply clause (i) by substituting the original yield to maturity for the coupon rate of interest";
}
pub relation tax_exempt_portion_of_oid_1286c2(item: StrippedItem, amount: Money) kind institutional {
    label en official "section 1286(c)(2): the tax-exempt portion of the original issue discount - the excess of the amount in subsection (a)(1) over the issue price at the lower yield";
}
@source(IRC_S1286_C, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the tax-exempt portion of the original issue discount determined under subsection (a) is the excess of—")
rule TaxExemptPortionRule(item: StrippedItem, srp: Money, price: Money) defeasible {
    label en official "section 1286(c)(2)(A)-(B), not below zero";
    when stripped_item_from_tax_exempt_obligation(item);
    when item_stated_redemption_price_or_coupon_amount(item, srp);
    when issue_price_at_lower_yield_1286c2(item, price);
    when srp > price;
    then tax_exempt_portion_of_oid_1286c2(item, srp - price);
}
rule TaxExemptPortionZeroRule(item: StrippedItem, srp: Money, price: Money) defeasible {
    label en official "section 1286(c)(2): the issue price is not below the amount: no tax-exempt portion";
    when stripped_item_from_tax_exempt_obligation(item);
    when item_stated_redemption_price_or_coupon_amount(item, srp);
    when issue_price_at_lower_yield_1286c2(item, price);
    when srp <= price;
    then tax_exempt_portion_of_oid_1286c2(item, 0.00 USD);
}
pub relation stripped_item_oid_tax_exempt_part_1286c1(item: StrippedItem, amount: Money) kind institutional {
    label en official "section 1286(c)(1)(A)(i): the original issue discount treated as original issue discount on a tax-exempt obligation - up to the tax-exempt portion";
}
pub relation stripped_item_oid_taxable_part_1286c1(item: StrippedItem, amount: Money) kind institutional {
    label en official "section 1286(c)(1)(A)(ii): the original issue discount treated as original issue discount on an obligation that is not tax-exempt - the excess over the tax-exempt portion";
}
@source(IRC_S1286_C, relation = formalizes, coverage = exact, quote = "(i) shall be treated as original issue discount on a tax-exempt obligation to the extent such discount does not exceed the tax-exempt portion of such discount, and")
rule OidTaxExemptPartRule(item: StrippedItem, oid: Money, portion: Money) defeasible {
    label en official "section 1286(c)(1)(A)(i): min(discount, tax-exempt portion)";
    when stripped_item_from_tax_exempt_obligation(item);
    when stripped_item_original_issue_discount(item, oid);
    when tax_exempt_portion_of_oid_1286c2(item, portion);
    then stripped_item_oid_tax_exempt_part_1286c1(item, min(oid, portion));
}
@source(IRC_S1286_C, relation = formalizes, coverage = exact, quote = "(ii) shall be treated as original issue discount on an obligation which is not a tax-exempt obligation to the extent such discount exceeds the tax-exempt portion of such discount,")
rule OidTaxablePartRule(item: StrippedItem, oid: Money, portion: Money) defeasible {
    label en official "section 1286(c)(1)(A)(ii): the excess over the tax-exempt portion";
    when stripped_item_from_tax_exempt_obligation(item);
    when stripped_item_original_issue_discount(item, oid);
    when tax_exempt_portion_of_oid_1286c2(item, portion);
    when oid > portion;
    then stripped_item_oid_taxable_part_1286c1(item, oid - portion);
}
rule OidTaxablePartNoneRule(item: StrippedItem, oid: Money, portion: Money) defeasible {
    label en official "section 1286(c)(1)(A)(ii): nothing above the tax-exempt portion";
    when stripped_item_from_tax_exempt_obligation(item);
    when stripped_item_original_issue_discount(item, oid);
    when tax_exempt_portion_of_oid_1286c2(item, portion);
    when oid <= portion;
    then stripped_item_oid_taxable_part_1286c1(item, 0.00 USD);
}
pub relation stripper_disposes_of_tax_exempt_bond_or_coupon(t: Transaction, stripper: Person) kind empirical {
    label en official "section 1286(c)(1): the stripper disposes of a tax-exempt obligation from which coupons have been stripped";
}
pub relation section_1286b1A_inapplicable_to_tax_exempt(t: Transaction) kind institutional {
    label en official "section 1286(c)(1)(B): subsection (b)(1)(A) does not apply to a tax-exempt obligation";
}
@source(IRC_S1286_C, relation = formalizes, coverage = exact, quote = "(B) subsection (b)(1)(A) shall not apply, and")
rule Section1286b1AInapplicableRule(t: Transaction, stripper: Person) defeasible {
    label en official "section 1286(c)(1)(B)";
    when stripper_disposes_of_tax_exempt_bond_or_coupon(t, stripper);
    then section_1286b1A_inapplicable_to_tax_exempt(t);
}
pub relation section_1286b_income_inclusion_tax_exempt(t: Transaction, amount: Money) kind institutional {
    label en official "section 1286(c)(1) with (b)(1): for a tax-exempt obligation only the accrued market discount (b)(1)(B) is included";
}
rule TaxExemptStripperInclusionRule(t: Transaction, stripper: Person, discount: Money) defeasible {
    label en official "section 1286(c)(1)(B): the interest of (b)(1)(A) is dropped";
    when stripper_disposes_of_tax_exempt_bond_or_coupon(t, stripper);
    when accrued_market_discount_not_previously_included(t, discount);
    then section_1286b_income_inclusion_tax_exempt(t, discount);
}
pub relation interest_accrued_unpaid_not_reflected_in_basis(t: Transaction, amount: Money) kind empirical {
    label en official "section 1286(c)(1)(C)(i): the interest accrued but not paid before the bond or coupon was disposed of (and not previously reflected in basis)";
}
pub relation basis_after_1286c_increase(t: Transaction, amount: Money) kind institutional {
    label en official "section 1286(c)(1)(C): for a tax-exempt obligation the basis is increased by the accrued unpaid interest plus the amount included under (b)(1)(B)";
}
@source(IRC_S1286_C, relation = formalizes, coverage = exact, quote = "(C) subsection (b)(2) shall be applied by increasing the basis of the bond or coupon by the sum of—")
rule TaxExemptBasisIncreaseRule(t: Transaction, basis: Money, interest: Money, inclusion: Money) defeasible {
    label en official "section 1286(c)(1)(C)(i)-(ii)";
    when adjusted_basis_of_bond_and_coupons_before_disposition(t, basis);
    when interest_accrued_unpaid_not_reflected_in_basis(t, interest);
    when section_1286b_income_inclusion_tax_exempt(t, inclusion);
    then basis_after_1286c_increase(t, basis + interest + inclusion);
}

// =============================================================================
// §1288: original issue discount on tax-exempt obligations
// =============================================================================

pub relation tax_exempt_oid_1288(instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1288(b)(1): the original issue discount of a tax-exempt obligation (section 1273(a) without its paragraph (3), so no de minimis zeroing)";
}
@source(IRC_S1288_B, relation = formalizes, coverage = partial, quote = "The term \"original issue discount\" has the meaning given to such term by section 1273(a) without regard to paragraph (3) thereof.")
rule TaxExemptOidRule(instr: DebtInstrument, oid: Money) defeasible {
    label en official "section 1288(b)(1)-(2)";
    when tax_exempt_obligation(instr);
    when original_issue_discount(instr, oid);
    then tax_exempt_oid_1288(instr, oid);
}
pub relation tax_exempt_oid_accrual_for_section_163(holder: Person, instr: DebtInstrument, day: Date, amount: Money) kind institutional {
    label en official "section 1288(a)(1): for purposes of section 163 the original issue discount accrues in the manner of section 1272(a) without regard to its paragraph (7)";
}
@source(IRC_S1288_A, relation = formalizes, coverage = exact, quote = "(1) for purposes of section 163, in the manner provided by section 1272(a) (determined without regard to paragraph (7) thereof), and")
rule TaxExemptAccrualFor163Rule(holder: Person, instr: DebtInstrument, day: Date, amount: Money) defeasible {
    label en official "section 1288(a)(1)";
    when tax_exempt_obligation(instr);
    when holder_held_on_day(holder, instr, day);
    when daily_portion_of_oid(instr, day, amount);
    then tax_exempt_oid_accrual_for_section_163(holder, instr, day, amount);
}
pub relation acquisition_premium_applies_1288(holder: Person, instr: DebtInstrument) kind institutional {
    label en unofficial "the holder's purchase after original issue triggers the section 1272(a)(7) reduction";
}
rule AcquisitionPremiumAppliesRule(holder: Person, instr: DebtInstrument, fraction: Decimal) defeasible {
    label en unofficial "helper";
    when acquisition_premium_fraction(instr, holder, fraction);
    then acquisition_premium_applies_1288(holder, instr);
}
pub relation tax_exempt_oid_accrual_for_basis(holder: Person, instr: DebtInstrument, day: Date, amount: Money) kind institutional {
    label en official "section 1288(a)(2): for the adjusted basis of the holder the original issue discount accrues in the manner of section 1272(a) with regard to its paragraph (7)";
}
@source(IRC_S1288_A, relation = formalizes, coverage = exact, quote = "(2) for purposes of determining the adjusted basis of the holder, in the manner provided by section 1272(a) (determined with regard to paragraph (7) thereof).")
rule TaxExemptAccrualForBasisReducedRule(holder: Person, instr: DebtInstrument, day: Date, amount: Money) defeasible {
    label en official "section 1288(a)(2): the daily portion reduced for acquisition premium";
    when tax_exempt_obligation(instr);
    when reduced_daily_portion_1272a7(instr, holder, day, amount);
    then tax_exempt_oid_accrual_for_basis(holder, instr, day, amount);
}
rule TaxExemptAccrualForBasisPlainRule(holder: Person, instr: DebtInstrument, day: Date, amount: Money) defeasible {
    label en official "section 1288(a)(2): the unreduced daily portion when there is no acquisition premium";
    when tax_exempt_obligation(instr);
    when holder_held_on_day(holder, instr, day);
    when daily_portion_of_oid(instr, day, amount);
    when not_known(acquisition_premium_applies_1288(holder, instr));
    then tax_exempt_oid_accrual_for_basis(holder, instr, day, amount);
}
pub relation tax_exempt_short_term_daily_portion_1288b3(instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1288(b)(3): for an obligation with maturity of 1 year or less rules similar to section 1283(b) apply - the discount over the days to maturity (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1288_B, relation = formalizes, coverage = exact, quote = "In applying this section to obligations with maturity of 1 year or less, rules similar to the rules of section 1283(b) shall apply.")
rule TaxExemptShortTermDailyPortionRule(instr: DebtInstrument, oid: Money, days: Integer) defeasible {
    label en official "section 1288(b)(3)";
    when tax_exempt_obligation(instr);
    when instrument_fixed_maturity_within_one_year_of_issue(instr);
    when tax_exempt_oid_1288(instr, oid);
    when days_from_issue_to_maturity_short_term(instr, days);
    when days > 0;
    then tax_exempt_short_term_daily_portion_1288b3(instr, div_round(oid, days * 1.00, 2, "HALF_UP"));
}
