// Stage 2b (IRC-07, A05). Section 1233 (short sales), section 1234/1234A
// (options and terminations), section 1235 (patents) — character rules.

// =============================================================================
// Section 1233: short sales
// =============================================================================

use self::{
    Asset,
    Corporation,
    IRC_S1233_A,
    IRC_S1233_B,
    IRC_S1233_C,
    IRC_S1233_D,
    IRC_S1234A,
    IRC_S1234_A,
    IRC_S1234_B,
    IRC_S1234_C,
    IRC_S1235_A,
    IRC_S1235_B,
    IRC_S1235_C,
    Person,
    Section1256Contract,
    Transaction,
    controlling_stock_ownership_1239,
    option_is_section_1233c_option,
    sale_or_exchange_to,
    section_1233_disapplied_for_hedging_1233g,
};

pub relation short_sale(t: Transaction, p: Person, sold_short_on: Date) kind empirical {
    label en official "a short sale of property (section 1233(a))";
}
pub relation property_used_to_close_is_capital_asset(t: Transaction, p: Person) kind empirical {
    label en unofficial "the property (including a commodity future) used to close the short sale is a capital asset in the taxpayer's hands (section 1233(a))";
}
pub relation short_sale_gain_or_loss_is_capital(t: Transaction, p: Person) kind institutional {
    label en official "section 1233(a): gain or loss from the short sale is capital gain or loss, to the extent the closing property is a capital asset";
}
@source(IRC_S1233_A, quote = "gain or loss from the short sale of property shall be considered as gain or loss from the sale or exchange of a capital asset to the extent that the property, including a commodity future, used to close the short sale constitutes a capital asset in the hands of the taxpayer.")
rule Section1233CapitalCharacterRule(t: Transaction, p: Person, sold_short_on: Date) strict {
    label en official "section 1233(a): short-sale gain/loss is capital to the extent the closing property is a capital asset";
    when short_sale(t, p, sold_short_on);
    when property_used_to_close_is_capital_asset(t, p);
    then short_sale_gain_or_loss_is_capital(t, p);
}

// (b): short-term gain and holding-period-restart rules, triggered when
// substantially identical property was already held (not more than 1 year)
// at the short-sale date, OR acquired after the short sale and on/before
// its closing.
pub relation substantially_identical_property_held_not_more_than_1_year_at_short_sale(t: Transaction, p: Person, si_property: Asset) kind empirical {
    label en unofficial "section 1233(b): on the date of the short sale, substantially identical property has been held by the taxpayer for not more than 1 year (determined without regard to (b)(2)'s effect on holding period)";
}
pub relation substantially_identical_property_acquired_after_short_sale_before_closing(t: Transaction, p: Person, si_property: Asset) kind empirical {
    label en unofficial "section 1233(b): substantially identical property is acquired by the taxpayer after the short sale and on or before the date the short sale is closed";
}
pub relation closes_short_sale(t: Transaction, closing_t: Transaction, closed_on: Date) kind empirical {
    label en unofficial "the closing transaction of the short sale, and its date";
}
pub relation section_1233b_triggered(t: Transaction, p: Person) kind institutional {
    label en unofficial "section 1233(b)'s triggering condition is met (either prong)";
}
@source(IRC_S1233_B, relation = formalizes, coverage = partial, quote = "substantially identical property has been held by the taxpayer for not more than 1 year")
rule Section1233bTriggeredFromHeldNotMoreThanOneYearRule(t: Transaction, p: Person, si: Asset) strict {
    when substantially_identical_property_held_not_more_than_1_year_at_short_sale(t, p, si);
    then section_1233b_triggered(t, p);
}
@source(IRC_S1233_B, relation = formalizes, coverage = partial, quote = "substantially identical property is acquired by the taxpayer after such short sale and on or before the date of the closing thereof")
rule Section1233bTriggeredFromAcquiredAfterShortSaleRule(t: Transaction, p: Person, si: Asset) strict {
    when substantially_identical_property_acquired_after_short_sale_before_closing(t, p, si);
    then section_1233b_triggered(t, p);
}
pub relation short_sale_closing_gain_short_term(t: Transaction, closing_t: Transaction) kind institutional {
    label en official "section 1233(b)(1): gain on the closing of the short sale is short-term capital gain, notwithstanding the period any closing property was held";
}
@source(IRC_S1233_B, quote = "any gain on the closing of such short sale shall be considered as a gain on the sale or exchange of a capital asset held for not more than 1 year (notwithstanding the period of time any property used to close such short sale has been held); and")
rule Section1233bShortTermGainRule(t: Transaction, p: Person, closing_t: Transaction, closed_on: Date) defeasible {
    label en official "section 1233(b)(1): closing gain is short-term";
    when not_known(section_1233_disapplied_for_hedging_1233g(t));
    when section_1233b_triggered(t, p);
    when closes_short_sale(t, closing_t, closed_on);
    when short_sale_gain_or_loss_is_capital(t, p);
    then short_sale_closing_gain_short_term(t, closing_t);
}
pub relation short_sale_resets_holding_period_of_si_property(t: Transaction, p: Person, si: Asset, restart_on: Date) kind institutional {
    label en official "section 1233(b)(2): the holding period of the substantially identical property is deemed to begin on the closing date (or an earlier disposition date), notwithstanding section 1223";
}
@source(IRC_S1233_B, quote = "the holding period of such substantially identical property shall be considered to begin (notwithstanding section 1223, relating to the holding period of property) on the date of the closing of the short sale, or on the date of a sale, gift, or other disposition of such property, whichever date occurs first.")
rule Section1233bHoldingPeriodResetFromHeldRule(t: Transaction, p: Person, si: Asset, closing_t: Transaction, closed_on: Date) defeasible {
    label en official "section 1233(b)(2): substantially identical property's holding period restarts at the short sale's closing date (held-not-more-than-1-year prong)";
    when not_known(section_1233_disapplied_for_hedging_1233g(t));
    when substantially_identical_property_held_not_more_than_1_year_at_short_sale(t, p, si);
    when closes_short_sale(t, closing_t, closed_on);
    then short_sale_resets_holding_period_of_si_property(t, p, si, closed_on);
}
rule Section1233bHoldingPeriodResetFromAcquiredAfterRule(t: Transaction, p: Person, si: Asset, closing_t: Transaction, closed_on: Date) defeasible {
    label en official "section 1233(b)(2): substantially identical property's holding period restarts at the short sale's closing date (acquired-after-short-sale prong)";
    when not_known(section_1233_disapplied_for_hedging_1233g(t));
    when substantially_identical_property_acquired_after_short_sale_before_closing(t, p, si);
    when closes_short_sale(t, closing_t, closed_on);
    then short_sale_resets_holding_period_of_si_property(t, p, si, closed_on);
}
pub relation option_to_sell_at_fixed_price(t: Transaction, p: Person, acquired_on: Date) kind empirical {
    label en unofficial "section 1233(b) last sentence: an option to sell property at a fixed price, treated as a short sale for purposes of this subsection";
}
@source(IRC_S1233_B, quote = "the acquisition of an option to sell property at a fixed price shall be considered as a short sale, and the exercise or failure to exercise such option shall be considered as a closing of such short sale.")
rule OptionToSellTreatedAsShortSaleRule(t: Transaction, p: Person, acquired_on: Date) strict {
    label en official "section 1233(b): an option to sell at a fixed price is treated as a short sale for (b)'s purposes";
    when option_to_sell_at_fixed_price(t, p, acquired_on);
    then short_sale(t, p, acquired_on);
}

// (c): the same-day identified-option exception to (b).
pub relation option_acquired_same_day_as_identified_property(t: Transaction, p: Person, identified_property_acquired_on: Date, option_acquired_on: Date) kind empirical {
    label en official "section 1233(c): the option to sell was acquired the same day as the property identified as intended for exercising it, and after August 16, 1954";
}
pub relation section_1233c_exception_applies(t: Transaction) kind institutional {
    label en official "section 1233(c): subsection (b) does not apply to this option-to-sell transaction";
}
@source(IRC_S1233_C, quote = "Subsection (b) shall not include an option to sell property at a fixed price acquired on the same day on which the property identified as intended to be used in exercising such option is acquired and which, if exercised, is exercised through the sale of the property so identified.")
rule Section1233cExceptionRule(t: Transaction, p: Person, identified_on: Date, option_on: Date) strict {
    label en official "section 1233(c): same-day-acquired identified-property option is excepted from (b)";
    when option_acquired_same_day_as_identified_property(t, p, identified_on, option_on);
    when identified_on == option_on;
    when option_on > @1954-08-16;
    then section_1233c_exception_applies(t);
}

// (d): long-term loss.
pub relation substantially_identical_property_held_more_than_1_year_at_short_sale(t: Transaction, p: Person, si_property: Asset) kind empirical {
    label en unofficial "section 1233(d): on the date of the short sale, substantially identical property has been held by the taxpayer for MORE than 1 year";
}
pub relation short_sale_closing_loss_long_term(t: Transaction, closing_t: Transaction) kind institutional {
    label en official "section 1233(d): loss on the closing of the short sale is long-term capital loss, notwithstanding the period any closing property was held and notwithstanding section 1234";
}
@source(IRC_S1233_D, quote = "any loss on the closing of such short sale shall be considered as a loss on the sale or exchange of a capital asset held for more than 1 year (notwithstanding the period of time any property used to close such short sale has been held, and notwithstanding section 1234).")
rule Section1233dLongTermLossRule(t: Transaction, p: Person, si: Asset, closing_t: Transaction, closed_on: Date) defeasible {
    label en official "section 1233(d): closing loss is long-term when substantially identical property was held more than 1 year at the short-sale date";
    when not_known(section_1233_disapplied_for_hedging_1233g(t));
    when substantially_identical_property_held_more_than_1_year_at_short_sale(t, p, si);
    when closes_short_sale(t, closing_t, closed_on);
    when short_sale_gain_or_loss_is_capital(t, p);
    then short_sale_closing_loss_long_term(t, closing_t);
}

// =============================================================================
// Section 1234: options
// =============================================================================

pub entity OptionContract : Asset {
    label en unofficial "an option to buy or sell property (section 1234)";
}
pub relation option_relates_to(opt: OptionContract, underlying: Asset) kind empirical {
    label en unofficial "the property to which the option relates (section 1234(a)(1))";
}
pub relation option_sold_or_exchanged(t: Transaction, holder: Person, opt: OptionContract, on: Date) kind empirical;
pub relation option_expired_unexercised(opt: OptionContract, holder: Person, expired_on: Date) kind empirical {
    label en official "section 1234(a)(2): the option expired without being exercised, the loss attributable to the failure to exercise it";
}
pub relation option_would_be_ordinary_property_1221a1(opt: OptionContract) kind empirical {
    label en official "section 1234(a)(3)(A): the option constitutes property described in section 1221(a)(1) (inventory/property held for sale)";
}
pub relation option_gain_treated_as_other_than_capital_1234a3b(opt: OptionContract) kind empirical {
    label en official "section 1234(a)(3)(B): gain on the option's sale/exchange is, without regard to (a), treated as other than capital gain";
}
pub relation option_purchaser_gain_or_loss_character_follows_underlying(opt: OptionContract, holder: Person) kind institutional {
    label en official "section 1234(a)(1): the purchaser's gain or loss on the option has the same character as the underlying property would have in the taxpayer's hands, unless (a)(3) excepts it";
}
@source(IRC_S1234_A, quote = "Gain or loss attributable to the sale or exchange of, or loss attributable to failure to exercise, an option to buy or sell property shall be considered gain or loss from the sale or exchange of property which has the same character as the property to which the option relates has in the hands of the taxpayer")
rule Section1234aPurchaserCharacterFromSaleRule(t: Transaction, opt: OptionContract, holder: Person, on: Date) defeasible {
    label en official "section 1234(a)(1): the option purchaser's gain/loss character follows the underlying property, on a sale or exchange of the option";
    when option_sold_or_exchanged(t, holder, opt, on);
    when not_known(option_would_be_ordinary_property_1221a1(opt));
    when not_known(option_gain_treated_as_other_than_capital_1234a3b(opt));
    then option_purchaser_gain_or_loss_character_follows_underlying(opt, holder);
}
@source(IRC_S1234_A, quote = "if loss is attributable to failure to exercise an option, the option shall be deemed to have been sold or exchanged on the day it expired.")
rule Section1234aPurchaserCharacterFromExpirationRule(opt: OptionContract, holder: Person, expired_on: Date) defeasible {
    label en official "section 1234(a)(2): a loss from failure to exercise is deemed a sale or exchange on the expiration date, following the same character rule";
    when option_expired_unexercised(opt, holder, expired_on);
    when not_known(option_would_be_ordinary_property_1221a1(opt));
    when not_known(option_gain_treated_as_other_than_capital_1234a3b(opt));
    when not_known(option_is_section_1233c_option(opt));
    then option_purchaser_gain_or_loss_character_follows_underlying(opt, holder);
}
// (a)(3)(C) — no character-follows-underlying treatment for a loss on a
// section 1233(c) same-day identified-property option (that option's own
// cost is added to the identified property's basis instead, per (c)).
// Not separately gated here: option_expired_unexercised is not expected to
// be asserted for a section 1233(c) option in a well-formed case.

// (b): grantor treatment.
pub relation option_granted(opt: OptionContract, grantor: Person, granted_on: Date) kind empirical {
    label en unofficial "the person granted (wrote) the option (section 1234(b))";
}
pub relation option_property_is_stocks_securities_or_commodities(opt: OptionContract) kind empirical {
    label en official "section 1234(b)(2)(B): the option relates to stocks, securities (incl. when-issued), commodities, or commodity futures";
}
pub relation option_closing_transaction(opt: OptionContract, grantor: Person, t: Transaction, on: Date) kind empirical {
    label en official "section 1234(b)(2)(A): termination of the grantor's obligation under the option, other than by exercise or lapse";
}
pub relation option_lapsed(opt: OptionContract, grantor: Person, lapsed_on: Date) kind empirical;
pub relation option_granted_in_ordinary_course_of_granting_options_business(opt: OptionContract, grantor: Person) kind empirical {
    label en official "section 1234(b)(3): the option was granted in the ordinary course of the grantor's trade or business of granting options — excepts (b) entirely";
}
pub relation option_grantor_gain_or_loss_short_term_capital(opt: OptionContract, grantor: Person) kind institutional {
    label en official "section 1234(b)(1): the grantor's gain or loss from a closing transaction, or gain on lapse, is short-term capital gain or loss";
}
@source(IRC_S1234_B, quote = "gain or loss from any closing transaction with respect to, and gain on lapse of, an option in property shall be treated as a gain or loss from the sale or exchange of a capital asset held not more than 1 year.")
rule Section1234bGrantorClosingTransactionRule(opt: OptionContract, grantor: Person, t: Transaction, on: Date) defeasible {
    label en official "section 1234(b)(1): grantor's closing-transaction gain/loss is short-term capital";
    when option_property_is_stocks_securities_or_commodities(opt);
    when option_closing_transaction(opt, grantor, t, on);
    when not_known(option_granted_in_ordinary_course_of_granting_options_business(opt, grantor));
    then option_grantor_gain_or_loss_short_term_capital(opt, grantor);
}
rule Section1234bGrantorLapseRule(opt: OptionContract, grantor: Person, lapsed_on: Date) defeasible {
    label en official "section 1234(b)(1): grantor's gain on lapse is short-term capital gain";
    when option_property_is_stocks_securities_or_commodities(opt);
    when option_lapsed(opt, grantor, lapsed_on);
    when not_known(option_granted_in_ordinary_course_of_granting_options_business(opt, grantor));
    then option_grantor_gain_or_loss_short_term_capital(opt, grantor);
}

// (c): options on section 1256 contracts, and cash settlement options.
pub relation option_on_section_1256_contract(opt: OptionContract) kind empirical {
    label en official "section 1234(c)(1): the option is on a section 1256 contract";
}
pub relation option_exercised(opt: OptionContract, exercised_on: Date) kind empirical;
pub relation gain_or_loss_recognized_on_option_exercise(opt: OptionContract) kind institutional {
    label en official "section 1234(c)(1): gain or loss is recognized on the exercise of an option on a section 1256 contract (an exception to the general non-recognition-on-exercise rule)";
}
@source(IRC_S1234_C, quote = "Gain or loss shall be recognized on the exercise of an option on a section 1256 contract (within the meaning of section 1256(b)).")
rule Section1234cSection1256ContractOptionExerciseRule(opt: OptionContract, exercised_on: Date) strict {
    label en official "section 1234(c)(1): gain/loss recognized on exercise of a section 1256 contract option";
    when option_on_section_1256_contract(opt);
    when option_exercised(opt, exercised_on);
    then gain_or_loss_recognized_on_option_exercise(opt);
}
pub relation cash_settlement_option(opt: OptionContract) kind empirical {
    label en official "section 1234(c)(2)(B): an option which on exercise settles (or could settle) in cash or property other than the underlying property";
}
pub relation cash_settlement_option_treated_as_option_to_buy_or_sell(opt: OptionContract) kind institutional {
    label en official "section 1234(c)(2)(A): a cash settlement option is treated as an option to buy or sell property, for purposes of (a) and (b)";
}
@source(IRC_S1234_C, quote = "a cash settlement option shall be treated as an option to buy or sell property.")
rule CashSettlementOptionTreatedAsOptionRule(opt: OptionContract) strict {
    label en official "section 1234(c)(2)(A): cash settlement options are treated as options to buy or sell property";
    when cash_settlement_option(opt);
    then cash_settlement_option_treated_as_option_to_buy_or_sell(opt);
}

// =============================================================================
// Section 1234A: gains or losses from certain terminations
// =============================================================================

pub relation right_or_obligation_terminated(t: Transaction, p: Person, underlying: Asset, terminated_on: Date) kind empirical {
    label en unofficial "section 1234A(1): cancellation, lapse, expiration, or other termination of a right or obligation (other than a securities futures contract) with respect to property which is (or on acquisition would be) a capital asset";
}
pub relation section_1256_contract_terminated(t: Transaction, p: Person, contract: Section1256Contract, terminated_on: Date) kind empirical {
    label en unofficial "section 1234A(2): termination of a section 1256 contract that is a capital asset, not otherwise described in (1)";
}
pub relation retirement_of_debt_instrument(t: Transaction) kind empirical {
    label en official "the transaction is a retirement of a debt instrument (whether or not through a trust or other participation arrangement) — section 1234A's exception";
}
pub relation section_1234a_gain_or_loss_from_sale_of_capital_asset(t: Transaction, p: Person) kind institutional {
    label en official "section 1234A: gain or loss from the termination is treated as gain or loss from the sale of a capital asset";
}
@source(IRC_S1234A, quote = "a right or obligation (other than a securities futures contract, as defined in section 1234B) with respect to property which is (or on acquisition would be) a capital asset in the hands of the taxpayer, or")
rule Section1234aTerminationFromRightOrObligationRule(t: Transaction, p: Person, underlying: Asset, terminated_on: Date) defeasible {
    label en official "section 1234A(1): termination of a right/obligation w.r.t. capital-asset property is treated as a capital-asset sale, unless it is a debt-instrument retirement";
    when right_or_obligation_terminated(t, p, underlying, terminated_on);
    when not_known(retirement_of_debt_instrument(t));
    then section_1234a_gain_or_loss_from_sale_of_capital_asset(t, p);
}
@source(IRC_S1234A, relation = formalizes, coverage = partial, quote = "a section 1256 contract (as defined in section 1256) not described in paragraph (1) which is a capital asset in the hands of the taxpayer,")
rule Section1234aTerminationFromSection1256ContractRule(t: Transaction, p: Person, contract: Section1256Contract, terminated_on: Date) defeasible {
    label en official "section 1234A(2): termination of a capital-asset section 1256 contract is treated as a capital-asset sale, unless it is a debt-instrument retirement";
    when section_1256_contract_terminated(t, p, contract, terminated_on);
    when not_known(retirement_of_debt_instrument(t));
    then section_1234a_gain_or_loss_from_sale_of_capital_asset(t, p);
}

// =============================================================================
// Section 1235: patents
// =============================================================================

pub relation transfer_of_all_substantial_patent_rights(t: Transaction, holder: Person, patent: Asset, on: Date) kind empirical {
    label en official "section 1235(a): a transfer (other than by gift, inheritance, or devise) of all substantial rights to a patent, or an undivided interest including a part of all such rights";
}
pub relation section_1235_holder(holder: Person, patent: Asset) kind institutional {
    label en official "section 1235(b): the holder of the patent (the creator, or a pre-reduction-to-practice purchaser who is not the creator's employer or related person)";
}
pub relation created_the_patented_property(individual: Person, patent: Asset) kind empirical {
    label en official "section 1235(b)(1): the individual's efforts created the patented property";
}
@source(IRC_S1235_B, quote = "any individual whose efforts created such property, or")
rule Section1235HolderFromCreatorRule(individual: Person, patent: Asset) strict {
    label en official "section 1235(b)(1): the creator is a holder";
    when created_the_patented_property(individual, patent);
    then section_1235_holder(individual, patent);
}
pub relation acquired_pre_reduction_to_practice_for_consideration(acquirer: Person, patent: Asset, creator: Person) kind empirical {
    label en official "section 1235(b)(2): the individual acquired an interest in the property for consideration in money or money's worth paid to the creator before actual reduction to practice of the invention";
}
pub relation employer_of_creator(employer: Person, creator: Person) kind empirical {
    label en unofficial "section 1235(b)(2)(A): the employer of the creator";
}
pub relation related_to_creator_1235c(acquirer: Person, creator: Person) kind empirical {
    label en unofficial "section 1235(b)(2)(B): related to the creator within the meaning of subsection (c) — case-asserted this stage (TECH_GAP: the (c) 25%-substituted section 267(b)/(c)/707(b) test is not itself derived, see below)";
}
@source(IRC_S1235_B, quote = "any other individual who has acquired his interest in such property in exchange for consideration in money or money's worth paid to such creator prior to actual reduction to practice of the invention covered by the patent, if such individual is neither—")
rule Section1235HolderFromPreReductionPurchaserRule(acquirer: Person, patent: Asset, creator: Person) defeasible {
    label en official "section 1235(b)(2): a pre-reduction-to-practice purchaser (not the creator's employer or related person) is a holder";
    when acquired_pre_reduction_to_practice_for_consideration(acquirer, patent, creator);
    when not_known(employer_of_creator(acquirer, creator));
    when not_known(related_to_creator_1235c(acquirer, creator));
    then section_1235_holder(acquirer, patent);
}

pub relation section_1235_transfer_is_long_term_capital_gain(t: Transaction, holder: Person, patent: Asset) kind institutional {
    label en official "section 1235(a): the transfer is considered the sale or exchange of a capital asset held for more than 1 year, regardless of periodic or contingent payment terms";
}
pub relation section_1235c_related_persons(a: Person, b: Person) kind institutional {
    label en unofficial "section 1235(c): persons related within any section 267(b) paragraph or section 707(b) (25% substituted for 'more than 50 percent', and the section 267(c)(4) family class narrowed to spouse/ancestors/lineal descendants) — modelled below via the same controlled-corporation construct as section 1239(c), at the 25% threshold, for the corporate-stock branch only; the partnership/707(b) and family-narrowing branches are TECH_GAP";
}
@source(IRC_S1235_C, relation = formalizes, coverage = partial, quote = "the phrase \"25 percent or more\" shall be substituted for the phrase \"more than 50 percent\" each place it appears in section 267(b) or 707(b)")
rule Section1235cRelatedFromStockOwnershipRule(a: Person, corp: Corporation, share: Decimal) defeasible {
    label en official "section 1235(c): 25%-or-more corporate stock ownership (directly or indirectly) makes the person and the corporation related, for section 1235 purposes";
    when controlling_stock_ownership_1239(a, corp, share);
    when share >= 0.25;
    then section_1235c_related_persons(a, corp);
}
@source(IRC_S1235_A, quote = "A transfer (other than by gift, inheritance, or devise) of property consisting of all substantial rights to a patent, or an undivided interest therein which includes a part of all such rights, by any holder shall be considered the sale or exchange of a capital asset held for more than 1 year")
rule Section1235TransferLongTermCapitalGainRule(t: Transaction, holder: Person, patent: Asset, on: Date, transferee: Person) defeasible {
    label en official "section 1235(a): a holder's transfer of all substantial patent rights is long-term capital gain, unless the transferee is a section 1235(c) related person";
    when transfer_of_all_substantial_patent_rights(t, holder, patent, on);
    when section_1235_holder(holder, patent);
    when sale_or_exchange_to(t, holder, transferee);
    when not_known(section_1235c_related_persons(holder, transferee));
    then section_1235_transfer_is_long_term_capital_gain(t, holder, patent);
}
// (d) cross-reference to section 871(a) (nonresident aliens) is
// NON_NORMATIVE (pure cross-reference, no independent rule).
