// Stage 3 (IRC-07, A05). Section 1202 remainder (module 16 carries (a)-(e) tests as
// case totals): (a)(2) empowerment zone 60 percent, (b)(3)(B) joint-return allocation,
// (c)(2)(B) specialized small business investment companies, (c)(3) redemptions,
// (d)(2)-(3) aggregate gross assets and the parent-subsidiary group, (e)(2)-(8) the
// active business sub-rules and the excluded trades, (f) conversion, (g) pass-thru
// entities, (h)(4) section 351/368 exchanges, (i) basis rules, (j) offsetting short
// positions.
//
// Method. The added tests feed the existing relations of module 16 through additional
// rules (and, for the redemption disqualification and the active business failures, guards
// added to QualifiedSmallBusinessStockRule and ActiveBusinessRequirementMetRule). Amounts
// that sum over derived relations are case-supplied totals (the section 111 subset limit).

// =============================================================================
// (a)(2): empowerment zone businesses
// =============================================================================

use self::{
    Asset,
    Corporation,
    IRC_S1202_A,
    IRC_S1202_B,
    IRC_S1202_C,
    IRC_S1202_D,
    IRC_S1202_E,
    IRC_S1202_F,
    IRC_S1202_G,
    IRC_S1202_H,
    IRC_S1202_I,
    IRC_S1202_J,
    Person,
    QsbsStock,
    Section1202Act2009Date,
    Section1202ActiveBusinessAssetRatio,
    TaxableYear,
    Transaction,
    acquired_at_original_issue_for_money_property_or_services,
    active_business_80_percent_test_met,
    active_business_requirement_met,
    qsbs_acquired_on,
    qualified_small_business_stock,
    stock_in_c_corporation,
    stock_issued_on,
    total_assets_value,
};

pub const Section1202a2EnactmentDate: Date = @2000-12-21 {
    label en official "the date of the enactment of paragraph (2) of section 1202(a): the Community Renewal Tax Relief Act of 2000, Pub. L. 106-554, approved December 21, 2000 (the date itself is not in the pinned text, which names the Act only: JUDGMENT CALL / SOURCE_GAP note)";
};
pub relation qbe_during_substantially_all_of_holding_period(p: Person, stock: QsbsStock) kind empirical {
    label en official "section 1202(a)(2)(A): the corporation is a qualified business entity (section 1397C(b)) during substantially all of the taxpayer's holding period (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation qbe_zone_is_district_of_columbia_enterprise_zone(stock: QsbsStock) kind empirical {
    label en official "section 1202(a)(2)(D): the zone in which the entity qualifies is the District of Columbia Enterprise Zone, which is not treated as an empowerment zone";
}
pub relation gain_attributable_to_periods_before_2019(p: Person, stock: QsbsStock, amount: Money) kind empirical {
    label en official "section 1202(a)(2)(C): the part of the gain attributable to periods on or before December 31, 2018";
}
pub relation gain_attributable_to_periods_after_2018(p: Person, stock: QsbsStock, amount: Money) kind empirical {
    label en official "section 1202(a)(2)(C): the part of the gain attributable to periods after December 31, 2018";
}
pub relation empowerment_zone_stock_1202a2(p: Person, stock: QsbsStock) kind institutional {
    label en official "section 1202(a)(2)(A): qualified small business stock acquired after the enactment of paragraph (2) in a qualified business pte, outside the District of Columbia Enterprise Zone, for stock not covered by paragraphs (3) and (4)";
}
@source(IRC_S1202_A, relation = formalizes, coverage = exact, quote = "In the case of qualified small business stock acquired after the date of the enactment of this paragraph in a corporation which is a qualified business entity (as defined in section 1397C(b)) during substantially all of the taxpayer's holding period for such stock, paragraph (1) shall be applied by substituting \"60 percent\" for \"50 percent\".")
rule EmpowermentZoneStockRule(p: Person, stock: QsbsStock, acquired_on: Date) defeasible {
    label en official "section 1202(a)(2)(A), (D) with the (a)(3) and (a)(4) exclusions for stock acquired after February 17, 2009";
    when qsbs_acquired_on(p, stock, acquired_on);
    when acquired_on > Section1202a2EnactmentDate;
    when acquired_on <= Section1202Act2009Date;
    when qbe_during_substantially_all_of_holding_period(p, stock);
    when not_known(qbe_zone_is_district_of_columbia_enterprise_zone(stock));
    then empowerment_zone_stock_1202a2(p, stock);
}
pub relation section_1202a2_excluded_gain(p: Person, stock: QsbsStock, amount: Money) kind institutional {
    label en official "section 1202(a)(2): 60 percent of the gain attributable to periods on or before December 31, 2018 and 50 percent of the later gain (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1202_A, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to gain attributable to periods after December 31, 2018.")
rule EmpowermentZoneExcludedGainRule(p: Person, stock: QsbsStock, before: Money, after: Money) defeasible {
    label en official "section 1202(a)(2)(A), (C)";
    when empowerment_zone_stock_1202a2(p, stock);
    when gain_attributable_to_periods_before_2019(p, stock, before);
    when gain_attributable_to_periods_after_2018(p, stock, after);
    then section_1202a2_excluded_gain(p, stock, round(before * 0.60 + after * 0.50, 2, "HALF_UP"));
}
pub relation section_1400B_rules_applied_to_1202a2(p: Person, stock: QsbsStock) kind empirical {
    label en official "section 1202(a)(2)(B): rules similar to the rules of paragraphs (5) and (7) of section 1400B(b), as in effect before its repeal, apply (section 1400B is repealed and not pinned: SOURCE_GAP)";
}

// =============================================================================
// (b)(3)(B): joint returns
// =============================================================================

pub relation joint_return_gain_taken_into_account(p: Person, spouse: Person, corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1202(b)(3)(B): the amount of gain taken into account under subsection (a) on a joint return of the spouses";
}
pub relation gain_allocated_to_spouse_for_later_years(p: Person, spouse: Person, corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1202(b)(3)(B): the amount is allocated equally between the spouses for applying the subsection to subsequent years (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1202_B, relation = formalizes, coverage = exact, quote = "In the case of any joint return, the amount of gain taken into account under subsection (a) shall be allocated equally between the spouses for purposes of applying this subsection to subsequent taxable years.")
rule JointReturnAllocationRule(p: Person, spouse: Person, corp: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1202(b)(3)(B)";
    when joint_return_gain_taken_into_account(p, spouse, corp, y, amount);
    then gain_allocated_to_spouse_for_later_years(p, spouse, corp, y, round(amount * 50 percent, 2, "HALF_UP"));
}

// =============================================================================
// (c)(2)(B): specialized small business investment companies
// =============================================================================

pub relation licensed_under_301d_sbia_as_of_may_13_1993(corp: Corporation) kind empirical {
    label en official "section 1202(c)(2)(B)(ii): the corporation is licensed to operate under section 301(d) of the Small Business Investment Act of 1958 (as in effect on May 13, 1993)";
}
pub relation specialized_small_business_investment_company(corp: Corporation) kind institutional {
    label en official "section 1202(c)(2)(B)(ii): a specialized small business investment company";
}
@source(IRC_S1202_C, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the term \"specialized small business investment company\" means any eligible corporation (as defined in subsection (e)(4)) which is licensed to operate under section 301(d) of the Small Business Investment Act of 1958 (as in effect on May 13, 1993).")
rule SsbicRule(corp: Corporation) defeasible {
    label en official "section 1202(c)(2)(B)(ii)";
    when eligible_corporation_by_definition(corp);
    when licensed_under_301d_sbia_as_of_may_13_1993(corp);
    then specialized_small_business_investment_company(corp);
}
@source(IRC_S1202_C, relation = formalizes, coverage = exact, quote = "Notwithstanding any provision of subsection (e), a corporation shall be treated as meeting the active business requirements of such subsection for any period during which such corporation qualifies as a specialized small business investment company.")
rule ActiveBusinessWaivedForSsbicRule(corp: Corporation, p: Person, stock: QsbsStock) defeasible {
    label en official "section 1202(c)(2)(B)(i)";
    when stock_in_c_corporation(stock, corp);
    when acquired_at_original_issue_for_money_property_or_services(stock, p);
    when specialized_small_business_investment_company(corp);
    then active_business_requirement_met(corp, p, stock);
}

// =============================================================================
// (c)(3): purchases by the corporation of its own stock
// =============================================================================

pub relation own_stock_purchase_event(corp: Corporation, on: Date, from_taxpayer_or_related: Boolean) kind empirical {
    label en official "section 1202(c)(3)(A): the corporation purchased (directly or indirectly) its own stock on the date, from the taxpayer or a person related to the taxpayer under section 267(b) or 707(b) (true) or from another person (false)";
}
pub relation section_304a_redemption_deemed_purchase(corp: Corporation, on: Date, from_taxpayer_or_related: Boolean) kind empirical {
    label en official "section 1202(c)(3)(C): a transaction treated under section 304(a) as a distribution in redemption of the stock of the corporation (the amount treated as a distribution is a purchase of that amount)";
}
pub relation redemption_from_taxpayer_or_related_in_window(corp: Corporation, stock: QsbsStock) kind institutional {
    label en official "section 1202(c)(3)(A): within the 4-year period beginning 2 years before issuance the corporation purchased its stock from the taxpayer or a related person";
}
@source(IRC_S1202_C, relation = formalizes, coverage = exact, quote = "Stock acquired by the taxpayer shall not be treated as qualified small business stock if, at any time during the 4-year period beginning on the date 2 years before the issuance of such stock, the corporation issuing such stock purchased (directly or indirectly) any of its stock from the taxpayer or from a person related (within the meaning of section 267(b) or 707(b)) to the taxpayer.")
rule RedemptionFromTaxpayerRule(corp: Corporation, stock: QsbsStock, issued: Date, on: Date, calendar_before_1: Date) defeasible {
    label en official "section 1202(c)(3)(A): a purchase from the taxpayer or a related person on or after the date 2 years before issuance and before the date 2 years after issuance";
    when stock_issued_on(stock, issued);
    when own_stock_purchase_event(corp, on, true);
    when on >= calendar_before_1;
    when on < add_calendar_period(issued, 2 calendar_year)
        and us.irc.core::civil_calendar_boundary_before(issued, 2, us.irc.core::CalendarYear, calendar_before_1);
    then redemption_from_taxpayer_or_related_in_window(corp, stock);
}
@source(IRC_S1202_C, relation = formalizes, coverage = exact, quote = "If any transaction is treated under section 304(a) as a distribution in redemption of the stock of any corporation, for purposes of subparagraphs (A) and (B), such corporation shall be treated as purchasing an amount of its stock equal to the amount treated as such a distribution under section 304(a).")
rule Redemption304FromTaxpayerRule(corp: Corporation, stock: QsbsStock, issued: Date, on: Date, calendar_before_1: Date) defeasible {
    label en official "section 1202(c)(3)(C) applied to subparagraph (A)";
    when stock_issued_on(stock, issued);
    when section_304a_redemption_deemed_purchase(corp, on, true);
    when on >= calendar_before_1;
    when on < add_calendar_period(issued, 2 calendar_year)
        and us.irc.core::civil_calendar_boundary_before(issued, 2, us.irc.core::CalendarYear, calendar_before_1);
    then redemption_from_taxpayer_or_related_in_window(corp, stock);
}
pub relation purchases_in_2_year_window_total(corp: Corporation, stock: QsbsStock, amount: Money) kind empirical {
    label en official "section 1202(c)(3)(B): the aggregate value (at the time of the purchases) of the purchases of its stock in the 2-year period beginning 1 year before issuance, including section 304(a) amounts (a case total: a sum over dated purchases)";
}
pub relation aggregate_stock_value_at_window_start(corp: Corporation, stock: QsbsStock, amount: Money) kind empirical {
    label en official "section 1202(c)(3)(B): the aggregate value of all of the corporation's stock at the beginning of the 2-year period";
}
pub relation significant_redemptions_in_window(corp: Corporation, stock: QsbsStock) kind institutional {
    label en official "section 1202(c)(3)(B): the purchases exceed 5 percent of the aggregate value of all of its stock";
}
@source(IRC_S1202_C, relation = formalizes, coverage = exact, quote = "Stock issued by a corporation shall not be treated as qualified business stock if, during the 2-year period beginning on the date 1 year before the issuance of such stock, such corporation made 1 or more purchases of its stock with an aggregate value (as of the time of the respective purchases) exceeding 5 percent of the aggregate value of all of its stock as of the beginning of such 2-year period.")
rule SignificantRedemptionsRule(corp: Corporation, stock: QsbsStock, purchases: Money, total: Money) defeasible {
    label en official "section 1202(c)(3)(B)";
    when purchases_in_2_year_window_total(corp, stock, purchases);
    when aggregate_stock_value_at_window_start(corp, stock, total);
    when purchases > total * 5 percent;
    then significant_redemptions_in_window(corp, stock);
}
pub relation stock_disqualified_by_redemption_1202c3(stock: QsbsStock) kind institutional {
    label en official "section 1202(c)(3): the stock is not qualified small business stock by reason of the corporation's purchases of its own stock";
}
rule DisqualifiedByTaxpayerRedemptionRule(corp: Corporation, stock: QsbsStock) defeasible {
    label en official "section 1202(c)(3)(A)";
    when redemption_from_taxpayer_or_related_in_window(corp, stock);
    then stock_disqualified_by_redemption_1202c3(stock);
}
rule DisqualifiedBySignificantRedemptionRule(corp: Corporation, stock: QsbsStock) defeasible {
    label en official "section 1202(c)(3)(B)";
    when significant_redemptions_in_window(corp, stock);
    then stock_disqualified_by_redemption_1202c3(stock);
}

// =============================================================================
// (d)(2)-(3): aggregate gross assets and the parent-subsidiary group
// =============================================================================

pub relation cash_held_by_corporation(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(d)(2)(A): the amount of cash held by the corporation";
}
pub relation adjusted_basis_of_property_held(corp: Corporation, item: Asset, amount: Money) kind empirical {
    label en official "section 1202(d)(2)(A): the adjusted basis of other property held by the corporation (property not contributed)";
}
pub relation contributed_property_fair_market_value(corp: Corporation, item: Asset, amount: Money) kind empirical {
    label en official "section 1202(d)(2)(B): the fair market value, immediately after the contribution, of property contributed to the corporation (or other property with a basis determined by reference to its basis)";
}
pub relation basis_sum_of_uncontributed_property(corp: Corporation, amount: Money) kind institutional {
    label en official "section 1202(d)(2)(A): the sum of the adjusted bases of the property that was not contributed (a sum over the case's empirical items)";
}
rule BasisSumRule(corp: Corporation, cash: Money) defeasible {
    label en official "section 1202(d)(2)(A)";
    when cash_held_by_corporation(corp, cash);
    then basis_sum_of_uncontributed_property(corp, sum all amount: Money for item: Asset where adjusted_basis_of_property_held(corp, item, amount));
}
pub relation contributed_property_value_sum(corp: Corporation, amount: Money) kind institutional {
    label en official "section 1202(d)(2)(B): the sum of the fair market values of contributed property, each taken as its basis";
}
@source(IRC_S1202_D, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the adjusted basis of any property contributed to the corporation (or other property with a basis determined in whole or in part by reference to the adjusted basis of property so contributed) shall be determined as if the basis of the property contributed to the corporation (immediately after such contribution) were equal to its fair market value as of the time of such contribution.")
rule ContributedValueSumRule(corp: Corporation, cash: Money) defeasible {
    label en official "section 1202(d)(2)(B)";
    when cash_held_by_corporation(corp, cash);
    then contributed_property_value_sum(corp, sum all amount: Money for item: Asset where contributed_property_fair_market_value(corp, item, amount));
}
pub relation aggregate_gross_assets_computed(corp: Corporation, amount: Money) kind institutional {
    label en official "section 1202(d)(2)(A)-(B): the aggregate gross assets - cash plus the adjusted bases of other property, contributed property at its fair market value (exposed for the case: the (d)(1) tests read the case totals aggregate_gross_assets_before_issuance and _immediately_after_issuance)";
}
@source(IRC_S1202_D, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the term \"aggregate gross assets\" means the amount of cash and the aggregate adjusted bases of other property held by the corporation.")
rule AggregateGrossAssetsRule(corp: Corporation, cash: Money, bases: Money, contributed: Money) defeasible {
    label en official "section 1202(d)(2)";
    when cash_held_by_corporation(corp, cash);
    when basis_sum_of_uncontributed_property(corp, bases);
    when contributed_property_value_sum(corp, contributed);
    then aggregate_gross_assets_computed(corp, cash + bases + contributed);
}
pub relation share_of_voting_power_owned(parent: Corporation, sub: Corporation, share: Decimal) kind empirical {
    label en official "section 1202(d)(3)(B)(i): the share of the total combined voting power of all classes of stock entitled to vote that the parent owns directly";
}
pub relation share_of_value_owned(parent: Corporation, sub: Corporation, share: Decimal) kind empirical {
    label en official "section 1202(d)(3)(B)(i): the share of the value of all classes of stock that the parent owns directly";
}
pub relation parent_subsidiary_pair_1202d3(parent: Corporation, sub: Corporation) kind institutional {
    label en official "section 1202(d)(3)(B): the parent-subsidiary controlled group link - the parent owns more than 50 percent of the voting power or of the value, in place of the 80 percent of section 1563(a)(1), without the constructive ownership of section 1563(a)(4) (a direct link: chains of groups are case-supplied)";
}
@source(IRC_S1202_D, relation = formalizes, coverage = exact, quote = "(i) \"more than 50 percent\" shall be substituted for \"at least 80 percent\" each place it appears in section 1563(a)(1), and")
rule ParentSubsidiaryByVotingRule(parent: Corporation, sub: Corporation, share: Decimal) defeasible {
    label en official "section 1202(d)(3)(B)(i), voting power limb";
    when share_of_voting_power_owned(parent, sub, share);
    when share > 0.50;
    then parent_subsidiary_pair_1202d3(parent, sub);
}
rule ParentSubsidiaryByValueRule(parent: Corporation, sub: Corporation, share: Decimal) defeasible {
    label en official "section 1202(d)(3)(B)(i), value limb";
    when share_of_value_owned(parent, sub, share);
    when share > 0.50;
    then parent_subsidiary_pair_1202d3(parent, sub);
}
pub relation treated_as_one_corporation_1202d3(a: Corporation, b: Corporation) kind institutional {
    label en official "section 1202(d)(3)(A): members of the same parent-subsidiary controlled group are treated as one corporation for the subsection";
}
@source(IRC_S1202_D, relation = formalizes, coverage = exact, quote = "All corporations which are members of the same parent-subsidiary controlled group shall be treated as 1 corporation for purposes of this subsection.")
rule TreatedAsOneRule(parent: Corporation, sub: Corporation) defeasible {
    label en official "section 1202(d)(3)(A)";
    when parent_subsidiary_pair_1202d3(parent, sub);
    then treated_as_one_corporation_1202d3(parent, sub);
}

// =============================================================================
// (e)(3), (e)(4): excluded trades and eligible corporation
// =============================================================================

pub entity QsbsTrade {
    label en official "a trade or business of a corporation tested under section 1202(e)(3)";
}
pub enum ExcludedTradeKind1202 {
    ProfessionalServices;
    ReputationOrSkillOfEmployees;
    BankingInsuranceFinancingLeasingInvesting;
    Farming;
    MineralProduction613;
    HotelMotelRestaurant;
    label en official "the excluded trades of section 1202(e)(3)(A)-(E): services in the listed fields or where the principal asset is the reputation or skill of employees, banking and similar businesses, farming, section 613/613A businesses, hotels, motels and restaurants";
}
pub relation trade_is_of_excluded_kind(tb: QsbsTrade, kind: ExcludedTradeKind1202) kind empirical {
    label en official "section 1202(e)(3): the trade or business is of the excluded kind";
}
pub relation trade_or_business_of_corporation(tb: QsbsTrade, corp: Corporation) kind empirical {
    label en official "the trade or business belongs to the corporation";
}
pub relation trade_excluded_1202e3(tb: QsbsTrade) kind institutional {
    label en official "section 1202(e)(3)(A)-(E): the trade or business is excluded";
}
@source(IRC_S1202_E, relation = formalizes, coverage = exact, quote = "(A) any trade or business involving the performance of services in the fields of health, law, engineering, architecture, accounting, actuarial science, performing arts, consulting, athletics, financial services, brokerage services, or any trade or business where the principal asset of such trade or business is the reputation or skill of 1 or more of its employees,")
rule TradeExcludedRule(tb: QsbsTrade, kind: ExcludedTradeKind1202) defeasible {
    label en official "section 1202(e)(3)(A)-(E)";
    when trade_is_of_excluded_kind(tb, kind);
    then trade_excluded_1202e3(tb);
}
pub relation qualified_trade_or_business_1202e3(tb: QsbsTrade) kind institutional {
    label en official "section 1202(e)(3): a qualified trade or business - any trade or business other than the excluded ones";
}
@source(IRC_S1202_E, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"qualified trade or business\" means any trade or business other than—")
rule QualifiedTradeRule(tb: QsbsTrade, corp: Corporation) defeasible {
    label en official "section 1202(e)(3)";
    when trade_or_business_of_corporation(tb, corp);
    when not_known(trade_excluded_1202e3(tb));
    then qualified_trade_or_business_1202e3(tb);
}
pub relation domestic_corporation_1202e4(corp: Corporation) kind empirical {
    label en official "section 1202(e)(4): the corporation is a domestic corporation";
}
pub relation corporation_is_disc_or_former_disc(corp: Corporation) kind empirical {
    label en official "section 1202(e)(4)(A): a DISC or former DISC";
}
pub relation corporation_is_ric_reit_or_remic(corp: Corporation) kind empirical {
    label en official "section 1202(e)(4)(B): a regulated investment company, real estate investment trust or REMIC";
}
pub relation corporation_is_cooperative(corp: Corporation) kind empirical {
    label en official "section 1202(e)(4)(C): a cooperative";
}
pub relation eligible_corporation_by_definition(corp: Corporation) kind institutional {
    label en official "section 1202(e)(4): an eligible corporation - a domestic corporation other than a DISC, RIC, REIT, REMIC or cooperative";
}
@source(IRC_S1202_E, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"eligible corporation\" means any domestic corporation; except that such term shall not include—")
rule EligibleCorporationRule(corp: Corporation) defeasible {
    label en official "section 1202(e)(4)(A)-(C)";
    when domestic_corporation_1202e4(corp);
    when not_known(corporation_is_disc_or_former_disc(corp));
    when not_known(corporation_is_ric_reit_or_remic(corp));
    when not_known(corporation_is_cooperative(corp));
    then eligible_corporation_by_definition(corp);
}
@source(IRC_S1202_E, relation = formalizes, coverage = partial, quote = "the requirements of this subsection are met by a corporation for any period if during such period—")
rule ActiveBusinessRequirementByDefinitionRule(corp: Corporation, p: Person, stock: QsbsStock) defeasible {
    label en official "section 1202(e)(1) with the derived eligible corporation status";
    when stock_in_c_corporation(stock, corp);
    when acquired_at_original_issue_for_money_property_or_services(stock, p);
    when active_business_80_percent_test_met(corp);
    when eligible_corporation_by_definition(corp);
    when not_known(active_business_failure_1202e(corp));
    then active_business_requirement_met(corp, p, stock);
}

// =============================================================================
// (e)(2), (5)-(8): adjusted asset totals and the failures
// =============================================================================

pub relation qualified_assets_base(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(1)(A): the value of the assets used in the active conduct of qualified trades or businesses, before the (e)(2), (5), (6) and (8) additions (supplied by the case, zero where none)";
}
pub relation startup_and_research_activity_assets(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(2): the value of assets used in start-up activities (section 195(c)(1)(A)), research and experimental expenditure activities (section 174) or in-house research (section 41(b)(4)) in connection with a future qualified trade or business";
}
pub relation ratable_share_of_subsidiary_assets(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(5)(A): the parent's ratable share of the subsidiary's assets used in the active conduct of its qualified trades or businesses";
}
pub relation software_royalty_rights_assets(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(8): rights to computer software producing active business computer software royalties (section 543(d)(1))";
}
pub relation working_capital_assets(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(6)(A)-(B): assets held for the reasonably required working capital needs, or held for investment and reasonably expected to be used within 2 years for research or working capital increases (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation corporation_in_existence_at_least_2_years(corp: Corporation) kind empirical {
    label en official "section 1202(e)(6), last sentence: the corporation has been in existence for at least 2 years";
}
pub const Section1202e6WorkingCapitalCeiling: Decimal = 0.50 {
    label en official "50 percent (section 1202(e)(6), last sentence)";
};
pub relation working_capital_counted(corp: Corporation, amount: Money) kind institutional {
    label en official "section 1202(e)(6): the working capital assets counted as used in the active conduct, at most 50 percent of the assets once the corporation is 2 years old";
}
@source(IRC_S1202_E, relation = formalizes, coverage = exact, quote = "shall be treated as used in the active conduct of a qualified trade or business. For periods after the corporation has been in existence for at least 2 years, in no event may more than 50 percent of the assets of the corporation qualify as used in the active conduct of a qualified trade or business by reason of this paragraph.")
rule WorkingCapitalCappedRule(corp: Corporation, wc: Money, total: Money) strict {
    label en official "section 1202(e)(6): the cap applies after 2 years of existence";
    when working_capital_assets(corp, wc);
    when total_assets_value(corp, total);
    when corporation_in_existence_at_least_2_years(corp);
    when wc > total * Section1202e6WorkingCapitalCeiling;
    then working_capital_counted(corp, total * Section1202e6WorkingCapitalCeiling);
}
rule WorkingCapitalWithinCapRule(corp: Corporation, wc: Money, total: Money) strict {
    label en official "section 1202(e)(6): within the cap, or the corporation is younger than 2 years";
    when working_capital_assets(corp, wc);
    when total_assets_value(corp, total);
    when corporation_in_existence_at_least_2_years(corp);
    when wc <= total * Section1202e6WorkingCapitalCeiling;
    then working_capital_counted(corp, wc);
}
rule WorkingCapitalYoungCorporationRule(corp: Corporation, wc: Money) strict {
    label en official "section 1202(e)(6): no cap before the corporation is 2 years old";
    when working_capital_assets(corp, wc);
    when not_known(corporation_in_existence_at_least_2_years(corp));
    then working_capital_counted(corp, wc);
}
pub relation qualified_assets_adjusted(corp: Corporation, amount: Money) kind institutional {
    label en official "section 1202(e)(1)(A) with (e)(2), (5)(A), (6) and (8): the assets treated as used in the active conduct of qualified trades or businesses";
}
@source(IRC_S1202_E, relation = formalizes, coverage = partial, quote = "assets used in such activities shall be treated as used in the active conduct of a qualified trade or business. Any determination under this paragraph shall be made without regard to whether a corporation has any gross income from such activities at the time of the determination.")
rule QualifiedAssetsAdjustedRule(corp: Corporation, base: Money, startup: Money, sub: Money, software: Money, wc: Money) strict {
    label en official "section 1202(e)(2), (5)(A), (6), (8)";
    when qualified_assets_base(corp, base);
    when startup_and_research_activity_assets(corp, startup);
    when ratable_share_of_subsidiary_assets(corp, sub);
    when software_royalty_rights_assets(corp, software);
    when working_capital_counted(corp, wc);
    then qualified_assets_adjusted(corp, base + startup + sub + software + wc);
}
@source(IRC_S1202_E, relation = formalizes, coverage = partial, quote = "(A) at least 80 percent (by value) of the assets of such corporation are used by such corporation in the active conduct of 1 or more qualified trades or businesses, and")
rule ActiveBusiness80PercentAdjustedRule(corp: Corporation, adjusted: Money, total: Money) strict {
    label en official "section 1202(e)(1)(A) over the adjusted asset totals";
    when qualified_assets_adjusted(corp, adjusted);
    when total_assets_value(corp, total);
    when adjusted >= total * Section1202ActiveBusinessAssetRatio;
    then active_business_80_percent_test_met(corp);
}
pub relation net_asset_value_of_corporation(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(5)(B): the value of the corporation's assets in excess of liabilities";
}
pub relation nonsubsidiary_stock_and_securities_value(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(5)(B): the value of stock or securities in other corporations that are not subsidiaries (other than the working capital assets of paragraph (6))";
}
pub relation portfolio_stock_failure_1202e5B(corp: Corporation) kind institutional {
    label en official "section 1202(e)(5)(B): more than 10 percent of the value of its assets (in excess of liabilities) consists of stock or securities of non-subsidiaries: the corporation fails paragraph (1)";
}
@source(IRC_S1202_E, relation = formalizes, coverage = exact, quote = "A corporation shall be treated as failing to meet the requirements of paragraph (1) for any period during which more than 10 percent of the value of its assets (in excess of liabilities) consists of stock or securities in other corporations which are not subsidiaries of such corporation (other than assets described in paragraph (6)).")
rule PortfolioStockFailureRule(corp: Corporation, net: Money, portfolio: Money) defeasible {
    label en official "section 1202(e)(5)(B)";
    when net_asset_value_of_corporation(corp, net);
    when nonsubsidiary_stock_and_securities_value(corp, portfolio);
    when portfolio > net * 10 percent;
    then portfolio_stock_failure_1202e5B(corp);
}
pub relation share_of_voting_power_or_value_owned_1202e5C(parent: Corporation, sub: Corporation, share: Decimal) kind empirical {
    label en official "section 1202(e)(5)(C): the share of the combined voting power, or of the value, of the corporation that the parent owns";
}
pub relation subsidiary_1202e5C(parent: Corporation, sub: Corporation) kind institutional {
    label en official "section 1202(e)(5)(C): the corporation is a subsidiary if the parent owns more than 50 percent of its voting power or of its value";
}
@source(IRC_S1202_E, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, a corporation shall be considered a subsidiary if the parent owns more than 50 percent of the combined voting power of all classes of stock entitled to vote, or more than 50 percent in value of all outstanding stock, of such corporation.")
rule Subsidiary1202e5CRule(parent: Corporation, sub: Corporation, share: Decimal) defeasible {
    label en official "section 1202(e)(5)(C)";
    when share_of_voting_power_or_value_owned_1202e5C(parent, sub, share);
    when share > 0.50;
    then subsidiary_1202e5C(parent, sub);
}
pub relation total_asset_value_of_corporation(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(7): the total value of the corporation's assets";
}
pub relation real_property_not_used_in_active_conduct_value(corp: Corporation, amount: Money) kind empirical {
    label en official "section 1202(e)(7): the value of real property not used in the active conduct of a qualified trade or business (owning, dealing in or renting real property is not active conduct)";
}
pub relation real_estate_failure_1202e7(corp: Corporation) kind institutional {
    label en official "section 1202(e)(7): more than 10 percent of the total value of its assets is real property not used in the active conduct: the corporation does not meet paragraph (1)";
}
@source(IRC_S1202_E, relation = formalizes, coverage = exact, quote = "A corporation shall not be treated as meeting the requirements of paragraph (1) for any period during which more than 10 percent of the total value of its assets consists of real property which is not used in the active conduct of a qualified trade or business.")
rule RealEstateFailureRule(corp: Corporation, total: Money, real: Money) defeasible {
    label en official "section 1202(e)(7)";
    when total_asset_value_of_corporation(corp, total);
    when real_property_not_used_in_active_conduct_value(corp, real);
    when real > total * 10 percent;
    then real_estate_failure_1202e7(corp);
}
pub relation active_business_failure_1202e(corp: Corporation) kind institutional {
    label en official "section 1202(e)(5)(B), (7): the corporation is treated as not meeting the active business requirement";
}
rule ActiveBusinessFailurePortfolioRule(corp: Corporation) defeasible {
    label en official "section 1202(e)(5)(B)";
    when portfolio_stock_failure_1202e5B(corp);
    then active_business_failure_1202e(corp);
}
rule ActiveBusinessFailureRealEstateRule(corp: Corporation) defeasible {
    label en official "section 1202(e)(7)";
    when real_estate_failure_1202e7(corp);
    then active_business_failure_1202e(corp);
}

// =============================================================================
// (f): conversion of other stock
// =============================================================================

pub relation stock_acquired_solely_by_conversion_of_qsbs(new_stock: QsbsStock, old_stock: QsbsStock, p: Person) kind empirical {
    label en official "section 1202(f): the stock is acquired solely through the conversion of other stock in the same corporation which is qualified small business stock in the hands of the taxpayer";
}
pub relation conversion_stock_treated_as_qsbs(new_stock: QsbsStock, p: Person) kind institutional {
    label en official "section 1202(f)(1): the stock so acquired is treated as qualified small business stock in the taxpayer's hands";
}
@source(IRC_S1202_F, relation = formalizes, coverage = exact, quote = "(1) the stock so acquired shall be treated as qualified small business stock in the hands of the taxpayer, and")
rule ConversionQsbsRule(new_stock: QsbsStock, old_stock: QsbsStock, p: Person, corp: Corporation) defeasible {
    label en official "section 1202(f)(1)";
    when stock_acquired_solely_by_conversion_of_qsbs(new_stock, old_stock, p);
    when stock_in_c_corporation(old_stock, corp);
    when qualified_small_business_stock(old_stock, corp, p);
    then conversion_stock_treated_as_qsbs(new_stock, p);
}
pub relation converted_stock_holding_start(p: Person, old_stock: QsbsStock, on: Date) kind empirical {
    label en official "the date the taxpayer began holding the converted stock";
}
pub relation holding_period_start_of_conversion_stock(new_stock: QsbsStock, p: Person, on: Date) kind institutional {
    label en official "section 1202(f)(2): the stock acquired is treated as held during the period the converted stock was held";
}
@source(IRC_S1202_F, relation = formalizes, coverage = exact, quote = "(2) the stock so acquired shall be treated as having been held during the period during which the converted stock was held.")
rule ConversionHoldingPeriodRule(new_stock: QsbsStock, old_stock: QsbsStock, p: Person, on: Date) defeasible {
    label en official "section 1202(f)(2)";
    when stock_acquired_solely_by_conversion_of_qsbs(new_stock, old_stock, p);
    when converted_stock_holding_start(p, old_stock, on);
    then holding_period_start_of_conversion_stock(new_stock, p, on);
}

// =============================================================================
// (g): pass-thru entities
// =============================================================================

pub enum PassThruKind1202 {
    Partnership;
    SCorporation;
    RegulatedInvestmentCompany;
    CommonTrustFund;
    label en official "the pass-thru entities of section 1202(g)(4)(A)-(D)";
}
pub relation entity_is_pass_thru_kind(pte: Person, kind: PassThruKind1202) kind empirical {
    label en official "the entity is a pass-thru entity of the kind";
}
pub relation pass_thru_entity_1202g4(pte: Person) kind institutional {
    label en official "section 1202(g)(4): a pass-thru entity";
}
@source(IRC_S1202_G, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"pass-thru entity\" means—")
rule PassThruEntityRule(pte: Person, kind: PassThruKind1202) defeasible {
    label en official "section 1202(g)(4)(A)-(D)";
    when entity_is_pass_thru_kind(pte, kind);
    then pass_thru_entity_1202g4(pte);
}
pub relation pass_thru_gain_on_qsbs(pte: Person, stock: QsbsStock, amount: Money) kind empirical {
    label en official "section 1202(g)(2)(A): the amount attributable to gain on the sale or exchange by the pass-thru entity of stock that is qualified small business stock in its hands (treating the entity as an individual)";
}
pub relation pass_thru_held_stock_more_than_5_years(pte: Person, stock: QsbsStock) kind empirical {
    label en official "section 1202(g)(2)(A): the entity held the stock for more than 5 years";
}
pub relation taxpayer_held_interest_from_acquisition_to_disposition(p: Person, pte: Person, stock: QsbsStock) kind empirical {
    label en official "section 1202(g)(2)(B): the interest was held by the taxpayer on the date the entity acquired the stock and at all times thereafter before the disposition";
}
pub relation amount_included_by_reason_of_interest(p: Person, pte: Person, stock: QsbsStock, amount: Money) kind empirical {
    label en official "section 1202(g)(1): the amount included in the taxpayer's gross income by reason of holding an interest in the entity";
}
pub relation amount_by_reference_to_interest_held_at_acquisition(p: Person, pte: Person, stock: QsbsStock, amount: Money) kind empirical {
    label en official "section 1202(g)(3): the amount to which paragraph (1) would have applied if determined by reference to the interest the taxpayer held on the date the stock was acquired";
}
pub relation pass_thru_amount_meets_requirements_1202g2(p: Person, pte: Person, stock: QsbsStock) kind institutional {
    label en official "section 1202(g)(2): the amount meets the requirements of paragraph (2)";
}
@source(IRC_S1202_G, relation = formalizes, coverage = exact, quote = "An amount meets the requirements of this paragraph if—")
rule PassThruRequirementsRule(p: Person, pte: Person, stock: QsbsStock) defeasible {
    label en official "section 1202(g)(2)(A)-(B): qualified small business stock held by the entity more than 5 years, and the taxpayer's interest held from the acquisition to the disposition";
    when pass_thru_entity_1202g4(pte);
    when pass_thru_held_stock_more_than_5_years(pte, stock);
    when taxpayer_held_interest_from_acquisition_to_disposition(p, pte, stock);
    then pass_thru_amount_meets_requirements_1202g2(p, pte, stock);
}
pub relation pass_thru_amount_treated_as_gain_under_a(p: Person, pte: Person, stock: QsbsStock, amount: Money) kind institutional {
    label en official "section 1202(g)(1)(A): the amount is treated as gain described in subsection (a), not above the (g)(3) limit (cents are exact: the limit is a minimum)";
}
@source(IRC_S1202_G, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any amount to the extent such amount exceeds the amount to which paragraph (1) would have applied if such amount were determined by reference to the interest the taxpayer held in the pass-thru entity on the date the qualified small business stock was acquired.")
rule PassThruGainRule(p: Person, pte: Person, stock: QsbsStock, included: Money, limit: Money) defeasible {
    label en official "section 1202(g)(1)(A) with the (g)(3) limit";
    when pass_thru_amount_meets_requirements_1202g2(p, pte, stock);
    when amount_included_by_reason_of_interest(p, pte, stock, included);
    when amount_by_reference_to_interest_held_at_acquisition(p, pte, stock, limit);
    then pass_thru_amount_treated_as_gain_under_a(p, pte, stock, min(included, limit));
}

// =============================================================================
// (h)(4): section 351 and 368 exchanges
// =============================================================================

pub relation qsbs_exchanged_in_351_or_368(t: Transaction, p: Person, old_stock: QsbsStock, new_stock: QsbsStock) kind empirical {
    label en official "section 1202(h)(4)(A): a transaction described in section 351 or a reorganization described in section 368 in which qualified small business stock is exchanged for other stock";
}
pub relation exchange_is_351_transaction(t: Transaction) kind empirical {
    label en official "the exchange is a section 351 transaction";
}
pub relation issuer_controls_exchanged_corporation_368c_after(t: Transaction) kind empirical {
    label en official "section 1202(h)(4)(D): immediately after the section 351 transaction the issuing corporation owns directly or indirectly stock representing control (section 368(c)) of the corporation whose stock was exchanged";
}
pub relation exchange_stock_treated_as_qsbs_1202h4(new_stock: QsbsStock, p: Person) kind institutional {
    label en official "section 1202(h)(4)(A): the other stock is treated as qualified small business stock acquired on the date of the original acquisition of the exchanged stock";
}
@source(IRC_S1202_H, relation = formalizes, coverage = partial, quote = "In the case of a transaction described in section 351 or a reorganization described in section 368, if qualified small business stock is exchanged for other stock which would not qualify as qualified small business stock but for this subparagraph, such other stock shall be treated as qualified small business stock acquired on th")
rule ExchangeStockRule368(t: Transaction, p: Person, old_stock: QsbsStock, new_stock: QsbsStock, corp: Corporation) defeasible {
    label en official "section 1202(h)(4)(A): a reorganization under section 368";
    when qsbs_exchanged_in_351_or_368(t, p, old_stock, new_stock);
    when not_known(exchange_is_351_transaction(t));
    when stock_in_c_corporation(old_stock, corp);
    when qualified_small_business_stock(old_stock, corp, p);
    then exchange_stock_treated_as_qsbs_1202h4(new_stock, p);
}
@source(IRC_S1202_H, relation = formalizes, coverage = exact, quote = "In the case of a transaction described in section 351, this paragraph shall apply only if, immediately after the transaction, the corporation issuing the stock owns directly or indirectly stock representing control (within the meaning of section 368(c)) of the corporation whose stock was exchanged.")
rule ExchangeStockRule351(t: Transaction, p: Person, old_stock: QsbsStock, new_stock: QsbsStock, corp: Corporation) defeasible {
    label en official "section 1202(h)(4)(A), (D): a section 351 transaction needs control immediately after";
    when qsbs_exchanged_in_351_or_368(t, p, old_stock, new_stock);
    when exchange_is_351_transaction(t);
    when issuer_controls_exchanged_corporation_368c_after(t);
    when stock_in_c_corporation(old_stock, corp);
    when qualified_small_business_stock(old_stock, corp, p);
    then exchange_stock_treated_as_qsbs_1202h4(new_stock, p);
}
pub relation gain_that_would_have_been_recognized_at_transfer(t: Transaction, amount: Money) kind empirical {
    label en official "section 1202(h)(4)(B): the gain that would have been recognized at the time of the transfer if section 351 or 368 had not applied";
}
pub relation gain_on_sale_of_exchange_stock(p: Person, new_stock: QsbsStock, amount: Money) kind empirical {
    label en official "the gain from the sale or exchange of the stock treated as qualified small business stock by reason of paragraph (4)(A)";
}
pub relation section_1202_gain_limit_h4B(p: Person, new_stock: QsbsStock, t: Transaction, amount: Money) kind institutional {
    label en official "section 1202(h)(4)(B): the section applies to the gain only to the extent of the gain that would have been recognized at the transfer (the limitation stays as of the first transfer to which it applied, (C))";
}
pub relation issuer_was_qualified_small_business_at_transfer(t: Transaction) kind empirical {
    label en official "section 1202(h)(4)(B), second sentence: the corporation issuing the stock is, as of the time of the transfer, a qualified small business";
}
@source(IRC_S1202_H, relation = formalizes, coverage = partial, quote = "This section shall apply to gain from the sale or exchange of stock treated as qualified small business stock by reason of subparagraph (A) only to the extent of the gain which would have been recognized at the time of the transfer described in subparagraph (A) if section 351 or 368 had not applied at such time.")
rule GainLimitH4BRule(p: Person, new_stock: QsbsStock, t: Transaction, sale: Money, transfer: Money) defeasible {
    label en official "section 1202(h)(4)(B), first sentence: unless the issuer is a qualified small business at the transfer";
    when exchange_stock_treated_as_qsbs_1202h4(new_stock, p);
    when gain_on_sale_of_exchange_stock(p, new_stock, sale);
    when gain_that_would_have_been_recognized_at_transfer(t, transfer);
    when not_known(issuer_was_qualified_small_business_at_transfer(t));
    then section_1202_gain_limit_h4B(p, new_stock, t, min(sale, transfer));
}
@source(IRC_S1202_H, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply if the stock which is treated as qualified small business stock by reason of subparagraph (A) is issued by a corporation which (as of the time of the transfer described in subparagraph (A)) is a qualified small business.")
rule GainLimitH4BNotApplicableRule(p: Person, new_stock: QsbsStock, t: Transaction, sale: Money) defeasible {
    label en official "section 1202(h)(4)(B), second sentence";
    when exchange_stock_treated_as_qsbs_1202h4(new_stock, p);
    when gain_on_sale_of_exchange_stock(p, new_stock, sale);
    when issuer_was_qualified_small_business_at_transfer(t);
    then section_1202_gain_limit_h4B(p, new_stock, t, sale);
}
pub relation later_exchange_of_h4_stock(t2: Transaction, p: Person, stock: QsbsStock, new_stock: QsbsStock) kind empirical {
    label en official "section 1202(h)(4)(C): a subsequent transaction or reorganization in which the stock treated as qualified small business stock is exchanged";
}
pub relation exchange_stock_continues_as_qsbs(new_stock: QsbsStock, p: Person) kind institutional {
    label en official "section 1202(h)(4)(C): the stock treated as qualified small business stock under (A) is so treated for subsequent transactions or reorganizations";
}
@source(IRC_S1202_H, relation = formalizes, coverage = partial, quote = "For purposes of this paragraph, stock treated as qualified small business stock under subparagraph (A) shall be so treated for subsequent transactions or reorganizations, except that the limitation of subparagraph (B) shall be applied as of the time of the first transfer to which such limitation applied (determined after the application of the second sentence of subparagraph (B)).")
rule ContinuedExchangeRule(t2: Transaction, p: Person, stock: QsbsStock, new_stock: QsbsStock) defeasible {
    label en official "section 1202(h)(4)(C)";
    when exchange_stock_treated_as_qsbs_1202h4(stock, p);
    when later_exchange_of_h4_stock(t2, p, stock, new_stock);
    then exchange_stock_continues_as_qsbs(new_stock, p);
}

// =============================================================================
// (i): basis rules
// =============================================================================

pub relation property_transferred_for_stock(t: Transaction, p: Person, stock: QsbsStock) kind empirical {
    label en official "section 1202(i)(1): the taxpayer transfers property (other than money or stock) to a corporation in exchange for stock in it";
}
pub relation exchange_date_1202i(t: Transaction, on: Date) kind empirical {
    label en official "the date of the exchange";
}
pub relation fair_market_value_of_property_exchanged(t: Transaction, amount: Money) kind empirical {
    label en official "section 1202(i)(1)(B): the fair market value of the property exchanged";
}
pub relation basis_of_stock_before_floor(p: Person, stock: QsbsStock, amount: Money) kind empirical {
    label en official "the taxpayer's basis in the stock before the section 1202(i)(1)(B) floor";
}
pub relation stock_acquired_on_exchange_date_1202i1A(p: Person, stock: QsbsStock, on: Date) kind institutional {
    label en official "section 1202(i)(1)(A): the stock is treated as acquired on the date of the exchange";
}
@source(IRC_S1202_I, relation = formalizes, coverage = exact, quote = "(A) such stock shall be treated as having been acquired by the taxpayer on the date of such exchange, and")
rule AcquiredOnExchangeDateRule(t: Transaction, p: Person, stock: QsbsStock, on: Date) defeasible {
    label en official "section 1202(i)(1)(A)";
    when property_transferred_for_stock(t, p, stock);
    when exchange_date_1202i(t, on);
    then stock_acquired_on_exchange_date_1202i1A(p, stock, on);
}
pub relation stock_basis_for_1202(p: Person, stock: QsbsStock, amount: Money) kind institutional {
    label en official "section 1202(i)(1)(B): the basis of the stock is in no event less than the fair market value of the property exchanged";
}
@source(IRC_S1202_I, relation = formalizes, coverage = exact, quote = "(B) the basis of such stock in the hands of the taxpayer shall in no event be less than the fair market value of the property exchanged.")
rule BasisFloorRaisedRule(t: Transaction, p: Person, stock: QsbsStock, basis: Money, fmv: Money) defeasible {
    label en official "section 1202(i)(1)(B): the fair market value where it exceeds the basis";
    when property_transferred_for_stock(t, p, stock);
    when basis_of_stock_before_floor(p, stock, basis);
    when fair_market_value_of_property_exchanged(t, fmv);
    when fmv > basis;
    then stock_basis_for_1202(p, stock, fmv);
}
rule BasisFloorKeptRule(t: Transaction, p: Person, stock: QsbsStock, basis: Money, fmv: Money) defeasible {
    label en official "section 1202(i)(1)(B): the basis where it is not below the fair market value";
    when property_transferred_for_stock(t, p, stock);
    when basis_of_stock_before_floor(p, stock, basis);
    when fair_market_value_of_property_exchanged(t, fmv);
    when fmv <= basis;
    then stock_basis_for_1202(p, stock, basis);
}
pub relation contribution_to_capital_after_issue(p: Person, stock: QsbsStock, item: Asset) kind empirical {
    label en official "section 1202(i)(2): a contribution to capital after the stock was originally issued";
}
pub relation basis_of_contributed_property(item: Asset, amount: Money) kind empirical {
    label en official "section 1202(i)(2): the basis of the contributed property";
}
pub relation fair_market_value_of_contributed_property(item: Asset, amount: Money) kind empirical {
    label en official "section 1202(i)(2): the fair market value of the contributed property";
}
pub relation contributed_property_basis_for_stock_adjustment(p: Person, stock: QsbsStock, item: Asset, amount: Money) kind institutional {
    label en official "section 1202(i)(2): in determining the adjustment by reason of the contribution the basis of the contributed property is in no event less than its fair market value";
}
@source(IRC_S1202_I, relation = formalizes, coverage = partial, quote = "If the adjusted basis of any qualified small business stock is adjusted by reason of any contribution to capital after the date on which such stock was originally issued")
rule ContributionBasisRaisedRule(p: Person, stock: QsbsStock, item: Asset, basis: Money, fmv: Money) defeasible {
    label en official "section 1202(i)(2): the fair market value where it exceeds the basis";
    when contribution_to_capital_after_issue(p, stock, item);
    when basis_of_contributed_property(item, basis);
    when fair_market_value_of_contributed_property(item, fmv);
    when fmv > basis;
    then contributed_property_basis_for_stock_adjustment(p, stock, item, fmv);
}
rule ContributionBasisKeptRule(p: Person, stock: QsbsStock, item: Asset, basis: Money, fmv: Money) defeasible {
    label en official "section 1202(i)(2): the basis where it is not below the fair market value";
    when contribution_to_capital_after_issue(p, stock, item);
    when basis_of_contributed_property(item, basis);
    when fair_market_value_of_contributed_property(item, fmv);
    when fmv <= basis;
    then contributed_property_basis_for_stock_adjustment(p, stock, item, basis);
}

// =============================================================================
// (j): offsetting short positions
// =============================================================================

pub relation short_sale_of_substantially_identical_property(p: Person, stock: QsbsStock, on: Date) kind empirical {
    label en official "section 1202(j)(2)(A): the taxpayer (or a related person, section 267(b) or 707(b)) has made a short sale of substantially identical property, on the date";
}
pub relation option_to_sell_substantially_identical_property_at_fixed_price(p: Person, stock: QsbsStock, on: Date) kind empirical {
    label en official "section 1202(j)(2)(B): the taxpayer (or a related person) has acquired an option to sell substantially identical property at a fixed price, on the date";
}
pub relation other_risk_reducing_transaction_by_regulation(p: Person, stock: QsbsStock, on: Date) kind empirical {
    label en official "section 1202(j)(2)(C): to the extent provided in regulations, another transaction that substantially reduces the risk of loss from holding the stock (EXTERNAL_DEPENDENCY: regulations)";
}
pub relation offsetting_short_position_first_day(p: Person, stock: QsbsStock, on: Date) kind institutional {
    label en official "section 1202(j)(2): a day on which the taxpayer has an offsetting short position";
}
@source(IRC_S1202_J, relation = formalizes, coverage = exact, quote = "(A) the taxpayer has made a short sale of substantially identical property,")
rule ShortSaleRule(p: Person, stock: QsbsStock, on: Date) defeasible {
    label en official "section 1202(j)(2)(A)";
    when short_sale_of_substantially_identical_property(p, stock, on);
    then offsetting_short_position_first_day(p, stock, on);
}
@source(IRC_S1202_J, relation = formalizes, coverage = exact, quote = "(B) the taxpayer has acquired an option to sell substantially identical property at a fixed price, or")
rule PutOptionRule(p: Person, stock: QsbsStock, on: Date) defeasible {
    label en official "section 1202(j)(2)(B)";
    when option_to_sell_substantially_identical_property_at_fixed_price(p, stock, on);
    then offsetting_short_position_first_day(p, stock, on);
}
@source(IRC_S1202_J, relation = formalizes, coverage = exact, quote = "(C) to the extent provided in regulations, the taxpayer has entered into any other transaction which substantially reduces the risk of loss from holding such qualified small business stock.")
rule RegulatedTransactionRule(p: Person, stock: QsbsStock, on: Date) defeasible {
    label en official "section 1202(j)(2)(C)";
    when other_risk_reducing_transaction_by_regulation(p, stock, on);
    then offsetting_short_position_first_day(p, stock, on);
}
pub relation earlier_short_position_day_exists(p: Person, stock: QsbsStock, on: Date) kind institutional {
    label en unofficial "a strictly earlier short position day exists (the earliest-of pattern)";
}
rule EarlierShortPositionRule(p: Person, stock: QsbsStock, on: Date, other: Date) defeasible {
    label en unofficial "helper";
    when offsetting_short_position_first_day(p, stock, on);
    when offsetting_short_position_first_day(p, stock, other);
    when other < on;
    then earlier_short_position_day_exists(p, stock, on);
}
pub relation first_short_position_day(p: Person, stock: QsbsStock, on: Date) kind institutional {
    label en official "section 1202(j)(1)(A): the first day on which there was an offsetting short position";
}
rule FirstShortPositionRule(p: Person, stock: QsbsStock, on: Date) defeasible {
    label en official "section 1202(j)(1)(A)";
    when offsetting_short_position_first_day(p, stock, on);
    when not_known(earlier_short_position_day_exists(p, stock, on));
    then first_short_position_day(p, stock, on);
}
pub relation stock_acquired_date_for_short_test(p: Person, stock: QsbsStock, on: Date) kind empirical {
    label en official "the date the taxpayer began holding the stock";
}
pub relation held_more_than_5_years_at_first_short_day(p: Person, stock: QsbsStock) kind institutional {
    label en official "section 1202(j)(1)(A): the stock was held for more than 5 years as of the first day on which there was a short position";
}
rule HeldMoreThanFiveYearsAtShortRule(p: Person, stock: QsbsStock, acquired: Date, first: Date) defeasible {
    label en official "section 1202(j)(1)(A)";
    when first_short_position_day(p, stock, first);
    when stock_acquired_date_for_short_test(p, stock, acquired);
    when first > add_calendar_period(acquired, 5 calendar_year);
    then held_more_than_5_years_at_first_short_day(p, stock);
}
pub relation elects_deemed_sale_on_first_short_day(p: Person, stock: QsbsStock) kind empirical {
    label en official "section 1202(j)(1)(B): the taxpayer elects to recognize gain as if the stock were sold on the first short day for its fair market value";
}
pub relation deemed_sale_election_1202j_in_effect(p: Person, stock: QsbsStock) kind institutional {
    label en official "section 1202(j)(1)(B): the election is in effect";
}
@source(IRC_S1202_J, relation = formalizes, coverage = exact, quote = "(B) the taxpayer elects to recognize gain as if such stock were sold on such first day for its fair market value.")
rule Section1202jDeemedSaleElectionPower(p: Person, stock: QsbsStock) strict {
    label en official "section 1202(j)(1)(B): the election is a power of the taxpayer over the stock; valid where the stock was held more than 5 years at the first short day";
    when elects_deemed_sale_on_first_short_day(p, stock);
    then power Section1202jDeemedSaleElection {
        holder p;
        over stock;
        exercise elects_deemed_sale_on_first_short_day(p, stock);
        valid_when held_more_than_5_years_at_first_short_day(p, stock);
        effect create(deemed_sale_election_1202j_in_effect(p, stock));
        window [@1993-08-10, infinity);
    };
}
pub relation section_1202a_available_despite_short_position(p: Person, stock: QsbsStock) kind institutional {
    label en official "section 1202(j)(1): subsection (a) applies to the gain despite a short position only where (A) and (B) are met";
}
@source(IRC_S1202_J, relation = formalizes, coverage = exact, quote = "If the taxpayer has an offsetting short position with respect to any qualified small business stock, subsection (a) shall not apply to any gain from the sale or exchange of such stock unless—")
rule AvailableWithElectionRule(p: Person, stock: QsbsStock) defeasible {
    label en official "section 1202(j)(1)(A)-(B)";
    when held_more_than_5_years_at_first_short_day(p, stock);
    when deemed_sale_election_1202j_in_effect(p, stock);
    then section_1202a_available_despite_short_position(p, stock);
}
pub relation has_offsetting_short_position(p: Person, stock: QsbsStock) kind institutional {
    label en unofficial "the taxpayer has some offsetting short position";
}
rule HasOffsettingShortPositionRule(p: Person, stock: QsbsStock, on: Date) defeasible {
    label en unofficial "helper";
    when first_short_position_day(p, stock, on);
    then has_offsetting_short_position(p, stock);
}
pub relation section_1202a_applies_to_gain_1202j(p: Person, stock: QsbsStock) kind institutional {
    label en official "section 1202(j): subsection (a) applies - there is no offsetting short position, or the (j)(1) conditions are met";
}
rule ApplicableWithoutShortRule(p: Person, stock: QsbsStock) defeasible {
    label en official "section 1202(j)(1): no offsetting short position";
    when qualified_stock_held_by(p, stock);
    when not_known(has_offsetting_short_position(p, stock));
    then section_1202a_applies_to_gain_1202j(p, stock);
}
rule ApplicableWithElectionRule(p: Person, stock: QsbsStock) defeasible {
    label en official "section 1202(j)(1): the deemed-sale election and the 5-year holding";
    when section_1202a_available_despite_short_position(p, stock);
    then section_1202a_applies_to_gain_1202j(p, stock);
}
pub relation qualified_stock_held_by(p: Person, stock: QsbsStock) kind empirical {
    label en official "the taxpayer holds the qualified small business stock";
}

// =============================================================================
// (h)(3): rules similar to section 1244(d)(2)
// =============================================================================

pub relation basis_determined_by_reference_to_qsbs_basis(new_stock: QsbsStock, old_stock: QsbsStock) kind empirical {
    label en official "section 1244(d)(2), applied by section 1202(h)(3): the basis of the stock in the taxpayer's hands is determined in whole or in part by reference to the basis of stock meeting the requirements";
}
pub relation received_in_368a1F_reorganization_for_qsbs(new_stock: QsbsStock, old_stock: QsbsStock) kind empirical {
    label en official "section 1244(d)(2), applied by section 1202(h)(3): the stock is received in a reorganization described in section 368(a)(1)(F) in exchange for stock meeting the requirements";
}
pub relation regulations_provide_continuity_1202h3(new_stock: QsbsStock) kind empirical {
    label en official "section 1244(d)(2): to the extent provided in regulations prescribed by the Secretary (EXTERNAL_DEPENDENCY)";
}
pub relation treated_as_meeting_requirements_1202h3(new_stock: QsbsStock) kind institutional {
    label en official "section 1202(h)(3) with section 1244(d)(2): the stock is treated as meeting the requirements, to the extent the regulations provide";
}
@source(IRC_S1202_H, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of section 1244(d)(2) shall apply for purposes of this section.")
rule ContinuityByBasisRule(new_stock: QsbsStock, old_stock: QsbsStock) defeasible {
    label en official "section 1244(d)(2), first limb, as made applicable";
    when basis_determined_by_reference_to_qsbs_basis(new_stock, old_stock);
    when regulations_provide_continuity_1202h3(new_stock);
    then treated_as_meeting_requirements_1202h3(new_stock);
}
rule ContinuityByFReorganizationRule(new_stock: QsbsStock, old_stock: QsbsStock) defeasible {
    label en official "section 1244(d)(2), second limb, as made applicable";
    when received_in_368a1F_reorganization_for_qsbs(new_stock, old_stock);
    when regulations_provide_continuity_1202h3(new_stock);
    then treated_as_meeting_requirements_1202h3(new_stock);
}
pub relation successor_in_368a1F_reorganization(successor: Corporation, predecessor: Corporation) kind empirical {
    label en official "section 1244(d)(2), last sentence: a successor corporation in a reorganization described in section 368(a)(1)(F)";
}
pub relation treated_as_same_corporation_1202h3(successor: Corporation, predecessor: Corporation) kind institutional {
    label en official "section 1244(d)(2), last sentence, as made applicable: the successor is treated as the same corporation as its predecessor for the (c)(1)/(3)(A)-type tests";
}
rule SuccessorSameCorporationRule(successor: Corporation, predecessor: Corporation) defeasible {
    label en official "section 1244(d)(2), last sentence";
    when successor_in_368a1F_reorganization(successor, predecessor);
    then treated_as_same_corporation_1202h3(successor, predecessor);
}
