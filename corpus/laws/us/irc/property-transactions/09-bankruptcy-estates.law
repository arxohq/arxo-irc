// Stage 2b (IRC-07, A05). Section 1398: individual debtors in bankruptcy —
// when the section applies (a)-(b), the election to close the debtor's year
// at commencement as a taxpayer power (d)(2), and the estate's succession to
// the debtor's tax attributes (g).

use self::{
    Asset,
    CapitalLossCharacter,
    IRC_S1398_A,
    IRC_S1398_D,
    IRC_S1398_E,
    IRC_S1398_F,
    IRC_S1398_G,
    Partnership,
    Person,
    TaxableYear,
    Transaction,
    capital_asset,
    capital_loss_carryover,
    long_term,
};

pub entity BankruptcyCase {
    label en unofficial "a case under chapter 7 or chapter 11 of title 11 of the United States Code, in which section 1398 tests whether it applies to an individual debtor";
}
pub entity BankruptcyEstate : Person {
    label en official "the bankruptcy estate created by a case to which section 1398 applies (section 1398(c) taxes the estate as an individual) — distinct from a decedent's Estate";
}

// =============================================================================
// (a)-(b): cases to which the section applies
// =============================================================================

pub relation bankruptcy_case_under_chapter_7_or_11(c: BankruptcyCase, debtor: Person) kind empirical {
    label en official "a case under chapter 7 or chapter 11 of title 11 of the United States Code in which the person is the debtor";
}
pub relation debtor_is_individual(debtor: Person) kind empirical {
    label en unofficial "the debtor in the case is an individual (section 1398(a))";
}
pub relation case_dismissed(c: BankruptcyCase) kind empirical {
    label en official "the case under chapter 7 or 11 is dismissed (section 1398(b)(1) exception)";
}
pub relation bankruptcy_estate_of(c: BankruptcyCase, estate: BankruptcyEstate) kind empirical {
    label en unofficial "the bankruptcy estate created by the case (section 1398(c) links the estate to the case whose debtor triggered section 1398)";
}
pub relation section_1398_applies(c: BankruptcyCase, debtor: Person) kind institutional {
    label en official "section 1398 applies to the case (an individual debtor, case not dismissed)";
}
@source(IRC_S1398_A, quote = "Except as provided in subsection (b), this section shall apply to any case under chapter 7 (relating to liquidations) or chapter 11 (relating to reorganizations) of title 11 of the United States Code in which the debtor is an individual.")
rule Section1398AppliesRule(c: BankruptcyCase, debtor: Person) defeasible {
    label en official "section 1398(a): the section applies to a chapter 7/11 case with an individual debtor, unless dismissed";
    when bankruptcy_case_under_chapter_7_or_11(c, debtor);
    when debtor_is_individual(debtor);
    when not_known(case_dismissed(c));
    then section_1398_applies(c, debtor);
}

pub relation partnership_interest_of_debtor(debtor: Person, partnership: Partnership) kind empirical {
    label en unofficial "section 1398(b)(2): a partnership interest held by an individual debtor is taken into account under this section as any other interest of the debtor (the partnership ITSELF is not treated as an individual — this package does not separately model partnership-level nonapplication, since section 1398_applies already keys off debtor_is_individual, not the partnership)";
}

// =============================================================================
// (d): taxable year of debtors — the election to terminate the debtor's year
// =============================================================================

pub relation commencement_date(c: BankruptcyCase, on: Date) kind empirical {
    label en official "section 1398(d)(3): the day on which the case commences";
}
pub relation elects_to_terminate_debtors_year(debtor: Person, c: BankruptcyCase) kind empirical {
    label en official "section 1398(d)(2)(A): the debtor elects to treat the taxable year including the commencement date as 2 taxable years";
}
pub relation election_made_by_due_date_1398d2d(debtor: Person, c: BankruptcyCase) kind empirical {
    label en official "section 1398(d)(2)(D): the election is made on or before the due date for filing the return for the taxable year ending the day before the commencement date";
}
pub relation debtor_has_only_exempt_property(debtor: Person, c: BankruptcyCase) kind empirical {
    label en official "section 1398(d)(2)(C): the debtor has no assets other than property the debtor may treat as exempt under section 522 of title 11 — bars the election";
}
pub relation debtors_year_terminated_at_commencement(debtor: Person, c: BankruptcyCase) kind institutional {
    label en official "section 1398(d)(2)(A): the debtor's taxable year including the commencement date is split into 2 taxable years (ending the day before, and beginning on, the commencement date)";
}
@source(IRC_S1398_D, quote = "the debtor may (without the approval of the Secretary) elect to treat the debtor's taxable year which includes the commencement date as 2 taxable years")
rule Section1398DebtorYearTerminationElectionPower(debtor: Person, c: BankruptcyCase) strict {
    label en official "section 1398(d)(2)(A): the debtor may elect, without Secretary approval, to split the commencement-date year into 2 taxable years, unless the debtor has only exempt property (d)(2)(C)";
    when elects_to_terminate_debtors_year(debtor, c);
    then power Section1398DebtorYearTerminationElection {
        holder debtor;
        over c;
        exercise elects_to_terminate_debtors_year(debtor, c);
        valid_when election_valid_1398d2(debtor, c);
        effect create(debtors_year_terminated_at_commencement(debtor, c));
        window [@1980-01-01, infinity);
    };
}
relation election_valid_1398d2(debtor: Person, c: BankruptcyCase) kind institutional {
    label en unofficial "section 1398(d)(2)(C)-(D): the election is timely and the debtor has non-exempt assets — a single-atom helper for the power's valid_when (§130.3: valid_when takes exactly one atom)";
}
@source(IRC_S1398_D, quote = "No election may be made under subparagraph (A) by a debtor who has no assets other than property which the debtor may treat as exempt property under section 522 of title 11 of the United States Code.")
rule ElectionValid1398d2Rule(debtor: Person, c: BankruptcyCase) defeasible {
    label en official "section 1398(d)(2)(C)-(D): timely made and not barred by the exempt-property-only exception";
    when election_made_by_due_date_1398d2d(debtor, c);
    when not_known(debtor_has_only_exempt_property(debtor, c));
    then election_valid_1398d2(debtor, c);
}
// (d)(2)(B) spouse-joinder, (E) separate returns, (F) annualization treatment
// under section 443 are TECH_GAP this stage: the election above models only
// the debtor's own split, not the spousal-joinder or return-filing mechanics.
// (d)(2)'s "once made, irrevocable" persistence beyond the power's own
// `create` effect is not separately modelled (same open class as this
// package's section 1256(d)(3) gap, TECH-GAPS.md G287).

// =============================================================================
// (e): treatment of income between debtor and estate (classification, not a
// carryover) — the estate's gross income includes post-commencement income
// the estate is entitled to; the debtor's gross income excludes it.
// =============================================================================

pub relation debtor_income_estate_entitled_to(debtor: Person, estate: BankruptcyEstate, c: BankruptcyCase, amount: Money) kind empirical {
    label en unofficial "section 1398(e)(1): gross income of the debtor to which the estate is entitled under title 11, received or accrued on or after the commencement date";
}
pub relation estate_gross_income_from_debtor(estate: BankruptcyEstate, c: BankruptcyCase, amount: Money) kind institutional {
    label en official "section 1398(e)(1): the estate's gross income includes the debtor's income the estate is entitled to (post-commencement only)";
}
@source(IRC_S1398_E, quote = "The gross income of the estate for each taxable year shall include the gross income of the debtor to which the estate is entitled under title 11 of the United States Code.")
rule EstateGrossIncomeFromDebtorRule(debtor: Person, estate: BankruptcyEstate, c: BankruptcyCase, amount: Money) defeasible {
    label en official "section 1398(e)(1): estate gross income includes debtor income the estate is entitled to";
    when debtor_income_estate_entitled_to(debtor, estate, c, amount);
    then estate_gross_income_from_debtor(estate, c, amount);
}

// =============================================================================
// (f): transfers between debtor and estate not treated as dispositions
// =============================================================================

pub relation transfer_debtor_to_estate(t: Transaction, debtor: Person, estate: BankruptcyEstate, a: Asset) kind empirical {
    label en official "section 1398(f)(1): a transfer (other than by sale or exchange) of an asset from the debtor to the estate";
}
pub relation transfer_estate_to_debtor_on_termination(t: Transaction, estate: BankruptcyEstate, debtor: Person, a: Asset) kind empirical {
    label en official "section 1398(f)(2): on termination of the estate, a transfer (other than by sale or exchange) of an asset from the estate to the debtor";
}
pub relation section_1398_transfer_not_a_disposition(t: Transaction) kind institutional {
    label en official "section 1398(f): the transfer is not treated as a disposition for purposes of any provision assigning tax consequences to a disposition";
}
@source(IRC_S1398_F, quote = "A transfer (other than by sale or exchange) of an asset from the debtor to the estate shall not be treated as a disposition for purposes of any provision of this title assigning tax consequences to a disposition")
rule TransferDebtorToEstateNotDispositionRule(t: Transaction, debtor: Person, estate: BankruptcyEstate, a: Asset) strict {
    label en official "section 1398(f)(1): debtor-to-estate transfer is not a disposition";
    when transfer_debtor_to_estate(t, debtor, estate, a);
    then section_1398_transfer_not_a_disposition(t);
}
@source(IRC_S1398_F, quote = "a transfer (other than by sale or exchange) of an asset from the estate to the debtor shall not be treated as a disposition for purposes of any provision of this title assigning tax consequences to a disposition")
rule TransferEstateToDebtorNotDispositionRule(t: Transaction, estate: BankruptcyEstate, debtor: Person, a: Asset) strict {
    label en official "section 1398(f)(2): estate-to-debtor transfer on termination is not a disposition";
    when transfer_estate_to_debtor_on_termination(t, estate, debtor, a);
    then section_1398_transfer_not_a_disposition(t);
}

// =============================================================================
// (g): the estate succeeds to the debtor's tax attributes
// =============================================================================

// (g)(5): capital loss carryover — this package OWNS section 1212, so this
// is a real, executable bridge (not a cross-package contract).
pub relation estate_succeeds_to_capital_loss_carryover(estate: BankruptcyEstate, debtor: Person, from_year: TaxableYear, to_year: TaxableYear, character: CapitalLossCharacter, amount: Money) kind institutional {
    label en official "section 1398(g)(5): the estate succeeds to the debtor's section 1212 capital loss carryover, determined as of the first day of the debtor's taxable year in which the case commences";
}
@source(IRC_S1398_G, quote = "The capital loss carryover determined under section 1212.")
rule EstateSucceedsToCapitalLossCarryoverRule(estate: BankruptcyEstate, debtor: Person, c: BankruptcyCase, from_year: TaxableYear, to_year: TaxableYear, character: CapitalLossCharacter, amount: Money) defeasible {
    label en official "section 1398(g)(5): the estate succeeds to the debtor's capital loss carryover for the year the case commences";
    when section_1398_applies(c, debtor);
    when bankruptcy_estate_of(c, estate);
    when capital_loss_carryover(debtor, from_year, to_year, character, amount);
    then estate_succeeds_to_capital_loss_carryover(estate, debtor, from_year, to_year, character, amount);
}

// (g)(6): basis, holding period, and character of assets acquired by the
// estate from the debtor (other than by sale or exchange) — this package
// owns adjusted_basis/long_term/capital_asset, so this is executable too.
pub relation estate_succeeds_to_basis(estate: BankruptcyEstate, a: Asset, on: Date, amount: Money) kind institutional {
    label en official "section 1398(g)(6): the estate's basis in an asset acquired from the debtor (other than by sale or exchange) is the debtor's basis";
}
@source(IRC_S1398_G, quote = "In the case of any asset acquired (other than by sale or exchange) by the estate from the debtor, the basis, holding period, and character it had in the hands of the debtor.")
rule EstateSucceedsToBasisRule(estate: BankruptcyEstate, debtor: Person, t: Transaction, a: Asset, on: Date, amount: Money) defeasible {
    label en official "section 1398(g)(6): the estate's basis in a transferred asset carries over from the debtor";
    when transfer_debtor_to_estate(t, debtor, estate, a);
    when us.irc.core::adjusted_basis(debtor, a, on, amount);
    then estate_succeeds_to_basis(estate, a, on, amount);
}
pub relation estate_succeeds_to_long_term(estate: BankruptcyEstate, a: Asset) kind institutional {
    label en official "section 1398(g)(6): the estate's holding period in a transferred asset includes the debtor's holding period";
}
rule EstateSucceedsToLongTermRule(estate: BankruptcyEstate, debtor: Person, t: Transaction, a: Asset) defeasible {
    label en official "section 1398(g)(6): the estate's holding period tacks the debtor's for a transferred asset already long-term";
    when transfer_debtor_to_estate(t, debtor, estate, a);
    when long_term(debtor, a);
    then estate_succeeds_to_long_term(estate, a);
}
pub relation estate_succeeds_to_capital_asset_character(estate: BankruptcyEstate, a: Asset) kind institutional {
    label en official "section 1398(g)(6): the estate's character in a transferred asset carries over from the debtor";
}
rule EstateSucceedsToCapitalAssetCharacterRule(estate: BankruptcyEstate, debtor: Person, t: Transaction, a: Asset) defeasible {
    label en official "section 1398(g)(6): capital-asset character carries over on a debtor-to-estate transfer";
    when transfer_debtor_to_estate(t, debtor, estate, a);
    when capital_asset(debtor, a);
    then estate_succeeds_to_capital_asset_character(estate, a);
}

// (g)(1)-(4),(7)-(8): NOL carryover (section 172), charitable contribution
// carryover (section 170(d)(1)), tax-benefit-rule recovery (section 111),
// credit carryovers, method of accounting, and the residual "other
// attributes" catch-all are all EXTERNAL_DEPENDENCY: each is owned by
// another package (income-individual/deductions/credits/accounting), not
// this one. Declared as typed institutional contracts, not invented.
pub relation estate_succeeds_to_net_operating_loss_carryover(estate: BankruptcyEstate, debtor: Person, amount: Money) kind institutional {
    label en unofficial "section 1398(g)(1): pending contract — section 172 net operating loss carryover, owned by income-individual/deductions";
}
pub relation estate_succeeds_to_charitable_contribution_carryover(estate: BankruptcyEstate, debtor: Person, amount: Money) kind institutional {
    label en unofficial "section 1398(g)(2): pending contract — section 170(d)(1) excess charitable contribution carryover, owned by deductions";
}
pub relation estate_succeeds_to_tax_benefit_recovery_items(estate: BankruptcyEstate, debtor: Person) kind institutional {
    label en unofficial "section 1398(g)(3): pending contract — section 111 tax-benefit-rule recovery items, owned by gross-income";
}
pub relation estate_succeeds_to_credit_carryovers(estate: BankruptcyEstate, debtor: Person) kind institutional {
    label en unofficial "section 1398(g)(4): pending contract — credit carryovers, owned by credits";
}
pub relation estate_succeeds_to_method_of_accounting(estate: BankruptcyEstate, debtor: Person) kind institutional {
    label en unofficial "section 1398(g)(7): pending contract — the debtor's accounting method, owned by accounting";
}
