// Property transactions -- stage 4 (26.09.2026, DECISION-0379, implemented_unverified): rows that stage 3b left as
// technical gaps and that admit a bounded statement.
//
// Covered: section 1016(a)(2) (the last sentences: no method adopted, the tax benefit limb (B), the pre-1932 depletion),
// section 1239(c)(1)(B), (2) (constructive ownership of partnership interests), section 1092(a)(2)(C) (liability positions),
// section 1017(b)(4)(C) (qualified property by analogy) and (d)(2) (straight line as if no reduction), section 1060(d)(1),
// section 1400Z-2 as amended by Pub. L. 119-21 section 70421(c)(2)(A) (the year of inclusion).
//
// METHOD AND JUDGMENT CALLS.
//  - Explicit incorporation by analogy ("rules similar to ...") is stated as a copy of the earlier rules over the analogous
//    relation, with the analogy named in the label; nothing is re-derived from prose.
//  - Section 1239(c)(2): the constructive ownership of a partnership interest is the direct share plus the share through ONE
//    entity tier plus the direct and one-tier shares of the family (asserted), as in module 25 of the excise package (bounded:
//    two or more entity tiers are not attributed, TECH-GAPS G6897); section 267(c)(3) is not applied.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

use self::{
    Asset,
    FarmBasisReductionTier,
    IRC_S1016_A,
    IRC_S1017_B,
    IRC_S1017_D,
    IRC_S1060_D,
    IRC_S1092_A,
    IRC_S1239_C,
    Partnership,
    Person,
    QualifiedOpportunityFundInvestment,
    StraddlePosition,
    TaxableYear,
    Transaction,
    actual_depreciation_adjustments,
    additional_depreciation,
    amount_includible_pl,
    deferred_gain_inclusion_date_pl,
    depreciable_property_1017,
    depreciation_allowable,
    depreciation_allowed,
    election_1017b3e_made_on_return_for_discharge_year,
    farm_indebtedness_reduction_tier,
    identified_straddle,
    identified_straddle_loss_on_position,
    identified_straddle_no_offsetting_gain,
    identified_straddle_total_offsetting_gain,
    land_used_in_farming_business,
    long_term,
    offsetting_position_unrecognized_gain,
    partnership_distribution_or_interest_transfer_with_section_755,
    property_held_at_beginning_of_year_after_discharge,
    real_property_described_in_1221a1,
    related_persons_1239,
};

// ============================================================================
// section 1016(a)(2): the last sentences of the paragraph
// ============================================================================

pub relation no_depreciation_method_adopted_1016a2(p: Person, a: Asset, period_ending: Date) kind empirical {
    label en official "section 1016(a)(2): no method has been adopted under section 167 for the period";
}
pub relation straight_line_amount_for_1016a2(p: Person, a: Asset, period_ending: Date, amount: Money) kind empirical {
    label en official "section 1016(a)(2): the depreciation for the period computed by the straight line method";
}
@source(IRC_S1016_A, quote = "Where no method has been adopted under section 167 (relating to depreciation deduction), the amount allowable shall be determined under the straight line method.")
rule AllowableIsStraightLineWhenNoMethodAdopted1016a2(p: Person, a: Asset, period_ending: Date, sl: Money) strict {
    label en official "section 1016(a)(2): the amount allowable, absent an adopted method, is the straight line amount";
    when no_depreciation_method_adopted_1016a2(p, a, period_ending);
    when straight_line_amount_for_1016a2(p, a, period_ending, sl);
    then depreciation_allowable(p, a, period_ending, sl);
}
pub relation deduction_tax_reduction_limit_1016a2B(p: Person, a: Asset, period_ending: Date, reduced_by: Money) kind empirical {
    label en official "section 1016(a)(2)(B): the amount of the allowed deductions that resulted in a reduction of the taxpayer's taxes (asserted only when it is less than the amount allowed)";
}
pub relation election_1020_made_1016a2(p: Person, a: Asset) kind empirical {
    label en official "section 1016(a)(2): an election has been made under section 1020 (as in effect before the Tax Reform Act of 1976)";
}
pub relation tax_benefit_limit_exists_1016a2B(p: Person, a: Asset, period_ending: Date) kind institutional {
    label en unofficial "helper: a tax reduction limit is asserted for the period";
}
rule TaxBenefitLimitExists1016a2B(p: Person, a: Asset, period_ending: Date, r: Money) strict {
    label en unofficial "helper";
    when deduction_tax_reduction_limit_1016a2B(p, a, period_ending, r);
    then tax_benefit_limit_exists_1016a2B(p, a, period_ending);
}
pub relation subparagraph_B_inapplicable_1913_to_1951_1016a2(p: Person, a: Asset, period_ending: Date) kind institutional {
    label en official "section 1016(a)(2): subparagraph (B) does not apply to a period since February 28, 1913 and before January 1, 1952, unless a section 1020 election has been made";
}
@source(IRC_S1016_A, quote = "Subparagraph (B) of this paragraph shall not apply in respect of any period since February 28, 1913, and before January 1, 1952, unless an election has been made under section 1020 (as in effect before the date of the enactment of the Tax Reform Act of 1976).")
rule SubparagraphBInapplicableInPeriod1016a2(p: Person, a: Asset, period_ending: Date) strict {
    label en official "section 1016(a)(2): the period ends after February 28, 1913 and before January 1, 1952, and no section 1020 election";
    when depreciation_allowed(p, a, period_ending, _);
    when period_ending > @1913-02-28;
    when period_ending < @1952-01-01;
    when not_known(election_1020_made_1016a2(p, a));
    then subparagraph_B_inapplicable_1913_to_1951_1016a2(p, a, period_ending);
}
pub relation allowed_after_1016a2B(p: Person, a: Asset, period_ending: Date, amount: Money) kind institutional {
    label en official "section 1016(a)(2)(A)-(B): the deductions allowed that count: all of them, or, where subparagraph (B) applies and the deductions reduced taxes by less, that lesser amount";
}
@source(IRC_S1016_A, quote = "(B) resulting (by reason of the deductions so allowed) in a reduction for any taxable year of the taxpayer's taxes under this subtitle (other than chapter 2, relating to tax on self-employment income), or prior income, war-profits, or excess-profits tax laws,")
rule AllowedAfterB1016a2NoLimit(p: Person, a: Asset, period_ending: Date, allowed: Money) strict {
    label en official "section 1016(a)(2)(A)-(B): no tax reduction limit asserted, the whole allowed amount counts";
    when depreciation_allowed(p, a, period_ending, allowed);
    when not_known(tax_benefit_limit_exists_1016a2B(p, a, period_ending));
    then allowed_after_1016a2B(p, a, period_ending, allowed);
}
@source(IRC_S1016_A, quote = "(B) resulting (by reason of the deductions so allowed) in a reduction for any taxable year of the taxpayer's taxes under this subtitle (other than chapter 2, relating to tax on self-employment income), or prior income, war-profits, or excess-profits tax laws,")
rule AllowedAfterB1016a2Limited(p: Person, a: Asset, period_ending: Date, allowed: Money, reduced_by: Money) strict {
    label en official "section 1016(a)(2)(B): the allowed amount counts only to the extent it reduced taxes";
    when depreciation_allowed(p, a, period_ending, allowed);
    when deduction_tax_reduction_limit_1016a2B(p, a, period_ending, reduced_by);
    when not_known(subparagraph_B_inapplicable_1913_to_1951_1016a2(p, a, period_ending));
    then allowed_after_1016a2B(p, a, period_ending, min(allowed, reduced_by));
}
@source(IRC_S1016_A, quote = "Subparagraph (B) of this paragraph shall not apply in respect of any period since February 28, 1913, and before January 1, 1952, unless an election has been made under section 1020 (as in effect before the date of the enactment of the Tax Reform Act of 1976).")
rule AllowedAfterB1016a2NotApplicable(p: Person, a: Asset, period_ending: Date, allowed: Money) strict {
    label en official "section 1016(a)(2): subparagraph (B) does not apply to the period, so the whole allowed amount counts";
    when depreciation_allowed(p, a, period_ending, allowed);
    when subparagraph_B_inapplicable_1913_to_1951_1016a2(p, a, period_ending);
    then allowed_after_1016a2B(p, a, period_ending, allowed);
}
pub relation depletion_based_on_discovery_value_or_percentage_before_1932_1016a2(p: Person, a: Asset, period_ending: Date) kind empirical {
    label en official "section 1016(a)(2): for a taxable year before 1932 the depletion allowance was based on discovery value or a percentage of income";
}
pub relation depletion_without_discovery_value_or_percentage_1016a2(p: Person, a: Asset, period_ending: Date, amount: Money) kind empirical {
    label en official "section 1016(a)(2): the depletion which would have been allowable for the year computed without reference to discovery value or a percentage of income";
}
@source(IRC_S1016_A, quote = "Where for any taxable year before the taxable year 1932 the depletion allowance was based on discovery value or a percentage of income, then the adjustment for depletion for such year shall be based on the depletion which would have been allowable for such year if computed without reference to discovery value or a percentage of income;")
rule AllowableDepletionPre1932WithoutDiscoveryValue1016a2(p: Person, a: Asset, period_ending: Date, amt: Money) strict {
    label en official "section 1016(a)(2): the pre-1932 depletion adjustment is the depletion computed without discovery value or percentage (the amount allowable)";
    when depletion_based_on_discovery_value_or_percentage_before_1932_1016a2(p, a, period_ending);
    when period_ending < @1932-01-01;
    when depletion_without_discovery_value_or_percentage_1016a2(p, a, period_ending, amt);
    then depreciation_allowable(p, a, period_ending, amt);
}

// ============================================================================
// section 1239(c)(1)(B), (2): a partnership more than 50 percent owned, directly or indirectly
// ============================================================================

pub relation direct_partnership_interest_share_1239c(owner: Person, ent: Person, share: Decimal) kind empirical {
    label en official "section 1239(c)(1)(B): the share of the capital interest or profits interest of the partnership that the owner holds directly";
}
pub relation family_member_of_owner_1239c2(q: Person, p: Person) kind empirical {
    label en official "section 1239(c)(2), section 267(c)(2), (4): the person q is a member of the family of the individual p (asserted)";
}
pub relation partnership_interest_holder_1239c(p: Person, partnership: Partnership) kind empirical {
    label en official "section 1239(c)(1)(B): the person is considered for ownership of the interests of the partnership (marker)";
}
pub relation constructive_partnership_interest_1239c(p: Person, partnership: Partnership, share: Decimal) kind institutional {
    label en official "section 1239(c)(2): the capital or profits interest in the partnership owned by or for the person: direct, through one entity tier (proportionately) and by family (bounded; section 267(c)(3) excluded)";
}
@source(IRC_S1239_C, quote = "For purposes of this section, ownership shall be determined in accordance with rules similar to the rules under section 267(c) (other than paragraph (3) thereof).")
rule ConstructivePartnershipInterest1239c(p: Person, partnership: Partnership) defeasible {
    label en official "section 1239(c)(2): direct + one tier + the family's direct and one-tier shares";
    when partnership_interest_holder_1239c(p, partnership);
    then constructive_partnership_interest_1239c(p, partnership, sum(collect all d: Decimal where direct_partnership_interest_share_1239c(p, partnership, d), empty: 0.00) + sum(collect all x: Decimal, m: Person, a: Decimal, b: Decimal where direct_partnership_interest_share_1239c(p, m, a) and direct_partnership_interest_share_1239c(m, partnership, b) and x == a * b, empty: 0.00) + sum(collect all d2: Decimal, q: Person where family_member_of_owner_1239c2(q, p) and direct_partnership_interest_share_1239c(q, partnership, d2), empty: 0.00) + sum(collect all x2: Decimal, q2: Person, m2: Person, a2: Decimal, b2: Decimal where family_member_of_owner_1239c2(q2, p) and direct_partnership_interest_share_1239c(q2, m2, a2) and direct_partnership_interest_share_1239c(m2, partnership, b2) and x2 == a2 * b2, empty: 0.00));
}
@source(IRC_S1239_C, quote = "(B) a partnership more than 50 percent of the capital interest or profits interest in which is owned (directly or indirectly) by or for such person, and")
rule ControlledPartnershipFromConstructiveInterest1239c1B(p: Person, partnership: Partnership, share: Decimal) defeasible {
    label en official "section 1239(c)(1)(B) read on the constructive share of paragraph (2)";
    when constructive_partnership_interest_1239c(p, partnership, share);
    when share > 0.50;
    then related_persons_1239(p, partnership);
}

// ============================================================================
// section 1092(a)(2)(C): rules similar to (A)(ii)-(iii) for liabilities and obligations
// ============================================================================

pub relation position_is_or_has_been_a_liability_or_obligation_1092a2C(pos: StraddlePosition) kind empirical {
    label en official "section 1092(a)(2)(C): the position is, or has been, a liability or obligation";
}
pub relation secretary_provides_otherwise_1092a2C(p: Person, straddle_id: Integer) kind empirical {
    label en official "section 1092(a)(2)(C): the Secretary provides otherwise for the straddle (EXTERNAL_DEPENDENCY: regulations or guidance)";
}
pub relation liability_position_gain_adjustment_1092a2C(p: Person, straddle_id: Integer, pos: StraddlePosition, amount: Money) kind institutional {
    label en official "section 1092(a)(2)(C) with (A)(ii): for an offsetting position that is a liability or obligation, the adjustment (the basis increase of clause (ii), read for the liability: the same ratio of the loss as its unrecognized gain to the aggregate unrecognized gain)";
}
@source(IRC_S1092_A, quote = "Except as otherwise provided by the Secretary, rules similar to the rules of clauses (ii) and (iii) of subparagraph (A) shall apply for purposes of this paragraph with respect to any position which is, or has been, a liability or obligation.")
rule LiabilityPositionAdjustment1092a2C(p: Person, straddle_id: Integer, pos: StraddlePosition, loss: Money, gain: Money, total: Money) defeasible {
    label en official "section 1092(a)(2)(C): the analogy of clause (ii) for a liability position (cents HALF_UP; JUDGMENT CALL, no rounding named)";
    when identified_straddle(p, straddle_id);
    when position_is_or_has_been_a_liability_or_obligation_1092a2C(pos);
    when identified_straddle_loss_on_position(p, straddle_id, loss);
    when offsetting_position_unrecognized_gain(p, straddle_id, pos, gain);
    when identified_straddle_total_offsetting_gain(p, straddle_id, total);
    when total > 0.00 USD;
    unless secretary_provides_otherwise_1092a2C(p, straddle_id) and identified_straddle(p, straddle_id) and position_is_or_has_been_a_liability_or_obligation_1092a2C(pos) and identified_straddle_loss_on_position(p, straddle_id, loss) and offsetting_position_unrecognized_gain(p, straddle_id, pos, gain) and identified_straddle_total_offsetting_gain(p, straddle_id, total);
    then liability_position_gain_adjustment_1092a2C(p, straddle_id, pos, div_round(loss * (gain / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation liability_position_reasonable_allocation_required_1092a2C(p: Person, straddle_id: Integer, pos: StraddlePosition) kind institutional {
    label en official "section 1092(a)(2)(C) with (A)(iii): clause (ii) resulted in no adjustment for the liability positions, so a reasonable, consistently applied allocation equal to the loss is required (the reasonableness is the evaluative element of module 17)";
}
@source(IRC_S1092_A, quote = "Except as otherwise provided by the Secretary, rules similar to the rules of clauses (ii) and (iii) of subparagraph (A) shall apply for purposes of this paragraph with respect to any position which is, or has been, a liability or obligation.")
rule LiabilityPositionReasonableAllocationRequired1092a2C(p: Person, straddle_id: Integer, pos: StraddlePosition) defeasible {
    label en official "section 1092(a)(2)(C) with (A)(iii)";
    when identified_straddle(p, straddle_id);
    when position_is_or_has_been_a_liability_or_obligation_1092a2C(pos);
    when identified_straddle_no_offsetting_gain(p, straddle_id);
    unless secretary_provides_otherwise_1092a2C(p, straddle_id) and identified_straddle(p, straddle_id) and position_is_or_has_been_a_liability_or_obligation_1092a2C(pos) and identified_straddle_no_offsetting_gain(p, straddle_id);
    then liability_position_reasonable_allocation_required_1092a2C(p, straddle_id, pos);
}

// ============================================================================
// section 1017(b)(4)(C): rules similar to (b)(3)(C)-(E) for qualified property
// ============================================================================

pub relation partnership_interest_proportionate_qualified_share_1017b4C(a: Asset) kind empirical {
    label en official "section 1017(b)(4)(C) with (b)(3)(C): a partnership interest, to the extent of the partner's proportionate interest in the partnership's qualified property, when the partnership basis is correspondingly reduced";
}
pub relation subsidiary_stock_consented_qualified_1017b4C(a: Asset) kind empirical {
    label en official "section 1017(b)(4)(C) with (b)(3)(D): stock of a subsidiary in a consolidated group, to the extent the subsidiary consents to a corresponding reduction in the basis of its qualified property";
}
pub relation election_1017b4C_to_include_inventory_real_property(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1017(b)(4)(C) with (b)(3)(E)(i): the taxpayer elects that qualified property includes real property described in section 1221(a)(1)";
}
pub relation election_1017b4C_timely(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1017(b)(4)(C) with (b)(3)(E)(ii): the election is made on the return for the discharge year";
}
rule Election1017b4CTimely(p: Person, y: TaxableYear) defeasible {
    label en official "section 1017(b)(4)(C) with (b)(3)(E)(ii)";
    when election_1017b4C_to_include_inventory_real_property(p, y);
    when election_1017b3e_made_on_return_for_discharge_year(p, y);
    then election_1017b4C_timely(p, y);
}
pub relation qualified_property_by_analogy_1017b4C(p: Person, y: TaxableYear, a: Asset) kind institutional {
    label en official "section 1017(b)(4)(C): property treated as qualified property for the qualified farm indebtedness reduction by rules similar to paragraph (3)(C)-(E)";
}
@source(IRC_S1017_B, quote = "Rules similar to the rules of subparagraphs (C), (D), and (E) of paragraph (3) shall apply for purposes of this paragraph and section 108(g).")
rule QualifiedPropertyPartnershipInterest1017b4C(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(4)(C) with (b)(3)(C)";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when partnership_interest_proportionate_qualified_share_1017b4C(a);
    then qualified_property_by_analogy_1017b4C(p, y, a);
}
@source(IRC_S1017_B, quote = "Rules similar to the rules of subparagraphs (C), (D), and (E) of paragraph (3) shall apply for purposes of this paragraph and section 108(g).")
rule QualifiedPropertySubsidiaryStock1017b4C(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(4)(C) with (b)(3)(D)";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when subsidiary_stock_consented_qualified_1017b4C(a);
    then qualified_property_by_analogy_1017b4C(p, y, a);
}
@source(IRC_S1017_B, quote = "Rules similar to the rules of subparagraphs (C), (D), and (E) of paragraph (3) shall apply for purposes of this paragraph and section 108(g).")
rule QualifiedPropertyInventoryRealProperty1017b4C(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(4)(C) with (b)(3)(E)";
    when property_held_at_beginning_of_year_after_discharge(p, y, a);
    when real_property_described_in_1221a1(a);
    when election_1017b4C_timely(p, y);
    then qualified_property_by_analogy_1017b4C(p, y, a);
}
@source(IRC_S1017_B, quote = "(I) First the basis of qualified property which is depreciable property.")
rule FarmTierFirstViaAnalogy1017b4C(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(4)(A)(ii)(I) on qualified property by analogy";
    when qualified_property_by_analogy_1017b4C(p, y, a);
    when depreciable_property_1017(p, y, a);
    then farm_indebtedness_reduction_tier(p, y, a, FirstDepreciableQualifiedProperty);
}
@source(IRC_S1017_B, quote = "(III) Then the basis of other qualified property.")
rule FarmTierThirdViaAnalogy1017b4C(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(4)(A)(ii)(III) on qualified property by analogy that is neither depreciable nor farmland";
    when qualified_property_by_analogy_1017b4C(p, y, a);
    when not_known(depreciable_property_1017(p, y, a));
    when not_known(land_used_in_farming_business(a));
    then farm_indebtedness_reduction_tier(p, y, a, ThirdOtherQualifiedProperty);
}

// ============================================================================
// section 1017(d)(2): the straight line for section 1250(b) as if no reduction
// ============================================================================

pub relation basis_reduced_under_1017_1017d2(p: Person, a: Asset) kind empirical {
    label en official "section 1017(d)(2): the basis of the property was reduced under section 1017";
}
pub relation straight_line_adjustments_ignoring_1017_reduction_1017d2(p: Person, a: Asset, on: Date, amount: Money) kind empirical {
    label en official "section 1017(d)(2): the depreciation adjustments that would have resulted under the straight line method as if there had been no reduction under section 1017 (the schedule rerun is external to this package)";
}
pub relation straight_line_for_1250b_as_if_no_1017_reduction(p: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en official "section 1017(d)(2): for section 1250(b) the straight line adjustments are those determined as if there had been no reduction under this section";
}
@source(IRC_S1017_D, quote = "For purposes of section 1250(b), the determination of what would have been the depreciation adjustments under the straight line method shall be made as if there had been no reduction under this section.")
rule StraightLineForSection1250bIgnoresReduction1017d2(p: Person, a: Asset, on: Date, sl: Money) defeasible {
    label en official "section 1017(d)(2)";
    when basis_reduced_under_1017_1017d2(p, a);
    when straight_line_adjustments_ignoring_1017_reduction_1017d2(p, a, on, sl);
    then straight_line_for_1250b_as_if_no_1017_reduction(p, a, on, sl);
}
@source(IRC_S1017_D, quote = "For purposes of section 1250(b), the determination of what would have been the depreciation adjustments under the straight line method shall be made as if there had been no reduction under this section.")
rule AdditionalDepreciationOnStraightLineIgnoringReduction1017d2(p: Person, a: Asset, on: Date, actual: Money, sl: Money) defeasible {
    label en official "section 1017(d)(2) with section 1250(b)(1): additional depreciation of a reduced property against the straight line ignoring the reduction (held more than one year)";
    when actual_depreciation_adjustments(p, a, on, actual);
    when straight_line_for_1250b_as_if_no_1017_reduction(p, a, on, sl);
    when long_term(p, a);
    when actual > sl;
    then additional_depreciation(p, a, on, actual - sl);
}

// ============================================================================
// section 1060(d)(1): the scope of the residual method for a partnership distribution or transfer (the value itself stays a gap)
// ============================================================================

pub relation section_1060a_limited_to_197_value_for_755_1060d1(t: Transaction) kind institutional {
    label en official "section 1060(d)(1): subsection (a) applies to the distribution or transfer only for the value of section 197 intangibles for section 755, not for the basis of the transferee or the gain or loss of the transferor of subsection (a)(1)-(2)";
}
@source(IRC_S1060_D, quote = "(1) the rules of subsection (a) shall apply but only for purposes of determining the value of section 197 intangibles for purposes of applying section 755, and")
rule Section1060aLimitedTo197ValueFor755(t: Transaction) defeasible {
    label en official "section 1060(d)(1)";
    when partnership_distribution_or_interest_transfer_with_section_755(t);
    then section_1060a_limited_to_197_value_for_755_1060d1(t);
}

// ============================================================================
// section 1400Z-2 as amended by Pub. L. 119-21 section 70421(c)(2)(A): the taxable year of inclusion
// ============================================================================

pub relation deferred_gain_included_in_year_pl(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, y: TaxableYear, amount: Money) kind institutional {
    label en official "SEC. 70421(c)(2)(A): the gain is included in gross income in the taxable year which includes the inclusion date (the earlier of the sale or the fifth anniversary)";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, quote = "(1) Applicability.Year of inclusion.—Gain to which subsection (a)(1)(B) applies shall be included in gross income in the taxable year which includes the earlier of— (A) the date on which such investment is sold or exchanged, or (B) the date which is 5 years after the date the investment in the qualified opportunity fund was made.")
rule DeferredGainIncludedInYearOfInclusionDate(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, y: TaxableYear, on: Date, begins_on: Date, ends_on: Date, amount: Money) defeasible {
    label en official "SEC. 70421(c)(2)(A): the taxpayer taxable year that begins on or before and ends on or after the inclusion date, with the amount includible under section 1400Z-2(b)(2)(A)";
    when deferred_gain_inclusion_date_pl(fund_investment, taxpayer, on);
    when us.irc.core::year_of(taxpayer, y);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    when begins_on <= on;
    when on <= ends_on;
    when amount_includible_pl(taxpayer, fund_investment, amount);
    then deferred_gain_included_in_year_pl(taxpayer, fund_investment, y, amount);
}
