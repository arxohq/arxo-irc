    label en unofficial "section 1398(h)(2)(B): the taxable year 2 after the loss year";
}
@source(IRC_S1398_H, relation = formalizes, coverage = exact, quote = "an administrative expense carryover to each of the 7 succeeding taxable years")
rule CarryFwd2Rule(estate: BankruptcyEstate, loss_year: TaxableYear, mid: TaxableYear, target_year: TaxableYear, loss_amount: Money) defeasible {
    label en official "section 1398(h)(2)(B): carryover year 2";
    when administrative_expense_loss_1398h2B(estate, loss_year, loss_amount);
    when carry_fwd_step_1_1398h2B(estate, loss_year, mid);
    when succeeding_taxable_year(mid, target_year);
    then carry_fwd_step_2_1398h2B(estate, loss_year, target_year);
}
rule CarryFwdTarget2Rule(estate: BankruptcyEstate, loss_year: TaxableYear, target_year: TaxableYear) defeasible {
    label en official "section 1398(h)(2)(B): carryover target at offset 2";
    when carry_fwd_step_2_1398h2B(estate, loss_year, target_year);
    then administrative_expense_carry_year_1398h2B(estate, loss_year, target_year, 2);
}
