    label en unofficial "section 1398(h)(2)(B): the taxable year 5 after the loss year";
}
@source(IRC_S1398_H, relation = formalizes, coverage = exact, quote = "an administrative expense carryover to each of the 7 succeeding taxable years")
rule CarryFwd5Rule(estate: BankruptcyEstate, loss_year: TaxableYear, mid: TaxableYear, target_year: TaxableYear, loss_amount: Money) defeasible {
