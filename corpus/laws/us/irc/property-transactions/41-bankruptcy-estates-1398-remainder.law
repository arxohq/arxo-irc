// =============================================================================
// Section 1398(i): the debtor succeeds to the estate's attributes on termination
// =============================================================================

pub relation estate_terminated(c: BankruptcyCase) kind empirical {
    label en official "section 1398(i): the estate terminates";
}
pub relation debtor_succeeds_to_capital_loss_carryover_1398i(debtor: Person, estate: BankruptcyEstate, from_year: TaxableYear, to_year: TaxableYear, character: CapitalLossCharacter, amount: Money) kind institutional {
    label en official "section 1398(i) with (g)(5): on termination the debtor succeeds to the estate's section 1212 capital loss carryover";
}
@source(IRC_S1398_I, relation = formalizes, coverage = partial, quote = "the debtor shall succeed to and take into account the items referred to in paragraphs (1), (2), (3), (4), (5), and (6) of subsection (g)")
rule DebtorSucceedsToCapitalLossCarryoverRule(c: BankruptcyCase, debtor: Person, estate: BankruptcyEstate, from_year: TaxableYear, to_year: TaxableYear, character: CapitalLossCharacter, amount: Money) defeasible {
    label en official "section 1398(i): the debtor takes the estate's capital loss carryover on termination";
    when estate_case_1398(c, debtor, estate);
    when estate_terminated(c);
    when capital_loss_carryover(estate, from_year, to_year, character, amount);
    then debtor_succeeds_to_capital_loss_carryover_1398i(debtor, estate, from_year, to_year, character, amount);
}
pub relation debtor_succeeds_to_basis_1398i(debtor: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en official "section 1398(i) with (g)(6): on termination the debtor's basis in an asset acquired from the estate is the estate's basis";
}
rule DebtorSucceedsToBasisRule(c: BankruptcyCase, debtor: Person, estate: BankruptcyEstate, t: Transaction, a: Asset, on: Date, amount: Money) defeasible {
    label en official "section 1398(i): the debtor takes the estate's basis in an asset transferred on termination";
    when estate_case_1398(c, debtor, estate);
    when estate_terminated(c);
    when transfer_estate_to_debtor_on_termination(t, estate, debtor, a);
    when us.irc.core::adjusted_basis(estate, a, on, amount);
    then debtor_succeeds_to_basis_1398i(debtor, a, on, amount);
}
pub relation debtor_succeeds_to_long_term_1398i(debtor: Person, a: Asset) kind institutional {
    label en official "section 1398(i) with (g)(6): the debtor's holding period tacks the estate's";
}
rule DebtorSucceedsToLongTermRule(c: BankruptcyCase, debtor: Person, estate: BankruptcyEstate, t: Transaction, a: Asset) defeasible {
    label en official "section 1398(i): the estate's long-term holding period passes to the debtor";
    when estate_case_1398(c, debtor, estate);
    when estate_terminated(c);
    when transfer_estate_to_debtor_on_termination(t, estate, debtor, a);
    when long_term(estate, a);
    then debtor_succeeds_to_long_term_1398i(debtor, a);
}
pub relation debtor_succeeds_to_capital_asset_character_1398i(debtor: Person, a: Asset) kind institutional {
    label en official "section 1398(i) with (g)(6): the debtor takes the estate's character";
}
rule DebtorSucceedsToCapitalAssetCharacterRule(c: BankruptcyCase, debtor: Person, estate: BankruptcyEstate, t: Transaction, a: Asset) defeasible {
    label en official "section 1398(i): the capital-asset character passes to the debtor";
    when estate_case_1398(c, debtor, estate);
    when estate_terminated(c);
    when transfer_estate_to_debtor_on_termination(t, estate, debtor, a);
    when capital_asset(estate, a);
    then debtor_succeeds_to_capital_asset_character_1398i(debtor, a);
}
pub relation debtor_succeeds_to_nol_carryover_1398i(debtor: Person, estate: BankruptcyEstate, amount: Money) kind institutional {
    label en unofficial "section 1398(i) with (g)(1): pending contract - the section 172 net operating loss carryover, owned by income-individual/deductions";
}
pub relation debtor_succeeds_to_charitable_carryover_1398i(debtor: Person, estate: BankruptcyEstate, amount: Money) kind institutional {
    label en unofficial "section 1398(i) with (g)(2): pending contract - the section 170(d)(1) carryover, owned by deductions";
}
pub relation debtor_succeeds_to_tax_benefit_items_1398i(debtor: Person, estate: BankruptcyEstate) kind institutional {
    label en unofficial "section 1398(i) with (g)(3): pending contract - section 111 tax-benefit items, owned by gross-income";
}
pub relation debtor_succeeds_to_credit_carryovers_1398i(debtor: Person, estate: BankruptcyEstate) kind institutional {
    label en unofficial "section 1398(i) with (g)(4): pending contract - credit carryovers, owned by credits";
}
pub relation regulations_prescribe_other_attribute_1398g8_i(attribute: Asset) kind empirical {
    label en official "section 1398(g)(8), (i): another tax attribute prescribed by regulations (external)";
}

// =============================================================================
// Section 1398(j): accounting period and carrybacks
// =============================================================================

pub relation estate_has_no_prior_accounting_period_change(estate: BankruptcyEstate) kind empirical {
    label en official "section 1398(j)(1): the estate has not previously changed its annual accounting period";
}
pub relation estate_elects_accounting_period_change(estate: BankruptcyEstate) kind empirical {
    label en official "section 1398(j)(1): the estate changes its annual accounting period";
}
pub relation estate_accounting_period_changed_1398j1(estate: BankruptcyEstate) kind institutional {
    label en official "section 1398(j)(1): the estate has changed its annual accounting period once, without Secretary approval";
}
@source(IRC_S1398_J, relation = formalizes, coverage = exact, quote = "the estate may change its annual accounting period one time without the approval of the Secretary")
rule EstateAccountingPeriodChangePower(estate: BankruptcyEstate) strict {
    label en official "section 1398(j)(1): the estate may change its annual accounting period one time without approval";
    when estate_elects_accounting_period_change(estate);
    then power Section1398EstateAccountingPeriodChange {
        holder estate;
        over estate;
        exercise estate_elects_accounting_period_change(estate);
        valid_when estate_has_no_prior_accounting_period_change(estate);
        effect create(estate_accounting_period_changed_1398j1(estate));
        window [@1980-01-01, infinity);
    };
}
pub relation estate_carryback_1398j2(estate: BankruptcyEstate, carry_item: Transaction, carryback_year: TaxableYear, amount: Money) kind empirical {
    label en official "section 1398(j)(2)(A): a carryback of the estate to a carryback year";
}
pub relation carryback_year_before_estates_first_year(carryback_year: TaxableYear) kind empirical {
    label en official "section 1398(j)(2)(A): the carryback year is a taxable year before the estate's first taxable year";
}
pub relation debtor_year_corresponding_to(carryback_year: TaxableYear, debtor_year: TaxableYear) kind empirical {
    label en official "section 1398(j)(2)(A): the debtor's taxable year corresponding to the carryback year";
}
pub relation estate_carryback_taken_into_account_for_debtor_year_1398j2A(estate: BankruptcyEstate, debtor_year: TaxableYear, amount: Money) kind institutional {
    label en official "section 1398(j)(2)(A): the carryback is taken into account for the debtor's corresponding taxable year";
}
@source(IRC_S1398_J, relation = formalizes, coverage = exact, quote = "the carryback to such carryback year shall be taken into account for the debtor's taxable year corresponding to the carryback year")
rule EstateCarrybackToDebtorYearRule(c: BankruptcyCase, debtor: Person, estate: BankruptcyEstate, item: Transaction, cy: TaxableYear, dy: TaxableYear, amount: Money) defeasible {
    label en official "section 1398(j)(2)(A): an estate carryback to a pre-estate year is taken into account for the debtor's corresponding year";
    when estate_case_1398(c, debtor, estate);
    when estate_carryback_1398j2(estate, item, cy, amount);
    when carryback_year_before_estates_first_year(cy);
    when debtor_year_corresponding_to(cy, dy);
    then estate_carryback_taken_into_account_for_debtor_year_1398j2A(estate, dy, amount);
}
pub relation debtor_carryback_1398j2(debtor: Person, carry_item: Transaction, from_year: TaxableYear, to_year: TaxableYear) kind empirical {
    label en official "section 1398(j)(2)(B): a carryback of the debtor from a taxable year to an earlier taxable year";
}
pub relation year_before_debtors_commencement_year(c: BankruptcyCase, y: TaxableYear) kind empirical {
    label en official "section 1398(j)(2)(B): a taxable year before the debtor's taxable year in which the case commences";
}
pub relation debtor_carryback_barred_1398j2B(debtor: Person, carry_item: Transaction) kind institutional {
    label en official "section 1398(j)(2)(B): the debtor may not carry back to a year before the commencement year a carryback from a year ending after the case commences";
}
@source(IRC_S1398_J, relation = formalizes, coverage = exact, quote = "The debtor may not carry back to a taxable year before the debtor's taxable year in which the case commences any carryback from a taxable year ending after the case commences")
rule DebtorCarrybackBarredRule(c: BankruptcyCase, debtor: Person, item: Transaction, from_year: TaxableYear, to_year: TaxableYear, from_end: Date, commenced: Date) defeasible {
    label en official "section 1398(j)(2)(B): a post-commencement carryback into a pre-commencement-year is barred";
    when section_1398_applies(c, debtor);
    when debtor_carryback_1398j2(debtor, item, from_year, to_year);
    when us.irc.core::ends(from_year, from_end);
    when commencement_date(c, commenced);
    when from_end > commenced;
    when year_before_debtors_commencement_year(c, to_year);
    then debtor_carryback_barred_1398j2B(debtor, item);
}
pub relation carry_item_is_nol_carryback_172(item: Transaction) kind empirical {
    label en official "section 1398(j)(2)(C)(i): a net operating loss carryback under section 172";
}
pub relation carry_item_is_part_IV_credit_carryback(item: Transaction) kind empirical {
    label en official "section 1398(j)(2)(C)(i): a carryback of any credit provided by part IV of subchapter A";
}
pub relation carryback_1398j2Ci(item: Transaction) kind institutional {
    label en official "section 1398(j)(2)(C)(i): the term carryback";
}
@source(IRC_S1398_J, relation = formalizes, coverage = exact, quote = "The term \"carryback\" means a net operating loss carryback under section 172 or a carryback of any credit provided by part IV of subchapter A")
rule CarrybackNolRule(item: Transaction) strict {
    label en official "section 1398(j)(2)(C)(i): a net operating loss carryback is a carryback";
    when carry_item_is_nol_carryback_172(item);
    then carryback_1398j2Ci(item);
}
rule CarrybackCreditRule(item: Transaction) strict {
    label en official "section 1398(j)(2)(C)(i): a part IV credit carryback is a carryback";
    when carry_item_is_part_IV_credit_carryback(item);
    then carryback_1398j2Ci(item);
}
pub relation carried_to_year(item: Transaction, y: TaxableYear) kind empirical {
    label en official "the taxable year to which the item is carried";
}
pub relation carryback_year_1398j2Cii(item: Transaction, y: TaxableYear) kind institutional {
    label en official "section 1398(j)(2)(C)(ii): the taxable year to which a carryback is carried";
}
@source(IRC_S1398_J, relation = formalizes, coverage = exact, quote = "The term \"carryback year\" means the taxable year to which a carryback is carried")
rule CarrybackYearRule(item: Transaction, y: TaxableYear) strict {
    label en official "section 1398(j)(2)(C)(ii): the carryback year is the year to which a carryback is carried";
    when carryback_1398j2Ci(item);
    when carried_to_year(item, y);
    then carryback_year_1398j2Cii(item, y);
}
