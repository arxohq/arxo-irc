// Property transactions -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Placeholder relations of this package that name a norm of `us.irc.definitions` are derived from its `pub` relations. The case-fact
// channel stays valid (WIRE-7/8/9 technique).

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

use self::{
    IRC_S1202_B,
    IRC_S1211_A,
    Person,
    TaxableYear,
    corporation_taxpayer,
    married_filing_separate_return_1202,
};

// --- section 7701(a)(3): corporation (section 1211(a)) ----------------------------------------------------------------------------

@source(IRC_S1211_A, relation = formalizes, coverage = partial, quote = "In the case of a corporation, losses from sales or exchanges of capital assets shall be allowed only to the extent of gains from such sales or exchanges.")
rule W10CorporationTaxpayerFromDefinitions(p: Person) strict {
    label en official "a person the definitions package classifies as a corporation (section 7701(a)(3)) is a corporation for the section 1211(a) limitation";
    when us.irc.definitions::corporation(p);
    then corporation_taxpayer(p);
}

// --- section 7703: a married individual filing a separate return (section 1202(b)(3)(A)) -----------------------------------------

@source(IRC_S1202_B, relation = formalizes, coverage = partial, quote = "In the case of a separate return by a married individual, paragraph (1)(A) shall be applied by substituting")
rule W10MarriedFilingSeparateReturn1202FromDefinitions(p: us.irc.core::Individual, y: TaxableYear) strict {
    label en official "an individual who is married under section 7703(a) and files a separate return is a married individual filing a separate return";
    when us.irc.definitions::married_for_this_title(p, y);
    when us.irc.definitions::files_separate_return(p, y);
    then married_filing_separate_return_1202(p, y);
}
