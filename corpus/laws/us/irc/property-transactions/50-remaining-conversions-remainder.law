// Stage 3b (IRC-07, A05). Late conversions of rows that stage 3b first re-tagged as gaps:
// section 1391(f) (the application elements), section 1394(b)(3)(C)(iii) (untracted areas),
// section 1400Z-1(b)(2) (the extension request as a power), section 1017(b)(3)(F) (qualified real
// property business indebtedness), section 1060(a) (the residual method over classes I-VII, unrolled),
// section 1248(f) (nonrecognition distributions), section 1255(a)(1) (the coordination limb) and
// section 1250(d)(4)(A)-(C) (the greater-of candidates).
//
// Method. Module 27's nomination rule now has a parallel rule reading the derived application
// relation. The class allocation is a chain of seven predicates (sequential caps, LDC-E4102 avoided):
// each class takes the lesser of its fair market value and the consideration still unallocated;
// class VII takes what remains.

// =============================================================================
// Section 1391(f)
// =============================================================================

use self::{
    Asset,
    CensusTract,
    Corporation,
    IRC_S1017_B,
    IRC_S1060_A,
    IRC_S1244_A,
    IRC_S1248_F,
    IRC_S1255_A,
    IRC_S1391_F,
    IRC_S1400Z_1_B,
    NominatedArea,
    Person,
    Section1244IndividualLossLimit,
    Section1244JointReturnLossLimit,
    TaxableYear,
    Transaction,
    applicable_asset_acquisition,
    depreciable_property_1017,
    determination_period_end,
    determination_period_start,
    is_trust_or_estate_1244,
    joint_return_filed_1244,
    nominated_by_local_governments_and_state,
    nomination_requirements_met_1391,
    nominators_certify_no_overlap,
    nominators_have_authority_and_give_assurances,
    secretary_determines_information_reasonably_accurate,
    section_1244_stock,
    section_1255_ordinary_income,
};

pub relation application_demonstrates_eligibility_1391f1(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(1): the application demonstrates that the nominated area satisfies the eligibility criteria of section 1392";
}
pub relation plan_describes_coordinated_development_1391f2A(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(2)(A): the plan describes the coordinated economic, human, community and physical development plan and related activities";
}
pub relation plan_describes_community_partnership_process_1391f2B(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(2)(B): the plan describes the process by which the affected community is a full partner";
}
pub relation plan_identifies_resources_1391f2C(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(2)(C): the plan identifies the State, local and private resources available";
}
pub relation plan_identifies_federal_funding_requested_1391f2D(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(2)(D): the plan identifies the funding requested under any Federal program";
}
pub relation plan_identifies_baselines_and_benchmarks_1391f2E(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(2)(E): the plan identifies baselines, methods and benchmarks for measuring success";
}
pub relation plan_includes_action_to_relocate_establishment_1391f2F(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(2)(F): the plan includes an action to assist an establishment in relocating from one area outside the zone into it";
}
pub relation relocation_carve_out_new_branch_1391f2F(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(2)(F)(i)-(ii): the new branch, affiliate or subsidiary will not decrease employment at the original location and is not being established with the intention of closing the original operation";
}
pub relation application_includes_other_information_1391f3(area: NominatedArea) kind empirical {
    label en official "section 1391(f)(3): the application includes such other information as may be required by the Secretary";
}
pub relation strategic_plan_meets_1391f2(area: NominatedArea) kind institutional {
    label en official "section 1391(f)(2): the strategic plan has elements (A)-(E) and does not include a relocation action (outside the carve-out)";
}
@source(IRC_S1391_F, relation = formalizes, coverage = exact, quote = "includes a strategic plan for accomplishing the purposes of this subchapter that")
rule StrategicPlanRule(area: NominatedArea) defeasible {
    label en official "section 1391(f)(2): all plan elements are present and there is no disqualifying relocation action";
    when plan_describes_coordinated_development_1391f2A(area);
    when plan_describes_community_partnership_process_1391f2B(area);
    when plan_identifies_resources_1391f2C(area);
    when plan_identifies_federal_funding_requested_1391f2D(area);
    when plan_identifies_baselines_and_benchmarks_1391f2E(area);
    when not_known(plan_includes_action_to_relocate_establishment_1391f2F(area));
    then strategic_plan_meets_1391f2(area);
}
rule StrategicPlanWithCarveOutRule(area: NominatedArea) defeasible {
    label en official "section 1391(f)(2)(F): a relocation action within the carve-out does not disqualify the plan";
    when plan_describes_coordinated_development_1391f2A(area);
    when plan_describes_community_partnership_process_1391f2B(area);
    when plan_identifies_resources_1391f2C(area);
    when plan_identifies_federal_funding_requested_1391f2D(area);
    when plan_identifies_baselines_and_benchmarks_1391f2E(area);
    when plan_includes_action_to_relocate_establishment_1391f2F(area);
    when relocation_carve_out_new_branch_1391f2F(area);
    then strategic_plan_meets_1391f2(area);
}
pub relation application_meets_1391f_derived(area: NominatedArea) kind institutional {
    label en official "section 1391(f): the application demonstrates eligibility, includes a compliant strategic plan and the other required information (derived)";
}
@source(IRC_S1391_F, relation = formalizes, coverage = exact, quote = "No area may be designated under this section unless the application for such designation")
rule ApplicationMeets1391fRule(area: NominatedArea) defeasible {
    label en official "section 1391(f)(1)-(3)";
    when application_demonstrates_eligibility_1391f1(area);
    when strategic_plan_meets_1391f2(area);
    when application_includes_other_information_1391f3(area);
    then application_meets_1391f_derived(area);
}
rule NominationRequirementsDerivedRule(area: NominatedArea) defeasible {
    label en official "section 1391(e)-(f): the nomination requirements met with the derived application test";
    when nominated_by_local_governments_and_state(area);
    when nominators_have_authority_and_give_assurances(area);
    when secretary_determines_information_reasonably_accurate(area);
    when nominators_certify_no_overlap(area);
    when application_meets_1391f_derived(area);
    then nomination_requirements_met_1391(area);
}

// =============================================================================
// Section 1394(b)(3)(C)(iii); section 1400Z-1(b)(2)
// =============================================================================

pub relation state_ceo_requests_extension(ceo: Person, tract: CensusTract) kind empirical {
    label en official "section 1400Z-1(b)(2): the chief executive officer of a State requests that the Secretary extend the determination or consideration period, or both, for an additional 30 days";
}
pub relation request_within_determination_period_1400Z1b2(tract: CensusTract) kind empirical {
    label en official "section 1400Z-1(b)(2): the request is made within the period to be extended";
}
pub relation secretary_grants_extension_1400Z1b2(tract: CensusTract) kind empirical {
    label en official "section 1400Z-1(b)(2): the Secretary grants the extension";
}
pub relation extension_requested_1400Z1b2(tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(b)(2): a valid extension request is on file";
}
@source(IRC_S1400Z_1_B, relation = formalizes, coverage = exact, quote = "A chief executive officer of a State may request that the Secretary extend either the determination or consideration period, or both")
rule ExtensionRequestPower(ceo: Person, tract: CensusTract) strict {
    label en official "section 1400Z-1(b)(2): a State chief executive may request a 30-day extension";
    when state_ceo_requests_extension(ceo, tract);
    then power Section1400Z1ExtensionRequest {
        holder ceo;
        over tract;
        exercise state_ceo_requests_extension(ceo, tract);
        valid_when request_within_determination_period_1400Z1b2(tract);
        effect create(extension_requested_1400Z1b2(tract));
        window [@2017-12-22, infinity);
    };
}
pub relation determination_period_extended_derived_1400Z1b2(tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(b)(2): the request was made and the Secretary granted the extension";
}
rule ExtensionGrantedRule(tract: CensusTract) defeasible {
    label en official "section 1400Z-1(b)(2): a valid request followed by the Secretary's grant";
    when extension_requested_1400Z1b2(tract);
    when secretary_grants_extension_1400Z1b2(tract);
    then determination_period_extended_derived_1400Z1b2(tract);
}
rule DeterminationPeriodEndDerivedExtensionRule(tract: CensusTract, start: Date) defeasible {
    label en official "section 1400Z-1(b)(2), (c)(2)(B): 90 days plus 30 when the derived extension applies";
    when determination_period_start(tract, start);
    when determination_period_extended_derived_1400Z1b2(tract);
    then determination_period_end(tract, add_calendar_period(start, 120 calendar_day));
}

// =============================================================================
// Section 1017(b)(3)(F)
// =============================================================================

pub relation amount_applied_under_108c1_qrpbi(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1017(b)(3)(F): the amount is applied to reduce basis under section 108(c)(1) (qualified real property business indebtedness)";
}
pub relation depreciable_real_property_1017(a: Asset) kind empirical {
    label en official "section 1017(b)(3)(F)(i): depreciable real property";
}
pub relation depreciable_property_qrpbi_1017b3F(p: Person, y: TaxableYear, a: Asset) kind institutional {
    label en official "section 1017(b)(3)(F)(i): for a section 108(c)(1) amount depreciable property includes only depreciable real property (subparagraphs (A) and (C))";
}
@source(IRC_S1017_B, relation = formalizes, coverage = exact, quote = "depreciable property shall only include depreciable real property for purposes of subparagraphs (A) and (C)")
rule DepreciableRealPropertyOnlyRule(p: Person, y: TaxableYear, a: Asset) defeasible {
    label en official "section 1017(b)(3)(F)(i): only depreciable real property counts";
    when amount_applied_under_108c1_qrpbi(p, y);
    when depreciable_property_1017(p, y, a);
    when depreciable_real_property_1017(a);
    then depreciable_property_qrpbi_1017b3F(p, y, a);
}
pub relation inventory_election_disapplied_1017b3Fii(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1017(b)(3)(F)(ii): subparagraph (E) does not apply to a section 108(c)(1) amount";
}
@source(IRC_S1017_B, relation = formalizes, coverage = exact, quote = "subparagraph (E) shall not apply")
rule InventoryElectionDisapplied1017Rule(p: Person, y: TaxableYear) defeasible {
    label en official "section 1017(b)(3)(F)(ii): the inventory-real-property election is unavailable";
    when amount_applied_under_108c1_qrpbi(p, y);
    then inventory_election_disapplied_1017b3Fii(p, y);
}
pub relation property_taken_into_account_under_108c2B(a: Asset) kind empirical {
    label en official "section 1017(b)(3)(F)(iii): property taken into account under section 108(c)(2)(B)";
}
pub relation reduction_time_under_1017a(a: Asset, on: Date) kind empirical {
    label en official "section 1017(a): the time of the reduction (the first day of the taxable year following the discharge)";
}
pub relation disposition_date_of_property_1017(a: Asset, on: Date) kind empirical {
    label en official "section 1017(b)(3)(F)(iii): the date of disposition of the property";
}
pub relation reduction_time_1017b3Fiii(a: Asset, on: Date) kind institutional {
    label en official "section 1017(b)(3)(F)(iii): the reduction is made as of the time immediately before disposition if earlier than the time under subsection (a)";
}
@source(IRC_S1017_B, relation = formalizes, coverage = exact, quote = "the reduction with respect to such property shall be made as of the time immediately before disposition if earlier than the time under subsection (a)")
rule ReductionTimeEarlierDispositionRule(a: Asset, normal: Date, disposed: Date) defeasible {
    label en official "section 1017(b)(3)(F)(iii): the disposition date when it is earlier (modelled as the disposition date, the ordering within the day being the case's)";
    when property_taken_into_account_under_108c2B(a);
    when reduction_time_under_1017a(a, normal);
    when disposition_date_of_property_1017(a, disposed);
    when disposed < normal;
    then reduction_time_1017b3Fiii(a, disposed);
}
rule ReductionTimeNormalRule(a: Asset, normal: Date, disposed: Date) defeasible {
    label en official "section 1017(b)(3)(F)(iii): the section 1017(a) time when the disposition is not earlier";
    when property_taken_into_account_under_108c2B(a);
    when reduction_time_under_1017a(a, normal);
    when disposition_date_of_property_1017(a, disposed);
    when disposed >= normal;
    then reduction_time_1017b3Fiii(a, normal);
}

// =============================================================================
// Section 1060(a): the residual method over classes I-VII
// =============================================================================

pub relation total_consideration_for_applicable_assets_1060(t: Transaction, amount: Money) kind empirical {
    label en official "section 1060(a): the consideration received for the assets acquired in the applicable asset acquisition";
}
pub relation class_fair_market_value_1060(t: Transaction, class: Integer, amount: Money) kind empirical {
    label en official "section 1060(a): the aggregate fair market value of the class I to VI assets (the case supplies the class totals); class VII takes the residual";
}
pub relation class_allocation_1060(t: Transaction, class: Integer, amount: Money) kind institutional {
    label en official "section 1060(a): the consideration allocated to the asset class under the residual method";
}
pub relation alloc_class_1_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): class I allocation";
}
pub relation unallocated_after_class_1_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): the consideration still unallocated after class I";
}
@source(IRC_S1060_A, relation = formalizes, coverage = partial, quote = "the consideration received for such assets shall be allocated among such assets acquired in such acquisition in the same manner as amounts are allocated to assets under section 338(b)(5)")
rule Alloc1WithinRule(t: Transaction, cons: Money, fmv: Money) defeasible {
    label en official "section 1060(a) (classes under section 338(b)(5)): class I takes the whole consideration when it does not exceed its value";
    when applicable_asset_acquisition(t);
    when total_consideration_for_applicable_assets_1060(t, cons);
    when class_fair_market_value_1060(t, 1, fmv);
    when cons <= fmv;
    then alloc_class_1_1060(t, cons);
}
rule Alloc1CappedRule(t: Transaction, cons: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class I takes its fair market value when the consideration exceeds it";
    when applicable_asset_acquisition(t);
    when total_consideration_for_applicable_assets_1060(t, cons);
    when class_fair_market_value_1060(t, 1, fmv);
    when cons > fmv;
    then alloc_class_1_1060(t, fmv);
}
rule Rem1Rule(t: Transaction, cons: Money, a: Money) defeasible {
    label en official "section 1060(a): the consideration left after class I";
    when total_consideration_for_applicable_assets_1060(t, cons);
    when alloc_class_1_1060(t, a);
    then unallocated_after_class_1_1060(t, cons - a);
}
rule ClassAllocation1Rule(t: Transaction, a: Money) defeasible {
    label en official "section 1060(a): the class I allocation";
    when alloc_class_1_1060(t, a);
    then class_allocation_1060(t, 1, a);
}
pub relation alloc_class_2_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): class 2 allocation";
}
pub relation unallocated_after_class_2_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): the consideration still unallocated after class 2";
}
rule Alloc2WithinRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 2 takes all that remains when it does not exceed its value";
    when unallocated_after_class_1_1060(t, rem);
    when class_fair_market_value_1060(t, 2, fmv);
    when rem <= fmv;
    then alloc_class_2_1060(t, rem);
}
rule Alloc2CappedRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 2 takes its fair market value when more remains";
    when unallocated_after_class_1_1060(t, rem);
    when class_fair_market_value_1060(t, 2, fmv);
    when rem > fmv;
    then alloc_class_2_1060(t, fmv);
}
rule Rem2Rule(t: Transaction, rem: Money, a: Money) defeasible {
    label en official "section 1060(a): the consideration left after class 2";
    when unallocated_after_class_1_1060(t, rem);
    when alloc_class_2_1060(t, a);
    then unallocated_after_class_2_1060(t, rem - a);
}
rule ClassAllocation2Rule(t: Transaction, a: Money) defeasible {
    label en official "section 1060(a): the class 2 allocation";
    when alloc_class_2_1060(t, a);
    then class_allocation_1060(t, 2, a);
}
pub relation alloc_class_3_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): class 3 allocation";
}
pub relation unallocated_after_class_3_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): the consideration still unallocated after class 3";
}
rule Alloc3WithinRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 3 takes all that remains when it does not exceed its value";
    when unallocated_after_class_2_1060(t, rem);
    when class_fair_market_value_1060(t, 3, fmv);
    when rem <= fmv;
    then alloc_class_3_1060(t, rem);
}
rule Alloc3CappedRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 3 takes its fair market value when more remains";
    when unallocated_after_class_2_1060(t, rem);
    when class_fair_market_value_1060(t, 3, fmv);
    when rem > fmv;
    then alloc_class_3_1060(t, fmv);
}
rule Rem3Rule(t: Transaction, rem: Money, a: Money) defeasible {
    label en official "section 1060(a): the consideration left after class 3";
    when unallocated_after_class_2_1060(t, rem);
    when alloc_class_3_1060(t, a);
    then unallocated_after_class_3_1060(t, rem - a);
}
rule ClassAllocation3Rule(t: Transaction, a: Money) defeasible {
    label en official "section 1060(a): the class 3 allocation";
    when alloc_class_3_1060(t, a);
    then class_allocation_1060(t, 3, a);
}
pub relation alloc_class_4_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): class 4 allocation";
}
pub relation unallocated_after_class_4_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): the consideration still unallocated after class 4";
}
rule Alloc4WithinRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 4 takes all that remains when it does not exceed its value";
    when unallocated_after_class_3_1060(t, rem);
    when class_fair_market_value_1060(t, 4, fmv);
    when rem <= fmv;
    then alloc_class_4_1060(t, rem);
}
rule Alloc4CappedRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 4 takes its fair market value when more remains";
    when unallocated_after_class_3_1060(t, rem);
    when class_fair_market_value_1060(t, 4, fmv);
    when rem > fmv;
    then alloc_class_4_1060(t, fmv);
}
rule Rem4Rule(t: Transaction, rem: Money, a: Money) defeasible {
    label en official "section 1060(a): the consideration left after class 4";
    when unallocated_after_class_3_1060(t, rem);
    when alloc_class_4_1060(t, a);
    then unallocated_after_class_4_1060(t, rem - a);
}
rule ClassAllocation4Rule(t: Transaction, a: Money) defeasible {
    label en official "section 1060(a): the class 4 allocation";
    when alloc_class_4_1060(t, a);
    then class_allocation_1060(t, 4, a);
}
pub relation alloc_class_5_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): class 5 allocation";
}
pub relation unallocated_after_class_5_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): the consideration still unallocated after class 5";
}
rule Alloc5WithinRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 5 takes all that remains when it does not exceed its value";
    when unallocated_after_class_4_1060(t, rem);
    when class_fair_market_value_1060(t, 5, fmv);
    when rem <= fmv;
    then alloc_class_5_1060(t, rem);
}
rule Alloc5CappedRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 5 takes its fair market value when more remains";
    when unallocated_after_class_4_1060(t, rem);
    when class_fair_market_value_1060(t, 5, fmv);
    when rem > fmv;
    then alloc_class_5_1060(t, fmv);
}
rule Rem5Rule(t: Transaction, rem: Money, a: Money) defeasible {
    label en official "section 1060(a): the consideration left after class 5";
    when unallocated_after_class_4_1060(t, rem);
    when alloc_class_5_1060(t, a);
    then unallocated_after_class_5_1060(t, rem - a);
}
rule ClassAllocation5Rule(t: Transaction, a: Money) defeasible {
    label en official "section 1060(a): the class 5 allocation";
    when alloc_class_5_1060(t, a);
    then class_allocation_1060(t, 5, a);
}
pub relation alloc_class_6_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): class 6 allocation";
}
pub relation unallocated_after_class_6_1060(t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1060(a): the consideration still unallocated after class 6";
}
rule Alloc6WithinRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 6 takes all that remains when it does not exceed its value";
    when unallocated_after_class_5_1060(t, rem);
    when class_fair_market_value_1060(t, 6, fmv);
    when rem <= fmv;
    then alloc_class_6_1060(t, rem);
}
rule Alloc6CappedRule(t: Transaction, rem: Money, fmv: Money) defeasible {
    label en official "section 1060(a): class 6 takes its fair market value when more remains";
    when unallocated_after_class_5_1060(t, rem);
    when class_fair_market_value_1060(t, 6, fmv);
    when rem > fmv;
    then alloc_class_6_1060(t, fmv);
}
rule Rem6Rule(t: Transaction, rem: Money, a: Money) defeasible {
    label en official "section 1060(a): the consideration left after class 6";
    when unallocated_after_class_5_1060(t, rem);
    when alloc_class_6_1060(t, a);
    then unallocated_after_class_6_1060(t, rem - a);
}
rule ClassAllocation6Rule(t: Transaction, a: Money) defeasible {
    label en official "section 1060(a): the class 6 allocation";
    when alloc_class_6_1060(t, a);
    then class_allocation_1060(t, 6, a);
}
rule ClassAllocation7Rule(t: Transaction, rem: Money) defeasible {
    label en official "section 1060(a): class VII (goodwill and going concern value) takes the residual";
    when unallocated_after_class_6_1060(t, rem);
    then class_allocation_1060(t, 7, rem);
}

// =============================================================================
// Section 1248(f)
// =============================================================================

pub relation domestic_corporation_satisfies_1248a2_ownership(t: Transaction, corp: Person) kind empirical {
    label en official "section 1248(f)(1)(A): a domestic corporation satisfies the stock ownership requirements of subsection (a)(2) with respect to a foreign corporation";
}
pub relation distribution_under_311a_337_355c1_361c1(t: Transaction) kind empirical {
    label en official "section 1248(f)(1)(B): the domestic corporation distributes stock of the foreign corporation in a distribution to which section 311(a), 337, 355(c)(1) or 361(c)(1) applies";
}
pub relation fair_market_value_of_distributed_foreign_stock(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(f)(1): the fair market value of the distributed stock";
}
pub relation adjusted_basis_of_distributed_foreign_stock_1248f(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(f)(1): the adjusted basis of the stock in the hands of the domestic corporation";
}
pub relation earnings_attributable_to_distributed_stock_1248f(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(f)(1): the earnings and profits of the foreign corporation attributable to the stock, accumulated in taxable years beginning after 1962 while it was a controlled foreign corporation and the domestic corporation held the stock";
}
pub relation exception_1248f2_applies(t: Transaction) kind empirical {
    label en official "section 1248(f)(2): the distribution is to a domestic corporation treated as holding the stock for the distributing corporation's period and satisfying the stock ownership requirements immediately after";
}
pub relation dividend_inclusion_1248f1(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(f)(1): the excess of fair market value over adjusted basis is included in gross income as a dividend to the extent of the attributable earnings and profits";
}
@source(IRC_S1248_F, relation = formalizes, coverage = exact, quote = "an amount equal to the excess of the fair market value of such stock over its adjusted basis in the hands of the domestic corporation shall be included in the gross income of the domestic corporation as a dividend")
rule DividendInclusion1248fWithinRule(t: Transaction, corp: Person, fmv: Money, basis: Money, earnings: Money) defeasible {
    label en official "section 1248(f)(1): the gain (not above the attributable earnings) is a dividend";
    when domestic_corporation_satisfies_1248a2_ownership(t, corp);
    when distribution_under_311a_337_355c1_361c1(t);
    when not_known(exception_1248f2_applies(t));
    when fair_market_value_of_distributed_foreign_stock(t, fmv);
    when adjusted_basis_of_distributed_foreign_stock_1248f(t, basis);
    when earnings_attributable_to_distributed_stock_1248f(t, earnings);
    when fmv > basis;
    when (fmv - basis) <= earnings;
    then dividend_inclusion_1248f1(t, fmv - basis);
}
rule DividendInclusion1248fCappedRule(t: Transaction, corp: Person, fmv: Money, basis: Money, earnings: Money) defeasible {
    label en official "section 1248(f)(1): the dividend is capped at the attributable earnings and profits";
    when domestic_corporation_satisfies_1248a2_ownership(t, corp);
    when distribution_under_311a_337_355c1_361c1(t);
    when not_known(exception_1248f2_applies(t));
    when fair_market_value_of_distributed_foreign_stock(t, fmv);
    when adjusted_basis_of_distributed_foreign_stock_1248f(t, basis);
    when earnings_attributable_to_distributed_stock_1248f(t, earnings);
    when fmv > basis;
    when (fmv - basis) > earnings;
    then dividend_inclusion_1248f1(t, earnings);
}
pub relation distribution_treated_as_sale_under_1248a_1248f1(t: Transaction) kind institutional {
    label en official "section 1248(f)(1): for subsections (c)(2), (d) and (h) the distribution is treated as a sale of stock to which subsection (a) applies";
}
@source(IRC_S1248_F, relation = formalizes, coverage = exact, quote = "For purposes of subsections (c)(2), (d), and (h), a distribution of stock to which this subsection applies shall be treated as a sale of stock to which subsection (a) applies")
rule DistributionTreatedAsSaleRule(t: Transaction, corp: Person) defeasible {
    label en official "section 1248(f)(1): a covered distribution is treated as a sale for the exclusion subsections";
    when domestic_corporation_satisfies_1248a2_ownership(t, corp);
    when distribution_under_311a_337_355c1_361c1(t);
    when not_known(exception_1248f2_applies(t));
    then distribution_treated_as_sale_under_1248a_1248f1(t);
}
pub relation earnings_taken_into_account_under_1248f_excluded_from_1248e_3(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(f)(3): earnings and profits taken into account under subsection (f) are excluded and not taken into account for subsection (e)";
}
@source(IRC_S1248_F, relation = formalizes, coverage = exact, quote = "To the extent that earnings and profits are taken into account under this subsection, they shall be excluded and not taken into account for purposes of subsection (e)")
rule EarningsExcludedFromSubsectionERule(t: Transaction, amount: Money) defeasible {
    label en official "section 1248(f)(3): the earnings used for the dividend are not counted again under subsection (e)";
    when dividend_inclusion_1248f1(t, amount);
    then earnings_taken_into_account_under_1248f_excluded_from_1248e_3(t, amount);
}

// =============================================================================
// Section 1255(a)(1) coordination limb
// =============================================================================

pub relation ordinary_income_recognized_under_other_provision_of_part_1255(t: Transaction, amount: Money) kind empirical {
    label en official "section 1255(a)(1): the part of the gain recognized as ordinary income under another provision of this part";
}
pub relation section_1255_ordinary_income_net_of_other_provisions(t: Transaction, amount: Money) kind institutional {
    label en official "section 1255(a)(1): this section does not apply to the extent the gain is recognized as ordinary income under any other provision of the part";
}
@source(IRC_S1255_A, relation = formalizes, coverage = exact, quote = "this section shall not apply to the extent such gain is recognized as ordinary income under any other provision of this part")
rule Section1255NetOfOtherRule(t: Transaction, ordinary: Money, other: Money) defeasible {
    label en official "section 1255(a)(1): the section 1255 amount less the amount already ordinary under another provision (when positive)";
    when section_1255_ordinary_income(t, ordinary);
    when ordinary_income_recognized_under_other_provision_of_part_1255(t, other);
    when ordinary > other;
    then section_1255_ordinary_income_net_of_other_provisions(t, ordinary - other);
}
rule Section1255NetOfOtherNoneRule(t: Transaction, ordinary: Money, other: Money) defeasible {
    label en official "section 1255(a)(1): nothing remains when the other provisions cover the amount";
    when section_1255_ordinary_income(t, ordinary);
    when ordinary_income_recognized_under_other_provision_of_part_1255(t, other);
    when ordinary <= other;
    then section_1255_ordinary_income_net_of_other_provisions(t, 0.00 USD);
}

// =============================================================================
// Section 1244(a): stock issued to a partnership
// =============================================================================

pub relation stock_issued_to_partnership_1244(a: Asset, partnership: Person, corp: Corporation) kind empirical {
    label en official "section 1244(a): section 1244 stock issued to a partnership";
}
pub relation partner_share_of_partnership_loss_1244(p: Person, partnership: Person, t: Transaction, amount: Money) kind empirical {
    label en official "section 1244(a): the individual partner's distributive share of the partnership's loss on the stock (a case amount; the partner-at-issuance condition of the section is not a fragment of this package: JUDGMENT CALL)";
}
pub relation section_1244_ordinary_loss_via_partnership(p: Person, t: Transaction, amount: Money) kind institutional {
    label en official "section 1244(a), (b): the partner's share of a loss on partnership-held section 1244 stock treated as an ordinary loss within the annual limit";
}
@source(IRC_S1244_A, relation = formalizes, coverage = exact, quote = "a loss on section 1244 stock issued to such individual or to a partnership")
rule PartnershipOrdinaryLossJointWithinRule(p: Person, partnership: Person, t: Transaction, y: TaxableYear, a: Asset, corp: Corporation, amount: Money) defeasible {
    label en official "section 1244(a),(b)(2): a partner's share within the $100,000 joint-return limit";
    when not_known(is_trust_or_estate_1244(p));
    when stock_issued_to_partnership_1244(a, partnership, corp);
    when section_1244_stock(a, corp);
    when partner_share_of_partnership_loss_1244(p, partnership, t, amount);
    when us.irc.core::year_of(p, y);
    when joint_return_filed_1244(p, y);
    when amount <= Section1244JointReturnLossLimit;
    then section_1244_ordinary_loss_via_partnership(p, t, amount);
}
rule PartnershipOrdinaryLossJointCappedRule(p: Person, partnership: Person, t: Transaction, y: TaxableYear, a: Asset, corp: Corporation, amount: Money) defeasible {
    label en official "section 1244(b)(2): a partner's share above the joint-return limit is ordinary only up to it";
    when not_known(is_trust_or_estate_1244(p));
    when stock_issued_to_partnership_1244(a, partnership, corp);
    when section_1244_stock(a, corp);
    when partner_share_of_partnership_loss_1244(p, partnership, t, amount);
    when us.irc.core::year_of(p, y);
    when joint_return_filed_1244(p, y);
    when amount > Section1244JointReturnLossLimit;
    then section_1244_ordinary_loss_via_partnership(p, t, Section1244JointReturnLossLimit);
}
rule PartnershipOrdinaryLossIndividualWithinRule(p: Person, partnership: Person, t: Transaction, y: TaxableYear, a: Asset, corp: Corporation, amount: Money) defeasible {
    label en official "section 1244(a),(b)(1): a partner's share within the $50,000 individual limit";
    when not_known(is_trust_or_estate_1244(p));
    when stock_issued_to_partnership_1244(a, partnership, corp);
    when section_1244_stock(a, corp);
    when partner_share_of_partnership_loss_1244(p, partnership, t, amount);
    when us.irc.core::year_of(p, y);
    when not_known(joint_return_filed_1244(p, y));
    when amount <= Section1244IndividualLossLimit;
    then section_1244_ordinary_loss_via_partnership(p, t, amount);
}
rule PartnershipOrdinaryLossIndividualCappedRule(p: Person, partnership: Person, t: Transaction, y: TaxableYear, a: Asset, corp: Corporation, amount: Money) defeasible {
    label en official "section 1244(b)(1): a partner's share above the individual limit is ordinary only up to it";
    when not_known(is_trust_or_estate_1244(p));
    when stock_issued_to_partnership_1244(a, partnership, corp);
    when section_1244_stock(a, corp);
    when partner_share_of_partnership_loss_1244(p, partnership, t, amount);
    when us.irc.core::year_of(p, y);
    when not_known(joint_return_filed_1244(p, y));
    when amount > Section1244IndividualLossLimit;
    then section_1244_ordinary_loss_via_partnership(p, t, Section1244IndividualLossLimit);
}
