// Stage 2c (IRC-07, A05). Pub. L. 119-21 (July 4, 2025) changes owned by this
// package, as revisions carried over the 2024-Edition base:
//   * new section 1062 (SEC. 70437): installment payment of the tax on gain from
//     the sale of qualified farmland property to a qualified farmer, for sales
//     or exchanges in taxable years beginning after the enactment date; the
//     2024 section 1062 (vessel cross-references) is redesignated section 1063
//     (its text is unchanged and is classified in the coverage rows);
//   * section 1400Z-1 (SEC. 70421(a)-(b)): decennial designations, the new
//     low-income community test, the 10-year designation period, repeal of the
//     contiguous-tract rule and of the Puerto Rico deeming rule;
//   * section 1400Z-2 (SEC. 70421(c)): the permanent rolling deferral for
//     amounts invested after December 31, 2026 — module 22.
// Anchors point at `us.irc.temporal` fragments (`derives_from`); the base text
// stays the 2024 Edition (Д-02 of DECISIONS.md).

use self::{
    Asset,
    IRC_S1400Z_1_A,
    IRC_S1400Z_1_B,
    IRC_S1400Z_1_C,
    IRC_S1400Z_1_D,
    IRC_S1400Z_1_E,
    Person,
    TaxableYear,
    Transaction,
    determination_period_extended_derived_1400Z1b2,
    succeeding_taxable_year,
};

pub const Pl11921EnactmentDate: Date = @2025-07-04 {
    label en official "the date of enactment of Pub. L. 119-21 (July 4, 2025)";
};

// =============================================================================
// New §1062 (SEC. 70437): farmland sale to a qualified farmer — installments
// =============================================================================

pub relation farmland_sale_or_exchange(t: Transaction, seller: Person, buyer: Person, prop: Asset, sold_on: Date, y: TaxableYear) kind empirical {
    label en official "section 1062(a): a sale or exchange of property by the taxpayer to a person, in the taxable year y, on the date";
}
pub relation real_property_in_united_states(prop: Asset) kind empirical {
    label en official "section 1062(d)(2)(A): the property is real property located in the United States";
}
pub relation used_or_leased_as_farm_substantially_all_of_ten_years(prop: Asset, seller: Person) kind empirical {
    label en official "section 1062(d)(2)(A)(i): the property has been used by the taxpayer as a farm for farming purposes, or leased by the taxpayer to a qualified farmer for farming purposes, during substantially all of the 10-year period ending on the date of the sale (an evaluative element, DECISION-0194: adjudicated fact; attribution through a partnership or S corporation is folded into the fact)";
}
pub relation subject_to_farming_only_covenant_for_ten_years(prop: Asset, sold_on: Date) kind empirical {
    label en official "section 1062(d)(2)(A)(ii): the property is subject to a covenant or other legally enforceable restriction which prohibits use other than as a farm for farming purposes for any period before the date 10 years after the sale";
}
pub relation covenant_runs_until(prop: Asset, until: Date) kind empirical {
    label en unofficial "the last date before which the covenant prohibits non-farm use";
}
pub relation qualified_farmland_property(prop: Asset, sold_on: Date) kind institutional {
    label en official "section 1062(d)(2): qualified farmland property";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "the term ‘qualified farmland property’ means real property located in the United States—")
rule QualifiedFarmlandPropertyRule(prop: Asset, seller: Person, sold_on: Date, until: Date) defeasible {
    label en official "section 1062(d)(2)(A)(i)-(ii): US real property farmed or leased for farming for substantially all of 10 years, covenanted to farm use until at least 10 years after the sale";
    when real_property_in_united_states(prop);
    when used_or_leased_as_farm_substantially_all_of_ten_years(prop, seller);
    when subject_to_farming_only_covenant_for_ten_years(prop, sold_on);
    when covenant_runs_until(prop, until);
    when until >= add_calendar_period(sold_on, 10 calendar_year);
    then qualified_farmland_property(prop, sold_on);
}
pub relation individual_actively_engaged_in_farming(buyer: Person) kind empirical {
    label en official "section 1062(d)(3): an individual who is actively engaged in farming within the meaning of section 1001(b) and (c) of the Food Security Act of 1986 (7 U.S.C. 1308-1(b), (c)) (external norm; asserted)";
}
pub relation individual_person(buyer: Person) kind empirical {
    label en official "the buyer is an individual";
}
pub relation qualified_farmer(buyer: Person) kind institutional {
    label en official "section 1062(d)(3): a qualified farmer";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = exact, quote = "The term ‘qualified farmer’ means any individual who is actively engaged in farming")
rule QualifiedFarmerRule(buyer: Person) defeasible {
    label en official "section 1062(d)(3)";
    when individual_person(buyer);
    when individual_actively_engaged_in_farming(buyer);
    then qualified_farmer(buyer);
}
pub relation sale_year_begins_on(y: TaxableYear, on: Date) kind institutional {
    label en unofficial "the first day of the taxable year, read from us.irc.core::begins";
}
rule SaleYearBeginsOnRule(y: TaxableYear, on: Date) defeasible {
    label en unofficial "helper reading the core begins relation";
    when us.irc.core::begins(y, on);
    then sale_year_begins_on(y, on);
}
pub relation section_1062_applies_to_sale_year(y: TaxableYear) kind institutional {
    label en official "SEC. 70437(c): the amendments apply to sales or exchanges in taxable years beginning after the date of enactment (July 4, 2025)";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = exact, quote = "shall apply to sales or exchanges in taxable years beginning after the date of the enactment of this Act.")
rule Section1062EffectiveDateRule(y: TaxableYear, on: Date) defeasible {
    label en official "SEC. 70437(c): taxable years beginning after 2025-07-04";
    when sale_year_begins_on(y, on);
    when on > Pl11921EnactmentDate;
    then section_1062_applies_to_sale_year(y);
}
pub relation elects_1062(t: Transaction, p: Person) kind empirical {
    label en official "section 1062(a): the taxpayer elects to pay the applicable net tax liability in 4 equal installments";
}
pub relation election_1062_made_by_owner_not_entity(t: Transaction) kind empirical {
    label en official "section 1062(c)(2): for a sale by a partnership or S corporation, the election is made at the partner or shareholder level (this fact is true when the election is made by the owner)";
}
pub relation sale_by_partnership_or_s_corporation(t: Transaction) kind empirical {
    label en official "section 1062(c)(2): the sale or exchange is by a partnership or S corporation";
}
pub relation election_1062_filed_on(t: Transaction, on: Date) kind empirical {
    label en official "the date the section 1062 election is made";
}
pub relation return_due_date_for_sale_year(t: Transaction, due: Date) kind empirical {
    label en official "section 1062(c)(1): the due date for the return of tax for the taxable year of the sale or exchange";
}
pub relation election_1062_valid(t: Transaction, p: Person) kind institutional {
    label en official "section 1062(a), (c): the election is available (qualified farmland property sold to a qualified farmer in an eligible year) and timely";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "Any election under subsection (a) shall be made not later than the due date for the return of tax for the taxable year described in subsection (a).")
rule Election1062ValidRule(t: Transaction, seller: Person, buyer: Person, prop: Asset, sold_on: Date, y: TaxableYear, filed: Date, due: Date) defeasible {
    label en official "section 1062(a), (c)(1), (c)(2), (d)";
    when farmland_sale_or_exchange(t, seller, buyer, prop, sold_on, y);
    when qualified_farmland_property(prop, sold_on);
    when qualified_farmer(buyer);
    when section_1062_applies_to_sale_year(y);
    when election_1062_filed_on(t, filed);
    when return_due_date_for_sale_year(t, due);
    when filed <= due;
    when not_known(sale_by_partnership_or_s_corporation(t));
    then election_1062_valid(t, seller);
}
rule Election1062ValidPassThroughOwnerRule(t: Transaction, seller: Person, buyer: Person, prop: Asset, sold_on: Date, y: TaxableYear, filed: Date, due: Date) defeasible {
    label en official "section 1062(c)(2): for a pass-through seller the election is valid only when made by the partner or shareholder";
    when farmland_sale_or_exchange(t, seller, buyer, prop, sold_on, y);
    when qualified_farmland_property(prop, sold_on);
    when qualified_farmer(buyer);
    when section_1062_applies_to_sale_year(y);
    when election_1062_filed_on(t, filed);
    when return_due_date_for_sale_year(t, due);
    when filed <= due;
    when sale_by_partnership_or_s_corporation(t);
    when election_1062_made_by_owner_not_entity(t);
    then election_1062_valid(t, seller);
}
pub relation installment_regime_in_effect_1062(t: Transaction, p: Person) kind institutional {
    label en official "section 1062(a): the applicable net tax liability is payable in 4 equal installments";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "at the election of the taxpayer, the portion of the net income tax of such taxpayer for the taxable year of the sale or exchange which is equal to the applicable net tax liability shall be paid in 4 equal installments.")
rule Section1062InstallmentElectionPower(t: Transaction, p: Person) strict {
    label en official "section 1062(a): the taxpayer's election moves the applicable net tax liability into 4 equal installments";
    when elects_1062(t, p);
    then power Section1062InstallmentElection {
        holder p;
        over t;
        exercise elects_1062(t, p);
        valid_when election_1062_valid(t, p);
        effect create(installment_regime_in_effect_1062(t, p));
        window [@2025-07-05, infinity);
    };
}

// (d)(1): applicable net tax liability
pub relation regular_tax_liability_with_gain(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1062(d)(1)(B): the regular tax liability for the taxable year (owner: income-individual; asserted)";
}
pub relation credits_subparts_a_b_d_with_gain(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1062(d)(1)(B): credits allowed under subparts A, B and D of part IV of subchapter A for the year";
}
pub relation regular_tax_liability_without_gain(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1062(d)(1)(A)(ii): the regular tax liability determined without regard to any gain recognized from the sale or exchange of the property";
}
pub relation credits_subparts_a_b_d_without_gain(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1062(d)(1)(A)(ii): the credits determined without regard to the gain";
}
pub relation net_income_tax_with_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1062(d)(1)(B): the net income tax: the regular tax liability reduced by the credits (not below zero, INTERPRETATION: a negative net tax has no meaning as a liability)";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "The term ‘net income tax’ means the regular tax liability reduced by the credits allowed under subparts A, B, and D of part IV of subchapter A.")
rule NetIncomeTaxWithGainRule(p: Person, y: TaxableYear, tax: Money, credits: Money) defeasible {
    label en official "section 1062(d)(1)(B)";
    when regular_tax_liability_with_gain(p, y, tax);
    when credits_subparts_a_b_d_with_gain(p, y, credits);
    when tax > credits;
    then net_income_tax_with_gain(p, y, tax - credits);
}
rule NetIncomeTaxWithGainZeroRule(p: Person, y: TaxableYear, tax: Money, credits: Money) defeasible {
    label en official "section 1062(d)(1)(B): credits at least the tax leave no net income tax";
    when regular_tax_liability_with_gain(p, y, tax);
    when credits_subparts_a_b_d_with_gain(p, y, credits);
    when tax <= credits;
    then net_income_tax_with_gain(p, y, 0.00 USD);
}
pub relation net_income_tax_without_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1062(d)(1)(A)(ii): the net income tax determined without regard to the gain";
}
rule NetIncomeTaxWithoutGainRule(p: Person, y: TaxableYear, tax: Money, credits: Money) defeasible {
    label en official "section 1062(d)(1)(A)(ii), (B)";
    when regular_tax_liability_without_gain(p, y, tax);
    when credits_subparts_a_b_d_without_gain(p, y, credits);
    when tax > credits;
    then net_income_tax_without_gain(p, y, tax - credits);
}
rule NetIncomeTaxWithoutGainZeroRule(p: Person, y: TaxableYear, tax: Money, credits: Money) defeasible {
    label en official "section 1062(d)(1)(A)(ii), (B): zero floor";
    when regular_tax_liability_without_gain(p, y, tax);
    when credits_subparts_a_b_d_without_gain(p, y, credits);
    when tax <= credits;
    then net_income_tax_without_gain(p, y, 0.00 USD);
}
pub relation applicable_net_tax_liability_1062(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1062(d)(1)(A): the excess (if any) of the net income tax over the net income tax determined without regard to the gain";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "The applicable net tax liability with respect to the sale or exchange of any property described in subsection (a) is the excess (if any) of—")
rule ApplicableNetTaxLiabilityRule(p: Person, y: TaxableYear, with_gain: Money, without_gain: Money) defeasible {
    label en official "section 1062(d)(1)(A)";
    when net_income_tax_with_gain(p, y, with_gain);
    when net_income_tax_without_gain(p, y, without_gain);
    when with_gain > without_gain;
    then applicable_net_tax_liability_1062(p, y, with_gain - without_gain);
}
rule ApplicableNetTaxLiabilityZeroRule(p: Person, y: TaxableYear, with_gain: Money, without_gain: Money) defeasible {
    label en official "section 1062(d)(1)(A): no excess, no liability";
    when net_income_tax_with_gain(p, y, with_gain);
    when net_income_tax_without_gain(p, y, without_gain);
    when with_gain <= without_gain;
    then applicable_net_tax_liability_1062(p, y, 0.00 USD);
}

// (b)(1): the four installments and their due dates
pub relation return_due_date_without_extension(p: Person, y: TaxableYear, due: Date) kind empirical {
    label en official "section 1062(b)(1): the due date (determined without regard to any extension of time for filing) for the return of tax for the taxable year";
}
pub relation installment_due(t: Transaction, p: Person, n: Integer, due: Date, amount: Money) kind institutional {
    label en official "section 1062(a), (b)(1): installment n of 4 equal installments, due on the return due date (without extensions) of the sale year and of each of the three following taxable years";
}
pub const Section1062InstallmentCount: Integer = 4 {
    label en official "4 equal installments (section 1062(a))";
};
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "the first installment shall be paid on the due date (determined without regard to any extension of time for filing the return) for the return of tax for the taxable year in which the sale or exchange occurs")
rule Installment1Rule(t: Transaction, p: Person, buyer: Person, prop: Asset, sold_on: Date, y0: TaxableYear, due: Date, total: Money) defeasible {
    label en official "section 1062(b)(1): first installment (cents HALF_UP, JUDGMENT CALL: the statute says equal and names no rounding; a rounding remainder is not reassigned)";
    when installment_regime_in_effect_1062(t, p);
    when farmland_sale_or_exchange(t, p, buyer, prop, sold_on, y0);
    when return_due_date_without_extension(p, y0, due);
    when applicable_net_tax_liability_1062(p, y0, total);
    then installment_due(t, p, 1, due, round(total * 25 percent, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "each succeeding installment shall be paid on the due date (as so determined) for the return of tax for the taxable year following the taxable year with respect to which the preceding installment was made.")
rule Installment2Rule(t: Transaction, p: Person, buyer: Person, prop: Asset, sold_on: Date, y0: TaxableYear, y1: TaxableYear, due: Date, total: Money) defeasible {
    label en official "section 1062(b)(1): second installment, due for the year following the sale year";
    when installment_regime_in_effect_1062(t, p);
    when farmland_sale_or_exchange(t, p, buyer, prop, sold_on, y0);
    when succeeding_taxable_year(y0, y1);
    when return_due_date_without_extension(p, y1, due);
    when applicable_net_tax_liability_1062(p, y0, total);
    then installment_due(t, p, 2, due, round(total * 25 percent, 2, "HALF_UP"));
}
rule Installment3Rule(t: Transaction, p: Person, buyer: Person, prop: Asset, sold_on: Date, y0: TaxableYear, y1: TaxableYear, y2: TaxableYear, due: Date, total: Money) defeasible {
    label en official "section 1062(b)(1): third installment";
    when installment_regime_in_effect_1062(t, p);
    when farmland_sale_or_exchange(t, p, buyer, prop, sold_on, y0);
    when succeeding_taxable_year(y0, y1);
    when succeeding_taxable_year(y1, y2);
    when return_due_date_without_extension(p, y2, due);
    when applicable_net_tax_liability_1062(p, y0, total);
    then installment_due(t, p, 3, due, round(total * 25 percent, 2, "HALF_UP"));
}
rule Installment4Rule(t: Transaction, p: Person, buyer: Person, prop: Asset, sold_on: Date, y0: TaxableYear, y1: TaxableYear, y2: TaxableYear, y3: TaxableYear, due: Date, total: Money) defeasible {
    label en official "section 1062(b)(1): fourth installment";
    when installment_regime_in_effect_1062(t, p);
    when farmland_sale_or_exchange(t, p, buyer, prop, sold_on, y0);
    when succeeding_taxable_year(y0, y1);
    when succeeding_taxable_year(y1, y2);
    when succeeding_taxable_year(y2, y3);
    when return_due_date_without_extension(p, y3, due);
    when applicable_net_tax_liability_1062(p, y0, total);
    then installment_due(t, p, 4, due, round(total * 25 percent, 2, "HALF_UP"));
}
pub relation installment_paid_1062(t: Transaction, p: Person, n: Integer) kind empirical {
    label en official "the taxpayer paid installment n";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "shall be paid in 4 equal installments.")
rule Installment1PaymentDuty(t: Transaction, p: Person, due: Date, amount: Money) defeasible {
    label en official "section 1062(a), (b)(1): the taxpayer shall pay installment 1 by its due date (achievement goal with the statutory window)";
    when installment_due(t, p, 1, due, amount);
    then duty Section1062Installment1DutyPosition {
        bearer p;
        beneficiary p;
        goal achievement {
            condition installment_paid_1062(t, p, 1);
            window [-infinity, due];
        }
    };
}
rule Installment2PaymentDuty(t: Transaction, p: Person, due: Date, amount: Money) defeasible {
    label en official "section 1062(b)(1): installment 2";
    when installment_due(t, p, 2, due, amount);
    then duty Section1062Installment2DutyPosition {
        bearer p;
        beneficiary p;
        goal achievement {
            condition installment_paid_1062(t, p, 2);
            window [-infinity, due];
        }
    };
}
rule Installment3PaymentDuty(t: Transaction, p: Person, due: Date, amount: Money) defeasible {
    label en official "section 1062(b)(1): installment 3";
    when installment_due(t, p, 3, due, amount);
    then duty Section1062Installment3DutyPosition {
        bearer p;
        beneficiary p;
        goal achievement {
            condition installment_paid_1062(t, p, 3);
            window [-infinity, due];
        }
    };
}
rule Installment4PaymentDuty(t: Transaction, p: Person, due: Date, amount: Money) defeasible {
    label en official "section 1062(b)(1): installment 4";
    when installment_due(t, p, 4, due, amount);
    then duty Section1062Installment4DutyPosition {
        bearer p;
        beneficiary p;
        goal achievement {
            condition installment_paid_1062(t, p, 4);
            window [-infinity, due];
        }
    };
}

// (b)(2): acceleration
pub relation addition_to_tax_for_late_installment_on(t: Transaction, p: Person, on: Date) kind empirical {
    label en official "section 1062(b)(2)(A): there is an addition to tax for failure to timely pay an installment, at the date of the failure";
}
pub relation taxpayer_died_and_return_due_date_for_death_year(t: Transaction, p: Person, due: Date) kind empirical {
    label en official "section 1062(b)(2)(B): the individual dies; the due date for the return of tax for the taxable year in which the taxpayer dies";
}
pub relation liquidation_sale_or_cessation_event_on(t: Transaction, p: Person, on: Date) kind empirical {
    label en official "section 1062(b)(2)(C): a liquidation or sale of substantially all the assets (including in a title 11 or similar case), a cessation of business (C corporation), or any similar circumstance, at the date of the event (the day before the petition in a title 11 case)";
}
pub relation taxpayer_is_c_corporation_trust_or_estate(p: Person) kind empirical {
    label en official "section 1062(b)(2)(C): the taxpayer is a C corporation, trust or estate";
}
pub relation buyer_of_substantially_all_assets_agreed_with_secretary_to_assume(t: Transaction) kind empirical {
    label en official "section 1062(b)(2)(C), last sentence: a buyer of substantially all the assets enters into an agreement with the Secretary under which it is liable for the remaining installments";
}
pub relation remaining_installments_due_on(t: Transaction, p: Person, on: Date) kind institutional {
    label en official "section 1062(b)(2): the unpaid portion of all remaining installments is due on the date";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "then the unpaid portion of all remaining installments shall be due on the date of such failure.")
rule AccelerationOnLatePaymentRule(t: Transaction, p: Person, on: Date) defeasible {
    label en official "section 1062(b)(2)(A)";
    when installment_regime_in_effect_1062(t, p);
    when addition_to_tax_for_late_installment_on(t, p, on);
    then remaining_installments_due_on(t, p, on);
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "then the unpaid portion of all remaining installment shall be paid on the due date for the return of tax for the taxable year in which the taxpayer dies.")
rule AccelerationOnDeathRule(t: Transaction, p: Person, due: Date) defeasible {
    label en official "section 1062(b)(2)(B): an individual's death";
    when installment_regime_in_effect_1062(t, p);
    when individual_person(p);
    when taxpayer_died_and_return_due_date_for_death_year(t, p, due);
    then remaining_installments_due_on(t, p, due);
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = partial, quote = "then the unpaid portion of all remaining installments shall be due on the date of such event")
rule AccelerationOnLiquidationRule(t: Transaction, p: Person, on: Date) defeasible {
    label en official "section 1062(b)(2)(C): a C corporation, trust or estate; the assumption agreement of the buyer switches acceleration off";
    when installment_regime_in_effect_1062(t, p);
    when taxpayer_is_c_corporation_trust_or_estate(p);
    when liquidation_sale_or_cessation_event_on(t, p, on);
    when not_known(buyer_of_substantially_all_assets_agreed_with_secretary_to_assume(t));
    then remaining_installments_due_on(t, p, on);
}
pub relation covenant_copy_included_with_return_1062e(t: Transaction, p: Person) kind empirical {
    label en official "section 1062(e): the taxpayer includes with the return for the year of the sale a copy of the covenant or other legally enforceable restriction";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = exact, quote = "A taxpayer making an election under subsection (a) shall include with the return for the taxable year of the sale or exchange described in subsection (a) a copy of the covenant or other legally enforceable restriction described in subsection (d)(2)(A)(ii).")
rule CovenantCopyReturnDuty(t: Transaction, p: Person, due: Date) defeasible {
    label en official "section 1062(e): a duty of the electing taxpayer; the window closes at the return (due date without extension is used, INTERPRETATION: the text names the return, not its due date)";
    when installment_regime_in_effect_1062(t, p);
    when return_due_date_for_sale_year(t, due);
    then duty Section1062CovenantCopyDutyPosition {
        bearer p;
        beneficiary p;
        goal achievement {
            condition covenant_copy_included_with_return_1062e(t, p);
            window [-infinity, due];
        }
    };
}

// =============================================================================
// §1400Z-1: designation of qualified opportunity zones (2024 text, with the
// SEC. 70421(a)-(b) revisions for designations after July 4, 2025)
// =============================================================================

pub entity CensusTract : Asset {
    label en official "a population census tract (section 1400Z-1(a))";
}
pub entity StateOrPossession {
    label en official "a State, including any possession of the United States (section 1400Z-1(c)(3))";
}
pub relation tract_in_state(tract: CensusTract, state: StateOrPossession) kind empirical {
    label en unofficial "the tract is located in the State";
}
pub relation tract_certified_and_designated_on(tract: CensusTract, on: Date) kind empirical {
    label en official "section 1400Z-1(b)(1)(B): the Secretary certifies the nomination and designates the tract on the date";
}
pub relation designation_governed_by_pl119_21(tract: CensusTract) kind institutional {
    label en official "SEC. 70421(a)(5), (b)(4): the amendments apply to areas designated after the date of enactment (July 4, 2025)";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "The amendments made by this subsection shall apply to areas designated under section 1400Z-1 of the Internal Revenue Code of 1986 after the date of the enactment of this Act.")
rule DesignationGovernedByPlRule(tract: CensusTract, on: Date) defeasible {
    label en official "SEC. 70421(b)(4): designation dated after 2025-07-04";
    when tract_certified_and_designated_on(tract, on);
    when on > Pl11921EnactmentDate;
    then designation_governed_by_pl119_21(tract);
}

// low-income community: 2024 text refers to section 45D(e); the PL text sets its own test
pub relation low_income_community_45d(tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(c)(1) (2024 text): a low-income community within the meaning of section 45D(e) (owner: credits; asserted)";
}
pub relation tract_median_family_income(tract: CensusTract, amount: Money) kind empirical {
    label en official "the median family income of the tract";
}
pub relation tract_in_metropolitan_area(tract: CensusTract) kind empirical {
    label en official "the tract is located within a metropolitan area";
}
pub relation statewide_median_family_income(state: StateOrPossession, amount: Money) kind empirical {
    label en official "the statewide median family income";
}
pub relation metropolitan_area_median_family_income(tract: CensusTract, amount: Money) kind empirical {
    label en official "the median family income of the metropolitan area in which the tract is located";
}
pub relation tract_poverty_rate(tract: CensusTract, rate: Decimal) kind empirical {
    label en official "the poverty rate of the tract as a fraction (0.20 is 20 percent)";
}
pub relation low_income_community_1400z1(tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(c)(1): a low-income community";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = partial, quote = "(i) in the case of a population census tract not located within a metropolitan area, does not exceed 70 percent of the statewide median family income, or")
rule LowIncomeNonMetroRule(tract: CensusTract, state: StateOrPossession, income: Money, statewide: Money) defeasible {
    label en official "section 1400Z-1(c)(1)(A)(i) (as amended): a non-metropolitan tract at or below 70 percent of the statewide median";
    when designation_governed_by_pl119_21(tract);
    when tract_in_state(tract, state);
    when tract_median_family_income(tract, income);
    when statewide_median_family_income(state, statewide);
    when not_known(tract_in_metropolitan_area(tract));
    when income <= statewide * 70 percent;
    then low_income_community_1400z1(tract);
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = partial, quote = "(ii) in the case of a population census tract located within a metropolitan area, does not exceed 70 percent of the metropolitan area median family income, or")
rule LowIncomeMetroRule(tract: CensusTract, income: Money, metro: Money) defeasible {
    label en official "section 1400Z-1(c)(1)(A)(ii) (as amended): a metropolitan tract at or below 70 percent of the metropolitan median";
    when designation_governed_by_pl119_21(tract);
    when tract_median_family_income(tract, income);
    when metropolitan_area_median_family_income(tract, metro);
    when tract_in_metropolitan_area(tract);
    when income <= metro * 70 percent;
    then low_income_community_1400z1(tract);
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = partial, quote = "“(B) such population census tract—")
rule LowIncomePovertyNonMetroRule(tract: CensusTract, state: StateOrPossession, income: Money, statewide: Money, rate: Decimal) defeasible {
    label en official "section 1400Z-1(c)(1)(B) (as amended): poverty rate at least 20 percent and income at or below 125 percent of the statewide median (non-metropolitan)";
    when designation_governed_by_pl119_21(tract);
    when tract_in_state(tract, state);
    when tract_poverty_rate(tract, rate);
    when tract_median_family_income(tract, income);
    when statewide_median_family_income(state, statewide);
    when not_known(tract_in_metropolitan_area(tract));
    when rate >= 0.20;
    when income <= statewide * 125 percent;
    then low_income_community_1400z1(tract);
}
rule LowIncomePovertyMetroRule(tract: CensusTract, income: Money, metro: Money, rate: Decimal) defeasible {
    label en official "section 1400Z-1(c)(1)(B) (as amended): poverty rate at least 20 percent and income at or below 125 percent of the metropolitan median";
    when designation_governed_by_pl119_21(tract);
    when tract_poverty_rate(tract, rate);
    when tract_median_family_income(tract, income);
    when metropolitan_area_median_family_income(tract, metro);
    when tract_in_metropolitan_area(tract);
    when rate >= 0.20;
    when income <= metro * 125 percent;
    then low_income_community_1400z1(tract);
}
@source(IRC_S1400Z_1_C, relation = formalizes, coverage = exact, quote = "The term \"low-income community\" has the same meaning as when used in section 45D(e).")
rule LowIncomeCommunityBaseTextRule(tract: CensusTract) defeasible {
    label en official "section 1400Z-1(c)(1) (2024 text): the section 45D(e) meaning, for designations on or before July 4, 2025";
    when low_income_community_45d(tract);
    when not_known(designation_governed_by_pl119_21(tract));
    then low_income_community_1400z1(tract);
}

// (b): the nomination and designation powers
pub relation state_chief_executive_officer(state: StateOrPossession, ceo: Person) kind empirical {
    label en official "the chief executive officer of the State in which the tract is located";
}
pub relation determination_period_start(tract: CensusTract, on: Date) kind empirical {
    label en official "section 1400Z-1(c)(2)(B): the first day of the determination period (the TCJA enactment date, December 22, 2017; after Pub. L. 119-21 the decennial determination date)";
}
pub relation determination_period_extended(tract: CensusTract) kind empirical {
    label en official "section 1400Z-1(b)(2): the State's chief executive officer requested, and the Secretary granted, an extension of the determination period by 30 days";
}
pub relation determination_period_end(tract: CensusTract, on: Date) kind institutional {
    label en official "section 1400Z-1(c)(2)(B): the last day of the 90-day determination period (120 days if extended)";
}
@source(IRC_S1400Z_1_C, relation = formalizes, coverage = partial, quote = "The term \"determination period\" means the 90-day period beginning on the date of the enactment of the Tax Cuts and Jobs Act, as extended under subsection (b)(2).")
rule DeterminationPeriodEndRule(tract: CensusTract, start: Date) defeasible {
    label en official "section 1400Z-1(c)(2)(B): 90 days, counted from the start day";
    when determination_period_start(tract, start);
    when not_known(determination_period_extended(tract));
    when not_known(determination_period_extended_derived_1400Z1b2(tract));
    then determination_period_end(tract, add_calendar_period(start, 90 calendar_day));
}
rule DeterminationPeriodEndExtendedRule(tract: CensusTract, start: Date) defeasible {
    label en official "section 1400Z-1(b)(2), (c)(2)(B): 90 days plus a 30-day extension";
    when determination_period_start(tract, start);
    when determination_period_extended(tract);
    then determination_period_end(tract, add_calendar_period(start, 120 calendar_day));
}
pub relation nominates_tract_for_designation(ceo: Person, tract: CensusTract) kind empirical {
    label en official "section 1400Z-1(b)(1)(A)(i): the chief executive officer of the State nominates the tract for designation as a qualified opportunity zone";
}
pub relation nomination_notified_to_secretary_in_writing_on(tract: CensusTract, on: Date) kind empirical {
    label en official "section 1400Z-1(b)(1)(A)(ii): the officer notifies the Secretary in writing of the nomination (date of receipt starts the consideration period)";
}
pub relation nomination_timely_and_valid(ceo: Person, tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(b)(1)(A): the nominated tract is a low-income community, the officer is the State's chief executive, and the notice is given not later than the end of the determination period";
}
@source(IRC_S1400Z_1_B, relation = formalizes, coverage = partial, quote = "(A) not later than the end of the determination period, the chief executive officer of the State in which the tract is located—")
rule NominationValidRule(ceo: Person, tract: CensusTract, state: StateOrPossession, notified: Date, end: Date) defeasible {
    label en official "section 1400Z-1(b)(1)(A)";
    when tract_in_state(tract, state);
    when state_chief_executive_officer(state, ceo);
    when low_income_community_1400z1(tract);
    when nomination_notified_to_secretary_in_writing_on(tract, notified);
    when determination_period_end(tract, end);
    when notified <= end;
    then nomination_timely_and_valid(ceo, tract);
}
pub relation tract_nominated_1400z1(tract: CensusTract) kind institutional {
    label en official "the tract has been validly nominated";
}
@source(IRC_S1400Z_1_B, relation = formalizes, coverage = partial, quote = "(i) nominates the tract for designation as a qualified opportunity zone, and")
rule Section1400z1NominationPower(ceo: Person, tract: CensusTract) strict {
    label en official "section 1400Z-1(b)(1)(A): the State's chief executive officer nominates tracts within the determination period";
    when nominates_tract_for_designation(ceo, tract);
    then power Section1400z1Nomination {
        holder ceo;
        over tract;
        exercise nominates_tract_for_designation(ceo, tract);
        valid_when nomination_timely_and_valid(ceo, tract);
        effect create(tract_nominated_1400z1(tract));
        window [@2017-12-22, infinity);
    };
}
pub relation consideration_period_extended(tract: CensusTract) kind empirical {
    label en official "section 1400Z-1(b)(2): the consideration period is extended by 30 days on the State's request";
}
pub relation consideration_period_end(tract: CensusTract, on: Date) kind institutional {
    label en official "section 1400Z-1(c)(2)(A): the last day of the 30-day consideration period beginning on the date the Secretary receives the notice (60 days if extended)";
}
@source(IRC_S1400Z_1_C, relation = formalizes, coverage = partial, quote = "The term \"consideration period\" means the 30-day period beginning on the date on which the Secretary receives notice under subsection (b)(1)(A)(ii), as extended under subsection (b)(2).")
rule ConsiderationPeriodEndRule(tract: CensusTract, notified: Date) defeasible {
    label en official "section 1400Z-1(c)(2)(A): 30 days from receipt of the notice";
    when nomination_notified_to_secretary_in_writing_on(tract, notified);
    when not_known(consideration_period_extended(tract));
    then consideration_period_end(tract, add_calendar_period(notified, 30 calendar_day));
}
rule ConsiderationPeriodEndExtendedRule(tract: CensusTract, notified: Date) defeasible {
    label en official "section 1400Z-1(b)(2), (c)(2)(A): 30 days plus a 30-day extension";
    when nomination_notified_to_secretary_in_writing_on(tract, notified);
    when consideration_period_extended(tract);
    then consideration_period_end(tract, add_calendar_period(notified, 60 calendar_day));
}
pub relation secretary_certifies_and_designates(tract: CensusTract) kind empirical {
    label en official "section 1400Z-1(b)(1)(B): the Secretary certifies the nomination and designates the tract as a qualified opportunity zone";
}
pub relation designation_within_consideration_period(tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(b)(1)(B): the certification and designation occur before the end of the consideration period";
}
@source(IRC_S1400Z_1_B, relation = formalizes, coverage = partial, quote = "(B) the Secretary certifies such nomination and designates such tract as a qualified opportunity zone before the end of the consideration period.")
rule DesignationWithinConsiderationPeriodRule(tract: CensusTract, on: Date, end: Date) defeasible {
    label en official "section 1400Z-1(b)(1)(B)";
    when tract_certified_and_designated_on(tract, on);
    when consideration_period_end(tract, end);
    when on < end;
    then designation_within_consideration_period(tract);
}
pub relation designated_qualified_opportunity_zone(tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(a), (b)(1): the tract is designated as a qualified opportunity zone";
}
rule Section1400z1DesignationPower(tract: CensusTract) strict {
    label en official "section 1400Z-1(b)(1)(B): the Secretary's certification and designation of a validly nominated tract before the end of the consideration period";
    when secretary_certifies_and_designates(tract);
    then power Section1400z1Designation {
        holder us.irc.core::Secretary;
        over tract;
        exercise secretary_certifies_and_designates(tract);
        valid_when designation_ready_1400z1(tract);
        effect create(designated_qualified_opportunity_zone(tract));
        window [@2017-12-22, infinity);
    };
}
relation designation_ready_1400z1(tract: CensusTract) kind institutional {
    label en unofficial "single-atom helper for valid_when (§130.3): validly nominated and designated within the consideration period";
}
rule DesignationReadyRule(tract: CensusTract) defeasible {
    label en official "section 1400Z-1(b)(1)(A)-(B)";
    when tract_nominated_1400z1(tract);
    when designation_within_consideration_period(tract);
    then designation_ready_1400z1(tract);
}
pub relation qualified_opportunity_zone_1400z1(tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(a): a qualified opportunity zone is a low-income community tract designated as such";
}
@source(IRC_S1400Z_1_A, relation = formalizes, coverage = exact, quote = "the term \"qualified opportunity zone\" means a population census tract that is a low-income community that is designated as a qualified opportunity zone.")
rule QualifiedOpportunityZoneRule(tract: CensusTract) defeasible {
    label en official "section 1400Z-1(a)";
    when low_income_community_1400z1(tract);
    when designated_qualified_opportunity_zone(tract);
    then qualified_opportunity_zone_1400z1(tract);
}

// (d): the cap on the number of designations
pub relation designated_tracts_in_state(state: StateOrPossession, n: Integer) kind empirical {
    label en official "the number of population census tracts in the State designated as qualified opportunity zones (during the period, after Pub. L. 119-21)";
}
pub relation low_income_communities_in_state(state: StateOrPossession, n: Integer) kind empirical {
    label en official "the number of low-income communities in the State";
}
pub relation designation_cap_respected(state: StateOrPossession) kind institutional {
    label en official "section 1400Z-1(d): the number of designated tracts does not exceed 25 percent of the low-income communities in the State (a total of 25 where there are fewer than 100)";
}
@source(IRC_S1400Z_1_D, relation = formalizes, coverage = partial, quote = "may not exceed 25 percent of the number of low-income communities in the State.")
rule DesignationCapLargeStateRule(state: StateOrPossession, designated: Integer, communities: Integer) defeasible {
    label en official "section 1400Z-1(d)(1): designated x 4 does not exceed the number of low-income communities";
    when designated_tracts_in_state(state, designated);
    when low_income_communities_in_state(state, communities);
    when communities >= 100;
    when designated * 4 <= communities;
    then designation_cap_respected(state);
}
@source(IRC_S1400Z_1_D, relation = formalizes, coverage = partial, quote = "then a total of 25 of such tracts may be designated as qualified opportunity zones.")
rule DesignationCapSmallStateRule(state: StateOrPossession, designated: Integer, communities: Integer) defeasible {
    label en official "section 1400Z-1(d)(2): a State with fewer than 100 low-income communities may designate 25 tracts";
    when designated_tracts_in_state(state, designated);
    when low_income_communities_in_state(state, communities);
    when communities < 100;
    when designated <= 25;
    then designation_cap_respected(state);
}

// (e) (2024 text): contiguous tracts — repealed for designations after Pub. L. 119-21
pub relation tract_contiguous_with_designated_low_income_zone(tract: CensusTract, zone: CensusTract) kind empirical {
    label en official "section 1400Z-1(e)(1)(A) (2024 text): the tract is contiguous with the low-income community designated as a qualified opportunity zone";
}
pub relation median_family_income_of_tract_and_neighbour(tract: CensusTract, zone: CensusTract, tract_income: Money, zone_income: Money) kind empirical {
    label en official "section 1400Z-1(e)(1)(B) (2024 text): the median family incomes of the tract and of the contiguous low-income community";
}
pub relation contiguous_tract_may_be_designated(tract: CensusTract) kind institutional {
    label en official "section 1400Z-1(e)(1) (2024 text): a tract that is not a low-income community may be designated when contiguous with a designated low-income zone and its median family income does not exceed 125 percent of that zone's";
}
@source(IRC_S1400Z_1_E, relation = formalizes, coverage = partial, quote = "(B) the median family income of the tract does not exceed 125 percent of the median family income of the low-income community with which the tract is contiguous.")
rule ContiguousTractRule(tract: CensusTract, zone: CensusTract, ti: Money, zi: Money) defeasible {
    label en official "section 1400Z-1(e)(1) (2024 text); repealed by SEC. 70421(b)(2) for designations after enactment, so it does not apply to those";
    when tract_contiguous_with_designated_low_income_zone(tract, zone);
    when median_family_income_of_tract_and_neighbour(tract, zone, ti, zi);
    when ti <= zi * 125 percent;
    when not_known(designation_governed_by_pl119_21(tract));
    then contiguous_tract_may_be_designated(tract);
}
pub relation contiguous_designations_in_state_share(state: StateOrPossession, share: Decimal) kind empirical {
    label en official "section 1400Z-1(e)(2) (2024 text): the share of designated tracts in a State designated under paragraph (1) (at most 5 percent)";
}
pub relation contiguous_share_within_limit(state: StateOrPossession) kind institutional {
    label en official "section 1400Z-1(e)(2) (2024 text): not more than 5 percent of designated tracts are contiguous-tract designations";
}
@source(IRC_S1400Z_1_E, relation = formalizes, coverage = exact, quote = "Not more than 5 percent of the population census tracts designated in a State as a qualified opportunity zone may be designated under paragraph (1).")
rule ContiguousShareLimitRule(state: StateOrPossession, share: Decimal) defeasible {
    label en official "section 1400Z-1(e)(2) (2024 text)";
    when contiguous_designations_in_state_share(state, share);
    when share <= 0.05;
    then contiguous_share_within_limit(state);
}

// (e) (as amended): the 10-year designation period from the applicable start date
pub relation applicable_start_date_1400z1(tract: CensusTract, on: Date) kind empirical {
    label en official "section 1400Z-1(e)(2) (as amended): the January 1 following the date on which the zone was certified and designated (case-supplied: the date term is not derived, TECH-GAPS G2321)";
}
pub relation designation_period_end(tract: CensusTract, on: Date) kind institutional {
    label en official "section 1400Z-1(e)(1) (as amended): the designation remains in effect until the day before the date 10 years after the applicable start date";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "ending on the day before the date that is 10 years after the applicable start date.")
rule DesignationPeriodEndRule(tract: CensusTract, start: Date, calendar_before_1: Date) defeasible {
    label en official "section 1400Z-1(e)(1) (as amended)";
    when designation_governed_by_pl119_21(tract);
    when applicable_start_date_1400z1(tract, start)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(start, 10 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then designation_period_end(tract, calendar_before_1);
}
