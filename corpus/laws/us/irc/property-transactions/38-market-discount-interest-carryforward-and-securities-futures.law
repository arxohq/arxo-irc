// Stage 3 (IRC-07, A05). Section 1277(b): the later-year allowance of the interest
// deduction disallowed under section 1277(a) (the election against net interest income,
// the year-of-disposition rule and its nonrecognition variant), and section 1234B
// (securities futures contracts: character, short-term rule, definition).
//
// Method. The running ledger of the disallowed interest expense is an aggregate over
// years (the section 111 subset limit): the balance "as of the close of the preceding
// taxable year, excluding amounts previously taken into account under (b)(1)" is a case
// fact. The same-year amount taken under (b)(1) is subtracted before the (b)(2) rule
// (b)(2)(C). Amounts are Money; the case supplies the interest facts of section 1277(c).

// =============================================================================
// Section 1277(b)(1): election to take disallowed interest into account against net interest income
// =============================================================================

use self::{
    Asset,
    DebtInstrument,
    IRC_S1234B_A,
    IRC_S1234B_B,
    IRC_S1234B_C,
    IRC_S1234B_D,
    IRC_S1277_B,
    Person,
    TaxableYear,
    Transaction,
    net_direct_interest_expense_deduction_disallowed,
};

pub relation interest_paid_on_carrying_debt_1277c1(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1277(c)(1): interest paid or accrued during the taxable year on indebtedness incurred or continued to purchase or carry the bond";
}
pub relation interest_included_in_gross_income_1277c2(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1277(c)(2): the aggregate interest (including original issue discount) includible in gross income for the taxable year with respect to the bond";
}
pub relation disallowed_interest_balance_1277b(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 1277(b)(1)(B), (2)(C), (3): the aggregate disallowed under subsection (a) as of the close of the preceding taxable year, not including amounts previously taken into account under paragraph (1) - a case-supplied running total (section 111 limit)";
}
pub relation elects_deferral_against_net_interest_income_1277b1(bond: DebtInstrument, taxpayer: Person) kind empirical {
    label en official "section 1277(b)(1)(A)(ii): the taxpayer makes an election under this subparagraph with respect to the bond";
}
pub relation net_interest_income_1277b1c(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(b)(1)(C): the excess of the amount under section 1277(c)(2) over the amount under section 1277(c)(1)";
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "the term \"net interest income\" means the excess of the amount determined under paragraph (2) of subsection (c) over the amount determined under paragraph (1) of subsection (c)")
rule NetInterestIncome1277b1cRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, paid: Money, included: Money) strict {
    label en official "section 1277(b)(1)(C): net interest income is the excess of the interest included over the interest paid or accrued";
    when interest_paid_on_carrying_debt_1277c1(bond, taxpayer, y, paid);
    when interest_included_in_gross_income_1277c2(bond, taxpayer, y, included);
    when included > paid;
    then net_interest_income_1277b1c(bond, taxpayer, y, included - paid);
}

pub relation deferral_amount_1277b1(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(b)(1)(A): the disallowed interest expense taken into account in the year, not exceeding the net interest income (zero where there is no election or no net interest income)";
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "to the extent such disallowed interest expense does not exceed the net interest income with respect to such bond")
rule DeferralAmountElectedRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, balance: Money, nii: Money) strict {
    label en official "section 1277(b)(1)(A): with an election and net interest income, the lesser of the disallowed balance and the net interest income";
    when elects_deferral_against_net_interest_income_1277b1(bond, taxpayer);
    when disallowed_interest_balance_1277b(bond, taxpayer, y, balance);
    when net_interest_income_1277b1c(bond, taxpayer, y, nii);
    then deferral_amount_1277b1(bond, taxpayer, y, min(balance, nii));
}
rule DeferralAmountNoElectionRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, balance: Money) strict {
    label en official "section 1277(b)(1)(A)(ii): without the election nothing is taken into account under paragraph (1)";
    when disallowed_interest_balance_1277b(bond, taxpayer, y, balance);
    when not_known(elects_deferral_against_net_interest_income_1277b1(bond, taxpayer));
    then deferral_amount_1277b1(bond, taxpayer, y, 0.00 USD);
}
rule DeferralAmountNoNetInterestIncomeRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, balance: Money, paid: Money, included: Money) strict {
    label en official "section 1277(b)(1)(A)(i): without net interest income (the interest included does not exceed the interest paid) nothing is taken into account under paragraph (1)";
    when disallowed_interest_balance_1277b(bond, taxpayer, y, balance);
    when interest_paid_on_carrying_debt_1277c1(bond, taxpayer, y, paid);
    when interest_included_in_gross_income_1277c2(bond, taxpayer, y, included);
    when included <= paid;
    then deferral_amount_1277b1(bond, taxpayer, y, 0.00 USD);
}

pub relation interest_treated_as_paid_under_1277b1(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(b)(1)(A): the disallowed interest expense is treated as interest paid or accrued during the taxable year";
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "any disallowed interest expense with respect to such bond shall be treated as interest paid or accrued by the taxpayer during such taxable year")
rule InterestTreatedAsPaidUnder1277b1Rule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1277(b)(1)(A): the amount taken into account is interest paid or accrued in the year";
    when deferral_amount_1277b1(bond, taxpayer, y, amount);
    when amount > 0.00 USD;
    then interest_treated_as_paid_under_1277b1(bond, taxpayer, y, amount);
}

// =============================================================================
// Section 1277(b)(2): remainder allowed for the year of disposition
// =============================================================================

pub relation market_discount_bond_disposed_in_year_1277b2(bond: DebtInstrument, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "section 1277(b)(2)(A): the taxable year in which the market discount bond is disposed of";
}
pub relation bond_disposed_in_nonrecognition_transaction_1277b2b(bond: DebtInstrument, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "section 1277(b)(2)(B): the bond is disposed of in a nonrecognition transaction";
}
pub relation gain_recognized_on_bond_disposition_1277b2b(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1277(b)(2)(B)(i): the amount of gain recognized on the disposition";
}
pub relation remaining_disallowed_interest_1277b2c(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(b)(2)(C): the disallowed interest expense not including any amount previously taken into account under paragraph (1)";
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "the amount of the disallowed interest expense shall not include any amount previously taken into account under paragraph (1)")
rule RemainingDisallowedInterest1277b2cRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, balance: Money, taken: Money) strict {
    label en official "section 1277(b)(2)(C): the balance less the amount taken into account under paragraph (1)";
    when disallowed_interest_balance_1277b(bond, taxpayer, y, balance);
    when deferral_amount_1277b1(bond, taxpayer, y, taken);
    then remaining_disallowed_interest_1277b2c(bond, taxpayer, y, balance - taken);
}

pub relation interest_treated_as_paid_at_disposition_1277b2(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(b)(2): the amount of the disallowed interest expense treated as interest paid or accrued in the year of disposition";
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "shall be treated as interest paid or accrued by the taxpayer in the taxable year in which such bond is disposed of")
rule InterestTreatedAsPaidAtDispositionRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, remaining: Money) defeasible {
    label en official "section 1277(b)(2)(A): the remaining disallowed interest expense is treated as paid or accrued in the year of disposition";
    when market_discount_bond_disposed_in_year_1277b2(bond, taxpayer, y);
    when not_known(bond_disposed_in_nonrecognition_transaction_1277b2b(bond, taxpayer, y));
    when remaining_disallowed_interest_1277b2c(bond, taxpayer, y, remaining);
    then interest_treated_as_paid_at_disposition_1277b2(bond, taxpayer, y, remaining);
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "the disallowed interest expense with respect to such bond shall be treated as interest paid or accrued in the year of disposition only to the extent of the amount of gain recognized on such disposition")
rule InterestTreatedAsPaidNonrecognitionRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, remaining: Money, gain: Money) defeasible {
    label en official "section 1277(b)(2)(B)(i): in a nonrecognition transaction only the lesser of the remaining amount and the recognized gain is treated as paid or accrued";
    when market_discount_bond_disposed_in_year_1277b2(bond, taxpayer, y);
    when bond_disposed_in_nonrecognition_transaction_1277b2b(bond, taxpayer, y);
    when remaining_disallowed_interest_1277b2c(bond, taxpayer, y, remaining);
    when gain_recognized_on_bond_disposition_1277b2b(bond, taxpayer, y, gain);
    then interest_treated_as_paid_at_disposition_1277b2(bond, taxpayer, y, min(remaining, gain));
}

pub relation carried_disallowed_interest_1277b2b(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(b)(2)(B)(ii): the part of the disallowed interest expense not treated as paid or accrued in the year of a nonrecognition disposition";
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "(to the extent not so treated) shall be treated as disallowed interest expense")
rule CarriedDisallowedInterestRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, remaining: Money, gain: Money) strict {
    label en official "section 1277(b)(2)(B)(ii): the remaining disallowed interest expense in excess of the recognized gain stays disallowed";
    when market_discount_bond_disposed_in_year_1277b2(bond, taxpayer, y);
    when bond_disposed_in_nonrecognition_transaction_1277b2b(bond, taxpayer, y);
    when remaining_disallowed_interest_1277b2c(bond, taxpayer, y, remaining);
    when gain_recognized_on_bond_disposition_1277b2b(bond, taxpayer, y, gain);
    then carried_disallowed_interest_1277b2b(bond, taxpayer, y, remaining - min(remaining, gain));
}

pub relation transferred_basis_property_1276c1(bond: DebtInstrument, prop: Asset, transferee: Person) kind empirical {
    label en official "section 1276(c)(1): the transferred basis property received by the transferee";
}
pub relation exchanged_basis_property_1276c2(bond: DebtInstrument, prop: Asset) kind empirical {
    label en official "section 1276(c)(2): the exchanged basis property received in the exchange";
}
pub relation disallowed_interest_expense_of_property_1277b2bii(prop: Asset, holder: Person, amount: Money) kind institutional {
    label en official "section 1277(b)(2)(B)(ii): the disallowed interest expense with respect to the transferee's transferred basis property or the exchanged basis property";
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "of the transferee with respect to the transferred basis property")
rule DisallowedInterestPassesToTransfereeRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, prop: Asset, transferee: Person, carried: Money) defeasible {
    label en official "section 1277(b)(2)(B)(ii)(I): the carried amount is disallowed interest expense of the transferee with respect to the transferred basis property";
    when carried_disallowed_interest_1277b2b(bond, taxpayer, y, carried);
    when transferred_basis_property_1276c1(bond, prop, transferee);
    then disallowed_interest_expense_of_property_1277b2bii(prop, transferee, carried);
}
@source(IRC_S1277_B, relation = formalizes, coverage = exact, quote = "with respect to the exchanged basis property")
rule DisallowedInterestStaysWithExchangedBasisPropertyRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, prop: Asset, carried: Money) defeasible {
    label en official "section 1277(b)(2)(B)(ii)(II): the carried amount is disallowed interest expense with respect to the exchanged basis property";
    when carried_disallowed_interest_1277b2b(bond, taxpayer, y, carried);
    when exchanged_basis_property_1276c2(bond, prop);
    then disallowed_interest_expense_of_property_1277b2bii(prop, taxpayer, carried);
}

pub relation disallowed_interest_expense_of_year_1277b3(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(b)(3): the amount disallowed under subsection (a) with respect to the bond (one component of the aggregate)";
}
@source(IRC_S1277_B, relation = formalizes, coverage = partial, quote = "the term \"disallowed interest expense\" means the aggregate amount disallowed under subsection (a) with respect to the market discount bond")
rule DisallowedInterestExpenseOfYearRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1277(b)(3): each amount disallowed under subsection (a) is a component of the disallowed interest expense";
    when net_direct_interest_expense_deduction_disallowed(bond, taxpayer, y, amount);
    then disallowed_interest_expense_of_year_1277b3(bond, taxpayer, y, amount);
}

// =============================================================================
// Section 1234B: securities futures contracts
// =============================================================================

pub relation security_future_within_3a55A_1934_act(a: Asset) kind empirical {
    label en official "section 1234B(c): a security future as defined in section 3(a)(55)(A) of the Securities Exchange Act of 1934 as in effect on the date of enactment";
}
pub relation securities_futures_contract_definition_met_1234Bc(a: Asset) kind institutional {
    label en official "section 1234B(c): the contract is a securities futures contract";
}
@source(IRC_S1234B_C, relation = formalizes, coverage = partial, quote = "the term \"securities futures contract\" means any security future")
rule SecuritiesFuturesContractDefinitionRule(a: Asset) strict {
    label en official "section 1234B(c): a securities futures contract is a security future";
    when security_future_within_3a55A_1934_act(a);
    then securities_futures_contract_definition_met_1234Bc(a);
}

pub relation securities_futures_contract_sold_exchanged_or_terminated(t: Transaction, p: Person, a: Asset) kind empirical {
    label en official "section 1234B(a)(1): the sale, exchange or termination of a securities futures contract";
}
pub relation contract_relates_to_property_capital_asset_1234Ba1(a: Asset, p: Person) kind empirical {
    label en official "section 1234B(a)(1): the property to which the contract relates is (or, if acquired by the taxpayer, would be) a capital asset in the taxpayer's hands";
}
pub relation contract_is_property_1221a1_or_a7(a: Asset) kind empirical {
    label en official "section 1234B(a)(2)(A): the contract constitutes property described in paragraph (1) or (7) of section 1221(a)";
}
pub relation contract_income_treated_other_than_capital_gain_1234Ba2B(a: Asset) kind empirical {
    label en official "section 1234B(a)(2)(B): income derived in connection with a contract which, without regard to the subsection, is treated as other than gain from the sale or exchange of a capital asset";
}
pub relation securities_futures_character_rule_applies_1234Ba(a: Asset) kind institutional {
    label en official "section 1234B(a)(2): the character rule of subsection (a) applies to the contract";
}
@source(IRC_S1234B_A, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to")
rule SecuritiesFuturesCharacterRuleAppliesRule(a: Asset) strict {
    label en official "section 1234B(a)(2): the character rule applies unless the contract is section 1221(a)(1)/(7) property or the income is already other than capital gain";
    when securities_futures_contract_definition_met_1234Bc(a);
    when not_known(contract_is_property_1221a1_or_a7(a));
    when not_known(contract_income_treated_other_than_capital_gain_1234Ba2B(a));
    then securities_futures_character_rule_applies_1234Ba(a);
}

pub relation securities_futures_gain_or_loss_is_capital_1234Ba1(t: Transaction, p: Person, a: Asset) kind institutional {
    label en official "section 1234B(a)(1): the gain or loss has the character of the property to which the contract relates (here: capital)";
}
@source(IRC_S1234B_A, relation = formalizes, coverage = exact, quote = "shall be considered gain or loss from the sale or exchange of property which has the same character as the property to which the contract relates")
rule SecuritiesFuturesGainLossCapitalRule(t: Transaction, p: Person, a: Asset) defeasible {
    label en official "section 1234B(a)(1): gain or loss on a securities futures contract relating to capital-asset property is capital gain or loss";
    when securities_futures_contract_sold_exchanged_or_terminated(t, p, a);
    when securities_futures_character_rule_applies_1234Ba(a);
    when contract_relates_to_property_capital_asset_1234Ba1(a, p);
    then securities_futures_gain_or_loss_is_capital_1234Ba1(t, p, a);
}

pub relation securities_futures_contract_to_sell_1234Bb(a: Asset) kind empirical {
    label en official "section 1234B(b): a securities futures contract to sell property";
}
pub relation regulations_1092b_or_1234B_provide_otherwise(t: Transaction) kind empirical {
    label en official "section 1234B(b): the regulations under section 1092(b) or section 1234B provide otherwise";
}
pub relation section_1233_governs_securities_futures_closing(t: Transaction) kind empirical {
    label en official "section 1234B(b): section 1233 provides otherwise for the transaction";
}
pub relation securities_futures_gain_or_loss_short_term_1234Bb(t: Transaction, p: Person, a: Asset) kind institutional {
    label en official "section 1234B(b): the capital gain or loss on a securities futures contract to sell is short-term";
}
@source(IRC_S1234B_B, relation = formalizes, coverage = exact, quote = "such gain or loss shall be treated as short-term capital gain or loss")
rule SecuritiesFuturesToSellShortTermRule(t: Transaction, p: Person, a: Asset) defeasible {
    label en official "section 1234B(b): capital gain or loss on a securities futures contract to sell is short-term, subject to section 1092(b) regulations and section 1233";
    when securities_futures_contract_sold_exchanged_or_terminated(t, p, a);
    when securities_futures_contract_to_sell_1234Bb(a);
    when securities_futures_gain_or_loss_is_capital_1234Ba1(t, p, a);
    when not_known(regulations_1092b_or_1234B_provide_otherwise(t));
    when not_known(section_1233_governs_securities_futures_closing(t));
    then securities_futures_gain_or_loss_short_term_1234Bb(t, p, a);
}

pub relation securities_futures_contract_not_commodity_futures_1234Bd(a: Asset) kind institutional {
    label en official "section 1234B(d): for purposes of the title, a securities futures contract is not treated as a commodity futures contract";
}
@source(IRC_S1234B_D, relation = formalizes, coverage = exact, quote = "a securities futures contract shall not be treated as a commodity futures contract")
rule SecuritiesFuturesNotCommodityFuturesRule(a: Asset) strict {
    label en official "section 1234B(d): a securities futures contract is not a commodity futures contract";
    when securities_futures_contract_definition_met_1234Bc(a);
    then securities_futures_contract_not_commodity_futures_1234Bd(a);
}
