// Section 1231 (property used in the trade or business; the hotchpot and
// the 5-year recapture), section 1245 (depreciation recapture on personal
// and certain other property) and section 1250 (additional depreciation
// recapture on real property).

// =============================================================================
// Section 1231
// =============================================================================

use self::{
    Asset,
    IRC_S1231_A,
    IRC_S1231_B,
    IRC_S1231_C,
    IRC_S1245_A,
    IRC_S1245_B,
    IRC_S1250_A,
    IRC_S1250_B,
    IRC_S1250_C,
    IRC_S1250_D,
    Person,
    TaxableYear,
    Transaction,
    amount_realized,
    casualty_theft_conversion_excluded_1231a4C,
    category_property_1250,
    depreciation_allowed,
    gain_recognized,
    held_by,
    held_for_productive_use_or_investment,
    held_primarily_for_sale,
    inventory_or_stock_in_trade,
    involuntary_conversion,
    long_term,
    loss_recognized,
    real_property,
    sale_or_disposition,
    tax_exempt_disposition_blocks_cap_1245b3,
};

pub relation section_1231b_property(p: Person, a: Asset) kind institutional {
    label en official "property used in the trade or business within the meaning of section 1231(b): depreciable section 167 property, or real property, used in the trade or business and held more than 1 year, that is not within the section 1221(a)(1),(3),(5) exclusions this rule cross-references";
}
pub relation depreciable_property(a: Asset) kind empirical {
    label en unofficial "property of a character subject to the section 167 depreciation allowance";
}
pub relation real_property_used_in_trade_or_business(a: Asset) kind empirical {
    label en official "real property used in the trade or business (section 1231(b)(1) second branch)";
}

@source(IRC_S1231_B, quote = "The term \"property used in the trade or business\" means property used in the trade or business, of a character which is subject to the allowance for depreciation provided in section 167, held for more than 1 year, and real property used in the trade or business, held for more than 1 year")
rule Section1231bPropertyFromDepreciablePropertyRule(p: Person, a: Asset) defeasible {
    label en official "section 1231(b)(1): depreciable trade-or-business property held more than 1 year is section 1231(b) property, unless within the (A)-(D) exclusions";
    when held_by(p, a);
    when depreciable_property(a);
    when held_for_productive_use_or_investment(p, a);
    when long_term(p, a);
    when not_known(inventory_or_stock_in_trade(a));
    when not_known(held_primarily_for_sale(p, a));
    then section_1231b_property(p, a);
}
rule Section1231bPropertyFromRealPropertyRule(p: Person, a: Asset) defeasible {
    label en official "section 1231(b)(1): real property used in the trade or business, held more than 1 year, is section 1231(b) property, unless within the (A)-(D) exclusions";
    when held_by(p, a);
    when real_property_used_in_trade_or_business(a);
    when long_term(p, a);
    when not_known(inventory_or_stock_in_trade(a));
    when not_known(held_primarily_for_sale(p, a));
    then section_1231b_property(p, a);
}

// (b)(3): livestock held for draft, breeding, dairy or sporting purposes.
pub relation cattle_or_horses_held_for_draft_breeding_dairy_sporting(p: Person, a: Asset, months_held: Integer) kind empirical {
    label en official "cattle or horses held by the taxpayer for draft, breeding, dairy, or sporting purposes (section 1231(b)(3)(A))";
}
pub relation other_livestock_held_for_draft_breeding_dairy_sporting(p: Person, a: Asset, months_held: Integer) kind empirical {
    label en official "other livestock (not poultry) held by the taxpayer for draft, breeding, dairy, or sporting purposes (section 1231(b)(3)(B))";
}
@source(IRC_S1231_B, quote = "cattle and horses, regardless of age, held by the taxpayer for draft, breeding, dairy, or sporting purposes, and held by him for 24 months or more from the date of acquisition")
rule CattleOrHorsesSection1231bPropertyRule(p: Person, a: Asset, months: Integer) strict {
    label en official "section 1231(b)(3)(A): cattle/horses held 24 months or more for draft, breeding, dairy or sporting purposes are section 1231(b) property";
    when cattle_or_horses_held_for_draft_breeding_dairy_sporting(p, a, months);
    when months >= 24;
    then section_1231b_property(p, a);
}
@source(IRC_S1231_B, quote = "other livestock, regardless of age, held by the taxpayer for draft, breeding, dairy, or sporting purposes, and held by him for 12 months or more from the date of acquisition")
rule OtherLivestockSection1231bPropertyRule(p: Person, a: Asset, months: Integer) strict {
    label en official "section 1231(b)(3)(B): other livestock held 12 months or more for draft, breeding, dairy or sporting purposes is section 1231(b) property";
    when other_livestock_held_for_draft_breeding_dairy_sporting(p, a, months);
    when months >= 12;
    then section_1231b_property(p, a);
}

// (a)(3): section 1231 gain/loss per transaction, from either a direct
// sale/exchange of section 1231(b) property, or an involuntary conversion
// of it (or of a long-term capital asset held in connection with a trade
// or business or a profit-seeking transaction).
pub relation section_1231_gain_transaction(p: Person, y: TaxableYear, t: Transaction, amount: Money) kind institutional {
    label en official "section 1231(a)(3)(A): a recognized gain from the sale, exchange, or covered involuntary conversion of section 1231(b) property";
}
pub relation section_1231_loss_transaction(p: Person, y: TaxableYear, t: Transaction, amount: Money) kind institutional {
    label en official "section 1231(a)(3)(B): a recognized loss from a sale, exchange, or conversion described in section 1231(a)(3)(A)";
}
@source(IRC_S1231_A, quote = "any recognized gain on the sale or exchange of property used in the trade or business")
rule Section1231GainFromSaleRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money, on: Date) defeasible {
    label en official "section 1231(a)(3)(A)(i): a recognized gain on the sale or exchange of section 1231(b) property";
    when sale_or_disposition(t, p, a, on);
    when section_1231b_property(p, a);
    when gain_recognized(p, t, amount);
    when amount > 0.00 USD;
    when us.irc.core::year_of(p, y);
    then section_1231_gain_transaction(p, y, t, amount);
}
rule Section1231LossFromSaleRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money, on: Date) defeasible {
    label en official "section 1231(a)(3)(B): a recognized loss on the sale or exchange of section 1231(b) property";
    when sale_or_disposition(t, p, a, on);
    when section_1231b_property(p, a);
    when loss_recognized(p, t, amount);
    when amount > 0.00 USD;
    when us.irc.core::year_of(p, y);
    then section_1231_loss_transaction(p, y, t, amount);
}
@source(IRC_S1231_A, quote = "any recognized gain from the compulsory or involuntary conversion")
rule Section1231GainFromInvoluntaryConversionRule(p: Person, y: TaxableYear, t: Transaction, converted: Asset, amount: Money) defeasible {
    label en official "section 1231(a)(3)(A)(ii): a recognized gain from the involuntary conversion of section 1231(b) property (or a long-term capital asset held in a trade/business or profit-seeking transaction)";
    when involuntary_conversion(t, p, converted);
    when section_1231b_property(p, converted);
    when gain_recognized(p, t, amount);
    when amount > 0.00 USD;
    when us.irc.core::year_of(p, y);
    when not_known(casualty_theft_conversion_excluded_1231a4C(p, y, t));
    then section_1231_gain_transaction(p, y, t, amount);
}
rule Section1231LossFromInvoluntaryConversionRule(p: Person, y: TaxableYear, t: Transaction, converted: Asset, amount: Money) defeasible {
    label en official "section 1231(a)(3)(B): a recognized loss from the involuntary conversion of section 1231(b) property";
    when involuntary_conversion(t, p, converted);
    when section_1231b_property(p, converted);
    when loss_recognized(p, t, amount);
    when amount > 0.00 USD;
    when us.irc.core::year_of(p, y);
    when not_known(casualty_theft_conversion_excluded_1231a4C(p, y, t));
    then section_1231_loss_transaction(p, y, t, amount);
}

// (a)(1)-(2): the hotchpot.
pub relation section_1231_gains_for_year(p: Person, y: TaxableYear, amount: Money) kind institutional;
pub relation section_1231_losses_for_year(p: Person, y: TaxableYear, amount: Money) kind institutional;
relation has_section_1231_gain_transaction(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "guard: at least one section 1231 gain transaction exists for the year";
}
rule HasSection1231GainTransactionRule(p: Person, y: TaxableYear, t: Transaction, amount: Money) defeasible {
    when section_1231_gain_transaction(p, y, t, amount);
    then has_section_1231_gain_transaction(p, y);
}
relation has_section_1231_loss_transaction(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "guard: at least one section 1231 loss transaction exists for the year";
}
rule HasSection1231LossTransactionRule(p: Person, y: TaxableYear, t: Transaction, amount: Money) defeasible {
    when section_1231_loss_transaction(p, y, t, amount);
    then has_section_1231_loss_transaction(p, y);
}
rule Section1231GainsForYearRule(p: Person, y: TaxableYear, t0: Transaction, amount0: Money) defeasible {
    label en unofficial "sums the year's section 1231 gain transactions";
    when section_1231_gain_transaction(p, y, t0, amount0);
    then section_1231_gains_for_year(p, y,
        sum all amount: Money for t: Transaction where section_1231_gain_transaction(p, y, t, amount));
}
rule Section1231LossesForYearRule(p: Person, y: TaxableYear, t0: Transaction, amount0: Money) defeasible {
    label en unofficial "sums the year's section 1231 loss transactions";
    when section_1231_loss_transaction(p, y, t0, amount0);
    then section_1231_losses_for_year(p, y,
        sum all amount: Money for t: Transaction where section_1231_loss_transaction(p, y, t, amount));
}

pub relation section_1231_hotchpot_gains_prevail(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1231(a)(1): section 1231 gains for the year exceed section 1231 losses — treated as long-term capital gain/loss";
}
pub relation section_1231_hotchpot_losses_prevail(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1231(a)(2): section 1231 gains for the year do not exceed section 1231 losses — treated as ordinary gains/losses, not capital";
}
@source(IRC_S1231_A, quote = "such gains and losses shall be treated as long-term capital gains or long-term capital losses, as the case may be")
rule HotchpotGainsExceedLossesRule(p: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 1231(a)(1): where section 1231 gains exceed section 1231 losses for the year, both are treated as long-term capital gain/loss";
    when section_1231_gains_for_year(p, y, gains);
    when section_1231_losses_for_year(p, y, losses);
    when gains > losses;
    then section_1231_hotchpot_gains_prevail(p, y);
}
@source(IRC_S1231_A, quote = "such gains and losses shall not be treated as gains and losses from sales or exchanges of capital assets")
rule HotchpotLossesPrevailRule(p: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 1231(a)(2): where section 1231 gains do not exceed section 1231 losses for the year, neither is treated as a capital gain/loss (ordinary character)";
    when section_1231_gains_for_year(p, y, gains);
    when section_1231_losses_for_year(p, y, losses);
    when gains <= losses;
    then section_1231_hotchpot_losses_prevail(p, y);
}
rule HotchpotOnlyGainsPrevailRule(p: Person, y: TaxableYear, gains: Money) defeasible {
    label en official "section 1231(a)(1): with section 1231 gains and no section 1231 losses for the year, the gains are treated as long-term capital gain";
    when section_1231_gains_for_year(p, y, gains);
    when gains > 0.00 USD;
    when not_known(has_section_1231_loss_transaction(p, y));
    then section_1231_hotchpot_gains_prevail(p, y);
}

// (c): recapture of net ordinary (section 1231) losses — a current-year
// net section 1231 GAIN is treated as ordinary income to the extent of the
// "non-recaptured" net section 1231 losses of the preceding 5 taxable
// years not yet absorbed by this rule in an earlier year.
pub relation net_section_1231_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1231(c)(3): the excess of section 1231 gains over section 1231 losses for the year";
}
pub relation net_section_1231_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1231(c)(4): the excess of section 1231 losses over section 1231 gains for the year";
}
@source(IRC_S1231_C, relation = formalizes, coverage = partial, quote = "the term \"net section 1231 gain\" means the excess of—")
rule NetSection1231GainRule(p: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 1231(c)(3)";
    when section_1231_gains_for_year(p, y, gains);
    when section_1231_losses_for_year(p, y, losses);
    when gains > losses;
    then net_section_1231_gain(p, y, gains - losses);
}
@source(IRC_S1231_C, relation = formalizes, coverage = partial, quote = "the term \"net section 1231 loss\" means the excess of—")
rule NetSection1231LossRule(p: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 1231(c)(4)";
    when section_1231_gains_for_year(p, y, gains);
    when section_1231_losses_for_year(p, y, losses);
    when losses >= gains;
    then net_section_1231_loss(p, y, losses - gains);
}

pub relation non_recaptured_net_section_1231_losses(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "section 1231(c)(2): the aggregate net section 1231 losses of the 5 most recent preceding taxable years, less the portion already recharacterized as ordinary income under section 1231(c)(1) in those or later years — the 5-year lookback aggregation and prior-absorption bookkeeping is a case-asserted fact this stage (TECH_GAP: a full running 5-year ledger needs the same recursive-accumulation construct flagged in TECH-GAPS.md G1/G2, not built here)";
}
pub relation section_1231_recapture_as_ordinary_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1231(c)(1): the net section 1231 gain for the year treated as ordinary income, to the extent of non-recaptured net section 1231 losses";
}
@source(IRC_S1231_C, quote = "Recapture of net ordinary losses")
rule Section1231RecaptureLesserOfGainOrNonrecapturedLossesRule(p: Person, y: TaxableYear, gain: Money, non_recaptured: Money) defeasible {
    label en official "section 1231(c)(1): the net section 1231 gain is ordinary income to the extent it does not exceed non-recaptured net section 1231 losses";
    when net_section_1231_gain(p, y, gain);
    when non_recaptured_net_section_1231_losses(p, y, non_recaptured);
    when gain <= non_recaptured;
    then section_1231_recapture_as_ordinary_income(p, y, gain);
}
rule Section1231RecaptureCappedAtNonrecapturedLossesRule(p: Person, y: TaxableYear, gain: Money, non_recaptured: Money) defeasible {
    label en official "section 1231(c)(1): where the net section 1231 gain exceeds non-recaptured net section 1231 losses, only that lesser (non-recaptured-losses) amount is ordinary income";
    when net_section_1231_gain(p, y, gain);
    when non_recaptured_net_section_1231_losses(p, y, non_recaptured);
    when gain > non_recaptured;
    then section_1231_recapture_as_ordinary_income(p, y, non_recaptured);
}

// =============================================================================
// Section 1245: recapture of depreciation on section 1245 property
// =============================================================================

pub relation section_1245_property(a: Asset) kind institutional {
    label en official "section 1245(a)(3): personal property, and certain other listed property, of a character subject to the section 167 depreciation allowance";
}
pub relation personal_property(a: Asset) kind empirical {
    label en unofficial "personal property (section 1245(a)(3)(A)) — the section 1245(a)(3)(B)-(F) additional categories (integral-use property, single-purpose structures, storage facilities, railroad grading) are not separately modelled this stage: a case asserting section_1245_property directly for those categories is still valid";
}
@source(IRC_S1245_A, quote = "personal property,")
rule Section1245PropertyFromPersonalPropertyRule(a: Asset) strict {
    label en official "section 1245(a)(3)(A): depreciable personal property is section 1245 property";
    when depreciable_property(a);
    when personal_property(a);
    then section_1245_property(a);
}

pub relation recomputed_basis(p: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en official "section 1245(a)(2): adjusted basis, recomputed by adding back all depreciation/amortization adjustments (allowed or allowable, whichever is greater) reflected in it";
}
@source(IRC_S1245_A, quote = "The term \"recomputed basis\" means, with respect to any property, its adjusted basis recomputed by adding thereto all adjustments reflected in such adjusted basis on account of deductions")
rule RecomputedBasisRule(p: Person, a: Asset, on: Date, basis: Money, depreciation_addback: Money) strict {
    label en official "section 1245(a)(2)(A): recomputed basis is adjusted basis plus depreciation/amortization adjustments added back";
    when us.irc.core::adjusted_basis(p, a, on, basis);
    when depreciation_allowed(p, a, on, depreciation_addback);
    then recomputed_basis(p, a, on, basis + depreciation_addback);
}

pub relation section_1245_disposition(t: Transaction, p: Person, a: Asset, on: Date) kind institutional {
    label en unofficial "a disposition (sale, exchange, involuntary conversion, or other disposition) of section 1245 property";
}
rule Section1245DispositionFromSaleRule(t: Transaction, p: Person, a: Asset, on: Date) strict {
    label en unofficial "any sale or disposition of section 1245 property is a section 1245(a) disposition";
    when sale_or_disposition(t, p, a, on);
    when section_1245_property(a);
    then section_1245_disposition(t, p, a, on);
}

pub relation section_1245_ordinary_income_recapture(p: Person, t: Transaction, amount: Money) kind institutional {
    label en official "section 1245(a)(1): the excess of the lower of recomputed basis or amount realized (fair market value, for a non-sale disposition), over adjusted basis, treated as ordinary income";
}
@source(IRC_S1245_A, quote = "Except as otherwise provided in this section, if section 1245 property is disposed of the amount by which the lower of")
rule Section1245RecaptureOnSaleRule(p: Person, t: Transaction, a: Asset, on: Date, recomputed: Money, realized: Money, basis: Money) defeasible {
    label en official "section 1245(a)(1): on a sale, exchange, or involuntary conversion, ordinary income equals the excess of the lower of recomputed basis or amount realized, over adjusted basis";
    when section_1245_disposition(t, p, a, on);
    when recomputed_basis(p, a, on, recomputed);
    when amount_realized(p, t, realized);
    when us.irc.core::adjusted_basis(p, a, on, basis);
    when min(recomputed, realized) > basis;
    then section_1245_ordinary_income_recapture(p, t, min(recomputed, realized) - basis);
}

// (b)(1)-(2): dispositions by gift or at death are excepted entirely.
pub relation section_1245_disposition_by_gift(t: Transaction) kind empirical;
pub relation section_1245_disposition_at_death(t: Transaction) kind empirical;
@source(IRC_S1245_B, quote = "Subsection (a) shall not apply to a disposition by gift.")
rule Section1245NoRecaptureOnGiftRule(t: Transaction) strict {
    label en official "section 1245(b)(1): no section 1245 recapture on a disposition by gift";
    when section_1245_disposition_by_gift(t);
    then section_1245_recapture_excepted(t);
}
@source(IRC_S1245_B, quote = "Except as provided in section 691 (relating to income in respect of a decedent), subsection (a) shall not apply to a transfer at death.")
rule Section1245NoRecaptureAtDeathRule(t: Transaction) strict {
    label en official "section 1245(b)(2): no section 1245 recapture on a transfer at death (except section 691 income in respect of a decedent)";
    when section_1245_disposition_at_death(t);
    then section_1245_recapture_excepted(t);
}
pub relation section_1245_recapture_excepted(t: Transaction) kind institutional {
    label en unofficial "section 1245(b): this disposition is excepted from recapture entirely";
}

// (b)(3): certain tax-free carryover-basis transactions (section 332, 351,
// 361, 721, 731) cap section 1245(a)(1) gain at the gain actually
// recognized on the transfer (determined without regard to section 1245).
pub relation carryover_basis_under_332_351_361_721_731(t: Transaction) kind empirical {
    label en official "section 1245(b)(3): the transferee's basis in the property is determined by reference to the transferor's basis by reason of section 332, 351, 361, 721, or 731";
}
pub relation gain_recognized_without_regard_to_1245(t: Transaction, amount: Money) kind empirical {
    label en unofficial "section 1245(b)(3): the amount of gain recognized to the transferor on the transfer, determined WITHOUT REGARD to section 1245 (i.e. the gain the general nonrecognition/partial-recognition rule of the cited section itself would produce)";
}
pub relation disposition_to_tax_exempt_organization_1245b3(t: Transaction) kind empirical {
    label en official "section 1245(b)(3) second sentence: the disposition is to an organization (other than a section 521 cooperative) exempt from the chapter 1 tax — this exception to the (b)(3) cap does not itself apply (see paragraph (6)) to a disposition described in section 1245(b)(6)(A)";
}
pub relation section_1245_recapture_capped_by_tax_free_transaction(p: Person, t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1245(b)(3): section 1245(a)(1) gain, capped at the gain recognized on the transfer without regard to section 1245 — a SEPARATE capped-amount relation from Section1245RecaptureOnSaleRule's uncapped section_1245_ordinary_income_recapture; this stage does not add an explicit `priority` link selecting the capped amount over the general rule's amount for the same (p, t) (same open caveat as gross-income's s63/s67 modules for a capped-vs-general conflict on the same head)";
}
@source(IRC_S1245_B, quote = "If the basis of property in the hands of a transferee is determined by reference to its basis in the hands of the transferor by reason of the application of section 332, 351, 361, 721, or 731, then the amount of gain taken into account by the transferor under subsection (a)(1) shall not exceed the amount of gain recognized to the transferor on the transfer of such property (determined without regard to this section).")
rule Section1245RecaptureCappedByTaxFreeTransactionRule(p: Person, t: Transaction, a: Asset, on: Date, amount: Money) defeasible {
    label en official "section 1245(b)(3): where transferee basis carries over under section 332/351/361/721/731, section 1245 gain is capped at the gain actually recognized on the transfer";
    when section_1245_disposition(t, p, a, on);
    when carryover_basis_under_332_351_361_721_731(t);
    when gain_recognized_without_regard_to_1245(t, amount);
    when not_known(tax_exempt_disposition_blocks_cap_1245b3(t));
    then section_1245_recapture_capped_by_tax_free_transaction(p, t, amount);
}

// (b)(4): like-kind exchanges and involuntary conversions cap section
// 1245(a)(1) gain at recognized gain plus the FMV of non-section-1245
// property received. (5)-(8) (partnership distributions, timber, section
// 197 intangible bundling) are TECH_GAP this stage — narrower basis-shape
// mechanics layered on top of the capped-amount construct above.
pub relation nonrecognition_under_1031_or_1033(t: Transaction) kind empirical {
    label en official "section 1245(b)(4): gain on the disposition is not recognized in whole or in part under section 1031 or 1033 (determined without regard to section 1245)";
}
pub relation fair_market_value_of_non_1245_property_acquired(t: Transaction, amount: Money) kind empirical {
    label en unofficial "section 1245(b)(4)(B): the fair market value of property acquired in the transaction which is not section 1245 property and not taken into account under (b)(4)(A)";
}
pub relation section_1245_recapture_capped_by_like_kind_or_involuntary_conversion(p: Person, t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1245(b)(4): section 1245(a)(1) gain capped at recognized gain (determined without regard to section 1245) plus the FMV of non-section-1245 property acquired — same separate-capped-relation caveat as (b)(3) above";
}
@source(IRC_S1245_B, quote = "If property is disposed of and gain (determined without regard to this section) is not recognized in whole or in part under section 1031 or 1033, then the amount of gain taken into account by the transferor under subsection (a)(1) shall not exceed the sum of—")
rule Section1245RecaptureCappedByLikeKindOrInvoluntaryConversionRule(p: Person, t: Transaction, a: Asset, on: Date, recognized: Money, non_1245_fmv: Money) defeasible {
    label en official "section 1245(b)(4): section 1245 gain on a section 1031/1033 transaction is capped at recognized gain plus the FMV of non-section-1245 property acquired";
    when section_1245_disposition(t, p, a, on);
    when nonrecognition_under_1031_or_1033(t);
    when gain_recognized_without_regard_to_1245(t, recognized);
    when fair_market_value_of_non_1245_property_acquired(t, non_1245_fmv);
    then section_1245_recapture_capped_by_like_kind_or_involuntary_conversion(p, t, recognized + non_1245_fmv);
}

// =============================================================================
// Section 1250: recapture of additional depreciation on real property
// =============================================================================

pub relation section_1250_property(a: Asset) kind institutional {
    label en official "section 1250(c): real property (other than section 1245 property) of a character subject to the section 167 depreciation allowance";
}
@source(IRC_S1250_C, quote = "the term \"section 1250 property\" means any real property (other than section 1245 property, as defined in section 1245(a)(3)) which is or has been property of a character subject to the allowance for depreciation")
rule Section1250PropertyFromRealDepreciablePropertyRule(a: Asset) strict {
    label en official "section 1250(c): real property, not section 1245 property, subject to the depreciation allowance, is section 1250 property";
    when depreciable_property(a);
    when real_property(a);
    when not_known(section_1245_property(a));
    then section_1250_property(a);
}

// (b)(1),(3),(5): "additional depreciation" is the excess of actual
// depreciation adjustments over what straight-line depreciation would have
// produced. Post-1986 real property must already use straight-line
// depreciation (section 168(b)(3)), so additional depreciation on such
// property is ordinarily zero — the statute's mechanism remains fully
// stated below for pre-1987 (or otherwise accelerated) property.
pub relation actual_depreciation_adjustments(p: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en unofficial "section 1250(b)(3): all adjustments (since December 31, 1963) reflected in adjusted basis on account of depreciation/amortization deductions actually allowed or allowable";
}
pub relation straight_line_depreciation_adjustments(p: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en unofficial "section 1250(b)(1),(5): the depreciation adjustments that would have resulted under the straight-line method for the same property and period";
}
pub relation additional_depreciation(p: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en official "section 1250(b)(1): the excess of actual depreciation adjustments over straight-line depreciation adjustments";
}
@source(IRC_S1250_B, quote = "The term \"additional depreciation\" means, in the case of any property, the depreciation adjustments in respect of such property")
rule AdditionalDepreciationRule(p: Person, a: Asset, on: Date, actual: Money, straight_line: Money) defeasible {
    label en official "section 1250(b)(1): additional depreciation is actual depreciation adjustments less straight-line depreciation adjustments (held-more-than-1-year property)";
    when actual_depreciation_adjustments(p, a, on, actual);
    when straight_line_depreciation_adjustments(p, a, on, straight_line);
    when long_term(p, a);
    when actual > straight_line;
    then additional_depreciation(p, a, on, actual - straight_line);
}
rule NoAdditionalDepreciationRule(p: Person, a: Asset, on: Date, actual: Money, straight_line: Money) defeasible {
    label en official "section 1250(b)(1): where actual depreciation does not exceed straight-line depreciation (the ordinary case for post-1986 real property, which must already use the straight-line method), additional depreciation is zero";
    when actual_depreciation_adjustments(p, a, on, actual);
    when straight_line_depreciation_adjustments(p, a, on, straight_line);
    when long_term(p, a);
    when actual <= straight_line;
    then additional_depreciation(p, a, on, 0.00 USD);
}

// (a)(1)(B)(v): the general 100%-applicable-percentage case (all section
// 1250 property not within the named federal-housing/rehabilitation
// categories of (a)(1)(B)(i)-(iv), which are TECH_GAP this stage — see
// module note below).
pub relation applicable_percentage_general_case(a: Asset) kind institutional {
    label en unofficial "section 1250(a)(1)(B)(v): all section 1250 property other than the federal-housing-assisted or rehabilitation-expenditure categories of (a)(1)(B)(i)-(iv) — the 100% default";
}
rule ApplicablePercentageGeneralCaseDefaultRule(a: Asset) defeasible {
    label en unofficial "absent an asserted federal-housing/rehabilitation classification, section 1250 property falls in the general 100% case";
    when section_1250_property(a);
    when not_known(federal_housing_assisted_or_rehabilitation_property(a));
    when not_known(category_property_1250(a));
    then applicable_percentage_general_case(a);
}
pub relation federal_housing_assisted_or_rehabilitation_property(a: Asset) kind empirical {
    label en unofficial "section 1250(a)(1)(B)(i)-(iv): federally-insured or assisted housing, section 8 housing, section 167(k) rehabilitation-expenditure property, or title V Housing Act property — TECH_GAP: the four percentage-phase-down schedules for these categories, and the separate (a)(2)/(a)(3) pre-1976/pre-1970 transition schedules, are not computed this stage (they are historical, applicable only when depreciation attributable to those pre-1987 periods exists); a case naming this classification blocks the general-100%-case default above rather than silently misapplying it";
}

pub relation section_1250_ordinary_income_recapture(p: Person, t: Transaction, amount: Money) kind institutional {
    label en official "section 1250(a)(1)(A): the applicable percentage of the lower of additional depreciation (attributable to periods after December 31, 1975) or the excess of amount realized (or fair market value) over adjusted basis, treated as ordinary income";
}
@source(IRC_S1250_A, quote = "If section 1250 property is disposed of after December 31, 1975, then the applicable percentage of the lower of")
rule Section1250RecaptureGeneralCaseRule(p: Person, t: Transaction, a: Asset, on: Date, additional_dep: Money, realized: Money, basis: Money) defeasible {
    label en official "section 1250(a)(1): ordinary income equals the applicable percentage (100% in the general case) of the lower of additional depreciation or the excess of amount realized over adjusted basis";
    when section_1250_property(a);
    when applicable_percentage_general_case(a);
    when sale_or_disposition(t, p, a, on);
    when additional_depreciation(p, a, on, additional_dep);
    when amount_realized(p, t, realized);
    when us.irc.core::adjusted_basis(p, a, on, basis);
    when realized > basis;
    then section_1250_ordinary_income_recapture(p, t, min(additional_dep, realized - basis));
}
rule Section1250NoRecaptureWhenNoAdditionalDepreciationRule(p: Person, t: Transaction, a: Asset, on: Date) defeasible {
    label en official "section 1250(a)(1): with zero additional depreciation (the ordinary post-1986 straight-line case), there is no section 1250 ordinary-income recapture";
    when section_1250_property(a);
    when applicable_percentage_general_case(a);
    when sale_or_disposition(t, p, a, on);
    when additional_depreciation(p, a, on, 0.00 USD);
    then section_1250_ordinary_income_recapture(p, t, 0.00 USD);
}

// (d)(1)-(2): gift and death exceptions, mirroring section 1245(b)(1)-(2).
@source(IRC_S1250_D, quote = "Subsection (a) shall not apply to a disposition by gift.")
rule Section1250NoRecaptureOnGiftRule(t: Transaction) strict {
    label en official "section 1250(d)(1): no section 1250 recapture on a disposition by gift";
    when section_1245_disposition_by_gift(t);
    then section_1250_recapture_excepted(t);
}
@source(IRC_S1250_D, quote = "Except as provided in section 691 (relating to income in respect of a decedent), subsection (a) shall not apply to a transfer at death.")
rule Section1250NoRecaptureAtDeathRule(t: Transaction) strict {
    label en official "section 1250(d)(2): no section 1250 recapture on a transfer at death (except section 691 income in respect of a decedent)";
    when section_1245_disposition_at_death(t);
    then section_1250_recapture_excepted(t);
}
pub relation section_1250_recapture_excepted(t: Transaction) kind institutional {
    label en unofficial "section 1250(d): this disposition is excepted from recapture entirely";
}

// (d)(3): identical cap to section 1245(b)(3) (carryover basis under
// section 332/351/361/721/731), reusing that module's relations.
pub relation section_1250_recapture_capped_by_tax_free_transaction(p: Person, t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1250(d)(3): section 1250(a) gain capped at the gain recognized on the transfer without regard to section 1250 — same separate-capped-relation caveat as section 1245(b)(3)";
}
@source(IRC_S1250_D, quote = "If the basis of property in the hands of a transferee is determined by reference to its basis in the hands of the transferor by reason of the application of section 332, 351, 361, 721, or 731, then the amount of gain taken into account by the transferor under subsection (a) shall not exceed the amount of gain recognized to the transferor on the transfer of such property (determined without regard to this section).")
rule Section1250RecaptureCappedByTaxFreeTransactionRule(p: Person, t: Transaction, a: Asset, on: Date, amount: Money) defeasible {
    label en official "section 1250(d)(3): where transferee basis carries over under section 332/351/361/721/731, section 1250 gain is capped at the gain actually recognized on the transfer";
    when sale_or_disposition(t, p, a, on);
    when section_1250_property(a);
    when carryover_basis_under_332_351_361_721_731(t);
    when gain_recognized_without_regard_to_1245(t, amount);
    when not_known(disposition_to_tax_exempt_organization_1245b3(t));
    then section_1250_recapture_capped_by_tax_free_transaction(p, t, amount);
}

// (d)(4): the section 1031/1033 cap. Only the (A)(i)/(C) "recognized gain,
// or the excess of would-be gain over the FMV/cost of section 1250 property
// acquired" branch of the "greater of" test is modelled; the (B) stock-
// purchase increase and the (A)(ii)/(C) full "greater of" comparison itself
// (needing an ordered maximum over two computed candidates, TECH-GAPS.md
// G136 class) are TECH_GAP.
pub relation fair_market_value_of_1250_property_acquired(t: Transaction, amount: Money) kind empirical {
    label en unofficial "section 1250(d)(4)(C)(ii): the fair market value (or cost, for a section 1033(a)(2) transaction) of the section 1250 property acquired in the transaction";
}
pub relation section_1250_recapture_capped_by_insufficient_1250_property_acquired(p: Person, t: Transaction, amount: Money) kind institutional {
    label en unofficial "section 1250(d)(4)(A)(ii)/(C): the excess of the would-be section 1250(a) gain over the FMV/cost of section 1250 property acquired — one candidate of the (A) 'greater of' test; the OTHER candidate ((A)(i)/(B), recognized gain increased for certain stock) and the max-over-both comparison are TECH_GAP (G136 class)";
}
@source(IRC_S1250_D, quote = "the amount of gain which would (but for this paragraph) be taken into account under subsection (a), over")
rule Section1250RecaptureCappedByInsufficientPropertyAcquiredRule(p: Person, t: Transaction, would_be_gain: Money, fmv_1250_acquired: Money) defeasible {
    label en official "section 1250(d)(4)(C): the excess of the would-be section 1250 gain over the FMV/cost of section 1250 property acquired in a section 1031/1033 transaction";
    when nonrecognition_under_1031_or_1033(t);
    when section_1250_ordinary_income_recapture(p, t, would_be_gain);
    when fair_market_value_of_1250_property_acquired(t, fmv_1250_acquired);
    when would_be_gain > fmv_1250_acquired;
    then section_1250_recapture_capped_by_insufficient_1250_property_acquired(p, t, would_be_gain - fmv_1250_acquired);
}

// (e): holding period for the applicable-percentage phase-down schedules
// (not itself needed by the general 100% case modelled above, since a
// 100% applicable percentage does not phase down with holding period; kept
// here as a named cross-reference for the (a)(1)(B)(i)-(iv) TECH_GAP).
