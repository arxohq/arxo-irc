// Stage 2b (IRC-07, A05). Section 1272-1275: original issue discount (OID).
// Section 1273 definitions incl. the ¼-of-1%-per-year de minimis rule;
// section 1272(a) the ONE-PERIOD constant-yield accrual step (the
// multi-period running ledger is TECH-GAPS.md G1-class, filed not built);
// section 1274 debt instruments issued for property (the AFR-dependent
// imputed principal amount is SOURCE_GAP: no us.irc.* package pins the
// applicable federal rate); section 1275 definitions and the personal-use
// carve-out.

use self::{
    IRC_S1272_A,
    IRC_S1272_B,
    IRC_S1272_C,
    IRC_S1273_A,
    IRC_S1273_B,
    IRC_S1274_A,
    IRC_S1275_B,
    Person,
    section_1274_governs,
};

pub entity DebtInstrument : Asset {
    label en unofficial "a bond, debenture, note, or other evidence of indebtedness (section 1275(a)(1)) — the (a)(1)(B) certain-annuity-contract exclusion is read into whether a case asserts the subtype";
}

// =============================================================================
// Section 1273: original issue discount, issue price, de minimis rule
// =============================================================================

pub relation stated_redemption_price_at_maturity(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1273(a)(2): the amount fixed by the last modification of the purchase agreement, including interest/other amounts payable at maturity other than qualifying fixed-rate unconditional periodic interest";
}
pub relation issue_price(instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1273(b)/section 1274(a): the debt instrument's issue price";
}
pub relation publicly_offered(instr: DebtInstrument) kind empirical;
pub relation issued_for_property(instr: DebtInstrument) kind empirical;
pub relation initial_offering_price_to_public(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1273(b)(1): the initial offering price to the public (excluding bond houses and brokers) at which a substantial amount of the issue was sold";
}
@source(IRC_S1273_B, quote = "the issue price is the initial offering price to the public (excluding bond houses and brokers) at which price a substantial amount of such debt instruments was sold.")
rule IssuePricePubliclyOfferedNotForPropertyRule(instr: DebtInstrument, amount: Money) strict {
    label en official "section 1273(b)(1): issue price is the public offering price for a publicly-offered issue not issued for property";
    when publicly_offered(instr);
    when not_known(issued_for_property(instr));
    when initial_offering_price_to_public(instr, amount);
    then issue_price(instr, amount);
}
pub relation price_paid_by_first_buyer(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1273(b)(2): the price paid by the first buyer of the debt instrument";
}
@source(IRC_S1273_B, quote = "the issue price of each such instrument is the price paid by the first buyer of such debt instrument.")
rule IssuePriceNotPubliclyOfferedNotForPropertyRule(instr: DebtInstrument, amount: Money) strict {
    label en official "section 1273(b)(2): issue price is the price paid by the first buyer for a non-publicly-offered issue not issued for property";
    when not_known(publicly_offered(instr));
    when not_known(issued_for_property(instr));
    when price_paid_by_first_buyer(instr, amount);
    then issue_price(instr, amount);
}
pub relation traded_on_established_securities_market(instr: DebtInstrument) kind empirical {
    label en unofficial "section 1273(b)(3)(A): part of an issue a portion of which is traded on an established securities market";
}
pub relation fair_market_value_of_property_for_which_issued(instr: DebtInstrument, amount: Money) kind empirical {
    label en unofficial "section 1273(b)(3): the fair market value of the property for which the debt instrument was issued";
}
@source(IRC_S1273_B, quote = "the issue price of such debt instrument shall be the fair market value of such property.")
rule IssuePriceIssuedForPropertyWithPublicTradingRule(instr: DebtInstrument, amount: Money) strict {
    label en official "section 1273(b)(3): issue price is the FMV of the property received, where issued for property and there is public trading";
    when issued_for_property(instr);
    when traded_on_established_securities_market(instr);
    when fair_market_value_of_property_for_which_issued(instr, amount);
    then issue_price(instr, amount);
}
pub relation section_1274_applies_to_instrument(instr: DebtInstrument) kind empirical {
    label en unofficial "whether section 1274 applies to this instrument (guard so (b)(4)'s 'other cases' residual does not also fire when 1274 governs)";
}
@source(IRC_S1273_B, quote = "the issue price of a debt instrument which is issued for property shall be the stated redemption price at maturity.")
rule IssuePriceOtherCasesRule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1273(b)(4): absent (1)-(3) and section 1274, issue price of property-issued debt is the stated redemption price at maturity";
    when issued_for_property(instr);
    when not_known(traded_on_established_securities_market(instr));
    when not_known(section_1274_applies_to_instrument(instr));
    when not_known(section_1274_governs(instr));
    when stated_redemption_price_at_maturity(instr, amount);
    then issue_price(instr, amount);
}

pub relation original_issue_discount(instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1273(a)(1): the excess of the stated redemption price at maturity over the issue price";
}
@source(IRC_S1273_A, quote = "The term \"original issue discount\" means the excess (if any) of—")
rule OriginalIssueDiscountRule(instr: DebtInstrument, srpm: Money, issue: Money) defeasible {
    label en official "section 1273(a)(1): OID is the excess of stated redemption price at maturity over issue price";
    when stated_redemption_price_at_maturity(instr, srpm);
    when issue_price(instr, issue);
    when srpm > issue;
    then original_issue_discount(instr, srpm - issue);
}

pub const DeMinimisOidRatePerYear: Decimal = 0.0025 {
    label en official "¼ of 1 percent (section 1273(a)(3)(A))";
};
pub relation complete_years_to_maturity(instr: DebtInstrument, n: Integer) kind empirical {
    label en official "section 1273(a)(3)(B): the number of complete years to maturity";
}
pub relation original_issue_discount_treated_as_zero(instr: DebtInstrument) kind institutional {
    label en official "section 1273(a)(3): the de minimis rule — OID below ¼-of-1%-per-complete-year-to-maturity of the stated redemption price at maturity is treated as zero";
}
@source(IRC_S1273_A, quote = "then the original issue discount shall be treated as zero.")
rule DeMinimisOidRule(instr: DebtInstrument, oid: Money, srpm: Money, years: Integer) defeasible {
    label en official "section 1273(a)(3): OID below the de minimis threshold is treated as zero";
    when original_issue_discount(instr, oid);
    when stated_redemption_price_at_maturity(instr, srpm);
    when complete_years_to_maturity(instr, years);
    when oid < srpm * DeMinimisOidRatePerYear * years;
    then original_issue_discount_treated_as_zero(instr);
}

// =============================================================================
// Section 1274: debt instruments issued for property
// =============================================================================

pub relation adequate_stated_interest(instr: DebtInstrument) kind empirical {
    label en official "section 1274(a)(1): the debt instrument has adequate stated interest (section 1274(c)/(d)'s own tests, not separately derived here)";
}
pub relation stated_principal_amount(instr: DebtInstrument, amount: Money) kind empirical;
@source(IRC_S1274_A, quote = "where there is adequate stated interest, the stated principal amount, or")
rule Section1274IssuePriceAdequateStatedInterestRule(instr: DebtInstrument, amount: Money) strict {
    label en official "section 1274(a)(1): issue price is the stated principal amount, where there is adequate stated interest";
    when section_1274_applies_to_instrument(instr);
    when adequate_stated_interest(instr);
    when stated_principal_amount(instr, amount);
    then issue_price(instr, amount);
}
pub relation imputed_principal_amount(instr: DebtInstrument, amount: Money) kind empirical {
    label en unofficial "section 1274(a)(2)/(b): the imputed principal amount — the present value of all payments due under the instrument, discounted at the applicable federal rate (section 1274(d)). SOURCE_GAP: no us.irc.* package pins the AFR table this stage; the amount is case-supplied, not computed from a discount-rate schedule";
}
@source(IRC_S1274_A, quote = "in any other case, the imputed principal amount.")
rule Section1274IssuePriceImputedPrincipalRule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1274(a)(2): issue price is the imputed principal amount, absent adequate stated interest";
    when section_1274_applies_to_instrument(instr);
    when not_known(adequate_stated_interest(instr));
    when imputed_principal_amount(instr, amount);
    then issue_price(instr, amount);
}

// =============================================================================
// Section 1275: definitions and the personal-use-property carve-out
// =============================================================================

pub relation tax_exempt_obligation(instr: DebtInstrument) kind empirical {
    label en official "section 1275(a)(3): interest not includible in gross income under section 103, or exempt under any other provision";
}
pub relation obligor_personal_use_property(instr: DebtInstrument) kind empirical {
    label en official "section 1275(b)(3): the property for which the instrument was given in consideration is personal use property (substantially all use not in a trade/business or section 212 activity, determined as of issuance)";
}
pub relation sections_1274_and_483_excepted_for_personal_use(instr: DebtInstrument) kind institutional {
    label en official "section 1275(b)(1): sections 1274 and 483 do not apply to the obligor on a personal-use-property debt instrument";
}
@source(IRC_S1275_B, quote = "sections 1274 and 483 shall not apply if such property is personal use property.")
rule PersonalUsePropertyExceptsSections1274And483Rule(instr: DebtInstrument) strict {
    label en official "section 1275(b)(1): personal use property excepts sections 1274 and 483 for the obligor";
    when obligor_personal_use_property(instr);
    then sections_1274_and_483_excepted_for_personal_use(instr);
}

// =============================================================================
// Section 1272: current inclusion of OID (the (a)(2) exceptions, the
// (c) purchase/basis-adjustment rule, and the ONE-PERIOD constant-yield
// accrual step of (a)(3)-(4))
// =============================================================================

pub relation united_states_savings_bond(instr: DebtInstrument) kind empirical;
pub relation fixed_maturity_date(instr: DebtInstrument, maturity: Date) kind empirical;
pub relation date_of_issue(instr: DebtInstrument, issued_on: Date) kind empirical;
pub relation short_term_obligation_1272a2c(instr: DebtInstrument) kind institutional {
    label en official "section 1272(a)(2)(C): a debt instrument with a fixed maturity date not more than 1 year from the date of issue";
}
@source(IRC_S1272_A, quote = "Any debt instrument which has a fixed maturity date not more than 1 year from the date of issue.")
rule ShortTermObligationRule(instr: DebtInstrument, maturity: Date, issued_on: Date) strict {
    label en official "section 1272(a)(2)(C): fixed maturity within 1 year of issue is a short-term obligation, excepted from current OID inclusion";
    when fixed_maturity_date(instr, maturity);
    when date_of_issue(instr, issued_on);
    when maturity <= add_calendar_period(issued_on, 1 calendar_year);
    then short_term_obligation_1272a2c(instr);
}

pub relation loan_between_natural_persons(instr: DebtInstrument, lender: Person, borrower: Person, principal_and_prior_loans: Money) kind empirical {
    label en official "section 1272(a)(2)(D)(i): a loan by a natural person to another natural person, not made in the course of the lender's trade or business, with the loan (plus prior loans by the lender to the borrower) not exceeding $10,000";
}
pub relation loan_has_tax_avoidance_purpose(instr: DebtInstrument) kind empirical {
    label en official "section 1272(a)(2)(D)(ii): the loan has tax avoidance as one of its principal purposes — bars the exception";
}
pub const NaturalPersonLoanOidExceptionCeiling: Money = 10000.00 USD {
    label en official "$10,000 (section 1272(a)(2)(D)(i)(II))";
};
pub relation natural_person_loan_oid_excepted(instr: DebtInstrument) kind institutional {
    label en official "section 1272(a)(2)(D): a qualifying natural-person-to-natural-person loan of $10,000 or less is excepted from current OID inclusion";
}
@source(IRC_S1272_A, quote = "the amount of such loan (when increased by the outstanding amount of prior loans by such natural person to such other natural person) does not exceed $10,000.")
rule NaturalPersonLoanOidExceptedRule(instr: DebtInstrument, lender: Person, borrower: Person, total: Money) defeasible {
    label en official "section 1272(a)(2)(D): natural-person loans of $10,000 or less are excepted, unless tax avoidance is a principal purpose";
    when loan_between_natural_persons(instr, lender, borrower, total);
    when total <= NaturalPersonLoanOidExceptionCeiling;
    when not_known(loan_has_tax_avoidance_purpose(instr));
    then natural_person_loan_oid_excepted(instr);
}

pub relation oid_current_inclusion_excepted(instr: DebtInstrument) kind institutional {
    label en official "section 1272(a)(2): current OID inclusion does not apply to this debt instrument";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "Any tax-exempt obligation.")
rule OidExceptedFromTaxExemptRule(instr: DebtInstrument) strict {
    when tax_exempt_obligation(instr);
    then oid_current_inclusion_excepted(instr);
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "Any United States savings bond.")
rule OidExceptedFromSavingsBondRule(instr: DebtInstrument) strict {
    when united_states_savings_bond(instr);
    then oid_current_inclusion_excepted(instr);
}
rule OidExceptedFromShortTermRule(instr: DebtInstrument) strict {
    when short_term_obligation_1272a2c(instr);
    then oid_current_inclusion_excepted(instr);
}
rule OidExceptedFromNaturalPersonLoanRule(instr: DebtInstrument) defeasible {
    when natural_person_loan_oid_excepted(instr);
    then oid_current_inclusion_excepted(instr);
}

// (a)(3)-(4): the ONE-PERIOD constant-yield step. `adjusted_issue_price_at_
// start` is a case-supplied snapshot for the accrual period in question
// (the FIRST period's value is the issue price itself, by (a)(4); a SECOND
// period's value would need this period's own OUTPUT as its input — the
// same year-keyed running-ledger self-reference this package's TECH-GAPS.md
// G1/G24/G25 already document. Only ONE period's increase is computed here;
// the multi-period roll-forward and the resulting daily-portion allocation
// over the whole taxable year (summing across however many accrual periods
// fall in it) are TECH_GAP, G1-class, not built.
pub relation adjusted_issue_price_at_start_of_period(instr: DebtInstrument, period: Integer, amount: Money) kind empirical {
    label en unofficial "section 1272(a)(4): the adjusted issue price at the beginning of the accrual period — case-supplied for the period in question (period 1 = the issue price; a later period's value would be the PRIOR period's own OUTPUT, the multi-period chain this package does not build, TECH-GAPS.md G1-class)";
}
pub relation yield_to_maturity(instr: DebtInstrument, rate: Decimal) kind empirical {
    label en official "section 1272(a)(3)(A)(ii): the yield to maturity, compounded at the close of each accrual period";
}
pub relation interest_payable_during_period(instr: DebtInstrument, period: Integer, amount: Money) kind empirical {
    label en official "section 1272(a)(3)(B): the sum of amounts payable as interest during the accrual period";
}
pub relation increase_in_adjusted_issue_price(instr: DebtInstrument, period: Integer, amount: Money) kind institutional {
    label en official "section 1272(a)(3): the increase in adjusted issue price for ONE accrual period — (adjusted issue price at start × yield to maturity) minus interest payable during the period";
}
@source(IRC_S1272_A, quote = "the sum of the amounts payable as interest on such debt instrument during such accrual period.")
rule OnePeriodConstantYieldIncreaseRule(instr: DebtInstrument, period: Integer, start_price: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(3): one accrual period's increase in adjusted issue price under the constant-yield method";
    when adjusted_issue_price_at_start_of_period(instr, period, start_price);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, period, interest);
    when start_price * rate > interest;
    then increase_in_adjusted_issue_price(instr, period, start_price * rate - interest);
}

// (b): premium-purchaser and life-insurance-company exceptions; (c)(1)
// purchase defined; (c)(2) basis adjustment.
pub relation purchased_at_premium(instr: DebtInstrument, holder: Person) kind empirical {
    label en official "section 1272(b)(1): the holder purchased the debt instrument at a premium";
}
@source(IRC_S1272_B, relation = formalizes, coverage = partial, quote = "who has purchased the debt instrument at a premium,")
rule OidExceptedFromPremiumPurchaserRule(instr: DebtInstrument, holder: Person) strict {
    when purchased_at_premium(instr, holder);
    then oid_current_inclusion_excepted(instr);
}
pub relation oid_amount_included_in_gross_income(holder: Person, instr: DebtInstrument, amount: Money) kind empirical {
    label en unofficial "the amount of OID actually included in the holder's gross income under this section — case-asserted pending the multi-period ledger (G1-class) that would otherwise compute it";
}
// NOT written back into `us.irc.core::adjusted_basis` at the SAME (holder,
// instr, on) key read here — that would be the predicate-consumes-and-
// produces-itself self-loop this package's own AGENT-BRIEF traps list
// forbids (TECH-GAPS.md G24/G25 class). Exposed as its own terminal
// relation instead, mirroring module 04's wash-sale basis-adjustment idiom.
pub relation basis_after_oid_adjustment(holder: Person, instr: DebtInstrument, on: Date, amount: Money) kind institutional {
    label en official "section 1272(c)(2): the debt instrument's basis, increased by the OID included in gross income under this section";
}
@source(IRC_S1272_C, relation = formalizes, coverage = partial, quote = "The basis of any debt instrument in the hands of the holder thereof shall be increased by the amount included in his gross income pursuant to this section.")
rule OidBasisAdjustmentRule(holder: Person, instr: DebtInstrument, on: Date, basis: Money, oid_included: Money) strict {
    label en official "section 1272(c)(2): the holder's basis in the debt instrument is increased by the amount of OID included in gross income under this section";
    when us.irc.core::adjusted_basis(holder, instr, on, basis);
    when oid_amount_included_in_gross_income(holder, instr, oid_included);
    then basis_after_oid_adjustment(holder, instr, on, basis + oid_included);
}
