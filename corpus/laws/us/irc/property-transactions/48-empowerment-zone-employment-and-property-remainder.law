// Stage 3b (IRC-07, A05). Subpart U remainder: section 1396(d)(2)(C), (d)(3) the 90-day employment
// rule and the termination special cases; section 1397(a)(2), (b) training wages, related persons
// and the single-employer rule; section 1397A(b) recapture; section 1397D(b) sale-leasebacks.
//
// Method. The 90-day exclusion of (d)(2)(C) is a derived relation read by module 27's qualified
// zone employee rule; the (d)(3)(A) exceptions keep a terminated employee from being excluded and
// the (d)(3)(B) changes of form keep the relationship from being treated as terminated. The
// proportionate credit share of (b)(2) is a ratio of Decimal dollar facts (six places, HALF_UP:
// JUDGMENT CALL).

use self::{
    Asset,
    IRC_S1396_D,
    IRC_S1397A_B,
    IRC_S1397D_B,
    IRC_S1397_A,
    IRC_S1397_B,
    Person,
    TaxableYear,
    Transaction,
};

pub relation days_employed_by_employer_1396(employee: Person, employer: Person, days: Integer) kind empirical {
    label en official "section 1396(d)(2)(C): the number of days the individual was employed by the employer";
}
pub relation employment_terminated_1396(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(3): the employment was terminated";
}
pub relation transaction_381a_employee_continues_with_acquirer(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(3)(B)(i): a transaction to which section 381(a) applies and the employee continues to be employed by the acquiring corporation";
}
pub relation mere_change_in_form_employee_continues(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(3)(B)(ii): a mere change in the form of conducting the trade or business, the employee continues in it and the taxpayer retains a substantial interest";
}
pub relation employment_relationship_not_terminated_1396d3B(employee: Person, employer: Person) kind institutional {
    label en official "section 1396(d)(3)(B): the employment relationship is not treated as terminated";
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "by a transaction to which section 381(a) applies if the employee continues to be employed by the acquiring corporation")
rule NotTerminatedBy381Rule(employee: Person, employer: Person) strict {
    label en official "section 1396(d)(3)(B)(i): a section 381(a) transaction with continued employment is not a termination";
    when transaction_381a_employee_continues_with_acquirer(employee, employer);
    then employment_relationship_not_terminated_1396d3B(employee, employer);
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "by reason of a mere change in the form of conducting the trade or business of the taxpayer if the employee continues to be employed in such trade or business and the taxpayer retains a substantial interest in such trade or business")
rule NotTerminatedByFormChangeRule(employee: Person, employer: Person) strict {
    label en official "section 1396(d)(3)(B)(ii): a mere change in form is not a termination";
    when mere_change_in_form_employee_continues(employee, employer);
    then employment_relationship_not_terminated_1396d3B(employee, employer);
}
pub relation relationship_terminated_1396d2C(employee: Person, employer: Person) kind institutional {
    label en official "section 1396(d)(2)(C), (3)(B): the employment relationship is terminated";
}
rule RelationshipTerminatedRule(employee: Person, employer: Person) defeasible {
    label en official "section 1396(d)(3)(B): a termination that is not excluded by the changes-in-form rule";
    when employment_terminated_1396(employee, employer);
    when not_known(employment_relationship_not_terminated_1396d3B(employee, employer));
    then relationship_terminated_1396d2C(employee, employer);
}
pub relation terminated_after_becoming_disabled_within_period(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(3)(A)(i): the individual becomes disabled to perform the services before the close of the 90-day period";
}
pub relation disability_removed_before_close_of_period(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(3)(A)(i): the disability is removed before the close of the period";
}
pub relation taxpayer_fails_to_offer_reemployment(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(3)(A)(i): the taxpayer fails to offer reemployment";
}
pub relation disability_removed_and_reemployment_not_offered_1396d3Ai(employee: Person, employer: Person) kind institutional {
    label en official "section 1396(d)(3)(A)(i): the proviso - the disability is removed and the taxpayer fails to offer reemployment";
}
rule DisabilityProvisoRule(employee: Person, employer: Person) strict {
    label en official "section 1396(d)(3)(A)(i): both conditions of the proviso hold";
    when disability_removed_before_close_of_period(employee, employer);
    when taxpayer_fails_to_offer_reemployment(employee, employer);
    then disability_removed_and_reemployment_not_offered_1396d3Ai(employee, employer);
}
pub relation termination_due_to_misconduct_under_state_law(employee: Person, employer: Person) kind empirical {
    label en official "section 1396(d)(3)(A)(ii): it is determined under the applicable State unemployment compensation law that the termination was due to the misconduct of the individual";
}
pub relation termination_exempt_from_90_day_rule_1396d3A(employee: Person, employer: Person) kind institutional {
    label en official "section 1396(d)(3)(A): paragraph (2)(C) does not apply to the termination";
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "a termination of employment of an individual who before the close of the period referred to in paragraph (2)(C) becomes disabled to perform the services of such employment")
rule DisabilityTerminationExemptRule(employee: Person, employer: Person) defeasible {
    label en official "section 1396(d)(3)(A)(i): a disability termination is exempt unless the proviso applies";
    when relationship_terminated_1396d2C(employee, employer);
    when terminated_after_becoming_disabled_within_period(employee, employer);
    when not_known(disability_removed_and_reemployment_not_offered_1396d3Ai(employee, employer));
    then termination_exempt_from_90_day_rule_1396d3A(employee, employer);
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "the termination was due to the misconduct of such individual")
rule MisconductTerminationExemptRule(employee: Person, employer: Person) defeasible {
    label en official "section 1396(d)(3)(A)(ii): a misconduct termination is exempt";
    when relationship_terminated_1396d2C(employee, employer);
    when termination_due_to_misconduct_under_state_law(employee, employer);
    then termination_exempt_from_90_day_rule_1396d3A(employee, employer);
}
pub relation excluded_short_employment_1396d2C(employee: Person, employer: Person) kind institutional {
    label en official "section 1396(d)(2)(C): an individual employed by the employer for less than 90 days is not a qualified zone employee";
}
@source(IRC_S1396_D, relation = formalizes, coverage = exact, quote = "any individual employed by the employer for less than 90 days")
rule ShortEmploymentTerminatedRule(employee: Person, employer: Person, days: Integer) defeasible {
    label en official "section 1396(d)(2)(C): a terminated employee with under 90 days is excluded unless the (3)(A) exception applies";
    when days_employed_by_employer_1396(employee, employer, days);
    when days < 90;
    when relationship_terminated_1396d2C(employee, employer);
    when not_known(termination_exempt_from_90_day_rule_1396d3A(employee, employer));
    then excluded_short_employment_1396d2C(employee, employer);
}
rule ShortEmploymentOngoingRule(employee: Person, employer: Person, days: Integer) defeasible {
    label en official "section 1396(d)(2)(C): an employee still employed with under 90 days is excluded";
    when days_employed_by_employer_1396(employee, employer, days);
    when days < 90;
    when not_known(relationship_terminated_1396d2C(employee, employer));
    then excluded_short_employment_1396d2C(employee, employer);
}

// =============================================================================
// Section 1397(a)(2), (b)
// =============================================================================

pub relation section_127_payment_to_payee(pay: Transaction, employee: Person, employer: Person, y: TaxableYear, amount: Money, payee: Person) kind empirical {
    label en official "section 1397(a)(2)(A)(i): an amount paid or incurred by an employer which is excludable from the employee's gross income under section 127, and its payee";
}
pub relation relationship_267b_or_707b1_at_10_percent(p: Person, q: Person) kind empirical {
    label en official "section 1397(a)(2)(B): the relationship specified in section 267(b) or 707(b)(1), with 10 percent substituted for 50 percent";
}
pub relation trades_or_businesses_under_common_control_52ab(p: Person, q: Person) kind empirical {
    label en official "section 1397(a)(2)(B): engaged in trades or businesses under common control (within the meaning of section 52(a) and (b))";
}
pub relation related_person_1397a2B(p: Person, q: Person) kind institutional {
    label en official "section 1397(a)(2)(B): a person is related to another person";
}
@source(IRC_S1397_A, relation = formalizes, coverage = exact, quote = "such person and such other person are engaged in trades or businesses under common control (within the meaning of subsections (a) and (b) of section 52)")
rule RelatedByCommonControlRule(p: Person, q: Person) strict {
    label en official "section 1397(a)(2)(B): related by common control";
    when trades_or_businesses_under_common_control_52ab(p, q);
    then related_person_1397a2B(p, q);
}
@source(IRC_S1397_A, relation = formalizes, coverage = exact, quote = "\"10 percent\" shall be substituted for \"50 percent\"")
rule RelatedBy267bRule(p: Person, q: Person) strict {
    label en official "section 1397(a)(2)(B): related under section 267(b) or 707(b)(1) at 10 percent";
    when relationship_267b_or_707b1_at_10_percent(p, q);
    then related_person_1397a2B(p, q);
}
pub relation training_payment_treated_as_wages_1397a2Ai(pay: Transaction, employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1397(a)(2)(A)(i): a section 127 amount treated as wages, only to the extent paid or incurred to a person not related to the employer";
}
@source(IRC_S1397_A, relation = formalizes, coverage = exact, quote = "Any amount paid or incurred by an employer which is excludable from the gross income of an employee under section 127, but only to the extent paid or incurred to a person not related to the employer")
rule Section127WagesRule(pay: Transaction, employee: Person, employer: Person, y: TaxableYear, amount: Money, payee: Person) defeasible {
    label en official "section 1397(a)(2)(A)(i): section 127 amounts paid to an unrelated person are wages";
    when section_127_payment_to_payee(pay, employee, employer, y, amount, payee);
    when not_known(related_person_1397a2B(payee, employer));
    then training_payment_treated_as_wages_1397a2Ai(pay, employee, employer, y, amount);
}
pub relation employee_under_age_19(employee: Person) kind empirical {
    label en official "section 1397(a)(2)(A)(ii): an employee who has not attained the age of 19";
}
pub relation youth_training_program_payment(pay: Transaction, employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1397(a)(2)(A)(ii): an amount paid or incurred by the employer for a youth training program operated in conjunction with local education officials";
}
pub relation youth_training_treated_as_wages_1397a2Aii(pay: Transaction, employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1397(a)(2)(A)(ii): the youth training amount is treated as wages";
}
@source(IRC_S1397_A, relation = formalizes, coverage = exact, quote = "any amount paid or incurred by an employer for any youth training program operated by such employer in conjunction with local education officials")
rule YouthTrainingWagesRule(pay: Transaction, employee: Person, employer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1397(a)(2)(A)(ii): youth training amounts for an employee under 19 are wages";
    when employee_under_age_19(employee);
    when youth_training_program_payment(pay, employee, employer, y, amount);
    then youth_training_treated_as_wages_1397a2Aii(pay, employee, employer, y, amount);
}
pub relation employers_treated_as_single_under_52ab(e1: Person, e2: Person) kind empirical {
    label en official "section 1397(b)(1): employers treated as a single employer under section 52(a) or (b)";
}
pub relation treated_as_single_employer_1397b1(e1: Person, e2: Person) kind institutional {
    label en official "section 1397(b)(1): all such employers are one employer for the subpart";
}
@source(IRC_S1397_B, relation = formalizes, coverage = exact, quote = "all employers treated as a single employer under subsection (a) or (b) of section 52 shall be treated as a single employer for purposes of this subpart")
rule SingleEmployerRule(e1: Person, e2: Person) defeasible {
    label en official "section 1397(b)(1): aggregated employers are one employer";
    when employers_treated_as_single_under_52ab(e1, e2);
    then treated_as_single_employer_1397b1(e1, e2);
}
pub relation group_credit_1397b(grp: Asset, amount: Money) kind empirical {
    label en official "section 1397(b)(2): the credit determined under section 1396 with respect to the single employer";
}
pub relation employer_wages_dollars_1397b(employer: Person, grp: Asset, dollars: Decimal) kind empirical {
    label en official "section 1397(b)(2): the wages of the employer giving rise to the credit";
}
pub relation group_wages_dollars_1397b(grp: Asset, dollars: Decimal) kind empirical {
    label en official "section 1397(b)(2): the wages of the whole group giving rise to the credit";
}
pub relation employer_credit_share_1397b2(employer: Person, grp: Asset, amount: Money) kind institutional {
    label en official "section 1397(b)(2): the employer's proportionate share of the wages giving rise to the credit (six-place ratio, cents HALF_UP)";
}
@source(IRC_S1397_B, relation = formalizes, coverage = exact, quote = "its proportionate share of the wages giving rise to such credit")
rule EmployerCreditShareRule(employer: Person, grp: Asset, credit: Money, own: Decimal, total: Decimal) defeasible {
    label en official "section 1397(b)(2): the group credit times the employer's share of the group wages";
    when group_credit_1397b(grp, credit);
    when employer_wages_dollars_1397b(employer, grp, own);
    when group_wages_dollars_1397b(grp, total);
    when total > 0.0;
    then employer_credit_share_1397b2(employer, grp, round(credit * div_round(own, total, 6, "HALF_UP"), 2, "HALF_UP"));
}

// =============================================================================
// Section 1397A(b), 1397D(b)
// =============================================================================

pub relation qualified_zone_property_ceases_to_be_used_in_zone(prop: Asset, p: Person, on: Date) kind empirical {
    label en official "section 1397A(b): the qualified zone property ceases to be used in an empowerment zone by an enterprise zone business";
}
pub relation section_179_deduction_on_zone_property(prop: Asset, amount: Money) kind empirical {
    label en official "section 179(d)(10) by section 1397A(b): the section 179 deduction taken on the property";
}
pub relation depreciation_that_would_have_been_allowed_without_179(prop: Asset, amount: Money) kind empirical {
    label en official "section 179(d)(10) by section 1397A(b): the depreciation that would have been allowed had the section 179 election not been made";
}
pub relation recapture_on_ceasing_use_1397Ab(prop: Asset, p: Person, amount: Money) kind institutional {
    label en official "section 1397A(b), section 179(d)(10): the excess of the section 179 deduction over the depreciation otherwise allowable is recaptured (rules similar to section 179(d)(10), modelled as that excess)";
}
@source(IRC_S1397A_B, relation = formalizes, coverage = partial, quote = "Rules similar to the rules under section 179(d)(10) shall apply with respect to any qualified zone property which ceases to be used in an empowerment zone by an enterprise zone business")
rule RecaptureOnCeasingUseRule(prop: Asset, p: Person, on: Date, deduction: Money, without: Money) defeasible {
    label en official "section 1397A(b): the recapture when the property leaves the zone (deduction above the depreciation otherwise allowable)";
    when qualified_zone_property_ceases_to_be_used_in_zone(prop, p, on);
    when section_179_deduction_on_zone_property(prop, deduction);
    when depreciation_that_would_have_been_allowed_without_179(prop, without);
    when deduction > without;
    then recapture_on_ceasing_use_1397Ab(prop, p, deduction - without);
}
rule NoRecaptureOnCeasingUseRule(prop: Asset, p: Person, on: Date, deduction: Money, without: Money) defeasible {
    label en official "section 1397A(b): no recapture when the deduction does not exceed the depreciation otherwise allowable";
    when qualified_zone_property_ceases_to_be_used_in_zone(prop, p, on);
    when section_179_deduction_on_zone_property(prop, deduction);
    when depreciation_that_would_have_been_allowed_without_179(prop, without);
    when deduction <= without;
    then recapture_on_ceasing_use_1397Ab(prop, p, 0.00 USD);
}
pub relation sold_and_leased_back_by_taxpayer(prop: Asset, sold_on: Date) kind empirical {
    label en official "section 1397D(b): the property is sold and leased back by the taxpayer";
}
pub relation originally_placed_in_service_on_1397D(prop: Asset, on: Date) kind empirical {
    label en official "section 1397D(b): the date the property was originally placed in service";
}
pub relation first_use_under_leaseback_on(prop: Asset, on: Date) kind empirical {
    label en official "section 1397D(b): the date the property is used under the leaseback";
}
pub relation placed_in_service_date_for_1397D(prop: Asset, on: Date) kind institutional {
    label en official "section 1397D(b): the date treated as the original placement in service for subsection (a)(1)(B)";
}
@source(IRC_S1397D_B, relation = formalizes, coverage = exact, quote = "such property shall be treated as originally placed in service not earlier than the date on which such property is used under the leaseback")
rule SaleLeasebackDateRule(prop: Asset, sold_on: Date, original: Date, leaseback: Date) defeasible {
    label en official "section 1397D(b): a sale-leaseback within 3 months restarts the placement date at the leaseback use (never earlier than the original)";
    when sold_and_leased_back_by_taxpayer(prop, sold_on);
    when originally_placed_in_service_on_1397D(prop, original);
    when first_use_under_leaseback_on(prop, leaseback);
    when sold_on <= add_calendar_period(original, 3 calendar_month);
    when leaseback >= original;
    then placed_in_service_date_for_1397D(prop, leaseback);
}
rule OrdinaryPlacedInServiceRule(prop: Asset, original: Date) defeasible {
    label en official "section 1397D(b): without a timely sale-leaseback the original date stands";
    when originally_placed_in_service_on_1397D(prop, original);
    when not_known(sale_leaseback_within_3_months_1397D(prop));
    then placed_in_service_date_for_1397D(prop, original);
}
pub relation sale_leaseback_within_3_months_1397D(prop: Asset) kind institutional {
    label en unofficial "guard: the sale-leaseback was within 3 months of the original placement in service";
}
rule SaleLeasebackWithinThreeMonthsRule(prop: Asset, sold_on: Date, original: Date) defeasible {
    label en unofficial "guard rule";
    when sold_and_leased_back_by_taxpayer(prop, sold_on);
    when originally_placed_in_service_on_1397D(prop, original);
    when sold_on <= add_calendar_period(original, 3 calendar_month);
    then sale_leaseback_within_3_months_1397D(prop);
}
