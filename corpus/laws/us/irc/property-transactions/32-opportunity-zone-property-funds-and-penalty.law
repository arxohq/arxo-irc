// Stage 3 (IRC-07, A05). Section 1400Z-2(d)-(f) (qualified opportunity fund, qualified
// opportunity zone property, business, mixed investments, related persons, decedents, the
// 90-percent penalty), the Pub. L. 119-21 SEC. 70421(c)(4) amendments to section
// 1400Z-2(d)(2) (G2322), the section 1400Z-2(b)(2)(A) amount of the 2024 text for
// investments made on or before December 31, 2026 (G2323), and the remaining rows of
// section 1400Z-1 (Puerto Rico, the decennial determination date, the 10-year period of
// the 2024 text).
//
// Method. "Substantially all" and "substantially improved" tests are adjudicated facts or
// computed from amounts stated in the text; the applicable start dates of the amended text
// are dates the case supplies for the zone, and the earliest of them defines the
// applicable date of a business (an earliest-of rule).

// =============================================================================
// §1400Z-2(e)(2): related persons (20 percent)
// =============================================================================

use self::{
    Asset,
    CensusTract,
    IRC_S1400Z_1_B,
    IRC_S1400Z_1_F,
    IRC_S1400Z_2_B,
    IRC_S1400Z_2_D,
    IRC_S1400Z_2_E,
    IRC_S1400Z_2_F,
    Person,
    QualifiedOpportunityFundInvestment,
    ZoneBusiness,
    basis_in_investment,
    basis_step_up_5_year,
    basis_step_up_7_year,
    deferred_gain_inclusion_date,
    designation_governed_by_pl119_21,
    determination_period_start,
    fair_market_value_of_investment_on,
    gain_excluded_under_a1A_for_investment,
    investment_governed_by_pl119_21,
    low_income_community_1400z1,
    operates_facility_in_144c6B,
    qualified_opportunity_zone_1400z1,
};

pub relation related_under_267b_with_20_percent(p: Person, q: Person) kind empirical {
    label en official "section 1400Z-2(e)(2): the persons are described in section 267(b), with \"20 percent\" substituted for \"50 percent\" (a section 267 computation of another owner: a case fact)";
}
pub relation related_under_707b1_with_20_percent(p: Person, q: Person) kind empirical {
    label en official "section 1400Z-2(e)(2): the persons are described in section 707(b)(1), with \"20 percent\" substituted for \"50 percent\"";
}
pub relation related_persons_1400z2e2(p: Person, q: Person) kind institutional {
    label en official "section 1400Z-2(e)(2): the persons are related for purposes of the section";
}
@source(IRC_S1400Z_2_E, relation = formalizes, coverage = exact, quote = "For purposes of this section, persons are related to each other if such persons are described in section 267(b) or 707(b)(1), determined by substituting \"20 percent\" for \"50 percent\" each place it occurs in such sections.")
rule RelatedBy267Rule(p: Person, q: Person) defeasible {
    label en official "section 1400Z-2(e)(2), section 267(b) limb";
    when related_under_267b_with_20_percent(p, q);
    then related_persons_1400z2e2(p, q);
}
rule RelatedBy707Rule(p: Person, q: Person) defeasible {
    label en official "section 1400Z-2(e)(2), section 707(b)(1) limb";
    when related_under_707b1_with_20_percent(p, q);
    then related_persons_1400z2e2(p, q);
}

// =============================================================================
// §1400Z-2(d)(3): qualified opportunity zone business
// =============================================================================

pub relation substantially_all_tangible_property_is_qozbp(b: ZoneBusiness) kind empirical {
    label en official "section 1400Z-2(d)(3)(A)(i): substantially all of the tangible property owned or leased by the business is qualified opportunity zone business property, determined by substituting \"qualified opportunity zone business\" for \"qualified opportunity fund\" in paragraph (2)(D) (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation qozb_gross_income_share_from_active_conduct(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "section 1397C(b)(2), applied by section 1400Z-2(d)(3)(A)(ii): the share of total gross income derived from the active conduct of a trade or business";
}
pub relation qozb_substantial_intangibles_in_active_conduct(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(b)(4), applied by section 1400Z-2(d)(3)(A)(ii): a substantial portion of the intangible property is used in the active conduct of the business";
}
pub relation qozb_nonqualified_financial_property_share(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "section 1397C(b)(8), applied by section 1400Z-2(d)(3)(A)(ii): the share of the average aggregate unadjusted bases attributable to nonqualified financial property";
}
pub relation qualified_opportunity_zone_business(b: ZoneBusiness) kind institutional {
    label en official "section 1400Z-2(d)(3)(A): a qualified opportunity zone business";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "The term \"qualified opportunity zone business\" means a trade or business—")
rule QualifiedOpportunityZoneBusinessRule(b: ZoneBusiness, income: Decimal, financial: Decimal) defeasible {
    label en official "section 1400Z-2(d)(3)(A)(i)-(iii): substantially all tangible property in QOZBP, section 1397C(b)(2), (4), (8) tests, and not a section 144(c)(6)(B) facility";
    when substantially_all_tangible_property_is_qozbp(b);
    when qozb_gross_income_share_from_active_conduct(b, income);
    when income >= 0.50;
    when qozb_substantial_intangibles_in_active_conduct(b);
    when qozb_nonqualified_financial_property_share(b, financial);
    when financial < 0.05;
    when not_known(operates_facility_in_144c6B(b));
    then qualified_opportunity_zone_business(b);
}
pub relation property_ceases_to_be_qozbp_on(a: Asset, on: Date) kind empirical {
    label en official "section 1400Z-2(d)(3)(B): the date on which the tangible property ceases to be qualified opportunity zone business property";
}
pub relation property_no_longer_held_by_qozb_on(a: Asset, on: Date) kind empirical {
    label en official "section 1400Z-2(d)(3)(B)(ii): the date on which the property is no longer held by the business";
}
pub relation continued_qozbp_treatment_tested_on(a: Asset, on: Date) kind empirical {
    label en official "the date for which the continued treatment as qualified opportunity zone business property is asked";
}
pub relation continues_to_be_treated_as_qozbp(a: Asset) kind institutional {
    label en official "section 1400Z-2(d)(3)(B): the property continues to be treated as qualified opportunity zone business property for the lesser of 5 years after it ceases to qualify and the date it is no longer held";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "(i) 5 years after the date on which such tangible property ceases to be so qualified, or")
rule ContinuedTreatmentWhileHeldRule(a: Asset, ceased: Date, today: Date) defeasible {
    label en official "section 1400Z-2(d)(3)(B)(i): within 5 years of ceasing, and still held";
    when property_ceases_to_be_qozbp_on(a, ceased);
    when continued_qozbp_treatment_tested_on(a, today);
    when today < add_calendar_period(ceased, 5 calendar_year);
    when not_known(property_disposed_by_qozb(a));
    then continues_to_be_treated_as_qozbp(a);
}
pub relation property_disposed_by_qozb(a: Asset) kind institutional {
    label en unofficial "the property has left the business by the tested date";
}
rule PropertyDisposedRule(a: Asset, gone: Date, today: Date) defeasible {
    label en unofficial "helper";
    when property_no_longer_held_by_qozb_on(a, gone);
    when continued_qozbp_treatment_tested_on(a, today);
    when today >= gone;
    then property_disposed_by_qozb(a);
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "(ii) the date on which such tangible property is no longer held by the qualified opportunity zone business.")
rule ContinuedTreatmentUntilDisposalRule(a: Asset, ceased: Date, gone: Date, today: Date) defeasible {
    label en official "section 1400Z-2(d)(3)(B)(ii): the property leaves the business before the 5 years end";
    when property_ceases_to_be_qozbp_on(a, ceased);
    when property_no_longer_held_by_qozb_on(a, gone);
    when continued_qozbp_treatment_tested_on(a, today);
    when today < gone;
    when today < add_calendar_period(ceased, 5 calendar_year);
    then continues_to_be_treated_as_qozbp(a);
}

// =============================================================================
// §1400Z-2(d)(2): qualified opportunity zone property (2024 text and SEC. 70421(c)(4))
// =============================================================================

pub relation acquired_by_fund_on(a: Asset, on: Date) kind empirical {
    label en official "the date the qualified opportunity fund acquired the stock, interest or property";
}
pub relation issuer_business_of(a: Asset, b: ZoneBusiness) kind empirical {
    label en official "the corporation or partnership that issued the stock or interest is the business";
}
pub relation business_property_start_date_1400z2(b: ZoneBusiness, prop: Asset, on: Date) kind empirical {
    label en official "section 1400Z-2(d)(2)(E): the date described in subparagraph (D)(i)(I) - the applicable start date of the zone of the qualified opportunity zone business property held by the business";
}
pub relation earlier_business_start_date_exists(b: ZoneBusiness, on: Date) kind institutional {
    label en unofficial "a strictly earlier property start date exists (the earliest-of pattern)";
}
rule EarlierBusinessStartDateRule(b: ZoneBusiness, p1: Asset, on: Date, p2: Asset, other: Date) defeasible {
    label en unofficial "helper";
    when business_property_start_date_1400z2(b, p1, on);
    when business_property_start_date_1400z2(b, p2, other);
    when other < on;
    then earlier_business_start_date_exists(b, on);
}
pub relation applicable_date_1400z2d2E(b: ZoneBusiness, on: Date) kind institutional {
    label en official "section 1400Z-2(d)(2)(E) (SEC. 70421(c)(4)(B)(ii)): the applicable date - the earliest date described in (D)(i)(I) for the property held by the qualified opportunity zone business";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "the earliest date described in subparagraph (D)(i)(I) with respect to the qualified opportunity zone business property held by such qualified opportunity zone business.")
rule ApplicableDateRule(b: ZoneBusiness, p: Asset, on: Date) defeasible {
    label en official "SEC. 70421(c)(4)(B)(ii): the earliest start date over the business's property";
    when business_property_start_date_1400z2(b, p, on);
    when not_known(earlier_business_start_date_exists(b, on));
    then applicable_date_1400z2d2E(b, on);
}
pub relation zone_applicable_start_date_of_property(a: Asset, on: Date) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(i)(I) (as amended): the applicable start date (section 1400Z-1(e)(2)) of the qualified opportunity zone described in subclause (III) for the property";
}
pub relation qualifying_date_for_stock_or_interest(a: Asset, on: Date) kind institutional {
    label en official "section 1400Z-2(d)(2)(B)(i)(I), (C)(i): the date the acquisition must follow - December 31, 2017, or for property acquired after December 31, 2026 the applicable date of the issuer";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "(i) by striking “December 31, 2017,” each place it appears in subparagraphs (B)(i)(I) and (C)(i) and inserting “the applicable date”, and")
rule QualifyingDateStockOldRule(a: Asset, acquired: Date) defeasible {
    label en official "SEC. 70421(c)(5)(B): acquired on or before December 31, 2026 - the 2024 text date";
    when acquired_by_fund_on(a, acquired);
    when acquired <= @2026-12-31;
    then qualifying_date_for_stock_or_interest(a, @2017-12-31);
}
rule QualifyingDateStockNewRule(a: Asset, acquired: Date, b: ZoneBusiness, on: Date) defeasible {
    label en official "SEC. 70421(c)(5)(B): acquired after December 31, 2026 - the applicable date of the issuing business";
    when acquired_by_fund_on(a, acquired);
    when acquired > @2026-12-31;
    when issuer_business_of(a, b);
    when applicable_date_1400z2d2E(b, on);
    then qualifying_date_for_stock_or_interest(a, on);
}
pub relation qualifying_date_for_business_property(a: Asset, on: Date) kind institutional {
    label en official "section 1400Z-2(d)(2)(D)(i)(I): the date the purchase must follow - December 31, 2017, or for property acquired after December 31, 2026 the applicable start date of the zone";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "Section 1400Z-2(d)(2)(D)(i)(I) is amended by striking “December 31, 2017” and inserting “the applicable start date (as defined in section 1400Z-1(e)(2)) with respect to the qualified opportunity zone described in subclause (III)”.")
rule QualifyingDatePropertyOldRule(a: Asset, acquired: Date) defeasible {
    label en official "SEC. 70421(c)(5)(B): acquired on or before December 31, 2026 - the 2024 text date";
    when acquired_by_fund_on(a, acquired);
    when acquired <= @2026-12-31;
    then qualifying_date_for_business_property(a, @2017-12-31);
}
rule QualifyingDatePropertyNewRule(a: Asset, acquired: Date, start: Date) defeasible {
    label en official "SEC. 70421(c)(5)(B): acquired after December 31, 2026 - the applicable start date of the zone";
    when acquired_by_fund_on(a, acquired);
    when acquired > @2026-12-31;
    when zone_applicable_start_date_of_property(a, start);
    then qualifying_date_for_business_property(a, start);
}
// stock
pub relation qozp_candidate_is_stock_of_domestic_corporation(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(B)(i): the asset is stock in a domestic corporation";
}
pub relation acquired_at_original_issue_solely_for_cash(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(B)(i)(I), (C)(i): acquired by the fund at original issue (directly or through an underwriter) from the corporation, or from the partnership, solely in exchange for cash";
}
pub relation issuer_was_qozb_or_being_organized_as_one_at_issue(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(B)(i)(II), (C)(ii): as of the time of issue the corporation or partnership was a qualified opportunity zone business (or, if new, being organized for that purpose)";
}
pub relation issuer_qozb_during_substantially_all_of_holding_period(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(B)(i)(III), (C)(iii): during substantially all of the fund's holding period the issuer qualified as a qualified opportunity zone business (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation redemption_rule_1202c3_disqualifies(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(B)(ii): a rule similar to section 1202(c)(3) (redemptions) applies - the stock is disqualified by the redemption rule (a case fact from the section 1202(c)(3) analysis)";
}
pub relation qualified_opportunity_zone_stock(a: Asset) kind institutional {
    label en official "section 1400Z-2(d)(2)(B): qualified opportunity zone stock";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), the term \"qualified opportunity zone stock\" means any stock in a domestic corporation if—")
rule QualifiedOpportunityZoneStockRule(a: Asset, acquired: Date, date: Date) defeasible {
    label en official "section 1400Z-2(d)(2)(B)(i)(I)-(III) with the (ii) redemption rule and the applicable date";
    when qozp_candidate_is_stock_of_domestic_corporation(a);
    when acquired_by_fund_on(a, acquired);
    when qualifying_date_for_stock_or_interest(a, date);
    when acquired > date;
    when acquired_at_original_issue_solely_for_cash(a);
    when issuer_was_qozb_or_being_organized_as_one_at_issue(a);
    when issuer_qozb_during_substantially_all_of_holding_period(a);
    when not_known(redemption_rule_1202c3_disqualifies(a));
    then qualified_opportunity_zone_stock(a);
}
pub relation qozp_candidate_is_capital_or_profits_interest_in_domestic_partnership(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(C): the asset is a capital or profits interest in a domestic partnership";
}
pub relation qualified_opportunity_zone_partnership_interest(a: Asset) kind institutional {
    label en official "section 1400Z-2(d)(2)(C): a qualified opportunity zone partnership interest";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "The term \"qualified opportunity zone partnership interest\" means any capital or profits interest in a domestic partnership if—")
rule QualifiedOpportunityZonePartnershipInterestRule(a: Asset, acquired: Date, date: Date) defeasible {
    label en official "section 1400Z-2(d)(2)(C)(i)-(iii) with the applicable date";
    when qozp_candidate_is_capital_or_profits_interest_in_domestic_partnership(a);
    when acquired_by_fund_on(a, acquired);
    when qualifying_date_for_stock_or_interest(a, date);
    when acquired > date;
    when acquired_at_original_issue_solely_for_cash(a);
    when issuer_was_qozb_or_being_organized_as_one_at_issue(a);
    when issuer_qozb_during_substantially_all_of_holding_period(a);
    then qualified_opportunity_zone_partnership_interest(a);
}
// business property
pub relation acquired_by_purchase_179d2(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(i)(I): the property was acquired by the fund by purchase (section 179(d)(2)); paragraph (D)(iii) applies the related-person rule of (e)(2) in place of section 179(d)(2)(A)";
}
pub relation acquired_from_related_person_20_percent(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(iii): the property was acquired from a person related to the fund under section 1400Z-2(e)(2)";
}
pub relation original_use_in_zone_commences_with_fund(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(i)(II): the original use of the property in the qualified opportunity zone commences with the fund";
}
pub relation additions_to_basis_in_30_month_period(a: Asset, amount: Money) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(ii): the additions to basis in the hands of the fund during a 30-month period beginning after the date of acquisition";
}
pub relation adjusted_basis_at_start_of_30_month_period(a: Asset, amount: Money) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(ii): the adjusted basis of the property at the beginning of the 30-month period in the hands of the fund";
}
pub relation property_in_zone_comprised_entirely_of_rural_area(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(ii) (as amended): the property is in a qualified opportunity zone comprised entirely of a rural area (section 1400Z-2(b)(2)(C)(ii))";
}
pub relation substantial_improvement_tested_on(a: Asset, on: Date) kind empirical {
    label en official "the date for which the 30-month test is applied (the rural 50-percent rule takes effect on the date of enactment, July 4, 2025: SEC. 70421(c)(5)(C))";
}
pub relation substantially_improved_by_fund(a: Asset) kind institutional {
    label en official "section 1400Z-2(d)(2)(D)(ii): the property is substantially improved by the fund - additions exceed the adjusted basis (50 percent of it for rural-zone property from the enactment date)";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = partial, quote = "For purposes of subparagraph (A)(ii), property shall be treated as substantially improved by the qualified opportunity fund only if, during any 30-month period beginning after the date of acquisition of such property, additions to basis with respect to such property in the hands of the qualified opportunity fund exceed an amount equal to the adjusted basis of such property at the beginning of such 30-month period in the hands of the qualified opportunity fund.")
rule SubstantialImprovementOrdinaryRule(a: Asset, added: Money, basis: Money) defeasible {
    label en official "section 1400Z-2(d)(2)(D)(ii): additions above the whole adjusted basis";
    when additions_to_basis_in_30_month_period(a, added);
    when adjusted_basis_at_start_of_30_month_period(a, basis);
    when added > basis;
    when not_known(property_in_zone_comprised_entirely_of_rural_area(a));
    then substantially_improved_by_fund(a);
}
rule SubstantialImprovementRuralBeforeEnactmentRule(a: Asset, added: Money, basis: Money, on: Date) defeasible {
    label en official "section 1400Z-2(d)(2)(D)(ii): a rural-zone property tested before July 4, 2025 keeps the whole-basis test";
    when additions_to_basis_in_30_month_period(a, added);
    when adjusted_basis_at_start_of_30_month_period(a, basis);
    when property_in_zone_comprised_entirely_of_rural_area(a);
    when substantial_improvement_tested_on(a, on);
    when on < @2025-07-04;
    when added > basis;
    then substantially_improved_by_fund(a);
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "(C) Special rule for improvement of existing structures in rural areas.—Section 1400Z–2(d)(2)(D)(ii) is amended by inserting “(50 percent of such adjusted basis in the case of property in a qualified opportunity zone comprised entirely of a rural area (as defined in subsection (b)(2)(C)(ii))” after “the adjusted basis of such property”.")
rule SubstantialImprovementRuralRule(a: Asset, added: Money, basis: Money, on: Date) defeasible {
    label en official "SEC. 70421(c)(4)(C), (c)(5)(C): 50 percent of the adjusted basis for rural-zone property from the enactment date";
    when additions_to_basis_in_30_month_period(a, added);
    when adjusted_basis_at_start_of_30_month_period(a, basis);
    when property_in_zone_comprised_entirely_of_rural_area(a);
    when substantial_improvement_tested_on(a, on);
    when on >= @2025-07-04;
    when added > basis * 50 percent;
    then substantially_improved_by_fund(a);
}
pub relation substantially_all_use_in_zone_during_substantially_all_holding_period(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(i)(III): during substantially all of the fund's holding period substantially all of the use of the property was in a qualified opportunity zone (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation tangible_property_used_in_trade_or_business_of_fund(a: Asset) kind empirical {
    label en official "section 1400Z-2(d)(2)(D)(i): tangible property used in a trade or business of the qualified opportunity fund";
}
pub relation qualified_opportunity_zone_business_property(a: Asset) kind institutional {
    label en official "section 1400Z-2(d)(2)(D): qualified opportunity zone business property";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "The term \"qualified opportunity zone business property\" means tangible property used in a trade or business of the qualified opportunity fund if—")
rule QozbpOriginalUseRule(a: Asset, acquired: Date, date: Date) defeasible {
    label en official "section 1400Z-2(d)(2)(D)(i)(I)-(III), original use limb";
    when tangible_property_used_in_trade_or_business_of_fund(a);
    when acquired_by_purchase_179d2(a);
    when not_known(acquired_from_related_person_20_percent(a));
    when acquired_by_fund_on(a, acquired);
    when qualifying_date_for_business_property(a, date);
    when acquired > date;
    when original_use_in_zone_commences_with_fund(a);
    when substantially_all_use_in_zone_during_substantially_all_holding_period(a);
    then qualified_opportunity_zone_business_property(a);
}
rule QozbpSubstantialImprovementRule(a: Asset, acquired: Date, date: Date) defeasible {
    label en official "section 1400Z-2(d)(2)(D)(i)(I)-(III), substantial improvement limb";
    when tangible_property_used_in_trade_or_business_of_fund(a);
    when acquired_by_purchase_179d2(a);
    when not_known(acquired_from_related_person_20_percent(a));
    when acquired_by_fund_on(a, acquired);
    when qualifying_date_for_business_property(a, date);
    when acquired > date;
    when substantially_improved_by_fund(a);
    when substantially_all_use_in_zone_during_substantially_all_holding_period(a);
    then qualified_opportunity_zone_business_property(a);
}
pub relation qualified_opportunity_zone_property(a: Asset) kind institutional {
    label en official "section 1400Z-2(d)(2)(A): qualified opportunity zone property";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "The term \"qualified opportunity zone property\" means property which is—")
rule QozpStockRule(a: Asset) defeasible {
    label en official "section 1400Z-2(d)(2)(A)(i)";
    when qualified_opportunity_zone_stock(a);
    then qualified_opportunity_zone_property(a);
}
rule QozpInterestRule(a: Asset) defeasible {
    label en official "section 1400Z-2(d)(2)(A)(ii)";
    when qualified_opportunity_zone_partnership_interest(a);
    then qualified_opportunity_zone_property(a);
}
rule QozpBusinessPropertyRule(a: Asset) defeasible {
    label en official "section 1400Z-2(d)(2)(A)(iii)";
    when qualified_opportunity_zone_business_property(a);
    then qualified_opportunity_zone_property(a);
}

// =============================================================================
// §1400Z-2(d)(1): the qualified opportunity fund
// =============================================================================

pub relation fund_organized_as_corporation_or_partnership_to_invest_in_qozp(fund: Person) kind empirical {
    label en official "section 1400Z-2(d)(1): the vehicle is organized as a corporation or a partnership for the purpose of investing in qualified opportunity zone property (other than another qualified opportunity fund)";
}
pub relation fund_purpose_is_investing_in_another_qof(fund: Person) kind empirical {
    label en official "section 1400Z-2(d)(1): the vehicle invests in another qualified opportunity fund (which is outside the purpose)";
}
pub relation fund_qozp_share_first_six_months(fund: Person, share: Decimal) kind empirical {
    label en official "section 1400Z-2(d)(1)(A): the percentage of qualified opportunity zone property held on the last day of the first 6-month period of the taxable year of the fund";
}
pub relation fund_qozp_share_year_end(fund: Person, share: Decimal) kind empirical {
    label en official "section 1400Z-2(d)(1)(B): the percentage of qualified opportunity zone property held on the last day of the taxable year of the fund";
}
pub relation fund_ninety_percent_average_met(fund: Person) kind institutional {
    label en official "section 1400Z-2(d)(1): the average of the two percentages is at least 90 percent (their sum is at least 180 percent)";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "(A) on the last day of the first 6-month period of the taxable year of the fund, and")
rule NinetyPercentAverageRule(fund: Person, first: Decimal, last: Decimal) defeasible {
    label en official "section 1400Z-2(d)(1)(A)-(B)";
    when fund_qozp_share_first_six_months(fund, first);
    when fund_qozp_share_year_end(fund, last);
    when first + last >= 1.80;
    then fund_ninety_percent_average_met(fund);
}
pub relation qualified_opportunity_fund(fund: Person) kind institutional {
    label en official "section 1400Z-2(d)(1): a qualified opportunity fund";
}
@source(IRC_S1400Z_2_D, relation = formalizes, coverage = exact, quote = "(B) on the last day of the taxable year of the fund.")
rule QualifiedOpportunityFundRule(fund: Person) defeasible {
    label en official "section 1400Z-2(d)(1)";
    when fund_organized_as_corporation_or_partnership_to_invest_in_qozp(fund);
    when not_known(fund_purpose_is_investing_in_another_qof(fund));
    when fund_ninety_percent_average_met(fund);
    then qualified_opportunity_fund(fund);
}

// =============================================================================
// §1400Z-2(e)(1), (3), (4) and (f)
// =============================================================================

pub relation qof_investment_total_amount(inv: QualifiedOpportunityFundInvestment, amount: Money) kind empirical {
    label en official "section 1400Z-2(e)(1): the total investment in the qualified opportunity fund";
}
pub relation qof_investment_elected_gain_amount(inv: QualifiedOpportunityFundInvestment, amount: Money) kind empirical {
    label en official "section 1400Z-2(e)(1): the part of the investment that consists of investments of gain to which an election under subsection (a) is in effect";
}
pub relation separate_investment_election_part(inv: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(e)(1)(A)(i): the separate investment that includes only amounts to which the election applies";
}
pub relation separate_investment_other_part(inv: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(e)(1)(A)(ii): the separate investment consisting of the other amounts";
}
@source(IRC_S1400Z_2_E, relation = formalizes, coverage = exact, quote = "(i) one investment that only includes amounts to which the election under subsection (a) applies, and")
rule SeparateElectionPartRule(inv: QualifiedOpportunityFundInvestment, total: Money, gain: Money) defeasible {
    label en official "section 1400Z-2(e)(1)(A)(i): a mixed investment";
    when qof_investment_total_amount(inv, total);
    when qof_investment_elected_gain_amount(inv, gain);
    when total > gain;
    then separate_investment_election_part(inv, gain);
}
@source(IRC_S1400Z_2_E, relation = formalizes, coverage = exact, quote = "(ii) a separate investment consisting of other amounts, and")
rule SeparateOtherPartRule(inv: QualifiedOpportunityFundInvestment, total: Money, gain: Money) defeasible {
    label en official "section 1400Z-2(e)(1)(A)(ii): the remainder";
    when qof_investment_total_amount(inv, total);
    when qof_investment_elected_gain_amount(inv, gain);
    when total > gain;
    then separate_investment_other_part(inv, total - gain);
}
pub relation subsections_abc_apply_to_election_part_only(inv: QualifiedOpportunityFundInvestment) kind institutional {
    label en official "section 1400Z-2(e)(1)(B): subsections (a), (b) and (c) apply only to the separate investment of the elected amounts";
}
@source(IRC_S1400Z_2_E, relation = formalizes, coverage = exact, quote = "(B) subsections (a), (b), and (c) shall only apply to the investment described in subparagraph (A)(i).")
rule AbcOnlyElectionPartRule(inv: QualifiedOpportunityFundInvestment, amount: Money) defeasible {
    label en official "section 1400Z-2(e)(1)(B)";
    when separate_investment_election_part(inv, amount);
    then subsections_abc_apply_to_election_part_only(inv);
}
pub relation decedent_amount_recognized_not_includible_by_decedent(inv: QualifiedOpportunityFundInvestment, amount: Money) kind empirical {
    label en official "section 1400Z-2(e)(3): an amount recognized under the section, in the case of a decedent, that is not properly includible in the gross income of the decedent";
}
pub relation includible_as_provided_by_section_691(inv: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(e)(3): the amount is includible in gross income as provided by section 691 (owner: gross-income; the section 691 treatment is applied there)";
}
@source(IRC_S1400Z_2_E, relation = formalizes, coverage = exact, quote = "In the case of a decedent, amounts recognized under this section shall, if not properly includible in the gross income of the decedent, be includible in gross income as provided by section 691.")
rule DecedentSection691Rule(inv: QualifiedOpportunityFundInvestment, amount: Money) defeasible {
    label en official "section 1400Z-2(e)(3)";
    when decedent_amount_recognized_not_includible_by_decedent(inv, amount);
    then includible_as_provided_by_section_691(inv, amount);
}
// (f): the penalty
pub relation fund_aggregate_assets_for_month(fund: Person, month_begins: Date, amount: Money) kind empirical {
    label en official "section 1400Z-2(f)(1)(A)(i): the fund's aggregate assets in the month";
}
pub relation fund_qozp_held_for_month(fund: Person, month_begins: Date, amount: Money) kind empirical {
    label en official "section 1400Z-2(f)(1)(A)(ii): the aggregate amount of qualified opportunity zone property held by the fund in the month";
}
pub relation underpayment_rate_6621a2_for_month(month_begins: Date, rate: Decimal) kind empirical {
    label en official "section 1400Z-2(f)(1)(B): the underpayment rate under section 6621(a)(2) for the month (a rate of another owner: a case fact; used as the multiplier the text states, without dividing the annual rate: JUDGMENT CALL)";
}
pub relation fund_fails_ninety_percent_in_month(fund: Person, month_begins: Date) kind institutional {
    label en official "section 1400Z-2(f)(1): the fund fails to meet the 90-percent requirement of subsection (c)(1) in the month";
}
@source(IRC_S1400Z_2_F, relation = formalizes, coverage = exact, quote = "If a qualified opportunity fund fails to meet the 90-percent requirement of subsection (c)(1),[2] the qualified opportunity fund shall pay a penalty for each month it fails to meet the requirement in an amount equal to the product of—")
rule FailsNinetyPercentRule(fund: Person, month: Date, assets: Money, held: Money) defeasible {
    label en official "section 1400Z-2(f)(1): qualified property below 90 percent of aggregate assets";
    when fund_aggregate_assets_for_month(fund, month, assets);
    when fund_qozp_held_for_month(fund, month, held);
    when held < assets * 90 percent;
    then fund_fails_ninety_percent_in_month(fund, month);
}
pub relation ninety_percent_shortfall(fund: Person, month_begins: Date, amount: Money) kind institutional {
    label en official "section 1400Z-2(f)(1)(A): the excess of 90 percent of aggregate assets over the qualified opportunity zone property held";
}
@source(IRC_S1400Z_2_F, relation = formalizes, coverage = exact, quote = "(i) the amount equal to 90 percent of its aggregate assets, over")
rule ShortfallRule(fund: Person, month: Date, assets: Money, held: Money) defeasible {
    label en official "section 1400Z-2(f)(1)(A)(i)-(ii)";
    when fund_aggregate_assets_for_month(fund, month, assets);
    when fund_qozp_held_for_month(fund, month, held);
    when held < assets * 90 percent;
    then ninety_percent_shortfall(fund, month, assets * 90 percent - held);
}
pub relation reasonable_cause_shown_for_failure(fund: Person, month_begins: Date) kind empirical {
    label en official "section 1400Z-2(f)(3): it is shown that the failure is due to reasonable cause (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation ninety_percent_penalty_amount(fund: Person, month_begins: Date, amount: Money) kind institutional {
    label en official "section 1400Z-2(f)(1): the penalty for the month - the shortfall times the underpayment rate (cents HALF_UP: JUDGMENT CALL); none where reasonable cause is shown";
}
@source(IRC_S1400Z_2_F, relation = formalizes, coverage = exact, quote = "(B) the underpayment rate established under section 6621(a)(2) for such month.")
rule PenaltyAmountRule(fund: Person, month: Date, shortfall: Money, rate: Decimal) defeasible {
    label en official "section 1400Z-2(f)(1)(A)-(B)";
    when ninety_percent_shortfall(fund, month, shortfall);
    when underpayment_rate_6621a2_for_month(month, rate);
    when not_known(reasonable_cause_shown_for_failure(fund, month));
    then ninety_percent_penalty_amount(fund, month, round(shortfall * rate, 2, "HALF_UP"));
}
pub relation ninety_percent_penalty_paid(fund: Person, month_begins: Date) kind empirical {
    label en official "section 1400Z-2(f)(1): the fund paid the penalty for the month";
}
@source(IRC_S1400Z_2_F, relation = formalizes, coverage = exact, quote = "If a qualified opportunity fund fails to meet the 90-percent requirement of subsection (c)(1),[2] the qualified opportunity fund shall pay a penalty for each month it fails to meet the requirement in an amount equal to the product of—")
rule NinetyPercentPenaltyDuty(fund: Person, month: Date, amount: Money) defeasible {
    label en official "section 1400Z-2(f)(1): the fund shall pay the penalty for each month of failure; no time for payment is stated, so the window is unbounded";
    when ninety_percent_penalty_amount(fund, month, amount);
    then duty NinetyPercentPenaltyDutyPosition {
        bearer fund;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition ninety_percent_penalty_paid(fund, month);
            window [-infinity, infinity];
        }
    };
}
pub relation fund_is_partnership_1400z2f2(fund: Person) kind empirical {
    label en official "section 1400Z-2(f)(2): the qualified opportunity fund is a partnership";
}
pub relation partner_share_of_distributive_share(fund: Person, partner: Person, share: Decimal) kind empirical {
    label en official "section 1400Z-2(f)(2): the partner's proportion of the distributive share";
}
pub relation partner_penalty_share(fund: Person, partner: Person, month_begins: Date, amount: Money) kind institutional {
    label en official "section 1400Z-2(f)(2): the penalty is taken into account proportionately as part of the distributive share of each partner (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1400Z_2_F, relation = formalizes, coverage = exact, quote = "In the case that the qualified opportunity fund is a partnership, the penalty imposed by paragraph (1) shall be taken into account proportionately as part of the distributive share of each partner of the partnership.")
rule PartnerPenaltyShareRule(fund: Person, partner: Person, month: Date, penalty: Money, share: Decimal) defeasible {
    label en official "section 1400Z-2(f)(2)";
    when fund_is_partnership_1400z2f2(fund);
    when ninety_percent_penalty_amount(fund, month, penalty);
    when partner_share_of_distributive_share(fund, partner, share);
    then partner_penalty_share(fund, partner, month, round(penalty * share, 2, "HALF_UP"));
}

// =============================================================================
// §1400Z-2(b)(2)(A), 2024 text (investments made on or before December 31, 2026)
// =============================================================================

pub relation step_up_5_year_2024_exists(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment) kind institutional {
    label en unofficial "guard: the 5-year step-up of the 2024 text exists";
}
rule StepUp5Year2024ExistsRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, deferred: Money, step: Money) defeasible {
    label en unofficial "helper";
    when basis_step_up_5_year(taxpayer, fund_investment, deferred, step);
    then step_up_5_year_2024_exists(taxpayer, fund_investment);
}
pub relation step_up_7_year_2024_exists(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment) kind institutional {
    label en unofficial "guard: the 7-year step-up of the 2024 text exists";
}
rule StepUp7Year2024ExistsRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, deferred: Money, step: Money) defeasible {
    label en unofficial "helper";
    when basis_step_up_7_year(taxpayer, fund_investment, deferred, step);
    then step_up_7_year_2024_exists(taxpayer, fund_investment);
}
pub relation basis_for_inclusion_2024(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(b)(2)(B) (2024 text): the basis in the investment - zero (or the gain recognized), increased by the 5-year 10 percent and the 7-year 5 percent step-ups";
}
rule BasisForInclusion2024NoStepRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, base: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(B)(i)-(ii): no step-up";
    when not_known(investment_governed_by_pl119_21(fund_investment, taxpayer));
    when basis_in_investment(taxpayer, fund_investment, base);
    when not_known(step_up_5_year_2024_exists(taxpayer, fund_investment));
    then basis_for_inclusion_2024(taxpayer, fund_investment, base);
}
rule BasisForInclusion2024FiveYearRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, base: Money, deferred: Money, step5: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(B)(iii): the 5-year step-up";
    when not_known(investment_governed_by_pl119_21(fund_investment, taxpayer));
    when basis_in_investment(taxpayer, fund_investment, base);
    when basis_step_up_5_year(taxpayer, fund_investment, deferred, step5);
    when not_known(step_up_7_year_2024_exists(taxpayer, fund_investment));
    then basis_for_inclusion_2024(taxpayer, fund_investment, base + step5);
}
rule BasisForInclusion2024SevenYearRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, base: Money, deferred: Money, step5: Money, step7: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(B)(iii)-(iv): the 5-year and the additional 7-year step-ups";
    when not_known(investment_governed_by_pl119_21(fund_investment, taxpayer));
    when basis_in_investment(taxpayer, fund_investment, base);
    when basis_step_up_5_year(taxpayer, fund_investment, deferred, step5);
    when basis_step_up_7_year(taxpayer, fund_investment, deferred, step7);
    then basis_for_inclusion_2024(taxpayer, fund_investment, base + step5 + step7);
}
pub relation amount_includible_2024(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(b)(2)(A) (2024 text): the excess of the lesser of the gain excluded and the fair market value on the inclusion date over the taxpayer's basis";
}
@source(IRC_S1400Z_2_B, relation = formalizes, coverage = exact, quote = "The amount of gain included in gross income under subsection (a)(1)(A) shall be the excess of—")
rule AmountIncludible2024PositiveRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, gain: Money, on: Date, fmv: Money, basis: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(A)(i)-(ii) for an investment made on or before December 31, 2026";
    when not_known(investment_governed_by_pl119_21(fund_investment, taxpayer));
    when gain_excluded_under_a1A_for_investment(taxpayer, fund_investment, gain);
    when deferred_gain_inclusion_date(fund_investment, taxpayer, on);
    when fair_market_value_of_investment_on(fund_investment, on, fmv);
    when basis_for_inclusion_2024(taxpayer, fund_investment, basis);
    when min(gain, fmv) > basis;
    then amount_includible_2024(taxpayer, fund_investment, min(gain, fmv) - basis);
}
rule AmountIncludible2024ZeroRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, gain: Money, on: Date, fmv: Money, basis: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(A): nothing above the basis";
    when not_known(investment_governed_by_pl119_21(fund_investment, taxpayer));
    when gain_excluded_under_a1A_for_investment(taxpayer, fund_investment, gain);
    when deferred_gain_inclusion_date(fund_investment, taxpayer, on);
    when fair_market_value_of_investment_on(fund_investment, on, fmv);
    when basis_for_inclusion_2024(taxpayer, fund_investment, basis);
    when min(gain, fmv) <= basis;
    then amount_includible_2024(taxpayer, fund_investment, 0.00 USD);
}

// =============================================================================
// §1400Z-1: Puerto Rico, decennial determination date, the 10-year period of the 2024 text
// =============================================================================

pub relation tract_in_puerto_rico(tract: CensusTract) kind empirical {
    label en official "section 1400Z-1(b)(3): the population census tract is in Puerto Rico";
}
pub relation puerto_rico_rule_tested_on(tract: CensusTract, on: Date) kind empirical {
    label en official "the date for which the Puerto Rico deemed designation is asked";
}
@source(IRC_S1400Z_1_B, relation = formalizes, coverage = exact, quote = "Each population census tract in Puerto Rico that is a low-income community shall be deemed to be certified and designated as a qualified opportunity zone, effective on the date of the enactment of Public Law 115–97.")
rule PuertoRicoDeemedRule(tract: CensusTract, on: Date) defeasible {
    label en official "section 1400Z-1(b)(3) (2024 text): a low-income Puerto Rico tract is deemed certified and designated from December 22, 2017 until the SEC. 70421(a)(3) repeal takes effect on December 31, 2026 (JUDGMENT CALL on the boundary day)";
    when tract_in_puerto_rico(tract);
    when low_income_community_1400z1(tract);
    when puerto_rico_rule_tested_on(tract, on);
    when on >= @2017-12-22;
    when on < @2026-12-31;
    then qualified_opportunity_zone_1400z1(tract);
}
pub relation puerto_rico_deeming_repealed_for_date(tract: CensusTract) kind institutional {
    label en official "SEC. 70421(a)(3), (a)(5)(B): paragraph (3) is struck, effective December 31, 2026";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "(3) Repeal of special rule for puerto rico.—Section 1400Z-1(b) is amended by striking paragraph (3).")
rule PuertoRicoRepealedRule(tract: CensusTract, on: Date) defeasible {
    label en official "SEC. 70421(a)(3), (a)(5)(B)";
    when tract_in_puerto_rico(tract);
    when puerto_rico_rule_tested_on(tract, on);
    when on >= @2026-12-31;
    then puerto_rico_deeming_repealed_for_date(tract);
}
pub relation decennial_determination_date(on: Date) kind institutional {
    label en official "SEC. 70421(a)(2): the decennial determination date - July 1, 2026 and each July 1 ten years after the preceding one (the first six are listed: a bounded horizon to 2076)";
}
pub relation date_candidate_1400z1(on: Date) kind empirical {
    label en unofficial "a candidate date tested for being a decennial determination date";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "“(i) July 1, 2026, and“(ii) each July 1 of the year that is 10 years after the preceding decennial determination date under this subparagraph.”.")
rule Decennial2026Rule(on: Date) defeasible {
    label en official "SEC. 70421(a)(2)(C)(i)";
    when date_candidate_1400z1(on);
    when on == @2026-07-01;
    then decennial_determination_date(on);
}
rule Decennial2036Rule(on: Date) defeasible {
    label en official "SEC. 70421(a)(2)(C)(ii), first repetition";
    when date_candidate_1400z1(on);
    when on == @2036-07-01;
    then decennial_determination_date(on);
}
rule Decennial2046Rule(on: Date) defeasible {
    label en official "SEC. 70421(a)(2)(C)(ii), second repetition";
    when date_candidate_1400z1(on);
    when on == @2046-07-01;
    then decennial_determination_date(on);
}
rule Decennial2056Rule(on: Date) defeasible {
    label en official "SEC. 70421(a)(2)(C)(ii), third repetition";
    when date_candidate_1400z1(on);
    when on == @2056-07-01;
    then decennial_determination_date(on);
}
rule Decennial2066Rule(on: Date) defeasible {
    label en official "SEC. 70421(a)(2)(C)(ii), fourth repetition";
    when date_candidate_1400z1(on);
    when on == @2066-07-01;
    then decennial_determination_date(on);
}
rule Decennial2076Rule(on: Date) defeasible {
    label en official "SEC. 70421(a)(2)(C)(ii), fifth repetition";
    when date_candidate_1400z1(on);
    when on == @2076-07-01;
    then decennial_determination_date(on);
}
pub relation determination_period_start_is_decennial(tract: CensusTract) kind institutional {
    label en official "SEC. 70421(a)(1): for a designation under the amended text the determination period begins on the decennial determination date";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "(1) Determination period.—Section 1400Z-1(c)(2)(B) is amended by striking “beginning on the date of the enactment of the Tax Cuts and Jobs Act” and inserting “beginning on the decennial determination date”.")
rule DeterminationStartDecennialRule(tract: CensusTract, start: Date) defeasible {
    label en official "SEC. 70421(a)(1)";
    when determination_period_start(tract, start);
    when decennial_determination_date(start);
    then determination_period_start_is_decennial(tract);
}
pub relation first_january_1_on_or_after_designation(tract: CensusTract, on: Date) kind empirical {
    label en official "the first January 1 that falls on or after the date of designation (the year-part arithmetic is supplied by the case; the period arithmetic is derived)";
}
pub relation designation_close_2024(tract: CensusTract, on: Date) kind institutional {
    label en official "section 1400Z-1(f) (2024 text): the designation ends at the close of the 10th calendar year beginning on or after the date of designation";
}
@source(IRC_S1400Z_1_F, relation = formalizes, coverage = exact, quote = "A designation as a qualified opportunity zone shall remain in effect for the period beginning on the date of the designation and ending at the close of the 10th calendar year beginning on or after such date of designation.")
rule DesignationClose2024Rule(tract: CensusTract, jan1: Date, calendar_before_1: Date) defeasible {
    label en official "section 1400Z-1(f): December 31 of the 10th calendar year beginning on or after designation";
    when not_known(designation_governed_by_pl119_21(tract));
    when first_january_1_on_or_after_designation(tract, jan1)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(jan1, 10 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then designation_close_2024(tract, calendar_before_1);
}
