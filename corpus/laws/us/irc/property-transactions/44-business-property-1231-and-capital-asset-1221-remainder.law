// Stage 3b (IRC-07, A05). Section 1231 remainder: (a)(4) inclusion, treated conversions and the
// casualty/theft netting exception, (b)(2) timber, coal and iron ore, (b)(4) unharvested crops, (c)(2)
// non-recaptured net section 1231 losses. Section 1221 remainder: (a)(6) exceptions, (b)(1)
// commodities derivatives dealers, instruments and the specified index, (b)(2)(A) hedging
// transactions, (a)(7) identification.
//
// Method. The five-year ledger of (c)(2) is two `sum all` totals over the per-year losses and the
// per-year recaptured portions the case places in the five most recent preceding years (the
// selection of those years is the case's; the sums are computed). The casualty/theft netting of
// (a)(4)(C) sums per-transaction items the case supplies as empirical facts; module 07's
// involuntary-conversion rules read the resulting exclusion as a guard. Evaluative elements
// (no connection to dealer activities; primarily to manage risk; regularly offers) are
// adjudicated facts (DECISION-0194).

// =============================================================================
// Section 1231(a)(4)(A): inclusion
// =============================================================================

use self::{
    Asset,
    IRC_S1221_A,
    IRC_S1221_B,
    IRC_S1231_A,
    IRC_S1231_B,
    IRC_S1231_C,
    Person,
    TaxableYear,
    Transaction,
    excluded_from_capital_asset,
    held_by,
    loss_recognized,
    non_recaptured_net_section_1231_losses,
    section_1231_gain_transaction,
    section_1231_loss_transaction,
    section_1231b_property,
    section_1256_contract_by_definition,
};

pub relation gain_taken_into_account_in_gross_income(t: Transaction, amount: Money) kind empirical {
    label en official "section 1231(a)(4)(A)(i): the section 1231 gain taken into account in computing gross income";
}
pub relation loss_taken_into_account_in_taxable_income(t: Transaction, amount: Money) kind empirical {
    label en official "section 1231(a)(4)(A)(ii): the section 1231 loss taken into account in computing taxable income (section 1211 not applied)";
}
pub relation section_1231_gain_includible_1231a4Ai(p: Person, y: TaxableYear, t: Transaction, amount: Money) kind institutional {
    label en official "section 1231(a)(4)(A)(i): the gain included only to the extent taken into account in gross income";
}
@source(IRC_S1231_A, relation = formalizes, coverage = exact, quote = "the section 1231 gains shall be included only if and to the extent taken into account in computing gross income")
rule GainIncludibleWithinTakenRule(p: Person, y: TaxableYear, t: Transaction, gain: Money, taken: Money) defeasible {
    label en official "section 1231(a)(4)(A)(i): the lesser of the gain and the amount taken into account in gross income (taken not larger)";
    when section_1231_gain_transaction(p, y, t, gain);
    when gain_taken_into_account_in_gross_income(t, taken);
    when taken <= gain;
    then section_1231_gain_includible_1231a4Ai(p, y, t, taken);
}
rule GainIncludibleAllRule(p: Person, y: TaxableYear, t: Transaction, gain: Money, taken: Money) defeasible {
    label en official "section 1231(a)(4)(A)(i): the whole gain when the amount taken into account is at least the gain";
    when section_1231_gain_transaction(p, y, t, gain);
    when gain_taken_into_account_in_gross_income(t, taken);
    when taken > gain;
    then section_1231_gain_includible_1231a4Ai(p, y, t, gain);
}
pub relation section_1231_loss_includible_1231a4Aii(p: Person, y: TaxableYear, t: Transaction, amount: Money) kind institutional {
    label en official "section 1231(a)(4)(A)(ii): the loss included only to the extent taken into account in taxable income, without the section 1211 limit";
}
@source(IRC_S1231_A, relation = formalizes, coverage = exact, quote = "the section 1231 losses shall be included only if and to the extent taken into account in computing taxable income, except that section 1211 shall not apply")
rule LossIncludibleWithinTakenRule(p: Person, y: TaxableYear, t: Transaction, loss: Money, taken: Money) defeasible {
    label en official "section 1231(a)(4)(A)(ii): the lesser of the loss and the amount taken into account (taken not larger)";
    when section_1231_loss_transaction(p, y, t, loss);
    when loss_taken_into_account_in_taxable_income(t, taken);
    when taken <= loss;
    then section_1231_loss_includible_1231a4Aii(p, y, t, taken);
}
rule LossIncludibleAllRule(p: Person, y: TaxableYear, t: Transaction, loss: Money, taken: Money) defeasible {
    label en official "section 1231(a)(4)(A)(ii): the whole loss when the amount taken into account is at least the loss";
    when section_1231_loss_transaction(p, y, t, loss);
    when loss_taken_into_account_in_taxable_income(t, taken);
    when taken > loss;
    then section_1231_loss_includible_1231a4Aii(p, y, t, loss);
}

// =============================================================================
// Section 1231(a)(4)(B): losses treated as involuntary conversion losses
// =============================================================================

pub relation loss_on_destruction_theft_seizure_requisition_or_condemnation(t: Transaction, p: Person, a: Asset) kind empirical {
    label en official "section 1231(a)(4)(B): a loss (including an uncompensated loss) on the destruction, theft, seizure, requisition or condemnation of the asset";
}
pub relation long_term_capital_asset_held_in_business_or_profit_transaction(a: Asset) kind empirical {
    label en official "section 1231(a)(4)(B)(ii): a capital asset held for more than 1 year in connection with a trade or business or a transaction entered into for profit";
}
pub relation loss_treated_as_involuntary_conversion_loss_1231a4B(t: Transaction, p: Person, a: Asset) kind institutional {
    label en official "section 1231(a)(4)(B): the loss is treated as a loss from a compulsory or involuntary conversion";
}
@source(IRC_S1231_A, relation = formalizes, coverage = exact, quote = "shall be treated as losses from a compulsory or involuntary conversion")
rule LossTreatedAsConversionBusinessPropertyRule(t: Transaction, p: Person, a: Asset) defeasible {
    label en official "section 1231(a)(4)(B)(i): a casualty, theft or seizure loss on property used in the trade or business";
    when loss_on_destruction_theft_seizure_requisition_or_condemnation(t, p, a);
    when section_1231b_property(p, a);
    then loss_treated_as_involuntary_conversion_loss_1231a4B(t, p, a);
}
rule LossTreatedAsConversionCapitalAssetRule(t: Transaction, p: Person, a: Asset) defeasible {
    label en official "section 1231(a)(4)(B)(ii): a casualty, theft or seizure loss on a long-term capital asset held in a business or profit transaction";
    when loss_on_destruction_theft_seizure_requisition_or_condemnation(t, p, a);
    when long_term_capital_asset_held_in_business_or_profit_transaction(a);
    then loss_treated_as_involuntary_conversion_loss_1231a4B(t, p, a);
}
rule Section1231LossFromTreatedConversionRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money) defeasible {
    label en official "section 1231(a)(3)(B) with (a)(4)(B): a recognized loss on a treated conversion is a section 1231 loss";
    when loss_treated_as_involuntary_conversion_loss_1231a4B(t, p, a);
    when loss_recognized(p, t, amount);
    when amount > 0.00 USD;
    when us.irc.core::year_of(p, y);
    when not_known(casualty_theft_conversion_excluded_1231a4C(p, y, t));
    then section_1231_loss_transaction(p, y, t, amount);
}

// =============================================================================
// Section 1231(a)(4)(C): casualty and theft netting
// =============================================================================

pub relation casualty_theft_conversion_item(p: Person, y: TaxableYear, t: Transaction) kind empirical {
    label en official "section 1231(a)(4)(C): an involuntary conversion arising from fire, storm, shipwreck, other casualty or theft of business property or a long-term capital asset held in a business or profit transaction";
}
pub relation casualty_theft_recognized_gain_item(p: Person, y: TaxableYear, t: Transaction, amount: Money) kind empirical {
    label en official "section 1231(a)(4)(C): a recognized gain from such a conversion";
}
pub relation casualty_theft_recognized_loss_item(p: Person, y: TaxableYear, t: Transaction, amount: Money) kind empirical {
    label en official "section 1231(a)(4)(C): a recognized loss from such a conversion";
}
pub relation casualty_theft_conversion_gains_total(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1231(a)(4)(C): the recognized gains from such conversions in the year";
}
pub relation casualty_theft_conversion_losses_total(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1231(a)(4)(C): the recognized losses from such conversions in the year";
}
@source(IRC_S1231_A, relation = formalizes, coverage = exact, quote = "the recognized losses from such conversions exceed the recognized gains from such conversions")
rule CasualtyGainsTotalRule(p: Person, y: TaxableYear, t0: Transaction) defeasible {
    label en official "section 1231(a)(4)(C): the year's casualty and theft conversion gains";
    when casualty_theft_conversion_item(p, y, t0);
    then casualty_theft_conversion_gains_total(p, y,
        sum all amount: Money for t: Transaction where casualty_theft_recognized_gain_item(p, y, t, amount));
}
rule CasualtyLossesTotalRule(p: Person, y: TaxableYear, t0: Transaction) defeasible {
    label en official "section 1231(a)(4)(C): the year's casualty and theft conversion losses";
    when casualty_theft_conversion_item(p, y, t0);
    then casualty_theft_conversion_losses_total(p, y,
        sum all amount: Money for t: Transaction where casualty_theft_recognized_loss_item(p, y, t, amount));
}
pub relation casualty_theft_conversion_excluded_1231a4C(p: Person, y: TaxableYear, t: Transaction) kind institutional {
    label en official "section 1231(a)(4)(C): subsection (a) does not apply to the conversion (gain or loss) when the year's recognized losses exceed the recognized gains";
}
@source(IRC_S1231_A, relation = formalizes, coverage = exact, quote = "this subsection shall not apply to such conversion (whether resulting in gain or loss)")
rule CasualtyConversionExcludedRule(p: Person, y: TaxableYear, t: Transaction, gains: Money, losses: Money) defeasible {
    label en official "section 1231(a)(4)(C): when casualty and theft losses exceed the gains, the conversions fall outside section 1231";
    when casualty_theft_conversion_item(p, y, t);
    when casualty_theft_conversion_gains_total(p, y, gains);
    when casualty_theft_conversion_losses_total(p, y, losses);
    when losses > gains;
    then casualty_theft_conversion_excluded_1231a4C(p, y, t);
}

// =============================================================================
// Section 1231(b)(2), (b)(4)
// =============================================================================

pub relation timber_coal_or_iron_ore_to_which_631_applies(a: Asset) kind empirical {
    label en official "section 1231(b)(2): timber, coal or iron ore with respect to which section 631 applies";
}
@source(IRC_S1231_B, relation = formalizes, coverage = exact, quote = "Such term includes timber, coal, and iron ore with respect to which section 631 applies")
rule Section1231bPropertyFromTimberCoalIronOreRule(p: Person, a: Asset) defeasible {
    label en official "section 1231(b)(2): timber, coal and iron ore under section 631 are property used in the trade or business";
    when held_by(p, a);
    when timber_coal_or_iron_ore_to_which_631_applies(a);
    then section_1231b_property(p, a);
}
pub relation unharvested_crop_on_land(crop: Asset, land: Asset) kind empirical {
    label en official "section 1231(b)(4): an unharvested crop on land";
}
pub relation land_used_in_business_and_held_more_than_1_year(land: Asset) kind empirical {
    label en official "section 1231(b)(4): the land is used in the trade or business and held for more than 1 year";
}
pub relation crop_and_land_disposed_together_to_same_person(t: Transaction, crop: Asset, land: Asset) kind empirical {
    label en official "section 1231(b)(4): the crop and the land are sold or exchanged (or compulsorily or involuntarily converted) at the same time and to the same person";
}
pub relation crop_treated_as_property_used_in_business_1231b4(t: Transaction, crop: Asset) kind institutional {
    label en official "section 1231(b)(4): the crop is considered property used in the trade or business";
}
@source(IRC_S1231_B, relation = formalizes, coverage = exact, quote = "the crop shall be considered as \"property used in the trade or business.\"")
rule UnharvestedCropRule(t: Transaction, crop: Asset, land: Asset) defeasible {
    label en official "section 1231(b)(4): an unharvested crop disposed of with its land is property used in the trade or business";
    when unharvested_crop_on_land(crop, land);
    when land_used_in_business_and_held_more_than_1_year(land);
    when crop_and_land_disposed_together_to_same_person(t, crop, land);
    then crop_treated_as_property_used_in_business_1231b4(t, crop);
}
rule Section1231bPropertyFromCropRule(p: Person, t: Transaction, crop: Asset) defeasible {
    label en official "section 1231(b)(4): the crop is section 1231(b) property";
    when held_by(p, crop);
    when crop_treated_as_property_used_in_business_1231b4(t, crop);
    then section_1231b_property(p, crop);
}

// =============================================================================
// Section 1231(c)(2): non-recaptured net section 1231 losses
// =============================================================================

pub relation prior_year_net_1231_loss(p: Person, prior: TaxableYear, amount: Money) kind empirical {
    label en official "section 1231(c)(2)(A): the net section 1231 loss of one of the 5 most recent preceding taxable years (the case supplies exactly those years)";
}
pub relation prior_year_loss_taken_into_account_under_1231c1(p: Person, prior: TaxableYear, amount: Money) kind empirical {
    label en official "section 1231(c)(2)(B): the portion of a preceding year's loss taken into account under paragraph (1) for the preceding taxable years";
}
pub relation five_year_net_1231_losses(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1231(c)(2)(A): the aggregate net section 1231 losses for the 5 most recent preceding taxable years";
}
@source(IRC_S1231_C, relation = formalizes, coverage = exact, quote = "the aggregate amount of the net section 1231 losses for the 5 most recent preceding taxable years")
rule FiveYearLossesRule(p: Person, y: TaxableYear) defeasible {
    label en official "section 1231(c)(2)(A): the sum of the preceding years' net section 1231 losses";
    when us.irc.core::year_of(p, y);
    then five_year_net_1231_losses(p, y,
        sum all amount: Money for prior: TaxableYear where prior_year_net_1231_loss(p, prior, amount));
}
pub relation five_year_losses_recaptured(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1231(c)(2)(B): the portion of those losses taken into account under paragraph (1) for the preceding years";
}
@source(IRC_S1231_C, relation = formalizes, coverage = exact, quote = "the portion of such losses taken into account under paragraph (1) for such preceding taxable years")
rule FiveYearRecapturedRule(p: Person, y: TaxableYear) defeasible {
    label en official "section 1231(c)(2)(B): the sum of the portions already recaptured";
    when us.irc.core::year_of(p, y);
    then five_year_losses_recaptured(p, y,
        sum all amount: Money for prior: TaxableYear where prior_year_loss_taken_into_account_under_1231c1(p, prior, amount));
}
@source(IRC_S1231_C, relation = formalizes, coverage = exact, quote = "means the excess of")
rule NonRecapturedLossesRule(p: Person, y: TaxableYear, losses: Money, recaptured: Money) defeasible {
    label en official "section 1231(c)(2): the excess of the five-year losses over the portion already recaptured";
    when five_year_net_1231_losses(p, y, losses);
    when five_year_losses_recaptured(p, y, recaptured);
    when losses > recaptured;
    then non_recaptured_net_section_1231_losses(p, y, losses - recaptured);
}
rule NonRecapturedLossesZeroRule(p: Person, y: TaxableYear, losses: Money, recaptured: Money) defeasible {
    label en official "section 1231(c)(2): no excess when the losses are fully recaptured";
    when five_year_net_1231_losses(p, y, losses);
    when five_year_losses_recaptured(p, y, recaptured);
    when losses <= recaptured;
    then non_recaptured_net_section_1231_losses(p, y, 0.00 USD);
}

// =============================================================================
// Section 1221(b)(1): commodities derivatives
// =============================================================================

pub relation regularly_offers_commodities_derivative_positions_to_customers(p: Person) kind empirical {
    label en official "section 1221(b)(1)(A): the person regularly offers to enter into, assume, offset, assign or terminate positions in commodities derivative financial instruments with customers in the ordinary course of a trade or business (an adjudicated element, DECISION-0194)";
}
pub relation commodities_derivatives_dealer_1221b1A(p: Person) kind institutional {
    label en official "section 1221(b)(1)(A): a commodities derivatives dealer";
}
@source(IRC_S1221_B, relation = formalizes, coverage = exact, quote = "regularly offers to enter into, assume, offset, assign, or terminate positions in commodities derivative financial instruments with customers in the ordinary course of a trade or business")
rule CommoditiesDerivativesDealerRule(p: Person) defeasible {
    label en official "section 1221(b)(1)(A): a person that regularly makes a market in commodities derivatives";
    when regularly_offers_commodities_derivative_positions_to_customers(p);
    then commodities_derivatives_dealer_1221b1A(p);
}
pub relation index_is_fixed_rate_price_or_amount(idx: Asset) kind empirical {
    label en official "section 1221(b)(1)(B)(ii)(I): a fixed rate, price or amount";
}
pub relation index_is_variable_rate_price_or_amount(idx: Asset) kind empirical {
    label en official "section 1221(b)(1)(B)(ii)(II): a variable rate, price or amount";
}
pub relation index_based_on_objective_commodity_information(idx: Asset) kind empirical {
    label en official "section 1221(b)(1)(B)(ii): based on current, objectively determinable financial or economic information with respect to commodities";
}
pub relation index_information_within_control_of_a_party(idx: Asset) kind empirical {
    label en official "section 1221(b)(1)(B)(ii): the information is within the control of one of the parties";
}
pub relation index_unique_to_a_partys_circumstances(idx: Asset) kind empirical {
    label en official "section 1221(b)(1)(B)(ii): the information is unique to a party's circumstances";
}
pub relation specified_index_1221b1Bii(idx: Asset) kind institutional {
    label en official "section 1221(b)(1)(B)(ii): a specified index";
}
@source(IRC_S1221_B, relation = formalizes, coverage = exact, quote = "which is based on any current, objectively determinable financial or economic information with respect to commodities which is not within the control of any of the parties to the contract or instrument and is not unique to any of the parties' circumstances")
rule SpecifiedIndexFixedRule(idx: Asset) strict {
    label en official "section 1221(b)(1)(B)(ii)(I): a fixed objective index outside the parties' control and not unique to them";
    when index_is_fixed_rate_price_or_amount(idx);
    when index_based_on_objective_commodity_information(idx);
    when not_known(index_information_within_control_of_a_party(idx));
    when not_known(index_unique_to_a_partys_circumstances(idx));
    then specified_index_1221b1Bii(idx);
}
rule SpecifiedIndexVariableRule(idx: Asset) strict {
    label en official "section 1221(b)(1)(B)(ii)(II): a variable objective index outside the parties' control and not unique to them";
    when index_is_variable_rate_price_or_amount(idx);
    when index_based_on_objective_commodity_information(idx);
    when not_known(index_information_within_control_of_a_party(idx));
    when not_known(index_unique_to_a_partys_circumstances(idx));
    then specified_index_1221b1Bii(idx);
}
pub relation contract_with_respect_to_commodities(a: Asset) kind empirical {
    label en official "section 1221(b)(1)(B)(i): a contract or financial instrument with respect to commodities";
}
pub relation contract_is_stock_partnership_trust_interest_or_debt(a: Asset) kind empirical {
    label en official "section 1221(b)(1)(B)(i): a share of stock, a beneficial interest in a partnership or trust, a note, bond, debenture or other evidence of indebtedness";
}
pub relation contract_references_index(a: Asset, idx: Asset) kind empirical {
    label en official "section 1221(b)(1)(B)(i): the value or settlement price is calculated by or determined by reference to the index";
}
pub relation commodities_derivative_financial_instrument_1221b1B(a: Asset) kind institutional {
    label en official "section 1221(b)(1)(B): a commodities derivative financial instrument";
}
@source(IRC_S1221_B, relation = formalizes, coverage = exact, quote = "the value or settlement price of which is calculated by or determined by reference to a specified index")
rule CommoditiesDerivativeInstrumentRule(a: Asset, idx: Asset) defeasible {
    label en official "section 1221(b)(1)(B)(i): a commodities contract priced by a specified index, other than stock, partnership or trust interests, debt and section 1256 contracts";
    when contract_with_respect_to_commodities(a);
    when contract_references_index(a, idx);
    when specified_index_1221b1Bii(idx);
    when not_known(contract_is_stock_partnership_trust_interest_or_debt(a));
    when not_known(section_1256_contract_by_definition(a));
    then commodities_derivative_financial_instrument_1221b1B(a);
}

// =============================================================================
// Section 1221(a)(6) with (b)(1); (a)(7) with (b)(2)(A)
// =============================================================================

pub relation instrument_has_no_connection_to_dealer_activities(a: Asset) kind empirical {
    label en official "section 1221(a)(6)(A): it is established to the satisfaction of the Secretary that the instrument has no connection to the activities of the dealer as a dealer (an adjudicated element, DECISION-0194)";
}
pub relation instrument_identified_in_dealer_records_in_time(a: Asset) kind empirical {
    label en official "section 1221(a)(6)(B): the instrument is clearly identified in the dealer's records as described in subparagraph (A) before the close of the day it was acquired, originated or entered into (or such other time as regulations prescribe)";
}
pub relation dealer_exception_1221a6AB(a: Asset) kind institutional {
    label en official "section 1221(a)(6)(A)-(B): the exception for an instrument unconnected with the dealer's activities and timely identified";
}
@source(IRC_S1221_A, relation = formalizes, coverage = exact, quote = "such instrument is clearly identified in such dealer's records as being described in subparagraph (A) before the close of the day on which it was acquired, originated, or entered into")
rule DealerExceptionRule(a: Asset) strict {
    label en official "section 1221(a)(6): both the no-connection and the identification conditions are met";
    when instrument_has_no_connection_to_dealer_activities(a);
    when instrument_identified_in_dealer_records_in_time(a);
    then dealer_exception_1221a6AB(a);
}
pub relation commodities_derivative_of_dealer_excluded_1221a6(a: Asset, p: Person) kind institutional {
    label en official "section 1221(a)(6): a commodities derivative financial instrument held by a commodities derivatives dealer, unless excepted";
}
@source(IRC_S1221_A, relation = formalizes, coverage = exact, quote = "any commodities derivative financial instrument held by a commodities derivatives dealer, unless")
rule CommoditiesDerivativeOfDealerRule(a: Asset, p: Person) defeasible {
    label en official "section 1221(a)(6): a dealer's commodities derivative is not a capital asset unless the (A)-(B) exception applies";
    when held_by(p, a);
    when commodities_derivative_financial_instrument_1221b1B(a);
    when commodities_derivatives_dealer_1221b1A(p);
    when not_known(dealer_exception_1221a6AB(a));
    then commodities_derivative_of_dealer_excluded_1221a6(a, p);
}
rule ExcludedFromDerivedCommoditiesDerivativeRule(a: Asset, p: Person) defeasible {
    label en official "section 1221(a)(6): the derived dealer exclusion removes the asset from capital-asset status";
    when commodities_derivative_of_dealer_excluded_1221a6(a, p);
    then excluded_from_capital_asset(a, p);
}
pub relation transaction_in_normal_course_of_business(a: Asset) kind empirical {
    label en official "section 1221(b)(2)(A): the transaction is entered into by the taxpayer in the normal course of the taxpayer's trade or business";
}
pub relation primarily_manages_price_risk_of_ordinary_property(a: Asset) kind empirical {
    label en official "section 1221(b)(2)(A)(i): primarily to manage risk of price changes or currency fluctuations with respect to ordinary property held or to be held (adjudicated, DECISION-0194)";
}
pub relation primarily_manages_borrowing_or_obligation_risk(a: Asset) kind empirical {
    label en official "section 1221(b)(2)(A)(ii): primarily to manage risk of interest rate or price changes or currency fluctuations with respect to borrowings or ordinary obligations (adjudicated, DECISION-0194)";
}
pub relation primarily_manages_other_risk_prescribed_by_regulations(a: Asset) kind empirical {
    label en official "section 1221(b)(2)(A)(iii): primarily to manage other risks the Secretary prescribes in regulations";
}
pub relation hedging_transaction_1221b2A(a: Asset) kind institutional {
    label en official "section 1221(b)(2)(A): a hedging transaction";
}
@source(IRC_S1221_B, relation = formalizes, coverage = exact, quote = "the term \"hedging transaction\" means any transaction entered into by the taxpayer in the normal course of the taxpayer's trade or business primarily")
rule HedgingTransactionOrdinaryPropertyRule(a: Asset) defeasible {
    label en official "section 1221(b)(2)(A)(i): a normal-course transaction primarily managing price risk of ordinary property";
    when transaction_in_normal_course_of_business(a);
    when primarily_manages_price_risk_of_ordinary_property(a);
    then hedging_transaction_1221b2A(a);
}
rule HedgingTransactionBorrowingsRule(a: Asset) defeasible {
    label en official "section 1221(b)(2)(A)(ii): a normal-course transaction primarily managing borrowing or obligation risk";
    when transaction_in_normal_course_of_business(a);
    when primarily_manages_borrowing_or_obligation_risk(a);
    then hedging_transaction_1221b2A(a);
}
rule HedgingTransactionOtherRiskRule(a: Asset) defeasible {
    label en official "section 1221(b)(2)(A)(iii): a normal-course transaction primarily managing a risk prescribed by regulations";
    when transaction_in_normal_course_of_business(a);
    when primarily_manages_other_risk_prescribed_by_regulations(a);
    then hedging_transaction_1221b2A(a);
}
pub relation hedge_identified_before_close_of_day(a: Asset) kind empirical {
    label en official "section 1221(a)(7): the hedging transaction is clearly identified as such before the close of the day it was acquired, originated or entered into (or such other time as regulations prescribe)";
}
pub relation hedge_excluded_1221a7(a: Asset, p: Person) kind institutional {
    label en official "section 1221(a)(7): an identified hedging transaction is not a capital asset";
}
@source(IRC_S1221_A, relation = formalizes, coverage = exact, quote = "any hedging transaction which is clearly identified as such before the close of the day on which it was acquired, originated, or entered into")
rule HedgeExcludedRule(a: Asset, p: Person) defeasible {
    label en official "section 1221(a)(7): a hedging transaction identified in time is excluded";
    when held_by(p, a);
    when hedging_transaction_1221b2A(a);
    when hedge_identified_before_close_of_day(a);
    then hedge_excluded_1221a7(a, p);
}
rule ExcludedFromDerivedHedgeRule(a: Asset, p: Person) defeasible {
    label en official "section 1221(a)(7): the derived hedge exclusion removes the asset from capital-asset status";
    when hedge_excluded_1221a7(a, p);
    then excluded_from_capital_asset(a, p);
}
