// Stage 3 (IRC-07, A05). Additions to modules 18, 23, 24, 26 and 27:
//   * sections 1043(c), 1045(b)(3) and 1397B(b)(4): the unrecognized gain reduces the
//     basis of the replacement property "in the order acquired";
//   * section 1248(b) (the individual's tax limitation), (c)(2) (lower-tier earnings) and
//     (f)(3) (earnings taken under (f) are excluded from (e));
//   * section 1260(a)(2) (the rate groups of the remaining gain) and (b) (the interest
//     charge on the deferral, with the applicable Federal rate of section 1274(d));
//   * section 1258(d)(2)-(4) (applicable rate, built-in loss character, net investment);
//   * section 1236(d) (floor specialists) and section 1237(b)(2), (b)(3), (c);
//   * section 1341(b)(4)-(5) (the loss carrybacks and carryovers).
//
// Method notes. The ordered allocation is exact for any number of properties: each
// property carries the aggregate basis of the properties acquired before it (a case
// fact - a sum over a derived relation is the section 111 subset limit), and its
// reduction is the unrecognized gain left after those earlier bases, at most its own
// basis (a reduction below zero basis is not possible: JUDGMENT CALL, the text says
// only "applied to reduce (in the order acquired)"). Tax computations under section 1
// are supplied by the case (tax on a stated amount as long-term capital gain).

// =============================================================================
// Ordered basis reduction: sections 1043(c), 1045(b)(3), 1397B(b)(4)
// =============================================================================

use self::{
    Asset,
    CapitalLossCharacter,
    FederalRateClass,
    IRC_S1043_C,
    IRC_S1045_B,
    IRC_S1236_D,
    IRC_S1237_A,
    IRC_S1237_B,
    IRC_S1237_C,
    IRC_S1248_B,
    IRC_S1248_C,
    IRC_S1248_F,
    IRC_S1258_D,
    IRC_S1260_A,
    IRC_S1260_B,
    IRC_S1341_B,
    IRC_S1397B_B,
    Person,
    TaxableYear,
    Transaction,
    dealer_gain_is_capital_1236,
    dealer_sells_security,
    earnings_and_profits_attributable_to_stock,
    elects_1043,
    elects_1045,
    elects_1397b,
    gain_realized,
    lot_held_at_least_5_years_or_inherited,
    lot_sold_from_tract,
    published_federal_rate,
    section_1043_recognized_gain,
    section_1045_recognized_gain,
    section_1237_applies_to_lot,
    section_1237_deemed_ordinary_gain,
    section_1248_dividend,
    section_1248b_limitation_available,
    section_1258_built_in_loss,
    section_1260_remaining_long_term_gain,
    section_1397b_recognized_gain,
    tax_for_year_computed_with_deduction,
    tax_under_1341_alternative_5,
    taxpayer_is_c_corporation_1237,
    tract_not_previously_held_primarily_for_sale_and_no_other_real_property_so_held,
};

pub enum OrderedBasisRegime {
    Section1043;
    Section1045;
    Section1397B;
    label en official "the rollover regimes whose unrecognized gain reduces the basis of replacement property in the order acquired (sections 1043(c), 1045(b)(3), 1397B(b)(4))";
}
pub relation ordered_basis_regime_gain(t: Transaction, regime: OrderedBasisRegime, amount: Money) kind institutional {
    label en official "the gain not recognized by reason of the rollover subsection (a): the gain realized less the gain recognized";
}
@source(IRC_S1043_C, relation = formalizes, coverage = partial, quote = "If gain from the sale of any property is not recognized by reason of subsection (a), such gain shall be applied to reduce (in the order acquired) the basis for determining gain or loss of any permitted property which is purchased by the taxpayer during the 60-day period described in subsection (a).")
rule UnrecognizedGain1043Rule(t: Transaction, seller: Person, gain: Money, recognized: Money) defeasible {
    label en official "section 1043(c): the gain not recognized by reason of section 1043(a)";
    when elects_1043(t, seller);
    when gain_realized(seller, t, gain);
    when section_1043_recognized_gain(t, recognized);
    when gain > recognized;
    then ordered_basis_regime_gain(t, Section1043, gain - recognized);
}
@source(IRC_S1045_B, relation = formalizes, coverage = partial, quote = "If gain from any sale is not recognized by reason of subsection (a), such gain shall be applied to reduce (in the order acquired) the basis for determining gain or loss of any qualified small business stock which is purchased by the taxpayer during the 60-day period described in subsection (a).")
rule UnrecognizedGain1045Rule(t: Transaction, seller: Person, gain: Money, recognized: Money) defeasible {
    label en official "section 1045(b)(3): the gain not recognized by reason of section 1045(a)";
    when elects_1045(t, seller);
    when gain_realized(seller, t, gain);
    when section_1045_recognized_gain(t, recognized);
    when gain > recognized;
    then ordered_basis_regime_gain(t, Section1045, gain - recognized);
}
@source(IRC_S1397B_B, relation = formalizes, coverage = partial, quote = "If gain from any sale is not recognized by reason of subsection (a), such gain shall be applied to reduce (in the order acquired) the basis for determining gain or loss of any qualified empowerment zone asset which is purchased by the taxpayer during the 60-day period described in subsection (a).")
rule UnrecognizedGain1397BRule(t: Transaction, p: Person, gain: Money, recognized: Money) defeasible {
    label en official "section 1397B(b)(4): the gain not recognized by reason of section 1397B(a)";
    when elects_1397b(t, p);
    when gain_realized(p, t, gain);
    when section_1397b_recognized_gain(t, recognized);
    when gain > recognized;
    then ordered_basis_regime_gain(t, Section1397B, gain - recognized);
}
pub relation replacement_property_of_regime(t: Transaction, regime: OrderedBasisRegime, a: Asset) kind empirical {
    label en official "the property purchased during the 60-day period: permitted property (section 1043), qualified small business stock (section 1045) or a qualified empowerment zone asset (section 1397B)";
}
pub relation replacement_property_basis_before_reduction(t: Transaction, a: Asset, amount: Money) kind empirical {
    label en official "the basis of the replacement property before the reduction";
}
pub relation basis_of_earlier_acquired_replacement_property(t: Transaction, a: Asset, amount: Money) kind empirical {
    label en official "the aggregate basis of the replacement properties acquired before this one (case-supplied: a sum over a derived relation, the section 111 subset limit)";
}
pub relation ordered_basis_reduction(t: Transaction, regime: OrderedBasisRegime, a: Asset, amount: Money) kind institutional {
    label en official "the reduction of the basis of the replacement property: the unrecognized gain left after the properties acquired earlier, at most the property's own basis";
}
rule OrderedReductionPartialRule(t: Transaction, regime: OrderedBasisRegime, a: Asset, gain: Money, earlier: Money, basis: Money) defeasible {
    label en official "sections 1043(c), 1045(b)(3), 1397B(b)(4): the gain left after earlier properties, capped by the property's own basis";
    when ordered_basis_regime_gain(t, regime, gain);
    when replacement_property_of_regime(t, regime, a);
    when basis_of_earlier_acquired_replacement_property(t, a, earlier);
    when replacement_property_basis_before_reduction(t, a, basis);
    when gain > earlier;
    then ordered_basis_reduction(t, regime, a, min(basis, gain - earlier));
}
rule OrderedReductionExhaustedRule(t: Transaction, regime: OrderedBasisRegime, a: Asset, gain: Money, earlier: Money) defeasible {
    label en official "sections 1043(c), 1045(b)(3), 1397B(b)(4): earlier properties absorbed the whole gain";
    when ordered_basis_regime_gain(t, regime, gain);
    when replacement_property_of_regime(t, regime, a);
    when basis_of_earlier_acquired_replacement_property(t, a, earlier);
    when gain <= earlier;
    then ordered_basis_reduction(t, regime, a, 0.00 USD);
}
pub relation basis_after_ordered_reduction(t: Transaction, regime: OrderedBasisRegime, a: Asset, amount: Money) kind institutional {
    label en official "the basis of the replacement property for determining gain or loss after the reduction";
}
rule BasisAfterOrderedReductionRule(t: Transaction, regime: OrderedBasisRegime, a: Asset, basis: Money, cut: Money) defeasible {
    label en official "sections 1043(c), 1045(b)(3), 1397B(b)(4)";
    when replacement_property_basis_before_reduction(t, a, basis);
    when ordered_basis_reduction(t, regime, a, cut);
    then basis_after_ordered_reduction(t, regime, a, basis - cut);
}
pub relation basis_for_section_1202_purposes(t: Transaction, regime: OrderedBasisRegime, a: Asset, amount: Money) kind institutional {
    label en official "section 1397B(b)(4), last sentence: the paragraph does not apply for purposes of section 1202 - the basis for section 1202 is not reduced under section 1397B";
}
@source(IRC_S1397B_B, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply for purposes of section 1202.")
rule Basis1202Not1397BReducedRule(t: Transaction, a: Asset, basis: Money) defeasible {
    label en official "section 1397B(b)(4), last sentence";
    when replacement_property_of_regime(t, Section1397B, a);
    when replacement_property_basis_before_reduction(t, a, basis);
    then basis_for_section_1202_purposes(t, Section1397B, a, basis);
}
rule Basis1202Reduced1043Rule(t: Transaction, a: Asset, reduced: Money) defeasible {
    label en official "section 1043(c) carries no section 1202 exception: the reduced basis governs";
    when basis_after_ordered_reduction(t, Section1043, a, reduced);
    then basis_for_section_1202_purposes(t, Section1043, a, reduced);
}
rule Basis1202Reduced1045Rule(t: Transaction, a: Asset, reduced: Money) defeasible {
    label en official "section 1045(b)(3) carries no section 1202 exception: the reduced basis governs";
    when basis_after_ordered_reduction(t, Section1045, a, reduced);
    then basis_for_section_1202_purposes(t, Section1045, a, reduced);
}

// =============================================================================
// §1248(b), (c)(2), (f)(3)
// =============================================================================

pub relation pro_rata_share_of_foreign_corporation_1248b1(t: Transaction, share: Decimal) kind empirical {
    label en official "section 1248(b)(1): the pro rata share of the stock sold or exchanged";
}
pub relation domestic_corporation_taxes_1248b1A(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(b)(1)(A): the taxes that would have been paid by the foreign corporation had it been taxed as a domestic corporation (without deduction of, or credit for, the (B) taxes), for the periods the stock was held while it was a controlled foreign corporation, adjusted for distributions and amounts under subpart F (a computation of the regulations: a case fact)";
}
pub relation foreign_income_taxes_paid_1248b1B(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(b)(1)(B): the income, war profits or excess profits taxes paid by the foreign corporation with respect to that income";
}
pub relation section_1248b_paragraph_1_amount(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(b)(1): the pro rata share of the excess of the (A) taxes over the (B) taxes (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1248_B, relation = formalizes, coverage = partial, quote = "(1) a pro rata share of the excess of—")
rule Paragraph1AmountRule(t: Transaction, a: Money, b: Money, share: Decimal) defeasible {
    label en official "section 1248(b)(1)";
    when domestic_corporation_taxes_1248b1A(t, a);
    when foreign_income_taxes_paid_1248b1B(t, b);
    when pro_rata_share_of_foreign_corporation_1248b1(t, share);
    when a > b;
    then section_1248b_paragraph_1_amount(t, round((a - b) * share, 2, "HALF_UP"));
}
rule Paragraph1AmountNoExcessRule(t: Transaction, a: Money, b: Money) defeasible {
    label en official "section 1248(b)(1): no excess, nothing";
    when domestic_corporation_taxes_1248b1A(t, a);
    when foreign_income_taxes_paid_1248b1B(t, b);
    when a <= b;
    then section_1248b_paragraph_1_amount(t, 0.00 USD);
}
pub relation excess_of_dividend_over_paragraph_1(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(b)(2): the dividend under subsection (a) over the (1) amount, the amount included as long-term capital gain for the (2) tax";
}
@source(IRC_S1248_B, relation = formalizes, coverage = partial, quote = "(2) an amount equal to the tax that would result by including in gross income, as gain from the sale or exchange of a capital asset held for more than 1 year, an amount equal to the excess of (A) the amount included in gross income as a dividend under subsection (a), over (B) the amount determined under paragraph (1).")
rule ExcessOverParagraph1Rule(p: Person, t: Transaction, dividend: Money, one: Money) defeasible {
    label en official "section 1248(b)(2)(A)-(B), not below zero";
    when section_1248_dividend(p, t, dividend);
    when section_1248b_paragraph_1_amount(t, one);
    when dividend > one;
    then excess_of_dividend_over_paragraph_1(t, dividend - one);
}
rule ExcessOverParagraph1NoneRule(p: Person, t: Transaction, dividend: Money, one: Money) defeasible {
    label en official "section 1248(b)(2): the (1) amount covers the dividend";
    when section_1248_dividend(p, t, dividend);
    when section_1248b_paragraph_1_amount(t, one);
    when dividend <= one;
    then excess_of_dividend_over_paragraph_1(t, 0.00 USD);
}
pub relation tax_on_amount_as_long_term_capital_gain(t: Transaction, base: Money, tax: Money) kind empirical {
    label en official "section 1248(b)(2): the tax that would result by including the base amount in gross income as gain from the sale of a capital asset held for more than 1 year (a section 1 computation of the case)";
}
pub relation section_1248b_tax_cap(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(b): the sum of the (1) amount and the (2) tax - the cap of the tax attributable to the dividend";
}
rule TaxCapRule(t: Transaction, one: Money, excess: Money, tax: Money) defeasible {
    label en official "section 1248(b)(1)+(2)";
    when section_1248b_paragraph_1_amount(t, one);
    when excess_of_dividend_over_paragraph_1(t, excess);
    when tax_on_amount_as_long_term_capital_gain(t, excess, tax);
    then section_1248b_tax_cap(t, one + tax);
}
pub relation tax_attributable_to_dividend_1248(p: Person, t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(b): the tax attributable to the amount included in gross income as a dividend under subsection (a)";
}
pub relation section_1248b_limited_tax(p: Person, t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(b): the tax attributable to the dividend, not greater than the cap";
}
@source(IRC_S1248_B, relation = formalizes, coverage = partial, quote = "In the case of an individual, if the stock sold or exchanged is a capital asset (within the meaning of section 1221) and has been held for more than 1 year, the tax attributable to an amount included in gross income as a dividend under subsection (a) shall not be greater than a tax equal to the sum of—")
rule LimitedTaxRule(p: Person, t: Transaction, attributable: Money, cap: Money) defeasible {
    label en official "section 1248(b): min(attributable tax, cap) when the limitation is available";
    when section_1248b_limitation_available(p, t);
    when tax_attributable_to_dividend_1248(p, t, attributable);
    when section_1248b_tax_cap(t, cap);
    then section_1248b_limited_tax(p, t, min(attributable, cap));
}
// (c)(2): the lower-tier corporation's earnings
pub relation owns_other_foreign_corporation_stock_958a2_by_reason_of_sold_stock(t: Transaction, other: Person) kind empirical {
    label en official "section 1248(c)(2)(A): by reason of the ownership of the stock sold, the person owned within the meaning of section 958(a)(2) stock of another foreign corporation";
}
pub relation owned_10_percent_of_other_while_cfc_within_5_years(t: Transaction, other: Person) kind empirical {
    label en official "section 1248(c)(2)(B): the person owned (section 958(a)) or was considered as owning (section 958(b)) 10 percent or more of the total combined voting power of the other foreign corporation at any time during the 5-year period ending on the date of the sale, when it was a controlled foreign corporation";
}
pub relation lower_tier_earnings_attributable_to_stock_owned_1248c2C(t: Transaction, other: Person, amount: Money) kind empirical {
    label en official "section 1248(c)(2)(C): the earnings and profits of the other corporation attributable (under regulations) to the stock owned within the meaning of section 958(a)(2) on the date of the sale (or on the date of a sale of the other corporation's stock in the 5-year period)";
}
pub relation lower_tier_earnings_accumulated_post_1962_while_cfc_1248c2D(t: Transaction, other: Person, amount: Money) kind empirical {
    label en official "section 1248(c)(2)(D): the earnings and profits accumulated in taxable years of the other corporation beginning after December 31, 1962, during the periods it was a controlled foreign corporation and the person owned its stock within the meaning of section 958(a)";
}
pub relation lower_tier_earnings_deemed_included_1248c2(t: Transaction, other: Person, amount: Money) kind institutional {
    label en official "section 1248(c)(2): the earnings and profits of the other foreign corporation that satisfy both (C) and (D) are deemed included in the earnings attributable to the stock sold (the lesser of the two case-supplied amounts: JUDGMENT CALL for the overlap)";
}
@source(IRC_S1248_C, relation = formalizes, coverage = partial, quote = "then, for purposes of this section, the earnings and profits of the foreign corporation the stock of which is sold or exchanged which are attributable to the stock sold or exchanged shall be deemed to include the earnings and profits of such other foreign corporation which—")
rule LowerTierEarningsRule(t: Transaction, other: Person, c: Money, d: Money) defeasible {
    label en official "section 1248(c)(2)(A)-(D)";
    when owns_other_foreign_corporation_stock_958a2_by_reason_of_sold_stock(t, other);
    when owned_10_percent_of_other_while_cfc_within_5_years(t, other);
    when lower_tier_earnings_attributable_to_stock_owned_1248c2C(t, other, c);
    when lower_tier_earnings_accumulated_post_1962_while_cfc_1248c2D(t, other, d);
    then lower_tier_earnings_deemed_included_1248c2(t, other, min(c, d));
}
pub relation total_attributable_earnings_1248(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(a), (c)(2): the earnings and profits attributable to the stock sold, with the lower-tier earnings of (c)(2)";
}
rule TotalAttributableWithLowerTierRule(t: Transaction, base: Money, lower: Money, other: Person) defeasible {
    label en official "section 1248(c)(2)";
    when earnings_and_profits_attributable_to_stock(t, base);
    when lower_tier_earnings_deemed_included_1248c2(t, other, lower);
    then total_attributable_earnings_1248(t, base + lower);
}
rule TotalAttributableWithoutLowerTierRule(t: Transaction, base: Money) defeasible {
    label en official "section 1248(a): no lower-tier corporation";
    when earnings_and_profits_attributable_to_stock(t, base);
    when not_known(lower_tier_present_1248c2(t));
    then total_attributable_earnings_1248(t, base);
}
pub relation lower_tier_present_1248c2(t: Transaction) kind institutional {
    label en unofficial "some lower-tier earnings are deemed included";
}
rule LowerTierPresentRule(t: Transaction, other: Person, amount: Money) defeasible {
    label en unofficial "helper";
    when lower_tier_earnings_deemed_included_1248c2(t, other, amount);
    then lower_tier_present_1248c2(t);
}
// (f)(3)
pub relation earnings_attributable_under_1248e(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(e): the earnings and profits taken into account for the sale of domestic holding company stock";
}
pub relation earnings_taken_into_account_under_1248f(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(f): the earnings and profits taken into account for the distribution of foreign stock";
}
pub relation earnings_for_1248e_after_f3_exclusion(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(f)(3): earnings taken into account under subsection (f) are excluded and not taken into account for subsection (e)";
}
@source(IRC_S1248_F, relation = formalizes, coverage = exact, quote = "To the extent that earnings and profits are taken into account under this subsection, they shall be excluded and not taken into account for purposes of subsection (e).")
rule EarningsAfterFExclusionRule(t: Transaction, e: Money, f: Money) defeasible {
    label en official "section 1248(f)(3): (e) earnings less (f) earnings, not below zero";
    when earnings_attributable_under_1248e(t, e);
    when earnings_taken_into_account_under_1248f(t, f);
    when e > f;
    then earnings_for_1248e_after_f3_exclusion(t, e - f);
}
rule EarningsAfterFExclusionExhaustedRule(t: Transaction, e: Money, f: Money) defeasible {
    label en official "section 1248(f)(3): the (f) earnings exhaust the (e) earnings";
    when earnings_attributable_under_1248e(t, e);
    when earnings_taken_into_account_under_1248f(t, f);
    when e <= f;
    then earnings_for_1248e_after_f3_exclusion(t, 0.00 USD);
}

// =============================================================================
// §1260(a)(2) and (b)
// =============================================================================

pub enum GainRateGroup1260 {
    OrdinaryLongTermRates;
    UnrecapturedSection1250;
    Collectibles28;
    QualifiedSmallBusiness28;
    label en official "the groups of long-term capital gain taxed at distinct rates under section 1(h)";
}
pub relation underlying_gain_share_in_rate_group(p: Person, asset: Asset, group: GainRateGroup1260, share: Decimal) kind empirical {
    label en official "section 1260(a)(2): the share of the net underlying long-term capital gain that would have been taxed at the group's rate (shares sum to 1)";
}
pub relation remaining_gain_in_rate_group(p: Person, asset: Asset, group: GainRateGroup1260, amount: Money) kind institutional {
    label en official "section 1260(a)(2): the remaining long-term gain taxed at the rate that would have applied to the net underlying gain, pro rata by group (cents HALF_UP: JUDGMENT CALL; a rounding remainder is not reallocated)";
}
@source(IRC_S1260_A, relation = formalizes, coverage = partial, quote = "(2) to the extent such gain is treated as a long-term capital gain after the application of paragraph (1), the determination of the capital gain rate (or rates) applicable to such gain under section 1(h) shall be determined on the basis of the respective rate (or rates) that would have been applicable to the net underlying long-term capital gain.")
rule RemainingGainInRateGroupRule(p: Person, asset: Asset, group: GainRateGroup1260, remaining: Money, share: Decimal) defeasible {
    label en official "section 1260(a)(2)";
    when section_1260_remaining_long_term_gain(p, asset, remaining);
    when underlying_gain_share_in_rate_group(p, asset, group, share);
    then remaining_gain_in_rate_group(p, asset, group, round(remaining * share, 2, "HALF_UP"));
}
// (b): the interest charge
pub relation constructive_ownership_opened_on(p: Person, asset: Asset, on: Date) kind empirical {
    label en official "the date the constructive ownership transaction was opened";
}
pub relation constructive_ownership_closed_on(p: Person, asset: Asset, on: Date) kind empirical {
    label en official "the date the constructive ownership transaction closed";
}
pub relation constructive_ownership_closing_month_begins(p: Person, asset: Asset, month_begins: Date) kind empirical {
    label en official "section 1260(b)(2): the first day of the calendar month of the day the transaction closed (the rate is that in effect on that day)";
}
pub relation federal_rate_class_of_open_period_1260b3(p: Person, asset: Asset, class: FederalRateClass) kind institutional {
    label en official "section 1260(b)(3): the Federal rate class of a debt instrument with a term equal to the period the transaction was open";
}
rule OpenPeriodShortRule(p: Person, asset: Asset, opened: Date, closed: Date) defeasible {
    label en official "section 1260(b)(3), section 1274(d)(1)(A): not over 3 years";
    when constructive_ownership_opened_on(p, asset, opened);
    when constructive_ownership_closed_on(p, asset, closed);
    when closed <= add_calendar_period(opened, 3 calendar_year);
    then federal_rate_class_of_open_period_1260b3(p, asset, ShortTerm);
}
rule OpenPeriodMidRule(p: Person, asset: Asset, opened: Date, closed: Date) defeasible {
    label en official "section 1260(b)(3), section 1274(d)(1)(A): over 3 years but not over 9 years";
    when constructive_ownership_opened_on(p, asset, opened);
    when constructive_ownership_closed_on(p, asset, closed);
    when closed > add_calendar_period(opened, 3 calendar_year);
    when closed <= add_calendar_period(opened, 9 calendar_year);
    then federal_rate_class_of_open_period_1260b3(p, asset, MidTerm);
}
rule OpenPeriodLongRule(p: Person, asset: Asset, opened: Date, closed: Date) defeasible {
    label en official "section 1260(b)(3), section 1274(d)(1)(A): over 9 years";
    when constructive_ownership_opened_on(p, asset, opened);
    when constructive_ownership_closed_on(p, asset, closed);
    when closed > add_calendar_period(opened, 9 calendar_year);
    then federal_rate_class_of_open_period_1260b3(p, asset, LongTerm);
}
pub relation applicable_federal_rate_1260b3(p: Person, asset: Asset, rate: Decimal) kind institutional {
    label en official "section 1260(b)(3): the applicable Federal rate (compounded semiannually) of the class, in effect on the closing day";
}
@source(IRC_S1260_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (2), the applicable Federal rate is the applicable Federal rate determined under section 1274(d) (compounded semiannually) which would apply to a debt instrument with a term equal to the period the transaction was open.")
rule ApplicableFederalRate1260Rule(p: Person, asset: Asset, class: FederalRateClass, month: Date, rate: Decimal) defeasible {
    label en official "section 1260(b)(3)";
    when federal_rate_class_of_open_period_1260b3(p, asset, class);
    when constructive_ownership_closing_month_begins(p, asset, month);
    when published_federal_rate(class, month, rate);
    then applicable_federal_rate_1260b3(p, asset, rate);
}
pub relation prior_year_interest_1260b2(p: Person, asset: Asset, prior: TaxableYear, amount: Money) kind empirical {
    label en official "section 1260(b)(2): the interest that would have been imposed under section 6601 on the underpayment for the prior taxable year had the gain been included in the years in which it accrued (a constant rate accrual; the section 6601 interest is computed by the payment-refunds-interest owner: a case fact)";
}
pub relation rate_used_for_prior_year_interest_1260b2(p: Person, asset: Asset, rate: Decimal) kind empirical {
    label en official "section 1260(b)(2): the constant accrual rate with which the case computed the prior-year interest";
}
pub relation interest_computed_at_applicable_rate_1260b2(p: Person, asset: Asset) kind institutional {
    label en official "section 1260(b)(2)-(3): the constant accrual rate equals the applicable Federal rate in effect on the closing day";
}
@source(IRC_S1260_B, relation = formalizes, coverage = exact, quote = "(determined by treating the income as accruing at a constant rate equal to the applicable Federal rate as in effect on the day the transaction closed)")
rule InterestRateCheckRule(p: Person, asset: Asset, rate: Decimal) defeasible {
    label en official "section 1260(b)(2)";
    when applicable_federal_rate_1260b3(p, asset, rate);
    when rate_used_for_prior_year_interest_1260b2(p, asset, rate);
    then interest_computed_at_applicable_rate_1260b2(p, asset);
}
pub relation section_1260b_interest_increase(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1260(b)(1): the tax for the year is increased by the interest determined for each prior taxable year during any portion of which the transaction was open (a sum over the case's empirical prior-year interest amounts)";
}
@source(IRC_S1260_B, relation = formalizes, coverage = partial, quote = "If any gain is treated as ordinary income for any taxable year by reason of subsection (a)(1), the tax imposed by this chapter for such taxable year shall be increased by the amount of interest determined under paragraph (2) with respect to each prior taxable year during any portion of which the constructive ownership transaction was open.")
rule InterestIncreaseRule(p: Person, asset: Asset, y: TaxableYear, ordinary: Money) defeasible {
    label en official "section 1260(b)(1)";
    when section_1260_ordinary_income_in_year(p, asset, y, ordinary);
    when ordinary > 0.00 USD;
    when interest_computed_at_applicable_rate_1260b2(p, asset);
    then section_1260b_interest_increase(p, asset, y, sum all amount: Money for prior: TaxableYear where prior_year_interest_1260b2(p, asset, prior, amount));
}
pub relation section_1260_ordinary_income_in_year(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1260(a)(1): the year in which the gain is treated as ordinary income, with the amount";
}
pub relation interest_increase_treated_as_interest_for_deduction(p: Person, asset: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1260(b)(1), last sentence: the amount payable is taken into account in computing any deduction allowable for interest paid or accrued during the year";
}
@source(IRC_S1260_B, relation = formalizes, coverage = exact, quote = "Any amount payable under this paragraph shall be taken into account in computing the amount of any deduction allowable to the taxpayer for interest paid or accrued during such taxable year.")
rule InterestDeductionTreatmentRule(p: Person, asset: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1260(b)(1), last sentence";
    when section_1260b_interest_increase(p, asset, y, amount);
    then interest_increase_treated_as_interest_for_deduction(p, asset, y, amount);
}
pub relation increase_excluded_from_credit_determination(p: Person, asset: Asset, y: TaxableYear) kind institutional {
    label en official "section 1260(b)(4)(A): the increase is not treated as tax imposed by this chapter for the amount of any credit";
}
pub relation increase_excluded_from_section_55_tax(p: Person, asset: Asset, y: TaxableYear) kind institutional {
    label en official "section 1260(b)(4)(B): the increase is not treated as tax imposed by this chapter for the amount of the tax imposed by section 55";
}
@source(IRC_S1260_B, relation = formalizes, coverage = exact, quote = "Any increase in tax under paragraph (1) shall not be treated as tax imposed by this chapter for purposes of determining—")
rule IncreaseExcludedFromCreditsRule(p: Person, asset: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1260(b)(4)(A)";
    when section_1260b_interest_increase(p, asset, y, amount);
    then increase_excluded_from_credit_determination(p, asset, y);
}
rule IncreaseExcludedFromSection55Rule(p: Person, asset: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1260(b)(4)(B)";
    when section_1260b_interest_increase(p, asset, y, amount);
    then increase_excluded_from_section_55_tax(p, asset, y);
}

// =============================================================================
// §1258(d)(2)-(4)
// =============================================================================

pub relation conversion_transaction_term_indefinite(t: Transaction) kind empirical {
    label en official "section 1258(d)(2)(B): the term of the conversion transaction is indefinite";
}
pub relation conversion_transaction_started_on(t: Transaction, on: Date) kind empirical {
    label en official "the date the conversion transaction began";
}
pub relation conversion_transaction_ends_on(t: Transaction, on: Date) kind empirical {
    label en official "the date the conversion transaction ends (its term as if a debt instrument)";
}
pub relation conversion_transaction_month_begins(t: Transaction, month_begins: Date) kind empirical {
    label en official "the first day of the calendar month used to pick the Federal rate (JUDGMENT CALL: the month the transaction began)";
}
pub relation federal_rate_class_of_conversion_transaction(t: Transaction, class: FederalRateClass) kind institutional {
    label en official "section 1258(d)(2)(A): the Federal rate class of a debt instrument with the term of the conversion transaction";
}
rule ConversionClassShortRule(t: Transaction, start: Date, end: Date) defeasible {
    label en official "section 1258(d)(2)(A), section 1274(d)(1)(A): not over 3 years";
    when not_known(conversion_transaction_term_indefinite(t));
    when conversion_transaction_started_on(t, start);
    when conversion_transaction_ends_on(t, end);
    when end <= add_calendar_period(start, 3 calendar_year);
    then federal_rate_class_of_conversion_transaction(t, ShortTerm);
}
rule ConversionClassMidRule(t: Transaction, start: Date, end: Date) defeasible {
    label en official "section 1258(d)(2)(A), section 1274(d)(1)(A): over 3 years but not over 9 years";
    when not_known(conversion_transaction_term_indefinite(t));
    when conversion_transaction_started_on(t, start);
    when conversion_transaction_ends_on(t, end);
    when end > add_calendar_period(start, 3 calendar_year);
    when end <= add_calendar_period(start, 9 calendar_year);
    then federal_rate_class_of_conversion_transaction(t, MidTerm);
}
rule ConversionClassLongRule(t: Transaction, start: Date, end: Date) defeasible {
    label en official "section 1258(d)(2)(A), section 1274(d)(1)(A): over 9 years";
    when not_known(conversion_transaction_term_indefinite(t));
    when conversion_transaction_started_on(t, start);
    when conversion_transaction_ends_on(t, end);
    when end > add_calendar_period(start, 9 calendar_year);
    then federal_rate_class_of_conversion_transaction(t, LongTerm);
}
pub relation federal_short_term_rate_6621b_daily(t: Transaction, rate: Decimal) kind empirical {
    label en official "section 1258(d)(2)(B): the Federal short-term rates in effect under section 6621(b) during the period of the transaction, compounded daily (the rate is a case fact: section 6621(b) rates are not pinned)";
}
pub relation applicable_rate_1258d2(t: Transaction, rate: Decimal) kind institutional {
    label en official "section 1258(d)(2): the applicable rate";
}
@source(IRC_S1258_D, relation = formalizes, coverage = partial, quote = "(A) the applicable Federal rate determined under section 1274(d) (compounded semiannually) as if the conversion transaction were a debt instrument, or")
rule ApplicableRateFederalRule(t: Transaction, class: FederalRateClass, month: Date, rate: Decimal) defeasible {
    label en official "section 1258(d)(2)(A)";
    when federal_rate_class_of_conversion_transaction(t, class);
    when conversion_transaction_month_begins(t, month);
    when published_federal_rate(class, month, rate);
    then applicable_rate_1258d2(t, rate);
}
@source(IRC_S1258_D, relation = formalizes, coverage = partial, quote = "(B) if the term of the conversion transaction is indefinite, the Federal short-term rates in effect under section 6621(b) during the period of the conversion transaction (compounded daily).")
rule ApplicableRateIndefiniteRule(t: Transaction, rate: Decimal) defeasible {
    label en official "section 1258(d)(2)(B)";
    when conversion_transaction_term_indefinite(t);
    when federal_short_term_rate_6621b_daily(t, rate);
    then applicable_rate_1258d2(t, rate);
}
pub relation rate_at_120_percent_of_applicable_rate(t: Transaction, rate: Decimal) kind institutional {
    label en official "section 1258(b)(1): 120 percent of the applicable rate";
}
rule Rate120Rule(t: Transaction, rate: Decimal) defeasible {
    label en official "section 1258(b)(1)";
    when applicable_rate_1258d2(t, rate);
    then rate_at_120_percent_of_applicable_rate(t, rate * 1.20);
}
pub relation position_disposed_in_transaction_recognizing_loss(t: Transaction, pos: Asset, loss: Money) kind empirical {
    label en official "section 1258(d)(3)(A)(ii): the position is disposed of or terminated in a transaction in which loss is recognized, with the loss recognized";
}
pub relation built_in_loss_recognized_with_ordinary_character_rules(t: Transaction, pos: Asset, amount: Money) kind institutional {
    label en official "section 1258(d)(3)(A)(ii): the built-in loss is recognized and has a character determined without regard to this section (the recognized loss up to the built-in loss)";
}
@source(IRC_S1258_D, relation = formalizes, coverage = partial, quote = "(ii) upon the disposition or other termination of such position in a transaction in which gain or loss is recognized, such built-in loss shall be recognized and shall have a character determined without regard to this section.")
rule BuiltInLossRecognizedRule(t: Transaction, pos: Asset, built_in: Money, recognized: Money) defeasible {
    label en official "section 1258(d)(3)(A)(ii)";
    when section_1258_built_in_loss(t, pos, built_in);
    when position_disposed_in_transaction_recognizing_loss(t, pos, recognized);
    then built_in_loss_recognized_with_ordinary_character_rules(t, pos, min(built_in, recognized));
}
pub relation cash_invested_in_conversion_transaction(t: Transaction, amount: Money) kind empirical {
    label en official "the cash the taxpayer invested in the conversion transaction";
}
pub relation position_fair_market_value_when_entering(t: Transaction, pos: Asset, amount: Money) kind empirical {
    label en official "section 1258(d)(4): the fair market value of a position that becomes part of the transaction, determined as of the time it became part";
}
pub relation positions_entering_value_total(t: Transaction, amount: Money) kind institutional {
    label en official "section 1258(d)(4): the sum of the fair market values of the positions entering the transaction (an aggregate over the case's empirical positions)";
}
rule PositionsEnteringTotalRule(t: Transaction, cash: Money) defeasible {
    label en official "section 1258(d)(4): sums the empirical position values (the guard binds the transaction)";
    when cash_invested_in_conversion_transaction(t, cash);
    then positions_entering_value_total(t, sum all amount: Money for pos: Asset where position_fair_market_value_when_entering(t, pos, amount));
}
pub relation net_investment_in_conversion_transaction(t: Transaction, amount: Money) kind institutional {
    label en official "section 1258(d)(4): the net investment includes the fair market value of any position that becomes part of the transaction";
}
@source(IRC_S1258_D, relation = formalizes, coverage = exact, quote = "In determining the taxpayer's net investment in any conversion transaction, there shall be included the fair market value of any position which becomes part of such transaction (determined as of the time such position became part of such transaction).")
rule NetInvestmentRule(t: Transaction, cash: Money, positions: Money) defeasible {
    label en official "section 1258(d)(4)";
    when cash_invested_in_conversion_transaction(t, cash);
    when positions_entering_value_total(t, positions);
    then net_investment_in_conversion_transaction(t, cash + positions);
}

// =============================================================================
// §1236(d): floor specialists
// =============================================================================

pub relation member_of_national_securities_exchange(p: Person) kind empirical {
    label en official "section 1236(d)(2)(A): a member of a national securities exchange";
}
pub relation registered_as_specialist_with_the_exchange(p: Person) kind empirical {
    label en official "section 1236(d)(2)(B): registered as a specialist with the exchange";
}
pub relation meets_sec_requirements_for_specialists(p: Person) kind empirical {
    label en official "section 1236(d)(2)(C): meets the requirements for specialists established by the Securities and Exchange Commission";
}
pub relation floor_specialist_1236(p: Person) kind institutional {
    label en official "section 1236(d)(2): a floor specialist";
}
@source(IRC_S1236_D, relation = formalizes, coverage = exact, quote = "The term \"floor specialist\" means a person who is—")
rule FloorSpecialistRule(p: Person) defeasible {
    label en official "section 1236(d)(2)(A)-(C)";
    when member_of_national_securities_exchange(p);
    when registered_as_specialist_with_the_exchange(p);
    when meets_sec_requirements_for_specialists(p);
    then floor_specialist_1236(p);
}
pub relation security_acquired_in_connection_with_duties_as_registered_specialist(sec: Asset) kind empirical {
    label en official "section 1236(d)(1): the stock was acquired in connection with the specialist's duties on an exchange, and the specialist is registered with the exchange in it";
}
pub relation seventh_business_day_after_acquisition(sec: Asset, on: Date) kind empirical {
    label en official "section 1236(d)(1)(A): the 7th business day following the day of acquisition (the exchange's business-day calendar is the case's)";
}
pub relation security_identified_as_investment_on(sec: Asset, on: Date) kind empirical {
    label en official "the date on which the security was clearly identified in the dealer's records as held for investment";
}
pub relation security_held_primarily_for_sale_after_the_7th_business_day(sec: Asset) kind empirical {
    label en official "section 1236(d)(1)(A) applied to section 1236(a)(2): at any time after the close of the 7th business day the security was held primarily for sale to customers";
}
@source(IRC_S1236_D, relation = formalizes, coverage = exact, quote = "In the case of a floor specialist (but only with respect to acquisitions, in connection with his duties on an exchange, of stock in which the specialist is registered with the exchange), subsection (a) shall be applied—")
rule SpecialistGainCapitalRule(t: Transaction, dealer: Person, sec: Asset, deadline: Date, identified: Date) defeasible {
    label en official "section 1236(d)(1)(A)-(B): identification by the close of the 7th business day (the earlier time the Secretary may prescribe does not apply)";
    when dealer_sells_security(t, dealer, sec);
    when floor_specialist_1236(dealer);
    when security_acquired_in_connection_with_duties_as_registered_specialist(sec);
    when seventh_business_day_after_acquisition(sec, deadline);
    when security_identified_as_investment_on(sec, identified);
    when identified <= deadline;
    when not_known(security_held_primarily_for_sale_after_the_7th_business_day(sec));
    then dealer_gain_is_capital_1236(t, dealer);
}

// =============================================================================
// §1237(b)(2), (b)(3), (c)
// =============================================================================

pub relation expenditures_in_connection_with_lot_sale(t: Transaction, amount: Money) kind empirical {
    label en official "section 1237(b)(2): the expenditures incurred in connection with the sale or exchange of the lot or parcel";
}
pub relation section_1237b2_deduction_allowed(t: Transaction, amount: Money) kind institutional {
    label en official "section 1237(b)(2): so much of the expenditures as does not exceed the portion of gain deemed to be gain from property held primarily for sale is allowed as a deduction";
}
@source(IRC_S1237_B, relation = formalizes, coverage = exact, quote = "but so much of such expenditures as does not exceed the portion of gain deemed under paragraph (1) of this subsection to be gain from the sale of property held primarily for sale to customers in the ordinary course of trade or business shall be so allowed as a deduction, and the remainder, if any, shall be treated as reducing the amount realized on such sale or exchange.")
rule ExpenditureDeductionRule(t: Transaction, spent: Money, deemed: Money) defeasible {
    label en official "section 1237(b)(2): min(expenditures, deemed ordinary gain)";
    when expenditures_in_connection_with_lot_sale(t, spent);
    when section_1237_deemed_ordinary_gain(t, deemed);
    then section_1237b2_deduction_allowed(t, min(spent, deemed));
}
pub relation section_1237b2_reduction_of_amount_realized(t: Transaction, amount: Money) kind institutional {
    label en official "section 1237(b)(2): the remainder of the expenditures reduces the amount realized";
}
@source(IRC_S1237_B, relation = formalizes, coverage = exact, quote = "For the purpose of computing gain under paragraph (1) of this subsection, expenditures incurred in connection with the sale or exchange of any lot or parcel shall neither be allowed as a deduction in computing taxable income, nor treated as reducing the amount realized on such sale or exchange;")
rule ExpenditureRemainderRule(t: Transaction, spent: Money, deemed: Money) defeasible {
    label en official "section 1237(b)(2): the excess over the deemed ordinary gain";
    when expenditures_in_connection_with_lot_sale(t, spent);
    when section_1237_deemed_ordinary_gain(t, deemed);
    when spent > deemed;
    then section_1237b2_reduction_of_amount_realized(t, spent - deemed);
}
rule ExpenditureRemainderNoneRule(t: Transaction, spent: Money, deemed: Money) defeasible {
    label en official "section 1237(b)(2): no remainder";
    when expenditures_in_connection_with_lot_sale(t, spent);
    when section_1237_deemed_ordinary_gain(t, deemed);
    when spent <= deemed;
    then section_1237b2_reduction_of_amount_realized(t, 0.00 USD);
}
pub relation improvement_is_water_sewer_drainage_or_roads(tract: Asset) kind empirical {
    label en official "section 1237(b)(3)(A): the improvement is the building or installation of water, sewer, or drainage facilities or roads";
}
pub relation lot_held_for_10_years(lot: Asset) kind empirical {
    label en official "section 1237(b)(3): the lot or parcel is held by the taxpayer for a period of 10 years";
}
pub relation shown_to_satisfaction_of_secretary_not_marketable_without_improvement(tract: Asset) kind empirical {
    label en official "section 1237(b)(3)(B): it is shown to the satisfaction of the Secretary that the lot, the value of which was substantially enhanced by the improvement, would not have been marketable at the prevailing local price for similar building sites without it (an evaluative element: a determination of the Secretary, DECISION-0194)";
}
pub relation taxpayer_elects_no_basis_adjustment_1237b3(tract: Asset) kind empirical {
    label en official "section 1237(b)(3)(C): the taxpayer elects, in accordance with regulations, to make no adjustment to basis on account of the expenditures for the improvements";
}
pub relation improvement_not_a_substantial_improvement_1237b3(tract: Asset) kind institutional {
    label en official "section 1237(b)(3): the improvement is not deemed a substantial improvement for purposes of subsection (a)";
}
@source(IRC_S1237_B, relation = formalizes, coverage = exact, quote = "No improvement shall be deemed a substantial improvement for purposes of subsection (a) if the lot or parcel is held by the taxpayer for a period of 10 years and if—")
rule NecessaryImprovementRule(tract: Asset, lot: Asset) defeasible {
    label en official "section 1237(b)(3)(A)-(C) with a 10-year holding";
    when lot_part_of_tract(lot, tract);
    when lot_held_for_10_years(lot);
    when improvement_is_water_sewer_drainage_or_roads(tract);
    when shown_to_satisfaction_of_secretary_not_marketable_without_improvement(tract);
    when taxpayer_elects_no_basis_adjustment_1237b3(tract);
    then improvement_not_a_substantial_improvement_1237b3(tract);
}
pub relation lot_part_of_tract(lot: Asset, tract: Asset) kind empirical {
    label en official "the lot or parcel is part of the tract";
}
pub relation substantial_improvement_exists_on_tract(tract: Asset) kind empirical {
    label en official "section 1237(a)(2): a substantial improvement that substantially enhances the value of the lot is made on the tract (before the (b)(3) disregard)";
}
@source(IRC_S1237_A, relation = formalizes, coverage = partial, quote = "shall not be deemed to be held primarily for sale to customers in the ordinary course of trade or business at the time of sale solely because of the taxpayer having subdivided such tract for purposes of sale")
rule Section1237AppliesWithNecessaryImprovementRule(t: Transaction, p: Person, lot: Asset, tract: Asset) defeasible {
    label en official "section 1237(a)(1)-(3) with the (b)(3) disregard of a necessary improvement";
    when lot_sold_from_tract(t, p, lot, tract);
    when not_known(taxpayer_is_c_corporation_1237(p));
    when tract_not_previously_held_primarily_for_sale_and_no_other_real_property_so_held(p, tract);
    when substantial_improvement_exists_on_tract(tract);
    when improvement_not_a_substantial_improvement_1237b3(tract);
    when lot_held_at_least_5_years_or_inherited(lot);
    then section_1237_applies_to_lot(p, lot, tract);
}
pub relation piece_of_real_property(piece: Asset) kind empirical {
    label en official "a piece of real property held by the taxpayer";
}
pub relation pieces_contiguous_in_hands_of_taxpayer_at_any_time(a: Asset, b: Asset) kind empirical {
    label en official "section 1237(c): the two pieces were at any time contiguous in the hands of the taxpayer";
}
pub relation pieces_contiguous_but_for_road_street_railroad_stream(a: Asset, b: Asset) kind empirical {
    label en official "section 1237(c): the two pieces would be contiguous except for the interposition of a road, street, railroad, stream, or similar property";
}
pub relation pieces_form_a_tract_1237c(a: Asset, b: Asset) kind institutional {
    label en official "section 1237(c): the pieces are considered a tract";
}
@source(IRC_S1237_C, relation = formalizes, coverage = partial, quote = "For purposes of this section, the term \"tract of real property\" means a single piece of real property, except that 2 or more pieces of real property shall be considered a tract if at any time they were contiguous in the hands of the taxpayer or if they would be contiguous except for the interposition of a road, street, railroad, stream, or similar property.")
rule PiecesContiguousRule(a: Asset, b: Asset) defeasible {
    label en official "section 1237(c): contiguous at any time in the hands of the taxpayer";
    when pieces_contiguous_in_hands_of_taxpayer_at_any_time(a, b);
    then pieces_form_a_tract_1237c(a, b);
}
rule PiecesContiguousButForRoadRule(a: Asset, b: Asset) defeasible {
    label en official "section 1237(c): contiguous but for the interposed road, street, railroad, stream or similar property";
    when pieces_contiguous_but_for_road_street_railroad_stream(a, b);
    then pieces_form_a_tract_1237c(a, b);
}
pub relation single_piece_is_a_tract_1237c(piece: Asset) kind institutional {
    label en official "section 1237(c): a single piece of real property is a tract";
}
rule SinglePieceRule(piece: Asset) defeasible {
    label en official "section 1237(c)";
    when piece_of_real_property(piece);
    then single_piece_is_a_tract_1237c(piece);
}
pub relation remainder_after_lot_sale(remainder: Asset) kind empirical {
    label en official "the remainder of a tract after a lot or parcel was sold or exchanged from it";
}
pub relation last_sale_from_remainder_on(remainder: Asset, on: Date) kind empirical {
    label en official "the date of the sale of the lot from the tract";
}
pub relation no_further_sales_from_remainder_within_5_years(remainder: Asset) kind empirical {
    label en official "no further sales or exchanges of other lots from the remainder are made for a period of 5 years";
}
pub relation as_of_date_1237c(remainder: Asset, on: Date) kind empirical {
    label en official "the date on which the 5-year period is tested";
}
pub relation remainder_deemed_a_tract_1237c(remainder: Asset) kind institutional {
    label en official "section 1237(c), last sentence: the remainder is deemed a tract";
}
@source(IRC_S1237_C, relation = formalizes, coverage = exact, quote = "If, following the sale or exchange of any lot or parcel from a tract of real property, no further sales or exchanges of any other lots or parcels from the remainder of such tract are made for a period of 5 years, such remainder shall be deemed a tract.")
rule RemainderTractRule(remainder: Asset, last: Date, today: Date) defeasible {
    label en official "section 1237(c), last sentence";
    when remainder_after_lot_sale(remainder);
    when last_sale_from_remainder_on(remainder, last);
    when no_further_sales_from_remainder_within_5_years(remainder);
    when as_of_date_1237c(remainder, today);
    when today >= add_calendar_period(last, 5 calendar_year);
    then remainder_deemed_a_tract_1237c(remainder);
}

// =============================================================================
// §1341(b)(4)-(5)
// =============================================================================

pub relation deduction_under_1341a4_results_in_net_operating_loss(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1341(b)(4)(A): the deduction referred to in subsection (a)(4) results in a net operating loss";
}
pub relation exclusion_1341a5B_results_in_prior_year_loss(p: Person, prior: TaxableYear, amount: Money) kind empirical {
    label en official "section 1341(b)(4)(B): the exclusion referred to in subsection (a)(5)(B) results in a net operating loss or capital loss for the prior taxable year";
}
pub relation section_1341_paragraph_4_applies(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1341(b)(4): the tax under paragraph (4) of subsection (a) - the computation with the deduction - is the lesser";
}
@source(IRC_S1341_B, relation = formalizes, coverage = partial, quote = "(4) For purposes of determining whether paragraph (4) or paragraph (5) of subsection (a) applies—")
rule Paragraph4AppliesRule(p: Person, y: TaxableYear, with_deduction: Money, alt5: Money) defeasible {
    label en official "section 1341(a): the computation with the deduction is the lesser (an equal result is read as paragraph (5), as in the section 1341(b)(3) rule)";
    when tax_for_year_computed_with_deduction(p, y, with_deduction);
    when tax_under_1341_alternative_5(p, y, alt5);
    when with_deduction < alt5;
    then section_1341_paragraph_4_applies(p, y);
}
pub relation section_1341_paragraph_5_applies(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1341(b)(4): the tax under paragraph (5) of subsection (a) is the lesser or equal";
}
rule Paragraph5AppliesRule(p: Person, y: TaxableYear, with_deduction: Money, alt5: Money) defeasible {
    label en official "section 1341(a): the paragraph (5) amount is not above the computation with the deduction";
    when tax_for_year_computed_with_deduction(p, y, with_deduction);
    when tax_under_1341_alternative_5(p, y, alt5);
    when alt5 <= with_deduction;
    then section_1341_paragraph_5_applies(p, y);
}
pub relation nol_carried_back_in_computing_a4_tax(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1341(b)(4)(A): the net operating loss is carried back to the same extent and in the same manner as under section 172 for computing the tax for the year under (a)(4)";
}
@source(IRC_S1341_B, relation = formalizes, coverage = exact, quote = "(A) in any case where the deduction referred to in paragraph (4) of subsection (a) results in a net operating loss, such loss shall, for purposes of computing the tax for the taxable year under such paragraph (4), be carried back to the same extent and in the same manner as is provided under section 172; and")
rule NolCarriedBackRule(p: Person, y: TaxableYear, nol: Money) defeasible {
    label en official "section 1341(b)(4)(A)";
    when deduction_under_1341a4_results_in_net_operating_loss(p, y, nol);
    when nol > 0.00 USD;
    then nol_carried_back_in_computing_a4_tax(p, y, nol);
}
pub relation prior_year_loss_carried_back_and_over_for_decrease(p: Person, prior: TaxableYear, amount: Money) kind institutional {
    label en official "section 1341(b)(4)(B): the prior-year net operating loss or capital loss is carried back and carried over as under section 172 or 1212 in computing the decrease in tax under (a)(5)(B), with no carryover beyond the taxable year of the deduction taken into account";
}
@source(IRC_S1341_B, relation = formalizes, coverage = partial, quote = "(B) in any case where the exclusion referred to in paragraph (5)(B) of subsection (a) results in a net operating loss or capital loss for the prior taxable year (or years), such loss shall, for purposes of computing the decrease in tax for the prior taxable year (or years) under such paragraph")
rule PriorLossCarriedRule(p: Person, prior: TaxableYear, loss: Money) defeasible {
    label en official "section 1341(b)(4)(B)";
    when exclusion_1341a5B_results_in_prior_year_loss(p, prior, loss);
    when loss > 0.00 USD;
    then prior_year_loss_carried_back_and_over_for_decrease(p, prior, loss);
}
pub relation nol_sustained_for_later_years_1341b5A(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1341(b)(5)(A): after the application of (a)(4), the net operating loss is taken into account under section 172 for later years as a net operating loss sustained for the taxable year";
}
@source(IRC_S1341_B, relation = formalizes, coverage = exact, quote = "(A) a net operating loss sustained for the taxable year, if paragraph (4) of subsection (a) applied, or")
rule NolForLaterYearsRule(p: Person, y: TaxableYear, nol: Money) defeasible {
    label en official "section 1341(b)(5)(A): only where paragraph (4) applied";
    when nol_carried_back_in_computing_a4_tax(p, y, nol);
    when section_1341_paragraph_4_applies(p, y);
    then nol_sustained_for_later_years_1341b5A(p, y, nol);
}
pub relation prior_year_loss_sustained_for_later_years_1341b5B(p: Person, prior: TaxableYear, amount: Money) kind institutional {
    label en official "section 1341(b)(5)(B): after the application of (a)(5)(B), the net operating loss or capital loss is taken into account under section 172 or 1212 for later years as a loss sustained for the prior taxable year";
}
@source(IRC_S1341_B, relation = formalizes, coverage = exact, quote = "(B) a net operating loss or capital loss sustained for the prior taxable year (or years), if paragraph (5)(B) of subsection (a) applied.")
rule PriorLossForLaterYearsRule(p: Person, y: TaxableYear, prior: TaxableYear, loss: Money) defeasible {
    label en official "section 1341(b)(5)(B): only where paragraph (5) applied";
    when prior_year_loss_carried_back_and_over_for_decrease(p, prior, loss);
    when section_1341_paragraph_5_applies(p, y);
    when prior_year_of_1341(p, y, prior);
    then prior_year_loss_sustained_for_later_years_1341b5B(p, prior, loss);
}
pub relation prior_year_of_1341(p: Person, y: TaxableYear, prior: TaxableYear) kind empirical {
    label en official "the prior taxable year in which the item was included, for the taxable year of the deduction";
}
