// Stage 2b (IRC-07, A05). Section 1202: qualified small business stock
// (QSBS) gain exclusion. Base 2024-Edition text (pre-OBBBA) plus Pub. L.
// 119-21 SEC. 70431 (EXPANSION OF QUALIFIED SMALL BUSINESS STOCK GAIN
// EXCLUSION), pinned in `us.irc.temporal::PL119_21_S70431` (enactment date
// 2025-07-04, "applicable date" per the amendment's own new (a)(6)(A)):
// the 3/4/5-year 50/75/100% tiered exclusion for post-applicable-date
// stock, the $15,000,000 per-issuer limit for such stock, and the
// $75,000,000 aggregate-gross-assets ceiling for stock issued after the
// enactment date.

use self::{
    Corporation,
    IRC_S1202_A,
    IRC_S1202_B,
    IRC_S1202_C,
    IRC_S1202_D,
    IRC_S1202_E,
    IRC_S1202_H,
    Partnership,
    Person,
    TaxableYear,
    Transaction,
    active_business_failure_1202e,
    stock_disqualified_by_redemption_1202c3,
};

pub entity QsbsStock : Asset {
    label en unofficial "qualified small business stock within the meaning of section 1202(c)";
}

// =============================================================================
// (c): qualified small business stock — definition
// =============================================================================

pub relation stock_in_c_corporation(stock: QsbsStock, corp: Corporation) kind empirical;
pub relation originally_issued_after_19930810(stock: QsbsStock) kind empirical {
    label en official "section 1202(c)(1): originally issued after the date of enactment of the Revenue Reconciliation Act of 1993 (August 10, 1993)";
}
pub relation qualified_small_business_at_issuance(corp: Corporation, stock: QsbsStock) kind institutional {
    label en official "section 1202(c)(1)(A): as of the date of issuance, the corporation is a qualified small business (section 1202(d))";
}
pub relation acquired_at_original_issue_for_money_property_or_services(stock: QsbsStock, p: Person) kind empirical {
    label en official "section 1202(c)(1)(B): the stock is acquired by the taxpayer at its original issue, for money or other property (not stock), or as compensation for services (other than underwriting)";
}
pub relation active_business_requirement_met(corp: Corporation, p: Person, stock: QsbsStock) kind institutional {
    label en official "section 1202(c)(2)(A): during substantially all of the taxpayer's holding period, the corporation meets the (e) active business requirement and is a C corporation";
}
pub relation qualified_small_business_stock(stock: QsbsStock, corp: Corporation, p: Person) kind institutional {
    label en official "section 1202(c): the stock is qualified small business stock";
}
@source(IRC_S1202_C, quote = "the term \"qualified small business stock\" means any stock in a C corporation which is originally issued after the date of the enactment of the Revenue Reconciliation Act of 1993, if—")
rule QualifiedSmallBusinessStockRule(stock: QsbsStock, corp: Corporation, p: Person) defeasible {
    label en official "section 1202(c): stock is QSBS when issued after August 10, 1993, by a corporation that was a qualified small business at issuance, acquired at original issue for money/property/services, and the active business requirement is met";
    when stock_in_c_corporation(stock, corp);
    when originally_issued_after_19930810(stock);
    when qualified_small_business_at_issuance(corp, stock);
    when acquired_at_original_issue_for_money_property_or_services(stock, p);
    when active_business_requirement_met(corp, p, stock);
    when not_known(stock_disqualified_by_redemption_1202c3(stock));
    then qualified_small_business_stock(stock, corp, p);
}
// (c)(3)(A)-(C) redemption disqualification: module 33 (stage 3) derives
// stock_disqualified_by_redemption_1202c3, read by the rule above.

// =============================================================================
// (d): qualified small business — aggregate gross assets
// =============================================================================

pub const Section1202GrossAssetCeilingBase: Money = 50000000.00 USD {
    label en official "$50,000,000 (section 1202(d)(1)(A)-(B), pre-Pub. L. 119-21 stock)";
};
pub const Section1202GrossAssetCeilingObbba: Money = 75000000.00 USD {
    label en official "$75,000,000 (section 1202(d)(1)(A)-(B), as amended by Pub. L. 119-21 SEC. 70431(c), for stock issued after the enactment date)";
};
pub const Section1202ObbbaEnactmentDate: Date = @2025-07-04 {
    label en official "the date of enactment of Pub. L. 119-21 (SEC. 70431's own \"applicable date\" for (a)/(b), and the (c) gross-asset increase's own \"stock issued after\" trigger date)";
};
pub relation aggregate_gross_assets_before_issuance(corp: Corporation, amount: Money) kind empirical {
    label en unofficial "section 1202(d)(1)(A): the corporation's aggregate gross assets at all times on or after August 10, 1993 and before the issuance";
}
pub relation aggregate_gross_assets_immediately_after_issuance(corp: Corporation, stock: QsbsStock, amount: Money) kind empirical {
    label en unofficial "section 1202(d)(1)(B): aggregate gross assets immediately after the issuance (including amounts received in the issuance)";
}
pub relation qualified_small_business_domestic_c_corp(corp: Corporation) kind empirical {
    label en unofficial "section 1202(d)(1): the corporation is a domestic C corporation";
}
pub relation stock_issued_on(stock: QsbsStock, issued_on: Date) kind empirical {
    label en unofficial "the date the stock was issued, for testing which section 1202(d)(1) gross-asset ceiling ($50,000,000 or $75,000,000) applies";
}
@source(IRC_S1202_D, quote = "The term \"qualified small business\" means any domestic corporation which is a C corporation if—")
rule QualifiedSmallBusinessPreObbbaRule(corp: Corporation, stock: QsbsStock, before: Money, after: Money, issued_on: Date) defeasible {
    label en official "section 1202(d)(1): a domestic C corporation is a qualified small business if gross assets before and immediately after issuance did not exceed $50,000,000 (stock issued on or before the Pub. L. 119-21 enactment date)";
    when qualified_small_business_domestic_c_corp(corp);
    when aggregate_gross_assets_before_issuance(corp, before);
    when aggregate_gross_assets_immediately_after_issuance(corp, stock, after);
    when originally_issued_after_19930810(stock);
    when stock_issued_on(stock, issued_on);
    when before <= Section1202GrossAssetCeilingBase;
    when after <= Section1202GrossAssetCeilingBase;
    when issued_on <= Section1202ObbbaEnactmentDate;
    then qualified_small_business_at_issuance(corp, stock);
}
@source(us.irc.temporal::PL119_21_S70431, relation = derives_from, quote = "Subparagraphs (A) and (B) of section 1202(d)(1) are each amended by striking “$50,000,000” and inserting “$75,000,000”.")
rule QualifiedSmallBusinessObbbaRule(corp: Corporation, stock: QsbsStock, before: Money, after: Money, issued_on: Date) defeasible {
    label en official "section 1202(d)(1), as amended by Pub. L. 119-21 SEC. 70431(c): $75,000,000 ceiling for stock issued after the enactment date";
    when qualified_small_business_domestic_c_corp(corp);
    when aggregate_gross_assets_before_issuance(corp, before);
    when aggregate_gross_assets_immediately_after_issuance(corp, stock, after);
    when originally_issued_after_19930810(stock);
    when stock_issued_on(stock, issued_on);
    when before <= Section1202GrossAssetCeilingObbba;
    when after <= Section1202GrossAssetCeilingObbba;
    when issued_on > Section1202ObbbaEnactmentDate;
    then qualified_small_business_at_issuance(corp, stock);
}
// (d)(2)(B) contributed-property FMV-as-basis rule and (d)(3) parent-
// subsidiary aggregation (50%-substituted section 1563(a)(1)) are TECH_GAP
// this stage: `aggregate_gross_assets_before_issuance`/`..._after_issuance`
// are case-supplied totals already reflecting (if applicable) those rules,
// not derived from raw contribution/subsidiary facts.

// =============================================================================
// (e): active business requirement (the 80% test)
// =============================================================================

pub const Section1202ActiveBusinessAssetRatio: Decimal = 0.80 {
    label en official "80 percent (section 1202(e)(1)(A))";
};
pub relation qualified_trade_or_business_assets_value(corp: Corporation, amount: Money) kind empirical {
    label en unofficial "section 1202(e)(1)(A): the value of assets used by the corporation in the active conduct of qualified trades or businesses";
}
pub relation total_assets_value(corp: Corporation, amount: Money) kind empirical;
pub relation eligible_corporation_1202e4(corp: Corporation) kind empirical {
    label en official "section 1202(e)(4): a domestic corporation other than a DISC/former DISC, RIC/REIT/REMIC, or cooperative";
}
pub relation active_business_80_percent_test_met(corp: Corporation) kind institutional {
    label en official "section 1202(e)(1)(A): at least 80 percent (by value) of the corporation's assets are used in the active conduct of qualified trades or businesses";
}
@source(IRC_S1202_E, quote = "at least 80 percent (by value) of the assets of such corporation are used by such corporation in the active conduct of 1 or more qualified trades or businesses, and")
rule ActiveBusiness80PercentTestRule(corp: Corporation, qualified_assets: Money, total: Money) strict {
    label en official "section 1202(e)(1)(A): the 80%-by-value active-business asset ratio test (exact comparison qualified >= total x 0.80; stage 2c replaced a 6-place rounded ratio, which could admit 79.99996 percent)";
    when qualified_trade_or_business_assets_value(corp, qualified_assets);
    when total_assets_value(corp, total);
    when qualified_assets >= total * Section1202ActiveBusinessAssetRatio;
    then active_business_80_percent_test_met(corp);
}
@source(IRC_S1202_E, quote = "the requirements of this subsection are met by a corporation for any period if during such period—")
rule ActiveBusinessRequirementMetRule(corp: Corporation, p: Person, stock: QsbsStock) defeasible {
    label en official "section 1202(e)(1): the active business requirement is met by the 80% asset test plus eligible-corporation status";
    when stock_in_c_corporation(stock, corp);
    when acquired_at_original_issue_for_money_property_or_services(stock, p);
    when active_business_80_percent_test_met(corp);
    when eligible_corporation_1202e4(corp);
    when not_known(active_business_failure_1202e(corp));
    then active_business_requirement_met(corp, p, stock);
}
// (e)(2) start-up/R&D-activity asset treatment, (e)(3) excluded-trade
// carve-outs (the professional-services/finance/farming/hotel list),
// (e)(5)-(8) look-through/portfolio-stock/working-capital/real-estate/
// software-royalty sub-rules are TECH_GAP: `qualified_trade_or_business_
// assets_value` is a case-supplied total already reflecting them.

// =============================================================================
// (a): the exclusion percentage — base 5-year tiers by acquisition date,
// and the Pub. L. 119-21 3/4/5-year tiers for post-applicable-date stock
// =============================================================================

pub const Section1202SmallBusinessJobsActDate: Date = @2010-09-27 {
    label en official "September 27, 2010, the enactment date of the Creating Small Business Jobs Act of 2010 (section 1202(a)(3)-(4))";
};
pub const Section1202Act2009Date: Date = @2009-02-17 {
    label en official "February 17, 2009 (section 1202(a)(3)'s own 'date of the enactment of this paragraph')";
};
pub relation qsbs_acquired_on(p: Person, stock: QsbsStock, on: Date) kind empirical {
    label en official "the date the taxpayer acquired the qualified small business stock";
}
// A SECOND, DISTINCT relation for stock acquired via an (h) gift/death/
// partnership-distribution transfer, so the percentage rules below can
// read either source WITHOUT a rule concluding `qsbs_acquired_on` from
// `qsbs_acquired_on` itself (the object-keyed self-loop class this
// package's TECH-GAPS.md G24/G25 already document — avoided here by
// construction, not by attempting and failing).
pub relation qsbs_acquired_on_via_transfer(transferee: Person, stock: QsbsStock, on: Date) kind institutional {
    label en official "section 1202(h)(1)(A): the transferee is treated as having acquired the stock on the same date as the transferor (gift, death, or qualifying partnership-to-partner transfer)";
}
pub relation qsbs_transfer_described_in_h2(t: Transaction, transferor: Person, transferee: Person, stock: QsbsStock) kind empirical {
    label en official "section 1202(h)(2): a transfer by gift, at death, or (subject to (2)(C)'s own conditions) from a partnership to a partner";
}
@source(IRC_S1202_H, quote = "having acquired such stock in the same manner as the transferor, and")
rule QsbsAcquiredOnViaTransferRule(t: Transaction, transferor: Person, transferee: Person, stock: QsbsStock, acquired_on: Date) defeasible {
    label en official "section 1202(h)(1)(A): the transferee's acquisition date is the transferor's own acquisition date";
    when qsbs_transfer_described_in_h2(t, transferor, transferee, stock);
    when qsbs_acquired_on(transferor, stock, acquired_on);
    then qsbs_acquired_on_via_transfer(transferee, stock, acquired_on);
}
pub relation qsbs_held_years(p: Person, stock: QsbsStock, years: Integer) kind empirical {
    label en unofficial "the number of complete years the taxpayer has held the stock (case-supplied; for an (h)-transferred stock, this already reflects the (h)(1)(B) tacked holding period)";
}

pub relation section_1202_gain_recognized(p: Person, t: Transaction, stock: QsbsStock, amount: Money) kind empirical {
    label en unofficial "gain from the sale or exchange of the qualified small business stock";
}
pub relation section_1202_exclusion_percentage(p: Person, stock: QsbsStock, pct: Decimal) kind institutional {
    label en official "section 1202(a): the applicable exclusion percentage for this stock";
}

// --- pre-2009-Act stock: 50% ---
@source(IRC_S1202_A, quote = "gross income shall not include 50 percent of any gain from the sale or exchange of qualified small business stock held for more than 5 years.")
rule ExclusionPercentageBase50Rule(p: Person, stock: QsbsStock, acquired_on: Date, years: Integer) defeasible {
    label en official "section 1202(a)(1): 50% exclusion for stock acquired on or before February 17, 2009 and held more than 5 years";
    when qsbs_acquired_on(p, stock, acquired_on);
    when acquired_on <= Section1202Act2009Date;
    when qsbs_held_years(p, stock, years);
    when years > 5;
    then section_1202_exclusion_percentage(p, stock, 0.50);
}
rule ExclusionPercentageBase50ViaTransferRule(p: Person, stock: QsbsStock, acquired_on: Date, years: Integer) defeasible {
    label en official "section 1202(a)(1): 50% exclusion, tacked acquisition date via an (h) transfer";
    when qsbs_acquired_on_via_transfer(p, stock, acquired_on);
    when acquired_on <= Section1202Act2009Date;
    when qsbs_held_years(p, stock, years);
    when years > 5;
    then section_1202_exclusion_percentage(p, stock, 0.50);
}

// --- 2009-2010 Act window: 75% ---
@source(IRC_S1202_A, quote = "paragraph (1) shall be applied by substituting \"75 percent\" for \"50 percent\", and")
rule ExclusionPercentage75Rule(p: Person, stock: QsbsStock, acquired_on: Date, years: Integer) defeasible {
    label en official "section 1202(a)(3): 75% exclusion for stock acquired after February 17, 2009 and on or before September 27, 2010, held more than 5 years";
    when qsbs_acquired_on(p, stock, acquired_on);
    when acquired_on > Section1202Act2009Date;
    when acquired_on <= Section1202SmallBusinessJobsActDate;
    when qsbs_held_years(p, stock, years);
    when years > 5;
    then section_1202_exclusion_percentage(p, stock, 0.75);
}

// --- post-2010-Act, pre-OBBBA-applicable-date stock: 100% ---
@source(IRC_S1202_A, quote = "paragraph (1) shall be applied by substituting \"100 percent\" for \"50 percent\",")
rule ExclusionPercentage100PreObbbaRule(p: Person, stock: QsbsStock, acquired_on: Date, years: Integer) defeasible {
    label en official "section 1202(a)(4): 100% exclusion for stock acquired after September 27, 2010 and on or before the Pub. L. 119-21 applicable date, held more than 5 years";
    when qsbs_acquired_on(p, stock, acquired_on);
    when acquired_on > Section1202SmallBusinessJobsActDate;
    when acquired_on <= Section1202ObbbaEnactmentDate;
    when qsbs_held_years(p, stock, years);
    when years > 5;
    then section_1202_exclusion_percentage(p, stock, 1.0);
}

// --- Pub. L. 119-21: post-applicable-date stock, 3/4/5-year tiers ---
@source(us.irc.temporal::PL119_21_S70431, relation = derives_from, quote = "3 years50%")
rule ExclusionPercentageObbba3YearRule(p: Person, stock: QsbsStock, acquired_on: Date, years: Integer) defeasible {
    label en official "section 1202(a)(1)(B)/(a)(5), as added by Pub. L. 119-21: 50% exclusion for post-applicable-date stock held at least 3 (but fewer than 4) years";
    when qsbs_acquired_on(p, stock, acquired_on);
    when acquired_on > Section1202ObbbaEnactmentDate;
    when qsbs_held_years(p, stock, years);
    when years >= 3;
    when years < 4;
    then section_1202_exclusion_percentage(p, stock, 0.50);
}
@source(us.irc.temporal::PL119_21_S70431, relation = derives_from, quote = "4 years75%")
rule ExclusionPercentageObbba4YearRule(p: Person, stock: QsbsStock, acquired_on: Date, years: Integer) defeasible {
    label en official "section 1202(a)(5), as added by Pub. L. 119-21: 75% exclusion for post-applicable-date stock held at least 4 (but fewer than 5) years";
    when qsbs_acquired_on(p, stock, acquired_on);
    when acquired_on > Section1202ObbbaEnactmentDate;
    when qsbs_held_years(p, stock, years);
    when years >= 4;
    when years < 5;
    then section_1202_exclusion_percentage(p, stock, 0.75);
}
@source(us.irc.temporal::PL119_21_S70431, relation = derives_from, quote = "5 years or more100%")
rule ExclusionPercentageObbba5YearRule(p: Person, stock: QsbsStock, acquired_on: Date, years: Integer) defeasible {
    label en official "section 1202(a)(5), as added by Pub. L. 119-21: 100% exclusion for post-applicable-date stock held 5 or more years";
    when qsbs_acquired_on(p, stock, acquired_on);
    when acquired_on > Section1202ObbbaEnactmentDate;
    when qsbs_held_years(p, stock, years);
    when years >= 5;
    then section_1202_exclusion_percentage(p, stock, 1.0);
}

pub relation section_1202_excluded_gain(p: Person, t: Transaction, stock: QsbsStock, amount: Money) kind institutional {
    label en official "section 1202(a): the amount of gain excluded from gross income (before the section 1202(b) per-issuer cap)";
}
rule Section1202ExcludedGainRule(p: Person, t: Transaction, stock: QsbsStock, corp: Corporation, gain: Money, pct: Decimal) defeasible {
    label en official "section 1202(a): excluded gain equals the applicable percentage times the recognized gain, before the (b) per-issuer cap";
    when section_1202_gain_recognized(p, t, stock, gain);
    when section_1202_exclusion_percentage(p, stock, pct);
    when qualified_small_business_stock(stock, corp, p);
    then section_1202_excluded_gain(p, t, stock, gain * pct);
}

// =============================================================================
// (b): per-issuer limitation on eligible gain
// =============================================================================

pub const Section1202PerIssuerLimitPreObbba: Money = 10000000.00 USD {
    label en official "$10,000,000 (section 1202(b)(1)(A), pre-Pub. L. 119-21 stock)";
};
pub const Section1202PerIssuerLimitPreObbbaSeparateReturn: Money = 5000000.00 USD {
    label en official "$5,000,000 (section 1202(b)(3)(A), separate return, pre-Pub. L. 119-21 stock)";
};
pub const Section1202PerIssuerLimitObbba: Money = 15000000.00 USD {
    label en official "$15,000,000 (section 1202(b)(4)(B), as added by Pub. L. 119-21 SEC. 70431(b), post-applicable-date stock)";
};
pub relation married_filing_separate_return_1202(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "a married individual filing a separate return (section 1202(b)(3)(A)) — pending typed dependency on returns/income-individual filing status";
}
pub relation eligible_gain(p: Person, corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1202(b)(2): gain from the sale or exchange of QSBS held for more than 5 years (pre-applicable-date stock) or at least 3 years (post-applicable-date stock, per Pub. L. 119-21's conforming amendment to (b)(2))";
}
@source(IRC_S1202_B, relation = formalizes, coverage = partial, quote = "the term \"eligible gain\" means any gain from the sale or exchange of qualified small business stock held for more than 5 years.")
rule EligibleGainRule(p: Person, corp: Corporation, y: TaxableYear, t: Transaction, stock: QsbsStock, excluded: Money) defeasible {
    label en official "section 1202(b)(2): the excluded-gain amount computed above is eligible gain for the per-issuer cap";
    when section_1202_excluded_gain(p, t, stock, excluded);
    when stock_in_c_corporation(stock, corp);
    when us.irc.core::year_of(p, y);
    then eligible_gain(p, corp, y, excluded);
}
pub relation eligible_gain_taken_into_account_prior_years(p: Person, corp: Corporation, amount: Money) kind empirical {
    label en unofficial "section 1202(b)(1)(A): the aggregate eligible gain already taken into account by the taxpayer for prior taxable years, attributable to this corporation's stock — case-supplied (multi-year running total, TECH-GAPS.md G1/G24/G25 class)";
}
pub relation aggregate_adjusted_basis_disposed_this_year(p: Person, corp: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1202(b)(1)(B): 10 times the aggregate adjusted bases of QSBS issued by the corporation and disposed of by the taxpayer during the year (basis determined without regard to post-issuance additions)";
}
pub const Section1202TenTimesBasisMultiplier: Decimal = 10.0 {
    label en official "10 (section 1202(b)(1)(B))";
};
pub relation per_issuer_limit_pre_obbba(p: Person, corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1202(b)(1): the per-issuer dollar limit for pre-applicable-date stock, before reduction — $10,000,000 ($5,000,000 if a separate return)";
}
rule PerIssuerLimitPreObbbaJointRule(p: Person, corp: Corporation, y: TaxableYear, basis: Money) defeasible {
    when aggregate_adjusted_basis_disposed_this_year(p, corp, y, basis);
    when not_known(married_filing_separate_return_1202(p, y));
    then per_issuer_limit_pre_obbba(p, corp, y, Section1202PerIssuerLimitPreObbba);
}
@source(IRC_S1202_B, relation = formalizes, coverage = partial, quote = "In the case of a separate return by a married individual, paragraph (1)(A) shall be applied by substituting \"$5,000,000\" for \"$10,000,000\".")
rule PerIssuerLimitPreObbbaSeparateRule(p: Person, corp: Corporation, y: TaxableYear, basis: Money) defeasible {
    when aggregate_adjusted_basis_disposed_this_year(p, corp, y, basis);
    when married_filing_separate_return_1202(p, y);
    then per_issuer_limit_pre_obbba(p, corp, y, Section1202PerIssuerLimitPreObbbaSeparateReturn);
}
pub relation per_issuer_dollar_cap_option_a(p: Person, corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1202(b)(1)(A): the dollar limit reduced by prior years' eligible gain for this corporation";
}
@source(IRC_S1202_B, relation = formalizes, coverage = partial, quote = "$10,000,000 reduced by the aggregate amount of eligible gain taken into account by the taxpayer under subsection (a) for prior taxable years and attributable to dispositions of stock issued by such corporation, or")
rule PerIssuerDollarCapOptionARule(p: Person, corp: Corporation, y: TaxableYear, limit: Money, prior: Money) defeasible {
    label en official "section 1202(b)(1)(A): dollar limit minus prior-year eligible gain";
    when per_issuer_limit_pre_obbba(p, corp, y, limit);
    when eligible_gain_taken_into_account_prior_years(p, corp, prior);
    when limit > prior;
    then per_issuer_dollar_cap_option_a(p, corp, y, limit - prior);
}
pub relation per_issuer_dollar_cap_option_b(p: Person, corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1202(b)(1)(B): 10 times the aggregate adjusted bases of QSBS disposed of this year";
}
@source(IRC_S1202_B, quote = "10 times the aggregate adjusted bases of qualified small business stock issued by such corporation and disposed of by the taxpayer during the taxable year.")
rule PerIssuerDollarCapOptionBRule(p: Person, corp: Corporation, y: TaxableYear, basis: Money) strict {
    label en official "section 1202(b)(1)(B): 10x aggregate basis disposed of this year";
    when aggregate_adjusted_basis_disposed_this_year(p, corp, y, basis);
    then per_issuer_dollar_cap_option_b(p, corp, y, basis * Section1202TenTimesBasisMultiplier);
}
pub relation per_issuer_cap(p: Person, corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1202(b)(1): the greater of the (A) reduced-dollar-limit or (B) 10x-basis amount";
}
@source(IRC_S1202_B, quote = "the aggregate amount of such gain from dispositions of stock issued by such corporation which may be taken into account under subsection (a) for the taxable year shall not exceed the greater of—")
rule PerIssuerCapAOverBRule(p: Person, corp: Corporation, y: TaxableYear, a: Money, b: Money) defeasible {
    label en official "section 1202(b)(1): option (A) governs when it exceeds option (B)";
    when per_issuer_dollar_cap_option_a(p, corp, y, a);
    when per_issuer_dollar_cap_option_b(p, corp, y, b);
    when a >= b;
    then per_issuer_cap(p, corp, y, a);
}
rule PerIssuerCapBOverARule(p: Person, corp: Corporation, y: TaxableYear, a: Money, b: Money) defeasible {
    label en official "section 1202(b)(1): option (B) governs when it exceeds option (A)";
    when per_issuer_dollar_cap_option_a(p, corp, y, a);
    when per_issuer_dollar_cap_option_b(p, corp, y, b);
    when b > a;
    then per_issuer_cap(p, corp, y, b);
}
// The Pub. L. 119-21 $15,000,000 track for post-applicable-date stock
// ((b)(4)(B), its own reduction formula summing BOTH prior-year gain and
// current-year pre-applicable-date-stock gain, plus the (b)(5) post-2026
// inflation adjustment) is TECH_GAP this stage: only the pre-existing
// $10,000,000/$5,000,000 track above is wired into per_issuer_cap; a case
// with post-applicable-date stock should assert per_issuer_limit_pre_obbba
// directly as $15,000,000 (or half for a separate return) as a documented
// simplification, not a fabricated computation.

pub relation section_1202_gain_within_per_issuer_cap(p: Person, t: Transaction, corp: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1202(a),(b): the excluded gain, capped at the per-issuer limit";
}
rule Section1202GainWithinCapRule(p: Person, t: Transaction, stock: QsbsStock, corp: Corporation, y: TaxableYear, excluded: Money, cap: Money) defeasible {
    label en official "section 1202(b)(1): excluded gain not exceeding the per-issuer cap is allowed in full";
    when section_1202_excluded_gain(p, t, stock, excluded);
    when per_issuer_cap(p, corp, y, cap);
    when excluded <= cap;
    then section_1202_gain_within_per_issuer_cap(p, t, corp, y, excluded);
}
rule Section1202GainCappedAtPerIssuerCapRule(p: Person, t: Transaction, stock: QsbsStock, corp: Corporation, y: TaxableYear, excluded: Money, cap: Money) defeasible {
    label en official "section 1202(b)(1): excluded gain exceeding the per-issuer cap is allowed only up to the cap";
    when section_1202_excluded_gain(p, t, stock, excluded);
    when per_issuer_cap(p, corp, y, cap);
    when excluded > cap;
    then section_1202_gain_within_per_issuer_cap(p, t, corp, y, cap);
}

// =============================================================================
// (h): tacking on gift, death, and partnership-to-partner transfers
// (the acquisition-date bridge is above; here, the (h)(2) trigger facts)
// =============================================================================

pub relation qsbs_transfer_by_gift(t: Transaction, transferor: Person, transferee: Person, stock: QsbsStock) kind empirical;
pub relation qsbs_transfer_at_death(t: Transaction, transferor: Person, transferee: Person, stock: QsbsStock) kind empirical;
pub relation qsbs_transfer_partnership_to_partner(t: Transaction, partnership: Partnership, partner: Person, stock: QsbsStock) kind empirical {
    label en official "section 1202(h)(2)(C): a transfer from a partnership to a partner meeting requirements similar to subsection (g) (without the 5-year holding period requirement)";
}
rule QsbsTransferDescribedFromGiftRule(t: Transaction, transferor: Person, transferee: Person, stock: QsbsStock) strict {
    when qsbs_transfer_by_gift(t, transferor, transferee, stock);
    then qsbs_transfer_described_in_h2(t, transferor, transferee, stock);
}
rule QsbsTransferDescribedFromDeathRule(t: Transaction, transferor: Person, transferee: Person, stock: QsbsStock) strict {
    when qsbs_transfer_at_death(t, transferor, transferee, stock);
    then qsbs_transfer_described_in_h2(t, transferor, transferee, stock);
}
rule QsbsTransferDescribedFromPartnershipRule(t: Transaction, partnership: Partnership, partner: Person, stock: QsbsStock) strict {
    when qsbs_transfer_partnership_to_partner(t, partnership, partner, stock);
    then qsbs_transfer_described_in_h2(t, partnership, partner, stock);
}
// (h)(3) section 1244(d)(2)-style recapitalization rule and (h)(4)
// nonqualified-stock section 351/368 exchange rules are TECH_GAP this
// stage.
