// Stage 2b (IRC-07, A05). Section 1311-1314: mitigation of the effect of
// limitations and other provisions. Section 1312's seven circumstances of
// adjustment as a classification; the adjustment itself as a power, with
// the section 1314(b) "as if... one year remained" deadline as an exact
// date test (not the power's `window`, which is the statute's OWN calendar
// validity — the two are distinct, see the rules below).

use self::{
    IRC_S1311_A,
    IRC_S1311_B,
    IRC_S1314_B,
    Person,
    correction_not_barred_at_time_1311b2,
    related_taxpayer_relationship_condition_met_1311b3,
};

pub entity Determination {
    label en official "a determination within the meaning of section 1313(a): a final Tax Court decision or other final court order, a section 7121 closing agreement, a final disposition of a refund claim, or a section 1313(a)(4) agreement";
}

// =============================================================================
// Section 1313: definitions
// =============================================================================

pub enum DeterminationKind {
    FinalCourtDecision;
    ClosingAgreement;
    FinalRefundClaimDisposition;
    Section1313a4Agreement;
    label en unofficial "section 1313(a)(1)-(4): the four kinds of determination";
}
pub relation determination_of_kind(d: Determination, kind: DeterminationKind, on: Date) kind empirical {
    label en official "section 1313(a): the determination and its kind and date";
}
pub relation taxpayer_of_determination(d: Determination, taxpayer: Person) kind empirical {
    label en official "section 1313(b): the taxpayer with respect to whom the determination is made (notwithstanding section 7701(a)(14), any person subject to a tax under the applicable revenue law)";
}
pub enum RelatedTaxpayerRelationship {
    HusbandAndWife;
    GrantorAndFiduciary;
    GrantorAndBeneficiary;
    FiduciaryAndBeneficiaryLegateeOrHeir;
    DecedentAndEstate;
    Partner;
    AffiliatedGroupMember;
    label en official "section 1313(c)(1)-(7): the seven related-taxpayer relationships";
}
pub relation related_taxpayer(taxpayer: Person, other: Person, relationship: RelatedTaxpayerRelationship) kind empirical {
    label en official "section 1313(c): a related taxpayer relationship, for purposes of this part";
}

// =============================================================================
// Section 1312: circumstances of adjustment (classification)
// =============================================================================

pub enum CircumstanceOfAdjustment {
    DoubleInclusionOfGrossIncomeItem;
    DoubleAllowanceOfDeductionOrCredit;
    DoubleExclusionItemsIncludedInReturn;
    DoubleExclusionItemsNotIncludedInReturn;
    DoubleDisallowanceOfDeductionOrCredit;
    CorrelativeEstateOrTrustDeductionAndInclusion;
    CorrelativeRelatedCorporationDeductionOrCredit;
    BasisAfterErroneousTreatmentOfPriorTransaction;
    label en official "section 1312(1)-(7): the circumstances under which the section 1311 adjustment is authorized";
}
pub relation circumstance_of_adjustment(d: Determination, kind: CircumstanceOfAdjustment) kind empirical {
    label en official "section 1312: the determination is described in one of the section 1312 circumstances";
}

// =============================================================================
// Section 1311: general rule and conditions
// =============================================================================

pub relation correction_prevented_by_other_law(d: Determination) kind empirical {
    label en official "section 1311(a): on the date of the determination, correction of the error is prevented by the operation of any law or rule of law, other than this part and section 7122";
}
pub relation inconsistent_position_by_secretary(d: Determination) kind empirical {
    label en official "section 1311(b)(1)(A): the determination adopts a position maintained by the Secretary, inconsistent with the erroneous treatment (refund/credit-direction adjustments)";
}
pub relation inconsistent_position_by_taxpayer(d: Determination) kind empirical {
    label en official "section 1311(b)(1)(B): the determination adopts a position maintained by the taxpayer, inconsistent with the erroneous treatment (deficiency-direction adjustments)";
}
pub relation section_1312_3b_or_4_exception(d: Determination) kind empirical {
    label en official "section 1311(b)(1): a determination described in section 1312(3)(B) or 1312(4), which does not need the (b)(1) inconsistent-position condition";
}
pub relation inconsistent_position_condition_met(d: Determination) kind institutional {
    label en unofficial "section 1311(b)(1): the inconsistent-position condition (or its (3)(B)/(4) exception) is satisfied";
}
@source(IRC_S1311_B, quote = "Except in cases described in paragraphs (3) (B) and (4) of section 1312, an adjustment shall be made under this part only if—")
rule InconsistentPositionExceptedRule(d: Determination) strict {
    label en official "section 1311(b)(1): the condition does not apply to a section 1312(3)(B)/(4) determination";
    when section_1312_3b_or_4_exception(d);
    then inconsistent_position_condition_met(d);
}
@source(IRC_S1311_B, relation = formalizes, coverage = partial, quote = "there is adopted in the determination a position maintained by the Secretary, or")
rule InconsistentPositionBySecretaryRule(d: Determination) strict {
    label en official "section 1311(b)(1)(A): satisfied by an inconsistent position maintained by the Secretary";
    when inconsistent_position_by_secretary(d);
    then inconsistent_position_condition_met(d);
}
@source(IRC_S1311_B, relation = formalizes, coverage = partial, quote = "there is adopted in the determination a position maintained by the taxpayer with respect to whom the determination is made,")
rule InconsistentPositionByTaxpayerRule(d: Determination) strict {
    label en official "section 1311(b)(1)(B): satisfied by an inconsistent position maintained by the taxpayer";
    when inconsistent_position_by_taxpayer(d);
    then inconsistent_position_condition_met(d);
}

pub relation mitigation_adjustment_authorized(d: Determination) kind institutional {
    label en official "section 1311(a): the adjustment provided in this part is authorized for this determination";
}
@source(IRC_S1311_A, quote = "then the effect of the error shall be corrected by an adjustment made in the amount and in the manner specified in section 1314.")
rule MitigationAdjustmentAuthorizedRule(d: Determination, kind: CircumstanceOfAdjustment) defeasible {
    label en official "section 1311(a): the adjustment is authorized when a section 1312 circumstance is met, correction is otherwise barred, and (b)(1)'s inconsistent-position condition is met";
    when circumstance_of_adjustment(d, kind);
    when correction_prevented_by_other_law(d);
    when inconsistent_position_condition_met(d);
    when correction_not_barred_at_time_1311b2(d);
    when related_taxpayer_relationship_condition_met_1311b3(d);
    then mitigation_adjustment_authorized(d);
}

// =============================================================================
// Section 1314: the adjustment amount, method, and the 1-year deadline
// =============================================================================

pub relation correct_treatment_tax_difference(d: Determination, amount: Money) kind empirical {
    label en unofficial "section 1314(a): the increase or decrease in the tax previously determined resulting solely from the correct treatment of the item that was the subject of the error — case-supplied this stage (the multi-year net-operating-loss/capital-loss-carryback recomputation the (a) last sentence describes is not derived from raw facts, same shape as this package's other multi-year TECH_GAP items)";
}
pub relation mitigation_adjustment_exercised_on(d: Determination, on: Date) kind empirical {
    label en official "the date the section 1314(b) assessment/refund adjustment is made (asserting/collecting the amount)";
}
pub relation mitigation_adjustment_within_1_year(d: Determination, exercised_on: Date) kind institutional {
    label en unofficial "section 1314(b): the adjustment is made as if, on the date of the determination, one year remained before expiration of the periods of limitation — a single-atom helper combining mitigation_adjustment_authorized with the 1-year deadline test, for the power's valid_when";
}
@source(IRC_S1314_B, quote = "and as if on the date of the determination one year remained before the expiration of the periods of limitation upon assessment or filing claim for refund for such taxable year or years.")
rule MitigationAdjustmentWithin1YearRule(d: Determination, kind: DeterminationKind, determined_on: Date, exercised_on: Date) defeasible {
    label en official "section 1314(b): the adjustment must be made within 1 year of the determination date";
    when mitigation_adjustment_authorized(d);
    when determination_of_kind(d, kind, determined_on);
    when mitigation_adjustment_exercised_on(d, exercised_on);
    when exercised_on <= add_calendar_period(determined_on, 1 calendar_year);
    then mitigation_adjustment_within_1_year(d, exercised_on);
}
pub relation mitigation_adjustment_made(d: Determination, taxpayer: Person, amount: Money) kind institutional {
    label en official "section 1314(b): the mitigation adjustment, assessed/collected or refunded/credited as if it were a deficiency or overpayment";
}
@source(IRC_S1314_B, quote = "The adjustment authorized in section 1311(a) shall be made by assessing and collecting, or refunding or crediting, the amount thereof in the same manner as if it were a deficiency determined by the Secretary with respect to the taxpayer as to whom the error was made or an overpayment claimed by such taxpayer")
rule MitigationAdjustmentPower(d: Determination, taxpayer: Person, exercised_on: Date, amount: Money) strict {
    label en official "section 1314(b): the section 1311 adjustment is made (assessed/collected or refunded/credited) within the 1-year deadline";
    when taxpayer_of_determination(d, taxpayer);
    when mitigation_adjustment_exercised_on(d, exercised_on);
    when correct_treatment_tax_difference(d, amount);
    then power Section1314MitigationAdjustment {
        holder taxpayer;
        over d;
        exercise mitigation_adjustment_exercised_on(d, exercised_on);
        valid_when mitigation_adjustment_within_1_year(d, exercised_on);
        effect create(mitigation_adjustment_made(d, taxpayer, amount));
        window [-infinity, infinity];
    };
}

// (c): the adjustment is unaffected by other items (a priority/isolation
// rule, not a computable predicate this stage — NON_NORMATIVE-by-nature
// procedural instruction to the assessing/refunding officer, not itself a
// fact this package's rules read). (d): inapplicable to subtitle C
// employment taxes — a scope-limiting cross-reference, not separately
// modelled (no employment-tax package this package could gate against).
