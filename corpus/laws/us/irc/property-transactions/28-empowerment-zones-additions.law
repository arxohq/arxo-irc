// Stage 3 (IRC-07, A05). Subchapter U additions to module 27: the additional
// empowerment zone rounds of section 1391(g) and (h) with the special (g)(3)
// eligibility rules, the designation as a POWER of the appropriate Secretaries,
// the enterprise community end date, section 1392(b) and (d), section 1393(a)(5),
// (7) and (8), section 1394 (the 95-percent facility test, the enterprise zone
// business modifications, the cure and interest-disallowance rules, empowerment
// zone facility bonds) and section 1397C(d)-(f) (qualified business, nonqualified
// financial property, contiguous-property look-through).
//
// Simplifications recorded in the coverage rows: counts of census tracts by
// poverty class are supplied by the case (an aggregate over a derived relation is
// the section 111 subset limit); dates that need date-part arithmetic (the close
// of the 10th calendar year, the first taxable year beginning more than 2 years
// after a date) are supplied by the case.

// =============================================================================
// §1393(a)(5), (7), (8): local government, joint nominations, EDC nominations
// =============================================================================

use self::{
    Asset,
    CensusTract,
    IRC_S1391_A,
    IRC_S1391_D,
    IRC_S1391_E,
    IRC_S1391_G,
    IRC_S1391_H,
    IRC_S1392_A,
    IRC_S1392_B,
    IRC_S1392_D,
    IRC_S1393_A,
    IRC_S1394_A,
    IRC_S1394_B,
    IRC_S1394_C,
    IRC_S1394_E,
    IRC_S1394_F,
    IRC_S1397C_D,
    IRC_S1397C_E,
    IRC_S1397C_F,
    NominatedArea,
    Person,
    ZoneBusiness,
    ZoneKind,
    application_meets_1391f,
    area_barred_as_indian_reservation_1393,
    area_eligible_for_designation_1392,
    collectibles_share_of_property_bases,
    designated_as,
    designation_end_candidate,
    designation_within_statutory_window,
    employee_share_resident_in_zone,
    enterprise_zone_business,
    every_trade_or_business_is_active_qualified_business_in_zone,
    gross_income_share_from_active_business,
    lowest_tract_poverty_rate,
    nomination_requirements_met_1391,
    nominators_certify_no_overlap,
    nominators_have_authority_and_give_assurances,
    nonqualified_financial_property_share,
    outstanding_zone_facility_bonds_all_zones,
    population_criterion_met_1392a1,
    property_subject_to_depreciation_168_or_179,
    rural_area_1393,
    secretary_determines_information_reasonably_accurate,
    substantial_employee_services_in_zone,
    substantial_intangible_property_used_in_business,
    substantial_tangible_property_use_in_zone,
    zone_property_acquired_by_purchase_after_designation,
    zone_property_original_use_with_taxpayer,
};

pub entity LocalGovernmentUnit : Person {
    label en official "a county, city, town, township, parish, village or other general purpose political subdivision of a State, or a combination recognized by the appropriate Secretary (section 1393(a)(5))";
}
pub relation general_purpose_political_subdivision(g: LocalGovernmentUnit) kind empirical {
    label en official "section 1393(a)(5)(A): a county, city, town, township, parish, village, or other general purpose political subdivision of a State";
}
pub relation combination_of_subdivisions_recognized_by_secretary(g: LocalGovernmentUnit) kind empirical {
    label en official "section 1393(a)(5)(B): a combination of political subdivisions described in (A) recognized by the appropriate Secretary";
}
pub relation local_government_1393(g: LocalGovernmentUnit) kind institutional {
    label en official "section 1393(a)(5): the term \"local government\"";
}
@source(IRC_S1393_A, relation = formalizes, coverage = exact, quote = "(A) any county, city, town, township, parish, village, or other general purpose political subdivision of a State, and")
rule LocalGovernmentSubdivisionRule(g: LocalGovernmentUnit) defeasible {
    label en official "section 1393(a)(5)(A)";
    when general_purpose_political_subdivision(g);
    then local_government_1393(g);
}
@source(IRC_S1393_A, relation = formalizes, coverage = exact, quote = "(B) any combination of political subdivisions described in subparagraph (A) recognized by the appropriate Secretary.")
rule LocalGovernmentCombinationRule(g: LocalGovernmentUnit) defeasible {
    label en official "section 1393(a)(5)(B)";
    when combination_of_subdivisions_recognized_by_secretary(g);
    then local_government_1393(g);
}
pub relation number_of_governments_seeking_nomination(area: NominatedArea, n: Integer) kind empirical {
    label en official "section 1393(a)(7): the number of State or local governments seeking to nominate the area";
}
pub relation number_of_seeking_governments_meeting_requirements(area: NominatedArea, n: Integer) kind empirical {
    label en official "section 1393(a)(7): the number of those governments for which each reference to, or requirement of, the subchapter is met";
}
pub relation all_nominating_governments_meet_requirements_1393a7(area: NominatedArea) kind institutional {
    label en official "section 1393(a)(7): where more than one State or local government seeks to nominate an area, a reference to or requirement of the subchapter applies to all such governments";
}
@source(IRC_S1393_A, relation = formalizes, coverage = exact, quote = "If more than 1 State or local government seeks to nominate an area under this part, any reference to, or requirement of, this subchapter shall apply to all such governments.")
rule AllNominatingGovernmentsRule(area: NominatedArea, seeking: Integer, meeting: Integer) defeasible {
    label en official "section 1393(a)(7): every seeking government meets the requirement";
    when number_of_governments_seeking_nomination(area, seeking);
    when number_of_seeking_governments_meeting_requirements(area, meeting);
    when seeking > 1;
    when meeting == seeking;
    then all_nominating_governments_meet_requirements_1393a7(area);
}
pub relation nominated_by_state_chartered_economic_development_corporation(area: NominatedArea) kind empirical {
    label en official "section 1393(a)(8): the area is nominated by an economic development corporation chartered by the State";
}
pub relation nominated_by_state_and_local_government_treated_1393a8(area: NominatedArea) kind institutional {
    label en official "section 1393(a)(8): the area is treated as nominated by a State and a local government";
}
@source(IRC_S1393_A, relation = formalizes, coverage = exact, quote = "An area shall be treated as nominated by a State and a local government if it is nominated by an economic development corporation chartered by the State.")
rule EdcNominationTreatedRule(area: NominatedArea) defeasible {
    label en official "section 1393(a)(8)";
    when nominated_by_state_chartered_economic_development_corporation(area);
    then nominated_by_state_and_local_government_treated_1393a8(area);
}
@source(IRC_S1391_E, relation = formalizes, coverage = partial, quote = "No area may be designated under this section unless—")
rule NominationRequirementsEdcRule(area: NominatedArea) defeasible {
    label en official "section 1391(e)(1) satisfied through section 1393(a)(8); the remaining (e)(2)-(5) and (f) tests as in NominationRequirementsRule";
    when nominated_by_state_and_local_government_treated_1393a8(area);
    when nominators_have_authority_and_give_assurances(area);
    when secretary_determines_information_reasonably_accurate(area);
    when nominators_certify_no_overlap(area);
    when application_meets_1391f(area);
    then nomination_requirements_met_1391(area);
}

// =============================================================================
// §1391(a), (g), (h): the designation as a power; additional rounds
// =============================================================================

pub relation secretary_designates_area(area: NominatedArea, kind: ZoneKind, on: Date) kind empirical {
    label en official "section 1391(a): the appropriate Secretaries designate the nominated area as an empowerment zone or an enterprise community on the date";
}
pub relation designation_exercise_valid_1391(area: NominatedArea) kind institutional {
    label en unofficial "single-atom helper for valid_when (section 130.3): the area is eligible under section 1392, the nomination requirements are met and the designation date is inside the window of its round";
}
@source(IRC_S1391_A, relation = formalizes, coverage = exact, quote = "From among the areas nominated for designation under this section, the appropriate Secretaries may designate empowerment zones and enterprise communities.")
rule DesignationExerciseValidRule(area: NominatedArea) defeasible {
    label en official "section 1391(a), (e), (f): only a nominated area that is eligible and properly nominated, within the window of the round";
    when area_eligible_for_designation_1392(area);
    when nomination_requirements_met_1391(area);
    when designation_within_statutory_window(area);
    then designation_exercise_valid_1391(area);
}
pub relation designation_effected_1391(area: NominatedArea, kind: ZoneKind) kind institutional {
    label en official "section 1391(a): the area is designated as an empowerment zone or an enterprise community";
}
@source(IRC_S1391_A, relation = formalizes, coverage = exact, quote = "From among the areas nominated for designation under this section, the appropriate Secretaries may designate empowerment zones and enterprise communities.")
rule Section1391DesignationPower(area: NominatedArea, kind: ZoneKind, on: Date) strict {
    label en official "section 1391(a): the appropriate Secretaries MAY designate a nominated area (a power over the nominated area, not a duty)";
    when secretary_designates_area(area, kind, on);
    then power Section1391Designation {
        holder us.irc.core::Secretary;
        over area;
        exercise secretary_designates_area(area, kind, on);
        valid_when designation_exercise_valid_1391(area);
        effect create(designation_effected_1391(area, kind));
        window [@1993-08-10, infinity);
    };
}

// (g)(1)-(2): the additional 20 empowerment zones
pub relation additional_zone_designation_counts_1391g(urban: Integer, rural: Integer) kind empirical {
    label en official "the numbers of empowerment zones designated under section 1391(g) in urban and rural areas";
}
pub relation additional_zone_caps_respected_1391g(urban: Integer, rural: Integer) kind institutional {
    label en official "section 1391(g)(1): at most 20 in the aggregate, at most 15 urban and at most 5 rural";
}
pub const AdditionalZonesRound2Cap: Integer = 20 {
    label en official "an additional 20 nominated areas as empowerment zones (section 1391(g)(1))";
};
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "Of that number, not more than 15 may be designated in urban areas and not more than 5 may be designated in rural areas.")
rule AdditionalZoneCapsRound2Rule(urban: Integer, rural: Integer) defeasible {
    label en official "section 1391(g)(1)";
    when additional_zone_designation_counts_1391g(urban, rural);
    when urban + rural <= AdditionalZonesRound2Cap;
    when urban <= 15;
    when rural <= 5;
    then additional_zone_caps_respected_1391g(urban, rural);
}

// (h)(1), (h)(4): the additional 9 (plus replacements)
pub relation additional_zone_designation_counts_1391h(urban: Integer, rural: Integer) kind empirical {
    label en official "the numbers of empowerment zones designated under section 1391(h) in urban and rural areas";
}
pub relation zones_ceasing_under_1400E_e_counts(urban: Integer, rural: Integer) kind empirical {
    label en official "section 1391(h)(4): the numbers of urban and rural areas that cease to be an empowerment zone by reason of section 1400E(e)";
}
pub relation additional_zone_caps_respected_1391h(urban: Integer, rural: Integer) kind institutional {
    label en official "section 1391(h)(1), (4): at most 9 in the aggregate, 7 urban and 2 rural, each cap increased by one for each area of the same character ceasing to be a zone under section 1400E(e)";
}
pub const AdditionalZonesRound3Cap: Integer = 9 {
    label en official "an additional 9 nominated areas as empowerment zones (section 1391(h)(1))";
};
@source(IRC_S1391_H, relation = formalizes, coverage = exact, quote = "Of that number, not more than seven may be designated in urban areas and not more than 2 may be designated in rural areas.")
rule AdditionalZoneCapsRound3Rule(urban: Integer, rural: Integer, cu: Integer, cr: Integer) defeasible {
    label en official "section 1391(h)(1) with the (h)(4) increase by one for each replaced area of the same urban or rural character";
    when additional_zone_designation_counts_1391h(urban, rural);
    when zones_ceasing_under_1400E_e_counts(cu, cr);
    when urban + rural <= AdditionalZonesRound3Cap + cu + cr;
    when urban <= 7 + cu;
    when rural <= 2 + cr;
    then additional_zone_caps_respected_1391h(urban, rural);
}

// (g)(3): eligibility rules for the additional rounds ((h)(3) applies the same rules)
pub relation tract_in_nominated_area(tract: CensusTract, area: NominatedArea) kind empirical {
    label en unofficial "the census tract lies within the nominated area";
}
pub relation tract_population_1391g(tract: CensusTract, n: Integer) kind empirical {
    label en official "section 1391(g)(3)(A)(ii): the population of the tract";
}
pub relation tract_poverty_rate_1391g(tract: CensusTract, rate: Decimal) kind empirical {
    label en official "section 1391(g)(3)(A)(i): the poverty rate of the tract";
}
pub relation tract_share_zoned_commercial_or_industrial(tract: CensusTract, share: Decimal) kind empirical {
    label en official "section 1391(g)(3)(A)(ii)(I): the share of the tract zoned for commercial or industrial use";
}
pub relation tract_contiguous_to_tract_with_poverty_at_least_25_percent(tract: CensusTract) kind empirical {
    label en official "section 1391(g)(3)(A)(ii)(II): the tract is contiguous to one or more tracts with a poverty rate of at least 25 percent (determined without regard to clause (ii))";
}
pub relation tract_treated_as_poverty_25_percent_1391g(tract: CensusTract) kind institutional {
    label en official "section 1391(g)(3)(A): the tract has a poverty rate of not less than 25 percent, actually or by the clause (ii) rule";
}
@source(IRC_S1391_G, relation = formalizes, coverage = partial, quote = "A nominated area shall be eligible for designation under this subsection only if the poverty rate for each population census tract within the nominated area is not less than 20 percent and the poverty rate for at least 90 percent of the population census tracts within the nominated area is not less than 25 percent.")
rule TractPoverty25ActualRule(tract: CensusTract, rate: Decimal) defeasible {
    label en official "section 1391(g)(3)(A)(i): actual poverty rate of at least 25 percent";
    when tract_poverty_rate_1391g(tract, rate);
    when rate >= 0.25;
    then tract_treated_as_poverty_25_percent_1391g(tract);
}
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "A population census tract with a population of less than 2,000 shall be treated as having a poverty rate of not less than 25 percent if—")
rule TractPoverty25SmallTractRule(tract: CensusTract, pop: Integer, zoned: Decimal) defeasible {
    label en official "section 1391(g)(3)(A)(ii): population under 2,000, more than 75 percent zoned commercial or industrial and contiguous to a tract at 25 percent";
    when tract_population_1391g(tract, pop);
    when pop < 2000;
    when tract_share_zoned_commercial_or_industrial(tract, zoned);
    when zoned > 0.75;
    when tract_contiguous_to_tract_with_poverty_at_least_25_percent(tract);
    then tract_treated_as_poverty_25_percent_1391g(tract);
}
pub relation area_tract_count(area: NominatedArea, n: Integer) kind empirical {
    label en official "the number of population census tracts within the nominated area";
}
pub relation area_tracts_treated_as_25_percent_count(area: NominatedArea, n: Integer) kind empirical {
    label en official "the number of tracts within the area that satisfy tract_treated_as_poverty_25_percent_1391g (supplied by the case: an aggregate over a derived relation is the section 111 subset limit)";
}
pub relation noncontiguous_parcel_count_1391g(area: NominatedArea, n: Integer) kind empirical {
    label en official "section 1391(g)(3)(A)(iii): the number of noncontiguous parcels developed for commercial or industrial purposes";
}
pub relation noncontiguous_parcel_acreage_1391g(area: NominatedArea, acres: Integer) kind empirical {
    label en official "section 1391(g)(3)(A)(iii): the aggregate area of those parcels in acres";
}
pub relation parcel_exemption_from_clause_i_applies(area: NominatedArea) kind institutional {
    label en official "section 1391(g)(3)(A)(iii): clause (i) does not apply to up to 3 noncontiguous parcels of aggregate area of at most 2,000 acres";
}
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "Clause (i) shall not apply to up to 3 noncontiguous parcels in a nominated area which may be developed for commercial or industrial purposes.")
rule ParcelExemptionRule(area: NominatedArea, n: Integer, acres: Integer) defeasible {
    label en official "section 1391(g)(3)(A)(iii): at most 3 parcels, aggregate at most 2,000 acres";
    when noncontiguous_parcel_count_1391g(area, n);
    when noncontiguous_parcel_acreage_1391g(area, acres);
    when n <= 3;
    when acres <= 2000;
    then parcel_exemption_from_clause_i_applies(area);
}
pub relation poverty_criteria_met_1391g3(area: NominatedArea) kind institutional {
    label en official "section 1391(g)(3)(A)(i): each tract at least 20 percent and at least 90 percent of the tracts at least 25 percent (section 1392(a)(4) does not apply, clause (iv))";
}
@source(IRC_S1391_G, relation = formalizes, coverage = partial, quote = "Section 1392(a)(4) (and so much of paragraphs (1) and (2) of section 1392(b) as relate to section 1392(a)(4)) shall not apply to an area nominated for designation under this subsection.")
rule PovertyCriteriaG3Rule(area: NominatedArea, low: Decimal, total: Integer, treated: Integer) defeasible {
    label en official "section 1391(g)(3)(A)(i) and (iv): 20 percent floor in every tract, 25 percent in at least 90 percent of tracts (the count is case-supplied)";
    when lowest_tract_poverty_rate(area, low);
    when low >= 0.20;
    when area_tract_count(area, total);
    when area_tracts_treated_as_25_percent_count(area, treated);
    when treated * 10 >= total * 9;
    then poverty_criteria_met_1391g3(area);
}
@source(IRC_S1391_G, relation = formalizes, coverage = partial, quote = "Clause (i) shall not apply to up to 3 noncontiguous parcels in a nominated area which may be developed for commercial or industrial purposes.")
rule PovertyCriteriaG3ParcelRule(area: NominatedArea, total: Integer, treated: Integer) defeasible {
    label en official "section 1391(g)(3)(A)(iii): where the parcel exemption applies clause (i) is satisfied by the remaining tracts; the case supplies the counts without the exempt parcels";
    when parcel_exemption_from_clause_i_applies(area);
    when area_tract_count(area, total);
    when area_tracts_treated_as_25_percent_count(area, treated);
    when treated * 10 >= total * 9;
    then poverty_criteria_met_1391g3(area);
}
pub relation rural_zone_by_emigration_criteria(area: NominatedArea) kind empirical {
    label en official "section 1391(g)(3)(A)(v): the rural area satisfies the emigration criteria specified by the Secretary of Agriculture";
}
pub relation rural_emigration_zones_designated_count(n: Integer) kind empirical {
    label en official "the number of rural empowerment zones designated by the Secretary of Agriculture without regard to clause (i)";
}
pub relation emigration_designation_permitted_1391g3av(area: NominatedArea) kind institutional {
    label en official "section 1391(g)(3)(A)(v): the Secretary of Agriculture may designate not more than 1 empowerment zone in a rural area without regard to clause (i)";
}
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "The Secretary of Agriculture may designate not more than 1 empowerment zone in a rural area without regard to clause (i) if such area satisfies emigration criteria specified by the Secretary of Agriculture.")
rule EmigrationDesignationRule(area: NominatedArea, n: Integer) defeasible {
    label en official "section 1391(g)(3)(A)(v)";
    when rural_area_1393(area);
    when rural_zone_by_emigration_criteria(area);
    when rural_emigration_zones_designated_count(n);
    when n <= 1;
    then emigration_designation_permitted_1391g3av(area);
}
pub relation size_parcels_disregarded_1391g3b(area: NominatedArea) kind institutional {
    label en official "section 1391(g)(3)(B)(i): the parcels of (A)(iii) are not taken into account in the 1392(a)(3)(A) or (B) requirements";
}
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "The parcels described in subparagraph (A)(iii) shall not be taken into account in determining whether the requirement of subparagraph (A) or (B) of section 1392(a)(3) is met.")
rule ParcelsDisregardedForSizeRule(area: NominatedArea) defeasible {
    label en official "section 1391(g)(3)(B)(i)";
    when parcel_exemption_from_clause_i_applies(area);
    then size_parcels_disregarded_1391g3b(area);
}
pub relation rural_tract_square_miles(area: NominatedArea, sq: Integer) kind empirical {
    label en official "section 1391(g)(3)(B)(ii): the square miles of a rural tract";
}
pub relation rural_tract_government_owned_land_substantial(area: NominatedArea) kind empirical {
    label en official "section 1391(g)(3)(B)(ii): the rural tract includes a substantial amount of land owned by the Federal, State or local government (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation rural_excess_exclusion_permitted_1391g3b(area: NominatedArea) kind institutional {
    label en official "section 1391(g)(3)(B)(ii): the nominated area may exclude the excess square mileage or the governmentally owned land without violating the continuous-boundary requirement";
}
@source(IRC_S1391_G, relation = formalizes, coverage = partial, quote = "If a population census tract (or equivalent division under section 1392(b)(4)) in a rural area exceeds 1,000 square miles")
rule RuralExcessExclusionExceedsRule(area: NominatedArea, sq: Integer) defeasible {
    label en official "section 1391(g)(3)(B)(ii): a rural tract above 1,000 square miles";
    when rural_area_1393(area);
    when rural_tract_square_miles(area, sq);
    when sq > 1000;
    then rural_excess_exclusion_permitted_1391g3b(area);
}
rule RuralExcessExclusionGovernmentLandRule(area: NominatedArea) defeasible {
    label en official "section 1391(g)(3)(B)(ii): a rural tract with substantial governmentally owned land";
    when rural_area_1393(area);
    when rural_tract_government_owned_land_substantial(area);
    then rural_excess_exclusion_permitted_1391g3b(area);
}
pub relation aggregate_population_limit_disapplied_1391g3c(area: NominatedArea) kind institutional {
    label en official "section 1391(g)(3)(C): the aggregate population limitation of the last sentence of section 1391(b)(2) does not apply to a designation under paragraph (1)";
}
pub relation designated_under_1391g1(area: NominatedArea) kind empirical {
    label en official "the area is designated under section 1391(g)(1)";
}
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "The aggregate population limitation under the last sentence of subsection (b)(2) shall not apply to a designation under paragraph (1).")
rule AggregatePopulationLimitDisappliedRule(area: NominatedArea) defeasible {
    label en official "section 1391(g)(3)(C)";
    when designated_under_1391g1(area);
    then aggregate_population_limit_disapplied_1391g3c(area);
}
pub relation also_nominated_under_1391g(area: NominatedArea) kind empirical {
    label en official "the enterprise community is also nominated for designation under section 1391(g)";
}
pub relation overlap_certification_disapplied_1391g3d(area: NominatedArea) kind institutional {
    label en official "section 1391(g)(3)(D): section 1391(e)(5) does not apply to an enterprise community designated under (a) that is also nominated under (g)";
}
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "Subsection (e)(5) shall not apply to any enterprise community designated under subsection (a) that is also nominated for designation under this subsection.")
rule OverlapCertificationDisappliedRule(area: NominatedArea) defeasible {
    label en official "section 1391(g)(3)(D)";
    when designated_as(area, EnterpriseCommunity);
    when also_nominated_under_1391g(area);
    then overlap_certification_disapplied_1391g3d(area);
}
pub relation nominated_in_indian_reservation_area(area: NominatedArea) kind empirical {
    label en official "section 1391(g)(3)(E): the area lies in an Indian reservation";
}
pub relation nominated_by_reservation_governing_body(area: NominatedArea) kind empirical {
    label en official "section 1391(g)(3)(E)(ii): the area is nominated by the reservation governing body (as determined by the Secretary of the Interior)";
}
pub relation indian_reservation_bar_disapplied_1391g3e(area: NominatedArea) kind institutional {
    label en official "section 1391(g)(3)(E)(i): section 1393(a)(4) does not apply to an area nominated under this subsection";
}
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "Section 1393(a)(4) shall not apply to an area nominated for designation under this subsection.")
rule IndianReservationBarDisappliedRule(area: NominatedArea) defeasible {
    label en official "section 1391(g)(3)(E)(i)";
    when designated_under_1391g1(area);
    then indian_reservation_bar_disapplied_1391g3e(area);
}
@source(IRC_S1391_G, relation = formalizes, coverage = exact, quote = "An area in an Indian reservation shall be treated as nominated by a State and a local government if it is nominated by the reservation governing body (as determined by the Secretary of the Interior).")
rule ReservationNominationTreatedRule(area: NominatedArea) defeasible {
    label en official "section 1391(g)(3)(E)(ii)";
    when nominated_in_indian_reservation_area(area);
    when nominated_by_reservation_governing_body(area);
    then nominated_by_state_and_local_government_treated_1393a8(area);
}
pub relation designated_under_1391h(area: NominatedArea) kind empirical {
    label en official "the area is designated under section 1391(h)";
}
pub relation g3_rules_apply_to_area(area: NominatedArea) kind institutional {
    label en official "section 1391(h)(3): the rules of subsection (g)(3) apply to designations under subsection (h)";
}
@source(IRC_S1391_H, relation = formalizes, coverage = exact, quote = "The rules of subsection (g)(3) shall apply to designations under this subsection.")
rule G3RulesApplyToHRule(area: NominatedArea) defeasible {
    label en official "section 1391(h)(3)";
    when designated_under_1391h(area);
    then g3_rules_apply_to_area(area);
}
rule G3RulesApplyToGRule(area: NominatedArea) defeasible {
    label en official "section 1391(g)(3): the rules apply to designations under paragraph (1)";
    when designated_under_1391g1(area);
    then g3_rules_apply_to_area(area);
}

// §1391(d)(1)(A)(ii): the enterprise community end date (the case supplies the
// close of the 10th calendar year beginning on or after the designation date)
pub relation first_january_1_on_or_after_area_designation(area: NominatedArea, jan1: Date) kind empirical {
    label en official "section 1391(d)(1)(A)(ii): the first January 1 on or after the date of designation (the year-part arithmetic is supplied by the case; the period arithmetic is derived)";
}
@source(IRC_S1391_D, relation = formalizes, coverage = partial, quote = "(ii) in the case of an enterprise community, the close of the 10th calendar year beginning on or after such date of designation,")
rule EndCandidateEnterpriseCommunityRule(area: NominatedArea, jan1: Date, calendar_before_1: Date) defeasible {
    label en official "section 1391(d)(1)(A)(ii): December 31 of the 10th calendar year beginning on or after designation";
    when designated_as(area, EnterpriseCommunity);
    when first_january_1_on_or_after_area_designation(area, jan1)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(jan1, 10 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then designation_end_candidate(area, calendar_before_1);
}

// =============================================================================
// §1392(b) and (d)
// =============================================================================

pub relation tract_has_no_population(tract: CensusTract) kind empirical {
    label en official "section 1392(b)(1)(A): a population census tract with no population";
}
pub relation tract_treated_as_meeting_1392a4_ab(tract: CensusTract) kind institutional {
    label en official "section 1392(b)(1): the tract is treated as having a poverty rate that meets subparagraphs (A) and (B) of section 1392(a)(4)";
}
@source(IRC_S1392_B, relation = formalizes, coverage = exact, quote = "(i) such tract shall be treated as having a poverty rate which meets the requirements of subparagraphs (A) and (B) of subsection (a)(4), but")
rule NoPopulationTractAbRule(tract: CensusTract) defeasible {
    label en official "section 1392(b)(1)(A)(i)";
    when tract_has_no_population(tract);
    then tract_treated_as_meeting_1392a4_ab(tract);
}
pub relation tract_treated_as_zero_poverty_for_1392a4c(tract: CensusTract) kind institutional {
    label en official "section 1392(b)(1)(A)(ii): the no-population tract is treated as having a zero poverty rate for subparagraph (C)";
}
@source(IRC_S1392_B, relation = formalizes, coverage = exact, quote = "(ii) such tract shall be treated as having a zero poverty rate for purposes of applying subparagraph (C) thereof.")
rule NoPopulationTractZeroPovertyRule(tract: CensusTract) defeasible {
    label en official "section 1392(b)(1)(A)(ii)";
    when tract_has_no_population(tract);
    then tract_treated_as_zero_poverty_for_1392a4c(tract);
}
@source(IRC_S1392_B, relation = formalizes, coverage = exact, quote = "A population census tract with a population of less than 2,000 shall be treated as having a poverty rate which meets the requirements of subparagraphs (A) and (B) of subsection (a)(4) if more than 75 percent of such tract is zoned for commercial or industrial use.")
rule SmallZonedTractAbRule(tract: CensusTract, pop: Integer, zoned: Decimal) defeasible {
    label en official "section 1392(b)(1)(B)";
    when tract_population_1391g(tract, pop);
    when pop < 2000;
    when tract_share_zoned_commercial_or_industrial(tract, zoned);
    when zoned > 0.75;
    then tract_treated_as_meeting_1392a4_ab(tract);
}
// (b)(2): the appropriate Secretary MAY reduce a threshold for enterprise communities
pub relation secretary_reduces_threshold_1392b2(area: NominatedArea, threshold_c: Boolean) kind empirical {
    label en official "section 1392(b)(2): the appropriate Secretary reduces a poverty threshold for the enterprise community nomination (true: the (C) 10-point reduction for 3 tracts; false: a 5-point reduction of one threshold)";
}
pub relation reduced_tract_count_1392b2(area: NominatedArea, n: Integer) kind empirical {
    label en official "section 1392(b)(2): the number of tracts for which the threshold is reduced";
}
pub relation nominated_area_tract_total_1392b2(area: NominatedArea, n: Integer) kind empirical {
    label en official "the number of population census tracts in the nominated area";
}
pub relation seeking_enterprise_community_designation(area: NominatedArea) kind empirical {
    label en official "the area is nominated for designation as an enterprise community";
}
pub relation threshold_reduction_within_tract_limit_1392b2(area: NominatedArea) kind institutional {
    label en unofficial "single-atom helper for valid_when: the reduction touches not more than 10 percent of the tracts (or, if fewer, 5), or in the (C) alternative 3 tracts";
}
@source(IRC_S1392_B, relation = formalizes, coverage = partial, quote = "(A) The 20 percent threshold in subsection (a)(4)(A).")
rule ReductionWithinLimitFivePointRule(area: NominatedArea, n: Integer, total: Integer) defeasible {
    label en official "section 1392(b)(2): a 5-point reduction for at most 10 percent of the tracts and at most 5 tracts";
    when secretary_reduces_threshold_1392b2(area, false);
    when reduced_tract_count_1392b2(area, n);
    when nominated_area_tract_total_1392b2(area, total);
    when n * 10 <= total;
    when n <= 5;
    then threshold_reduction_within_tract_limit_1392b2(area);
}
@source(IRC_S1392_B, relation = formalizes, coverage = exact, quote = "If the appropriate Secretary elects to reduce the threshold under subparagraph (C), such Secretary may (in lieu of applying the preceding sentence) reduce by 10 percentage points the threshold under subparagraph (C) for 3 population census tracts.")
rule ReductionWithinLimitCAlternativeRule(area: NominatedArea, n: Integer) defeasible {
    label en official "section 1392(b)(2), last sentence: a 10-point reduction of the (C) threshold for 3 tracts";
    when secretary_reduces_threshold_1392b2(area, true);
    when reduced_tract_count_1392b2(area, n);
    when n <= 3;
    then threshold_reduction_within_tract_limit_1392b2(area);
}
pub relation threshold_reduced_1392b2(area: NominatedArea) kind institutional {
    label en official "section 1392(b)(2): the threshold is reduced for the nominated area";
}
@source(IRC_S1392_B, relation = formalizes, coverage = exact, quote = "In determining whether a nominated area is eligible for designation as an enterprise community, the appropriate Secretary may, where necessary to carry out the purposes of this subchapter, reduce by 5 percentage points one of the following thresholds for not more than 10 percent of the population census tracts (or, if fewer, 5 population census tracts) in the nominated area:")
rule Section1392ThresholdReductionPower(area: NominatedArea, c: Boolean) strict {
    label en official "section 1392(b)(2): the appropriate Secretary MAY reduce a threshold in determining eligibility as an enterprise community";
    when secretary_reduces_threshold_1392b2(area, c);
    then power Section1392ThresholdReduction {
        holder us.irc.core::Secretary;
        over area;
        exercise secretary_reduces_threshold_1392b2(area, c);
        valid_when threshold_reduction_within_tract_limit_1392b2(area);
        effect create(threshold_reduced_1392b2(area));
        window [@1993-08-10, infinity);
    };
}
pub relation parcels_not_meeting_criteria_separately(area: NominatedArea, n: Integer) kind empirical {
    label en official "section 1392(b)(3): the number of noncontiguous parcels that do not separately meet the section 1392(a)(4) criteria (subject to (b)(1) and (2))";
}
pub relation noncontiguous_parcel_includable_1392b3(area: NominatedArea) kind institutional {
    label en official "section 1392(b)(3): the nominated area may include its noncontiguous parcels, each having separately met the criteria";
}
@source(IRC_S1392_B, relation = formalizes, coverage = exact, quote = "A nominated area may not include a noncontiguous parcel unless such parcel separately meets (subject to paragraphs (1) and (2)) the criteria set forth in subsection (a)(4).")
rule NoncontiguousParcelCriteriaRule(area: NominatedArea) defeasible {
    label en official "section 1392(b)(3): no parcel fails the criteria";
    when parcels_not_meeting_criteria_separately(area, 0);
    then noncontiguous_parcel_includable_1392b3(area);
}
pub relation area_not_tracted(area: NominatedArea) kind empirical {
    label en official "section 1392(b)(4): the area is not tracted for population census tracts";
}
pub relation poverty_unit_is_equivalent_county_division(area: NominatedArea) kind institutional {
    label en official "section 1392(b)(4): the equivalent county divisions (as defined by the Bureau of the Census for defining poverty areas) are used for the poverty rates";
}
@source(IRC_S1392_B, relation = formalizes, coverage = exact, quote = "In the case of an area which is not tracted for population census tracts, the equivalent county divisions (as defined by the Bureau of the Census for purposes of defining poverty areas) shall be used for purposes of determining poverty rates.")
rule EquivalentCountyDivisionRule(area: NominatedArea) defeasible {
    label en official "section 1392(b)(4)";
    when area_not_tracted(area);
    then poverty_unit_is_equivalent_county_division(area);
}
pub relation area_in_alaska_or_hawaii(area: NominatedArea) kind empirical {
    label en official "section 1392(d): the nominated area is in Alaska or Hawaii";
}
pub relation lowest_share_of_low_income_families_in_unit(area: NominatedArea, share: Decimal) kind empirical {
    label en official "section 1392(d): the lowest, over the census tracts or block groups of the area, of the share of families with income of at most 50 percent of the statewide median family income (section 143)";
}
pub relation alaska_hawaii_criteria_deemed_met_1392d(area: NominatedArea) kind institutional {
    label en official "section 1392(d): the area is treated as meeting the requirements of paragraphs (2), (3) and (4) of subsection (a)";
}
@source(IRC_S1392_D, relation = formalizes, coverage = exact, quote = "A nominated area in Alaska or Hawaii shall be treated as meeting the requirements of paragraphs (2), (3), and (4) of subsection (a) if for each census tract or block group within such area 20 percent or more of the families have income which is 50 percent or less of the statewide median family income (as determined under section 143).")
rule AlaskaHawaiiDeemedRule(area: NominatedArea, share: Decimal) defeasible {
    label en official "section 1392(d)";
    when area_in_alaska_or_hawaii(area);
    when lowest_share_of_low_income_families_in_unit(area, share);
    when share >= 0.20;
    then alaska_hawaii_criteria_deemed_met_1392d(area);
}
@source(IRC_S1392_A, relation = formalizes, coverage = partial, quote = "A nominated area shall be eligible for designation under section 1391 only if it meets the following criteria:")
rule AreaEligibleAlaskaHawaiiRule(area: NominatedArea) defeasible {
    label en official "section 1392(a)(1) with section 1392(d): the (2)-(4) criteria are deemed met";
    when population_criterion_met_1392a1(area);
    when alaska_hawaii_criteria_deemed_met_1392d(area);
    when not_known(area_barred_as_indian_reservation_1393(area));
    then area_eligible_for_designation_1392(area);
}

// =============================================================================
// §1394: enterprise zone facility bonds
// =============================================================================

pub entity ZoneBondIssue {
    label en official "an issue of bonds financing an enterprise zone facility (section 1394)";
}
pub relation issue_net_proceeds_share_for_zone_facility(i: ZoneBondIssue, share: Decimal) kind empirical {
    label en official "section 1394(a): the share of the net proceeds (section 150(a)(3)) to be used to provide an enterprise zone facility";
}
pub relation exempt_facility_bond_by_1394(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(a): the bond is an exempt facility bond for part IV of subchapter B";
}
@source(IRC_S1394_A, relation = formalizes, coverage = exact, quote = "For purposes of part IV of subchapter B of this chapter (relating to tax exemption requirements for State and local bonds), the term \"exempt facility bond\" includes any bond issued as part of an issue 95 percent or more of the net proceeds (as defined in section 150(a)(3)) of which are to be used to provide any enterprise zone facility.")
rule ExemptFacilityBond1394Rule(i: ZoneBondIssue, share: Decimal) defeasible {
    label en official "section 1394(a): 95 percent or more of the net proceeds";
    when issue_net_proceeds_share_for_zone_facility(i, share);
    when share >= 0.95;
    then exempt_facility_bond_by_1394(i);
}
pub relation zone_facility_candidate_property(a: Asset) kind empirical {
    label en official "section 1394(b)(1): the property in question, a candidate for an enterprise zone facility";
}
pub relation principal_user_of_property(a: Asset, b: ZoneBusiness) kind empirical {
    label en official "section 1394(b)(1): the principal user of the property";
}
pub relation land_functionally_related_and_subordinate_to(land: Asset, prop: Asset) kind empirical {
    label en official "section 1394(b)(1): the land is functionally related and subordinate to the qualified zone property";
}
pub relation qualified_zone_property_1394(a: Asset) kind institutional {
    label en official "section 1394(b)(2): qualified zone property, with the enterprise-community and 15-percent substitutions";
}
pub relation zone_property_substantially_all_used_in_zone_or_community(a: Asset) kind empirical {
    label en official "section 1394(b)(2)(A): substantially all of the use is in an empowerment zone or enterprise community in the active conduct of a qualified business";
}
pub relation renovation_additions_to_basis_1394(a: Asset, amount: Money) kind empirical {
    label en official "section 1394(b)(2)(B): the additions to basis in the renovation period";
}
pub relation adjusted_basis_at_start_of_renovation_1394(a: Asset, amount: Money) kind empirical {
    label en official "section 1394(b)(2)(B): the adjusted basis of the property";
}
@source(IRC_S1394_B, relation = formalizes, coverage = partial, quote = "The term \"qualified zone property\" has the meaning given such term by section 1397D; except that—")
rule QualifiedZoneProperty1394PurchaseRule(a: Asset) defeasible {
    label en official "section 1394(b)(2) with (A): the section 1397D(a)(1) test where a zone includes an enterprise community";
    when property_subject_to_depreciation_168_or_179(a);
    when zone_property_acquired_by_purchase_after_designation(a);
    when zone_property_original_use_with_taxpayer(a);
    when zone_property_substantially_all_used_in_zone_or_community(a);
    then qualified_zone_property_1394(a);
}
@source(IRC_S1394_B, relation = formalizes, coverage = exact, quote = "(B) section 1397D(a)(2) shall be applied by substituting \"an amount equal to 15 percent of the adjusted basis\" for \"an amount equal to the adjusted basis\".")
rule QualifiedZoneProperty1394RenovatedRule(a: Asset, added: Money, basis: Money) defeasible {
    label en official "section 1394(b)(2)(B): renovation additions of at least 15 percent of the adjusted basis";
    when property_subject_to_depreciation_168_or_179(a);
    when renovation_additions_to_basis_1394(a, added);
    when adjusted_basis_at_start_of_renovation_1394(a, basis);
    when added >= basis * 15 percent;
    when zone_property_substantially_all_used_in_zone_or_community(a);
    then qualified_zone_property_1394(a);
}
pub relation enterprise_zone_facility_property_1394(a: Asset) kind institutional {
    label en official "section 1394(b)(1), first limb: qualified zone property whose principal user is an enterprise zone business";
}
pub relation enterprise_zone_facility_1394(a: Asset) kind institutional {
    label en official "section 1394(b)(1): qualified zone property whose principal user is an enterprise zone business, and functionally related and subordinate land";
}
pub relation enterprise_zone_business_1394(b: ZoneBusiness) kind institutional {
    label en official "section 1394(b)(3): the enterprise zone business as modified for the section";
}
@source(IRC_S1394_B, relation = formalizes, coverage = exact, quote = "The term \"enterprise zone facility\" means any qualified zone property the principal user of which is an enterprise zone business, and any land which is functionally related and subordinate to such property.")
rule EnterpriseZoneFacilityPropertyRule(a: Asset, b: ZoneBusiness) defeasible {
    label en official "section 1394(b)(1), first limb";
    when qualified_zone_property_1394(a);
    when principal_user_of_property(a, b);
    when enterprise_zone_business_1394(b);
    then enterprise_zone_facility_property_1394(a);
}
rule EnterpriseZoneFacilityIncludesPropertyRule(a: Asset) defeasible {
    label en official "section 1394(b)(1): the property limb is a facility";
    when enterprise_zone_facility_property_1394(a);
    then enterprise_zone_facility_1394(a);
}
rule EnterpriseZoneFacilityLandRule(land: Asset, prop: Asset) defeasible {
    label en official "section 1394(b)(1), second limb: land functionally related and subordinate to a facility";
    when enterprise_zone_facility_property_1394(prop);
    when land_functionally_related_and_subordinate_to(land, prop);
    then enterprise_zone_facility_1394(land);
}

// (b)(3): the enterprise zone business as modified
pub relation enterprise_zone_business_unmodified_1394(b: ZoneBusiness) kind institutional {
    label en official "section 1394(b)(3)(A): the unmodified section 1397C definition";
}
@source(IRC_S1394_B, relation = formalizes, coverage = exact, quote = "Except as modified in this paragraph, the term \"enterprise zone business\" has the meaning given such term by section 1397C.")
rule EnterpriseZoneBusiness1394BaseRule(b: ZoneBusiness) defeasible {
    label en official "section 1394(b)(3)(A)";
    when enterprise_zone_business(b);
    then enterprise_zone_business_1394(b);
}
pub relation employee_share_resident_in_zone_community_or_qlic(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "section 1394(b)(3)(B)(i): the share of employees who are residents of an empowerment zone, enterprise community, or qualified low-income community within an applicable nominating jurisdiction";
}
@source(IRC_S1394_B, relation = formalizes, coverage = partial, quote = "For purposes of subsections (b)(6) and (c)(5) of section 1397C, an employee shall be treated as a resident of an empowerment zone if such employee is a resident of an empowerment zone, an enterprise community, or a qualified low-income community within an applicable nominating jurisdiction.")
rule EnterpriseZoneBusiness1394ResidentsRule(b: ZoneBusiness, income: Decimal, residents: Decimal, collectibles: Decimal, financial: Decimal) defeasible {
    label en official "section 1394(b)(3)(B)(i): section 1397C(b)/(c) with enterprise communities counted as zones and the extended residence test";
    when every_trade_or_business_is_active_qualified_business_in_zone(b);
    when gross_income_share_from_active_business(b, income);
    when income >= 0.50;
    when substantial_tangible_property_use_in_zone(b);
    when substantial_intangible_property_used_in_business(b);
    when substantial_employee_services_in_zone(b);
    when employee_share_resident_in_zone_community_or_qlic(b, residents);
    when residents >= 0.35;
    when collectibles_share_of_property_bases(b, collectibles);
    when collectibles < 0.05;
    when nonqualified_financial_property_share(b, financial);
    when financial < 0.05;
    then enterprise_zone_business_1394(b);
}
pub relation business_in_startup_period_1394(b: ZoneBusiness) kind empirical {
    label en official "section 1394(b)(3)(D)(i): the business is within the startup period of the property (the period before the first taxable year beginning more than 2 years after the later of the issue date and the placed-in-service date or 3-year date; date arithmetic is supplied by the case)";
}
pub relation reasonably_expected_to_be_enterprise_zone_business_at_end_of_startup(b: ZoneBusiness) kind empirical {
    label en official "section 1394(b)(3)(B)(ii)(I): as of the beginning of the startup period it is reasonably expected that the business will be an enterprise zone business at the end of the period (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation business_makes_bona_fide_efforts_to_qualify(b: ZoneBusiness) kind empirical {
    label en official "section 1394(b)(3)(B)(ii)(II): the business makes bona fide efforts to be such a business (an evaluative element: adjudicated fact, DECISION-0194)";
}
@source(IRC_S1394_B, relation = formalizes, coverage = exact, quote = "A business shall not fail to be treated as an enterprise zone business during the startup period if—")
rule EnterpriseZoneBusiness1394StartupRule(b: ZoneBusiness) defeasible {
    label en official "section 1394(b)(3)(B)(ii)";
    when business_in_startup_period_1394(b);
    when reasonably_expected_to_be_enterprise_zone_business_at_end_of_startup(b);
    when business_makes_bona_fide_efforts_to_qualify(b);
    then enterprise_zone_business_1394(b);
}
pub relation business_after_testing_period_year_1394(b: ZoneBusiness) kind empirical {
    label en official "section 1394(b)(3)(B)(iii): the taxable year begins after the testing period (the first 3 taxable years beginning after the startup period, (D)(ii))";
}
pub relation employee_share_resident_in_zone_community_or_qlic_for_year(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "section 1394(b)(3)(B)(iii): the share of employees for the year who are residents of a zone, community or qualified low-income community within an applicable nominating jurisdiction";
}
@source(IRC_S1394_B, relation = formalizes, coverage = exact, quote = "A business shall not fail to be treated as an enterprise zone business for any taxable year beginning after the testing period by reason of failing to meet any requirement of subsection (b) or (c) of section 1397C if at least 35 percent of the employees of such business for such year are residents of an empowerment zone, an enterprise community, or a qualified low-income community within an applicable nominating jurisdiction.")
rule EnterpriseZoneBusiness1394PostTestingRule(b: ZoneBusiness, share: Decimal) defeasible {
    label en official "section 1394(b)(3)(B)(iii): at least 35 percent resident employees after the testing period";
    when business_after_testing_period_year_1394(b);
    when employee_share_resident_in_zone_community_or_qlic_for_year(b, share);
    when share >= 0.35;
    then enterprise_zone_business_1394(b);
}
pub relation issue_date_1394(b: ZoneBusiness, on: Date) kind empirical {
    label en official "section 1394(b)(3)(D)(i)(I): the date of issuance of the issue providing the property";
}
pub relation placed_in_service_after_issuance_1394(b: ZoneBusiness, on: Date) kind empirical {
    label en official "section 1394(b)(3)(D)(i)(II): the date the property is first placed in service after the issuance";
}
pub relation third_anniversary_of_issue_1394(b: ZoneBusiness, on: Date) kind institutional {
    label en official "section 1394(b)(3)(D)(i)(II): the date 3 years after the date of issuance";
}
rule ThirdAnniversaryRule(b: ZoneBusiness, issue: Date) defeasible {
    label en official "section 1394(b)(3)(D)(i)(II)";
    when issue_date_1394(b, issue);
    then third_anniversary_of_issue_1394(b, add_calendar_period(issue, 3 calendar_year));
}
pub relation startup_reference_date_1394(b: ZoneBusiness, on: Date) kind institutional {
    label en official "section 1394(b)(3)(D)(i): the later of (I) the issue date and (II) the placed-in-service date or, if earlier, the date 3 years after the issue date";
}
pub relation earlier_placed_in_service_measure_1394(b: ZoneBusiness, on: Date) kind institutional {
    label en unofficial "the (II) date: the placed-in-service date, or, if earlier, the third anniversary of the issue date";
}
@source(IRC_S1394_B, relation = formalizes, coverage = exact, quote = "(II) the date such property is first placed in service after such issuance (or, if earlier, the date which is 3 years after the date described in subclause (I)).")
rule StartupSecondDateInServiceRule(b: ZoneBusiness, ps: Date, third: Date) defeasible {
    label en official "section 1394(b)(3)(D)(i)(II): placed in service on or before the third anniversary";
    when placed_in_service_after_issuance_1394(b, ps);
    when third_anniversary_of_issue_1394(b, third);
    when ps <= third;
    then earlier_placed_in_service_measure_1394(b, ps);
}
rule StartupSecondDateThirdAnniversaryRule(b: ZoneBusiness, ps: Date, third: Date) defeasible {
    label en official "section 1394(b)(3)(D)(i)(II): the third anniversary when it is earlier than the placed-in-service date";
    when placed_in_service_after_issuance_1394(b, ps);
    when third_anniversary_of_issue_1394(b, third);
    when third < ps;
    then earlier_placed_in_service_measure_1394(b, third);
}
rule StartupSecondDateNeverInServiceRule(b: ZoneBusiness, third: Date) defeasible {
    label en official "section 1394(b)(3)(D)(i)(II): with no placement in service the third anniversary governs";
    when third_anniversary_of_issue_1394(b, third);
    when not_known(placed_in_service_after_issuance_1394(b, third));
    when not_known(placed_in_service_recorded_1394(b));
    then earlier_placed_in_service_measure_1394(b, third);
}
pub relation placed_in_service_recorded_1394(b: ZoneBusiness) kind empirical {
    label en unofficial "a placed-in-service date is recorded for the property";
}
@source(IRC_S1394_B, relation = formalizes, coverage = partial, quote = "The term \"startup period\" means, with respect to any property being provided for any business, the period before the first taxable year beginning more than 2 years after the later of—")
rule StartupReferenceDateFromIssueRule(b: ZoneBusiness, issue: Date, other: Date) defeasible {
    label en official "section 1394(b)(3)(D)(i): the later date is the issue date";
    when issue_date_1394(b, issue);
    when earlier_placed_in_service_measure_1394(b, other);
    when issue >= other;
    then startup_reference_date_1394(b, issue);
}
rule StartupReferenceDateFromServiceRule(b: ZoneBusiness, issue: Date, other: Date) defeasible {
    label en official "section 1394(b)(3)(D)(i): the later date is the (II) date";
    when issue_date_1394(b, issue);
    when earlier_placed_in_service_measure_1394(b, other);
    when other > issue;
    then startup_reference_date_1394(b, other);
}
pub relation local_government_nominated_zone_or_community(gov: LocalGovernmentUnit, area: NominatedArea) kind empirical {
    label en official "section 1394(b)(3)(D)(iii): the local government nominated the empowerment zone or enterprise community for designation under section 1391";
}
pub relation applicable_nominating_jurisdiction(gov: LocalGovernmentUnit, area: NominatedArea) kind institutional {
    label en official "section 1394(b)(3)(D)(iii): the applicable nominating jurisdiction of a zone or community";
}
@source(IRC_S1394_B, relation = formalizes, coverage = exact, quote = "The term \"applicable nominating jurisdiction\" means, with respect to any empowerment zone or enterprise community, any local government that nominated such community for designation under section 1391.")
rule ApplicableNominatingJurisdictionRule(gov: LocalGovernmentUnit, area: NominatedArea) defeasible {
    label en official "section 1394(b)(3)(D)(iii)";
    when local_government_nominated_zone_or_community(gov, area);
    when local_government_1393(gov);
    then applicable_nominating_jurisdiction(gov, area);
}
pub relation trade_or_business_qualifies_if_separately_incorporated(b: ZoneBusiness) kind empirical {
    label en official "section 1394(b)(3)(E): the trade or business would qualify as an enterprise zone business (after the (B) modifications) if separately incorporated";
}
@source(IRC_S1394_B, relation = formalizes, coverage = exact, quote = "The term \"enterprise zone business\" includes any trades or businesses which would qualify as an enterprise zone business (determined after the modifications of subparagraph (B)) if such trades or businesses were separately incorporated.")
rule EnterpriseZoneBusiness1394SeparatelyIncorporatedRule(b: ZoneBusiness) defeasible {
    label en official "section 1394(b)(3)(E)";
    when trade_or_business_qualifies_if_separately_incorporated(b);
    then enterprise_zone_business_1394(b);
}

// (c)(2): the allocation rules are those of section 144(a)(10)
pub relation allocable_outstanding_bonds_under_144a10_rules(person: Person, amount: Money) kind empirical {
    label en official "section 1394(c)(2): the aggregate amount of outstanding enterprise zone facility bonds allocable to the person, determined under rules similar to section 144(a)(10), taking into account only bonds to which subsection (a) applies (the section 144 allocation is a foreign norm; its result is a case fact)";
}
@source(IRC_S1394_C, relation = formalizes, coverage = partial, quote = "For purposes of paragraph (1), the aggregate amount of outstanding enterprise zone facility bonds allocable to any person shall be determined under rules similar to the rules of section 144(a)(10), taking into account only bonds to which subsection (a) applies.")
rule AllocableAmountFeedsOneZoneLimitRule(person: Person, amount: Money) defeasible {
    label en official "section 1394(c)(2): the allocable amount is the input of the (c)(1) tests for all zones";
    when allocable_outstanding_bonds_under_144a10_rules(person, amount);
    then outstanding_zone_facility_bonds_all_zones(person, amount);
}

// (e): cure, interest disallowance, exceptions
pub relation issue_failed_1394_requirements(i: ZoneBondIssue) kind empirical {
    label en official "the issue fails to meet one or more of the requirements of subsections (a) and (b)";
}
pub relation issuer_and_principal_user_attempted_in_good_faith(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(e)(1)(A): the issuer and any principal user in good faith attempted to meet the requirements (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation failure_corrected_within_reasonable_period(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(e)(1)(B): any failure is corrected within a reasonable period after it is first discovered (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation issue_treated_as_meeting_1394_requirements(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(e)(1): the issue is treated as meeting the requirements of subsections (a) and (b)";
}
@source(IRC_S1394_E, relation = formalizes, coverage = exact, quote = "An issue which fails to meet 1 or more of the requirements of subsections (a) and (b) shall be treated as meeting such requirements if—")
rule Cure1394Rule(i: ZoneBondIssue) defeasible {
    label en official "section 1394(e)(1)(A)-(B)";
    when issue_failed_1394_requirements(i);
    when issuer_and_principal_user_attempted_in_good_faith(i);
    when failure_corrected_within_reasonable_period(i);
    then issue_treated_as_meeting_1394_requirements(i);
}
pub relation facility_ceases_use_in_zone_or_community(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(e)(2)(A): substantially all of the facility ceases to be used in an empowerment zone or enterprise community";
}
pub relation principal_user_ceases_to_be_enterprise_zone_business(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(e)(2)(B): the principal user of the facility ceases to be an enterprise zone business";
}
pub relation calendar_year_start_of_cessation(i: ZoneBondIssue, on: Date) kind empirical {
    label en official "section 1394(e)(2): the first day of the calendar year that includes the date of the cessation (supplied by the case)";
}
pub relation cessation_solely_from_designation_termination_or_revocation(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(e)(3): the cessation is solely by reason of the termination or revocation of the designation";
}
pub relation cessation_resulting_from_bankruptcy(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(e)(4): the cessation results from bankruptcy";
}
pub relation interest_accrual_start(i: ZoneBondIssue, on: Date) kind empirical {
    label en official "the date on which the interest in question accrued";
}
pub relation cessation_triggers_disallowance_1394e2(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(e)(2), (3), (4): a cessation of (A) or (B) that is not solely a designation termination and not a bankruptcy cessation";
}
@source(IRC_S1394_E, relation = formalizes, coverage = partial, quote = "(A) substantially all of the facility with respect to which the financing was provided ceases to be used in an empowerment zone or enterprise community, or")
rule CessationUseRule(i: ZoneBondIssue) defeasible {
    label en official "section 1394(e)(2)(A) with the (e)(3) and (e)(4) exceptions";
    when facility_ceases_use_in_zone_or_community(i);
    when not_known(cessation_solely_from_designation_termination_or_revocation(i));
    when not_known(cessation_resulting_from_bankruptcy(i));
    then cessation_triggers_disallowance_1394e2(i);
}
@source(IRC_S1394_E, relation = formalizes, coverage = partial, quote = "(B) the principal user of such facility ceases to be an enterprise zone business (as defined in subsection (b)).")
rule CessationUserRule(i: ZoneBondIssue) defeasible {
    label en official "section 1394(e)(2)(B) with the (e)(3) and (e)(4) exceptions";
    when principal_user_ceases_to_be_enterprise_zone_business(i);
    when not_known(cessation_solely_from_designation_termination_or_revocation(i));
    when not_known(cessation_resulting_from_bankruptcy(i));
    then cessation_triggers_disallowance_1394e2(i);
}
pub relation interest_deduction_disallowed_1394e2(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(e)(2): no deduction is allowed under this chapter for interest on the financing to the extent it accrues on or after the first day of the calendar year of the cessation";
}
@source(IRC_S1394_E, relation = formalizes, coverage = partial, quote = "No deduction shall be allowed under this chapter for interest on any financing provided from any bond to which subsection (a) applies with respect to any facility to the extent such interest accrues during the period beginning on the first day of the calendar year which includes the date on which—")
rule InterestDeductionDisallowedRule(i: ZoneBondIssue, start: Date, accrual: Date) defeasible {
    label en official "section 1394(e)(2): interest accruing from the calendar-year start of the cessation";
    when cessation_triggers_disallowance_1394e2(i);
    when calendar_year_start_of_cessation(i, start);
    when interest_accrual_start(i, accrual);
    when accrual >= start;
    then interest_deduction_disallowed_1394e2(i);
}
// (f): empowerment zone facility bonds
pub relation designated_by_nominating_local_government(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(f)(2)(A): the bond is designated for the subsection by the local government which nominated the area to which the bond relates";
}
pub relation zone_facility_bond_issue_date(i: ZoneBondIssue, on: Date) kind empirical {
    label en official "the date of issue of the bond";
}
pub relation issue_zone_designation_round(i: ZoneBondIssue, round: Integer) kind empirical {
    label en official "the designation round (see designation_round) of the zone in which the facility is located";
}
pub relation issue_in_district_of_columbia_enterprise_zone(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(f)(3)(B): the facility is in the District of Columbia Enterprise Zone";
}
pub relation issue_in_empowerment_zone_not_community(i: ZoneBondIssue) kind empirical {
    label en official "the facility is in an empowerment zone";
}
pub relation empowerment_zone_facility_bond(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(f)(3): a bond that would be described in subsection (a) if, before 2002, only section 1391(g) zones, and after 2001 all zones other than the District of Columbia Enterprise Zone, were taken into account";
}
@source(IRC_S1394_F, relation = formalizes, coverage = partial, quote = "(A) in the case of obligations issued before January 1, 2002, only empowerment zones designated under section 1391(g) were taken into account under sections 1397C and 1397D, and")
rule ZoneFacilityBondBefore2002Rule(i: ZoneBondIssue, on: Date) defeasible {
    label en official "section 1394(f)(3)(A): issued before January 1, 2002, in a section 1391(g) zone";
    when exempt_facility_bond_by_1394(i);
    when zone_facility_bond_issue_date(i, on);
    when on < @2002-01-01;
    when issue_zone_designation_round(i, 2);
    then empowerment_zone_facility_bond(i);
}
@source(IRC_S1394_F, relation = formalizes, coverage = partial, quote = "(B) in the case of obligations issued after December 31, 2001, all empowerment zones (other than the District of Columbia Enterprise Zone) were taken into account under sections 1397C and 1397D.")
rule ZoneFacilityBondAfter2001Rule(i: ZoneBondIssue, on: Date) defeasible {
    label en official "section 1394(f)(3)(B): issued after December 31, 2001, in any empowerment zone other than the District of Columbia Enterprise Zone";
    when exempt_facility_bond_by_1394(i);
    when zone_facility_bond_issue_date(i, on);
    when on >= @2002-01-01;
    when issue_in_empowerment_zone_not_community(i);
    when not_known(issue_in_district_of_columbia_enterprise_zone(i));
    then empowerment_zone_facility_bond(i);
}
pub relation not_private_activity_bond_for_146(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(f)(1)(A): the bond is not treated as a private activity bond for purposes of section 146";
}
pub relation limit_1394c_inapplicable(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(f)(1)(B): subsection (c) does not apply to the bond";
}
pub relation empowerment_zone_facility_bond_designated_valid(i: ZoneBondIssue) kind institutional {
    label en unofficial "single-atom helper for valid_when: the empowerment zone facility bond of (f)(3)";
}
rule DesignatedValidRule(i: ZoneBondIssue) defeasible {
    label en unofficial "helper";
    when empowerment_zone_facility_bond(i);
    then empowerment_zone_facility_bond_designated_valid(i);
}
pub relation zone_bond_designation_effective_1394f2(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(f)(2)(A): paragraph (1) applies to the bond by reason of the designation";
}
@source(IRC_S1394_F, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall apply to an empowerment zone facility bond only if such bond is designated for purposes of this subsection by the local government which nominated the area to which such bond relates.")
rule Section1394ZoneBondDesignationPower(i: ZoneBondIssue, gov: LocalGovernmentUnit) strict {
    label en official "section 1394(f)(2)(A): the nominating local government MAY designate an empowerment zone facility bond, which is the only way paragraph (1) applies";
    when designation_of_zone_facility_bond_made_by(i, gov);
    then power Section1394ZoneBondDesignation {
        holder gov;
        over i;
        exercise designation_of_zone_facility_bond_made_by(i, gov);
        valid_when designation_by_nominating_government_valid(i);
        effect create(zone_bond_designation_effective_1394f2(i));
        window [@1993-08-10, infinity);
    };
}
pub relation designation_of_zone_facility_bond_made_by(i: ZoneBondIssue, gov: LocalGovernmentUnit) kind empirical {
    label en official "section 1394(f)(2)(A): the local government designates the bond";
}
pub relation designation_by_nominating_government_valid(i: ZoneBondIssue) kind institutional {
    label en unofficial "single-atom helper for valid_when: the designating government is the nominating jurisdiction of the zone and the bond is an empowerment zone facility bond";
}
pub relation zone_bond_designator_is_nominator(i: ZoneBondIssue) kind empirical {
    label en official "section 1394(f)(2)(A): the designating local government nominated the area to which the bond relates";
}
rule DesignationByNominatingGovernmentValidRule(i: ZoneBondIssue) defeasible {
    label en official "section 1394(f)(2)(A)";
    when empowerment_zone_facility_bond(i);
    when zone_bond_designator_is_nominator(i);
    then designation_by_nominating_government_valid(i);
}
@source(IRC_S1394_F, relation = formalizes, coverage = exact, quote = "(A) such bond shall not be treated as a private activity bond for purposes of section 146, and")
rule ZoneBondNotPrivateActivityRule(i: ZoneBondIssue) defeasible {
    label en official "section 1394(f)(1)(A) for a designated bond";
    when zone_bond_designation_effective_1394f2(i);
    then not_private_activity_bond_for_146(i);
}
@source(IRC_S1394_F, relation = formalizes, coverage = exact, quote = "(B) subsection (c) of this section shall not apply.")
rule ZoneBondLimitInapplicableRule(i: ZoneBondIssue) defeasible {
    label en official "section 1394(f)(1)(B) for a designated bond";
    when zone_bond_designation_effective_1394f2(i);
    then limit_1394c_inapplicable(i);
}
pub relation bond_taken_into_account_for_limit_1394c(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(f)(2)(C)(i): bonds to which paragraph (1) applies are not taken into account in applying the (c) limitation to other bonds";
}
@source(IRC_S1394_F, relation = formalizes, coverage = exact, quote = "Bonds to which paragraph (1) applies shall not be taken into account in applying the limitation of subsection (c) to other bonds.")
rule DesignatedBondsExcludedFromLimitRule(i: ZoneBondIssue) defeasible {
    label en official "section 1394(f)(2)(C)(i): an undesignated bond counts, a designated bond does not";
    when exempt_facility_bond_by_1394(i);
    when not_known(zone_bond_designation_effective_1394f2(i));
    then bond_taken_into_account_for_limit_1394c(i);
}
pub relation refunding_amount(i: ZoneBondIssue, amount: Money) kind empirical {
    label en official "section 1394(f)(2)(C)(ii)(I): the amount of the refunding bond";
}
pub relation refunded_outstanding_amount(i: ZoneBondIssue, amount: Money) kind empirical {
    label en official "section 1394(f)(2)(C)(ii)(I): the outstanding amount of the refunded bond";
}
pub relation refunded_bond_designated(i: ZoneBondIssue) kind empirical {
    label en official "the refunded bond (or the bond refunded in an earlier refunding of the series) was designated under paragraph (2)";
}
pub relation days_from_refunding_issue_to_redemption(i: ZoneBondIssue, days: Integer) kind empirical {
    label en official "section 1394(f)(2)(C)(ii)(II): the number of days after the date of issuance of the refunding bond on which the refunded bond is redeemed";
}
pub relation refunding_bond_treated_as_designated_1394f2(i: ZoneBondIssue) kind institutional {
    label en official "section 1394(f)(2)(C)(ii): the refunding obligation is treated as designated and is not taken into account in applying subparagraph (B)";
}
@source(IRC_S1394_F, relation = formalizes, coverage = exact, quote = "In the case of a refunding (or series of refundings) of a bond designated under this paragraph, the refunding obligation shall be treated as designated under this paragraph (and shall not be taken into account in applying subparagraph (B)) if—")
rule RefundingTreatedAsDesignatedRule(i: ZoneBondIssue, new_amount: Money, old_amount: Money, days: Integer) defeasible {
    label en official "section 1394(f)(2)(C)(ii)(I)-(II): not above the outstanding refunded amount, refunded bond redeemed within 90 days";
    when refunded_bond_designated(i);
    when refunding_amount(i, new_amount);
    when refunded_outstanding_amount(i, old_amount);
    when new_amount <= old_amount;
    when days_from_refunding_issue_to_redemption(i, days);
    when days <= 90;
    then refunding_bond_treated_as_designated_1394f2(i);
}

// =============================================================================
// §1397C(d)-(f): qualified business, nonqualified financial property, look-through
// =============================================================================

pub relation trade_or_business_of_business(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(d)(1): the activity is a trade or business";
}
pub relation rental_of_real_property_in_zone(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(d)(2): the business is the rental to others of real property located in an empowerment zone";
}
pub relation rental_of_tangible_personal_property(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(d)(3): the business is the rental to others of tangible personal property";
}
pub relation rented_real_property_is_residential_rental(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(d)(2)(A): the property is residential rental property (section 168(e)(2))";
}
pub relation gross_rental_income_share_from_zone_businesses(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "section 1397C(d)(2)(B): the share of the gross rental income from enterprise zone businesses";
}
pub relation lessee_certifies_enterprise_zone_business_status(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(d)(2), last sentence: the lessee certifies that it is an enterprise zone business and the lessor relies on the certification";
}
pub relation gross_rental_income_share_from_certifying_lessees(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "the share of the gross rental income from lessees that certify their status";
}
pub relation rental_share_by_zone_businesses_or_residents(b: ZoneBusiness, share: Decimal) kind empirical {
    label en official "section 1397C(d)(3): the share of the rental of the property that is by enterprise zone businesses or by residents of an empowerment zone";
}
pub relation predominantly_develops_or_holds_intangibles_for_sale_or_license(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(d)(4): the trade or business consists predominantly of the development or holding of intangibles for sale or license";
}
pub relation operates_facility_in_144c6B(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(d)(5)(A): the trade or business consists of the operation of a facility described in section 144(c)(6)(B)";
}
pub relation principal_activity_is_farming_2032A(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(d)(5)(B): the principal activity is farming (section 2032A(e)(5)(A) or (B))";
}
pub relation farming_owned_assets_bases_or_value(b: ZoneBusiness, amount: Money) kind empirical {
    label en official "section 1397C(d)(5)(B)(i): at the close of the taxable year, the aggregate unadjusted bases (or, if greater, the fair market value) of the assets owned and used in the business";
}
pub relation farming_leased_assets_value(b: ZoneBusiness, amount: Money) kind empirical {
    label en official "section 1397C(d)(5)(B)(ii): the aggregate value of the leased assets used in the business";
}
pub relation qualified_business_1397C(b: ZoneBusiness) kind institutional {
    label en official "section 1397C(d): a qualified business";
}
pub relation business_excluded_from_qualified_business_1397Cd(b: ZoneBusiness) kind institutional {
    label en official "section 1397C(d)(4), (5): the trade or business is excluded from the term qualified business";
}
@source(IRC_S1397C_D, relation = formalizes, coverage = exact, quote = "The term \"qualified business\" shall not include any trade or business consisting predominantly of the development or holding of intangibles for sale or license.")
rule ExcludedIntangiblesRule(b: ZoneBusiness) defeasible {
    label en official "section 1397C(d)(4)";
    when predominantly_develops_or_holds_intangibles_for_sale_or_license(b);
    then business_excluded_from_qualified_business_1397Cd(b);
}
@source(IRC_S1397C_D, relation = formalizes, coverage = exact, quote = "(A) any trade or business consisting of the operation of any facility described in section 144(c)(6)(B), and")
rule ExcludedFacilityRule(b: ZoneBusiness) defeasible {
    label en official "section 1397C(d)(5)(A)";
    when operates_facility_in_144c6B(b);
    then business_excluded_from_qualified_business_1397Cd(b);
}
@source(IRC_S1397C_D, relation = formalizes, coverage = exact, quote = "exceeds $500,000.")
rule ExcludedFarmingRule(b: ZoneBusiness, owned: Money, leased: Money) defeasible {
    label en official "section 1397C(d)(5)(B): farming where owned plus leased assets exceed $500,000";
    when principal_activity_is_farming_2032A(b);
    when farming_owned_assets_bases_or_value(b, owned);
    when farming_leased_assets_value(b, leased);
    when owned + leased > 500000.00 USD;
    then business_excluded_from_qualified_business_1397Cd(b);
}
@source(IRC_S1397C_D, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this subsection, the term \"qualified business\" means any trade or business.")
rule QualifiedBusinessGeneralRule(b: ZoneBusiness) defeasible {
    label en official "section 1397C(d)(1): any trade or business other than a rental and other than an excluded business";
    when trade_or_business_of_business(b);
    when not_known(rental_of_real_property_in_zone(b));
    when not_known(rental_of_tangible_personal_property(b));
    when not_known(business_excluded_from_qualified_business_1397Cd(b));
    then qualified_business_1397C(b);
}
@source(IRC_S1397C_D, relation = formalizes, coverage = partial, quote = "The rental to others of real property located in an empowerment zone shall be treated as a qualified business if and only if—")
rule QualifiedBusinessRealRentalRule(b: ZoneBusiness, share: Decimal) defeasible {
    label en official "section 1397C(d)(2)(A)-(B): not residential rental property and at least 50 percent of the gross rental income from enterprise zone businesses";
    when rental_of_real_property_in_zone(b);
    when not_known(rented_real_property_is_residential_rental(b));
    when gross_rental_income_share_from_zone_businesses(b, share);
    when share >= 0.50;
    then qualified_business_1397C(b);
}
@source(IRC_S1397C_D, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (B), the lessor of the property may rely on a lessee's certification that such lessee is an enterprise zone business.")
rule QualifiedBusinessRealRentalCertificationRule(b: ZoneBusiness, share: Decimal) defeasible {
    label en official "section 1397C(d)(2), reliance on the lessee's certification for the (B) test";
    when rental_of_real_property_in_zone(b);
    when not_known(rented_real_property_is_residential_rental(b));
    when lessee_certifies_enterprise_zone_business_status(b);
    when gross_rental_income_share_from_certifying_lessees(b, share);
    when share >= 0.50;
    then qualified_business_1397C(b);
}
@source(IRC_S1397C_D, relation = formalizes, coverage = exact, quote = "The rental to others of tangible personal property shall be treated as a qualified business if and only if at least 50 percent of the rental of such property is by enterprise zone businesses or by residents of an empowerment zone.")
rule QualifiedBusinessPersonalRentalRule(b: ZoneBusiness, share: Decimal) defeasible {
    label en official "section 1397C(d)(3)";
    when rental_of_tangible_personal_property(b);
    when rental_share_by_zone_businesses_or_residents(b, share);
    when share >= 0.50;
    then qualified_business_1397C(b);
}

pub enum FinancialPropertyKind {
    Debt;
    Stock;
    PartnershipInterest;
    Option;
    FuturesContract;
    ForwardContract;
    Warrant;
    NotionalPrincipalContract;
    Annuity;
    SpecifiedInRegulations;
    label en official "the kinds of property named in section 1397C(e): debt, stock, partnership interests, options, futures contracts, forward contracts, warrants, notional principal contracts, annuities, and other similar property specified in regulations";
}
pub relation asset_financial_property_kind(a: Asset, k: FinancialPropertyKind) kind empirical {
    label en official "section 1397C(e): the kind of financial property the asset is";
}
pub relation asset_is_reasonable_working_capital_1397Ce1(a: Asset) kind empirical {
    label en official "section 1397C(e)(1): reasonable amounts of working capital held in cash, cash equivalents, or debt instruments with a term of 18 months or less (an evaluative element for \"reasonable\": adjudicated fact, DECISION-0194)";
}
pub relation asset_is_debt_instrument_1221a4(a: Asset) kind empirical {
    label en official "section 1397C(e)(2): a debt instrument described in section 1221(a)(4)";
}
pub relation nonqualified_financial_property_1397Ce(a: Asset) kind institutional {
    label en official "section 1397C(e): nonqualified financial property";
}
@source(IRC_S1397C_E, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"nonqualified financial property\" means debt, stock, partnership interests, options, futures contracts, forward contracts, warrants, notional principal contracts, annuities, and other similar property specified in regulations; except that such term shall not include—")
rule NonqualifiedFinancialPropertyRule(a: Asset, k: FinancialPropertyKind) defeasible {
    label en official "section 1397C(e): a named kind of property unless excepted by (1) or (2)";
    when asset_financial_property_kind(a, k);
    when not_known(asset_is_reasonable_working_capital_1397Ce1(a));
    when not_known(asset_is_debt_instrument_1221a4(a));
    then nonqualified_financial_property_1397Ce(a);
}

pub relation uses_real_property_inside_zone(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(f)(1): the business entity or proprietorship uses real property located within an empowerment zone";
}
pub relation uses_real_property_outside_zone(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(f)(2): it also uses real property located outside the zone";
}
pub relation inside_real_property_substantial_compared_to_outside(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(f)(3): the real property inside the zone is substantial compared to the property outside (an evaluative element: adjudicated fact, DECISION-0194)";
}
pub relation outside_real_property_contiguous_to_inside(b: ZoneBusiness) kind empirical {
    label en official "section 1397C(f)(4): the outside real property is contiguous to part or all of the property inside the zone";
}
pub relation contiguous_property_treated_as_in_zone_1397Cf(b: ZoneBusiness) kind institutional {
    label en official "section 1397C(f): all the services performed by employees, all business activities and all tangible and intangible property occurring or situated on the inside and outside real property are treated as occurring or situated in the zone";
}
@source(IRC_S1397C_F, relation = formalizes, coverage = exact, quote = "then all the services performed by employees, all business activities, all tangible property, and all intangible property of the business entity or proprietorship that occur in or is located on the real property described in paragraphs (1) and (2) shall be treated as occurring or situated in an empowerment zone.")
rule ContiguousLookThroughRule(b: ZoneBusiness) defeasible {
    label en official "section 1397C(f)(1)-(4)";
    when uses_real_property_inside_zone(b);
    when uses_real_property_outside_zone(b);
    when inside_real_property_substantial_compared_to_outside(b);
    when outside_real_property_contiguous_to_inside(b);
    then contiguous_property_treated_as_in_zone_1397Cf(b);
}
@source(IRC_S1397C_F, relation = formalizes, coverage = partial, quote = "For purposes of this section, if—")
rule QualifiedBusinessEntityLookThroughRule(b: ZoneBusiness, income: Decimal, residents: Decimal, collectibles: Decimal, financial: Decimal) defeasible {
    label en official "section 1397C(b) with the (f) look-through curing the location tests (b)(1), (3) and (5)";
    when contiguous_property_treated_as_in_zone_1397Cf(b);
    when gross_income_share_from_active_business(b, income);
    when income >= 0.50;
    when substantial_intangible_property_used_in_business(b);
    when employee_share_resident_in_zone(b, residents);
    when residents >= 0.35;
    when collectibles_share_of_property_bases(b, collectibles);
    when collectibles < 0.05;
    when nonqualified_financial_property_share(b, financial);
    when financial < 0.05;
    then enterprise_zone_business(b);
}
