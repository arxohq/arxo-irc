// Stage 2c (IRC-07, A05). Section 1341 (computation of tax where taxpayer
// restores a substantial amount held under a claim of right), section 1351
// (recoveries of foreign expropriation losses), section 1253 (transfers of
// franchises, trademarks and trade names) and section 1399 (no separate
// taxable entity from a title 11 case).
//
// Modelling notes.
//  * §1341(a): the tax for the year with and without the deduction, and the
//    decrease in tax for the prior years, are computed by the income tax
//    packages for arbitrary hypothetical incomes; this module takes the three
//    amounts as case-supplied (the same class as §1301's tax-on-a-parameterised-
//    income function, TECH-GAPS G2339).
//  * §1341(b)(4)-(5): the net operating / capital loss carrybacks that change
//    the comparison are TECH-GAPS G2340.
//  * §1351(d)(2)-(4): the prior-year tax increase "computed in accordance with
//    regulations" is EXTERNAL_DEPENDENCY.

// =============================================================================
// §1341: claim of right
// =============================================================================

use self::{
    BankruptcyCase,
    IRC_S1253_A,
    IRC_S1253_B,
    IRC_S1253_C,
    IRC_S1253_D,
    IRC_S1341_A,
    IRC_S1341_B,
    IRC_S1351_A,
    IRC_S1351_C,
    IRC_S1351_D,
    IRC_S1351_E,
    IRC_S1351_F,
    IRC_S1351_G,
    IRC_S1351_H,
    IRC_S1399,
    Person,
    TaxableYear,
    bankruptcy_case_under_chapter_7_or_11,
    section_1398_applies,
};

pub const Section1341DeductionThreshold: Money = 3000.00 USD {
    label en official "the deduction must exceed $3,000 (section 1341(a)(3))";
};
pub relation item_included_in_prior_year_under_apparent_unrestricted_right(p: Person, prior: TaxableYear, amount: Money) kind empirical {
    label en official "section 1341(a)(1): an item was included in gross income for a prior taxable year (or years) because it appeared that the taxpayer had an unrestricted right to it";
}
pub relation deduction_allowable_because_right_not_established(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1341(a)(2): a deduction is allowable for the taxable year because it was established after the close of the prior year that the taxpayer did not have an unrestricted right to the item or a portion of it";
}
pub relation item_from_sale_of_inventory_or_property_held_for_customers(p: Person, prior: TaxableYear) kind empirical {
    label en official "section 1341(b)(2): the item was included by reason of the sale of stock in trade, inventory-type property, or property held primarily for sale to customers";
}
pub relation deduction_arises_from_regulated_utility_rate_refund(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1341(b)(2), second sentence: the deduction arises out of refunds or repayments with respect to rates made by a regulated public utility under compulsion of government, court order, or settlement";
}
pub relation tax_for_year_computed_with_deduction(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1341(a)(4): the tax for the taxable year computed with the deduction (case-supplied; G2339)";
}
pub relation tax_for_year_computed_without_deduction(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1341(a)(5)(A): the tax for the taxable year computed without the deduction (case-supplied; G2339)";
}
pub relation decrease_in_prior_year_tax_from_exclusion(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1341(a)(5)(B): the decrease in tax for the prior taxable year (or years) which would result solely from the exclusion of the item from gross income for those years (case-supplied; G2339)";
}
pub relation section_1341_conditions_met(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1341(a)(1)-(3): the item was included under an apparent unrestricted right, a deduction is allowable, and it exceeds $3,000; and (b)(2) does not exclude it";
}
@source(IRC_S1341_A, relation = formalizes, coverage = partial, quote = "(3) the amount of such deduction exceeds $3,000,")
rule Section1341ConditionsRule(p: Person, y: TaxableYear, prior: TaxableYear, included: Money, deduction: Money) defeasible {
    label en official "section 1341(a)(1)-(3) and (b)(2)";
    when item_included_in_prior_year_under_apparent_unrestricted_right(p, prior, included);
    when deduction_allowable_because_right_not_established(p, y, deduction);
    when deduction > Section1341DeductionThreshold;
    when not_known(item_from_sale_of_inventory_or_property_held_for_customers(p, prior));
    then section_1341_conditions_met(p, y);
}
rule Section1341UtilityRefundConditionsRule(p: Person, y: TaxableYear, prior: TaxableYear, included: Money, deduction: Money) defeasible {
    label en official "section 1341(b)(2), second sentence: the inventory exclusion does not apply to regulated-utility rate refunds";
    when item_included_in_prior_year_under_apparent_unrestricted_right(p, prior, included);
    when deduction_allowable_because_right_not_established(p, y, deduction);
    when deduction > Section1341DeductionThreshold;
    when item_from_sale_of_inventory_or_property_held_for_customers(p, prior);
    when deduction_arises_from_regulated_utility_rate_refund(p, y);
    then section_1341_conditions_met(p, y);
}
pub relation tax_under_1341_alternative_5(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1341(a)(5): the tax computed without the deduction, minus the decrease in tax for the prior years";
}
@source(IRC_S1341_A, relation = formalizes, coverage = partial, quote = "(A) the tax for the taxable year computed without such deduction, minus")
rule Alternative5Rule(p: Person, y: TaxableYear, without: Money, decrease: Money) defeasible {
    label en official "section 1341(a)(5)(A)-(B)";
    when tax_for_year_computed_without_deduction(p, y, without);
    when decrease_in_prior_year_tax_from_exclusion(p, y, decrease);
    then tax_under_1341_alternative_5(p, y, without - decrease);
}
pub relation tax_imposed_under_1341(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1341(a): the tax for the year is the lesser of the tax computed with the deduction and the (5) amount";
}
@source(IRC_S1341_A, relation = formalizes, coverage = partial, quote = "then the tax imposed by this chapter for the taxable year shall be the lesser of the following:")
rule Section1341LesserOfRule(p: Person, y: TaxableYear, with_deduction: Money, alt5: Money) defeasible {
    label en official "section 1341(a): min((4), (5))";
    when section_1341_conditions_met(p, y);
    when tax_for_year_computed_with_deduction(p, y, with_deduction);
    when tax_under_1341_alternative_5(p, y, alt5);
    then tax_imposed_under_1341(p, y, min(with_deduction, alt5));
}
pub relation section_1341b1_excess_treated_as_payment(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1341(b)(1): the excess of the prior-year decrease over the year's tax (computed without the deduction) is considered a payment on the last day for payment, refundable or creditable as an overpayment";
}
@source(IRC_S1341_B, relation = formalizes, coverage = exact, quote = "such excess shall be considered to be a payment of tax on the last day prescribed by law for the payment of tax for the taxable year")
rule Section1341ExcessPaymentRule(p: Person, y: TaxableYear, without: Money, decrease: Money) defeasible {
    label en official "section 1341(b)(1): decrease - tax without deduction, when positive";
    when section_1341_conditions_met(p, y);
    when tax_for_year_computed_without_deduction(p, y, without);
    when decrease_in_prior_year_tax_from_exclusion(p, y, decrease);
    when decrease > without;
    then section_1341b1_excess_treated_as_payment(p, y, decrease - without);
}
pub relation deduction_disregarded_elsewhere_when_alternative_5_applies(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1341(b)(3): when the tax is the (a)(5) amount, the deduction is not taken into account for any other purpose of the subtitle";
}
@source(IRC_S1341_B, relation = formalizes, coverage = exact, quote = "then the deduction referred to in subsection (a)(2) shall not be taken into account for any purpose of this subtitle other than this section.")
rule Section1341DeductionDisregardedRule(p: Person, y: TaxableYear, with_deduction: Money, alt5: Money) defeasible {
    label en official "section 1341(b)(3): applies when the (a)(5) amount is the lesser (or equal) tax";
    when tax_imposed_under_1341(p, y, alt5);
    when tax_for_year_computed_with_deduction(p, y, with_deduction);
    when tax_under_1341_alternative_5(p, y, alt5);
    then deduction_disregarded_elsewhere_when_alternative_5_applies(p, y);
}

// =============================================================================
// §1351: recoveries of foreign expropriation losses
// =============================================================================

pub relation corporation_subject_to_section_11_or_801_in_loss_and_recovery_years(corp: Person, loss: TaxableYear, recovery_year: TaxableYear) kind empirical {
    label en official "section 1351(a)(1): a domestic corporation subject to the tax under section 11 or 801 for the year of the loss and for the year of recovery";
}
pub relation elects_section_1351(corp: Person, loss_id: Integer) kind empirical {
    label en official "section 1351(a)(1): the corporation elects to have the section apply with respect to the loss (time and manner by regulations: EXTERNAL_DEPENDENCY)";
}
pub relation section_1351_applies_to_loss(corp: Person, loss_id: Integer) kind institutional {
    label en official "section 1351(a)(2): the election applies to all recoveries in respect of the loss";
}
@source(IRC_S1351_A, relation = formalizes, coverage = partial, quote = "An election made with respect to any foreign expropriation loss shall apply to all recoveries in respect of such loss.")
rule Section1351ElectionPower(corp: Person, loss_id: Integer) strict {
    label en official "section 1351(a): the corporation's election is a power over the loss; valid for a domestic corporation subject to the section 11/801 tax";
    when elects_section_1351(corp, loss_id);
    then power Section1351Election {
        holder corp;
        over loss_id;
        exercise elects_section_1351(corp, loss_id);
        valid_when election_1351_eligible(corp, loss_id);
        effect create(section_1351_applies_to_loss(corp, loss_id));
        window [@1964-10-16, infinity);
    };
}
relation election_1351_eligible(corp: Person, loss_id: Integer) kind institutional {
    label en unofficial "single-atom helper for valid_when (§130.3)";
}
pub relation loss_year_and_recovery_year_of_expropriation_loss(corp: Person, loss_id: Integer, loss: TaxableYear, recovery_year: TaxableYear) kind empirical {
    label en unofficial "the year of the loss and the year of the recovery for the expropriation loss";
}
@source(IRC_S1351_A, relation = formalizes, coverage = partial, quote = "This section shall apply only to a recovery, by a domestic corporation subject to the tax imposed by section 11 or 801, of a foreign expropriation loss sustained by such corporation and only if such corporation was subject to the tax imposed by section 11 or 801, as the case may be, for the year of the loss and elects to have the provisions of this section apply with respect to such loss.")
rule Election1351EligibleRule(corp: Person, loss_id: Integer, loss: TaxableYear, rec: TaxableYear) defeasible {
    label en official "section 1351(a)(1)";
    when loss_year_and_recovery_year_of_expropriation_loss(corp, loss_id, loss, rec);
    when corporation_subject_to_section_11_or_801_in_loss_and_recovery_years(corp, loss, rec);
    then election_1351_eligible(corp, loss_id);
}
pub relation recovery_amount_money(corp: Person, loss_id: Integer, amount: Money) kind empirical {
    label en official "section 1351(c)(1): the amount of money received in respect of the loss";
}
pub relation recovery_fmv_other_property(corp: Person, loss_id: Integer, amount: Money) kind empirical {
    label en official "section 1351(c)(1): the fair market value, as of the date of receipt, of other property received in respect of the loss";
}
pub relation recovery_amount_1351(corp: Person, loss_id: Integer, amount: Money) kind institutional {
    label en official "section 1351(c)(1): the amount of a recovery";
}
@source(IRC_S1351_C, relation = formalizes, coverage = exact, quote = "The amount of any recovery of a foreign expropriation loss is the amount of money and the fair market value of other property received in respect of such loss, determined as of the date of receipt.")
rule RecoveryAmountRule(corp: Person, loss_id: Integer, money: Money, other: Money) defeasible {
    label en official "section 1351(c)(1)";
    when recovery_amount_money(corp, loss_id, money);
    when recovery_fmv_other_property(corp, loss_id, other);
    then recovery_amount_1351(corp, loss_id, money + other);
}
pub relation allowable_deductions_in_prior_years_for_loss(corp: Person, loss_id: Integer, amount: Money) kind empirical {
    label en official "section 1351(d)(1): the allowable deductions in prior taxable years on account of the loss";
}
pub relation aggregate_previous_recoveries(corp: Person, loss_id: Integer, amount: Money) kind empirical {
    label en official "section 1351(d)(1): the aggregate of the amounts of previous recoveries with respect to the loss";
}
pub relation recovery_excluded_from_gross_income_1351(corp: Person, loss_id: Integer, amount: Money) kind institutional {
    label en official "section 1351(d)(1): that part of the recovery which, added to previous recoveries, does not exceed the prior-year deductions is excluded from gross income";
}
@source(IRC_S1351_D, relation = formalizes, coverage = partial, quote = "does not exceed the allowable deductions in prior taxable years on account of such loss shall be excluded from gross income")
rule RecoveryExcludedRule(corp: Person, loss_id: Integer, recovery: Money, prior_deductions: Money, previous: Money) defeasible {
    label en official "section 1351(d)(1): excluded = min(recovery, prior deductions - previous recoveries) when positive; the prior-year tax increase is by regulations (EXTERNAL_DEPENDENCY)";
    when section_1351_applies_to_loss(corp, loss_id);
    when recovery_amount_1351(corp, loss_id, recovery);
    when allowable_deductions_in_prior_years_for_loss(corp, loss_id, prior_deductions);
    when aggregate_previous_recoveries(corp, loss_id, previous);
    when prior_deductions > previous;
    then recovery_excluded_from_gross_income_1351(corp, loss_id, min(recovery, prior_deductions - previous));
}
rule RecoveryNothingLeftToExcludeRule(corp: Person, loss_id: Integer, recovery: Money, prior_deductions: Money, previous: Money) defeasible {
    label en official "section 1351(d)(1): nothing is excluded once previous recoveries have absorbed the prior-year deductions";
    when section_1351_applies_to_loss(corp, loss_id);
    when recovery_amount_1351(corp, loss_id, recovery);
    when allowable_deductions_in_prior_years_for_loss(corp, loss_id, prior_deductions);
    when aggregate_previous_recoveries(corp, loss_id, previous);
    when prior_deductions <= previous;
    then recovery_excluded_from_gross_income_1351(corp, loss_id, 0.00 USD);
}
pub relation recovery_gain_as_involuntary_conversion_1351e(corp: Person, loss_id: Integer, amount: Money) kind institutional {
    label en official "section 1351(e): the part of the recovery not excluded is gain on the involuntary conversion of property by destruction or seizure, recognized or not as section 1033 provides";
}
@source(IRC_S1351_E, relation = formalizes, coverage = exact, quote = "shall be considered for the taxable year of the recovery as gain on the involuntary conversion of property as a result of its destruction or seizure and shall be recognized or not recognized as provided in section 1033.")
rule RecoveryGainRule(corp: Person, loss_id: Integer, recovery: Money, excluded: Money) defeasible {
    label en official "section 1351(e)";
    when recovery_amount_1351(corp, loss_id, recovery);
    when recovery_excluded_from_gross_income_1351(corp, loss_id, excluded);
    then recovery_gain_as_involuntary_conversion_1351e(corp, loss_id, recovery - excluded);
}
pub relation fmv_of_recovered_property_on_receipt(corp: Person, loss_id: Integer, amount: Money) kind empirical {
    label en official "section 1351(f): the fair market value of property (other than money) received as a recovery on the date of receipt";
}
pub relation gain_not_recognized_under_1033_on_recovery(corp: Person, loss_id: Integer, amount: Money) kind empirical {
    label en official "section 1351(f): the part of the (e) gain which is not recognized as provided in section 1033";
}
pub relation basis_of_recovered_property_1351f(corp: Person, loss_id: Integer, amount: Money) kind institutional {
    label en official "section 1351(f): the basis of recovered property is its fair market value on receipt reduced by the unrecognized (e) gain";
}
@source(IRC_S1351_F, relation = formalizes, coverage = exact, quote = "shall be an amount equal to its fair market value on the date of receipt, reduced by such part of the gain under subsection (e) which is not recognized as provided in section 1033.")
rule RecoveredPropertyBasisRule(corp: Person, loss_id: Integer, fmv: Money, unrecognized: Money) defeasible {
    label en official "section 1351(f)";
    when fmv_of_recovered_property_on_receipt(corp, loss_id, fmv);
    when gain_not_recognized_under_1033_on_recovery(corp, loss_id, unrecognized);
    then basis_of_recovered_property_1351f(corp, loss_id, fmv - unrecognized);
}
pub relation value_restored_interest_worthless_by_expropriation(corp: Person, loss_id: Integer, restored: Money) kind empirical {
    label en official "section 1351(g): the value of an interest in property (including a section 165(g)(2) security) which became worthless by reason of the expropriation and was deducted or taken into account as a loss, restored by a recovery";
}
pub relation restored_value_treated_as_recovery_1351g(corp: Person, loss_id: Integer, amount: Money) kind institutional {
    label en official "section 1351(g): the restored value is treated as property received as a recovery in respect of the loss or bad debt";
}
@source(IRC_S1351_G, relation = formalizes, coverage = exact, quote = "the value so restored shall be treated as property received as a recovery in respect of such loss or such bad debt.")
rule RestoredValueRecoveryRule(corp: Person, loss_id: Integer, restored: Money) defeasible {
    label en official "section 1351(g)";
    when value_restored_interest_worthless_by_expropriation(corp, loss_id, restored);
    then restored_value_treated_as_recovery_1351g(corp, loss_id, restored);
}
pub relation debt_received_as_recovery_of_expropriation_loss(corp: Person, loss_id: Integer) kind empirical {
    label en official "section 1351(h): bonds or other evidences of indebtedness received as a recovery to which the section applies";
}
pub relation recovery_debt_has_no_original_issue_discount_1351h(corp: Person, loss_id: Integer) kind institutional {
    label en official "section 1351(h): such indebtedness is not considered to have original issue discount within the meaning of section 1273(a)";
}
@source(IRC_S1351_H, relation = formalizes, coverage = exact, quote = "shall not be considered to have any original issue discount within the meaning of section 1273(a).")
rule RecoveryDebtNoOidRule(corp: Person, loss_id: Integer) defeasible {
    label en official "section 1351(h)";
    when section_1351_applies_to_loss(corp, loss_id);
    when debt_received_as_recovery_of_expropriation_loss(corp, loss_id);
    then recovery_debt_has_no_original_issue_discount_1351h(corp, loss_id);
}

// =============================================================================
// §1253: transfers of franchises, trademarks and trade names
// =============================================================================

pub entity FranchiseTransfer : Transaction {
    label en official "a transfer (including a renewal) of a franchise, trademark or trade name (section 1253(b)(3))";
}
pub relation franchise_transfer_by(t: FranchiseTransfer, transferor: Person) kind empirical {
    label en unofficial "the transferor in the franchise transfer";
}
pub relation transferor_may_disapprove_assignment(t: FranchiseTransfer) kind empirical {
    label en official "section 1253(b)(2)(A): a right to disapprove any assignment of the interest";
}
pub relation transferor_may_terminate_at_will(t: FranchiseTransfer) kind empirical {
    label en official "section 1253(b)(2)(B): a right to terminate at will";
}
pub relation transferor_prescribes_quality_standards(t: FranchiseTransfer) kind empirical {
    label en official "section 1253(b)(2)(C): a right to prescribe the standards of quality of products or services and of equipment and facilities";
}
pub relation transferor_requires_sale_only_of_its_products(t: FranchiseTransfer) kind empirical {
    label en official "section 1253(b)(2)(D): a right to require that the transferee sell or advertise only the transferor's products or services";
}
pub relation transferor_requires_purchase_of_supplies_from_it(t: FranchiseTransfer) kind empirical {
    label en official "section 1253(b)(2)(E): a right to require that the transferee purchase substantially all supplies and equipment from the transferor";
}
pub relation transferor_has_substantial_contingent_payment_right(t: FranchiseTransfer) kind empirical {
    label en official "section 1253(b)(2)(F): a right to payments contingent on productivity, use or disposition, if they are a substantial element under the transfer agreement";
}
pub relation transferor_retains_other_significant_interest(t: FranchiseTransfer) kind empirical {
    label en official "section 1253(b)(2): any other significant power, right or continuing interest (the list is not exhaustive, an evaluative element, DECISION-0194)";
}
pub relation transferor_retains_significant_interest_1253(t: FranchiseTransfer) kind institutional {
    label en official "section 1253(a), (b)(2): the transferor retains a significant power, right or continuing interest";
}
@source(IRC_S1253_B, relation = formalizes, coverage = partial, quote = "(A) A right to disapprove any assignment of such interest, or any part thereof.")
rule RetainedDisapproveRule(t: FranchiseTransfer) defeasible {
    label en official "section 1253(b)(2)(A)";
    when transferor_may_disapprove_assignment(t);
    then transferor_retains_significant_interest_1253(t);
}
@source(IRC_S1253_B, relation = formalizes, coverage = partial, quote = "(B) A right to terminate at will.")
rule RetainedTerminateRule(t: FranchiseTransfer) defeasible {
    label en official "section 1253(b)(2)(B)";
    when transferor_may_terminate_at_will(t);
    then transferor_retains_significant_interest_1253(t);
}
@source(IRC_S1253_B, relation = formalizes, coverage = partial, quote = "(C) A right to prescribe the standards of quality of products used or sold, or of services furnished, and of the equipment and facilities used to promote such products or services.")
rule RetainedQualityRule(t: FranchiseTransfer) defeasible {
    label en official "section 1253(b)(2)(C)";
    when transferor_prescribes_quality_standards(t);
    then transferor_retains_significant_interest_1253(t);
}
@source(IRC_S1253_B, relation = formalizes, coverage = partial, quote = "(D) A right to require that the transferee sell or advertise only products or services of the transferor.")
rule RetainedExclusiveProductsRule(t: FranchiseTransfer) defeasible {
    label en official "section 1253(b)(2)(D)";
    when transferor_requires_sale_only_of_its_products(t);
    then transferor_retains_significant_interest_1253(t);
}
@source(IRC_S1253_B, relation = formalizes, coverage = partial, quote = "(E) A right to require that the transferee purchase substantially all of his supplies and equipment from the transferor.")
rule RetainedSuppliesRule(t: FranchiseTransfer) defeasible {
    label en official "section 1253(b)(2)(E)";
    when transferor_requires_purchase_of_supplies_from_it(t);
    then transferor_retains_significant_interest_1253(t);
}
@source(IRC_S1253_B, relation = formalizes, coverage = partial, quote = "(F) A right to payments contingent on the productivity, use, or disposition of the subject matter of the interest transferred, if such payments constitute a substantial element under the transfer agreement.")
rule RetainedContingentPaymentsRule(t: FranchiseTransfer) defeasible {
    label en official "section 1253(b)(2)(F)";
    when transferor_has_substantial_contingent_payment_right(t);
    then transferor_retains_significant_interest_1253(t);
}
@source(IRC_S1253_B, relation = formalizes, coverage = partial, quote = "includes, but is not limited to, the following rights with respect to the interest transferred:")
rule RetainedOtherRule(t: FranchiseTransfer) defeasible {
    label en official "section 1253(b)(2): other significant interests (\"includes, but is not limited to\")";
    when transferor_retains_other_significant_interest(t);
    then transferor_retains_significant_interest_1253(t);
}
pub relation franchise_transfer_not_a_sale_of_capital_asset(t: FranchiseTransfer) kind institutional {
    label en official "section 1253(a): the transfer is not treated as a sale or exchange of a capital asset";
}
@source(IRC_S1253_A, relation = formalizes, coverage = exact, quote = "A transfer of a franchise, trademark, or trade name shall not be treated as a sale or exchange of a capital asset if the transferor retains any significant power, right, or continuing interest with respect to the subject matter of the franchise, trademark, or trade name.")
rule FranchiseNotCapitalRule(t: FranchiseTransfer) defeasible {
    label en official "section 1253(a)";
    when transferor_retains_significant_interest_1253(t);
    then franchise_transfer_not_a_sale_of_capital_asset(t);
}
pub relation payment_on_franchise_transfer(t: FranchiseTransfer, payment: Integer, amount: Money) kind empirical {
    label en official "an amount received or accrued on account of the transfer, numbered";
}
pub relation payment_contingent_on_productivity_use_or_disposition(t: FranchiseTransfer, payment: Integer) kind empirical {
    label en official "section 1253(c), (d)(1)(B)(i): the amount is contingent on the productivity, use or disposition of the franchise, trademark or trade name";
}
pub relation payment_in_series_at_least_annual_substantially_equal_over_term(t: FranchiseTransfer, payment: Integer) kind empirical {
    label en official "section 1253(d)(1)(B)(ii): the payment is part of a series payable not less frequently than annually throughout the entire term of the agreement, substantially equal in amount or under a fixed formula (the term counts all renewal options and expected renewals, (d)(3))";
}
pub relation transferor_amount_from_non_capital_asset_1253c(t: FranchiseTransfer, payment: Integer, amount: Money) kind institutional {
    label en official "section 1253(c): a contingent amount is received from the disposition of property which is not a capital asset";
}
@source(IRC_S1253_C, relation = formalizes, coverage = exact, quote = "shall be treated as amounts received or accrued from the sale or other disposition of property which is not a capital asset.")
rule ContingentPaymentOrdinaryRule(t: FranchiseTransfer, payment: Integer, amount: Money) defeasible {
    label en official "section 1253(c)";
    when payment_on_franchise_transfer(t, payment, amount);
    when payment_contingent_on_productivity_use_or_disposition(t, payment);
    then transferor_amount_from_non_capital_asset_1253c(t, payment, amount);
}
pub relation transferee_deduction_under_162a_1253d1(t: FranchiseTransfer, payment: Integer, amount: Money) kind institutional {
    label en official "section 1253(d)(1): a contingent payment in a qualifying series is deductible under section 162(a)";
}
@source(IRC_S1253_D, relation = formalizes, coverage = partial, quote = "shall be allowed as a deduction under section 162(a) (relating to trade or business expenses).")
rule TransfereeDeductionRule(t: FranchiseTransfer, payment: Integer, amount: Money) defeasible {
    label en official "section 1253(d)(1)(A)-(B)";
    when payment_on_franchise_transfer(t, payment, amount);
    when payment_contingent_on_productivity_use_or_disposition(t, payment);
    when payment_in_series_at_least_annual_substantially_equal_over_term(t, payment);
    then transferee_deduction_under_162a_1253d1(t, payment, amount);
}
pub relation transferee_amount_chargeable_to_capital_1253d2(t: FranchiseTransfer, payment: Integer, amount: Money) kind institutional {
    label en official "section 1253(d)(2): an amount on account of the transfer to which paragraph (1) does not apply is chargeable to capital account";
}
@source(IRC_S1253_D, relation = formalizes, coverage = partial, quote = "shall be treated as an amount chargeable to capital account.")
rule TransfereeCapitalAccountRule(t: FranchiseTransfer, payment: Integer, amount: Money) defeasible {
    label en official "section 1253(d)(2)";
    when payment_on_franchise_transfer(t, payment, amount);
    when not_known(transferee_deduction_under_162a_1253d1(t, payment, amount));
    then transferee_amount_chargeable_to_capital_1253d2(t, payment, amount);
}

// =============================================================================
// §1399: no separate taxable entity from a title 11 case
// =============================================================================

pub relation title_11_case_commenced(c: BankruptcyCase) kind empirical {
    label en official "section 1399: a case under title 11 of the United States Code is commenced";
}
pub relation no_separate_taxable_entity_1399(c: BankruptcyCase) kind institutional {
    label en official "section 1399: no separate taxable entity results from the commencement of the case";
}
@source(IRC_S1399, relation = formalizes, coverage = exact, quote = "no separate taxable entity shall result from the commencement of a case under title 11 of the United States Code.")
rule NoSeparateTaxableEntityRule(c: BankruptcyCase, debtor: Person) defeasible {
    label en official "section 1399: except in a case to which section 1398 applies";
    when title_11_case_commenced(c);
    when bankruptcy_case_under_chapter_7_or_11(c, debtor);
    when not_known(section_1398_applies(c, debtor));
    then no_separate_taxable_entity_1399(c);
}
