// Stage 2c (IRC-07, A05). Section 1400Z-2 as amended by Pub. L. 119-21 SEC.
// 70421(c) (permanent renewal of opportunity zones; anchor
// `us.irc.temporal::PL119_21_S70421`, enactment 2025-07-04). The amendments
// apply to amounts invested in qualified opportunity funds after December 31,
// 2026 (SEC. 70421(c)(5)(A)); module 13 is the 2024-text regime, gated off
// for those investments by `investment_governed_by_pl119_21`.
//
// Not carried (TECH-GAPS G2322): SEC. 70421(c)(4) amendments to
// §1400Z-2(d)(2) (applicable start date for property, applicable date for
// stock, 50-percent substantial improvement in rural zones), because §1400Z-2(d)
// is itself not modelled in this package; and the new §§6039K/6039L information
// returns (owner: information-reporting).

use self::{
    Asset,
    Person,
    QualifiedOpportunityFundInvestment,
    Section1400z2FiveYearStepUpFraction,
    Transaction,
    basis_in_investment,
    deferred_gain_amount,
    election_valid_1400z2a,
    elects_10_year_fmv_basis,
    fair_market_value_of_investment_on,
    held_at_least_10_years,
    held_at_least_5_years,
    investment_acquired_on,
    investment_sold_or_exchanged_on,
    invests_in_qualified_opportunity_fund,
    prior_election_in_effect_for_sale,
    sale_or_exchange_with_unrelated_person,
};

pub const Section1400z2PostAmendmentInvestmentCutoff: Date = @2026-12-31 {
    label en official "amounts invested in qualified opportunity funds after December 31, 2026 (SEC. 70421(c)(5)(A))";
};
pub relation investment_governed_by_pl119_21(fund_investment: QualifiedOpportunityFundInvestment, taxpayer: Person) kind institutional {
    label en official "SEC. 70421(c)(5)(A): the amounts are invested after December 31, 2026, so the amended section 1400Z-2 applies";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "the amendments made by this subsection shall apply to amounts invested in qualified opportunity funds after December 31, 2026.")
rule InvestmentGovernedByPlRule(fund_investment: QualifiedOpportunityFundInvestment, taxpayer: Person, acquired_on: Date) defeasible {
    label en official "SEC. 70421(c)(5)(A)";
    when investment_acquired_on(fund_investment, taxpayer, acquired_on);
    when acquired_on > Section1400z2PostAmendmentInvestmentCutoff;
    then investment_governed_by_pl119_21(fund_investment, taxpayer);
}

// (a)(2) as amended: the December 31, 2026 sunset on the election is repealed
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "No election may be made under paragraph (1) with respect to a sale or exchange if an election previously made with respect to such sale or exchange is in effect.")
rule Section1400z2ElectionValidAfterSunsetRepealRule(taxpayer: Person, t: Transaction, sold_property: Asset, sold_on: Date, fund_investment: QualifiedOpportunityFundInvestment, invested_on: Date, invested_amount: Money) defeasible {
    label en official "section 1400Z-2(a)(2) (as amended): no sunset date; the election is valid when invested within 180 days of the sale, no prior election is in effect, and the amount is invested after December 31, 2026";
    when sale_or_exchange_with_unrelated_person(t, taxpayer, sold_property, sold_on);
    when invests_in_qualified_opportunity_fund(taxpayer, t, fund_investment, invested_on, invested_amount);
    when invested_on > Section1400z2PostAmendmentInvestmentCutoff;
    when invested_on >= sold_on;
    when invested_on <= add_calendar_period(sold_on, 180 calendar_day);
    when not_known(prior_election_in_effect_for_sale(t));
    then election_valid_1400z2a(taxpayer, t, invested_on, sold_on);
}

// (b)(1) as amended: the year of inclusion — the earlier of the sale or the fifth anniversary
pub relation deferred_gain_inclusion_date_pl(fund_investment: QualifiedOpportunityFundInvestment, taxpayer: Person, on: Date) kind institutional {
    label en official "section 1400Z-2(b)(1) (as amended): the earlier of the date the investment is sold or exchanged, or the date 5 years after the investment was made";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "the date which is 5 years after the date the investment in the qualified opportunity fund was made.")
rule InclusionDateFifthAnniversaryRule(fund_investment: QualifiedOpportunityFundInvestment, taxpayer: Person, acquired_on: Date) defeasible {
    label en official "section 1400Z-2(b)(1)(B) (as amended): the fifth anniversary, unless the investment is sold earlier";
    when investment_governed_by_pl119_21(fund_investment, taxpayer);
    when investment_acquired_on(fund_investment, taxpayer, acquired_on);
    when not_known(sold_before_fifth_anniversary(fund_investment, taxpayer));
    then deferred_gain_inclusion_date_pl(fund_investment, taxpayer, add_calendar_period(acquired_on, 5 calendar_year));
}
relation sold_before_fifth_anniversary(fund_investment: QualifiedOpportunityFundInvestment, taxpayer: Person) kind institutional {
    label en unofficial "the investment was sold or exchanged before the fifth anniversary of the investment";
}
rule SoldBeforeFifthAnniversaryRule(fund_investment: QualifiedOpportunityFundInvestment, taxpayer: Person, acquired_on: Date, sold_on: Date) defeasible {
    label en official "section 1400Z-2(b)(1)(A) (as amended)";
    when investment_acquired_on(fund_investment, taxpayer, acquired_on);
    when investment_sold_or_exchanged_on(fund_investment, sold_on);
    when sold_on < add_calendar_period(acquired_on, 5 calendar_year);
    then sold_before_fifth_anniversary(fund_investment, taxpayer);
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "the date on which such investment is sold or exchanged, or")
rule InclusionDateSaleRule(fund_investment: QualifiedOpportunityFundInvestment, taxpayer: Person, sold_on: Date) defeasible {
    label en official "section 1400Z-2(b)(1)(A) (as amended): the sale date when it is before the fifth anniversary";
    when investment_governed_by_pl119_21(fund_investment, taxpayer);
    when sold_before_fifth_anniversary(fund_investment, taxpayer);
    when investment_sold_or_exchanged_on(fund_investment, sold_on);
    then deferred_gain_inclusion_date_pl(fund_investment, taxpayer, sold_on);
}

// (b)(2)(C): qualified rural opportunity fund and rural area
pub relation area_is_city_or_town_over_50000(area: Asset) kind empirical {
    label en official "section 1400Z-2(b)(2)(C)(ii)(I): a city or town that has a population of greater than 50,000 inhabitants";
}
pub relation area_is_urbanized_and_contiguous_to_large_city(area: Asset) kind empirical {
    label en official "section 1400Z-2(b)(2)(C)(ii)(II): an urbanized area contiguous and adjacent to a city or town described in (I)";
}
pub relation rural_area_1400z2(area: Asset) kind institutional {
    label en official "section 1400Z-2(b)(2)(C)(ii) (as amended): any area other than a large city or town or an urbanized area contiguous to it";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "The term ‘rural area’ means any area other than—")
rule RuralAreaRule(area: Asset) defeasible {
    label en official "section 1400Z-2(b)(2)(C)(ii)";
    when area_of_interest_1400z2(area);
    when not_known(area_is_city_or_town_over_50000(area));
    when not_known(area_is_urbanized_and_contiguous_to_large_city(area));
    then rural_area_1400z2(area);
}
pub relation area_of_interest_1400z2(area: Asset) kind empirical {
    label en unofficial "an area whose rural character is being tested";
}
pub relation fund_asset_share_in_rural_qozp(fund: Person, share: Decimal) kind empirical {
    label en official "section 1400Z-2(b)(2)(C)(i): the share of the fund's assets held in qualified opportunity zone property of the rural kinds (I) or (II), measured under rules similar to subsection (d)(1)";
}
pub const RuralOpportunityFundAssetShare: Decimal = 0.90 {
    label en official "at least 90 percent of its assets (section 1400Z-2(b)(2)(C)(i))";
};
pub relation qualified_rural_opportunity_fund(fund: Person) kind institutional {
    label en official "section 1400Z-2(b)(2)(C)(i): a qualified opportunity fund holding at least 90 percent of its assets in rural qualified opportunity zone property";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = partial, quote = "the term ‘qualified rural opportunity fund’ means a qualified opportunity fund that holds at least 90 percent of its assets in qualified opportunity zone property")
rule QualifiedRuralOpportunityFundRule(fund: Person, share: Decimal) defeasible {
    label en official "section 1400Z-2(b)(2)(C)(i) (the property kinds (I)-(II) are folded into the case-supplied share)";
    when fund_asset_share_in_rural_qozp(fund, share);
    when share >= RuralOpportunityFundAssetShare;
    then qualified_rural_opportunity_fund(fund);
}
pub relation investment_in_fund(fund_investment: QualifiedOpportunityFundInvestment, fund: Person) kind empirical {
    label en unofficial "the investment is in the given qualified opportunity fund";
}

// (b)(2)(B)(iii) as amended: the 5-year basis step-up (10 percent; 30 percent for rural funds)
pub const Section1400z2RuralFundStepUpFraction: Decimal = 0.30 {
    label en official "30 percent in the case of any investment in a qualified rural opportunity fund (section 1400Z-2(b)(2)(B)(iii)(I), as amended)";
};
pub relation basis_step_up_5_year_pl(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(b)(2)(B)(iii) (as amended): for an investment held at least 5 years the basis increases by 10 percent (30 percent for a rural fund) of the gain deferred";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = partial, quote = "the basis of such investment shall be increased by an amount equal to 10 percent (30 percent in the case of any investment in a qualified rural opportunity fund) of the amount of gain deferred by reason of subsection (a)(1)(A).")
rule BasisStepUpFiveYearOrdinaryFundRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, fund: Person, as_of: Date, deferred: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(B)(iii)(I) (as amended): 10 percent (cents HALF_UP: JUDGMENT CALL)";
    when investment_governed_by_pl119_21(fund_investment, taxpayer);
    when held_at_least_5_years(fund_investment, taxpayer, as_of);
    when deferred_gain_amount(taxpayer, fund_investment, deferred);
    when investment_in_fund(fund_investment, fund);
    when not_known(qualified_rural_opportunity_fund(fund));
    then basis_step_up_5_year_pl(taxpayer, fund_investment, round(deferred * Section1400z2FiveYearStepUpFraction, 2, "HALF_UP"));
}
rule BasisStepUpFiveYearRuralFundRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, fund: Person, as_of: Date, deferred: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(B)(iii)(I) (as amended): 30 percent for a qualified rural opportunity fund";
    when investment_governed_by_pl119_21(fund_investment, taxpayer);
    when held_at_least_5_years(fund_investment, taxpayer, as_of);
    when deferred_gain_amount(taxpayer, fund_investment, deferred);
    when investment_in_fund(fund_investment, fund);
    when qualified_rural_opportunity_fund(fund);
    then basis_step_up_5_year_pl(taxpayer, fund_investment, round(deferred * Section1400z2RuralFundStepUpFraction, 2, "HALF_UP"));
}

// (b)(2)(A) as amended: the amount includible
pub relation gain_excluded_under_a1A_for_investment(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, amount: Money) kind empirical {
    label en official "section 1400Z-2(b)(2)(A)(i): the amount of gain excluded under subsection (a)(1)(A) with respect to the investment";
}
pub relation basis_for_inclusion_pl(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(b)(2)(A)(ii), (B)(iii)(II): the taxpayer's basis in the investment, with the 5-year increase treated as occurring before the inclusion date";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = partial, quote = "any increase in basis under this clause shall be treated as occurring before the date described in paragraph (1)(B).")
rule BasisForInclusionWithStepUpRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, base: Money, step: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(B)(iii)(II)";
    when investment_governed_by_pl119_21(fund_investment, taxpayer);
    when basis_in_investment(taxpayer, fund_investment, base);
    when basis_step_up_5_year_pl(taxpayer, fund_investment, step);
    then basis_for_inclusion_pl(taxpayer, fund_investment, base + step);
}
rule BasisForInclusionNoStepUpRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, base: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(B): no 5-year increase";
    when investment_governed_by_pl119_21(fund_investment, taxpayer);
    when basis_in_investment(taxpayer, fund_investment, base);
    when not_known(five_year_step_up_pl_exists(taxpayer, fund_investment));
    then basis_for_inclusion_pl(taxpayer, fund_investment, base);
}
relation five_year_step_up_pl_exists(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment) kind institutional {
    label en unofficial "guard: a 5-year step-up exists for the investment";
}
rule FiveYearStepUpPlExistsRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, step: Money) defeasible {
    label en unofficial "guard";
    when basis_step_up_5_year_pl(taxpayer, fund_investment, step);
    then five_year_step_up_pl_exists(taxpayer, fund_investment);
}
pub relation amount_includible_pl(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(b)(2)(A): the excess of the lesser of the gain excluded and the fair market value of the investment on the inclusion date over the taxpayer's basis";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = exact, quote = "the lesser of the amount of gain excluded under subsection (a)(1)(A) or the fair market value of the investment as determined as of the date described in paragraph (1), over")
rule AmountIncludiblePositiveRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, gain: Money, on: Date, fmv: Money, basis: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(A)";
    when gain_excluded_under_a1A_for_investment(taxpayer, fund_investment, gain);
    when deferred_gain_inclusion_date_pl(fund_investment, taxpayer, on);
    when fair_market_value_of_investment_on(fund_investment, on, fmv);
    when basis_for_inclusion_pl(taxpayer, fund_investment, basis);
    when min(gain, fmv) > basis;
    then amount_includible_pl(taxpayer, fund_investment, min(gain, fmv) - basis);
}
rule AmountIncludibleZeroRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, gain: Money, on: Date, fmv: Money, basis: Money) defeasible {
    label en official "section 1400Z-2(b)(2)(A): nothing is includible when the lesser amount does not exceed the basis";
    when gain_excluded_under_a1A_for_investment(taxpayer, fund_investment, gain);
    when deferred_gain_inclusion_date_pl(fund_investment, taxpayer, on);
    when fair_market_value_of_investment_on(fund_investment, on, fmv);
    when basis_for_inclusion_pl(taxpayer, fund_investment, basis);
    when min(gain, fmv) <= basis;
    then amount_includible_pl(taxpayer, fund_investment, 0.00 USD);
}

// (c) as amended: the election for investments held at least 10 years
pub relation basis_after_10_year_election_pl(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, amount: Money) kind institutional {
    label en official "section 1400Z-2(c) (as amended): the basis of the investment after the election: fair market value at sale (sold before 30 years), otherwise fair market value at 30 years";
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = partial, quote = "the fair market value of such investment on the date such investment is sold or exchanged, or")
rule TenYearElectionSoldBefore30YearsRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, acquired_on: Date, sold_on: Date, fmv: Money) defeasible {
    label en official "section 1400Z-2(c)(A) (as amended)";
    when investment_governed_by_pl119_21(fund_investment, taxpayer);
    when investment_acquired_on(fund_investment, taxpayer, acquired_on);
    when elects_10_year_fmv_basis(taxpayer, fund_investment, sold_on);
    when held_at_least_10_years(fund_investment, taxpayer, sold_on);
    when sold_on < add_calendar_period(acquired_on, 30 calendar_year);
    when fair_market_value_of_investment_on(fund_investment, sold_on, fmv);
    then basis_after_10_year_election_pl(taxpayer, fund_investment, fmv);
}
@source(us.irc.temporal::PL119_21_S70421, relation = derives_from, coverage = partial, quote = "the fair market value of such investment on the date that is 30 years after the date of the investment.")
rule TenYearElectionAfter30YearsRule(taxpayer: Person, fund_investment: QualifiedOpportunityFundInvestment, acquired_on: Date, sold_on: Date, fmv: Money) defeasible {
    label en official "section 1400Z-2(c)(B) (as amended): in any other case, the value 30 years after the investment";
    when investment_governed_by_pl119_21(fund_investment, taxpayer);
    when investment_acquired_on(fund_investment, taxpayer, acquired_on);
    when elects_10_year_fmv_basis(taxpayer, fund_investment, sold_on);
    when held_at_least_10_years(fund_investment, taxpayer, sold_on);
    when sold_on >= add_calendar_period(acquired_on, 30 calendar_year);
    when fair_market_value_of_investment_on(fund_investment, add_calendar_period(acquired_on, 30 calendar_year), fmv);
    then basis_after_10_year_election_pl(taxpayer, fund_investment, fmv);
}
