// Stage 3 (IRC-07, A05). Sections 1273(c), 1274(b)-(e), 1274A, 1275 and the
// remaining parts of 1272 (subsection (a)(1) inclusion, (a)(6)-(7), (b)(2), (c)(1))
// that are not the multi-period ledger.
//
// The applicable Federal rate (section 1274(d)): the term classes and the lowest
// 3-month rule are executable; the monthly published rates themselves are case
// facts (published_federal_rate) - the Revenue Rulings that announce them are not
// pinned (SOURCE_GAP row). Present values of payments are case facts because the
// language has no exponentiation; the imputed principal amount is their sum and the
// discount rate used by the case is checked against the applicable rate.

// =============================================================================
// §1274(d): the applicable Federal rate
// =============================================================================

use self::{
    Asset,
    CapitalLossCharacter,
    DebtInstrument,
    IRC_S1272_A,
    IRC_S1272_B,
    IRC_S1272_C,
    IRC_S1273_C,
    IRC_S1274A_A,
    IRC_S1274A_B,
    IRC_S1274A_C,
    IRC_S1274A_D,
    IRC_S1274_A,
    IRC_S1274_B,
    IRC_S1274_C,
    IRC_S1274_D,
    IRC_S1274_E,
    IRC_S1275_A,
    IRC_S1275_B,
    IRC_S1275_C,
    Person,
    TaxableYear,
    adjusted_issue_price_at_start_of_period,
    date_of_issue,
    fixed_maturity_date,
    issue_price,
    issued_for_property,
    oid_current_inclusion_excepted,
    original_issue_discount,
    publicly_offered,
    sections_1274_and_483_excepted_for_personal_use,
    stated_principal_amount,
    stated_redemption_price_at_maturity,
};

pub enum FederalRateClass {
    ShortTerm;
    MidTerm;
    LongTerm;
    label en official "the Federal short-term, mid-term and long-term rates (section 1274(d)(1)(A))";
}
pub relation instrument_final_date_1274d(instr: DebtInstrument, on: Date) kind empirical {
    label en official "section 1274(d)(3): the last date of the term of the debt instrument, taking into account options to renew or extend (the case supplies the extended date when an option exists)";
}
pub relation instrument_has_renewal_option_1274d(instr: DebtInstrument) kind empirical {
    label en official "section 1274(d)(3): the debt instrument carries options to renew or extend";
}
pub relation instrument_final_date_with_options_1274d(instr: DebtInstrument, on: Date) kind empirical {
    label en official "section 1274(d)(3): the last date of the term if every option to renew or extend were exercised";
}
pub relation term_end_for_federal_rate_class(instr: DebtInstrument, on: Date) kind institutional {
    label en official "section 1274(d)(3): the end of the term used to select the Federal rate class";
}
rule TermEndWithoutOptionsRule(instr: DebtInstrument, on: Date) defeasible {
    label en official "section 1274(d)(3): the fixed maturity when there is no option to renew or extend";
    when fixed_maturity_date(instr, on);
    when not_known(instrument_has_renewal_option_1274d(instr));
    then term_end_for_federal_rate_class(instr, on);
}
@source(IRC_S1274_D, relation = formalizes, coverage = exact, quote = "In determining the term of a debt instrument for purposes of this subsection, under regulations prescribed by the Secretary, there shall be taken into account options to renew or extend.")
rule TermEndWithOptionsRule(instr: DebtInstrument, on: Date) defeasible {
    label en official "section 1274(d)(3): options to renew or extend are taken into account";
    when instrument_has_renewal_option_1274d(instr);
    when instrument_final_date_with_options_1274d(instr, on);
    then term_end_for_federal_rate_class(instr, on);
}
pub relation federal_rate_class_of_instrument(instr: DebtInstrument, class: FederalRateClass) kind institutional {
    label en official "section 1274(d)(1)(A): the term table - not over 3 years short-term, over 3 but not over 9 years mid-term, over 9 years long-term";
}
@source(IRC_S1274_D, relation = formalizes, coverage = partial, quote = "with a term of:")
rule FederalRateClassShortRule(instr: DebtInstrument, issued_on: Date, end: Date) defeasible {
    label en official "section 1274(d)(1)(A): not over 3 years";
    when date_of_issue(instr, issued_on);
    when term_end_for_federal_rate_class(instr, end);
    when end <= add_calendar_period(issued_on, 3 calendar_year);
    then federal_rate_class_of_instrument(instr, ShortTerm);
}
rule FederalRateClassMidRule(instr: DebtInstrument, issued_on: Date, end: Date) defeasible {
    label en official "section 1274(d)(1)(A): over 3 years but not over 9 years";
    when date_of_issue(instr, issued_on);
    when term_end_for_federal_rate_class(instr, end);
    when end > add_calendar_period(issued_on, 3 calendar_year);
    when end <= add_calendar_period(issued_on, 9 calendar_year);
    then federal_rate_class_of_instrument(instr, MidTerm);
}
rule FederalRateClassLongRule(instr: DebtInstrument, issued_on: Date, end: Date) defeasible {
    label en official "section 1274(d)(1)(A): over 9 years";
    when date_of_issue(instr, issued_on);
    when term_end_for_federal_rate_class(instr, end);
    when end > add_calendar_period(issued_on, 9 calendar_year);
    then federal_rate_class_of_instrument(instr, LongTerm);
}
pub relation published_federal_rate(class: FederalRateClass, month_begins: Date, rate: Decimal) kind empirical {
    label en official "section 1274(d)(1)(B): the Federal rate of the class determined by the Secretary for the calendar month beginning on the date, compounded semiannually (the published value is a case fact; SOURCE_GAP)";
}
// (B): the Secretary's monthly determination is a duty
pub relation calendar_month_in_force(month_begins: Date) kind empirical {
    label en official "the calendar month beginning on the date is running";
}
pub relation federal_rates_determined_for_following_month(month_begins: Date) kind empirical {
    label en official "section 1274(d)(1)(B): during the calendar month the Secretary has determined the short-term, mid-term and long-term rates that apply during the following calendar month";
}
@source(IRC_S1274_D, relation = formalizes, coverage = exact, quote = "During each calendar month, the Secretary shall determine the Federal short-term rate, mid-term rate, and long-term rate which shall apply during the following calendar month.")
rule SecretaryMonthlyFederalRatesDuty(m: Date) defeasible {
    label en official "section 1274(d)(1)(B): in each calendar month the Secretary shall determine the rates for the next month";
    when calendar_month_in_force(m);
    then duty MonthlyFederalRatesDeterminationDuty {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition federal_rates_determined_for_following_month(m);
            window [m, add_calendar_period(m, 1 calendar_month)];
        }
    };
}
// (C): the rate methodology is the Secretary's determination
pub relation secretary_determination_basis_market_yield(class: FederalRateClass, month_begins: Date) kind empirical {
    label en official "section 1274(d)(1)(C): the rate rests on the average market yield, over a 1-month period ending in the month of determination, on outstanding marketable United States obligations with the class's remaining maturities (a determination of the Secretary; the value is published_federal_rate)";
}
// (D): a lower rate by regulation
pub relation lower_rate_permitted_by_regulation(instr: DebtInstrument, rate: Decimal) kind empirical {
    label en official "section 1274(d)(1)(D): a rate lower than the applicable Federal rate that the Secretary permits by regulation where the taxpayer establishes that it is based on the same principles and is appropriate for the term (a determination of the Secretary)";
}
// (2): the lowest 3-month rate
pub relation binding_contract_month_begins(instr: DebtInstrument, month_begins: Date) kind empirical {
    label en official "section 1274(d)(2)(B): the first calendar month in which there is a binding contract in writing for the sale or exchange (its first day)";
}
pub relation lowest_three_month_rate(instr: DebtInstrument, rate: Decimal) kind institutional {
    label en official "section 1274(d)(2): the lowest of the applicable Federal rates in effect for any month of the 3-calendar-month period ending with the month of the binding contract";
}
pub relation rate_in_three_month_window(instr: DebtInstrument, rate: Decimal) kind institutional {
    label en unofficial "the Federal rate of the instrument's class for the contract month or one of the two months before it";
}
@source(IRC_S1274_D, relation = formalizes, coverage = partial, quote = "For purposes of subparagraph (A), the term \"lowest 3-month rate\" means the lowest of the applicable Federal rates in effect for any month in the 3-calendar-month period ending with the 1st calendar month in which there is a binding contract in writing for such sale or exchange.")
rule WindowContractMonthRule(instr: DebtInstrument, class: FederalRateClass, m: Date, r: Decimal) defeasible {
    label en official "section 1274(d)(2)(B): the month of the binding contract";
    when federal_rate_class_of_instrument(instr, class);
    when binding_contract_month_begins(instr, m);
    when published_federal_rate(class, m, r);
    then rate_in_three_month_window(instr, r);
}
rule WindowPreviousMonthRule(instr: DebtInstrument, class: FederalRateClass, m: Date, w: Date, r: Decimal) defeasible {
    label en official "section 1274(d)(2)(B): the month before the contract month";
    when federal_rate_class_of_instrument(instr, class);
    when binding_contract_month_begins(instr, m);
    when published_federal_rate(class, w, r);
    when add_calendar_period(w, 1 calendar_month) == m;
    then rate_in_three_month_window(instr, r);
}
rule WindowSecondPreviousMonthRule(instr: DebtInstrument, class: FederalRateClass, m: Date, x: Date, r: Decimal) defeasible {
    label en official "section 1274(d)(2)(B): two months before the contract month";
    when federal_rate_class_of_instrument(instr, class);
    when binding_contract_month_begins(instr, m);
    when published_federal_rate(class, x, r);
    when add_calendar_period(add_calendar_period(x, 1 calendar_month), 1 calendar_month) == m;
    then rate_in_three_month_window(instr, r);
}
pub relation window_lower_rate_exists(instr: DebtInstrument, rate: Decimal) kind institutional {
    label en unofficial "a lower rate exists among the window rates (the earliest-of pattern)";
}
rule WindowLowerRateExistsRule(instr: DebtInstrument, r1: Decimal, r2: Decimal) defeasible {
    label en unofficial "helper for the lowest of the window rates";
    when rate_in_three_month_window(instr, r1);
    when rate_in_three_month_window(instr, r2);
    when r2 < r1;
    then window_lower_rate_exists(instr, r1);
}
@source(IRC_S1274_D, relation = formalizes, coverage = partial, quote = "In the case of any sale or exchange, the applicable Federal rate shall be the lowest 3-month rate.")
rule LowestThreeMonthRateRule(instr: DebtInstrument, r: Decimal) defeasible {
    label en official "section 1274(d)(2)(A)-(B): the lowest window rate";
    when rate_in_three_month_window(instr, r);
    when not_known(window_lower_rate_exists(instr, r));
    then lowest_three_month_rate(instr, r);
}
pub relation applicable_federal_rate_for_instrument(instr: DebtInstrument, rate: Decimal) kind institutional {
    label en official "section 1274(d): the applicable Federal rate of the instrument - the lowest 3-month rate for a sale or exchange";
}
rule ApplicableFederalRateRule(instr: DebtInstrument, r: Decimal) defeasible {
    label en official "section 1274(d)(2)(A)";
    when lowest_three_month_rate(instr, r);
    then applicable_federal_rate_for_instrument(instr, r);
}

// =============================================================================
// §1274(b): the imputed principal amount
// =============================================================================

pub relation sale_or_exchange_date_1274(instr: DebtInstrument, on: Date) kind empirical {
    label en official "the date of the sale or exchange for which the debt instrument is given";
}
pub relation sale_leaseback_plan_1274e3(instr: DebtInstrument) kind empirical {
    label en official "section 1274(e)(3): pursuant to a plan, the transferor or a related person leases a portion of the property after the sale or exchange";
}
pub relation qualified_debt_instrument_1274a(instr: DebtInstrument) kind institutional {
    label en official "section 1274A(b): a qualified debt instrument";
}
pub relation discount_rate_1274b2b(instr: DebtInstrument, rate: Decimal) kind institutional {
    label en official "section 1274(b)(2)(B), (e), 1274A(a): the discount rate for the present values - the applicable Federal rate, 110 percent of it in a sale-leaseback case, capped at 9 percent for a qualified debt instrument";
}
rule DiscountRateOrdinaryRule(instr: DebtInstrument, r: Decimal) defeasible {
    label en official "section 1274(b)(2)(B): the applicable Federal rate, compounded semiannually (no sale-leaseback, not a qualified debt instrument)";
    when applicable_federal_rate_for_instrument(instr, r);
    when not_known(sale_leaseback_plan_1274e3(instr));
    when not_known(qualified_debt_instrument_1274a(instr));
    then discount_rate_1274b2b(instr, r);
}
@source(IRC_S1274_E, relation = formalizes, coverage = exact, quote = "In the case of any debt instrument to which this subsection applies, the discount rate used under subsection (b)(2)(B) or section 483(b) shall be 110 percent of the applicable Federal rate, compounded semiannually.")
rule DiscountRateSaleLeasebackRule(instr: DebtInstrument, r: Decimal) defeasible {
    label en official "section 1274(e)(1): 110 percent of the applicable Federal rate (section 1274A does not apply, (e)(2))";
    when applicable_federal_rate_for_instrument(instr, r);
    when sale_leaseback_plan_1274e3(instr);
    then discount_rate_1274b2b(instr, r * 1.10);
}
@source(IRC_S1274A_A, relation = formalizes, coverage = exact, quote = "In the case of any qualified debt instrument, the discount rate used for purposes of sections 483 and 1274 shall not exceed 9 percent, compounded semiannually.")
rule DiscountRateQualifiedCappedRule(instr: DebtInstrument, r: Decimal) defeasible {
    label en official "section 1274A(a): not above 9 percent for a qualified debt instrument that is not a sale-leaseback instrument";
    when applicable_federal_rate_for_instrument(instr, r);
    when qualified_debt_instrument_1274a(instr);
    when not_known(sale_leaseback_plan_1274e3(instr));
    when r <= 0.09;
    then discount_rate_1274b2b(instr, r);
}
rule DiscountRateQualifiedAboveCapRule(instr: DebtInstrument, r: Decimal) defeasible {
    label en official "section 1274A(a): the 9 percent cap replaces a higher applicable Federal rate";
    when applicable_federal_rate_for_instrument(instr, r);
    when qualified_debt_instrument_1274a(instr);
    when not_known(sale_leaseback_plan_1274e3(instr));
    when r > 0.09;
    then discount_rate_1274b2b(instr, 0.09);
}
pub relation payment_present_value_1274b2(instr: DebtInstrument, payment_no: Integer, amount: Money) kind empirical {
    label en official "section 1274(b)(2): the present value, as of the date of the sale or exchange, of the payment due under the debt instrument (computed by the case: the language has no exponentiation)";
}
pub relation present_value_discount_rate_used(instr: DebtInstrument, rate: Decimal) kind empirical {
    label en official "section 1274(b)(2)(B): the discount rate (compounded semiannually) with which the case computed the present values";
}
pub relation present_value_date_used(instr: DebtInstrument, on: Date) kind empirical {
    label en official "section 1274(b)(2)(A): the date as of which the case computed the present values";
}
pub relation present_values_determined_per_1274b2(instr: DebtInstrument) kind institutional {
    label en official "section 1274(b)(2): the present values were determined as of the sale date at the applicable discount rate";
}
@source(IRC_S1274_B, relation = formalizes, coverage = exact, quote = "(B) by using a discount rate equal to the applicable Federal rate, compounded semiannually.")
rule PresentValuesDeterminedRule(instr: DebtInstrument, r: Decimal, on: Date) defeasible {
    label en official "section 1274(b)(2)(A)-(B): the date of the sale and the applicable discount rate";
    when discount_rate_1274b2b(instr, r);
    when present_value_discount_rate_used(instr, r);
    when sale_or_exchange_date_1274(instr, on);
    when present_value_date_used(instr, on);
    then present_values_determined_per_1274b2(instr);
}
pub relation tax_shelter_6662d2C2(instr: DebtInstrument) kind empirical {
    label en official "section 1274(b)(3)(B)(i): the situation is a tax shelter (section 6662(d)(2)(C)(ii))";
}
pub relation situation_of_type_specified_by_regulation_1274b3(instr: DebtInstrument) kind empirical {
    label en official "section 1274(b)(3)(B)(ii): a situation that, by reason of recent sales transactions, nonrecourse financing, financing with a term in excess of the economic life of the property, or other circumstances, is of a type the Secretary specifies by regulations as having potential for tax avoidance";
}
pub relation potentially_abusive_situation_1274b3(instr: DebtInstrument) kind institutional {
    label en official "section 1274(b)(3)(B): a potentially abusive situation";
}
@source(IRC_S1274_B, relation = formalizes, coverage = exact, quote = "(i) a tax shelter (as defined in section 6662(d)(2)(C)(ii)), and")
rule PotentiallyAbusiveTaxShelterRule(instr: DebtInstrument) defeasible {
    label en official "section 1274(b)(3)(B)(i)";
    when tax_shelter_6662d2C2(instr);
    then potentially_abusive_situation_1274b3(instr);
}
@source(IRC_S1274_B, relation = formalizes, coverage = exact, quote = "is of a type which the Secretary specifies by regulations as having potential for tax avoidance.")
rule PotentiallyAbusiveRegulatedTypeRule(instr: DebtInstrument) defeasible {
    label en official "section 1274(b)(3)(B)(ii): circumstances (I)-(IV) of a type specified by the Secretary";
    when situation_of_type_specified_by_regulation_1274b3(instr);
    then potentially_abusive_situation_1274b3(instr);
}
pub relation fair_market_value_of_property_adjusted_for_other_consideration(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1274(b)(3)(A): the fair market value of the property adjusted to take into account other consideration involved in the transaction";
}
pub relation imputed_principal_amount_derived(instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1274(b): the imputed principal amount - the sum of the present values, or in a potentially abusive situation the adjusted fair market value";
}
@source(IRC_S1274_B, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (3), the imputed principal amount of any debt instrument shall be equal to the sum of the present values of all payments due under such debt instrument.")
rule ImputedPrincipalSumOfPresentValuesRule(instr: DebtInstrument, total: Money) defeasible {
    label en official "section 1274(b)(1): the sum of the present values of all payments (an aggregate over the case's empirical payment values)";
    when present_values_determined_per_1274b2(instr);
    when not_known(potentially_abusive_situation_1274b3(instr));
    when payment_present_value_total_1274b1(instr, total);
    then imputed_principal_amount_derived(instr, total);
}
pub relation payment_present_value_total_1274b1(instr: DebtInstrument, total: Money) kind institutional {
    label en official "section 1274(b)(1): the sum of the present values of all payments due";
}
rule PaymentPresentValueTotalRule(instr: DebtInstrument, r: Decimal) defeasible {
    label en unofficial "sums the empirical payment values (the guard binds the instrument)";
    when present_value_discount_rate_used(instr, r);
    then payment_present_value_total_1274b1(instr, sum all amount: Money for n: Integer where payment_present_value_1274b2(instr, n, amount));
}
@source(IRC_S1274_B, relation = formalizes, coverage = exact, quote = "In the case of any potentially abusive situation, the imputed principal amount of any debt instrument received in exchange for property shall be the fair market value of such property adjusted to take into account other consideration involved in the transaction.")
rule ImputedPrincipalPotentiallyAbusiveRule(instr: DebtInstrument, fmv: Money) defeasible {
    label en official "section 1274(b)(3)(A)";
    when potentially_abusive_situation_1274b3(instr);
    when fair_market_value_of_property_adjusted_for_other_consideration(instr, fmv);
    then imputed_principal_amount_derived(instr, fmv);
}
@source(IRC_S1274_A, relation = formalizes, coverage = partial, quote = "in any other case, the imputed principal amount.")
rule Section1274IssuePriceDerivedImputedRule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1274(a)(2): the issue price is the derived imputed principal amount where section 1274 governs and there is no adequate stated interest";
    when section_1274_governs(instr);
    when not_known(adequate_stated_interest_1274c2(instr));
    when imputed_principal_amount_derived(instr, amount);
    then issue_price(instr, amount);
}
@source(IRC_S1274_A, relation = formalizes, coverage = partial, quote = "where there is adequate stated interest, the stated principal amount, or")
rule Section1274IssuePriceDerivedAdequateRule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1274(a)(1): the stated principal amount where section 1274 governs and there is adequate stated interest";
    when section_1274_governs(instr);
    when adequate_stated_interest_1274c2(instr);
    when stated_principal_amount(instr, amount);
    then issue_price(instr, amount);
}

// =============================================================================
// §1274(c): scope
// =============================================================================

pub relation adequate_stated_interest_1274c2(instr: DebtInstrument) kind institutional {
    label en official "section 1274(c)(2): the stated principal amount is less than or equal to the imputed principal amount";
}
@source(IRC_S1274_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, there is adequate stated interest with respect to any debt instrument if the stated principal amount for such debt instrument is less than or equal to the imputed principal amount of such debt instrument determined under subsection (b).")
rule AdequateStatedInterestRule(instr: DebtInstrument, stated: Money, imputed: Money) defeasible {
    label en official "section 1274(c)(2)";
    when stated_principal_amount(instr, stated);
    when imputed_principal_amount_derived(instr, imputed);
    when stated <= imputed;
    then adequate_stated_interest_1274c2(instr);
}
pub relation some_payment_due_more_than_6_months_after_sale(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(1)(B): some or all of the payments are due more than 6 months after the date of the sale or exchange";
}
pub relation given_in_consideration_for_sale_or_exchange_of_property(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(1): the debt instrument is given in consideration for the sale or exchange of property";
}
pub relation section_1274_scope_test_met(instr: DebtInstrument) kind institutional {
    label en official "section 1274(c)(1): the stated redemption price at maturity exceeds the stated principal amount (adequate stated interest) or the imputed principal amount (other cases), and a payment falls due more than 6 months after the sale";
}
@source(IRC_S1274_C, relation = formalizes, coverage = partial, quote = "Except as otherwise provided in this subsection, this section shall apply to any debt instrument given in consideration for the sale or exchange of property if—")
rule ScopeAdequateInterestRule(instr: DebtInstrument, srpm: Money, stated: Money) defeasible {
    label en official "section 1274(c)(1)(A)(i), (B)";
    when given_in_consideration_for_sale_or_exchange_of_property(instr);
    when adequate_stated_interest_1274c2(instr);
    when stated_redemption_price_at_maturity(instr, srpm);
    when stated_principal_amount(instr, stated);
    when srpm > stated;
    when some_payment_due_more_than_6_months_after_sale(instr);
    then section_1274_scope_test_met(instr);
}
rule ScopeOtherCasesRule(instr: DebtInstrument, srpm: Money, imputed: Money) defeasible {
    label en official "section 1274(c)(1)(A)(ii), (B)";
    when given_in_consideration_for_sale_or_exchange_of_property(instr);
    when not_known(adequate_stated_interest_1274c2(instr));
    when stated_redemption_price_at_maturity(instr, srpm);
    when imputed_principal_amount_derived(instr, imputed);
    when srpm > imputed;
    when some_payment_due_more_than_6_months_after_sale(instr);
    then section_1274_scope_test_met(instr);
}
// (c)(3): exceptions
pub relation farm_sale_by_eligible_seller_1274c3a(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(3)(A)(i): a sale or exchange of a farm (section 6420(c)(2)) by an individual, estate or testamentary trust, or by a small business corporation (section 1244(c)(3)) or a partnership meeting similar requirements as of the sale date";
}
pub relation farm_sales_price_cannot_exceed(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1274(c)(3)(A)(ii): the maximum sales price determinable at the time of the sale or exchange, all sales of the same transaction (or series) treated as one";
}
pub relation principal_residence_sale_by_individual_1274c3b(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(3)(B): a sale or exchange by an individual of his principal residence (section 121)";
}
pub relation debt_payments_total_1274c3c(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1274(c)(3)(C)(i)(I): the aggregate amount of the payments due under the instrument and all other debt instruments received for the sale or exchange (same transaction or series treated as one)";
}
pub relation other_consideration_fair_market_value_1274c3c(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1274(c)(3)(C)(i)(II), (ii): the aggregate other consideration, other than a debt instrument, at its fair market value";
}
pub relation instrument_under_1273b3(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(3)(D): a debt instrument to which section 1273(b)(3) applies";
}
pub relation patent_transfer_contingent_amount_1235(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(3)(E): a transfer described in section 1235(a) - an amount contingent on the productivity, use, or disposition of the property transferred";
}
pub relation section_483e_related_land_transfer(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(3)(F): the instrument to the extent section 483(e) (certain land transfers between related persons) applies";
}
pub relation section_1274_excepted_by_c3(instr: DebtInstrument) kind institutional {
    label en official "section 1274(c)(3): this section does not apply to the debt instrument";
}
pub const FarmSaleSalesPriceCeiling: Money = 1000000.00 USD {
    label en official "$1,000,000 (section 1274(c)(3)(A)(ii))";
};
pub const SmallSaleAmountCeiling: Money = 250000.00 USD {
    label en official "$250,000 (section 1274(c)(3)(C)(i))";
};
@source(IRC_S1274_C, relation = formalizes, coverage = exact, quote = "Clause (i) shall apply only if it can be determined at the time of the sale or exchange that the sales price cannot exceed $1,000,000.")
rule ExceptedFarmSaleRule(instr: DebtInstrument, cap: Money) defeasible {
    label en official "section 1274(c)(3)(A)(i)-(ii): a farm sale by an eligible seller with a sales price that cannot exceed $1,000,000";
    when farm_sale_by_eligible_seller_1274c3a(instr);
    when farm_sales_price_cannot_exceed(instr, cap);
    when cap <= FarmSaleSalesPriceCeiling;
    then section_1274_excepted_by_c3(instr);
}
@source(IRC_S1274_C, relation = formalizes, coverage = exact, quote = "Any debt instrument arising from the sale or exchange by an individual of his principal residence (within the meaning of section 121).")
rule ExceptedResidenceRule(instr: DebtInstrument) defeasible {
    label en official "section 1274(c)(3)(B)";
    when principal_residence_sale_by_individual_1274c3b(instr);
    then section_1274_excepted_by_c3(instr);
}
@source(IRC_S1274_C, relation = formalizes, coverage = exact, quote = "Any debt instrument arising from the sale or exchange of property if the sum of the following amounts does not exceed $250,000:")
rule ExceptedSmallSaleRule(instr: DebtInstrument, payments: Money, other: Money) defeasible {
    label en official "section 1274(c)(3)(C): payments plus other consideration (at fair market value) not above $250,000";
    when debt_payments_total_1274c3c(instr, payments);
    when other_consideration_fair_market_value_1274c3c(instr, other);
    when payments + other <= SmallSaleAmountCeiling;
    then section_1274_excepted_by_c3(instr);
}
@source(IRC_S1274_C, relation = formalizes, coverage = exact, quote = "Any debt instrument to which section 1273(b)(3) applies.")
rule Excepted1273b3Rule(instr: DebtInstrument) defeasible {
    label en official "section 1274(c)(3)(D)";
    when instrument_under_1273b3(instr);
    then section_1274_excepted_by_c3(instr);
}
@source(IRC_S1274_C, relation = formalizes, coverage = exact, quote = "In the case of any transfer described in section 1235(a) (relating to sale or exchange of patents), any amount contingent on the productivity, use, or disposition of the property transferred.")
rule ExceptedPatentContingentRule(instr: DebtInstrument) defeasible {
    label en official "section 1274(c)(3)(E)";
    when patent_transfer_contingent_amount_1235(instr);
    then section_1274_excepted_by_c3(instr);
}
@source(IRC_S1274_C, relation = formalizes, coverage = exact, quote = "Any debt instrument to the extent section 483(e) (relating to certain land transfers between related persons) applies to such instrument.")
rule ExceptedRelatedLandRule(instr: DebtInstrument) defeasible {
    label en official "section 1274(c)(3)(F)";
    when section_483e_related_land_transfer(instr);
    then section_1274_excepted_by_c3(instr);
}
// §1274A(c): the cash method election also excludes section 1274
pub relation cash_method_debt_instrument_1274a(instr: DebtInstrument) kind institutional {
    label en official "section 1274A(c)(2): a cash method debt instrument";
}
pub relation section_1274_governs(instr: DebtInstrument) kind institutional {
    label en official "section 1274: the section applies to the debt instrument (scope test met, no (c)(3) exception, not a cash method debt instrument, not excepted for personal use property)";
}
@source(IRC_S1274_C, relation = formalizes, coverage = partial, quote = "Except as otherwise provided in this subsection, this section shall apply to any debt instrument given in consideration for the sale or exchange of property if—")
rule Section1274GovernsRule(instr: DebtInstrument) defeasible {
    label en official "section 1274(c)(1) with the (c)(3) exceptions, section 1274A(c)(1)(A) and section 1275(b)(1)";
    when section_1274_scope_test_met(instr);
    when not_known(section_1274_excepted_by_c3(instr));
    when not_known(cash_method_debt_instrument_1274a(instr));
    when not_known(sections_1274_and_483_excepted_for_personal_use(instr));
    then section_1274_governs(instr);
}
pub relation debt_assumed_or_property_acquired_subject_to_debt(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(4)(A)-(B): in connection with the sale or exchange a person assumes the debt instrument or acquires property subject to it";
}
pub relation terms_modified_or_transaction_changed_in_connection(instr: DebtInstrument) kind empirical {
    label en official "section 1274(c)(4): the terms of the debt instrument are modified (or the nature of the transaction changed) in connection with the assumption or acquisition";
}
pub relation assumption_taken_into_account_1274c4(instr: DebtInstrument) kind institutional {
    label en official "section 1274(c)(4): the assumption or acquisition is taken into account in determining whether section 1274 or 483 applies";
}
@source(IRC_S1274_C, relation = formalizes, coverage = exact, quote = "in determining whether this section or section 483 applies to such debt instrument, such assumption (or such acquisition) shall not be taken into account unless the terms and conditions of such debt instrument are modified (or the nature of the transaction is changed) in connection with the assumption (or acquisition).")
rule AssumptionTakenIntoAccountRule(instr: DebtInstrument) defeasible {
    label en official "section 1274(c)(4)";
    when debt_assumed_or_property_acquired_subject_to_debt(instr);
    when terms_modified_or_transaction_changed_in_connection(instr);
    then assumption_taken_into_account_1274c4(instr);
}

// =============================================================================
// §1274A: qualified debt instruments, cash method, aggregation, indexing
// =============================================================================

pub relation stated_principal_amount_for_1274a(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1274A: the stated principal amount of the instrument (all debt instruments of the same transaction treated as one, (d)(1)(B))";
}
pub relation new_section_38_property_1274a(instr: DebtInstrument) kind empirical {
    label en official "section 1274A(b): the property is new section 38 property within the meaning of section 48(b) as in effect before the Revenue Reconciliation Act of 1990";
}
pub relation sale_calendar_year_1274a(instr: DebtInstrument, year: Integer) kind empirical {
    label en official "the calendar year of the sale or exchange";
}
pub relation cost_of_living_factor_1988_base(year: Integer, factor: Decimal) kind empirical {
    label en official "section 1274A(d)(2)(B): the cost-of-living adjustment determined under section 1(f)(3) for the calendar year, substituting calendar year 1988 for calendar year 2016 (the published factor is a case fact; SOURCE_GAP)";
}
pub const QualifiedDebtInstrumentBaseCap: Money = 2800000.00 USD {
    label en official "$2,800,000 (section 1274A(b))";
};
pub const CashMethodBaseCap: Money = 2000000.00 USD {
    label en official "$2,000,000 (section 1274A(c)(2)(A))";
};
pub relation qualified_debt_cap_1274a(instr: DebtInstrument, cap: Money) kind institutional {
    label en official "section 1274A(b), (d)(2): the $2,800,000 amount, indexed for a sale after 1989 (the increase rounded to the nearest $100, an increase that is a multiple of $50 going up)";
}
pub relation cash_method_cap_1274a(instr: DebtInstrument, cap: Money) kind institutional {
    label en official "section 1274A(c)(2)(A), (d)(2): the $2,000,000 amount, indexed for a sale after 1989";
}
@source(IRC_S1274A_D, relation = formalizes, coverage = partial, quote = "Any increase under the preceding sentence shall be rounded to the nearest multiple of $100 (or, if such increase is a multiple of $50, such increase shall be increased to the nearest multiple of $100).")
rule QualifiedCapAfter1989Rule(instr: DebtInstrument, year: Integer, factor: Decimal) defeasible {
    label en official "section 1274A(d)(2): a sale after 1989; rounding to the nearest $100, half up";
    when sale_calendar_year_1274a(instr, year);
    when cost_of_living_factor_1988_base(year, factor);
    when year > 1989;
    then qualified_debt_cap_1274a(instr, QualifiedDebtInstrumentBaseCap + round(QualifiedDebtInstrumentBaseCap * factor * 0.01, 0, "HALF_UP") * 100);
}
rule CashCapAfter1989Rule(instr: DebtInstrument, year: Integer, factor: Decimal) defeasible {
    label en official "section 1274A(d)(2): a sale after 1989; rounding to the nearest $100, half up";
    when sale_calendar_year_1274a(instr, year);
    when cost_of_living_factor_1988_base(year, factor);
    when year > 1989;
    then cash_method_cap_1274a(instr, CashMethodBaseCap + round(CashMethodBaseCap * factor * 0.01, 0, "HALF_UP") * 100);
}
@source(IRC_S1274A_D, relation = formalizes, coverage = partial, quote = "each dollar amount contained in the preceding provisions of this section shall be increased by an amount equal to—")
rule QualifiedCapUpTo1989Rule(instr: DebtInstrument, year: Integer) defeasible {
    label en official "section 1274A(d)(2): no increase for a sale before 1990";
    when sale_calendar_year_1274a(instr, year);
    when year <= 1989;
    then qualified_debt_cap_1274a(instr, QualifiedDebtInstrumentBaseCap);
}
rule CashCapUpTo1989Rule(instr: DebtInstrument, year: Integer) defeasible {
    label en official "section 1274A(d)(2): no increase for a sale before 1990";
    when sale_calendar_year_1274a(instr, year);
    when year <= 1989;
    then cash_method_cap_1274a(instr, CashMethodBaseCap);
}
@source(IRC_S1274A_B, relation = formalizes, coverage = exact, quote = "if the stated principal amount of such instrument does not exceed $2,800,000.")
rule QualifiedDebtInstrumentRule(instr: DebtInstrument, stated: Money, cap: Money) defeasible {
    label en official "section 1274A(b) with the (d)(2) indexing";
    when given_in_consideration_for_sale_or_exchange_of_property(instr);
    when not_known(new_section_38_property_1274a(instr));
    when stated_principal_amount_for_1274a(instr, stated);
    when qualified_debt_cap_1274a(instr, cap);
    when stated <= cap;
    then qualified_debt_instrument_1274a(instr);
}
pub relation lender_uses_accrual_method_or_is_dealer(instr: DebtInstrument) kind empirical {
    label en official "section 1274A(c)(2)(B): the lender uses an accrual method of accounting or is a dealer with respect to the property sold or exchanged";
}
pub relation section_1274_would_apply_but_for_election(instr: DebtInstrument) kind empirical {
    label en official "section 1274A(c)(2)(C): section 1274 would have applied to the instrument but for an election under the subsection";
}
pub relation cash_method_election_jointly_made(instr: DebtInstrument) kind empirical {
    label en official "section 1274A(c)(2)(D): the borrower and lender jointly make an election with respect to the instrument";
}
@source(IRC_S1274A_C, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the term \"cash method debt instrument\" means any qualified debt instrument if—")
rule CashMethodDebtInstrumentRule(instr: DebtInstrument, stated: Money, cap: Money) defeasible {
    label en official "section 1274A(c)(2)(A)-(D)";
    when qualified_debt_instrument_1274a(instr);
    when stated_principal_amount_for_1274a(instr, stated);
    when cash_method_cap_1274a(instr, cap);
    when stated <= cap;
    when not_known(lender_uses_accrual_method_or_is_dealer(instr));
    when section_1274_would_apply_but_for_election(instr);
    when cash_method_election_jointly_made(instr);
    then cash_method_debt_instrument_1274a(instr);
}
pub relation interest_taken_into_account_under_cash_method_by_borrower_and_lender(instr: DebtInstrument) kind institutional {
    label en official "section 1274A(c)(1)(B): interest is taken into account by both the borrower and the lender under the cash receipts and disbursements method";
}
@source(IRC_S1274A_C, relation = formalizes, coverage = exact, quote = "(B) interest on such debt instrument shall be taken into account by both the borrower and the lender under the cash receipts and disbursements method of accounting.")
rule CashMethodInterestRule(instr: DebtInstrument) defeasible {
    label en official "section 1274A(c)(1)(B)";
    when cash_method_debt_instrument_1274a(instr);
    then interest_taken_into_account_under_cash_method_by_borrower_and_lender(instr);
}
pub relation successor_to_borrower_or_lender(instr: DebtInstrument, successor: Person) kind empirical {
    label en official "section 1274A(c)(3)(A): the person is a successor to the borrower or lender";
}
pub relation cash_method_instrument_transferred_to_accrual_taxpayer_before(instr: DebtInstrument, successor: Person) kind empirical {
    label en official "section 1274A(c)(3)(B): the lender (or successor) transferred the instrument to an accrual method taxpayer before the period in question";
}
pub relation cash_method_binds_successor(instr: DebtInstrument, successor: Person) kind institutional {
    label en official "section 1274A(c)(3): paragraph (1) applies to the successor";
}
@source(IRC_S1274A_C, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), paragraph (1) shall apply to any successor to the borrower or lender with respect to a cash method debt instrument.")
rule SuccessorBoundRule(instr: DebtInstrument, successor: Person) defeasible {
    label en official "section 1274A(c)(3)(A) with the (B) exception for periods after a transfer to an accrual method taxpayer";
    when cash_method_debt_instrument_1274a(instr);
    when successor_to_borrower_or_lender(instr, successor);
    when not_known(cash_method_instrument_transferred_to_accrual_taxpayer_before(instr, successor));
    then cash_method_binds_successor(instr, successor);
}
pub relation section_483_applied_with_1274b3_fair_market_value_rule(instr: DebtInstrument) kind institutional {
    label en official "section 1274A(c)(4): for a cash method debt instrument section 483 is applied as if it included provisions similar to section 1274(b)(3)";
}
@source(IRC_S1274A_C, relation = formalizes, coverage = exact, quote = "In the case of any cash method debt instrument, section 483 shall be applied as if it included provisions similar to the provisions of section 1274(b)(3).")
rule Section483FmvRule(instr: DebtInstrument) defeasible {
    label en official "section 1274A(c)(4)";
    when cash_method_debt_instrument_1274a(instr);
    then section_483_applied_with_1274b3_fair_market_value_rule(instr);
}
pub relation transaction_of_instrument_aggregated_as_one(instr: DebtInstrument) kind empirical {
    label en official "section 1274A(d)(1): the sales or exchanges (and the debt instruments arising) are part of the same transaction or a series of related transactions, so they are treated as one";
}
pub relation aggregated_instrument_treated_as_one_1274ad1(instr: DebtInstrument) kind institutional {
    label en official "section 1274A(d)(1)(A)-(B): all sales or exchanges of the transaction are one sale, all instruments of the transaction are one instrument";
}
@source(IRC_S1274A_D, relation = formalizes, coverage = exact, quote = "(B) all debt instruments arising from the same transaction (or a series of related transactions) shall be treated as 1 debt instrument.")
rule AggregationRule(instr: DebtInstrument) defeasible {
    label en official "section 1274A(d)(1)";
    when transaction_of_instrument_aggregated_as_one(instr);
    then aggregated_instrument_treated_as_one_1274ad1(instr);
}

// =============================================================================
// §1275 and §1273(c)
// =============================================================================

pub relation date_first_issued_to_public(instr: DebtInstrument, on: Date) kind empirical {
    label en official "section 1275(a)(2)(A): the date on which the issue was first issued to the public";
}
pub relation date_sold_by_issuer(instr: DebtInstrument, on: Date) kind empirical {
    label en official "section 1275(a)(2)(B): the date on which the debt instrument was sold by the issuer";
}
pub relation date_issued_in_sale_or_exchange(instr: DebtInstrument, on: Date) kind empirical {
    label en official "section 1275(a)(2)(C): the date on which the debt instrument was issued in a sale or exchange";
}
pub relation date_of_original_issue(instr: DebtInstrument, on: Date) kind institutional {
    label en official "section 1275(a)(2): the date of original issue";
}
@source(IRC_S1275_A, relation = formalizes, coverage = exact, quote = "In the case of any debt instrument which is publicly offered, the term \"date of original issue\" means the date on which the issue was first issued to the public.")
rule DateOfOriginalIssuePublicRule(instr: DebtInstrument, on: Date) defeasible {
    label en official "section 1275(a)(2)(A)";
    when publicly_offered(instr);
    when date_first_issued_to_public(instr, on);
    then date_of_original_issue(instr, on);
}
@source(IRC_S1275_A, relation = formalizes, coverage = exact, quote = "In the case of any debt instrument to which section 1273(b)(2) applies, the term \"date of original issue\" means the date on which the debt instrument was sold by the issuer.")
rule DateOfOriginalIssueSoldByIssuerRule(instr: DebtInstrument, on: Date) defeasible {
    label en official "section 1275(a)(2)(B): not publicly offered and not issued for property (section 1273(b)(2))";
    when not_known(publicly_offered(instr));
    when not_known(issued_for_property(instr));
    when date_sold_by_issuer(instr, on);
    then date_of_original_issue(instr, on);
}
@source(IRC_S1275_A, relation = formalizes, coverage = exact, quote = "In the case of any debt instrument not described in subparagraph (A) or (B), the term \"date of original issue\" means the date on which the debt instrument was issued in a sale or exchange.")
rule DateOfOriginalIssueOtherRule(instr: DebtInstrument, on: Date) defeasible {
    label en official "section 1275(a)(2)(C): a publicly offered instrument is (A); a non-public instrument not issued for property is (B); the rest are (C)";
    when issued_for_property(instr);
    when not_known(publicly_offered(instr));
    when date_issued_in_sale_or_exchange(instr, on);
    then date_of_original_issue(instr, on);
}
pub relation annuity_contract_under_section_72(instr: DebtInstrument) kind empirical {
    label en official "section 1275(a)(1)(B): the instrument is an annuity contract to which section 72 applies";
}
pub relation annuity_depends_on_life_expectancy(instr: DebtInstrument) kind empirical {
    label en official "section 1275(a)(1)(B)(i): the contract depends in whole or in substantial part on the life expectancy of one or more individuals";
}
pub relation annuity_issued_by_insurer_in_qualifying_transaction(instr: DebtInstrument) kind empirical {
    label en official "section 1275(a)(1)(B)(ii): issued by a section-subchapter-L insurance company (or an exempt entity that would be) in a transaction (I) with only cash or another such annuity as consideration, (II) on the exercise of a death-benefit election, or (III) involving a qualified pension or benefit plan";
}
pub relation excluded_from_debt_instrument_1275a1b(instr: DebtInstrument) kind institutional {
    label en official "section 1275(a)(1)(B): the annuity contract is not a debt instrument";
}
@source(IRC_S1275_A, relation = formalizes, coverage = partial, quote = "The term \"debt instrument\" shall not include any annuity contract to which section 72 applies and which—")
rule AnnuityExcludedRule(instr: DebtInstrument) defeasible {
    label en official "section 1275(a)(1)(B)(i)-(ii)";
    when annuity_contract_under_section_72(instr);
    when annuity_depends_on_life_expectancy(instr);
    when annuity_issued_by_insurer_in_qualifying_transaction(instr);
    then excluded_from_debt_instrument_1275a1b(instr);
}
pub relation distributed_debt_obligation_of_corporation_with_respect_to_stock(instr: DebtInstrument) kind empirical {
    label en official "section 1275(a)(4): a debt obligation of a corporation distributed by the corporation with respect to its stock";
}
pub relation treated_as_issued_for_property_1275a4(instr: DebtInstrument) kind institutional {
    label en official "section 1275(a)(4): treated as if issued by the corporation for property";
}
@source(IRC_S1275_A, relation = formalizes, coverage = exact, quote = "Any debt obligation of a corporation distributed by such corporation with respect to its stock shall be treated as if it had been issued by such corporation for property.")
rule DistributedObligationIssuedForPropertyRule(instr: DebtInstrument) defeasible {
    label en official "section 1275(a)(4)";
    when distributed_debt_obligation_of_corporation_with_respect_to_stock(instr);
    then treated_as_issued_for_property_1275a4(instr);
}
pub relation obligor_uses_cash_method(instr: DebtInstrument) kind empirical {
    label en official "section 1275(b)(2)(B): the obligor uses the cash receipts and disbursements method of accounting";
}
pub relation incurred_in_connection_with_personal_use_property(instr: DebtInstrument) kind empirical {
    label en official "section 1275(b)(2)(A)(i): incurred in connection with the acquisition or carrying of personal use property";
}
pub relation oid_deductible_only_when_paid_1275b2(instr: DebtInstrument) kind institutional {
    label en official "section 1275(b)(2): notwithstanding section 163(e), the original issue discount is deductible only when paid";
}
@source(IRC_S1275_B, relation = formalizes, coverage = exact, quote = "notwithstanding section 163(e), the original issue discount on such instrument shall be deductible only when paid.")
rule OidDeductibleWhenPaidRule(instr: DebtInstrument, oid: Money) defeasible {
    label en official "section 1275(b)(2)(A)-(B)";
    when incurred_in_connection_with_personal_use_property(instr);
    when original_issue_discount(instr, oid);
    when oid > 0.00 USD;
    when obligor_uses_cash_method(instr);
    then oid_deductible_only_when_paid_1275b2(instr);
}
pub relation publicly_offered_oid_issue_1275c2(instr: DebtInstrument) kind institutional {
    label en official "section 1275(c)(2): an issue of publicly offered debt instruments having original issue discount (the (c)(3) exception for the section 1272(a)(2) obligations is applied)";
}
@source(IRC_S1275_C, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any obligation referred to in section 1272(a)(2) (relating to exceptions from current inclusion of original issue discount).")
rule PubliclyOfferedOidIssueRule(instr: DebtInstrument, oid: Money) defeasible {
    label en official "section 1275(c)(2), (c)(3)";
    when publicly_offered(instr);
    when original_issue_discount(instr, oid);
    when oid > 0.00 USD;
    when not_known(oid_current_inclusion_excepted(instr));
    then publicly_offered_oid_issue_1275c2(instr);
}
pub relation issuer_of_debt_instrument(instr: DebtInstrument, issuer: Person) kind empirical {
    label en official "the issuer of the debt instrument (the person making a public offering of stripped bonds or coupons is treated as the issuer, section 1275(c)(2))";
}
pub relation issuer_furnished_oid_information_to_secretary(instr: DebtInstrument, issuer: Person) kind empirical {
    label en official "section 1275(c)(2)(A)-(C): the issuer furnished the Secretary the amount of the original issue discount, the issue date and other information required by regulation";
}
@source(IRC_S1275_C, relation = formalizes, coverage = exact, quote = "In the case of any issue of publicly offered debt instruments having original issue discount, the issuer shall (at such time and in such manner as the Secretary shall by regulation prescribe) furnish the Secretary the following information:")
rule IssuerInformationDuty(instr: DebtInstrument, issuer: Person) defeasible {
    label en official "section 1275(c)(2): the issuer shall furnish the information; the time and manner are prescribed by regulation (EXTERNAL_DEPENDENCY), so the window is unbounded";
    when publicly_offered_oid_issue_1275c2(instr);
    when issuer_of_debt_instrument(instr, issuer);
    then duty IssuerOidInformationDuty {
        bearer issuer;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition issuer_furnished_oid_information_to_secretary(instr, issuer);
            window [-infinity, infinity];
        }
    };
}
pub relation person_makes_public_offering_of_stripped_bonds(instr: DebtInstrument, person: Person) kind empirical {
    label en official "section 1275(c)(2), last sentence: the person makes a public offering of stripped bonds or stripped coupons";
}
@source(IRC_S1275_C, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, any person who makes a public offering of stripped bonds (or stripped coupons) shall be treated as the issuer of a publicly offered debt instrument having original issue discount.")
rule StrippedOfferorIsIssuerRule(instr: DebtInstrument, person: Person) defeasible {
    label en official "section 1275(c)(2), last sentence";
    when person_makes_public_offering_of_stripped_bonds(instr, person);
    then issuer_of_debt_instrument(instr, person);
}
pub relation aggregate_payments_under_purchase_agreement(instr: DebtInstrument, payment_no: Integer, amount: Money) kind empirical {
    label en official "section 1273(c)(1): a payment made by the purchaser under the purchase agreement, including modifications of it";
}
pub relation price_paid_by_first_buyer_including_modifications(instr: DebtInstrument, total: Money) kind institutional {
    label en official "section 1273(c)(1): the price paid by the first buyer includes the aggregate payments under the purchase agreement, including modifications";
}
@source(IRC_S1273_C, relation = formalizes, coverage = exact, quote = "The terms \"initial offering price\" and \"price paid by the first buyer\" include the aggregate payments made by the purchaser under the purchase agreement, including modifications thereof.")
rule FirstBuyerPriceIncludesAggregatePaymentsRule(instr: DebtInstrument, n: Integer, first: Money) defeasible {
    label en official "section 1273(c)(1): a sum over the case's empirical payments";
    when aggregate_payments_under_purchase_agreement(instr, n, first);
    then price_paid_by_first_buyer_including_modifications(instr, sum all amount: Money for k: Integer where aggregate_payments_under_purchase_agreement(instr, k, amount));
}
pub entity InvestmentUnit {
    label en official "a debt instrument and an option, security or other property issued together as an investment unit (section 1273(c)(2))";
}
pub relation unit_issue_price(unit: InvestmentUnit, amount: Money) kind empirical {
    label en official "section 1273(c)(2)(A): the issue price of the unit determined under subsections (b) and (c) as if the unit were a debt instrument";
}
pub relation unit_element_fair_market_value(unit: InvestmentUnit, element: Asset, dollars: Decimal) kind empirical {
    label en official "section 1273(c)(2)(B): the fair market value of an element of the unit, in dollars (a Decimal so that the ratio of two values is expressible)";
}
pub relation unit_total_fair_market_value(unit: InvestmentUnit, dollars: Decimal) kind empirical {
    label en official "section 1273(c)(2)(B): the fair market value of all elements in the unit, in dollars";
}
pub relation unit_element_issue_price(unit: InvestmentUnit, element: Asset, amount: Money) kind institutional {
    label en official "section 1273(c)(2)(B)-(C): the portion of the unit's issue price allocated to the element by relative fair market value (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1273_C, relation = formalizes, coverage = exact, quote = "(B) the issue price determined for such unit shall be allocated to each element of such unit on the basis of the relationship of the fair market value of such element to the fair market value of all elements in such unit, and")
rule UnitElementIssuePriceRule(unit: InvestmentUnit, element: Asset, price: Money, part: Decimal, total: Decimal) defeasible {
    label en official "section 1273(c)(2)(B)";
    when unit_issue_price(unit, price);
    when unit_element_fair_market_value(unit, element, part);
    when unit_total_fair_market_value(unit, total);
    when total > 0.00;
    then unit_element_issue_price(unit, element, div_round(price * part, total, 2, "HALF_UP"));
}

// =============================================================================
// §1272: the remaining subsections that do not need the multi-period ledger
// =============================================================================

pub relation holder_is_life_insurance_company_811b(holder: Person) kind empirical {
    label en official "section 1272(b)(2): the holder is a life insurance company to which section 811(b) applies";
}
pub relation life_insurance_company_holder_excepted_1272b2(instr: DebtInstrument, holder: Person) kind institutional {
    label en official "section 1272(b)(2): current inclusion of original issue discount does not apply to the life insurance company holder";
}
pub relation instrument_held_by(instr: DebtInstrument, holder: Person) kind empirical {
    label en official "the person holds the debt instrument";
}
@source(IRC_S1272_B, relation = formalizes, coverage = exact, quote = "(2) which is a life insurance company to which section 811(b) applies.")
rule LifeInsuranceHolderExceptedRule(instr: DebtInstrument, holder: Person) defeasible {
    label en official "section 1272(b)(2)";
    when instrument_held_by(instr, holder);
    when holder_is_life_insurance_company_811b(holder);
    then life_insurance_company_holder_excepted_1272b2(instr, holder);
}
rule OidExceptedFromLifeInsuranceHolderRule(instr: DebtInstrument, holder: Person) defeasible {
    label en official "section 1272(b)(2) feeds the section 1272(a)(2) family of exceptions";
    when life_insurance_company_holder_excepted_1272b2(instr, holder);
    then oid_current_inclusion_excepted(instr);
}
pub relation acquisition_of_debt_instrument(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "section 1272(c)(1)(A): the person acquired the debt instrument";
}
pub relation basis_determined_by_reference_to_transferor_basis(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "section 1272(c)(1)(B): the basis of the instrument is determined in whole or in part by reference to its adjusted basis in the hands of the person from whom acquired";
}
pub relation purchase_1272c1(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "section 1272(c)(1): a purchase";
}
@source(IRC_S1272_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"purchase\" means—")
rule PurchaseRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1272(c)(1)(A)-(B)";
    when acquisition_of_debt_instrument(holder, instr);
    when not_known(basis_determined_by_reference_to_transferor_basis(holder, instr));
    then purchase_1272c1(holder, instr);
}
// (a)(1): inclusion of the daily portions
pub relation daily_portion_of_oid(instr: DebtInstrument, day: Date, amount: Money) kind empirical {
    label en official "section 1272(a)(1), (3): the daily portion of the original issue discount for the day (the ratable portion of the increase in adjusted issue price over the accrual period)";
}
pub relation holder_held_on_day(holder: Person, instr: DebtInstrument, day: Date) kind empirical {
    label en official "section 1272(a)(1): the holder held the debt instrument on the day";
}
pub relation taxable_year_span_1272(holder: Person, y: TaxableYear, first_day: Date, last_day: Date) kind empirical {
    label en official "the first and last days of the holder's taxable year";
}
pub relation oid_daily_portion_included_for_day(holder: Person, instr: DebtInstrument, y: TaxableYear, day: Date, amount: Money) kind institutional {
    label en official "section 1272(a)(1): the daily portion of a day of the taxable year on which the holder held the instrument";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "For purposes of this title, there shall be included in the gross income of the holder of any debt instrument having original issue discount, an amount equal to the sum of the daily portions of the original issue discount for each day during the taxable year on which such holder held such debt instrument.")
rule OidDailyPortionIncludedRule(holder: Person, instr: DebtInstrument, y: TaxableYear, day: Date, first_day: Date, last_day: Date, amount: Money) defeasible {
    label en official "section 1272(a)(1): a day of the year on which the holder held the instrument";
    when holder_held_on_day(holder, instr, day);
    when taxable_year_span_1272(holder, y, first_day, last_day);
    when day >= first_day;
    when day <= last_day;
    when daily_portion_of_oid(instr, day, amount);
    when not_known(oid_current_inclusion_excepted(instr));
    then oid_daily_portion_included_for_day(holder, instr, y, day, amount);
}
pub relation oid_inclusion_for_year_1272a1(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1272(a)(1): the sum of the daily portions for the year (an aggregate over a derived relation: the section 111 runtime subset limit, expected NEITHER until it is lifted)";
}
rule OidInclusionForYearRule(holder: Person, instr: DebtInstrument, y: TaxableYear) defeasible {
    label en official "section 1272(a)(1): the sum over the days";
    when instrument_held_by(instr, holder);
    when oid_daily_portion_year_marker(holder, y);
    then oid_inclusion_for_year_1272a1(holder, instr, y, sum all amount: Money for day: Date where oid_daily_portion_included_for_day(holder, instr, y, day, amount));
}
pub relation oid_daily_portion_year_marker(holder: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year for which the inclusion is asked";
}
// (a)(6): the prepayment-sensitive variant
pub relation remaining_payments_present_value_1272a6(instr: DebtInstrument, period: Integer, amount: Money) kind empirical {
    label en official "section 1272(a)(6)(A)(i)(I): the present value (original yield to maturity, events before the close of the period, prepayment assumption) of all remaining payments at the close of the accrual period (computed by the case)";
}
pub relation payments_in_accrual_period_1272a6(instr: DebtInstrument, period: Integer, amount: Money) kind empirical {
    label en official "section 1272(a)(6)(A)(i)(II): the payments during the accrual period of amounts included in the stated redemption price";
}
pub relation days_in_accrual_period(instr: DebtInstrument, period: Integer, days: Integer) kind empirical {
    label en official "the number of days in the accrual period";
}
pub relation prepayment_sensitive_instrument_1272a6c(instr: DebtInstrument) kind institutional {
    label en official "section 1272(a)(6)(C): a debt instrument to which paragraph (6) applies";
}
pub relation regular_interest_in_remic_or_qualified_mortgage(instr: DebtInstrument) kind empirical {
    label en official "section 1272(a)(6)(C)(i): a regular interest in a REMIC or a qualified mortgage held by a REMIC";
}
pub relation payments_accelerable_by_prepayment_of_securing_obligations(instr: DebtInstrument) kind empirical {
    label en official "section 1272(a)(6)(C)(ii): payments may be accelerated by prepayments of other obligations securing the instrument (or, to the extent provided in regulations, by other events)";
}
pub relation pool_of_instruments_yield_affected_by_prepayments(instr: DebtInstrument) kind empirical {
    label en official "section 1272(a)(6)(C)(iii): a pool of debt instruments the yield on which may be affected by prepayments";
}
pub relation small_retailer_ordinary_course_instrument_excepted_by_regulation(instr: DebtInstrument) kind empirical {
    label en official "section 1272(a)(6)(C), last sentence: to the extent provided in regulations, a small retailer's instrument incurred in the ordinary course of retail sales of tangible personal property while held by that business (EXTERNAL_DEPENDENCY: regulations)";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "(i) any regular interest in a REMIC or qualified mortgage held by a REMIC,")
rule PrepaymentSensitiveRemicRule(instr: DebtInstrument) defeasible {
    label en official "section 1272(a)(6)(C)(i)";
    when regular_interest_in_remic_or_qualified_mortgage(instr);
    then prepayment_sensitive_instrument_1272a6c(instr);
}
rule PrepaymentSensitiveAcceleratedRule(instr: DebtInstrument) defeasible {
    label en official "section 1272(a)(6)(C)(ii)";
    when payments_accelerable_by_prepayment_of_securing_obligations(instr);
    then prepayment_sensitive_instrument_1272a6c(instr);
}
rule PrepaymentSensitivePoolRule(instr: DebtInstrument) defeasible {
    label en official "section 1272(a)(6)(C)(iii), except a small retailer's instrument as provided by regulation";
    when pool_of_instruments_yield_affected_by_prepayments(instr);
    when not_known(small_retailer_ordinary_course_instrument_excepted_by_regulation(instr));
    then prepayment_sensitive_instrument_1272a6c(instr);
}
pub relation daily_portion_prepayment_variant(instr: DebtInstrument, period: Integer, amount: Money) kind institutional {
    label en official "section 1272(a)(6)(A): the daily portion - each day's ratable portion of the excess of (i) the present value of remaining payments plus payments in the period over (ii) the adjusted issue price at the beginning of the period (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "(ii) the adjusted issue price of such debt instrument at the beginning of such period.")
rule DailyPortionPrepaymentVariantRule(instr: DebtInstrument, period: Integer, pv: Money, paid: Money, start: Money, days: Integer) defeasible {
    label en official "section 1272(a)(6)(A)(i)-(ii); a zero or negative excess allocates nothing";
    when prepayment_sensitive_instrument_1272a6c(instr);
    when remaining_payments_present_value_1272a6(instr, period, pv);
    when payments_in_accrual_period_1272a6(instr, period, paid);
    when adjusted_issue_price_at_start_of_period(instr, period, start);
    when days_in_accrual_period(instr, period, days);
    when days > 0;
    when pv + paid > start;
    then daily_portion_prepayment_variant(instr, period, div_round(pv + paid - start, days * 1.00, 2, "HALF_UP"));
}
// (a)(7): the subsequent-holder acquisition premium
pub relation purchaser_cost_after_original_issue(instr: DebtInstrument, holder: Person, dollars: Decimal) kind empirical {
    label en official "section 1272(a)(7)(B)(i)(I): the cost of the debt instrument incurred by the purchaser";
}
pub relation issue_price_plus_previously_included_oid(instr: DebtInstrument, dollars: Decimal) kind empirical {
    label en official "section 1272(a)(7)(B)(i)(II): the issue price increased by the portion of original issue discount previously includible by any holder (computed without regard to paragraph (7))";
}
pub relation sum_of_daily_portions_after_purchase(instr: DebtInstrument, dollars: Decimal) kind empirical {
    label en official "section 1272(a)(7)(B)(ii): the sum of the daily portions for all days after the purchase date to the stated maturity date (computed without regard to paragraph (7))";
}
pub relation acquisition_premium_fraction(instr: DebtInstrument, holder: Person, fraction: Decimal) kind institutional {
    label en official "section 1272(a)(7)(B): the excess of cost over the adjusted issue price at purchase, divided by the sum of the later daily portions";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "(i) the numerator of which is the excess (if any) of—")
rule AcquisitionPremiumFractionRule(instr: DebtInstrument, holder: Person, cost: Decimal, aip: Decimal, denom: Decimal) defeasible {
    label en official "section 1272(a)(7)(B) (a zero numerator when the cost does not exceed the adjusted issue price)";
    when purchase_1272c1(holder, instr);
    when purchaser_cost_after_original_issue(instr, holder, cost);
    when issue_price_plus_previously_included_oid(instr, aip);
    when sum_of_daily_portions_after_purchase(instr, denom);
    when cost > aip;
    when denom > 0.00;
    then acquisition_premium_fraction(instr, holder, div_round(cost - aip, denom, 8, "HALF_UP"));
}
pub relation reduced_daily_portion_1272a7(instr: DebtInstrument, holder: Person, day: Date, amount: Money) kind institutional {
    label en official "section 1272(a)(7)(A): the daily portion reduced by the daily portion multiplied by the fraction (cents HALF_UP: JUDGMENT CALL)";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, in the case of any purchase after its original issue of a debt instrument to which this subsection applies, the daily portion for any day shall be reduced by an amount equal to the amount which would be the daily portion for such day (without regard to this paragraph) multiplied by the fraction determined under subparagraph (B).")
rule ReducedDailyPortionRule(instr: DebtInstrument, holder: Person, day: Date, daily: Money, fraction: Decimal) defeasible {
    label en official "section 1272(a)(7)(A)";
    when acquisition_premium_fraction(instr, holder, fraction);
    when holder_held_on_day(holder, instr, day);
    when daily_portion_of_oid(instr, day, daily);
    then reduced_daily_portion_1272a7(instr, holder, day, round(daily - daily * fraction, 2, "HALF_UP"));
}
