// Stage 2 (IRC-07, A05). Section 1239 (gain from sale of depreciable
// property between related persons — ordinary income), section 1244 (losses
// on small business stock — ordinary loss up to $50,000/$100,000), section
// 1256 (section 1256 contracts — mark to market, 60/40 character, hedging
// exception, mixed-straddle election) and section 1259 (constructive sales
// of appreciated financial positions, including the (c)(3) closed-
// transaction exception).
//
// Imports `us.irc.corporations` 0.1.0 for constructive stock ownership
// (section 1239(c)(2) cross-references section 267(c)); `Corporation` and
// `Partnership` are `Person` subtypes (`us.irc.core::persons.law`), so a
// controlled entity can be the `other` party of a section 1239 sale without
// a bridging type.

use self::{
    Asset,
    IRC_S1239_A,
    IRC_S1239_B,
    IRC_S1239_C,
    IRC_S1239_D,
    IRC_S1239_E,
    IRC_S1244_A,
    IRC_S1244_C,
    IRC_S1256_A,
    IRC_S1256_D,
    IRC_S1259_A,
    IRC_S1259_C,
    Person,
    TaxableYear,
    Transaction,
    closed_transaction_exception_disregards_1259c3,
    excluded_from_1259_1259b2,
    gain_recognized,
    hedging_transaction_1256e2,
    loss_recognized,
    nonpublic_sale_contract_exception_1259c2,
    sale_or_disposition,
};

type Corporation = us.irc.core::Corporation;
type Partnership = us.irc.core::Partnership;
type Trust = us.irc.core::Trust;
type Estate = us.irc.core::Estate;

// =============================================================================
// Section 1239: gain from sale of depreciable property between related persons
// =============================================================================

pub relation sale_or_exchange_to(t: Transaction, transferor: Person, transferee: Person) kind empirical {
    label en unofficial "the transferee (counterparty) of a sale or exchange transaction — case-asserted linkage to sale_or_disposition(t, transferor, ...)";
}
pub relation depreciable_in_hands_of_transferee(transferee: Person, a: Asset) kind empirical {
    label en official "section 1239(a): the property is, in the hands of the transferee, of a character subject to the section 167 depreciation allowance";
}

// --- (b)/(c)/(d): related persons ---

pub relation related_persons_1239(p: Person, other: Person) kind institutional {
    label en official "section 1239(b),(d): related persons, for purposes of section 1239(a)";
}

pub relation controlling_stock_ownership_1239(p: Person, corp: Corporation, share: Decimal) kind institutional {
    label en unofficial "section 1239(c)(1)(A),(2): the aggregate share of a corporation's outstanding stock (by value) owned, directly or indirectly under rules similar to section 267(c) (other than paragraph (3)), by or for the person — summed from us.irc.corporations::constructive_ownership, itself section 318(a)-based; section 267(c) and section 318(a) differ in several particulars (e.g. section 267(c)(4)'s family class is narrower than section 318(a)(1)(A)(ii)) which this stage does not distinguish, an INTERPRETATION judgment call, not a fabricated fact";
}
@source(IRC_S1239_C, quote = "For purposes of this section, ownership shall be determined in accordance with rules similar to the rules under section 267(c) (other than paragraph (3) thereof).")
rule ControllingStockOwnership1239Rule(p: Person, corp: Corporation, share0: Decimal, via0: us.irc.corporations::AttributionKind) defeasible {
    label en unofficial "sums this package's section 318(a)-derived constructive_ownership as an approximation of section 267(c) ownership (see the relation's own note)";
    when us.irc.corporations::constructive_ownership(p, corp, share0, via0);
    then controlling_stock_ownership_1239(p, corp,
        sum all share: Decimal for via: us.irc.corporations::AttributionKind where us.irc.corporations::constructive_ownership(p, corp, share, via));
}
@source(IRC_S1239_C, quote = "a corporation more than 50 percent of the value of the outstanding stock of which is owned (directly or indirectly) by or for such person,")
rule ControlledCorporationFromStockOwnershipRule(p: Person, corp: Corporation, share: Decimal) defeasible {
    label en official "section 1239(c)(1)(A): a corporation more than 50 percent of whose outstanding stock (by value) is owned, directly or indirectly, by or for the person is a controlled entity, hence a related person";
    when controlling_stock_ownership_1239(p, corp, share);
    when share > 0.50;
    then related_persons_1239(p, corp);
}

pub relation partnership_capital_or_profits_interest(p: Person, partnership: Partnership, share: Decimal) kind empirical {
    label en unofficial "section 1239(c)(1)(B): the person's capital interest or profits interest in the partnership, owned directly or indirectly (section 267(c) rules) — asserted directly as a case fact this stage (TECH_GAP: no section 267(c)-style attribution construct for partnership interests, distinct from the section 318(a) stock-attribution construct this package reuses for corporations above)";
}
@source(IRC_S1239_C, quote = "a partnership more than 50 percent of the capital interest or profits interest in which is owned (directly or indirectly) by or for such person, and")
rule ControlledPartnershipFromInterestRule(p: Person, partnership: Partnership, share: Decimal) defeasible {
    label en official "section 1239(c)(1)(B): a partnership more than 50 percent of whose capital or profits interest is owned, directly or indirectly, by or for the person is a controlled entity, hence a related person";
    when partnership_capital_or_profits_interest(p, partnership, share);
    when share > 0.50;
    then related_persons_1239(p, partnership);
}

pub relation related_under_267b_class_1239c1c(p: Person, other: Person) kind institutional {
    label en unofficial "section 1239(c)(1)(C): a person related to the taxpayer under section 267(b)(3), (10), (11) or (12) — EXTERNAL_DEPENDENCY: section 267(b)'s own relationship classes are not this package's owner (definitions/corporations, pending dependency), asserted directly as a case fact this stage";
}
@source(IRC_S1239_C, quote = "any entity which is a related person to such person under paragraph (3), (10), (11), or (12) of section 267(b).")
rule ControlledEntity267bClassRule(p: Person, other: Person) strict {
    label en official "section 1239(c)(1)(C): a person related under section 267(b)(3),(10),(11),(12) is a controlled entity, hence a related person";
    when related_under_267b_class_1239c1c(p, other);
    then related_persons_1239(p, other);
}

pub relation trust_beneficiary_of(p: Person, t: Trust) kind empirical {
    label en official "the person (or the person's spouse) is a beneficiary of the trust (section 1239(b)(2))";
}
pub relation remote_contingent_interest_318a3bi(p: Person, t: Trust) kind empirical {
    label en official "the beneficiary's interest in the trust is a remote contingent interest within the meaning of section 318(a)(3)(B)(i) (section 1239(b)(2) exception)";
}
@source(IRC_S1239_B, quote = "a taxpayer and any trust in which such taxpayer (or his spouse) is a beneficiary, unless such beneficiary's interest in the trust is a remote contingent interest (within the meaning of section 318(a)(3)(B)(i)), and")
rule TaxpayerAndTrustBeneficiaryRelatedRule(p: Person, t: Trust) defeasible {
    label en official "section 1239(b)(2): a taxpayer and a trust in which the taxpayer (or spouse) is a beneficiary are related, unless the beneficial interest is a remote contingent interest";
    when trust_beneficiary_of(p, t);
    when not_known(remote_contingent_interest_318a3bi(p, t));
    then related_persons_1239(p, t);
}

pub relation executor_of(p: Person, e: Estate) kind empirical {
    label en official "the person is the executor of the estate (section 1239(b)(3))";
}
pub relation estate_beneficiary_1239(other: Person, e: Estate) kind empirical {
    label en official "the person is a beneficiary of the estate (section 1239(b)(3))";
}
pub relation sale_in_satisfaction_of_pecuniary_bequest(t: Transaction) kind empirical {
    label en official "the sale or exchange is in satisfaction of a pecuniary bequest (section 1239(b)(3) exception)";
}
@source(IRC_S1239_B, quote = "except in the case of a sale or exchange in satisfaction of a pecuniary bequest, an executor of an estate and a beneficiary of such estate.")
rule ExecutorAndBeneficiaryRelatedRule(p: Person, e: Estate, other: Person) strict {
    label en official "section 1239(b)(3): an executor of an estate and a beneficiary of the estate are related persons (the pecuniary-bequest exception is checked per transaction in the operative section 1239(a) rule below, since it exempts a specific sale, not the relatedness itself)";
    when executor_of(p, e);
    when estate_beneficiary_1239(other, e);
    then related_persons_1239(p, other);
}

// (d)(1) restates (b)'s tests with the "employer" standing in the generic
// "such person" role (b) already uses — the (b) rules above are already
// generic in their first argument, so no separate rule is needed to reach
// (employer, person-related-to-employer) pairs (an INTERPRETATION judgment
// call, not a gap: applying (b) with an employer bound to its first
// argument requires no new construct). (d)(2) adds a further related-person
// pair for welfare benefit funds controlled by (d)(1) persons.
pub relation welfare_benefit_fund_controlled_by(fund: Person, controller: Person) kind empirical {
    label en official "section 1239(d)(2): the welfare benefit fund (within the meaning of section 419(e)) is controlled, directly or indirectly, by the employer or a person related to the employer under (b)";
}
@source(IRC_S1239_D, quote = "a welfare benefit fund (within the meaning of section 419(e)) which is controlled directly or indirectly by persons referred to in paragraph (1).")
rule WelfareBenefitFundControlledRelatedRule(fund: Person, controller: Person) strict {
    label en official "section 1239(d)(2): an employer (or a person related to the employer under (b)) and a welfare benefit fund it controls are related persons";
    when welfare_benefit_fund_controlled_by(fund, controller);
    then related_persons_1239(controller, fund);
}

// --- (e): patent applications ---
pub relation patent_application(a: Asset) kind empirical {
    label en official "the property is a patent application (section 1239(e))";
}

// --- (a): the operative rule ---
pub relation section_1239_ordinary_income(p: Person, t: Transaction, amount: Money) kind institutional {
    label en official "section 1239(a): gain recognized to the transferor on a sale or exchange, directly or indirectly, of property between related persons is treated as ordinary income, if the property is, in the transferee's hands, of a character subject to the section 167 depreciation allowance";
}
@source(IRC_S1239_A, quote = "In the case of a sale or exchange of property, directly or indirectly, between related persons, any gain recognized to the transferor shall be treated as ordinary income if such property is, in the hands of the transferee, of a character which is subject to the allowance for depreciation provided in section 167.")
rule Section1239OrdinaryIncomeRule(p: Person, t: Transaction, other: Person, a: Asset, on: Date, amount: Money) defeasible {
    label en official "section 1239(a): gain on a sale or exchange between related persons is ordinary income where the property is depreciable in the transferee's hands, unless the sale is in satisfaction of a pecuniary bequest (b)(3)'s own exception";
    when sale_or_disposition(t, p, a, on);
    when sale_or_exchange_to(t, p, other);
    when related_persons_1239(p, other);
    when depreciable_in_hands_of_transferee(other, a);
    when gain_recognized(p, t, amount);
    when amount > 0.00 USD;
    when not_known(sale_in_satisfaction_of_pecuniary_bequest(t));
    then section_1239_ordinary_income(p, t, amount);
}
@source(IRC_S1239_E, quote = "For purposes of this section, a patent application shall be treated as property which, in the hands of the transferee, is of a character which is subject to the allowance for depreciation provided in section 167.")
rule Section1239OrdinaryIncomeForPatentApplicationRule(p: Person, t: Transaction, other: Person, a: Asset, on: Date, amount: Money) defeasible {
    label en official "section 1239(a),(e): gain on a sale or exchange of a patent application between related persons is ordinary income (the patent application is treated as depreciable in the transferee's hands regardless of the transferee's actual use of it)";
    when sale_or_disposition(t, p, a, on);
    when sale_or_exchange_to(t, p, other);
    when related_persons_1239(p, other);
    when patent_application(a);
    when gain_recognized(p, t, amount);
    when amount > 0.00 USD;
    when not_known(sale_in_satisfaction_of_pecuniary_bequest(t));
    then section_1239_ordinary_income(p, t, amount);
}

// =============================================================================
// Section 1244: losses on small business stock
// =============================================================================

pub const Section1244IndividualLossLimit: Money = 50000.00 USD {
    label en official "$50,000 (section 1244(b)(1))";
};
pub const Section1244JointReturnLossLimit: Money = 100000.00 USD {
    label en official "$100,000, in the case of a husband and wife filing a joint return (section 1244(b)(2))";
};
pub const Section1244SmallBusinessCorporationCapitalCeiling: Money = 1000000.00 USD {
    label en official "$1,000,000 (section 1244(c)(3)(A))";
};

pub relation section_1244_stock(a: Asset, corp: Corporation) kind institutional {
    label en official "section 1244(c)(1): stock in a domestic corporation meeting the small-business-corporation, money-or-property-issuance, and gross-receipts requirements";
}
pub relation domestic_corporation(corp: Corporation) kind empirical;
pub relation issued_for_money_or_property_other_than_stock_and_securities(a: Asset, corp: Corporation) kind empirical {
    label en official "section 1244(c)(1)(B): the stock was issued for money or other property (other than stock and securities)";
}
pub relation small_business_corporation_1244(corp: Corporation, on: Date) kind institutional {
    label en official "section 1244(c)(3)(A): the aggregate money and property received by the corporation for stock, as a contribution to capital, and as paid-in surplus, as of the time the stock in question was issued, does not exceed $1,000,000";
}
pub relation aggregate_capital_received_1244(corp: Corporation, on: Date, amount: Money) kind empirical {
    label en unofficial "section 1244(c)(3)(A)-(B): the aggregate amount of money and the adjusted basis (reduced by liabilities assumed) of other property received by the corporation for stock, as a contribution to capital, and as paid-in surplus, determined as of the time the stock in question was issued and including all stock theretofore issued";
}
@source(IRC_S1244_C, quote = "a corporation shall be treated as a small business corporation if the aggregate amount of money and other property received by the corporation for stock, as a contribution to capital, and as paid-in surplus, does not exceed $1,000,000.")
rule SmallBusinessCorporation1244Rule(corp: Corporation, on: Date, amount: Money) strict {
    label en official "section 1244(c)(3)(A): a corporation is a small business corporation if its aggregate capital received does not exceed $1,000,000";
    when aggregate_capital_received_1244(corp, on, amount);
    when amount <= Section1244SmallBusinessCorporationCapitalCeiling;
    then small_business_corporation_1244(corp, on);
}

pub relation gross_receipts_test_met_1244(corp: Corporation, sustained_on: Date) kind empirical {
    label en unofficial "section 1244(c)(1)(C),(2): more than 50 percent of the corporation's aggregate gross receipts for the applicable period (5 most recent taxable years ending before the loss was sustained, or the shorter existence-based substitute period of (c)(2)(A)) were derived from sources other than royalties, rents, dividends, interest, annuities, and stock/security sales or exchanges (gains only, per (c)(2)(B)) — the multi-year gross-receipts aggregation and the (c)(2)(C) deductions-exceed-gross-income nonapplication proviso are TECH_GAP (same multi-year-ledger class as TECH-GAPS.md G1/G24/G25: this stage takes the ultimate more-than-50%-test OUTCOME as a case-asserted fact rather than deriving it from year-by-year receipts)";
}
@source(IRC_S1244_C, quote = "such corporation, during the period of its 5 most recent taxable years ending before the date the loss on such stock was sustained, derived more than 50 percent of its aggregate gross receipts from sources other than royalties, rents, dividends, interests, annuities, and sales or exchanges of stocks or securities.")
rule Section1244StockRule(a: Asset, corp: Corporation, on: Date, issued_on: Date) defeasible {
    label en official "section 1244(c)(1): stock in a domestic corporation is section 1244 stock if issued to a small business corporation for money/property, and the corporation's gross-receipts test is met (or not yet applicable to a corporation asserting no disqualifying receipts)";
    when domestic_corporation(corp);
    when small_business_corporation_1244(corp, issued_on);
    when issued_for_money_or_property_other_than_stock_and_securities(a, corp);
    when gross_receipts_test_met_1244(corp, on);
    then section_1244_stock(a, corp);
}

pub relation section_1244_ordinary_loss(p: Person, t: Transaction, amount: Money) kind institutional {
    label en official "section 1244(a): the amount of a loss on section 1244 stock treated as an ordinary loss, capped by the section 1244(b) annual maximum";
}
pub relation joint_return_filed_1244(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "a husband and wife file a joint return for the year under section 6013 (section 1244(b)(2)) — pending typed dependency on us.irc.returns (WIRE-1's joint_return_filed contract)";
}
// section 1244(d)(4): an individual, for section 1244, excludes a trust or
// estate; the four ordinary-loss rules below read `not_known(is_trust_or_
// estate_1244(p))` directly (p already bound by `loss_recognized`) rather
// than through a separate `individual_1244` relation, which would leave p
// unbound in a standalone rule with no positive, finite-domain conjunct
// (LDC-E4101 range restriction). Source: IRC_S1244_D, "the term 'individual'
// does not include a trust or estate."
relation is_trust_or_estate_1244(p: Person) kind institutional;
rule IsTrustFor1244Rule(p: Trust) strict { when trust_entity_1244(p); then is_trust_or_estate_1244(p); }
relation trust_entity_1244(p: Trust) kind empirical {
    label en unofficial "guard: the person entity is a Trust (case-asserted, since entity-subtype tests are not otherwise queryable)";
}
rule IsEstateFor1244Rule(p: Estate) strict { when estate_entity_1244(p); then is_trust_or_estate_1244(p); }
relation estate_entity_1244(p: Estate) kind empirical {
    label en unofficial "guard: the person entity is an Estate (case-asserted)";
}

@source(IRC_S1244_A, quote = "In the case of an individual, a loss on section 1244 stock issued to such individual or to a partnership which would (but for this section) be treated as a loss from the sale or exchange of a capital asset shall, to the extent provided in this section, be treated as an ordinary loss.")
rule Section1244OrdinaryLossWithinJointLimitRule(p: Person, t: Transaction, y: TaxableYear, a: Asset, corp: Corporation, amount: Money) defeasible {
    label en official "section 1244(a),(b)(2): a loss on section 1244 stock is ordinary up to $100,000 for a joint return";
    when not_known(is_trust_or_estate_1244(p));
    when section_1244_stock(a, corp);
    when loss_recognized(p, t, amount);
    when us.irc.core::year_of(p, y);
    when joint_return_filed_1244(p, y);
    when amount <= Section1244JointReturnLossLimit;
    then section_1244_ordinary_loss(p, t, amount);
}
rule Section1244OrdinaryLossCappedAtJointLimitRule(p: Person, t: Transaction, y: TaxableYear, a: Asset, corp: Corporation, amount: Money) defeasible {
    label en official "section 1244(b)(2): a loss on section 1244 stock exceeding $100,000 for a joint return is ordinary only up to $100,000, the excess remaining a capital loss";
    when not_known(is_trust_or_estate_1244(p));
    when section_1244_stock(a, corp);
    when loss_recognized(p, t, amount);
    when us.irc.core::year_of(p, y);
    when joint_return_filed_1244(p, y);
    when amount > Section1244JointReturnLossLimit;
    then section_1244_ordinary_loss(p, t, Section1244JointReturnLossLimit);
}
rule Section1244OrdinaryLossWithinIndividualLimitRule(p: Person, t: Transaction, y: TaxableYear, a: Asset, corp: Corporation, amount: Money) defeasible {
    label en official "section 1244(a),(b)(1): a loss on section 1244 stock is ordinary up to $50,000 absent a joint return";
    when not_known(is_trust_or_estate_1244(p));
    when section_1244_stock(a, corp);
    when loss_recognized(p, t, amount);
    when us.irc.core::year_of(p, y);
    when not_known(joint_return_filed_1244(p, y));
    when amount <= Section1244IndividualLossLimit;
    then section_1244_ordinary_loss(p, t, amount);
}
rule Section1244OrdinaryLossCappedAtIndividualLimitRule(p: Person, t: Transaction, y: TaxableYear, a: Asset, corp: Corporation, amount: Money) defeasible {
    label en official "section 1244(b)(1): a loss on section 1244 stock exceeding $50,000 absent a joint return is ordinary only up to $50,000, the excess remaining a capital loss";
    when not_known(is_trust_or_estate_1244(p));
    when section_1244_stock(a, corp);
    when loss_recognized(p, t, amount);
    when us.irc.core::year_of(p, y);
    when not_known(joint_return_filed_1244(p, y));
    when amount > Section1244IndividualLossLimit;
    then section_1244_ordinary_loss(p, t, Section1244IndividualLossLimit);
}
// (d)(1)(A)-(B) contribution-basis-reduction special rules and (d)(2)
// recapitalization successor rules are TECH_GAP this stage (basis-shape
// bookkeeping layered on top of the ordinary-loss cap above, not attempted).

// =============================================================================
// Section 1256: section 1256 contracts marked to market
// =============================================================================

pub entity Section1256Contract : Asset {
    label en unofficial "any regulated futures contract, foreign currency contract, nonequity option, dealer equity option, or dealer securities futures contract (section 1256(b)(1)) — the (b)(2) swap exclusions and the securities-futures-contract-unless-dealer exclusion are read into whether a case asserts this subtype, not separately re-derived";
}
pub relation held_at_close_of_year(p: Person, c: Section1256Contract, y: TaxableYear) kind empirical {
    label en official "the section 1256 contract is held by the taxpayer at the close of the taxable year (section 1256(a)(1))";
}
pub relation fair_market_value_at_year_end(p: Person, c: Section1256Contract, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the section 1256 contract on the last business day of the taxable year (section 1256(a)(1))";
}
pub relation basis_at_year_end(p: Person, c: Section1256Contract, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer's basis in the section 1256 contract immediately before the deemed sale (case-asserted, prior-year-adjusted per (a)(2))";
}
pub relation identified_as_hedging_transaction(p: Person, c: Section1256Contract) kind empirical {
    label en official "section 1256(e)(2): before the close of the day entered into, the taxpayer clearly identifies the transaction as a hedging transaction (section 1221(b)(2)(A))";
}
pub relation section_1256_mark_to_market_gain(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(a)(1): gain from the deemed year-end sale of a section 1256 contract at its fair market value";
}
pub relation section_1256_mark_to_market_loss(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(a)(1): loss from the deemed year-end sale of a section 1256 contract at its fair market value";
}
@source(IRC_S1256_A, quote = "each section 1256 contract held by the taxpayer at the close of the taxable year shall be treated as sold for its fair market value on the last business day of such taxable year (and any gain or loss shall be taken into account for the taxable year),")
rule Section1256MarkToMarketGainRule(p: Person, c: Section1256Contract, y: TaxableYear, fmv: Money, basis: Money) defeasible {
    label en official "section 1256(a)(1): a year-end fair market value exceeding basis is mark-to-market gain, unless the contract is an identified hedging transaction";
    when held_at_close_of_year(p, c, y);
    when fair_market_value_at_year_end(p, c, y, fmv);
    when basis_at_year_end(p, c, y, basis);
    when not_known(identified_as_hedging_transaction(p, c));
    when not_known(hedging_transaction_1256e2(p, c));
    when fmv > basis;
    then section_1256_mark_to_market_gain(p, y, c, fmv - basis);
}
rule Section1256MarkToMarketLossRule(p: Person, c: Section1256Contract, y: TaxableYear, fmv: Money, basis: Money) defeasible {
    label en official "section 1256(a)(1): a year-end fair market value less than basis is mark-to-market loss, unless the contract is an identified hedging transaction";
    when held_at_close_of_year(p, c, y);
    when fair_market_value_at_year_end(p, c, y, fmv);
    when basis_at_year_end(p, c, y, basis);
    when not_known(identified_as_hedging_transaction(p, c));
    when not_known(hedging_transaction_1256e2(p, c));
    when fmv < basis;
    then section_1256_mark_to_market_loss(p, y, c, basis - fmv);
}

// (d): the mixed-straddle election, as a taxpayer power (defeasible model
// per the stage-1 judgment call log, wiring valid_when/effect/window here
// where stage 1 declined to for section 1033/1012(c)(2)(B)).
pub relation part_of_mixed_straddle(p: Person, c: Section1256Contract) kind empirical {
    label en official "section 1256(d)(4): the contract is part of a mixed straddle (section 1092(c)) at least one, but not all, of whose positions are section 1256 contracts, each position clearly identified before the close of the day the first section 1256 contract of the straddle is acquired";
}
pub relation elects_mixed_straddle_out_of_1256(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1256(d)(1): the taxpayer elects to have section 1256 not apply to all section 1256 contracts that are part of a mixed straddle";
}
pub relation mixed_straddle_election_timely_and_properly_made(p: Person, y: TaxableYear) kind empirical {
    label en official "section 1256(d)(2): the election is made at the time and in the manner the Secretary prescribes by regulations";
}
pub relation section_1256_mixed_straddle_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "section 1256(d)(3): the mixed-straddle election is in effect for the taxable year for which made and all subsequent years, unless the Secretary consents to revocation";
}
@source(IRC_S1256_D, quote = "The taxpayer may elect to have this section not to apply to all section 1256 contracts which are part of a mixed straddle.")
rule Section1256MixedStraddleElectionPower(p: Person, y: TaxableYear) strict {
    label en official "section 1256(d)(1): a taxpayer may elect out of mark-to-market treatment for section 1256 contracts that are part of a mixed straddle";
    when elects_mixed_straddle_out_of_1256(p, y);
    then power Section1256MixedStraddleElection {
        holder p;
        over y;
        exercise elects_mixed_straddle_out_of_1256(p, y);
        valid_when mixed_straddle_election_timely_and_properly_made(p, y);
        effect create(section_1256_mixed_straddle_election_in_effect(p, y));
        window [@1981-06-01, infinity);
    };
}

// (a)(3): 60/40 character. Suppressed where the mixed-straddle election is
// in effect for the year, or where the contract is an identified hedging
// transaction (mark-to-market itself does not apply, so there is no
// section 1256 gain/loss to characterize).
pub relation section_1256_short_term_character(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(a)(3)(A): 40 percent of section 1256 contract gain or loss treated as short-term capital gain or loss";
}
pub relation section_1256_long_term_character(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) kind institutional {
    label en official "section 1256(a)(3)(B): 60 percent of section 1256 contract gain or loss treated as long-term capital gain or loss";
}
pub const Section1256ShortTermFraction: Decimal = 0.40 {
    label en official "40 percent (section 1256(a)(3)(A))";
};
pub const Section1256LongTermFraction: Decimal = 0.60 {
    label en official "60 percent (section 1256(a)(3)(B))";
};
@source(IRC_S1256_A, quote = "short-term capital gain or loss, to the extent of 40 percent of such gain or loss, and")
rule Section1256GainShortTermCharacterRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(a)(3)(A): 40 percent of the mark-to-market gain is short-term capital gain";
    when section_1256_mark_to_market_gain(p, y, c, amount);
    when not_known(section_1256_mixed_straddle_election_in_effect(p, y));
    then section_1256_short_term_character(p, y, c, amount * Section1256ShortTermFraction);
}
@source(IRC_S1256_A, quote = "long-term capital gain or loss, to the extent of 60 percent of such gain or loss, and")
rule Section1256GainLongTermCharacterRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(a)(3)(B): 60 percent of the mark-to-market gain is long-term capital gain";
    when section_1256_mark_to_market_gain(p, y, c, amount);
    when not_known(section_1256_mixed_straddle_election_in_effect(p, y));
    then section_1256_long_term_character(p, y, c, amount * Section1256LongTermFraction);
}
rule Section1256LossShortTermCharacterRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(a)(3)(A): 40 percent of the mark-to-market loss is short-term capital loss";
    when section_1256_mark_to_market_loss(p, y, c, amount);
    when not_known(section_1256_mixed_straddle_election_in_effect(p, y));
    then section_1256_short_term_character(p, y, c, amount * Section1256ShortTermFraction);
}
rule Section1256LossLongTermCharacterRule(p: Person, y: TaxableYear, c: Section1256Contract, amount: Money) defeasible {
    label en official "section 1256(a)(3)(B): 60 percent of the mark-to-market loss is long-term capital loss";
    when section_1256_mark_to_market_loss(p, y, c, amount);
    when not_known(section_1256_mixed_straddle_election_in_effect(p, y));
    then section_1256_long_term_character(p, y, c, amount * Section1256LongTermFraction);
}
// (c) terminations, (e)(2)-(4) hedging, syndicates and the hedging-loss limit,
// (f) character and (g) the contract kinds: module 34 (stage 3).

// =============================================================================
// Section 1259: constructive sales of appreciated financial positions
// =============================================================================

pub entity AppreciatedFinancialPosition : Asset {
    label en official "section 1259(b): a position with respect to stock, a debt instrument, or a partnership interest that would produce gain if sold, assigned, or terminated at fair market value — the (b)(2) debt/hedge/marked-to-market exclusions are read into whether a case asserts this subtype";
}
pub relation would_produce_gain_at_fmv(p: Person, pos: AppreciatedFinancialPosition, amount: Money) kind empirical {
    label en official "section 1259(b)(1): there would be gain of the given amount were the position sold, assigned, or otherwise terminated at fair market value";
}

pub relation enters_short_sale_of_same_or_substantially_identical(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) kind empirical;
pub relation enters_offsetting_notional_principal_contract(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) kind empirical;
pub relation enters_futures_or_forward_to_deliver(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) kind empirical;
pub relation acquires_same_or_substantially_identical_property(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) kind empirical {
    label en official "section 1259(c)(1)(D): where the appreciated financial position is itself a short sale or a (B)/(C)-type contract, the taxpayer acquires the same or substantially identical property";
}

pub relation constructive_sale_transaction(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) kind institutional {
    label en unofficial "section 1259(c)(1): a transaction that, absent the (c)(3) closed-transaction exception, causes a constructive sale of the position";
}
@source(IRC_S1259_C, quote = "enters into a short sale of the same or substantially identical property,")
rule ConstructiveSaleFromShortSaleRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) strict {
    label en official "section 1259(c)(1)(A): entering a short sale of the same or substantially identical property";
    when enters_short_sale_of_same_or_substantially_identical(p, pos, t, on);
    then constructive_sale_transaction(p, pos, t, on);
}
@source(IRC_S1259_C, quote = "enters into an offsetting notional principal contract with respect to the same or substantially identical property,")
rule ConstructiveSaleFromNotionalPrincipalContractRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) strict {
    label en official "section 1259(c)(1)(B): entering an offsetting notional principal contract";
    when enters_offsetting_notional_principal_contract(p, pos, t, on);
    then constructive_sale_transaction(p, pos, t, on);
}
@source(IRC_S1259_C, quote = "enters into a futures or forward contract to deliver the same or substantially identical property,")
rule ConstructiveSaleFromFuturesOrForwardRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) strict {
    label en official "section 1259(c)(1)(C): entering a futures or forward contract to deliver the same or substantially identical property";
    when enters_futures_or_forward_to_deliver(p, pos, t, on);
    then constructive_sale_transaction(p, pos, t, on);
}
@source(IRC_S1259_C, quote = "acquires the same or substantially identical property, or")
rule ConstructiveSaleFromAcquisitionRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) strict {
    label en official "section 1259(c)(1)(D): acquiring the same or substantially identical property where the position itself is a short sale or a (B)/(C) contract";
    when acquires_same_or_substantially_identical_property(p, pos, t, on);
    then constructive_sale_transaction(p, pos, t, on);
}

// (c)(2): the nonpublicly-traded-property exception.
pub relation marketable_security_453f(pos: AppreciatedFinancialPosition) kind empirical {
    label en official "the position is a marketable security within the meaning of section 453(f) (section 1259(c)(2) exception scope)";
}
pub relation settles_within_1_year(t: Transaction) kind empirical;

// (c)(3)(A): the closed-transaction exception — exact 30-day/60-day windows.
pub relation transaction_closed_on(t: Transaction, on: Date) kind empirical {
    label en official "the date the transaction (which would otherwise cause a constructive sale) is closed";
}
pub relation held_throughout_60_day_period_from_close(p: Person, pos: AppreciatedFinancialPosition, closed_on: Date) kind empirical {
    label en official "section 1259(c)(3)(A)(ii): the taxpayer holds the appreciated financial position throughout the 60-day period beginning on the date the transaction is closed";
}
pub relation risk_of_loss_not_diminished_during_60_days(p: Person, pos: AppreciatedFinancialPosition, closed_on: Date) kind empirical {
    label en official "section 1259(c)(3)(A)(iii): at no time during the 60-day period is the taxpayer's risk of loss on the position reduced by a circumstance described in section 246(c)(4) (references to stock read as references to the position)";
}
pub relation closed_transaction_exception_applies(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, taxable_year_end: Date) kind institutional {
    label en official "section 1259(c)(3)(A): the closed-transaction exception disregards this transaction for purposes of constructive-sale treatment";
}
@source(IRC_S1259_C, quote = "such transaction is closed on or before the 30th day after the close of such taxable year,")
rule ClosedTransactionExceptionRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, closed_on: Date, y: TaxableYear, taxable_year_end: Date) defeasible {
    label en official "section 1259(c)(3)(A): a transaction closed within 30 days after the close of the taxable year, with the position held throughout the following 60 days and risk of loss not reduced during that period, is disregarded for constructive-sale purposes";
    when transaction_closed_on(t, closed_on);
    when us.irc.core::year_of(p, y);
    when us.irc.core::ends(y, taxable_year_end);
    when closed_on <= add_calendar_period(taxable_year_end, 30 calendar_day);
    when held_throughout_60_day_period_from_close(p, pos, closed_on);
    when risk_of_loss_not_diminished_during_60_days(p, pos, closed_on);
    then closed_transaction_exception_applies(p, pos, t, taxable_year_end);
}

pub relation constructive_sale_of_appreciated_financial_position(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) kind institutional {
    label en official "section 1259(c)(1): the taxpayer is treated as having made a constructive sale of the appreciated financial position, the (c)(3) closed-transaction exception not applying";
}
rule ConstructiveSaleAppliesRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) defeasible {
    label en official "section 1259(c)(1): a qualifying transaction causes a constructive sale unless the (c)(3) closed-transaction exception disregards it, and (for nonpublicly-traded property) unless the (c)(2) short-settlement exception applies";
    when constructive_sale_transaction(p, pos, t, on);
    when not_known(closed_transaction_exception_disregards_1259c3(p, pos, t));
    when not_known(excluded_from_1259_1259b2(pos));
    when not_known(nonpublic_sale_contract_exception_1259c2(t, pos));
    then constructive_sale_of_appreciated_financial_position(p, pos, t, on);
}

pub relation section_1259_gain_recognized(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, amount: Money) kind institutional {
    label en official "section 1259(a)(1): gain recognized as if the appreciated financial position were sold at its fair market value on the constructive-sale date";
}
@source(IRC_S1259_A, quote = "the taxpayer shall recognize gain as if such position were sold, assigned, or otherwise terminated at its fair market value on the date of such constructive sale (and any gain shall be taken into account for the taxable year which includes such date), and")
rule Section1259GainRecognizedRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date, amount: Money) defeasible {
    label en official "section 1259(a)(1): a constructive sale recognizes gain equal to the position's built-in gain at the constructive-sale date";
    when constructive_sale_of_appreciated_financial_position(p, pos, t, on);
    when would_produce_gain_at_fmv(p, pos, amount);
    then section_1259_gain_recognized(p, pos, t, amount);
}
// (a)(2)(A)-(B) the subsequent-adjustment and re-started-holding-period
// rules mirror section 1091(b)/(d)'s and section 1223's own basis/holding-
// period carryover shapes (module 04/module 05) and are TECH_GAP for the
// same reason as this package's other post-recognition basis bookkeeping:
// not separately re-derived this stage. (e) special rules (chained
// constructive sales, trust-interest-as-stock) are also TECH_GAP.
