// Section 1221 (capital asset defined), section 1222 (capital gain/loss
// terms) and section 1223 (holding period, including the tacking rules).



// =============================================================================
// Section 1221: capital asset defined
// =============================================================================

use self::{
    Asset,
    IRC_S1221_A,
    IRC_S1222,
    IRC_S1223,
    Person,
    TaxableYear,
    Transaction,
    decedent_died_on,
    decedent_property_basis,
    gain_recognized,
    like_kind_exchange,
    loss_recognized,
    sale_or_disposition,
    substituted_basis_from,
};

pub relation held_by(p: Person, a: Asset) kind empirical {
    label en unofficial "the asset is held by the person, for purposes of the section 1221(a) capital-asset test";
}
pub relation inventory_or_stock_in_trade(a: Asset) kind empirical {
    label en official "stock in trade, or other property of a kind properly includible in inventory, or property held primarily for sale to customers in the ordinary course of trade or business (section 1221(a)(1))";
}
pub relation depreciable_trade_or_business_property_or_real_property(a: Asset) kind empirical {
    label en official "property used in the taxpayer's trade or business, of a character subject to the section 167 depreciation allowance, or real property used in the trade or business (section 1221(a)(2))";
}
pub relation self_created_copyright_or_similar_property(a: Asset, p: Person) kind empirical {
    label en official "a patent, invention, model, design, secret formula or process, copyright, or similar property, held by the taxpayer whose personal efforts created it, or a taxpayer described in section 1221(a)(3)(B)-(C) (section 1221(a)(3))";
}
pub relation ordinary_course_receivable(a: Asset) kind empirical {
    label en official "accounts or notes receivable acquired in the ordinary course of trade or business for services rendered or from a section 1221(a)(1) property sale (section 1221(a)(4))";
}
pub relation government_publication_received_free(a: Asset) kind empirical {
    label en official "a publication of the United States Government received other than by purchase at the public sale price, held by the recipient or a taxpayer whose basis is determined by reference to the recipient's basis (section 1221(a)(5))";
}
pub relation commodities_derivative_of_dealer_not_excepted(a: Asset) kind empirical {
    label en official "a commodities derivative financial instrument held by a commodities derivatives dealer, not excepted under section 1221(a)(6)(A)-(B)";
}
pub relation identified_hedging_transaction(a: Asset) kind empirical {
    label en official "a hedging transaction clearly identified as such before the close of the day acquired, originated, or entered into (section 1221(a)(7))";
}
pub relation supplies_consumed_in_ordinary_course(a: Asset) kind empirical {
    label en unofficial "supplies of a type regularly used or consumed by the taxpayer in the ordinary course of a trade or business (section 1221(a)(8))";
}
pub relation musical_composition_or_copyright_election(a: Asset, p: Person) kind empirical {
    label en official "the taxpayer elects, under section 1221(b)(3), to treat a self-created musical composition or copyright in a musical work as excluded from the (a)(1)/(a)(3) exclusions (i.e., treated as capable of being a capital asset)";
}

pub relation excluded_from_capital_asset(a: Asset, p: Person) kind institutional {
    label en unofficial "the asset falls within one of the section 1221(a) exclusions and so is NOT a capital asset";
}
@source(IRC_S1221_A, relation = formalizes, coverage = partial, quote = "stock in trade of the taxpayer or other property of a kind which would properly be included in the inventory of the taxpayer if on hand at the close of the taxable year, or property held by the taxpayer primarily for sale to customers in the ordinary course of his trade or business;")
rule ExcludedInventoryRule(a: Asset, p: Person) strict {
    label en official "section 1221(a)(1) exclusion";
    when held_by(p, a);
    when inventory_or_stock_in_trade(a);
    then excluded_from_capital_asset(a, p);
}
@source(IRC_S1221_A, relation = formalizes, coverage = partial, quote = "property, used in his trade or business, of a character which is subject to the allowance for depreciation provided in section 167, or real property used in his trade or business;")
rule ExcludedDepreciablePropertyRule(a: Asset, p: Person) strict {
    label en official "section 1221(a)(2) exclusion";
    when held_by(p, a);
    when depreciable_trade_or_business_property_or_real_property(a);
    then excluded_from_capital_asset(a, p);
}
@source(IRC_S1221_A, relation = formalizes, coverage = partial, quote = "a patent, invention, model or design (whether or not patented), a secret formula or process, a copyright, a literary, musical, or artistic composition, a letter or memorandum, or similar property, held by—")
rule ExcludedSelfCreatedCopyrightRule(a: Asset, p: Person) defeasible {
    label en official "section 1221(a)(3) exclusion, subject to the section 1221(b)(3) musical-composition election";
    when self_created_copyright_or_similar_property(a, p);
    when not_known(musical_composition_or_copyright_election(a, p));
    then excluded_from_capital_asset(a, p);
}
@source(IRC_S1221_A, relation = formalizes, coverage = partial, quote = "accounts or notes receivable acquired in the ordinary course of trade or business for services rendered or from the sale of property described in paragraph (1);")
rule ExcludedReceivableRule(a: Asset, p: Person) strict {
    label en official "section 1221(a)(4) exclusion";
    when held_by(p, a);
    when ordinary_course_receivable(a);
    then excluded_from_capital_asset(a, p);
}
@source(IRC_S1221_A, relation = formalizes, coverage = partial, quote = "a publication of the United States Government (including the Congressional Record) which is received from the United States Government or any agency thereof, other than by purchase at the price at which it is offered for sale to the public, and which is held by—")
rule ExcludedGovernmentPublicationRule(a: Asset, p: Person) strict {
    label en official "section 1221(a)(5) exclusion";
    when held_by(p, a);
    when government_publication_received_free(a);
    then excluded_from_capital_asset(a, p);
}
@source(IRC_S1221_A, relation = formalizes, coverage = partial, quote = "any commodities derivative financial instrument held by a commodities derivatives dealer, unless—")
rule ExcludedCommoditiesDerivativeRule(a: Asset, p: Person) strict {
    label en official "section 1221(a)(6) exclusion";
    when held_by(p, a);
    when commodities_derivative_of_dealer_not_excepted(a);
    then excluded_from_capital_asset(a, p);
}
@source(IRC_S1221_A, relation = formalizes, coverage = partial, quote = "any hedging transaction which is clearly identified as such before the close of the day on which it was acquired, originated, or entered into (or such other time as the Secretary may by regulations prescribe); or")
rule ExcludedHedgingTransactionRule(a: Asset, p: Person) strict {
    label en official "section 1221(a)(7) exclusion";
    when held_by(p, a);
    when identified_hedging_transaction(a);
    then excluded_from_capital_asset(a, p);
}
@source(IRC_S1221_A, relation = formalizes, coverage = partial, quote = "supplies of a type regularly used or consumed by the taxpayer in the ordinary course of a trade or business of the taxpayer.")
rule ExcludedSuppliesRule(a: Asset, p: Person) strict {
    label en official "section 1221(a)(8) exclusion";
    when held_by(p, a);
    when supplies_consumed_in_ordinary_course(a);
    then excluded_from_capital_asset(a, p);
}

pub relation capital_asset(p: Person, a: Asset) kind institutional {
    label en official "section 1221(a): property held by the taxpayer (whether or not connected with a trade or business) that is not within one of the eight named exclusions";
}
@source(IRC_S1221_A, quote = "For purposes of this subtitle, the term \"capital asset\" means property held by the taxpayer (whether or not connected with his trade or business), but does not include—")
rule CapitalAssetDefaultRule(p: Person, a: Asset) defeasible {
    label en official "section 1221(a): property held by the taxpayer is a capital asset unless excluded";
    when held_by(p, a);
    when not_known(excluded_from_capital_asset(a, p));
    then capital_asset(p, a);
}

// =============================================================================
// Section 1222: capital gain/loss definitions
// =============================================================================
//
// All eleven paragraphs are computations over case-asserted per-transaction
// sale/exchange gains and losses of capital assets, aggregated for the
// taxable year. `long_term`/`short_term` (module import from section 1223)
// classify each transaction; the year's short-term and long-term gain/loss
// totals are `sum all` aggregates over transaction-level facts.

pub relation capital_gain_or_loss_transaction(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money, is_gain: Boolean) kind institutional {
    label en unofficial "a per-transaction capital gain (is_gain=true) or loss (is_gain=false) from the sale or exchange of a capital asset, taken into account in gross/taxable income for the year (bridges gain_recognized/loss_recognized on capital-asset transactions into the section 1222 aggregates)";
}
rule CapitalGainTransactionFromRecognizedGainRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money, on: Date) defeasible {
    label en unofficial "a recognized gain on a capital-asset sale or exchange is a section 1222 capital gain transaction";
    when sale_or_disposition(t, p, a, on);
    when capital_asset(p, a);
    when gain_recognized(p, t, amount);
    when amount > 0.00 USD;
    when us.irc.core::year_of(p, y);
    then capital_gain_or_loss_transaction(p, y, t, a, amount, true);
}
rule CapitalLossTransactionFromRecognizedLossRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money, on: Date) defeasible {
    label en unofficial "a recognized loss on a capital-asset sale or exchange is a section 1222 capital loss transaction";
    when sale_or_disposition(t, p, a, on);
    when capital_asset(p, a);
    when loss_recognized(p, t, amount);
    when amount > 0.00 USD;
    when us.irc.core::year_of(p, y);
    then capital_gain_or_loss_transaction(p, y, t, a, amount, false);
}

pub relation short_term_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "short-term capital gain: gain from the sale or exchange of a capital asset held for not more than 1 year (section 1222(1))";
}
pub relation short_term_capital_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "short-term capital loss: loss from the sale or exchange of a capital asset held for not more than 1 year (section 1222(2))";
}
pub relation long_term_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "long-term capital gain: gain from the sale or exchange of a capital asset held for more than 1 year (section 1222(3))";
}
pub relation long_term_capital_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "long-term capital loss: loss from the sale or exchange of a capital asset held for more than 1 year (section 1222(4))";
}

@source(IRC_S1222, quote = "The term \"short-term capital gain\" means gain from the sale or exchange of a capital asset held for not more than 1 year")
rule ShortTermCapitalGainAggregateRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money) defeasible {
    label en official "section 1222(1)";
    when capital_gain_or_loss_transaction(p, y, t, a, amount, true);
    when not_known(long_term(p, a));
    then short_term_capital_gain(p, y, amount);
}
@source(IRC_S1222, quote = "The term \"short-term capital loss\" means loss from the sale or exchange of a capital asset held for not more than 1 year")
rule ShortTermCapitalLossAggregateRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money) defeasible {
    label en official "section 1222(2)";
    when capital_gain_or_loss_transaction(p, y, t, a, amount, false);
    when not_known(long_term(p, a));
    then short_term_capital_loss(p, y, amount);
}
@source(IRC_S1222, quote = "The term \"long-term capital gain\" means gain from the sale or exchange of a capital asset held for more than 1 year")
rule LongTermCapitalGainAggregateRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money) defeasible {
    label en official "section 1222(3)";
    when capital_gain_or_loss_transaction(p, y, t, a, amount, true);
    when long_term(p, a);
    then long_term_capital_gain(p, y, amount);
}
@source(IRC_S1222, quote = "The term \"long-term capital loss\" means loss from the sale or exchange of a capital asset held for more than 1 year")
rule LongTermCapitalLossAggregateRule(p: Person, y: TaxableYear, t: Transaction, a: Asset, amount: Money) defeasible {
    label en official "section 1222(4)";
    when capital_gain_or_loss_transaction(p, y, t, a, amount, false);
    when long_term(p, a);
    then long_term_capital_loss(p, y, amount);
}

pub relation net_short_term_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional;
pub relation net_short_term_capital_loss(p: Person, y: TaxableYear, amount: Money) kind institutional;
pub relation net_long_term_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional;
pub relation net_long_term_capital_loss(p: Person, y: TaxableYear, amount: Money) kind institutional;
pub relation capital_gain_net_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "capital gain net income: the excess of the gains from sales or exchanges of capital assets over the losses from such sales or exchanges (section 1222(9))";
}
pub relation net_capital_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1222(10): the excess of losses from sales/exchanges of capital assets over the sum allowed under section 1211";
}
pub relation net_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1222(11): the excess of the net long-term capital gain for the taxable year over the net short-term capital loss for such year";
}

@source(IRC_S1222, quote = "The term \"net short-term capital gain\" means the excess of short-term capital gains for the taxable year over the short-term capital losses for such year.")
rule NetShortTermCapitalGainRule(p: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 1222(5)";
    when short_term_capital_gain(p, y, gains);
    when short_term_capital_loss(p, y, losses);
    when gains > losses;
    then net_short_term_capital_gain(p, y, gains - losses);
}
@source(IRC_S1222, quote = "The term \"net short-term capital loss\" means the excess of short-term capital losses for the taxable year over the short-term capital gains for such year.")
rule NetShortTermCapitalLossRule(p: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 1222(6)";
    when short_term_capital_gain(p, y, gains);
    when short_term_capital_loss(p, y, losses);
    when losses >= gains;
    then net_short_term_capital_loss(p, y, losses - gains);
}
@source(IRC_S1222, quote = "The term \"net long-term capital gain\" means the excess of long-term capital gains for the taxable year over the long-term capital losses for such year.")
rule NetLongTermCapitalGainRule(p: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 1222(7)";
    when long_term_capital_gain(p, y, gains);
    when long_term_capital_loss(p, y, losses);
    when gains > losses;
    then net_long_term_capital_gain(p, y, gains - losses);
}
@source(IRC_S1222, quote = "The term \"net long-term capital loss\" means the excess of long-term capital losses for the taxable year over the long-term capital gains for such year.")
rule NetLongTermCapitalLossRule(p: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 1222(8)";
    when long_term_capital_gain(p, y, gains);
    when long_term_capital_loss(p, y, losses);
    when losses >= gains;
    then net_long_term_capital_loss(p, y, losses - gains);
}
@source(IRC_S1222, quote = "The term \"capital gain net income\" means the excess of the gains from sales or exchanges of capital assets over the losses from such sales or exchanges.")
rule CapitalGainNetIncomeRule(p: Person, y: TaxableYear, st_gain: Money, st_loss: Money, lt_gain: Money, lt_loss: Money) defeasible {
    label en official "section 1222(9)";
    when short_term_capital_gain(p, y, st_gain);
    when short_term_capital_loss(p, y, st_loss);
    when long_term_capital_gain(p, y, lt_gain);
    when long_term_capital_loss(p, y, lt_loss);
    when (st_gain + lt_gain) > (st_loss + lt_loss);
    then capital_gain_net_income(p, y, (st_gain + lt_gain) - (st_loss + lt_loss));
}
@source(IRC_S1222, quote = "The term \"net capital gain\" means the excess of the net long-term capital gain for the taxable year over the net short-term capital loss for such year.")
rule NetCapitalGainRule(p: Person, y: TaxableYear, lt_gain: Money, st_loss: Money) defeasible {
    label en official "section 1222(11)";
    when net_long_term_capital_gain(p, y, lt_gain);
    when net_short_term_capital_loss(p, y, st_loss);
    when lt_gain > st_loss;
    then net_capital_gain(p, y, lt_gain - st_loss);
}
relation has_net_short_term_capital_loss(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "guard: a net short-term capital loss exists for the year (avoids an unbound not_known argument)";
}
rule HasNetShortTermCapitalLossRule(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en unofficial "derives the guard from the asserted/derived amount";
    when net_short_term_capital_loss(p, y, amount);
    then has_net_short_term_capital_loss(p, y);
}
@source(IRC_S1222, quote = "The term \"net capital gain\" means the excess of the net long-term capital gain for the taxable year over the net short-term capital loss for such year.")
rule NetCapitalGainNoShortTermLossRule(p: Person, y: TaxableYear, lt_gain: Money) defeasible {
    label en official "section 1222(11), no net short-term capital loss to subtract";
    when net_long_term_capital_gain(p, y, lt_gain);
    when not_known(has_net_short_term_capital_loss(p, y));
    then net_capital_gain(p, y, lt_gain);
}

// --- Section 1223: holding period ---------------------------------------

pub relation long_term(p: Person, a: Asset) kind institutional {
    label en official "the taxpayer's holding period in the asset is more than 1 year (section 1222(3)-(4) threshold, computed under section 1223)";
}
pub relation acquired_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer acquired the asset, for computing the holding period under section 1223";
}
pub relation disposed_on(p: Person, a: Asset, t: Transaction, on: Date) kind empirical {
    label en unofficial "the date of the sale or exchange, for computing the holding period under section 1223";
}
@source(IRC_S1222, quote = "held for more than 1 year")
rule LongTermFromAcquisitionAndDispositionDatesRule(p: Person, a: Asset, t: Transaction, acquired: Date, disposed: Date) strict {
    label en official "the holding period exceeds 1 year (section 1222(3)/(4)'s threshold) when more than a year elapsed between acquisition and disposition, applying section 1223's own-property default (no tacking)";
    when acquired_on(p, a, acquired);
    when disposed_on(p, a, t, disposed);
    when disposed > add_calendar_period(acquired, 1 calendar_year);
    then long_term(p, a);
}

// (1): tacking on a like-kind/involuntary-conversion-treated-as-exchange/
// section 355-356 exchange with substituted basis.
pub relation exchange_with_substituted_basis(p: Person, old_asset: Asset, new_asset: Asset) kind institutional {
    label en unofficial "the new asset has, for gain/loss purposes, the same basis in whole or part as the old asset in the taxpayer's hands, and the old asset was a capital asset or section 1231(b) property (section 1223(1))";
}
rule ExchangeWithSubstitutedBasisFromLikeKindRule(p: Person, old_asset: Asset, new_asset: Asset, t: Transaction, transfer_date: Date) defeasible {
    label en unofficial "a substituted basis carried from a like-kind exchange (section 1031) qualifies for section 1223(1) tacking";
    when substituted_basis_from(p, new_asset, p);
    when like_kind_exchange(t, p, old_asset, new_asset, transfer_date);
    when capital_asset(p, old_asset);
    then exchange_with_substituted_basis(p, old_asset, new_asset);
}
// TECH_GAP (section 1223(1) and (2), LDC-E4102): a rule concluding
// `acquired_on(p, a, ...)` from `acquired_on(p, old_asset, ...)` of a
// DIFFERENT asset is, by predicate name, a self-loop on `acquired_on` in
// the engine's per-package dependency graph — the graph is built at the
// predicate level, not the object level, so it cannot see that the chain
// of successive substituted-basis transfers among distinct `Asset`
// instances is acyclic in fact (property never tacks from itself). The
// engine reports this as an unstratifiable cycle (`циклам разрешены
// только monotone supported(P)-рёбра`) and refuses the rule set. Recorded
// here, not hidden as a renamed boundary: `exchange_with_substituted_basis`
// (section 1223(1)'s trigger, above) and `substituted_basis_from` (section
// 1223(2)'s trigger, declared in module 02) are both wired up and would
// feed a tacking rule exactly like `LongTermFromAcquisitionAndDispositionDatesRule`
// above, but the engine will not accept it while it concludes the SAME
// relation (`acquired_on`) it reads. A minimal reproduction: assert
// `exchange_with_substituted_basis(p, old_asset, a)` and
// `acquired_on(p, old_asset, acquired)`, and try to derive
// `acquired_on(p, a, acquired)` — `check` reports LDC-E4102 naming any rule
// of this shape. Only the section 1223(9) 1-year-after-death rule (below)
// and the direct, non-tacked holding period are executable this stage.

// Stage 2 bounded tacking (per-hop relations, not a fix of G24's unbounded
// self-loop): `exchange_with_substituted_basis` and `long_term` are
// DIFFERENT relations, so a rule reading the OLD asset's OWN `acquired_on`
// and concluding `long_term` for the NEW asset is not a self-loop on
// `acquired_on` (it never re-derives `acquired_on` for the new asset at
// all) — this gives exactly ONE hop of tacking, executable.
@source(IRC_S1223, quote = "In determining the period for which the taxpayer has held property received in an exchange, there shall be included the period for which he held the property exchanged")
rule LongTermViaOneHopTackingRule(p: Person, old_asset: Asset, new_asset: Asset, t: Transaction, acquired: Date, disposed: Date) defeasible {
    label en official "section 1223(1): the holding period of property received in a substituted-basis exchange tacks the transferor's holding period in the property exchanged (one hop: new asset's disposition against the immediately preceding asset's acquisition date)";
    when exchange_with_substituted_basis(p, old_asset, new_asset);
    when acquired_on(p, old_asset, acquired);
    when disposed_on(p, new_asset, t, disposed);
    when disposed > add_calendar_period(acquired, 1 calendar_year);
    then long_term(p, new_asset);
}

// Two hops: a second substituted-basis exchange of the ALREADY-tacked new
// asset into a further asset. `tacking_chain_two_hops` is its own relation,
// joining two INSTANCES of `exchange_with_substituted_basis` (oldest→mid,
// mid→newest) — it depends on that relation, not on itself, so this is not
// a further self-loop; it is simply bounded at exactly 2 hops (3 assets in
// the chain). A THIRD hop would need `tacking_chain_two_hops` to feed a
// `tacking_chain_three_hops` relation and so on — there is no general,
// unbounded-length construct (TECH-GAPS.md G24), so this package stops at
// two hops rather than generating an unbounded family of per-length rules.
pub relation tacking_chain_two_hops(p: Person, oldest_asset: Asset, newest_asset: Asset) kind institutional {
    label en unofficial "section 1223(1)/(2): two successive substituted-basis exchanges chained (oldest asset's basis carried through a middle asset into the newest asset) — bounded at exactly 2 hops, see TECH-GAPS.md G24 for the unbounded case";
}
rule TackingChainTwoHopsRule(p: Person, oldest_asset: Asset, mid_asset: Asset, newest_asset: Asset) defeasible {
    label en unofficial "chains two exchange_with_substituted_basis facts into a single 2-hop tacking relation";
    when exchange_with_substituted_basis(p, oldest_asset, mid_asset);
    when exchange_with_substituted_basis(p, mid_asset, newest_asset);
    then tacking_chain_two_hops(p, oldest_asset, newest_asset);
}
rule LongTermViaTwoHopTackingRule(p: Person, oldest_asset: Asset, newest_asset: Asset, t: Transaction, acquired: Date, disposed: Date) defeasible {
    label en official "section 1223(1): the holding period of property received through TWO successive substituted-basis exchanges tacks all the way back to the original (oldest) asset's acquisition date";
    when tacking_chain_two_hops(p, oldest_asset, newest_asset);
    when acquired_on(p, oldest_asset, acquired);
    when disposed_on(p, newest_asset, t, disposed);
    when disposed > add_calendar_period(acquired, 1 calendar_year);
    then long_term(p, newest_asset);
}

// (9): the 1-year-after-death rule — property whose basis is section 1014
// (from a decedent), sold within 1 year of death, is DEEMED held more than
// 1 year (an outright exception, not a tacking computation).
@source(IRC_S1223, quote = "then such person shall be considered to have held such property for more than 1 year")
rule OneYearAfterDeathDeemedLongTermRule(p: Person, a: Asset, decedent: Person, basis_amt: Money, death_date: Date, sold_on: Date, t: Transaction) defeasible {
    label en official "section 1223(9): property with section 1014 basis, sold within 1 year of the decedent's death, is deemed held for more than 1 year";
    when decedent_property_basis(p, a, basis_amt);
    when decedent_died_on(decedent, death_date);
    when disposed_on(p, a, t, sold_on);
    when sold_on <= add_calendar_period(death_date, 1 calendar_year);
    then long_term(p, a);
}

// (3): wash-sale tacking — the disallowed-loss holding period tacks onto
// the replacement stock's own holding period. TECH_GAP, same LDC-E4102
// class as (1)/(2) above: a rule concluding `acquired_on(p, replacement,
// ...)` from `acquired_on(p, a, ...)` is a self-loop on `acquired_on` by
// predicate name. `wash_sale_loss_disallowed` and
// `acquired_substantially_identical_stock_or_securities` (module 04) are
// both available to wire this once the engine (or a future language
// revision) supports object-level-safe recursion on a shape relation.
