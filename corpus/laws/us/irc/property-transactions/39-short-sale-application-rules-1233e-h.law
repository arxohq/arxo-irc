// Stage 3b (IRC-07, A05). Section 1233(e)-(h) (rules for the application of section 1233,
// arbitrage operations, the hedging exception, short sales of property that becomes
// substantially worthless), the (a)(3)(B)-(C) option exceptions of section 1234(a), the
// section 1235(c)(2) family narrowing, and the section 1272(a)(4) roll-forward of the
// adjusted issue price (unrolled to six accrual periods).
//
// Method. Quantities are Integers supplied by the case. The section 1233(e)(1) excess and
// the section 1233(f)(1) arbitrage ordering are computed by pairs of guarded rules. The
// hedging exception (g) is a strict fact-derived relation read as a guard by the defeasible
// module 10 rules. The adjusted issue price roll-forward is unrolled into distinct
// predicates per period (LDC-E4102), bounded at six periods (JUDGMENT CALL).

// =============================================================================
// Section 1233(e)(1): excess quantity
// =============================================================================

use self::{
    Asset,
    DebtInstrument,
    IRC_S1233_E,
    IRC_S1233_F,
    IRC_S1233_G,
    IRC_S1233_H,
    IRC_S1235_C,
    IRC_S1272_A,
    OptionContract,
    Person,
    Transaction,
    closes_short_sale,
    interest_payable_during_period,
    issue_price,
    section_1235c_related_persons,
    securities_futures_contract_definition_met_1234Bc,
    short_sale,
    short_sale_resets_holding_period_of_si_property,
    substantially_identical_property_held_not_more_than_1_year_at_short_sale,
    yield_to_maturity,
};

pub relation quantity_used_to_close_short_sale(t: Transaction, closing_t: Transaction, quantity: Integer) kind empirical {
    label en official "section 1233(e)(1): the quantity of property used to close the short sale";
}
pub relation quantity_of_substantially_identical_property(t: Transaction, quantity: Integer) kind empirical {
    label en official "section 1233(e)(1): the quantity of the substantially identical property referred to in subsection (b)(1) or (d)";
}
pub relation quantity_subject_to_1233b_or_d(t: Transaction, closing_t: Transaction, quantity: Integer) kind institutional {
    label en official "section 1233(e)(1): subsections (b)(1) and (d) apply only up to the quantity of the substantially identical property";
}
pub relation quantity_outside_1233b_or_d(t: Transaction, closing_t: Transaction, quantity: Integer) kind institutional {
    label en official "section 1233(e)(1): the quantity used to close in excess of the substantially identical quantity, to which (b)(1) and (d) do not apply";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "shall not apply to the gain or loss, respectively, on any quantity of property used to close such short sale which is in excess of the quantity of the substantially identical property referred to in the applicable subsection")
rule QuantityExcessOutside1233Rule(t: Transaction, closing_t: Transaction, closed: Integer, identical: Integer) strict {
    label en official "section 1233(e)(1): the excess of the closing quantity over the identical quantity is outside subsections (b)(1) and (d)";
    when quantity_used_to_close_short_sale(t, closing_t, closed);
    when quantity_of_substantially_identical_property(t, identical);
    when closed > identical;
    then quantity_outside_1233b_or_d(t, closing_t, closed - identical);
}
rule QuantityNoExcessRule(t: Transaction, closing_t: Transaction, closed: Integer, identical: Integer) strict {
    label en official "section 1233(e)(1): where the closing quantity does not exceed the identical quantity nothing is outside";
    when quantity_used_to_close_short_sale(t, closing_t, closed);
    when quantity_of_substantially_identical_property(t, identical);
    when closed <= identical;
    then quantity_outside_1233b_or_d(t, closing_t, 0);
}
rule QuantitySubjectWhenExcessRule(t: Transaction, closing_t: Transaction, closed: Integer, identical: Integer) strict {
    label en official "section 1233(e)(1): where the closing quantity exceeds the identical quantity, (b)(1) and (d) apply to the identical quantity";
    when quantity_used_to_close_short_sale(t, closing_t, closed);
    when quantity_of_substantially_identical_property(t, identical);
    when closed > identical;
    then quantity_subject_to_1233b_or_d(t, closing_t, identical);
}
rule QuantitySubjectWhenCoveredRule(t: Transaction, closing_t: Transaction, closed: Integer, identical: Integer) strict {
    label en official "section 1233(e)(1): where the identical quantity covers the closing quantity, (b)(1) and (d) apply to all of it";
    when quantity_used_to_close_short_sale(t, closing_t, closed);
    when quantity_of_substantially_identical_property(t, identical);
    when closed <= identical;
    then quantity_subject_to_1233b_or_d(t, closing_t, closed);
}

// =============================================================================
// Section 1233(e)(2): definitions for subsections (b) and (d)
// =============================================================================

pub relation stock_or_security_including_when_issued(a: Asset) kind empirical {
    label en official "section 1233(e)(2)(A): stocks and securities (including those dealt with on a when-issued basis)";
}
pub relation commodity_future_asset(a: Asset) kind empirical {
    label en official "section 1233(e)(2)(A): a commodity future";
}
pub relation asset_is_capital_asset_of_taxpayer_1233e(a: Asset, p: Person) kind empirical {
    label en official "section 1233(e)(2)(A): the property is a capital asset in the hands of the taxpayer";
}
pub relation position_to_which_1092b_applies(a: Asset) kind empirical {
    label en official "section 1233(e)(2)(A): a position to which section 1092(b) applies";
}
pub relation section_1233_property(a: Asset, p: Person) kind institutional {
    label en official "section 1233(e)(2)(A): the term property for subsections (b) and (d)";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "the term \"property\" includes only stocks and securities (including stocks and securities dealt with on a \"when issued\" basis), and commodity futures, which are capital assets in the hands of the taxpayer, but does not include any position to which section 1092(b) applies")
rule Section1233PropertyStockRule(a: Asset, p: Person) strict {
    label en official "section 1233(e)(2)(A): a stock or security that is a capital asset and not a section 1092(b) position is property";
    when stock_or_security_including_when_issued(a);
    when asset_is_capital_asset_of_taxpayer_1233e(a, p);
    when not_known(position_to_which_1092b_applies(a));
    then section_1233_property(a, p);
}
rule Section1233PropertyCommodityFutureRule(a: Asset, p: Person) strict {
    label en official "section 1233(e)(2)(A): a commodity future that is a capital asset and not a section 1092(b) position is property";
    when commodity_future_asset(a);
    when asset_is_capital_asset_of_taxpayer_1233e(a, p);
    when not_known(position_to_which_1092b_applies(a));
    then section_1233_property(a, p);
}

pub relation same_commodity_futures_on_exchange(a: Asset, b: Asset) kind empirical {
    label en official "section 1233(e)(2)(B): futures transactions in the same commodity on or subject to the rules of a board of trade or commodity exchange";
}
pub relation delivery_calendar_month_index(a: Asset, month_index: Integer) kind empirical {
    label en unofficial "section 1233(e)(2)(B): the calendar month of required delivery, as year times 12 plus month number";
}
pub relation not_substantially_identical_by_delivery_month_1233e2B(a: Asset, b: Asset) kind institutional {
    label en official "section 1233(e)(2)(B): a commodity future requiring delivery in one calendar month is not substantially identical to one requiring delivery in a different calendar month";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "a commodity future requiring delivery in 1 calendar month shall not be considered as property substantially identical to another commodity future requiring delivery in a different calendar month")
rule DifferentDeliveryMonthRule(a: Asset, b: Asset, ma: Integer, mb: Integer) strict {
    label en official "section 1233(e)(2)(B): different delivery months are not substantially identical";
    when same_commodity_futures_on_exchange(a, b);
    when delivery_calendar_month_index(a, ma);
    when delivery_calendar_month_index(b, mb);
    when ma != mb;
    then not_substantially_identical_by_delivery_month_1233e2B(a, b);
}

pub relation individual_taxpayer_short_seller(p: Person) kind empirical {
    label en official "section 1233(e)(2)(C): a short sale of property by an individual";
}
pub relation spouse_of_taxpayer_1233e2C(p: Person, spouse: Person) kind empirical {
    label en official "section 1233(e)(2)(C): the spouse of the individual";
}
pub relation legally_separated_by_decree_1233e2C(p: Person, spouse: Person) kind empirical {
    label en official "section 1233(e)(2)(C): an individual legally separated from the taxpayer under a decree of divorce or of separate maintenance";
}
pub relation read_as_taxpayer_or_spouse_1233e2C(p: Person, other: Person) kind institutional {
    label en official "section 1233(e)(2)(C): the term taxpayer is read as taxpayer or his spouse";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "the term \"taxpayer\", in the application of this subsection and subsections (b) and (d), shall be read as \"taxpayer or his spouse\"")
rule TaxpayerOrSpouseRule(p: Person, spouse: Person) strict {
    label en official "section 1233(e)(2)(C): an individual's spouse (not legally separated by decree) is read into the term taxpayer";
    when individual_taxpayer_short_seller(p);
    when spouse_of_taxpayer_1233e2C(p, spouse);
    when not_known(legally_separated_by_decree_1233e2C(p, spouse));
    then read_as_taxpayer_or_spouse_1233e2C(p, spouse);
}

pub relation securities_futures_contract_to_acquire_identical_property(a: Asset) kind empirical {
    label en official "section 1233(e)(2)(D): a securities futures contract to acquire substantially identical property";
}
pub relation treated_as_substantially_identical_property_1233e2D(a: Asset) kind institutional {
    label en official "section 1233(e)(2)(D): the contract is treated as substantially identical property";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "a securities futures contract (as defined in section 1234B) to acquire substantially identical property shall be treated as substantially identical property")
rule SecuritiesFuturesSubstantiallyIdenticalRule(a: Asset) strict {
    label en official "section 1233(e)(2)(D): a securities futures contract to acquire substantially identical property is substantially identical property";
    when securities_futures_contract_definition_met_1234Bc(a);
    when securities_futures_contract_to_acquire_identical_property(a);
    then treated_as_substantially_identical_property_1233e2D(a);
}

pub relation enters_securities_futures_contract_to_sell(t: Transaction, p: Person, a: Asset, on: Date) kind empirical {
    label en official "section 1233(e)(2)(E): the taxpayer enters into a securities futures contract to sell";
}
pub relation settlement_of_securities_futures_contract(t: Transaction, closing_t: Transaction, a: Asset, on: Date) kind empirical {
    label en official "section 1233(e)(2)(E): the settlement of the contract";
}
pub relation treated_as_short_sale_1233e2E(t: Transaction, p: Person, on: Date) kind institutional {
    label en official "section 1233(e)(2)(E): entering into a securities futures contract to sell is considered a short sale";
}
pub relation treated_as_closing_of_short_sale_1233e2E(t: Transaction, closing_t: Transaction, closed_on: Date) kind institutional {
    label en official "section 1233(e)(2)(E): the settlement of the contract is considered the closing of the short sale";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "entering into a securities futures contract (as so defined) to sell shall be considered to be a short sale")
rule SecuritiesFuturesToSellIsShortSaleRule(t: Transaction, p: Person, a: Asset, on: Date) strict {
    label en official "section 1233(e)(2)(E): entering into a securities futures contract to sell is a short sale";
    when enters_securities_futures_contract_to_sell(t, p, a, on);
    when securities_futures_contract_definition_met_1234Bc(a);
    then treated_as_short_sale_1233e2E(t, p, on);
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "the settlement of such contract shall be considered to be the closing of such short sale")
rule SecuritiesFuturesSettlementIsClosingRule(t: Transaction, p: Person, closing_t: Transaction, a: Asset, on: Date, closed_on: Date) strict {
    label en official "section 1233(e)(2)(E): the settlement of the contract is the closing of the short sale";
    when enters_securities_futures_contract_to_sell(t, p, a, on);
    when securities_futures_contract_definition_met_1234Bc(a);
    when settlement_of_securities_futures_contract(t, closing_t, a, closed_on);
    then treated_as_closing_of_short_sale_1233e2E(t, closing_t, closed_on);
}

// =============================================================================
// Section 1233(e)(3): offsetting commodity futures closed on one day
// =============================================================================

pub relation offsetting_commodity_futures_same_day_same_month(t1: Transaction, t2: Transaction) kind empirical {
    label en official "section 1233(e)(3): two commodity futures transactions entered into on the same day, one requiring delivery by the taxpayer in one market and the other delivery to him of the same commodity in the same calendar month in a different market";
}
pub relation both_offsetting_futures_closed_same_day(t1: Transaction, t2: Transaction) kind empirical {
    label en official "section 1233(e)(3): the taxpayer subsequently closes both transactions on the same day";
}
pub relation commodity_quantity_of_transaction(t: Transaction, quantity: Integer) kind empirical {
    label en official "section 1233(e)(3): the quantity of the commodity involved in the transaction";
}
pub relation quantity_outside_1233b_d_by_offset_1233e3(t1: Transaction, t2: Transaction, quantity: Integer) kind institutional {
    label en official "section 1233(e)(3): subsections (b) and (d) do not apply to so much of the commodity as does not exceed in quantity the commodity in the other transaction";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "subsections (b) and (d) shall have no application to so much of the commodity involved in either such transaction as does not exceed in quantity the commodity involved in the other")
rule OffsetQuantityFirstSmallerRule(t1: Transaction, t2: Transaction, q1: Integer, q2: Integer) strict {
    label en official "section 1233(e)(3): the offset quantity is the smaller of the two quantities (first transaction not larger)";
    when offsetting_commodity_futures_same_day_same_month(t1, t2);
    when both_offsetting_futures_closed_same_day(t1, t2);
    when commodity_quantity_of_transaction(t1, q1);
    when commodity_quantity_of_transaction(t2, q2);
    when q1 <= q2;
    then quantity_outside_1233b_d_by_offset_1233e3(t1, t2, q1);
}
rule OffsetQuantitySecondSmallerRule(t1: Transaction, t2: Transaction, q1: Integer, q2: Integer) strict {
    label en official "section 1233(e)(3): the offset quantity is the smaller of the two quantities (second transaction smaller)";
    when offsetting_commodity_futures_same_day_same_month(t1, t2);
    when both_offsetting_futures_closed_same_day(t1, t2);
    when commodity_quantity_of_transaction(t1, q1);
    when commodity_quantity_of_transaction(t2, q2);
    when q1 > q2;
    then quantity_outside_1233b_d_by_offset_1233e3(t1, t2, q2);
}

// =============================================================================
// Section 1233(e)(4): dealers in securities
// =============================================================================

pub relation dealer_in_securities_1236_short_seller(p: Person) kind empirical {
    label en official "section 1233(e)(4)(A): a taxpayer who is a dealer in securities within the meaning of section 1236";
}
pub relation short_sale_of_stock(t: Transaction, p: Person, sold_on: Date) kind empirical {
    label en official "section 1233(e)(4)(A)(i): a short sale of stock";
}
pub relation share_or_certificate_of_stock(a: Asset) kind empirical {
    label en official "section 1233(e)(4)(B)(ii): a share or certificate of stock in a corporation";
}
pub relation convertible_evidence_of_indebtedness(a: Asset) kind empirical {
    label en official "section 1233(e)(4)(B)(ii): a bond or other evidence of indebtedness convertible into stock";
}
pub relation interest_or_right_to_subscribe_or_purchase_stock(a: Asset) kind empirical {
    label en official "section 1233(e)(4)(B)(ii): an evidence of an interest in, or right to subscribe to or purchase, any of the foregoing";
}
pub relation stock_for_1233e4(a: Asset) kind institutional {
    label en official "section 1233(e)(4)(B)(ii): the term stock for the dealer rule";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "the term \"stock\" means any share or certificate of stock in a corporation")
rule StockShareRule(a: Asset) strict {
    label en official "section 1233(e)(4)(B)(ii): a share or certificate of stock is stock";
    when share_or_certificate_of_stock(a);
    then stock_for_1233e4(a);
}
rule StockConvertibleRule(a: Asset) strict {
    label en official "section 1233(e)(4)(B)(ii): a convertible bond or evidence of indebtedness is stock";
    when convertible_evidence_of_indebtedness(a);
    then stock_for_1233e4(a);
}
rule StockRightRule(a: Asset) strict {
    label en official "section 1233(e)(4)(B)(ii): an interest or right to subscribe to or purchase stock is stock";
    when interest_or_right_to_subscribe_or_purchase_stock(a);
    then stock_for_1233e4(a);
}

pub relation dealer_short_sale_closed_after_20_days_1233e4(t: Transaction, p: Person, closed_on: Date) kind institutional {
    label en official "section 1233(e)(4)(A)(ii): the short sale is closed more than 20 days after the date on which it was made";
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "if such short sale is closed more than 20 days after the date on which it was made")
rule DealerClosedAfter20DaysRule(t: Transaction, p: Person, sold_on: Date, closing_t: Transaction, closed_on: Date) strict {
    label en official "section 1233(e)(4)(A)(ii): the closing date is later than 20 days after the short sale date";
    when dealer_in_securities_1236_short_seller(p);
    when short_sale_of_stock(t, p, sold_on);
    when closes_short_sale(t, closing_t, closed_on);
    when closed_on > add_calendar_period(sold_on, 20 calendar_day);
    then dealer_short_sale_closed_after_20_days_1233e4(t, p, closed_on);
}
@source(IRC_S1233_E, relation = formalizes, coverage = exact, quote = "subsection (b)(2) shall apply in respect of the holding period of such substantially identical property")
rule DealerHoldingPeriodResetRule(t: Transaction, p: Person, si: Asset, closed_on: Date) defeasible {
    label en official "section 1233(e)(4)(A): for a dealer, subsection (b)(2) applies to the holding period of substantially identical property held not more than 1 year at the short sale date when the short sale is closed after 20 days";
    when dealer_short_sale_closed_after_20_days_1233e4(t, p, closed_on);
    when substantially_identical_property_held_not_more_than_1_year_at_short_sale(t, p, si);
    when stock_for_1233e4(si);
    when not_known(section_1233_disapplied_for_hedging_1233g(t));
    then short_sale_resets_holding_period_of_si_property(t, p, si, closed_on);
}

// =============================================================================
// Section 1233(f): arbitrage operations
// =============================================================================

pub relation short_sale_entered_as_arbitrage_operation(t: Transaction, p: Person) kind empirical {
    label en official "section 1233(f): a short sale entered into as an arbitrage operation";
}
pub relation arbitrage_operation_transaction(t: Transaction) kind empirical {
    label en official "section 1233(f)(4): the purchase and sale of assets to profit from a current price difference, where the asset purchased entitles the taxpayer to acquire assets identical to those sold";
}
pub relation arbitrage_operation_identified_in_records_timely(t: Transaction) kind empirical {
    label en official "section 1233(f)(4): the operation is clearly identified as an arbitrage operation in the taxpayer's records on the day of the transaction or as soon thereafter as practicable";
}
pub relation arbitrage_operation_1233f4(t: Transaction) kind institutional {
    label en official "section 1233(f)(4): an arbitrage operation (transaction and identification requirements met)";
}
@source(IRC_S1233_F, relation = formalizes, coverage = exact, quote = "Such operations must be clearly identified by the taxpayer in his records as arbitrage operations on the day of the transaction or as soon thereafter as may be practicable")
rule ArbitrageOperationRule(t: Transaction) strict {
    label en official "section 1233(f)(4): an arbitrage operation is an arbitrage transaction identified in the records in time";
    when arbitrage_operation_transaction(t);
    when arbitrage_operation_identified_in_records_timely(t);
    then arbitrage_operation_1233f4(t);
}
pub relation asset_acquired_for_arbitrage_operation(a: Asset) kind empirical {
    label en official "section 1233(f)(4): an asset acquired for arbitrage operations (stocks and securities and the right to acquire them)";
}

pub relation arbitrage_assets_held_at_close_of_sale_day(t: Transaction, quantity: Integer) kind empirical {
    label en official "section 1233(f)(1): the substantially identical assets acquired for arbitrage operations held at the close of business on the day of the sale";
}
pub relation arbitrage_assets_entitled_to_receive(t: Transaction, quantity: Integer) kind empirical {
    label en official "section 1233(f)(3): property the taxpayer is or will be entitled to receive or acquire by virtue of another arbitrage asset or contract";
}
pub relation quantity_sold_short_in_arbitrage(t: Transaction, quantity: Integer) kind empirical {
    label en official "section 1233(f)(1): the quantity sold short";
}
pub relation deemed_arbitrage_assets_held_1233f3(t: Transaction, quantity: Integer) kind institutional {
    label en official "section 1233(f)(3): the arbitrage assets held plus those the taxpayer is entitled to receive or acquire";
}
@source(IRC_S1233_F, relation = formalizes, coverage = exact, quote = "the taxpayer will be deemed as of the close of any business day to hold property which he is or will be entitled to receive or acquire")
rule DeemedArbitrageAssetsHeldRule(t: Transaction, held: Integer, entitled: Integer) strict {
    label en official "section 1233(f)(3): assets held plus assets entitled to receive are deemed held";
    when arbitrage_assets_held_at_close_of_sale_day(t, held);
    when arbitrage_assets_entitled_to_receive(t, entitled);
    then deemed_arbitrage_assets_held_1233f3(t, held + entitled);
}
pub relation quantity_affecting_other_identical_assets_1233f1(t: Transaction, quantity: Integer) kind institutional {
    label en official "section 1233(f)(1): only the excess of the quantity sold short over the arbitrage assets held affects the holding period of other identical assets";
}
@source(IRC_S1233_F, relation = formalizes, coverage = exact, quote = "only to the extent that the quantity sold short exceeds the substantially identical assets acquired for arbitrage operations held at the close of business on the day such sale is made, shall the holding period of any other such identical assets held by the taxpayer be affected")
rule ArbitrageExcessAffectsOtherAssetsRule(t: Transaction, p: Person, sold: Integer, held: Integer) strict {
    label en official "section 1233(f)(1): the excess of the quantity sold short over the deemed arbitrage holdings reaches other identical assets";
    when short_sale_entered_as_arbitrage_operation(t, p);
    when arbitrage_operation_1233f4(t);
    when quantity_sold_short_in_arbitrage(t, sold);
    when deemed_arbitrage_assets_held_1233f3(t, held);
    when sold > held;
    then quantity_affecting_other_identical_assets_1233f1(t, sold - held);
}
rule ArbitrageNoExcessRule(t: Transaction, p: Person, sold: Integer, held: Integer) strict {
    label en official "section 1233(f)(1): where the arbitrage assets held cover the quantity sold short no other identical assets are affected";
    when short_sale_entered_as_arbitrage_operation(t, p);
    when arbitrage_operation_1233f4(t);
    when quantity_sold_short_in_arbitrage(t, sold);
    when deemed_arbitrage_assets_held_1233f3(t, held);
    when sold <= held;
    then quantity_affecting_other_identical_assets_1233f1(t, 0);
}

pub relation net_short_position_in_arbitrage_assets(t: Transaction, p: Person, on: Date, quantity: Integer) kind empirical {
    label en official "section 1233(f)(2): the disposition of arbitrage assets creates a net short position in assets acquired for arbitrage operations";
}
pub relation deemed_short_sale_of_net_short_position_1233f2(t: Transaction, p: Person, on: Date) kind institutional {
    label en official "section 1233(f)(2): the net short position is deemed a short sale made on that day";
}
@source(IRC_S1233_F, relation = formalizes, coverage = exact, quote = "such net short position shall be deemed to constitute a short sale made on that day")
rule NetShortPositionDeemedShortSaleRule(t: Transaction, p: Person, on: Date, quantity: Integer) strict {
    label en official "section 1233(f)(2): a positive net short position is a deemed short sale on that day";
    when net_short_position_in_arbitrage_assets(t, p, on, quantity);
    when quantity > 0;
    then deemed_short_sale_of_net_short_position_1233f2(t, p, on);
}

// =============================================================================
// Section 1233(g): hedging transactions in commodity futures
// =============================================================================

pub relation hedging_transaction_in_commodity_futures(t: Transaction) kind empirical {
    label en official "section 1233(g): a hedging transaction in commodity futures";
}
pub relation section_1233_disapplied_for_hedging_1233g(t: Transaction) kind institutional {
    label en official "section 1233(g): section 1233 does not apply to the transaction";
}
@source(IRC_S1233_G, relation = formalizes, coverage = exact, quote = "This section shall not apply in the case of a hedging transaction in commodity futures.")
rule Section1233HedgingExceptionRule(t: Transaction) strict {
    label en official "section 1233(g): section 1233 does not apply to a hedging transaction in commodity futures";
    when hedging_transaction_in_commodity_futures(t);
    then section_1233_disapplied_for_hedging_1233g(t);
}

// =============================================================================
// Section 1233(h): property that becomes substantially worthless
// =============================================================================

pub relation short_sale_property_becomes_substantially_worthless(t: Transaction, p: Person, worthless_on: Date) kind empirical {
    label en official "section 1233(h)(1)(B): the property sold short becomes substantially worthless";
}
pub relation regulations_extend_1233h_to_similar_transaction(t: Transaction) kind empirical {
    label en official "section 1233(h)(1): to the extent provided in regulations, the rule applies to an option, offsetting notional principal contract, futures or forward contract or similar transaction";
}
pub relation gain_recognized_as_if_short_sale_closed_1233h1(t: Transaction, p: Person, on: Date) kind institutional {
    label en official "section 1233(h)(1): the taxpayer recognizes gain as if the short sale were closed when the property becomes substantially worthless";
}
@source(IRC_S1233_H, relation = formalizes, coverage = exact, quote = "the taxpayer shall recognize gain in the same manner as if the short sale were closed when the property becomes substantially worthless")
rule WorthlessShortSaleGainRule(t: Transaction, p: Person, sold_on: Date, worthless_on: Date) defeasible {
    label en official "section 1233(h)(1): a short sale of property that becomes substantially worthless is treated as closed on that date";
    when short_sale(t, p, sold_on);
    when short_sale_property_becomes_substantially_worthless(t, p, worthless_on);
    then gain_recognized_as_if_short_sale_closed_1233h1(t, p, worthless_on);
}
@source(IRC_S1233_H, relation = formalizes, coverage = partial, quote = "To the extent provided in regulations prescribed by the Secretary, the preceding sentence also shall apply with respect to any option with respect to property")
rule WorthlessSimilarTransactionRule(t: Transaction, p: Person, worthless_on: Date) defeasible {
    label en official "section 1233(h)(1): by regulation the rule extends to options, notional principal contracts, futures or forwards and similar transactions";
    when regulations_extend_1233h_to_similar_transaction(t);
    when short_sale_property_becomes_substantially_worthless(t, p, worthless_on);
    then gain_recognized_as_if_short_sale_closed_1233h1(t, p, worthless_on);
}

pub relation short_sale_open_when_property_worthless(t: Transaction) kind empirical {
    label en official "section 1233(h)(2): a short sale of the property remains open at the time the property becomes substantially worthless";
}
pub relation secretary_notified_of_worthlessness_on(t: Transaction, notified: Date) kind empirical {
    label en official "section 1233(h)(2)(A)(i): the date the Secretary is notified by the taxpayer of the substantial worthlessness";
}
pub relation return_for_worthless_year_filed_on(t: Transaction, filed: Date) kind empirical {
    label en official "section 1233(h)(2)(A)(ii): the date the return for the taxable year is filed";
}
pub relation worthlessness_notification_period_end(t: Transaction, ends: Date) kind institutional {
    label en official "section 1233(h)(2)(A)(i): 3 years after the notification";
}
pub relation worthlessness_return_period_end(t: Transaction, ends: Date) kind institutional {
    label en official "section 1233(h)(2)(A)(ii): 6 years after the return is filed";
}
@source(IRC_S1233_H, relation = formalizes, coverage = exact, quote = "the date which is 3 years after the date the Secretary is notified by the taxpayer")
rule NotificationPeriodEndRule(t: Transaction, notified: Date) strict {
    label en official "section 1233(h)(2)(A)(i): the notification limb is 3 years after the notification";
    when short_sale_open_when_property_worthless(t);
    when secretary_notified_of_worthlessness_on(t, notified);
    then worthlessness_notification_period_end(t, add_calendar_period(notified, 3 calendar_year));
}
@source(IRC_S1233_H, relation = formalizes, coverage = exact, quote = "the date which is 6 years after the date the return for such taxable year is filed")
rule ReturnPeriodEndRule(t: Transaction, filed: Date) strict {
    label en official "section 1233(h)(2)(A)(ii): the return limb is 6 years after the return is filed";
    when short_sale_open_when_property_worthless(t);
    when return_for_worthless_year_filed_on(t, filed);
    then worthlessness_return_period_end(t, add_calendar_period(filed, 6 calendar_year));
}
pub relation assessment_period_floor_1233h2A(t: Transaction, floor: Date) kind institutional {
    label en official "section 1233(h)(2)(A): the assessment period does not expire before the earlier of the two dates";
}
@source(IRC_S1233_H, relation = formalizes, coverage = exact, quote = "shall not expire before the earlier of")
rule FloorNotificationEarlierRule(t: Transaction, n: Date, r: Date) strict {
    label en official "section 1233(h)(2)(A): the floor is the notification date when it is not later than the return date";
    when worthlessness_notification_period_end(t, n);
    when worthlessness_return_period_end(t, r);
    when n <= r;
    then assessment_period_floor_1233h2A(t, n);
}
rule FloorReturnEarlierRule(t: Transaction, n: Date, r: Date) strict {
    label en official "section 1233(h)(2)(A): the floor is the return date when it is earlier";
    when worthlessness_notification_period_end(t, n);
    when worthlessness_return_period_end(t, r);
    when n > r;
    then assessment_period_floor_1233h2A(t, r);
}
pub relation assessment_permitted_notwithstanding_other_law_1233h2B(t: Transaction) kind institutional {
    label en official "section 1233(h)(2)(B): the deficiency may be assessed before the date under (A) notwithstanding any other law that would prevent the assessment";
}
@source(IRC_S1233_H, relation = formalizes, coverage = exact, quote = "such deficiency may be assessed before the date applicable under subparagraph (A) notwithstanding the provisions of any other law or rule of law which would otherwise prevent such assessment")
rule AssessmentNotwithstandingRule(t: Transaction) strict {
    label en official "section 1233(h)(2)(B): assessment is permitted notwithstanding other law";
    when short_sale_open_when_property_worthless(t);
    then assessment_permitted_notwithstanding_other_law_1233h2B(t);
}

// =============================================================================
// Section 1234(a)(3)(C) and section 1235(c)(2)
// =============================================================================

pub relation option_is_section_1233c_option(opt: OptionContract) kind empirical {
    label en official "section 1234(a)(3)(C): an option described in section 1233(c)";
}
pub relation family_member_spouse_ancestor_or_lineal_descendant(a: Person, b: Person) kind empirical {
    label en official "section 1235(c)(2): a relation that is spouse, ancestor or lineal descendant (the narrowed family class)";
}
@source(IRC_S1235_C, relation = formalizes, coverage = exact, quote = "the family of an individual shall include only his spouse, ancestors, and lineal descendants")
rule Section1235cFamilyNarrowedRule(a: Person, b: Person) defeasible {
    label en official "section 1235(c)(2): persons related as spouse, ancestor or lineal descendant are related persons for section 1235";
    when family_member_spouse_ancestor_or_lineal_descendant(a, b);
    then section_1235c_related_persons(a, b);
}

// =============================================================================
// Section 1272(a)(4): adjusted issue price rolled forward (six periods)
// =============================================================================

pub relation rolled_adjusted_issue_price_1272a4(instr: DebtInstrument, period: Integer, amount: Money) kind institutional {
    label en official "section 1272(a)(4): the adjusted issue price at the beginning of the accrual period - the issue price plus the adjustments for all earlier periods (periods 1 to 6)";
}

pub relation aip_slot_1_1272a4(instr: DebtInstrument, amount: Money) kind institutional {
    label en unofficial "section 1272(a)(4)(A): period 1 starts at the issue price";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "the issue price of such debt instrument, plus")
rule AipSlot1Rule(instr: DebtInstrument, price: Money) defeasible {
    label en official "section 1272(a)(4)(A): the first period starts at the issue price";
    when issue_price(instr, price);
    then aip_slot_1_1272a4(instr, price);
}
rule AipUnion1Rule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1272(a)(4): the rolled adjusted issue price of period 1";
    when aip_slot_1_1272a4(instr, amount);
    then rolled_adjusted_issue_price_1272a4(instr, 1, amount);
}
pub relation aip_slot_2_1272a4(instr: DebtInstrument, amount: Money) kind institutional {
    label en unofficial "section 1272(a)(4)(B): period 2 starts at the period 1 start plus the period 1 adjustment";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "the adjustments under this subsection to such issue price for all periods before the first day of such accrual period")
rule AipSlot2Rule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): the start of period 2 is the start of period 1 plus its increase (start times yield less interest, when positive)";
    when aip_slot_1_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 1, interest);
    when start * rate > interest;
    then aip_slot_2_1272a4(instr, start + (start * rate - interest));
}
rule AipSlot2NoIncreaseRule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): where the period 1 product does not exceed the interest, the start is unchanged";
    when aip_slot_1_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 1, interest);
    when start * rate <= interest;
    then aip_slot_2_1272a4(instr, start);
}
rule AipUnion2Rule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1272(a)(4): the rolled adjusted issue price of period 2";
    when aip_slot_2_1272a4(instr, amount);
    then rolled_adjusted_issue_price_1272a4(instr, 2, amount);
}
pub relation aip_slot_3_1272a4(instr: DebtInstrument, amount: Money) kind institutional {
    label en unofficial "section 1272(a)(4)(B): period 3 starts at the period 2 start plus the period 2 adjustment";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "the adjustments under this subsection to such issue price for all periods before the first day of such accrual period")
rule AipSlot3Rule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): the start of period 3 is the start of period 2 plus its increase (start times yield less interest, when positive)";
    when aip_slot_2_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 2, interest);
    when start * rate > interest;
    then aip_slot_3_1272a4(instr, start + (start * rate - interest));
}
rule AipSlot3NoIncreaseRule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): where the period 2 product does not exceed the interest, the start is unchanged";
    when aip_slot_2_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 2, interest);
    when start * rate <= interest;
    then aip_slot_3_1272a4(instr, start);
}
rule AipUnion3Rule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1272(a)(4): the rolled adjusted issue price of period 3";
    when aip_slot_3_1272a4(instr, amount);
    then rolled_adjusted_issue_price_1272a4(instr, 3, amount);
}
pub relation aip_slot_4_1272a4(instr: DebtInstrument, amount: Money) kind institutional {
    label en unofficial "section 1272(a)(4)(B): period 4 starts at the period 3 start plus the period 3 adjustment";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "the adjustments under this subsection to such issue price for all periods before the first day of such accrual period")
rule AipSlot4Rule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): the start of period 4 is the start of period 3 plus its increase (start times yield less interest, when positive)";
    when aip_slot_3_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 3, interest);
    when start * rate > interest;
    then aip_slot_4_1272a4(instr, start + (start * rate - interest));
}
rule AipSlot4NoIncreaseRule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): where the period 3 product does not exceed the interest, the start is unchanged";
    when aip_slot_3_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 3, interest);
    when start * rate <= interest;
    then aip_slot_4_1272a4(instr, start);
}
rule AipUnion4Rule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1272(a)(4): the rolled adjusted issue price of period 4";
    when aip_slot_4_1272a4(instr, amount);
    then rolled_adjusted_issue_price_1272a4(instr, 4, amount);
}
pub relation aip_slot_5_1272a4(instr: DebtInstrument, amount: Money) kind institutional {
    label en unofficial "section 1272(a)(4)(B): period 5 starts at the period 4 start plus the period 4 adjustment";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "the adjustments under this subsection to such issue price for all periods before the first day of such accrual period")
rule AipSlot5Rule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): the start of period 5 is the start of period 4 plus its increase (start times yield less interest, when positive)";
    when aip_slot_4_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 4, interest);
    when start * rate > interest;
    then aip_slot_5_1272a4(instr, start + (start * rate - interest));
}
rule AipSlot5NoIncreaseRule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): where the period 4 product does not exceed the interest, the start is unchanged";
    when aip_slot_4_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 4, interest);
    when start * rate <= interest;
    then aip_slot_5_1272a4(instr, start);
}
rule AipUnion5Rule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1272(a)(4): the rolled adjusted issue price of period 5";
    when aip_slot_5_1272a4(instr, amount);
    then rolled_adjusted_issue_price_1272a4(instr, 5, amount);
}
pub relation aip_slot_6_1272a4(instr: DebtInstrument, amount: Money) kind institutional {
    label en unofficial "section 1272(a)(4)(B): period 6 starts at the period 5 start plus the period 5 adjustment";
}
@source(IRC_S1272_A, relation = formalizes, coverage = partial, quote = "the adjustments under this subsection to such issue price for all periods before the first day of such accrual period")
rule AipSlot6Rule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): the start of period 6 is the start of period 5 plus its increase (start times yield less interest, when positive)";
    when aip_slot_5_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 5, interest);
    when start * rate > interest;
    then aip_slot_6_1272a4(instr, start + (start * rate - interest));
}
rule AipSlot6NoIncreaseRule(instr: DebtInstrument, start: Money, rate: Decimal, interest: Money) defeasible {
    label en official "section 1272(a)(4)(B): where the period 5 product does not exceed the interest, the start is unchanged";
    when aip_slot_5_1272a4(instr, start);
    when yield_to_maturity(instr, rate);
    when interest_payable_during_period(instr, 5, interest);
    when start * rate <= interest;
    then aip_slot_6_1272a4(instr, start);
}
rule AipUnion6Rule(instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1272(a)(4): the rolled adjusted issue price of period 6";
    when aip_slot_6_1272a4(instr, amount);
    then rolled_adjusted_issue_price_1272a4(instr, 6, amount);
