// Section 1014 (basis of property acquired from a decedent), section 1015
// (basis of property acquired by gift) and section 1016 (adjustments to
// basis). Stage 1, priority sections.



// --- Section 1014: basis of property acquired from a decedent --------------
//
// (a): the general rule is fair-market-value-at-death ("stepped-up" or
// "stepped-down" basis), with three named alternatives ((a)(2)-(4)); (b)
// is the "acquired from a decedent" classification list (this stage models
// (b)(1) bequest/devise/inheritance, (b)(6) surviving spouse's community-
// property half, and the general shape of the others as a case fact,
// leaving the narrow revocable-trust/general-power/foreign-corporation/
// pre-2005 paragraphs (b)(2)-(5),(9)-(10) as EXTERNAL_DEPENDENCY-flavoured
// classification facts a case asserts directly rather than re-deriving
// their own multi-section tests); (c) income-in-respect-of-a-decedent
// exclusion; (e) the 1-year rule (appreciated gift back to the donor within
// a year of the donee-decedent's death); (f) consistency with the estate-
// tax return value.
//
// Fair market value at death is an EVALUATIVE element (DECISION-0194):
// modelled as a fact a case asserts with an origin (`appraised` or
// `adjudicated`), never invented by this package.

use self::{
    Asset,
    IRC_S1014_A,
    IRC_S1014_B,
    IRC_S1014_C,
    IRC_S1014_E,
    IRC_S1014_F,
    IRC_S1015_A,
    IRC_S1015_D,
    IRC_S1016_A,
    IRC_S1016_B,
    Person,
    allowed_after_1016a2B,
};

pub relation acquired_from_decedent(p: Person, a: Asset, decedent: Person) kind institutional {
    label en official "property considered to have been acquired from or to have passed from a decedent within the meaning of section 1014(b)";
}
@source(IRC_S1014_B, quote = "Property acquired by bequest, devise, or inheritance, or by the decedent's estate from the decedent;")
rule AcquiredFromDecedentByBequestRule(p: Person, a: Asset, decedent: Person) strict {
    label en official "section 1014(b)(1): property acquired by bequest, devise, or inheritance, or by the decedent's estate from the decedent";
    when acquired_by_bequest_devise_or_inheritance(p, a, decedent);
    then acquired_from_decedent(p, a, decedent);
}
pub relation acquired_by_bequest_devise_or_inheritance(p: Person, a: Asset, decedent: Person) kind empirical {
    label en official "acquired by bequest, devise, or inheritance, or by the decedent's estate from the decedent";
}
@source(IRC_S1014_B, quote = "In the case of decedents dying after December 31, 1947, property which represents the surviving spouse's one-half share of community property held by the decedent and the surviving spouse under the community property laws of any State, or possession of the United States or any foreign country, if at least one-half of the whole of the community interest in such property was includible in determining the value of the decedent's gross estate under chapter 11")
rule AcquiredFromDecedentBySurvivingSpouseCommunityShareRule(p: Person, a: Asset, decedent: Person, decedent_death: Date) strict {
    label en official "section 1014(b)(6): the surviving spouse's one-half share of community property, if at least half the whole community interest was includible in the decedent's gross estate (decedents dying after December 31, 1947)";
    when surviving_spouse_community_property_half(p, a, decedent);
    when decedent_died_on(decedent, decedent_death);
    when decedent_death > @1947-12-31;
    when half_of_community_interest_in_gross_estate(a);
    then acquired_from_decedent(p, a, decedent);
}
pub relation surviving_spouse_community_property_half(p: Person, a: Asset, decedent: Person) kind empirical {
    label en unofficial "property representing the surviving spouse's one-half share of community property held with the decedent";
}
pub relation decedent_died_on(decedent: Person, on: Date) kind empirical {
    label en official "the date of the decedent's death";
}
pub relation half_of_community_interest_in_gross_estate(a: Asset) kind empirical {
    label en unofficial "at least one-half of the whole of the community interest in the property was includible in determining the value of the decedent's gross estate under chapter 11";
}
// (b)(2)-(5),(9)-(10) — revocable-trust transfers, powers of appointment,
// pre-2005 foreign-personal-holding-company stock, section 2044 marital-
// deduction property, and the general "included in the gross estate by
// reason of death, form of ownership or other conditions" catch-all — are
// each their own multi-section classification test (chapter 11 gross-
// estate inclusion rules, owned by `estate-gift`, not this package).
// Modelled as a single case-asserted classification fact rather than a
// re-derivation of `estate-gift`'s own inclusion tests, per the "typed
// institutional dependency contract" method (declared, not invented):
pub relation acquired_from_decedent_other_paragraph_b(p: Person, a: Asset, decedent: Person) kind empirical {
    label en unofficial "property acquired from the decedent under section 1014(b)(2),(3),(4),(5),(9) or (10) — chapter 11 gross-estate-inclusion classification owned by estate-gift, asserted here as a case fact pending that package's typed dependency contract";
}
@source(IRC_S1014_B, relation = formalizes, coverage = partial, quote = "For purposes of subsection (a), the following property shall be considered to have been acquired from or to have passed from the decedent:")
rule AcquiredFromDecedentOtherParagraphBRule(p: Person, a: Asset, decedent: Person) strict {
    label en official "section 1014(b)(2)-(5),(9)-(10): property acquired from the decedent under the remaining paragraph (b) classifications";
    when acquired_from_decedent_other_paragraph_b(p, a, decedent);
    then acquired_from_decedent(p, a, decedent);
}

pub relation date_of_death_fair_market_value(a: Asset, decedent: Person, amount: Money) kind evaluative {
    label en unofficial "the fair market value of property at the date of the decedent's death (section 1014(a)(1)) — a DECISION-0194 evaluative element, asserted with its origin (appraised or adjudicated), never invented";
}
pub relation section_2032_alternate_valuation_elected(decedent: Person) kind empirical {
    label en official "an election under section 2032 (alternate valuation) is in effect for the decedent's estate";
}
pub relation section_2032_alternate_valuation_date_value(a: Asset, decedent: Person, amount: Money) kind evaluative {
    label en unofficial "the value of the property at the section 2032 alternate valuation date";
}
pub relation section_2032a_special_use_value(a: Asset, decedent: Person, amount: Money) kind institutional {
    label en unofficial "the value of the property determined under section 2032A (special use valuation), owned by estate-gift";
}
pub relation section_2031c_exclusion_applies(a: Asset, decedent: Person) kind empirical {
    label en official "the section 2031(c) qualified-conservation-easement exclusion applies to the property (to the extent of that exclusion, basis is the decedent's own basis, not fair market value)";
}
pub relation decedent_basis(a: Asset, decedent: Person, amount: Money) kind institutional {
    label en unofficial "the decedent's own adjusted basis in the property immediately before death (used, to the extent of the section 2031(c) exclusion, in place of fair market value)";
}

@source(IRC_S1014_A, quote = "the basis of property in the hands of a person acquiring the property from a decedent or to whom the property passed from a decedent shall, if not sold, exchanged, or otherwise disposed of before the decedent's death by such person, be—")
rule DecedentBasisFairMarketValueAtDeathRule(p: Person, a: Asset, decedent: Person, fmv: Money) defeasible {
    label en official "section 1014(a)(1): basis is fair market value at the date of the decedent's death";
    when acquired_from_decedent(p, a, decedent);
    when not_known(section_2032_alternate_valuation_elected(decedent));
    when not_known(section_2031c_exclusion_applies(a, decedent));
    when date_of_death_fair_market_value(a, decedent, fmv);
    then decedent_property_basis(p, a, fmv);
}
@source(IRC_S1014_A, quote = "in the case of an election under section 2032, its value at the applicable valuation date prescribed by such section")
rule DecedentBasisSection2032AlternateValuationRule(p: Person, a: Asset, decedent: Person, alt_value: Money) strict {
    label en official "section 1014(a)(2): basis is the section 2032 alternate valuation date value, if that election is in effect";
    when acquired_from_decedent(p, a, decedent);
    when section_2032_alternate_valuation_elected(decedent);
    when section_2032_alternate_valuation_date_value(a, decedent, alt_value);
    then decedent_property_basis(p, a, alt_value);
}
@source(IRC_S1014_A, quote = "to the extent of the applicability of the exclusion described in section 2031(c), the basis in the hands of the decedent")
rule DecedentBasisSection2031cExclusionRule(p: Person, a: Asset, decedent: Person, own_basis: Money) strict {
    label en official "section 1014(a)(4): to the extent of the section 2031(c) exclusion, basis is the decedent's own basis, not fair market value";
    when acquired_from_decedent(p, a, decedent);
    when section_2031c_exclusion_applies(a, decedent);
    when decedent_basis(a, decedent, own_basis);
    then decedent_property_basis(p, a, own_basis);
}
pub relation decedent_property_basis(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "the basis of property acquired from a decedent under section 1014, before the section 1014(e) 1-year appreciated-gift-back exception and the section 1014(f) consistency cap";
}

// (c): section 691 income-in-respect-of-a-decedent property is excluded
// from section 1014 entirely — its basis is carryover, computed under
// section 691, not fair market value.
pub relation section_691_ird_property(a: Asset) kind institutional {
    label en unofficial "a right to receive an item of income in respect of a decedent under section 691 — owned by that section, not this package";
}
@source(IRC_S1014_C, quote = "This section shall not apply to property which constitutes a right to receive an item of income in respect of a decedent under section 691.")
rule Section1014InapplicableToIrdRule(p: Person, a: Asset, decedent: Person) strict {
    label en official "section 1014(c): section 1014 does not apply to section 691 income-in-respect-of-a-decedent property";
    when acquired_from_decedent(p, a, decedent);
    when section_691_ird_property(a);
    then section_1014_inapplicable(p, a, decedent);
}
pub relation section_1014_inapplicable(p: Person, a: Asset, decedent: Person) kind institutional {
    label en unofficial "section 1014 does not determine this property's basis (section 691 governs instead)";
}

// (e): the 1-year rule — appreciated property given to the decedent within
// 1 year of death, that comes BACK to the donor (or the donor's spouse) on
// the decedent's death, keeps the DECEDENT's (i.e., the donor's own,
// carried through the decedent) adjusted basis — no step-up.
pub relation appreciated_gift_to_decedent_within_one_year(a: Asset, donor: Person, decedent: Person, gift_date: Date, decedent_death: Date, fmv_at_gift: Money, donor_basis_at_gift: Money) kind empirical {
    label en unofficial "appreciated property (fair market value at the gift date exceeding adjusted basis) acquired by the decedent by gift during the 1-year period ending on the date of the decedent's death";
}
pub relation acquired_from_decedent_by_original_donor_or_spouse(a: Asset, donor_or_spouse: Person, decedent: Person) kind empirical {
    label en official "the property is acquired from the decedent by (or passes from the decedent to) the donor of the property or the donor's spouse (section 1014(e)(1)(B))";
}
@source(IRC_S1014_E, quote = "the basis of such property in the hands of such donor (or spouse) shall be the adjusted basis of such property in the hands of the decedent immediately before the death of the decedent.")
rule OneYearRuleNoStepUpRule(p: Person, a: Asset, decedent: Person, gift_date: Date, decedent_death: Date, fmv_at_gift: Money, donor_basis_at_gift: Money, decedent_basis_before_death: Money, calendar_before_1: Date) strict {
    label en official "section 1014(e)(1): appreciated property gifted to the decedent within 1 year of death, returning to the donor (or spouse), keeps the decedent's adjusted basis immediately before death — no step-up";
    when appreciated_gift_to_decedent_within_one_year(a, p, decedent, gift_date, decedent_death, fmv_at_gift, donor_basis_at_gift);
    when fmv_at_gift > donor_basis_at_gift;
    when acquired_from_decedent_by_original_donor_or_spouse(a, p, decedent);
    when decedent_died_on(decedent, decedent_death);
    when gift_date >= calendar_before_1;
    when decedent_property_basis_before_death(a, decedent, decedent_basis_before_death)
        and us.irc.core::civil_calendar_boundary_before(decedent_death, 1, us.irc.core::CalendarYear, calendar_before_1);
    then decedent_property_basis(p, a, decedent_basis_before_death);
}
pub relation decedent_property_basis_before_death(a: Asset, decedent: Person, amount: Money) kind institutional {
    label en unofficial "the decedent's own adjusted basis in the property immediately before death, for purposes of section 1014(e)";
}

// (f): consistency with estate tax return value — basis under (a) cannot
// EXCEED the value finally determined for chapter 11 estate tax purposes
// (or the section 6035(a) statement value), when that inclusion increased
// the estate's chapter 11 liability.
pub relation final_chapter_11_value(a: Asset, decedent: Person, amount: Money) kind institutional {
    label en unofficial "the final value of the property determined for chapter 11 estate tax purposes (owner: estate-gift)";
}
pub relation section_6035a_statement_value(a: Asset, decedent: Person, amount: Money) kind empirical {
    label en unofficial "the value of the property identified in a statement furnished under section 6035(a)";
}
pub relation inclusion_increased_chapter_11_liability(a: Asset, decedent: Person) kind empirical {
    label en official "the property's inclusion in the decedent's gross estate increased the chapter 11 estate tax liability (reduced by allowable credits)";
}
@source(IRC_S1014_F, quote = "The basis of any property to which subsection (a) applies shall not exceed—")
rule ConsistencyCapFinalChapter11ValueRule(p: Person, a: Asset, decedent: Person, otherwise: Money, final_value: Money) defeasible {
    label en official "section 1014(f)(1)(A): basis under section 1014(a) may not exceed the finally determined chapter 11 estate tax value";
    when decedent_property_basis(p, a, otherwise);
    when inclusion_increased_chapter_11_liability(a, decedent);
    when final_chapter_11_value(a, decedent, final_value);
    when final_value < otherwise;
    then decedent_property_basis_capped(p, a, final_value);
}
pub relation decedent_property_basis_capped(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "the section 1014(f) consistency-capped basis of property acquired from a decedent — used in place of decedent_property_basis when the cap binds";
}

// --- Section 1015: basis of property acquired by gift -----------------------
//
// (a): the general dual-basis rule — donor's basis for GAIN, but for LOSS,
// the lesser of donor's basis or fair market value at the time of the
// gift. (d): the gift-tax basis increase (post-1976 net-appreciation
// formula, paragraph (6); pre-1977 formula not modelled, TECH_GAP — the
// statute's own footnote structure ties the pre-1977 rule to prior revenue
// laws this task does not pin). (e): a gift in a section 1041(a) transfer
// is NOT under this section (basis is section 1041(b)(2) carryover
// instead) — cross-reference, modelled as a guard.

pub relation acquired_by_gift(p: Person, a: Asset, donor: Person, gift_date: Date) kind empirical {
    label en official "property acquired by gift after December 31, 1920 (section 1015(a))";
}
pub relation donor_adjusted_basis_at_gift(a: Asset, donor: Person, gift_date: Date, amount: Money) kind institutional {
    label en unofficial "the donor's (or last-preceding-non-gift owner's) adjusted basis in the property, adjusted under section 1016 for the period before the gift";
}
pub relation fair_market_value_at_gift(a: Asset, gift_date: Date, amount: Money) kind evaluative {
    label en unofficial "the fair market value of the property at the time of the gift — a DECISION-0194 evaluative element, asserted with its origin";
}
pub relation section_1041_transfer(p: Person, a: Asset, transferor: Person) kind institutional {
    label en unofficial "the property was acquired in a transfer described in section 1041(a) (basis governed by section 1041(b)(2), not this section)";
}

@source(IRC_S1015_A, quote = "If the property was acquired by gift after December 31, 1920, the basis shall be the same as it would be in the hands of the donor or the last preceding owner by whom it was not acquired by gift")
rule GiftBasisForGainRule(p: Person, a: Asset, donor: Person, gift_date: Date, donor_basis: Money) defeasible {
    label en official "section 1015(a): basis for determining GAIN on a later sale is the donor's own adjusted basis (carryover)";
    when acquired_by_gift(p, a, donor, gift_date);
    when not_known(section_1041_transfer(p, a, donor));
    when donor_adjusted_basis_at_gift(a, donor, gift_date, donor_basis);
    then gift_basis_for_gain(p, a, donor_basis);
}
pub relation gift_basis_for_gain(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "section 1015(a): the donee's basis for determining gain — the donor's adjusted basis at the time of the gift, before the section 1015(d) gift-tax addback";
}

@source(IRC_S1015_A, quote = "except that if such basis (adjusted for the period before the date of the gift as provided in section 1016) is greater than the fair market value of the property at the time of the gift, then for the purpose of determining loss the basis shall be such fair market value")
rule GiftBasisForLossWhenBasisExceedsFmvRule(p: Person, a: Asset, donor: Person, gift_date: Date, donor_basis: Money, fmv: Money) strict {
    label en official "section 1015(a): where the donor's basis exceeds fair market value at the gift, basis for determining LOSS is that (lower) fair market value";
    when acquired_by_gift(p, a, donor, gift_date);
    when not_known(section_1041_transfer(p, a, donor));
    when donor_adjusted_basis_at_gift(a, donor, gift_date, donor_basis);
    when fair_market_value_at_gift(a, gift_date, fmv);
    when donor_basis > fmv;
    then gift_basis_for_loss(p, a, fmv);
}
@source(IRC_S1015_A, quote = "the basis shall be the same as it would be in the hands of the donor")
rule GiftBasisForLossWhenBasisNotAboveFmvRule(p: Person, a: Asset, donor: Person, gift_date: Date, donor_basis: Money, fmv: Money) strict {
    label en official "section 1015(a): where the donor's basis does not exceed fair market value at the gift, basis for determining loss is the same donor's basis used for gain (no dual basis)";
    when acquired_by_gift(p, a, donor, gift_date);
    when not_known(section_1041_transfer(p, a, donor));
    when donor_adjusted_basis_at_gift(a, donor, gift_date, donor_basis);
    when fair_market_value_at_gift(a, gift_date, fmv);
    when donor_basis <= fmv;
    then gift_basis_for_loss(p, a, donor_basis);
}
pub relation gift_basis_for_loss(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "section 1015(a): the donee's basis for determining loss on a later sale of gift property (the dual-basis rule)";
}

// (d): gift-tax paid increases basis (but not above fair market value at
// the gift), by the post-1976 net-appreciation ratio of paragraph (6).
pub relation gift_tax_paid_on_gift(a: Asset, gift_date: Date, amount: Money) kind empirical {
    label en unofficial "the amount of gift tax paid under chapter 12 apportioned to this gift, computed under section 1015(d)(2)-(3) (ratio of this gift to all taxable gifts for the period — computation not re-derived here, asserted directly per the method's treatment of a case-supplied apportionment)";
}
@source(IRC_S1015_D, quote = "In the case of any gift made after December 31, 1976, the increase in basis provided by this subsection with respect to any gift for the gift tax paid under chapter 12 shall be an amount (not in excess of the amount of tax so paid) which bears the same ratio to the amount of tax so paid as—")
rule GiftTaxBasisIncreaseRule(p: Person, a: Asset, donor: Person, gift_date: Date, donor_basis: Money, fmv: Money, tax_paid: Money) defeasible {
    label en official "section 1015(d)(1),(6): basis is increased (not above fair market value at the gift) by gift tax paid, prorated by net appreciation over the amount of the gift (post-1976 gifts)";
    when gift_basis_for_gain(p, a, donor_basis);
    when fair_market_value_at_gift(a, gift_date, fmv);
    when gift_tax_paid_on_gift(a, gift_date, tax_paid);
    when gift_date > @1976-12-31;
    then gift_basis_for_gain_after_gift_tax(p, a, min(fmv, donor_basis + tax_paid));
}
pub relation gift_basis_for_gain_after_gift_tax(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "section 1015(d): the donee's basis for gain after the gift-tax-paid basis increase";
}

// --- Section 1016: adjustments to basis --------------------------------------
//
// (a)(1)-(38) is modelled as ONE classification pattern (an enum of
// adjustment kinds + a case-asserted `basis_adjustment_item` fact per
// item, following the section 61(a) 14-item precedent in `gross-income`):
// a rule whose head and body share the same aggregate predicate is a
// dependency cycle the engine rejects (LDC-E4102), so the net adjustment
// for a period is `sum all` over the individual asserted items, not 38
// structurally-identical increase/decrease rules. Each paragraph is still
// recorded individually in the coverage rows against the shared enum
// value and the two rules below.

pub enum BasisAdjustmentKind {
    CapitalExpenditure;                    // (a)(1)
    DepreciationDepletionAllowedOrAllowable; // (a)(2)
    PreEffectiveDateDepreciation;           // (a)(3)
    StockDistributionsNontaxable;           // (a)(4)
    TaxExemptBondAmortizedPremium;          // (a)(5)
    MunicipalBondAmortizedPremium;          // (a)(6)
    FormerResidenceRolloverAdjustment;      // (a)(7)
    CommodityCreditCorporationLoan;         // (a)(8)
    MineDevelopmentDeferredExpenses;        // (a)(9)
    UnharvestedCropDisallowedDeduction;     // (a)(11)
    ResearchAndExperimentalDeferredExpenses; // (a)(14)
    CoalOrIronOreDisallowedDeduction;       // (a)(15)
    BondPremiumOrDiscount;                  // (a)(16)
    SCorporationStockOrDebt;                // (a)(17)
    ControlledForeignCorporationStock;      // (a)(18)
    InvestmentCreditBasisReduction;         // (a)(19)
    TenYearWriteoffElection;                // (a)(20)
    ExtraordinaryDividendReduction;         // (a)(21)
    QualifiedReplacementPropertySection1042; // (a)(22)
    NonrecognitionUnderSection1043_1045_1397B; // (a)(23)
    EnergyCreditProperty;                   // (a)(26)
    NewMarketsTaxCreditFacility;            // (a)(28)
    RailroadTrackMaintenanceCredit;         // (a)(29)
    EnergyEfficientCommercialBuildings;     // (a)(30)
    EnergyEfficientHomeCredit;              // (a)(31)
    EnergyEfficientHomeImprovementCredit;   // (a)(33)
    ResidentialCleanEnergyCredit;           // (a)(34)
    CleanVehicleCredit;                     // (a)(35)
    AlternativeFuelRefuelingCredit;         // (a)(36)
    PreviouslyOwnedCleanVehicleCredit;      // (a)(37)
    OpportunityZoneDeferredGainAdjustment;  // (a)(38)
    ImportedAutomobileExciseTax;            // (d)
    Section2032aAdditionalEstateTax;        // (c)
    label en unofficial "the kind of adjustment made to basis under section 1016(a) (a representative subset of the 38-paragraph list; additive as the remaining paragraphs are needed) or under section 1016(c)/(d)";
}
// SIMPLIFICATION (documented, not hidden): the aggregate below sums ALL
// asserted items for the asset without narrowing by date — section 1016's
// own date-scoping ("in respect of any period since...") is not modelled
// granularly this stage. A scenario needing the basis AS OF an
// intermediate date, with only some of several later adjustments already
// having occurred, is TECH_GAP: `sum all` takes one bound enum/case
// variable and a single matching relation call (no inline inequality
// filter on a second column), so per-item date filtering would need a
// second aggregation layer this stage did not build.
pub relation basis_increase_item(p: Person, a: Asset, kind: BasisAdjustmentKind, amount: Money) kind empirical {
    label en unofficial "a single section 1016 basis-INCREASE item: an amount and a kind (which paragraph)";
}
pub relation basis_decrease_item(p: Person, a: Asset, kind: BasisAdjustmentKind, amount: Money) kind empirical {
    label en unofficial "a single section 1016 basis-DECREASE item: an amount and a kind (which paragraph)";
}
pub relation basis_as_of(p: Person, a: Asset, on: Date) kind empirical {
    label en unofficial "a date the taxpayer (or a case scenario) asks for this asset's adjusted basis as of — binds the otherwise date-unscoped section 1016 aggregate below to a concrete adjusted_basis computation";
}
pub relation net_basis_adjustment_1016(p: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en official "section 1016(a): the net (signed) adjustment to basis, from all asserted section 1016 items (the `on` parameter identifies which adjusted_basis computation this feeds, not a date filter on the items themselves — see the module note above)";
}
@source(IRC_S1016_A, quote = "Proper adjustment in respect of the property shall in all cases be made")
rule NetBasisAdjustmentRule(p: Person, a: Asset, on: Date) strict {
    label en official "section 1016(a): the net basis adjustment is the sum of increases minus the sum of decreases from all asserted adjustment items";
    when basis_as_of(p, a, on);
    when has_basis_adjustment_activity(p, a);
    then net_basis_adjustment_1016(p, a, on,
        (sum all amount: Money for kind: BasisAdjustmentKind where basis_increase_item(p, a, kind, amount))
        - (sum all amount: Money for kind: BasisAdjustmentKind where basis_decrease_item(p, a, kind, amount)));
}
relation has_basis_adjustment_activity(p: Person, a: Asset) kind institutional {
    label en unofficial "guard: at least one section 1016 item (increase or decrease) is asserted for this asset, so the aggregate below is not a vacuous zero claim";
}
rule HasBasisIncreaseActivityRule(p: Person, a: Asset, kind: BasisAdjustmentKind, amount: Money) strict {
    label en unofficial "derives the guard from any asserted increase item";
    when basis_increase_item(p, a, kind, amount);
    then has_basis_adjustment_activity(p, a);
}
rule HasBasisDecreaseActivityRule(p: Person, a: Asset, kind: BasisAdjustmentKind, amount: Money) strict {
    label en unofficial "derives the guard from any asserted decrease item";
    when basis_decrease_item(p, a, kind, amount);
    then has_basis_adjustment_activity(p, a);
}

// (a)(2): depreciation "allowed or allowable" — the DEPRECIATION AMOUNT
// itself is `accounting`'s own computation (an EXTERNAL_DEPENDENCY this
// package reads, never re-derives); this module supplies only the section
// 1016(a)(2) RULE that the adjustment is the GREATER of allowed or
// allowable (never less than allowable), which is the operative legal
// content of the paragraph beyond the underlying number.
pub relation depreciation_allowed(p: Person, a: Asset, period_ending: Date, amount: Money) kind institutional {
    label en unofficial "depreciation actually allowed as a deduction for the period (owner: accounting, typed dependency contract)";
}
pub relation depreciation_allowable(p: Person, a: Asset, period_ending: Date, amount: Money) kind institutional {
    label en unofficial "depreciation allowable as a deduction for the period, whether or not claimed (owner: accounting, typed dependency contract)";
}
@source(IRC_S1016_A, quote = "but not less than the amount allowable under this subtitle or prior income tax laws")
rule DepreciationAdjustmentIsGreaterOfAllowedOrAllowableRule(p: Person, a: Asset, period_ending: Date, allowed: Money, allowable: Money) strict {
    label en official "section 1016(a)(2): the basis-reduction adjustment for depreciation is the greater of the amount allowed or the amount allowable for the period";
    when allowed_after_1016a2B(p, a, period_ending, allowed);  // Stage 4: the tax benefit limb (B), 51-*.law
    when depreciation_allowable(p, a, period_ending, allowable);
    then basis_decrease_item(p, a, DepreciationDepletionAllowedOrAllowable, max(allowed, allowable));
}

// (b): substituted-basis carry-through — the adjustments provided in (a)
// are computed as if the property had remained in the hands of the
// transferor whose basis is used (i.e., a substituted-basis chain
// reaches back through every prior holder whose basis this package
// carries over — sections 1015(a), 1041(b)(2), 1031(d), 1033(b)).
@source(IRC_S1016_B, quote = "Whenever it appears that the basis of property in the hands of the taxpayer is a substituted basis, then the adjustments provided in subsection (a) shall be made after first making in respect of such substituted basis proper adjustments of a similar nature")
rule SubstitutedBasisAdjustmentCarryThroughRule(p: Person, a: Asset, prior_holder: Person, on: Date, prior_adjustment: Money, own_adjustment: Money) defeasible {
    label en official "section 1016(b): where basis is a substituted basis, section 1016(a) adjustments for the period before the substitution (in the prior holder's hands) carry through together with adjustments in the taxpayer's own hands";
    when substituted_basis_from(p, a, prior_holder);
    when net_basis_adjustment_1016(prior_holder, a, on, prior_adjustment);
    when net_basis_adjustment_1016(p, a, on, own_adjustment);
    then combined_substituted_basis_adjustment(p, a, on, prior_adjustment + own_adjustment);
}
pub relation substituted_basis_from(p: Person, a: Asset, prior_holder: Person) kind institutional {
    label en unofficial "the taxpayer's basis in the asset is a substituted basis carried from a prior holder (gift under section 1015, spousal/divorce transfer under section 1041, like-kind exchange under section 1031, involuntary conversion under section 1033)";
}
pub relation combined_substituted_basis_adjustment(p: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en unofficial "the section 1016(b) combined substituted-basis adjustment: the prior holder's adjustment plus the taxpayer's own";
}
