// Stage 3b (IRC-07, A05). Section 1059 remainder: (c)(3)(A)-(B) the 85-day and 365-day
// aggregates computed by `sum all` over the dividends the case places in the window, (d)(6)(B) the
// qualified corporation, (e)(1)(A) the redemption basis rule, (e)(3)(B) the actual and stated
// rates of return.
//
// Method. Which dividends have ex-dividend dates within the same window is a case-supplied
// membership relation (an anchor dividend and the dividends in its window); the sum itself is
// computed. The rates of return are Decimal (dollar facts, div_round to six places, HALF_UP -
// JUDGMENT CALL: the statute names no rounding).

use self::{
    Asset,
    Corporation,
    IRC_S1059_C,
    IRC_S1059_D,
    IRC_S1059_E,
    Person,
    Section1059AggregateThreshold,
    Section1059OtherThreshold,
    Section1059PreferredThreshold,
    ShareDividend,
    dividend_received,
    exception_inconsistent_with_purposes_1059d6c,
    extraordinary_dividend_1059,
    measuring_base_1059,
    redemption_dividend_only_by_options_or_section_304,
    section_1059_applies_without_holding_period,
    section_1059_entire_existence_exception,
    share_preferred_as_to_dividends,
    stock_held_during_entire_existence_of_corporation,
};

pub relation dividend_in_85_day_window(anchor: ShareDividend, dv: ShareDividend, amount: Money) kind empirical {
    label en official "section 1059(c)(3)(A)(ii): a dividend whose ex-dividend date falls within the same 85 consecutive days as the anchor dividend's (membership supplied by the case)";
}
pub relation dividend_in_365_day_window(anchor: ShareDividend, dv: ShareDividend, amount: Money) kind empirical {
    label en official "section 1059(c)(3)(B)(ii): a dividend whose ex-dividend date falls within the same 365 consecutive days as the anchor dividend's (membership supplied by the case)";
}
pub relation person_described_in_1059c3C(p: Person, q: Person) kind empirical {
    label en official "section 1059(c)(3)(C): a person whose dividends are counted with the taxpayer's";
}
pub relation dividend_received_by_taxpayer_or_1059c3C_person(p: Person, share: Asset, dv: ShareDividend) kind institutional {
    label en official "section 1059(c)(3)(A)(i), (B)(i): the dividend is received by the taxpayer (or a person described in subparagraph (C)) with respect to a share";
}
@source(IRC_S1059_C, relation = formalizes, coverage = exact, quote = "which are received by the taxpayer (or a person described in subparagraph (C)) with respect to any share of stock")
rule DividendReceivedByTaxpayerRule(p: Person, share: Asset, dv: ShareDividend, amount: Money) defeasible {
    label en official "section 1059(c)(3): a dividend received by the taxpayer";
    when dividend_received(dv, p, share, amount);
    then dividend_received_by_taxpayer_or_1059c3C_person(p, share, dv);
}
rule DividendReceivedByLinkedPersonRule(p: Person, q: Person, share: Asset, dv: ShareDividend, amount: Money) defeasible {
    label en official "section 1059(c)(3): a dividend received by a person described in subparagraph (C)";
    when person_described_in_1059c3C(p, q);
    when dividend_received(dv, q, share, amount);
    then dividend_received_by_taxpayer_or_1059c3C_person(p, share, dv);
}
pub relation aggregate_85_day_dividends_computed(p: Person, share: Asset, anchor: ShareDividend, amount: Money) kind institutional {
    label en official "section 1059(c)(3)(A): the aggregate of the dividends in the 85-day window, treated as one dividend";
}
@source(IRC_S1059_C, relation = formalizes, coverage = exact, quote = "shall be treated as 1 dividend.")
rule Aggregate85ComputedRule(p: Person, share: Asset, anchor: ShareDividend) defeasible {
    label en official "section 1059(c)(3)(A): the 85-day dividends are summed and treated as one";
    when dividend_received_by_taxpayer_or_1059c3C_person(p, share, anchor);
    then aggregate_85_day_dividends_computed(p, share, anchor,
        sum all amount: Money for dv: ShareDividend where dividend_in_85_day_window(anchor, dv, amount));
}
pub relation aggregate_365_day_dividends_computed(p: Person, share: Asset, anchor: ShareDividend, amount: Money) kind institutional {
    label en official "section 1059(c)(3)(B): the aggregate of the dividends in the 365-day window";
}
@source(IRC_S1059_C, relation = formalizes, coverage = exact, quote = "which have ex-dividend dates during the same period of 365 consecutive days")
rule Aggregate365ComputedRule(p: Person, share: Asset, anchor: ShareDividend) defeasible {
    label en official "section 1059(c)(3)(B): the 365-day dividends are summed";
    when dividend_received_by_taxpayer_or_1059c3C_person(p, share, anchor);
    then aggregate_365_day_dividends_computed(p, share, anchor,
        sum all amount: Money for dv: ShareDividend where dividend_in_365_day_window(anchor, dv, amount));
}
@source(IRC_S1059_C, relation = formalizes, coverage = exact, quote = "shall be treated as extraordinary dividends if the aggregate of such dividends exceeds 20 percent of the taxpayer's adjusted basis in such stock")
rule Extraordinary365ComputedRule(p: Person, share: Asset, anchor: ShareDividend, agg: Money, base: Money) defeasible {
    label en official "section 1059(c)(3)(B): the computed 365-day aggregate above 20 percent of the base makes the anchor dividend extraordinary";
    when aggregate_365_day_dividends_computed(p, share, anchor, agg);
    when measuring_base_1059(p, share, anchor, base);
    when agg > base * Section1059AggregateThreshold;
    then extraordinary_dividend_1059(anchor, share);
}
rule Extraordinary85ComputedPreferredRule(p: Person, share: Asset, anchor: ShareDividend, agg: Money, base: Money) defeasible {
    label en official "section 1059(c)(3)(A): the computed 85-day aggregate tested as one dividend (preferred stock)";
    when aggregate_85_day_dividends_computed(p, share, anchor, agg);
    when measuring_base_1059(p, share, anchor, base);
    when share_preferred_as_to_dividends(share);
    when agg >= base * Section1059PreferredThreshold;
    then extraordinary_dividend_1059(anchor, share);
}
rule Extraordinary85ComputedOtherRule(p: Person, share: Asset, anchor: ShareDividend, agg: Money, base: Money) defeasible {
    label en official "section 1059(c)(3)(A): the computed 85-day aggregate tested as one dividend (other stock)";
    when aggregate_85_day_dividends_computed(p, share, anchor, agg);
    when measuring_base_1059(p, share, anchor, base);
    when not_known(share_preferred_as_to_dividends(share));
    when agg >= base * Section1059OtherThreshold;
    then extraordinary_dividend_1059(anchor, share);
}

// =============================================================================
// Section 1059(d)(6)(B): qualified corporation
// =============================================================================

pub relation ownership_interest_during_entire_existence_1059d6Bi(p: Person, corp: Corporation, percent: Decimal) kind empirical {
    label en official "section 1059(d)(6)(B)(i): the ownership interest the taxpayer holds, directly or indirectly, during the entire period of the corporation's existence";
}
pub relation ownership_interest_in_distributing_corporation(p: Person, distributing: Corporation, percent: Decimal) kind empirical {
    label en official "section 1059(d)(6)(B)(i): the ownership interest the taxpayer holds in the corporation distributing the extraordinary dividend";
}
pub relation earnings_earned_by_or_accrued_while_nonqualified(corp: Corporation) kind empirical {
    label en official "section 1059(d)(6)(B)(ii)(I)-(II): earnings and profits earned by, or attributable to gain accrued during a period the holding corporation was, a corporation not described in clause (i)";
}
pub relation qualified_corporation_1059d6B(p: Person, corp: Corporation, distributing: Corporation) kind institutional {
    label en official "section 1059(d)(6)(B): the corporation is a qualified corporation";
}
@source(IRC_S1059_D, relation = formalizes, coverage = exact, quote = "the term \"qualified corporation\" means any corporation (including a predecessor corporation)")
rule QualifiedCorporationRule(p: Person, corp: Corporation, distributing: Corporation, held: Decimal, dist_held: Decimal) defeasible {
    label en official "section 1059(d)(6)(B): at least the same interest throughout the corporation's existence and no earnings from non-qualified periods";
    when ownership_interest_during_entire_existence_1059d6Bi(p, corp, held);
    when ownership_interest_in_distributing_corporation(p, distributing, dist_held);
    when held >= dist_held;
    when not_known(earnings_earned_by_or_accrued_while_nonqualified(corp));
    then qualified_corporation_1059d6B(p, corp, distributing);
}
pub relation share_issuer_corporation(share: Asset, corp: Corporation) kind empirical {
    label en official "the corporation that issued the share";
}
@source(IRC_S1059_D, relation = formalizes, coverage = partial, quote = "with respect to which the taxpayer holds directly or indirectly during the entire period of such corporation's existence")
rule EntireExistenceExceptionViaQualifiedCorporationRule(dv: ShareDividend, p: Person, share: Asset, amount: Money, corp: Corporation, distributing: Corporation) defeasible {
    label en official "section 1059(d)(6)(A)(ii) with (B): the exception applies when the earnings come only from qualified corporations";
    when dividend_received(dv, p, share, amount);
    when stock_held_during_entire_existence_of_corporation(p, share);
    when share_issuer_corporation(share, distributing);
    when qualified_corporation_1059d6B(p, corp, distributing);
    when not_known(exception_inconsistent_with_purposes_1059d6c(dv));
    then section_1059_entire_existence_exception(dv);
}

// =============================================================================
// Section 1059(e)(1)(A): redemption basis
// =============================================================================

pub relation basis_of_stock_redeemed_1059e1A(dv: ShareDividend, share: Asset, amount: Money) kind empirical {
    label en official "section 1059(e)(1)(A): the basis in the stock redeemed";
}
pub relation redemption_basis_taken_into_account_1059e1A(dv: ShareDividend, share: Asset, amount: Money) kind institutional {
    label en official "section 1059(e)(1)(A): for a redemption described in clause (iii) only the basis in the stock redeemed is taken into account under subsection (a)";
}
@source(IRC_S1059_E, relation = formalizes, coverage = exact, quote = "only the basis in the stock redeemed shall be taken into account under subsection (a)")
rule RedemptionBasisOnlyRule(dv: ShareDividend, share: Asset, amount: Money) defeasible {
    label en official "section 1059(e)(1)(A): a clause (iii) redemption uses only the redeemed stock's basis";
    when redemption_dividend_only_by_options_or_section_304(dv);
    when basis_of_stock_redeemed_1059e1A(dv, share, amount);
    then redemption_basis_taken_into_account_1059e1A(dv, share, amount);
}
pub relation dividend_treated_as_extraordinary_without_holding_period_1059e1A(dv: ShareDividend) kind institutional {
    label en official "section 1059(e)(1)(A): a redemption dividend is extraordinary without regard to the holding period";
}
@source(IRC_S1059_E, relation = formalizes, coverage = partial, quote = "any amount treated as a dividend with respect to such redemption shall be treated as an extraordinary dividend to which paragraphs (1) and (2) of subsection (a) apply without regard to the period the taxpayer held such stock")
rule RedemptionDividendExtraordinaryRule(dv: ShareDividend) defeasible {
    label en official "section 1059(e)(1)(A): the redemption dividend is treated as extraordinary regardless of holding period";
    when section_1059_applies_without_holding_period(dv);
    then dividend_treated_as_extraordinary_without_holding_period_1059e1A(dv);
}

// =============================================================================
// Section 1059(e)(3)(B): rates of return
// =============================================================================

pub relation dividends_during_holding_dollars_1059e3B(p: Person, share: Asset, dollars: Decimal) kind empirical {
    label en official "section 1059(e)(3)(B)(i)(I): the dividends during the period the taxpayer held the stock";
}
pub relation basis_dollars_1059e3B(p: Person, share: Asset, dollars: Decimal) kind empirical {
    label en official "section 1059(e)(3)(B)(i)(II): the taxpayer's adjusted basis in the stock";
}
pub relation liquidation_preference_dollars_1059e3B(share: Asset, dollars: Decimal) kind empirical {
    label en official "section 1059(e)(3)(B)(i)(II): the liquidation preference of the stock";
}
pub relation lesser_of_basis_or_liquidation_preference_1059e3B(p: Person, share: Asset, dollars: Decimal) kind institutional {
    label en official "section 1059(e)(3)(B)(i)(II): the lesser of the adjusted basis and the liquidation preference";
}
@source(IRC_S1059_E, relation = formalizes, coverage = exact, quote = "by using the lesser of the adjusted basis of the taxpayer in such stock or the liquidation preference of such stock")
rule LesserIsBasisRule(p: Person, share: Asset, basis: Decimal, pref: Decimal) strict {
    label en official "section 1059(e)(3)(B)(i)(II): the basis when it is not larger than the liquidation preference";
    when basis_dollars_1059e3B(p, share, basis);
    when liquidation_preference_dollars_1059e3B(share, pref);
    when basis <= pref;
    then lesser_of_basis_or_liquidation_preference_1059e3B(p, share, basis);
}
rule LesserIsPreferenceRule(p: Person, share: Asset, basis: Decimal, pref: Decimal) strict {
    label en official "section 1059(e)(3)(B)(i)(II): the liquidation preference when the basis is larger";
    when basis_dollars_1059e3B(p, share, basis);
    when liquidation_preference_dollars_1059e3B(share, pref);
    when basis > pref;
    then lesser_of_basis_or_liquidation_preference_1059e3B(p, share, pref);
}
pub relation actual_rate_of_return_1059e3Bi(p: Person, share: Asset, rate: Decimal) kind institutional {
    label en official "section 1059(e)(3)(B)(i): the rate of return for the period held - the dividends during the period over the lesser of basis and liquidation preference (six places, HALF_UP)";
}
@source(IRC_S1059_E, relation = formalizes, coverage = exact, quote = "by only taking into account dividends during such period")
rule ActualRateOfReturnRule(p: Person, share: Asset, dividends: Decimal, lesser: Decimal) strict {
    label en official "section 1059(e)(3)(B)(i): actual rate of return";
    when dividends_during_holding_dollars_1059e3B(p, share, dividends);
    when lesser_of_basis_or_liquidation_preference_1059e3B(p, share, lesser);
    when lesser > 0.0;
    then actual_rate_of_return_1059e3Bi(p, share, div_round(dividends, lesser, 6, "HALF_UP"));
}
pub relation stated_annual_dividend_dollars_1059e3B(share: Asset, dollars: Decimal) kind empirical {
    label en official "section 1059(e)(3)(B)(ii): the annual qualified preferred dividend payable with respect to the share";
}
pub relation stated_rate_of_return_1059e3Bii(p: Person, share: Asset, rate: Decimal) kind institutional {
    label en official "section 1059(e)(3)(B)(ii): the annual dividend as a percentage of the lesser of basis and liquidation preference";
}
@source(IRC_S1059_E, relation = formalizes, coverage = exact, quote = "The stated rate of return shall be the annual rate of the qualified preferred dividend payable with respect to any share of stock")
rule StatedRateOfReturnRule(p: Person, share: Asset, annual: Decimal, lesser: Decimal) strict {
    label en official "section 1059(e)(3)(B)(ii): stated rate of return";
    when stated_annual_dividend_dollars_1059e3B(share, annual);
    when lesser_of_basis_or_liquidation_preference_1059e3B(p, share, lesser);
    when lesser > 0.0;
    then stated_rate_of_return_1059e3Bii(p, share, div_round(annual, lesser, 6, "HALF_UP"));
}
