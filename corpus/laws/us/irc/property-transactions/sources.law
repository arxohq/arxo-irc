// 26 U.S.C. 1287(a) — Denial of capital gain treatment for gains on certain obligations not in registered form
fragment IRC_S1287_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/1287/a";
    text en official """(a) In general
If any registration-required obligation is not in registered form, any gain on the sale or other disposition of such obligation shall be treated as ordinary income (unless the issuance of such obligation was subject to tax under section 4701).""";
    content_hash "sha256:720fa6492d38570d8dc14f7056497c3c4328cb470f596dc7138964bd9dc225e9";
}

// 26 U.S.C. 1287(b) — Denial of capital gain treatment for gains on certain obligations not in registered form
fragment IRC_S1287_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/1287/b";
    text en official """(b) Definitions
For purposes of subsection (a)—
(1) Registration-required obligation
The term "registration-required obligation" has the meaning given to such term by section 163(f)(2).
(2) Registered form
The term "registered form" has the same meaning as when used in section 163(f).""";
    content_hash "sha256:82f538bf4e4cc32edf3e7900946ca34a146cdf96a35d233043f7ffab071b9c5e";
}

