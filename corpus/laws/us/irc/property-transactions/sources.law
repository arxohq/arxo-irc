// 26 U.S.C. §1021 — Sale of annuities
fragment IRC_S1021 in IRC_2024_EDITION {
    kind section;
    locator "section/1021";
    text en official """Sale of annuities
In case of the sale of an annuity contract, the adjusted basis shall in no case be less than zero.""";
    content_hash "sha256:9639a13454de06c3759d44edad3e4a61335a7d9cf3940fd9a3ef171fca469100";
