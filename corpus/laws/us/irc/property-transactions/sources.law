// 26 U.S.C. 1397A(a) — Increase in expensing under section 179
fragment IRC_S1397A_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/1397A/a";
    text en official """(a) General rule
In the case of an enterprise zone business, for purposes of section 179—
(1) the limitation under section 179(b)(1) shall be increased by the lesser of—
(A) $35,000, or
(B) the cost of section 179 property which is qualified zone property placed in service during the taxable year, and
(2) the amount taken into account under section 179(b)(2) with respect to any section 179 property which is qualified zone property shall be 50 percent of the cost thereof.""";
    content_hash "sha256:cc9cbccc20e4eec5d3a5c61f212244524db036a64bc349c8b3de0e4218085b06";
}

// 26 U.S.C. 1397A(b) — Increase in expensing under section 179
fragment IRC_S1397A_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/1397A/b";
    text en official """(b) Recapture
Rules similar to the rules under section 179(d)(10) shall apply with respect to any qualified zone property which ceases to be used in an empowerment zone by an enterprise zone business.""";
    content_hash "sha256:7678f6958b623acf474d0cd308f1978277a5b92c5bf9c1e72d7819c63b25ff5d";
}

// 26 U.S.C. 1397A(c) — Increase in expensing under section 179
fragment IRC_S1397A_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/1397A/c";
    text en official """(c) Termination
This section shall not apply to any property placed in service in taxable years beginning after December 31, 2020.""";
    content_hash "sha256:4aab6d2646e68c8394346d17307ce57d1f809ce83d667de65c1457237e5294b3";
}

