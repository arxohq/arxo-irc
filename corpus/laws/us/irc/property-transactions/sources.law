    locator "section/1271/c";
    text en official """(c) Double inclusion in income not required
This section and sections 1272 and 1286 shall not require the inclusion of any amount previously includible in gross income.""";
    content_hash "sha256:a488f225bb459d19e49fc6fe8ceb90c6597282468a02442e30e2cd254ad61cca";
