    locator "section/1274#table/T1";
    text en official """ /  | Not over 3 years / The Federal short-term rate. | Over 3 years but    not over 9 years / The Federal mid-term rate. | Over 9 years / The Federal long-term rate.""";
    content_hash "sha256:728eb330e0b8d3f64a2db536e2c9a0e405dcf696e19ed642970ff032a42a7ad2";
