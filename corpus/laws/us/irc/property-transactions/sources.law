    locator "section/1257/note/4";
    text en official """Effective Date of 2003 Amendment
Amendment by Pub. L. 108–27 applicable, except as otherwise provided, to taxable years beginning after Dec. 31, 2002, see section 302(f) of Pub. L. 108–27, set out as an Effective and Termination Dates of 2003 Amendment note under section 1 of this title.""";
    content_hash "sha256:dc64f2259dda9ad995e47edf7d86b7def4ce024fdd4490789aafa5b225926721";
}

// 26 U.S.C. §1257 — statutory note 5 (effectivedate-note)
fragment IRC_S1257_NOTE_5 in IRC_2024_EDITION {
