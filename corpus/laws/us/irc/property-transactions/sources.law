// 26 U.S.C. 1036(a) — Stock for stock of same corporation
fragment IRC_S1036_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/1036/a";
    text en official """(a) General rule
No gain or loss shall be recognized if common stock in a corporation is exchanged solely for common stock in the same corporation, or if preferred stock in a corporation is exchanged solely for preferred stock in the same corporation.""";
    content_hash "sha256:8408c5ce0daf3fe913048a0e7db0e56ae94e7441da0953fc9bfe7fb9eaf963e4";
}

// 26 U.S.C. 1036(b) — Stock for stock of same corporation
fragment IRC_S1036_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/1036/b";
    text en official """(b) Nonqualified preferred stock not treated as stock
For purposes of this section, nonqualified preferred stock (as defined in section 351(g)(2)) shall be treated as property other than stock.""";
    content_hash "sha256:eb869432befa5f24c825dc07c06f624c18df4f3b0472b2a26a38b7e43056307e";
}

