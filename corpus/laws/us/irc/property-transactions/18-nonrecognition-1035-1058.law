// Stage 2c (IRC-07, A05). Nonrecognition and replacement-property sections not
// reached in stages 1-2b: §1035 (insurance and annuity contracts), §1036
// (stock for stock of the same corporation), §1037 (US obligations), §1038
// (reacquisition of real property), §1040 (§2032A property transfers), §1042
// (sales of stock to ESOPs and cooperatives), §1043 (certificates of
// divestiture), §1045 (rollover of QSBS), §1055 (redeemable ground rents),
// §1058 (securities loans).
//
// Vocabulary follows module 03 (§1033): a nonrecognition rule is `strict`,
// concludes `nonrecognition_exception_applies` and the recognized amount.
// Where the statute orders several properties ("in the order acquired") the
// allocation is TECH-GAPS G2305 (order-dependent running total).

// =============================================================================
// §1035: exchanges of insurance policies
// =============================================================================

use self::{
    Asset,
    IRC_S1035_A,
    IRC_S1035_B,
    IRC_S1036_A,
    IRC_S1037_A,
    IRC_S1037_B,
    IRC_S1038_A,
    IRC_S1038_B,
    IRC_S1038_C,
    IRC_S1038_D,
    IRC_S1040_A,
    IRC_S1040_C,
    IRC_S1042_A,
    IRC_S1042_B,
    IRC_S1042_C,
    IRC_S1042_D,
    IRC_S1042_E,
    IRC_S1042_F,
    IRC_S1042_G,
    IRC_S1043_A,
    IRC_S1045_A,
    IRC_S1055_A,
    IRC_S1055_C,
    IRC_S1058_A,
    IRC_S1058_B,
    IRC_S1058_C,
    Person,
    Transaction,
    gain_realized,
    gain_recognized,
    loss_recognized,
    nonrecognition_exception_applies,
    transfer_excepted_derived_1042e3,
};

pub enum InsuranceContractKind {
    LifeInsuranceContract;
    EndowmentContract;
    AnnuityContract;
    QualifiedLongTermCareContract;
    label en unofficial "the kinds of contract named in section 1035(a) and defined in (b)";
}
pub relation contract_with_insurance_company(c: Asset) kind empirical {
    label en official "section 1035(b)(1): a contract with an insurance company";
}
pub relation depends_in_part_on_life_expectancy(c: Asset) kind empirical {
    label en official "section 1035(b)(1): a contract which depends in part on the life expectancy of the insured";
}
pub relation payable_only_in_installments_during_annuitant_life(c: Asset) kind empirical {
    label en official "section 1035(b)(2): may be payable during the life of the annuitant only in installments";
}
pub relation ordinarily_payable_in_full_during_insured_life(c: Asset) kind empirical {
    label en official "section 1035(b)(3): ordinarily payable in full during the life of the insured";
}
pub relation qualified_long_term_care_insurance_contract(c: Asset) kind empirical {
    label en official "section 7702B(b) qualified long-term care insurance contract (owner: gross-income/other; asserted)";
}
pub relation insurance_contract_kind_1035(c: Asset, k: InsuranceContractKind) kind institutional {
    label en official "section 1035(b): the kind of contract for the exchange table";
}
@source(IRC_S1035_B, relation = formalizes, coverage = partial, quote = "A contract of endowment insurance is a contract with an insurance company which depends in part on the life expectancy of the insured")
rule EndowmentContractKindRule(c: Asset) defeasible {
    label en official "section 1035(b)(1): endowment contract (life-expectancy contract which may be paid in full during life); the LTC-rider saving sentences in (b)(2)-(3) are satisfied by construction (no test reads a rider)";
    when contract_with_insurance_company(c);
    when depends_in_part_on_life_expectancy(c);
    when ordinarily_payable_in_full_during_insured_life(c);
    when not_known(payable_only_in_installments_during_annuitant_life(c));
    then insurance_contract_kind_1035(c, EndowmentContract);
}
@source(IRC_S1035_B, relation = formalizes, coverage = partial, quote = "An annuity contract is a contract to which paragraph (1) applies but which may be payable during the life of the annuitant only in installments.")
rule AnnuityContractKindRule(c: Asset) defeasible {
    label en official "section 1035(b)(2): annuity contract";
    when contract_with_insurance_company(c);
    when depends_in_part_on_life_expectancy(c);
    when payable_only_in_installments_during_annuitant_life(c);
    then insurance_contract_kind_1035(c, AnnuityContract);
}
@source(IRC_S1035_B, relation = formalizes, coverage = partial, quote = "A contract of life insurance is a contract to which paragraph (1) applies but which is not ordinarily payable in full during the life of the insured.")
rule LifeInsuranceContractKindRule(c: Asset) defeasible {
    label en official "section 1035(b)(3): life insurance contract";
    when contract_with_insurance_company(c);
    when depends_in_part_on_life_expectancy(c);
    when not_known(payable_only_in_installments_during_annuitant_life(c));
    when not_known(ordinarily_payable_in_full_during_insured_life(c));
    then insurance_contract_kind_1035(c, LifeInsuranceContract);
}
rule LongTermCareContractKindRule(c: Asset) defeasible {
    label en unofficial "a qualified long-term care insurance contract is its own kind for the exchange table";
    when qualified_long_term_care_insurance_contract(c);
    then insurance_contract_kind_1035(c, QualifiedLongTermCareContract);
}
pub relation insurance_contract_exchange(t: Transaction, p: Person, given: Asset, received: Asset) kind empirical {
    label en official "an exchange of one contract for another (section 1035(a))";
}
pub relation endowment_payments_begin_no_later_than_exchanged_contract(t: Transaction) kind empirical {
    label en official "section 1035(a)(2)(A): the new endowment contract provides regular payments beginning at a date not later than the date payments would have begun under the contract exchanged";
}
pub relation exchange_transfers_to_non_us_person_under_regulation(t: Transaction) kind empirical {
    label en official "section 1035(c): the exchange has the effect of transferring property to a person other than a United States person, to the extent provided in regulations (EXTERNAL_DEPENDENCY)";
}
pub relation section_1035_exchange_qualifies(t: Transaction) kind institutional {
    label en official "section 1035(a): the exchange is one of the four permitted exchanges";
}
@source(IRC_S1035_A, relation = formalizes, coverage = partial, quote = "(1) a contract of life insurance for another contract of life insurance or for an endowment or annuity contract or for a qualified long-term care insurance contract;")
rule Exchange1035Paragraph1LifeForLifeRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(1): life insurance for life insurance";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, LifeInsuranceContract);
    when insurance_contract_kind_1035(r, LifeInsuranceContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
rule Exchange1035Paragraph1LifeForEndowmentRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(1): life insurance for an endowment contract";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, LifeInsuranceContract);
    when insurance_contract_kind_1035(r, EndowmentContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
rule Exchange1035Paragraph1LifeForAnnuityRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(1): life insurance for an annuity contract";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, LifeInsuranceContract);
    when insurance_contract_kind_1035(r, AnnuityContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
rule Exchange1035Paragraph1LifeForLtcRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(1): life insurance for a qualified long-term care contract";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, LifeInsuranceContract);
    when insurance_contract_kind_1035(r, QualifiedLongTermCareContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
@source(IRC_S1035_A, relation = formalizes, coverage = partial, quote = "(2) a contract of endowment insurance (A) for another contract of endowment insurance which provides for regular payments beginning at a date not later than the date payments would have begun under the contract exchanged")
rule Exchange1035Paragraph2EndowmentForEndowmentRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(2)(A): endowment for endowment with payments beginning no later";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, EndowmentContract);
    when insurance_contract_kind_1035(r, EndowmentContract);
    when endowment_payments_begin_no_later_than_exchanged_contract(t);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
rule Exchange1035Paragraph2EndowmentForAnnuityRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(2)(B): endowment for an annuity contract";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, EndowmentContract);
    when insurance_contract_kind_1035(r, AnnuityContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
rule Exchange1035Paragraph2EndowmentForLtcRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(2)(C): endowment for a qualified long-term care contract";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, EndowmentContract);
    when insurance_contract_kind_1035(r, QualifiedLongTermCareContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
@source(IRC_S1035_A, relation = formalizes, coverage = partial, quote = "(3) an annuity contract for an annuity contract or for a qualified long-term care insurance contract; or")
rule Exchange1035Paragraph3AnnuityForAnnuityRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(3): annuity for annuity";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, AnnuityContract);
    when insurance_contract_kind_1035(r, AnnuityContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
rule Exchange1035Paragraph3AnnuityForLtcRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(3): annuity for a qualified long-term care contract";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, AnnuityContract);
    when insurance_contract_kind_1035(r, QualifiedLongTermCareContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
@source(IRC_S1035_A, relation = formalizes, coverage = partial, quote = "(4) a qualified long-term care insurance contract for a qualified long-term care insurance contract.")
rule Exchange1035Paragraph4LtcForLtcRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a)(4): long-term care for long-term care";
    when insurance_contract_exchange(t, p, g, r);
    when insurance_contract_kind_1035(g, QualifiedLongTermCareContract);
    when insurance_contract_kind_1035(r, QualifiedLongTermCareContract);
    unless exchange_transfers_to_non_us_person_under_regulation(t);
    then section_1035_exchange_qualifies(t);
}
@source(IRC_S1035_A, relation = formalizes, coverage = partial, quote = "No gain or loss shall be recognized on the exchange of—")
rule Section1035NoGainOrLossRule(t: Transaction, p: Person, g: Asset, r: Asset) defeasible {
    label en official "section 1035(a): no gain or loss is recognized on a qualifying exchange (boot: section 1031(b)-(c), owned by module 03)";
    when section_1035_exchange_qualifies(t);
    when insurance_contract_exchange(t, p, g, r);
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
    then loss_recognized(p, t, 0.00 USD);
}

// =============================================================================
// §1036: stock for stock of the same corporation
// =============================================================================

pub relation stock_exchange_same_corporation(t: Transaction, p: Person, given: Asset, received: Asset, corp: Person) kind empirical {
    label en official "an exchange of stock in a corporation solely for stock in the same corporation (section 1036(a))";
}
pub relation common_stock_of(a: Asset, corp: Person) kind empirical {
    label en official "common stock of the corporation";
}
pub relation preferred_stock_of(a: Asset, corp: Person) kind empirical {
    label en official "preferred stock of the corporation";
}
pub relation nonqualified_preferred_stock(a: Asset) kind empirical {
    label en official "section 351(g)(2) nonqualified preferred stock (case-asserted; owner: corporations)";
}
pub relation other_property_or_boot_in_stock_exchange(t: Transaction) kind empirical {
    label en official "the exchange is not solely for stock of the same class (section 1031(b)-(c) governs the boot)";
}
@source(IRC_S1036_A, relation = formalizes, coverage = exact, quote = "No gain or loss shall be recognized if common stock in a corporation is exchanged solely for common stock in the same corporation")
rule Section1036CommonForCommonRule(t: Transaction, p: Person, g: Asset, r: Asset, corp: Person) strict {
    label en official "section 1036(a): common for common of the same corporation";
    when stock_exchange_same_corporation(t, p, g, r, corp);
    when common_stock_of(g, corp);
    when common_stock_of(r, corp);
    when not_known(other_property_or_boot_in_stock_exchange(t));
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
    then loss_recognized(p, t, 0.00 USD);
}
@source(IRC_S1036_A, relation = formalizes, coverage = exact, quote = "or if preferred stock in a corporation is exchanged solely for preferred stock in the same corporation.")
rule Section1036PreferredForPreferredRule(t: Transaction, p: Person, g: Asset, r: Asset, corp: Person) strict {
    label en official "section 1036(a) with (b): preferred for preferred of the same corporation; nonqualified preferred stock is property other than stock";
    when stock_exchange_same_corporation(t, p, g, r, corp);
    when preferred_stock_of(g, corp);
    when preferred_stock_of(r, corp);
    when not_known(nonqualified_preferred_stock(g));
    when not_known(nonqualified_preferred_stock(r));
    when not_known(other_property_or_boot_in_stock_exchange(t));
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
    then loss_recognized(p, t, 0.00 USD);
}

// =============================================================================
// §1037: exchanges of United States obligations
// =============================================================================

pub relation us_obligation_exchange(t: Transaction, p: Person, surrendered: Asset, received: Asset) kind empirical {
    label en official "surrender to the United States of chapter 31 of title 31 obligations in exchange solely for other obligations issued under that chapter (section 1037(a))";
}
pub relation regulations_provide_1037_nonrecognition(t: Transaction) kind empirical {
    label en official "section 1037(a): when so provided by regulations promulgated in connection with the issue of the obligations (EXTERNAL_DEPENDENCY: regulation text not pinned)";
}
@source(IRC_S1037_A, relation = formalizes, coverage = exact, quote = "no gain or loss shall be recognized on the surrender to the United States of obligations of the United States issued under chapter 31 of title 31 in exchange solely for other obligations issued under such chapter.")
rule Section1037NoGainOrLossRule(t: Transaction, p: Person, s: Asset, r: Asset) strict {
    label en official "section 1037(a)";
    when us_obligation_exchange(t, p, s, r);
    when regulations_provide_1037_nonrecognition(t);
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
    then loss_recognized(p, t, 0.00 USD);
}
pub relation stated_redemption_price_surrendered_obligation(t: Transaction, amount: Money) kind empirical {
    label en official "section 1037(b)(1)(B): the stated redemption price of the obligation surrendered in the exchange";
}
pub relation other_consideration_paid_to_united_states(t: Transaction, amount: Money) kind empirical {
    label en official "section 1037(b)(1)(B): other consideration paid to the United States as part of the exchange";
}
pub relation issue_price_of_obligation_received_1037(t: Transaction, amount: Money) kind institutional {
    label en official "section 1037(b)(1)(B): the issue price of the obligation received is the stated redemption price of the surrendered obligation increased by other consideration paid";
}
@source(IRC_S1037_B, relation = formalizes, coverage = partial, quote = "the issue price of the obligation received in the exchange shall be considered to be the stated redemption price of the obligation surrendered in the exchange, increased by the amount of other consideration (if any) paid to the United States as a part of the exchange.")
rule IssuePriceObligationReceivedRule(t: Transaction, srp: Money, other: Money) defeasible {
    label en official "section 1037(b)(1)(B)";
    when stated_redemption_price_surrendered_obligation(t, srp);
    when other_consideration_paid_to_united_states(t, other);
    then issue_price_of_obligation_received_1037(t, srp + other);
}
pub relation issue_price_of_surrendered_obligation(t: Transaction, amount: Money) kind empirical {
    label en official "the issue price of the obligation surrendered";
}
pub relation stated_redemption_price_at_exchange(t: Transaction, amount: Money) kind empirical {
    label en official "section 1037(b)(1)(A): the stated redemption price which applies at the time of the exchange";
}
pub relation section_1037_ordinary_income_ceiling(t: Transaction, amount: Money) kind institutional {
    label en official "section 1037(b)(1)(A): the aggregate amount treated as ordinary income does not exceed the difference between the issue price and the stated redemption price at the time of the exchange";
}
@source(IRC_S1037_B, relation = formalizes, coverage = partial, quote = "the aggregate amount considered, with respect to the obligation surrendered, as ordinary income shall not exceed the difference between the issue price and the stated redemption price which applies at the time of the exchange")
rule Section1037OrdinaryIncomeCeilingRule(t: Transaction, ip: Money, srp: Money) defeasible {
    label en official "section 1037(b)(1)(A): the ceiling is the discount (stated redemption price over issue price)";
    when issue_price_of_surrendered_obligation(t, ip);
    when stated_redemption_price_at_exchange(t, srp);
    when srp > ip;
    then section_1037_ordinary_income_ceiling(t, srp - ip);
}

// =============================================================================
// §1038: reacquisition of real property
// =============================================================================

pub relation seller_reacquires_real_property(t: Transaction, seller: Person, prop: Asset) kind empirical {
    label en official "section 1038(a): a sale of real property gave rise to indebtedness to the seller secured by the real property, and the seller reacquires it in partial or full satisfaction of the indebtedness";
}
pub relation money_and_property_received_before_reacquisition(t: Transaction, amount: Money) kind empirical {
    label en official "section 1038(b)(1)(A): money and the fair market value of other property (other than obligations of the purchaser) received prior to the reacquisition with respect to the sale";
}
pub relation prior_gain_returned_as_income(t: Transaction, amount: Money) kind empirical {
    label en official "section 1038(b)(1)(B), (b)(2)(A): the gain on the sale returned as income for periods prior to the reacquisition";
}
pub relation gross_sales_price_less_selling_expenses(t: Transaction, amount: Money) kind empirical {
    label en official "section 1038(b)(2), last sentence: the price at which the property was sold is the gross sales price reduced by selling commissions, legal fees and other expenses incident to the sale";
}
pub relation basis_of_property_sold_at_sale(t: Transaction, amount: Money) kind empirical {
    label en official "the adjusted basis of the real property in the seller's hands at the sale";
}
pub relation paid_by_seller_in_connection_with_reacquisition(t: Transaction, amount: Money) kind empirical {
    label en official "section 1038(b)(2)(B): money and the fair market value of other property (other than obligations of the purchaser) paid or transferred by the seller in connection with the reacquisition";
}
pub relation section_1038_gain_ceiling(t: Transaction, amount: Money) kind institutional {
    label en official "section 1038(b)(2): the ceiling on the gain resulting from the reacquisition";
}
@source(IRC_S1038_B, relation = formalizes, coverage = partial, quote = "shall not exceed the amount by which the price at which the real property was sold exceeded its adjusted basis, reduced by the sum of—")
rule Section1038GainCeilingRule(t: Transaction, price: Money, basis: Money, prior: Money, paid: Money) defeasible {
    label en official "section 1038(b)(2): ceiling = (price - adjusted basis) - (prior gain returned + amount paid by the seller); floored at zero";
    when gross_sales_price_less_selling_expenses(t, price);
    when basis_of_property_sold_at_sale(t, basis);
    when prior_gain_returned_as_income(t, prior);
    when paid_by_seller_in_connection_with_reacquisition(t, paid);
    when price - basis - (prior + paid) > 0.00 USD;
    then section_1038_gain_ceiling(t, price - basis - (prior + paid));
}
rule Section1038GainCeilingZeroRule(t: Transaction, price: Money, basis: Money, prior: Money, paid: Money) defeasible {
    label en official "section 1038(b)(2): the ceiling is zero when the reductions exhaust the excess of price over basis";
    when gross_sales_price_less_selling_expenses(t, price);
    when basis_of_property_sold_at_sale(t, basis);
    when prior_gain_returned_as_income(t, prior);
    when paid_by_seller_in_connection_with_reacquisition(t, paid);
    when price - basis - (prior + paid) <= 0.00 USD;
    then section_1038_gain_ceiling(t, 0.00 USD);
}
pub relation section_1038_gain_from_reacquisition(t: Transaction, amount: Money) kind institutional {
    label en official "section 1038(b): the gain resulting from the reacquisition, the lesser of the (b)(1) excess and the (b)(2) ceiling";
}
@source(IRC_S1038_B, relation = formalizes, coverage = partial, quote = "gain shall result from such reacquisition to the extent that—")
rule Section1038GainLimitedByCeilingRule(t: Transaction, received: Money, prior: Money, ceiling: Money) defeasible {
    label en official "section 1038(b)(1)-(2): gain is the excess of receipts over gain already returned, limited by the ceiling";
    when money_and_property_received_before_reacquisition(t, received);
    when prior_gain_returned_as_income(t, prior);
    when section_1038_gain_ceiling(t, ceiling);
    when received > prior;
    then section_1038_gain_from_reacquisition(t, min(received - prior, ceiling));
}
rule Section1038NoExcessNoGainRule(t: Transaction, received: Money, prior: Money) defeasible {
    label en official "section 1038(b)(1): no gain when the receipts do not exceed the gain already returned";
    when money_and_property_received_before_reacquisition(t, received);
    when prior_gain_returned_as_income(t, prior);
    when received <= prior;
    then section_1038_gain_from_reacquisition(t, 0.00 USD);
}
@source(IRC_S1038_A, relation = formalizes, coverage = partial, quote = "then, except as provided in subsections (b) and (d), no gain or loss shall result to the seller from such reacquisition, and no debt shall become worthless or partially worthless as a result of such reacquisition.")
rule Section1038ReacquisitionRecognizedGainRule(t: Transaction, seller: Person, prop: Asset, gain: Money) defeasible {
    label en official "section 1038(a)-(b): the only gain recognized on the reacquisition is the (b) amount (the (b)(3) sentence makes it recognized notwithstanding any other provision)";
    when seller_reacquires_real_property(t, seller, prop);
    when section_1038_gain_from_reacquisition(t, gain);
    then nonrecognition_exception_applies(seller, t);
    then gain_recognized(seller, t, gain);
    then loss_recognized(seller, t, 0.00 USD);
}
pub relation adjusted_basis_of_secured_indebtedness(t: Transaction, amount: Money) kind empirical {
    label en official "section 1038(c): the adjusted basis of the indebtedness to the seller secured by the property, determined as of the date of reacquisition";
}
pub relation reacquired_property_basis_1038(t: Transaction, amount: Money) kind institutional {
    label en official "section 1038(c): the basis of the reacquired real property";
}
@source(IRC_S1038_C, relation = formalizes, coverage = partial, quote = "the basis of such property upon such reacquisition shall be the adjusted basis of the indebtedness to the seller secured by such property (determined as of the date of reacquisition), increased by the sum of—")
rule Section1038ReacquiredBasisRule(t: Transaction, debt_basis: Money, gain: Money, paid: Money) defeasible {
    label en official "section 1038(c): basis = adjusted basis of the debt + (b) gain + the (b)(2)(B) amount paid";
    when adjusted_basis_of_secured_indebtedness(t, debt_basis);
    when section_1038_gain_from_reacquisition(t, gain);
    when paid_by_seller_in_connection_with_reacquisition(t, paid);
    then reacquired_property_basis_1038(t, debt_basis + gain + paid);
}
pub relation indebtedness_treated_as_worthless_before_reacquisition(t: Transaction, amount: Money) kind empirical {
    label en official "section 1038(d): indebtedness secured by the property which the seller treated as having become worthless or partially worthless before the reacquisition";
}
pub relation section_1038_deemed_receipt_on_reacquisition(t: Transaction, amount: Money) kind institutional {
    label en official "section 1038(d)(1): the seller is considered as receiving an amount equal to the indebtedness previously treated as worthless";
}
pub relation section_1038_debt_basis_increase(t: Transaction, amount: Money) kind institutional {
    label en official "section 1038(d)(2): the adjusted basis of the indebtedness is increased by the amount so considered as received";
}
@source(IRC_S1038_D, relation = formalizes, coverage = partial, quote = "such seller shall be considered as receiving, upon the reacquisition of such property, an amount equal to the amount of such indebtedness treated by him as having become worthless, and")
rule Section1038DeemedReceiptRule(t: Transaction, amount: Money) defeasible {
    label en official "section 1038(d)(1)";
    when indebtedness_treated_as_worthless_before_reacquisition(t, amount);
    then section_1038_deemed_receipt_on_reacquisition(t, amount);
}
@source(IRC_S1038_D, relation = formalizes, coverage = partial, quote = "the adjusted basis of such indebtedness shall be increased (as of the date of reacquisition) by an amount equal to the amount so considered as received by such seller.")
rule Section1038DebtBasisIncreaseRule(t: Transaction, amount: Money) defeasible {
    label en official "section 1038(d)(2)";
    when indebtedness_treated_as_worthless_before_reacquisition(t, amount);
    then section_1038_debt_basis_increase(t, amount);
}
pub relation indebtedness_not_discharged_on_reacquisition(t: Transaction) kind empirical {
    label en official "section 1038(c), last sentence: indebtedness secured by the property is not discharged upon the reacquisition";
}
pub relation undischarged_indebtedness_basis_zero(t: Transaction) kind institutional {
    label en official "section 1038(c), last sentence: the basis of the undischarged indebtedness is zero";
}
@source(IRC_S1038_C, relation = formalizes, coverage = exact, quote = "If any indebtedness to the seller secured by such property is not discharged upon the reacquisition of such property, the basis of such indebtedness shall be zero.")
rule UndischargedIndebtednessBasisZeroRule(t: Transaction) defeasible {
    label en official "section 1038(c), last sentence";
    when indebtedness_not_discharged_on_reacquisition(t);
    then undischarged_indebtedness_basis_zero(t);
}

// =============================================================================
// §1040: transfer of section 2032A property to a qualified heir
// =============================================================================

pub relation executor_transfers_2032a_property_to_qualified_heir(t: Transaction, executor: Person, prop: Asset) kind empirical {
    label en official "section 1040(a): the executor of the estate transfers to a qualified heir (section 2032A(e)(1)) property with respect to which a section 2032A election was made";
}
pub relation fmv_on_transfer_to_heir(t: Transaction, amount: Money) kind empirical {
    label en official "section 1040(a): the fair market value of the property on the date of the transfer";
}
pub relation chapter_11_value_without_2032a(t: Transaction, amount: Money) kind empirical {
    label en official "section 1040(a): the value of the property for chapter 11 purposes, determined without regard to section 2032A";
}
pub relation section_1040_gain_realized_by_estate(t: Transaction, amount: Money) kind empirical {
    label en unofficial "the gain realized by the estate on the transfer (from section 1001)";
}
pub relation section_1040_gain_recognized_by_estate(t: Transaction, amount: Money) kind institutional {
    label en official "section 1040(a): the gain recognized to the estate on the transfer";
}
@source(IRC_S1040_A, relation = formalizes, coverage = exact, quote = "then gain on such transfer shall be recognized to the estate only to the extent that, on the date of such transfer, the fair market value of such property exceeds the value of such property for purposes of chapter 11")
rule Section1040GainRecognizedRule(t: Transaction, fmv: Money, chapter11: Money, realized: Money) defeasible {
    label en official "section 1040(a): recognized gain is the excess of fair market value over the chapter 11 value, never more than the gain realized";
    when fmv_on_transfer_to_heir(t, fmv);
    when chapter_11_value_without_2032a(t, chapter11);
    when section_1040_gain_realized_by_estate(t, realized);
    when fmv > chapter11;
    then section_1040_gain_recognized_by_estate(t, min(realized, fmv - chapter11));
}
rule Section1040NoExcessNoGainRule(t: Transaction, fmv: Money, chapter11: Money) defeasible {
    label en official "section 1040(a): no gain is recognized when fair market value does not exceed the chapter 11 value";
    when fmv_on_transfer_to_heir(t, fmv);
    when chapter_11_value_without_2032a(t, chapter11);
    when fmv <= chapter11;
    then section_1040_gain_recognized_by_estate(t, 0.00 USD);
}
pub relation basis_immediately_before_transfer(t: Transaction, amount: Money) kind empirical {
    label en official "section 1040(c): the basis of the property immediately before the transfer";
}
pub relation basis_of_property_after_1040_transfer(t: Transaction, amount: Money) kind institutional {
    label en official "section 1040(c): the basis of property acquired in a transfer to which (a) applies";
}
@source(IRC_S1040_C, relation = formalizes, coverage = exact, quote = "shall be the basis of such property immediately before the transfer increased by the amount of the gain recognized to the estate or trust on the transfer.")
rule Section1040BasisRule(t: Transaction, before: Money, gain: Money) defeasible {
    label en official "section 1040(c)";
    when basis_immediately_before_transfer(t, before);
    when section_1040_gain_recognized_by_estate(t, gain);
    then basis_of_property_after_1040_transfer(t, before + gain);
}

// =============================================================================
// §1042: sales of stock to employee stock ownership plans or cooperatives
// =============================================================================

pub entity QualifiedSecuritiesSale : Transaction {
    label en official "a sale of qualified securities to which the section 1042(a) election may apply";
}
pub relation qualified_securities_sold(t: QualifiedSecuritiesSale, seller: Person, corp: Person, amount_realized: Money, sold_on: Date) kind empirical {
    label en official "section 1042(a): the sale of qualified securities, its amount realized and its date";
}
pub relation buyer_of(t: QualifiedSecuritiesSale, buyer: Person) kind empirical {
    label en unofficial "the purchaser of the qualified securities";
}
pub relation employee_stock_ownership_plan_4975e7(buyer: Person) kind empirical {
    label en official "section 1042(b)(1)(A): an employee stock ownership plan as defined in section 4975(e)(7) (owner: deferred-compensation/excise-entities; asserted)";
}
pub relation organization_subject_to_subchapter_t_part_i(o: Person) kind empirical {
    label en official "section 1042(c)(2)(A), (g)(3): an organization to which part I of subchapter T applies";
}
pub relation majority_of_membership_is_employees(o: Person) kind empirical {
    label en official "section 1042(c)(2)(B): a majority of the membership is composed of employees of the organization";
}
pub relation majority_of_voting_stock_owned_by_members(o: Person) kind empirical {
    label en official "section 1042(c)(2)(C): a majority of the voting stock is owned by members";
}
pub relation majority_of_board_elected_one_member_one_vote(o: Person) kind empirical {
    label en official "section 1042(c)(2)(D): a majority of the board of directors is elected by the members on the basis of 1 person 1 vote";
}
pub relation majority_of_earnings_allocated_by_patronage_or_capital(o: Person) kind empirical {
    label en official "section 1042(c)(2)(E): a majority of the allocated earnings and losses is allocated to members on the basis of patronage, capital contributions, or a combination";
}
pub relation eligible_worker_owned_cooperative(o: Person) kind institutional {
    label en official "section 1042(c)(2): an eligible worker-owned cooperative";
}
@source(IRC_S1042_C, relation = formalizes, coverage = exact, quote = "The term \"eligible worker-owned cooperative\" means any organization—")
rule EligibleWorkerOwnedCooperativeRule(o: Person) defeasible {
    label en official "section 1042(c)(2)(A)-(E)";
    when organization_subject_to_subchapter_t_part_i(o);
    when majority_of_membership_is_employees(o);
    when majority_of_voting_stock_owned_by_members(o);
    when majority_of_board_elected_one_member_one_vote(o);
    when majority_of_earnings_allocated_by_patronage_or_capital(o);
    then eligible_worker_owned_cooperative(o);
}
pub relation sold_to_esop_or_worker_cooperative(t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(b)(1): sold to an employee stock ownership plan or an eligible worker-owned cooperative";
}
@source(IRC_S1042_B, relation = formalizes, coverage = exact, quote = "(A) an employee stock ownership plan (as defined in section 4975(e)(7)), or")
rule SoldToEsopRule(t: QualifiedSecuritiesSale, buyer: Person) defeasible {
    label en official "section 1042(b)(1)(A)";
    when buyer_of(t, buyer);
    when employee_stock_ownership_plan_4975e7(buyer);
    then sold_to_esop_or_worker_cooperative(t);
}
@source(IRC_S1042_B, relation = formalizes, coverage = exact, quote = "(B) an eligible worker-owned cooperative.")
rule SoldToWorkerCooperativeRule(t: QualifiedSecuritiesSale, buyer: Person) defeasible {
    label en official "section 1042(b)(1)(B)";
    when buyer_of(t, buyer);
    when eligible_worker_owned_cooperative(buyer);
    then sold_to_esop_or_worker_cooperative(t);
}
pub relation buyer_owns_stock_percentage_after_sale(t: QualifiedSecuritiesSale, share: Decimal) kind empirical {
    label en official "section 1042(b)(2): the share of each class of outstanding stock (or of total value), after application of section 318(a)(4), owned by the plan or cooperative immediately after the sale";
}
pub relation verified_consent_statement_filed(t: QualifiedSecuritiesSale) kind empirical {
    label en official "section 1042(b)(3): the taxpayer files the verified written statement of the employer or cooperative officer consenting to the application of sections 4978 and 4979A";
}
pub relation holding_period_months_at_sale(t: QualifiedSecuritiesSale, months: Integer) kind empirical {
    label en official "section 1042(b)(4): the taxpayer's holding period of the qualified securities at the time of the sale, in complete months";
}
pub const Section1042MinimumOwnership: Decimal = 0.30 {
    label en official "at least 30 percent (section 1042(b)(2)); 100 percent for a farmers' cooperative sale under (g)(4)(B)";
};
pub const Section1042FarmersCooperativeOwnership: Decimal = 1.00 {
    label en official "100 percent substituted for 30 percent (section 1042(g)(4)(B))";
};
pub const Section1042MinimumHoldingMonths: Integer = 36 {
    label en official "at least 3 years (section 1042(b)(4)), counted here as 36 complete months";
};
pub relation cooperative_engaged_in_marketing_agricultural_products(o: Person) kind empirical {
    label en official "section 1042(g)(3): engaged in the marketing of agricultural or horticultural products";
}
pub relation eligible_farmers_cooperative(o: Person) kind institutional {
    label en official "section 1042(g)(3): an eligible farmers' cooperative";
}
@source(IRC_S1042_G, relation = formalizes, coverage = exact, quote = "the term \"eligible farmers' cooperative\" means an organization to which part I of subchapter T applies and which is engaged in the marketing of agricultural or horticultural products.")
rule EligibleFarmersCooperativeRule(o: Person) defeasible {
    label en official "section 1042(g)(3)";
    when organization_subject_to_subchapter_t_part_i(o);
    when cooperative_engaged_in_marketing_agricultural_products(o);
    then eligible_farmers_cooperative(o);
}
pub relation issuer_activities_are_refining_or_processing_agricultural_products(corp: Person) kind empirical {
    label en official "section 1042(g)(2)(A): substantially all of the activities consist of the active conduct of the trade or business of refining or processing agricultural or horticultural products";
}
pub relation issuer_bought_over_half_of_products_from_cooperative_or_its_farmers(corp: Person, t: QualifiedSecuritiesSale) kind empirical {
    label en official "section 1042(g)(2)(B): during the 1-year period ending on the date of the sale, purchased more than one-half of the products refined or processed from the farmers making up the purchasing cooperative, or from the cooperative";
}
pub relation domestic_corporation_1042g(corp: Person) kind empirical {
    label en official "section 1042(g)(2): a domestic corporation";
}
pub relation qualified_refiner_or_processor(corp: Person, t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(g)(2): a qualified refiner or processor";
}
@source(IRC_S1042_G, relation = formalizes, coverage = exact, quote = "the term \"qualified refiner or processor\" means a domestic corporation—")
rule QualifiedRefinerOrProcessorRule(corp: Person, t: QualifiedSecuritiesSale) defeasible {
    label en official "section 1042(g)(2)(A)-(B)";
    when domestic_corporation_1042g(corp);
    when issuer_activities_are_refining_or_processing_agricultural_products(corp);
    when issuer_bought_over_half_of_products_from_cooperative_or_its_farmers(corp, t);
    then qualified_refiner_or_processor(corp, t);
}
pub relation sale_to_eligible_farmers_cooperative(t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(g)(1): the sale is of stock of a qualified refiner or processor to an eligible farmers' cooperative";
}
@source(IRC_S1042_G, relation = formalizes, coverage = exact, quote = "This section shall apply to the sale of stock of a qualified refiner or processor to an eligible farmers' cooperative.")
rule SaleToFarmersCooperativeRule(t: QualifiedSecuritiesSale, buyer: Person, seller: Person, corp: Person, amount: Money, on: Date) defeasible {
    label en official "section 1042(g)(1)";
    when buyer_of(t, buyer);
    when eligible_farmers_cooperative(buyer);
    when qualified_securities_sold(t, seller, corp, amount, on);
    when qualified_refiner_or_processor(corp, t);
    then sale_to_eligible_farmers_cooperative(t);
}
pub relation section_1042_requirements_met(t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(b): the sale meets the requirements of subsection (b)";
}
@source(IRC_S1042_B, relation = formalizes, coverage = partial, quote = "A sale of qualified securities meets the requirements of this subsection if—")
rule Section1042RequirementsMetRule(t: QualifiedSecuritiesSale, share: Decimal, months: Integer) defeasible {
    label en official "section 1042(b)(1)-(4): buyer is an ESOP/cooperative owning at least 30 percent, statement filed, securities held at least 3 years";
    when sold_to_esop_or_worker_cooperative(t);
    when buyer_owns_stock_percentage_after_sale(t, share);
    when share >= Section1042MinimumOwnership;
    when verified_consent_statement_filed(t);
    when holding_period_months_at_sale(t, months);
    when months >= Section1042MinimumHoldingMonths;
    then section_1042_requirements_met(t);
}
@source(IRC_S1042_G, relation = formalizes, coverage = partial, quote = "subsection (b)(2) shall be applied by substituting \"100 percent\" for \"30 percent\" each place it appears,")
rule Section1042FarmersCooperativeRequirementsRule(t: QualifiedSecuritiesSale, share: Decimal, months: Integer) defeasible {
    label en official "section 1042(g)(4): a farmers' cooperative purchase requires 100 percent ownership; the cooperative is treated as an (b)(1)(B) cooperative";
    when sale_to_eligible_farmers_cooperative(t);
    when buyer_owns_stock_percentage_after_sale(t, share);
    when share >= Section1042FarmersCooperativeOwnership;
    when verified_consent_statement_filed(t);
    when holding_period_months_at_sale(t, months);
    when months >= Section1042MinimumHoldingMonths;
    then section_1042_requirements_met(t);
}
pub relation issuer_is_domestic_c_corporation_without_publicly_traded_stock(corp: Person) kind empirical {
    label en official "section 1042(c)(1)(A): issued by a domestic C corporation that has no stock outstanding readily tradable on an established securities market";
}
pub relation securities_are_employer_securities(t: QualifiedSecuritiesSale) kind empirical {
    label en official "section 1042(c)(1): employer securities as defined in section 409(l) (owner: deferred-compensation; asserted)";
}
pub relation securities_received_from_qualified_plan_or_option(t: QualifiedSecuritiesSale) kind empirical {
    label en official "section 1042(c)(1)(B): received in a distribution from a plan described in section 401(a), or in a transfer pursuant to an option to which section 83, 422 or 423 applied";
}
pub relation sold_by_underwriter_in_ordinary_course(t: QualifiedSecuritiesSale) kind empirical {
    label en official "section 1042(c)(5): a sale by an underwriter to an ESOP or cooperative in the ordinary course of trade or business as an underwriter";
}
pub relation gain_includible_in_gross_income_of_c_corporation(t: QualifiedSecuritiesSale) kind empirical {
    label en official "section 1042(c)(7): the gain on the sale is includible in the gross income of a C corporation";
}
pub relation section_1042_qualified_securities(t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(c)(1): the securities sold are qualified securities";
}
@source(IRC_S1042_C, relation = formalizes, coverage = partial, quote = "The term \"qualified securities\" means employer securities (as defined in section 409(l)) which—")
rule Section1042QualifiedSecuritiesRule(t: QualifiedSecuritiesSale, seller: Person, corp: Person, amount: Money, on: Date) defeasible {
    label en official "section 1042(c)(1)(A)-(B): employer securities of a domestic C corporation with no public stock, not received from a plan or option";
    when qualified_securities_sold(t, seller, corp, amount, on);
    when securities_are_employer_securities(t);
    when issuer_is_domestic_c_corporation_without_publicly_traded_stock(corp);
    when not_known(securities_received_from_qualified_plan_or_option(t));
    then section_1042_qualified_securities(t);
}
pub relation qualified_replacement_property(a: Asset) kind institutional {
    label en official "section 1042(c)(4): a security issued by a domestic operating corporation meeting (A)(i)-(ii)";
}
pub relation security_issued_by(a: Asset, issuer: Person) kind empirical {
    label en unofficial "the security is issued by the given corporation";
}
pub relation issuer_is_domestic_corporation(issuer: Person) kind empirical {
    label en official "section 1042(c)(4)(A): a domestic corporation";
}
pub relation more_than_half_of_assets_used_in_active_business(issuer: Person) kind empirical {
    label en official "section 1042(c)(4)(B)(i): more than 50 percent of the assets were, at the time the security was purchased or before the close of the replacement period, used in the active conduct of the trade or business";
}
pub relation issuer_is_financial_institution_or_insurance_company(issuer: Person) kind empirical {
    label en official "section 1042(c)(4)(B)(ii): a financial institution described in section 581 or an insurance company subject to tax under subchapter L";
}
pub relation operating_corporation_1042(issuer: Person) kind institutional {
    label en official "section 1042(c)(4)(B): an operating corporation";
}
@source(IRC_S1042_C, relation = formalizes, coverage = partial, quote = "The term \"operating corporation\" means a corporation more than 50 percent of the assets of which were, at the time the security was purchased or before the close of the replacement period, used in the active conduct of the trade or business.")
rule OperatingCorporationAssetTestRule(issuer: Person) defeasible {
    label en official "section 1042(c)(4)(B)(i)";
    when more_than_half_of_assets_used_in_active_business(issuer);
    then operating_corporation_1042(issuer);
}
@source(IRC_S1042_C, relation = formalizes, coverage = partial, quote = "(I) any financial institution described in section 581, and")
rule OperatingCorporationFinancialRule(issuer: Person) defeasible {
    label en official "section 1042(c)(4)(B)(ii)";
    when issuer_is_financial_institution_or_insurance_company(issuer);
    then operating_corporation_1042(issuer);
}
pub relation issued_by_domestic_operating_corporation(a: Asset, issuer: Person) kind institutional {
    label en official "section 1042(c)(4)(A): the security is issued by a domestic operating corporation";
}
rule IssuedByDomesticOperatingCorporationRule(a: Asset, issuer: Person) defeasible {
    label en official "section 1042(c)(4)(A), (B)";
    when security_issued_by(a, issuer);
    when issuer_is_domestic_corporation(issuer);
    when operating_corporation_1042(issuer);
    then issued_by_domestic_operating_corporation(a, issuer);
}
pub relation passive_income_over_25_percent_of_gross_receipts_preceding_year(issuer: Person) kind empirical {
    label en official "section 1042(c)(4)(A)(i): passive investment income (section 1362(d)(3)(C)) in the taxable year preceding the purchase exceeded 25 percent of gross receipts";
}
pub relation issuer_is_or_controlled_group_member_of_replaced_issuer(issuer: Person, replaced_issuer: Person) kind empirical {
    label en official "section 1042(c)(4)(A)(ii): the corporation which issued the qualified securities being replaced, or a member of the same controlled group (section 1563(a)(1))";
}
pub relation security_replaces_issuer_of(a: Asset, replaced_issuer: Person) kind empirical {
    label en official "the security is the replacement for qualified securities issued by the given corporation";
}
pub relation security_within_section_165g2(a: Asset) kind empirical {
    label en official "section 1042(c)(4)(D): a security as defined in section 165(g)(2), excluding any security issued by a government or political subdivision";
}
@source(IRC_S1042_C, relation = formalizes, coverage = partial, quote = "The term \"qualified replacement property\" means any security issued by a domestic operating corporation which—")
rule QualifiedReplacementPropertyRule(a: Asset, issuer: Person, replaced: Person) defeasible {
    label en official "section 1042(c)(4): domestic operating corporation, passive-income test, and not the replaced issuer or its controlled group";
    when security_within_section_165g2(a);
    when issued_by_domestic_operating_corporation(a, issuer);
    when security_replaces_issuer_of(a, replaced);
    when not_known(passive_income_over_25_percent_of_gross_receipts_preceding_year(issuer));
    when not_known(issuer_is_or_controlled_group_member_of_replaced_issuer(issuer, replaced));
    then qualified_replacement_property(a);
}
pub relation section_1042_replacement_period_start(t: QualifiedSecuritiesSale, on: Date) kind institutional {
    label en official "section 1042(c)(3): the replacement period begins 3 months before the date of the sale";
}
pub relation section_1042_replacement_period_end(t: QualifiedSecuritiesSale, on: Date) kind institutional {
    label en official "section 1042(c)(3): the replacement period ends 12 months after the date of the sale";
}
@source(IRC_S1042_C, relation = formalizes, coverage = exact, quote = "The term \"replacement period\" means the period which begins 3 months before the date on which the sale of qualified securities occurs and which ends 12 months after the date of such sale.")
rule Section1042ReplacementPeriodStartRule(t: QualifiedSecuritiesSale, seller: Person, corp: Person, amount: Money, on: Date, calendar_before_1: Date) defeasible {
    label en official "section 1042(c)(3): start (calendar months, not 30 days)";
    when qualified_securities_sold(t, seller, corp, amount, on)
        and us.irc.core::civil_calendar_boundary_before(on, 3, us.irc.core::CalendarMonth, calendar_before_1);
    then section_1042_replacement_period_start(t, calendar_before_1);
}
rule Section1042ReplacementPeriodEndRule(t: QualifiedSecuritiesSale, seller: Person, corp: Person, amount: Money, on: Date) defeasible {
    label en official "section 1042(c)(3): end";
    when qualified_securities_sold(t, seller, corp, amount, on);
    then section_1042_replacement_period_end(t, add_calendar_period(on, 12 calendar_month));
}
pub relation elects_1042(t: QualifiedSecuritiesSale, seller: Person) kind empirical {
    label en official "section 1042(a)(1): the taxpayer or executor elects, in the form the Secretary prescribes, the application of the section";
}
pub relation return_due_date_with_extensions_for_year_of_sale(t: QualifiedSecuritiesSale, due: Date) kind empirical {
    label en official "section 1042(c)(6): the last day prescribed by law (including extensions) for filing the return for the taxable year of the sale";
}
pub relation election_1042_filed_on(t: QualifiedSecuritiesSale, on: Date) kind empirical {
    label en official "the date the section 1042 election was filed";
}
pub relation election_1042_timely_and_available(t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(c)(6)-(7): the election is filed by the return due date and the seller is not a C corporation on the gain";
}
@source(IRC_S1042_C, relation = formalizes, coverage = partial, quote = "An election under subsection (a) shall be filed not later than the last day prescribed by law (including extensions thereof) for filing the return of tax imposed by this chapter for the taxable year in which the sale occurs.")
rule Section1042ElectionTimelyRule(t: QualifiedSecuritiesSale, filed: Date, due: Date) defeasible {
    label en official "section 1042(c)(6) and (c)(7)";
    when election_1042_filed_on(t, filed);
    when return_due_date_with_extensions_for_year_of_sale(t, due);
    when filed <= due;
    when not_known(gain_includible_in_gross_income_of_c_corporation(t));
    then election_1042_timely_and_available(t);
}
pub relation section_1042_nonrecognition_in_effect(t: QualifiedSecuritiesSale) kind institutional {
    label en official "section 1042(a): the elected nonrecognition treatment applies to the sale";
}
@source(IRC_S1042_A, relation = formalizes, coverage = partial, quote = "the taxpayer or executor elects in such form as the Secretary may prescribe the application of this section with respect to any sale of qualified securities,")
rule Section1042ElectionPower(t: QualifiedSecuritiesSale, seller: Person) strict {
    label en official "section 1042(a): the taxpayer's election is a power that switches the sale into the nonrecognition regime; valid when timely and the securities are qualified and the (b) requirements are met";
    when elects_1042(t, seller);
    then power Section1042Election {
        holder seller;
        over t;
        exercise elects_1042(t, seller);
        valid_when election_1042_valid(t);
        effect create(section_1042_nonrecognition_in_effect(t));
        window [@1986-07-18, infinity);
    };
}
relation election_1042_valid(t: QualifiedSecuritiesSale) kind institutional {
    label en unofficial "single-atom helper for valid_when (§130.3): timely election, qualified securities, (b) requirements met";
}
@source(IRC_S1042_A, relation = formalizes, coverage = partial, quote = "the requirements of subsection (b) are met with respect to such sale,")
rule Election1042ValidRule(t: QualifiedSecuritiesSale) defeasible {
    label en official "section 1042(a)(1), (a)(3), (b), (c)(6)-(7)";
    when election_1042_timely_and_available(t);
    when section_1042_qualified_securities(t);
    when section_1042_requirements_met(t);
    when not_known(sold_by_underwriter_in_ordinary_course(t));
    then election_1042_valid(t);
}
pub relation replacement_property_purchased(t: QualifiedSecuritiesSale, a: Asset, cost: Money, purchased_on: Date) kind empirical {
    label en official "section 1042(a)(2): qualified replacement property purchased, its cost and date";
}
pub relation cost_of_replacement_property_purchased_within_period(t: QualifiedSecuritiesSale, total: Money) kind institutional {
    label en official "section 1042(a): the total cost of the qualified replacement property purchased within the replacement period";
}
@source(IRC_S1042_A, relation = formalizes, coverage = partial, quote = "the taxpayer purchases qualified replacement property within the replacement period, and")
rule ReplacementCostWithinPeriodRule(t: QualifiedSecuritiesSale) defeasible {
    label en official "section 1042(a)(2): sum of the cost of qualified replacement property purchased inside the period";
    when section_1042_nonrecognition_in_effect(t);
    then cost_of_replacement_property_purchased_within_period(t, sum all cost: Money for a: Asset, purchased_on: Date where replacement_purchased_in_period(t, a, cost, purchased_on));
}
relation replacement_purchased_in_period(t: QualifiedSecuritiesSale, a: Asset, cost: Money, purchased_on: Date) kind institutional {
    label en unofficial "a qualified replacement property purchased inside the (c)(3) replacement period (helper for the aggregate)";
}
rule ReplacementPurchasedInPeriodRule(t: QualifiedSecuritiesSale, a: Asset, cost: Money, purchased_on: Date, start: Date, end: Date) defeasible {
    label en official "section 1042(a)(2), (c)(3)";
    when replacement_property_purchased(t, a, cost, purchased_on);
    when qualified_replacement_property(a);
    when section_1042_replacement_period_start(t, start);
    when section_1042_replacement_period_end(t, end);
    when purchased_on >= start;
    when purchased_on <= end;
    then replacement_purchased_in_period(t, a, cost, purchased_on);
}
pub relation section_1042_recognized_gain(t: QualifiedSecuritiesSale, amount: Money) kind institutional {
    label en official "section 1042(a): the gain recognized on the sale — the long-term capital gain part only to the extent the amount realized exceeds the cost of the replacement property";
}
pub relation long_term_capital_gain_on_1042_sale(t: QualifiedSecuritiesSale, amount: Money) kind empirical {
    label en official "section 1042(a): the gain on the sale which would be recognized as long-term capital gain";
}
@source(IRC_S1042_A, relation = formalizes, coverage = partial, quote = "then the gain (if any) on such sale which would be recognized as long-term capital gain shall be recognized only to the extent that the amount realized on such sale exceeds the cost to the taxpayer of such qualified replacement property.")
rule Section1042RecognizedGainRule(t: QualifiedSecuritiesSale, seller: Person, corp: Person, realized: Money, on: Date, cost: Money, ltcg: Money) defeasible {
    label en official "section 1042(a): recognized gain = min(long-term gain, amount realized - replacement cost) when positive";
    when qualified_securities_sold(t, seller, corp, realized, on);
    when section_1042_nonrecognition_in_effect(t);
    when cost_of_replacement_property_purchased_within_period(t, cost);
    when long_term_capital_gain_on_1042_sale(t, ltcg);
    when realized > cost;
    then section_1042_recognized_gain(t, min(ltcg, realized - cost));
}
rule Section1042FullyReinvestedRule(t: QualifiedSecuritiesSale, seller: Person, corp: Person, realized: Money, on: Date, cost: Money) defeasible {
    label en official "section 1042(a): no gain is recognized when the replacement cost is at least the amount realized";
    when qualified_securities_sold(t, seller, corp, realized, on);
    when section_1042_nonrecognition_in_effect(t);
    when cost_of_replacement_property_purchased_within_period(t, cost);
    when realized <= cost;
    then section_1042_recognized_gain(t, 0.00 USD);
}
pub relation section_1042_gain_not_recognized(t: QualifiedSecuritiesSale, amount: Money) kind institutional {
    label en official "section 1042(d): the gain not recognized by reason of the purchase and subsection (a)";
}
@source(IRC_S1042_D, relation = formalizes, coverage = partial, quote = "The basis of the taxpayer in qualified replacement property purchased by the taxpayer during the replacement period shall be reduced by the amount of gain not recognized by reason of such purchase and the application of subsection (a).")
rule Section1042GainNotRecognizedRule(t: QualifiedSecuritiesSale, ltcg: Money, recognized: Money) defeasible {
    label en official "section 1042(d): the unrecognized part of the long-term gain";
    when long_term_capital_gain_on_1042_sale(t, ltcg);
    when section_1042_recognized_gain(t, recognized);
    then section_1042_gain_not_recognized(t, ltcg - recognized);
}
pub relation section_1042_basis_reduction_for_item(t: QualifiedSecuritiesSale, a: Asset, amount: Money) kind institutional {
    label en official "section 1042(d): the basis reduction allocated to one item of qualified replacement property, in the ratio of its cost to the total cost";
}
@source(IRC_S1042_D, relation = formalizes, coverage = partial, quote = "(1) the numerator of which is the cost of such item of property, and")
rule Section1042BasisReductionPerItemRule(t: QualifiedSecuritiesSale, a: Asset, cost: Money, purchased_on: Date, total: Money, not_recognized: Money) defeasible {
    label en official "section 1042(d): gain not recognized x cost of the item / total cost (cents HALF_UP: JUDGMENT CALL)";
    when replacement_purchased_in_period(t, a, cost, purchased_on);
    when cost_of_replacement_property_purchased_within_period(t, total);
    when section_1042_gain_not_recognized(t, not_recognized);
    when total > 0.00 USD;
    then section_1042_basis_reduction_for_item(t, a, div_round(not_recognized * (cost / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation disposes_of_qualified_replacement_property(t: QualifiedSecuritiesSale, a: Asset, disposed_on: Date) kind empirical {
    label en official "section 1042(e)(1): the taxpayer disposes of qualified replacement property";
}
pub relation disposition_excepted_1042e3(t: QualifiedSecuritiesSale, a: Asset) kind empirical {
    label en official "section 1042(e)(3): a transfer in a qualifying reorganization, by death, by gift, or in a transaction to which section 1042(a) applies";
}
pub relation section_1042_deferred_gain_recognized_on_disposition(t: QualifiedSecuritiesSale, a: Asset, amount: Money) kind institutional {
    label en official "section 1042(e)(1): gain is recognized to the extent of the gain not recognized under (a) by reason of acquiring the property";
}
@source(IRC_S1042_E, relation = formalizes, coverage = partial, quote = "gain (if any) shall be recognized to the extent of the gain which was not recognized under subsection (a) by reason of the acquisition by such taxpayer of such qualified replacement property.")
rule Section1042RecaptureOnDispositionRule(t: QualifiedSecuritiesSale, a: Asset, on: Date, reduction: Money) defeasible {
    label en official "section 1042(e)(1): recapture = the basis reduction attributable to the disposed property";
    when disposes_of_qualified_replacement_property(t, a, on);
    when section_1042_basis_reduction_for_item(t, a, reduction);
    when not_known(disposition_excepted_1042e3(t, a));
    when not_known(transfer_excepted_derived_1042e3(t, a));
    then section_1042_deferred_gain_recognized_on_disposition(t, a, reduction);
}
pub relation issuing_corporation_disposes_of_substantial_assets_outside_ordinary_course(a: Asset) kind empirical {
    label en official "section 1042(e)(2)(A): the corporation issuing the qualified replacement property disposes of a substantial portion of its assets other than in the ordinary course of business";
}
pub relation taxpayer_owning_control_holds_replacement_property_at_disposition(t: QualifiedSecuritiesSale, a: Asset) kind empirical {
    label en official "section 1042(e)(2)(B): a taxpayer owning stock representing control (section 304(c)) holds the replacement property at that time";
}
pub relation replacement_property_treated_as_disposed(t: QualifiedSecuritiesSale, a: Asset) kind institutional {
    label en official "section 1042(e)(2): the taxpayer is treated as having disposed of the qualified replacement property at that time";
}
@source(IRC_S1042_E, relation = formalizes, coverage = partial, quote = "then the taxpayer shall be treated as having disposed of such qualified replacement property at such time.")
rule Section1042CorporateAssetDispositionRule(t: QualifiedSecuritiesSale, a: Asset) defeasible {
    label en official "section 1042(e)(2)";
    when issuing_corporation_disposes_of_substantial_assets_outside_ordinary_course(a);
    when taxpayer_owning_control_holds_replacement_property_at_disposition(t, a);
    then replacement_property_treated_as_disposed(t, a);
}
pub relation section_1042_notification_date(t: QualifiedSecuritiesSale, on: Date) kind empirical {
    label en official "section 1042(f)(1): the date the Secretary is notified by the taxpayer of the replacement cost, of the intention not to purchase, or of the failure to purchase within the replacement period";
}
pub relation assessment_period_not_expiring_before_1042(t: QualifiedSecuritiesSale, on: Date) kind institutional {
    label en official "section 1042(f)(1): the assessment period for a deficiency with respect to the gain does not expire before 3 years from the notification date";
}
@source(IRC_S1042_F, relation = formalizes, coverage = partial, quote = "the statutory period for the assessment of any deficiency with respect to such gain shall not expire before the expiration of 3 years from the date the Secretary is notified by the taxpayer")
rule Section1042AssessmentPeriodRule(t: QualifiedSecuritiesSale, notified: Date) defeasible {
    label en official "section 1042(f)(1): floor of 3 calendar years from notification; (f)(2) permits assessment within that period notwithstanding other law";
    when section_1042_nonrecognition_in_effect(t);
    when section_1042_notification_date(t, notified);
    then assessment_period_not_expiring_before_1042(t, add_calendar_period(notified, 3 calendar_year));
}

// =============================================================================
// §1043: sales of property pursuant to certificates of divestiture
// =============================================================================

pub relation sale_pursuant_to_certificate_of_divestiture(t: Transaction, seller: Person, amount_realized: Money) kind empirical {
    label en official "section 1043(a): an eligible person sells property pursuant to a certificate of divestiture";
}
pub relation seller_is_eligible_person_1043(seller: Person) kind empirical {
    label en official "section 1043(b)(1),(5): a federal executive or judicial officer or employee (not a special Government employee), an attributable spouse or minor/dependent child, or a trustee of a trust for such a person";
}
pub relation certificate_of_divestiture_valid(t: Transaction) kind empirical {
    label en official "section 1043(b)(2): a written determination by the President, the Director of the Office of Government Ethics, or the Judicial Conference (or designee) that identifies the specific property and states that divestiture is reasonably necessary to comply with a conflict-of-interest rule";
}
pub relation elects_1043(t: Transaction, seller: Person) kind empirical {
    label en official "section 1043(a): the taxpayer elects the application of the section";
}
pub relation permitted_property_cost_within_60_days(t: Transaction, amount: Money) kind empirical {
    label en official "section 1043(a), (b)(3)-(4): the cost of permitted property (obligations of the United States or an approved diversified investment fund) purchased during the 60-day period beginning on the date of the sale";
}
pub relation section_1043_recognized_gain(t: Transaction, amount: Money) kind institutional {
    label en official "section 1043(a): the gain recognized on the sale";
}
@source(IRC_S1043_A, relation = formalizes, coverage = exact, quote = "gain from such sale shall be recognized only to the extent that the amount realized on such sale exceeds the cost (to the extent not previously taken into account under this subsection) of any permitted property purchased by the taxpayer during the 60-day period beginning on the date of such sale.")
rule Section1043RecognizedGainRule(t: Transaction, seller: Person, realized: Money, cost: Money, gain: Money) defeasible {
    label en official "section 1043(a): recognized gain = min(gain realized, amount realized - cost of permitted property)";
    when sale_pursuant_to_certificate_of_divestiture(t, seller, realized);
    when seller_is_eligible_person_1043(seller);
    when certificate_of_divestiture_valid(t);
    when elects_1043(t, seller);
    when permitted_property_cost_within_60_days(t, cost);
    when gain_realized(seller, t, gain);
    when realized > cost;
    then section_1043_recognized_gain(t, min(gain, realized - cost));
}
rule Section1043FullyReinvestedRule(t: Transaction, seller: Person, realized: Money, cost: Money) defeasible {
    label en official "section 1043(a): no gain is recognized when permitted property costs at least the amount realized";
    when sale_pursuant_to_certificate_of_divestiture(t, seller, realized);
    when seller_is_eligible_person_1043(seller);
    when certificate_of_divestiture_valid(t);
    when elects_1043(t, seller);
    when permitted_property_cost_within_60_days(t, cost);
    when realized <= cost;
    then section_1043_recognized_gain(t, 0.00 USD);
}

// =============================================================================
// §1045: rollover of gain from qualified small business stock
// =============================================================================

pub relation sale_of_qsbs_rollover(t: Transaction, seller: Person, amount_realized: Money, sold_on: Date) kind empirical {
    label en official "section 1045(a): a sale of qualified small business stock by a taxpayer other than a corporation";
}
pub relation seller_is_not_a_corporation_1045(seller: Person) kind empirical {
    label en official "section 1045(a): the taxpayer is other than a corporation";
}
pub relation qsbs_holding_period_months_at_sale(t: Transaction, months: Integer) kind empirical {
    label en official "section 1045(a),(b)(4)(A): the holding period of the sold stock, determined without regard to section 1223, in complete months";
}
pub relation elects_1045(t: Transaction, seller: Person) kind empirical {
    label en official "section 1045(a): the taxpayer elects the application of the section";
}
pub relation replacement_qsbs_cost_within_60_days(t: Transaction, amount: Money) kind empirical {
    label en official "section 1045(a)(1): the cost of qualified small business stock purchased during the 60-day period beginning on the date of the sale";
}
pub relation replacement_qsbs_cost_previously_used(t: Transaction, amount: Money) kind empirical {
    label en official "section 1045(a)(2): any portion of the cost previously taken into account under this section";
}
pub relation gain_treated_as_ordinary_income(t: Transaction) kind empirical {
    label en official "section 1045(a), last sentence: the gain is treated as ordinary income for purposes of this title";
}
pub const Section1045MinimumHoldingMonths: Integer = 6 {
    label en official "held for more than 6 months (section 1045(a))";
};
pub relation section_1045_recognized_gain(t: Transaction, amount: Money) kind institutional {
    label en official "section 1045(a): the gain recognized on the sale";
}
@source(IRC_S1045_A, relation = formalizes, coverage = partial, quote = "gain from such sale shall be recognized only to the extent that the amount realized on such sale exceeds—")
rule Section1045RecognizedGainRule(t: Transaction, seller: Person, realized: Money, on: Date, months: Integer, cost: Money, used: Money, gain: Money) defeasible {
    label en official "section 1045(a): recognized gain = min(gain, amount realized - (new QSBS cost - portion previously used)); held for more than 6 months, non-corporate, elected, and not ordinary income";
    when sale_of_qsbs_rollover(t, seller, realized, on);
    when seller_is_not_a_corporation_1045(seller);
    when elects_1045(t, seller);
    when qsbs_holding_period_months_at_sale(t, months);
    when months > Section1045MinimumHoldingMonths;
    when replacement_qsbs_cost_within_60_days(t, cost);
    when replacement_qsbs_cost_previously_used(t, used);
    when gain_realized(seller, t, gain);
    when not_known(gain_treated_as_ordinary_income(t));
    when realized > cost - used;
    then section_1045_recognized_gain(t, min(gain, realized - (cost - used)));
}
rule Section1045FullyReinvestedRule(t: Transaction, seller: Person, realized: Money, on: Date, months: Integer, cost: Money, used: Money) defeasible {
    label en official "section 1045(a): no gain recognized when the net replacement cost is at least the amount realized";
    when sale_of_qsbs_rollover(t, seller, realized, on);
    when seller_is_not_a_corporation_1045(seller);
    when elects_1045(t, seller);
    when qsbs_holding_period_months_at_sale(t, months);
    when months > Section1045MinimumHoldingMonths;
    when replacement_qsbs_cost_within_60_days(t, cost);
    when replacement_qsbs_cost_previously_used(t, used);
    when not_known(gain_treated_as_ordinary_income(t));
    when realized <= cost - used;
    then section_1045_recognized_gain(t, 0.00 USD);
}

// =============================================================================
// §1055: redeemable ground rents
// =============================================================================

pub relation ground_rent_lease_assignable_over_15_years(r: Asset) kind empirical {
    label en official "section 1055(c)(1): a lease of land assignable by the lessee without the lessor's consent, for a term (with lessee-option renewals) in excess of 15 years";
}
pub relation leaseholder_statutory_right_to_acquire_lessor_interest(r: Asset) kind empirical {
    label en official "section 1055(c)(2): the leaseholder has a present or future right to terminate and acquire the entire interest of the lessor by payment of a determined or determinable amount, by virtue of State or local law and not private agreement";
}
pub relation lessor_interest_primarily_security_interest(r: Asset) kind empirical {
    label en official "section 1055(c)(3): the lessor's interest in the land is primarily a security interest to protect the rental payments";
}
pub relation redeemable_ground_rent(r: Asset) kind institutional {
    label en official "section 1055(c): a redeemable ground rent";
}
@source(IRC_S1055_C, relation = formalizes, coverage = exact, quote = "the term \"redeemable ground rent\" means only a ground rent with respect to which—")
rule RedeemableGroundRentRule(r: Asset) defeasible {
    label en official "section 1055(c)(1)-(3)";
    when ground_rent_lease_assignable_over_15_years(r);
    when leaseholder_statutory_right_to_acquire_lessor_interest(r);
    when lessor_interest_primarily_security_interest(r);
    then redeemable_ground_rent(r);
}
pub relation real_property_held_subject_to_ground_rent(a: Asset, r: Asset) kind empirical {
    label en official "real property held subject to liabilities under the ground rent";
}
pub relation treated_as_mortgage_1055(r: Asset) kind institutional {
    label en official "section 1055(a)(1): the redeemable ground rent is treated as being in the nature of a mortgage";
}
pub relation property_treated_as_held_subject_to_mortgage_1055(a: Asset) kind institutional {
    label en official "section 1055(a)(2): real property held subject to liabilities under a redeemable ground rent is treated as held subject to liabilities under a mortgage";
}
@source(IRC_S1055_A, relation = formalizes, coverage = exact, quote = "a redeemable ground rent shall be treated as being in the nature of a mortgage, and")
rule GroundRentTreatedAsMortgageRule(r: Asset) defeasible {
    label en official "section 1055(a)(1)";
    when redeemable_ground_rent(r);
    then treated_as_mortgage_1055(r);
}
@source(IRC_S1055_A, relation = formalizes, coverage = exact, quote = "real property held subject to liabilities under a redeemable ground rent shall be treated as held subject to liabilities under a mortgage.")
rule PropertyUnderGroundRentTreatedAsMortgagedRule(a: Asset, r: Asset) defeasible {
    label en official "section 1055(a)(2)";
    when redeemable_ground_rent(r);
    when real_property_held_subject_to_ground_rent(a, r);
    then property_treated_as_held_subject_to_mortgage_1055(a);
}

// =============================================================================
// §1058: transfers of securities under certain agreements
// =============================================================================

pub relation securities_loan_transfer(t: Transaction, transferor: Person, securities: Asset) kind empirical {
    label en official "section 1058(a): a taxpayer transfers securities (section 1236(c)) pursuant to an agreement described in subsection (b)";
}
pub relation agreement_provides_return_of_identical_securities(t: Transaction) kind empirical {
    label en official "section 1058(b)(1): provides for the return to the transferor of securities identical to the securities transferred";
}
pub relation agreement_requires_payments_of_equivalent_distributions(t: Transaction) kind empirical {
    label en official "section 1058(b)(2): requires payments to the transferor of amounts equivalent to all interest, dividends and other distributions the owner is entitled to receive during the loan period";
}
pub relation agreement_does_not_reduce_transferor_risk_or_opportunity(t: Transaction) kind empirical {
    label en official "section 1058(b)(3): does not reduce the risk of loss or opportunity for gain of the transferor in the securities transferred";
}
pub relation agreement_meets_regulatory_requirements_1058b4(t: Transaction) kind empirical {
    label en official "section 1058(b)(4): meets such other requirements as the Secretary prescribes by regulation (EXTERNAL_DEPENDENCY)";
}
pub relation section_1058_agreement_qualifies(t: Transaction) kind institutional {
    label en official "section 1058(b): the agreement meets the requirements of subsection (b)";
}
@source(IRC_S1058_B, relation = formalizes, coverage = partial, quote = "In order to meet the requirements of this subsection, an agreement shall—")
rule Section1058AgreementQualifiesRule(t: Transaction) defeasible {
    label en official "section 1058(b)(1)-(4)";
    when agreement_provides_return_of_identical_securities(t);
    when agreement_requires_payments_of_equivalent_distributions(t);
    when agreement_does_not_reduce_transferor_risk_or_opportunity(t);
    when agreement_meets_regulatory_requirements_1058b4(t);
    then section_1058_agreement_qualifies(t);
}
@source(IRC_S1058_A, relation = formalizes, coverage = partial, quote = "no gain or loss shall be recognized on the exchange of such securities by the taxpayer for an obligation under such agreement")
rule Section1058NoGainOrLossRule(t: Transaction, p: Person, s: Asset) defeasible {
    label en official "section 1058(a): no gain or loss on the exchange of securities for the obligation under a qualifying agreement (and, on the way back, of rights for identical securities)";
    when securities_loan_transfer(t, p, s);
    when section_1058_agreement_qualifies(t);
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
    then loss_recognized(p, t, 0.00 USD);
}
pub relation basis_of_securities_transferred_1058(t: Transaction, amount: Money) kind empirical {
    label en official "section 1058(c): the basis of the property transferred";
}
pub relation basis_of_property_acquired_1058(t: Transaction, amount: Money) kind institutional {
    label en official "section 1058(c): property acquired in the transaction has the same basis as the property transferred";
}
@source(IRC_S1058_C, relation = formalizes, coverage = exact, quote = "shall have the same basis as the property transferred by that taxpayer.")
rule Section1058SubstitutedBasisRule(t: Transaction, p: Person, s: Asset, basis: Money) defeasible {
    label en official "section 1058(c)";
    when securities_loan_transfer(t, p, s);
    when section_1058_agreement_qualifies(t);
    when basis_of_securities_transferred_1058(t, basis);
    then basis_of_property_acquired_1058(t, basis);
}
