// Nonrecognition provisions: section 1031 (like-kind exchanges), section
// 1033 (involuntary conversions) and section 1041 (transfers between
// spouses / incident to divorce). Each module here ASSERTS
// `nonrecognition_exception_applies(p, t)` (declared in module 01) and
// concludes its OWN `gain_recognized`/`loss_recognized` fact for the
// transactions it covers, so the section 1001(c) default rule (guarded by
// `not_known(nonrecognition_exception_applies(...))`) never also fires for
// the same transaction — no `priority` arbitration needed (the switch is
// exclusive by construction).



// =============================================================================
// Section 1031: like-kind exchanges (REAL PROPERTY ONLY, post-TCJA text)
// =============================================================================

use self::{
    Asset,
    IRC_S1031_A,
    IRC_S1031_B,
    IRC_S1031_C,
    IRC_S1031_D,
    IRC_S1031_F,
    IRC_S1031_H,
    IRC_S1033_A,
    IRC_S1033_B,
    IRC_S1041_A,
    IRC_S1041_B,
    IRC_S1041_C,
    IRC_S1041_E,
    Person,
    Transaction,
    acquired_by_gift,
    gain_realized,
    gain_recognized,
    longer_replacement_period_applies_1033,
    loss_realized,
    loss_recognized,
    nonrecognition_exception_applies,
    section_1033a_unavailable_by_related_acquisition,
    section_1041_transfer,
    substituted_basis_from,
    treated_as_involuntary_conversion,
};

pub relation like_kind_exchange(t: Transaction, p: Person, relinquished: Asset, received: Asset, transfer_date: Date) kind empirical {
    label en unofficial "an exchange of real property held for productive use in a trade or business or for investment, for real property of like kind to be held either for productive use in a trade or business or for investment (section 1031(a)(1))";
}
pub relation real_property(a: Asset) kind institutional {
    label en unofficial "the asset is real property (as distinguished from personal property) for purposes of section 1031(a)(1)";
}
pub relation like_kind(a1: Asset, a2: Asset) kind institutional {
    label en unofficial "two items of real property are of like kind (section 1031(a)(1)) — real property located in the United States and real property located outside the United States are NOT of like kind (section 1031(h))";
}
pub relation held_for_productive_use_or_investment(p: Person, a: Asset) kind empirical {
    label en unofficial "the property is held for productive use in a trade or business, or for investment";
}
pub relation held_primarily_for_sale(p: Person, a: Asset) kind empirical {
    label en official "real property held primarily for sale (section 1031(a)(2) exclusion)";
}
pub relation us_real_property(a: Asset) kind empirical {
    label en unofficial "real property located in the United States (section 1031(h))";
}

@source(IRC_S1031_H, quote = "Real property located in the United States and real property located outside the United States are not property of a like kind.")
rule LikeKindOnlyWhenBothUsRealPropertyRule(a1: Asset, a2: Asset) strict {
    label en official "section 1031(h): real property is of like kind to other real property only when BOTH are located in the United States (or, symmetrically, both outside) — modelled directly for the both-US case, the operative case for the priority scenarios";
    when real_property(a1);
    when real_property(a2);
    when us_real_property(a1);
    when us_real_property(a2);
    then like_kind(a1, a2);
}

// (a)(3): the 45-day identification / 180-day (or due-date-with-
// extensions) exchange-period deadlines are VALIDITY conditions on the
// "like-kind property" characterization of the property received, not an
// election — property received late or unidentified is treated as NOT
// like-kind property, so gain is recognized as boot.
pub relation relinquished_property_transferred_on(t: Transaction, on: Date) kind empirical {
    label en official "the date the taxpayer transfers the property relinquished in the exchange";
}
pub relation identified_on_or_before(t: Transaction, received: Asset, identified_on: Date) kind empirical {
    label en official "the date the property to be received in the exchange is identified (section 1031(a)(3)(A))";
}
pub relation received_on(t: Transaction, received: Asset, received_on: Date) kind empirical {
    label en official "the date the property received in the exchange is actually received";
}
pub relation transferor_return_due_date(t: Transaction, due_date: Date) kind institutional {
    label en unofficial "the due date (with regard to extension) for the transferor's return for the taxable year in which the transfer of the relinquished property occurs (section 1031(a)(3)(B)(ii))";
}

@source(IRC_S1031_A, quote = "such property is not identified as property to be received in the exchange on or before the day which is 45 days after the date on which the taxpayer transfers the property relinquished in the exchange")
rule NotLikeKindPropertyIfNotIdentifiedWithin45DaysRule(t: Transaction, relinquished: Asset, received: Asset, transferred_on: Date, identified_on: Date) strict {
    label en official "section 1031(a)(3)(A): property not identified within 45 days after the relinquished-property transfer is treated as not like-kind property";
    when relinquished_property_transferred_on(t, transferred_on);
    when identified_on_or_before(t, received, identified_on);
    when identified_on > add_calendar_period(transferred_on, 45 calendar_day);
    then treated_as_not_like_kind_property(t, received);
}
@source(IRC_S1031_A, quote = "the day which is 180 days after the date on which the taxpayer transfers the property relinquished in the exchange, or")
rule NotLikeKindPropertyIfReceivedAfter180DaysOrReturnDueDateRule(t: Transaction, relinquished: Asset, received: Asset, transferred_on: Date, received_at: Date, due_date: Date) defeasible {
    label en official "section 1031(a)(3)(B): property received after the earlier of 180 days after the relinquished-property transfer, or the transferor's return due date (with extensions), is treated as not like-kind property";
    when relinquished_property_transferred_on(t, transferred_on);
    when received_on(t, received, received_at);
    when transferor_return_due_date(t, due_date);
    when received_at > min(add_calendar_period(transferred_on, 180 calendar_day), due_date);
    then treated_as_not_like_kind_property(t, received);
}
pub relation treated_as_not_like_kind_property(t: Transaction, received: Asset) kind institutional {
    label en official "property treated, under section 1031(a)(3), as NOT like-kind property (untimely identification or receipt) — such property is boot, not nonrecognition property";
}

@source(IRC_S1031_A, quote = "No gain or loss shall be recognized on the exchange of real property held for productive use in a trade or business or for investment if such real property is exchanged solely for real property of like kind which is to be held either for productive use in a trade or business or for investment.")
rule LikeKindExchangeNonrecognitionRule(p: Person, t: Transaction, relinquished: Asset, received: Asset, transfer_date: Date) defeasible {
    label en official "section 1031(a)(1): no gain or loss is recognized on a like-kind exchange of real property held for productive use/investment, solely for real property of like kind similarly held";
    when like_kind_exchange(t, p, relinquished, received, transfer_date);
    when real_property(relinquished);
    when real_property(received);
    when like_kind(relinquished, received);
    when held_for_productive_use_or_investment(p, relinquished);
    when held_for_productive_use_or_investment(p, received);
    when not_known(held_primarily_for_sale(p, relinquished));
    when not_known(treated_as_not_like_kind_property(t, received));
    when not_known(boot_received(t, p));
    when not_known(section_1031f_related_party_disqualification(p, t));
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
    then loss_recognized(p, t, 0.00 USD);
}

// (b): boot — money or other (non-like-kind) property received alongside
// like-kind property. Gain recognized is the LESSER of realized gain, or
// the money plus the FMV of the other property received.
pub relation boot_received(t: Transaction, p: Person) kind institutional {
    label en unofficial "money or other property that is not like-kind property is also received in the exchange (section 1031(b)-(c))";
}
pub relation boot_money_received(t: Transaction, amount: Money) kind empirical {
    label en official "money received in the exchange, in addition to like-kind property (section 1031(b))";
}
pub relation boot_other_property_fmv(t: Transaction, amount: Money) kind empirical {
    label en official "the fair market value of other (non-like-kind) property received in the exchange (section 1031(b))";
}
rule BootReceivedRule(t: Transaction, p: Person, relinquished: Asset, received: Asset, transfer_date: Date, money: Money) strict {
    label en unofficial "money received alongside like-kind property triggers boot treatment";
    when like_kind_exchange(t, p, relinquished, received, transfer_date);
    when boot_money_received(t, money);
    when money > 0.00 USD;
    then boot_received(t, p);
}
rule BootReceivedFromOtherPropertyRule(t: Transaction, p: Person, relinquished: Asset, received: Asset, transfer_date: Date, fmv: Money) strict {
    label en unofficial "other (non-like-kind) property received alongside like-kind property triggers boot treatment";
    when like_kind_exchange(t, p, relinquished, received, transfer_date);
    when boot_other_property_fmv(t, fmv);
    when fmv > 0.00 USD;
    then boot_received(t, p);
}

@source(IRC_S1031_B, quote = "then the gain, if any, to the recipient shall be recognized, but in an amount not in excess of the sum of such money and the fair market value of such other property")
rule GainRecognizedOnBootLesserOfGainOrBootRule(p: Person, t: Transaction, relinquished: Asset, received: Asset, transfer_date: Date, realized: Money, money: Money, other_fmv: Money) defeasible {
    label en official "section 1031(b): where boot is received, gain is recognized up to (but not exceeding) the sum of money and the fair market value of other property received";
    when like_kind_exchange(t, p, relinquished, received, transfer_date);
    when real_property(relinquished);
    when real_property(received);
    when like_kind(relinquished, received);
    when held_for_productive_use_or_investment(p, relinquished);
    when held_for_productive_use_or_investment(p, received);
    when not_known(held_primarily_for_sale(p, relinquished));
    when gain_realized(p, t, realized);
    when boot_money_received(t, money);
    when boot_other_property_fmv(t, other_fmv);
    when not_known(section_1031f_related_party_disqualification(p, t));
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, min(realized, money + other_fmv));
}
@source(IRC_S1031_C, quote = "then no loss from the exchange shall be recognized")
rule NoLossRecognizedOnBootExchangeRule(p: Person, t: Transaction, relinquished: Asset, received: Asset, transfer_date: Date, loss: Money, money: Money, other_fmv: Money) strict {
    label en official "section 1031(c): no loss is recognized on an otherwise-nonrecognition exchange merely because boot is also received";
    when like_kind_exchange(t, p, relinquished, received, transfer_date);
    when real_property(relinquished);
    when real_property(received);
    when like_kind(relinquished, received);
    when loss_realized(p, t, loss);
    when boot_received(t, p);
    then nonrecognition_exception_applies(p, t);
    then loss_recognized(p, t, 0.00 USD);
}

// Basis results are transaction-scoped snapshots, not recursive writes to
// core::adjusted_basis. The latter is the opening ledger used by section 1001.
// A later disposition must supply its reviewed opening basis independently;
// inferring it back into this same program creates a defeasible dependency cycle.
pub relation like_kind_received_basis(p: Person, t: Transaction, received: Asset, on: Date, amount: Money) kind institutional {
    label en unofficial "section 1031(d): computed basis of property received in this exchange; not an opening-basis assertion for another disposition";
}
pub relation elected_replacement_basis(p: Person, t: Transaction, replacement: Asset, on: Date, amount: Money) kind institutional {
    label en unofficial "section 1033(b)(2): computed basis of replacement property for this conversion election; separate from the opening ledger";
}

// (d): basis of like-kind property received.
@source(IRC_S1031_D, quote = "then the basis shall be the same as that of the property exchanged, decreased in the amount of any money received by the taxpayer and increased in the amount of gain or decreased in the amount of loss to the taxpayer that was recognized on such exchange")
rule LikeKindExchangeBasisRule(p: Person, t: Transaction, relinquished: Asset, received: Asset, transfer_date: Date, old_basis: Money, money: Money, gain_rec: Money) defeasible {
    label en official "section 1031(d): basis of property received is the basis of property exchanged, decreased by money received and increased by recognized gain (recognized loss decreases it, folded into the same signed adjustment)";
    when like_kind_exchange(t, p, relinquished, received, transfer_date);
    when us.irc.core::adjusted_basis(p, relinquished, transfer_date, old_basis);
    when boot_money_received(t, money);
    when gain_recognized(p, t, gain_rec);
    then substituted_basis_from(p, received, p);
    then like_kind_received_basis(p, t, received, transfer_date, old_basis - money + gain_rec);
}

// (f): related-party 2-year rule.
pub relation exchange_with_related_person(t: Transaction, p: Person, related: Person) kind empirical {
    label en official "the taxpayer exchanges property with a related person (section 267(b) or 707(b)(1) relationship — section 1031(f)(3))";
}
pub relation related_party_disposition_within_two_years(t: Transaction, disposed_on: Date) kind empirical {
    label en official "before the date 2 years after the last transfer that was part of the exchange, the related person disposes of the property, or the taxpayer disposes of the like-kind property received from the related person (section 1031(f)(1)(C))";
}
pub relation last_transfer_date(t: Transaction, on: Date) kind empirical {
    label en unofficial "the date of the last transfer which was part of the related-party exchange";
}
pub relation disposition_excepted_under_1031f2(t: Transaction) kind empirical {
    label en unofficial "the disposition is excepted under section 1031(f)(2): after death, in an involuntary conversion preceding the threat of conversion, or established to the Secretary's satisfaction to lack a tax-avoidance purpose (a DECISION-0194 evaluative element for the last branch)";
}
@source(IRC_S1031_F, quote = "there shall be no nonrecognition of gain or loss under this section to the taxpayer with respect to such exchange; except that any gain or loss recognized by the taxpayer by reason of this subsection shall be taken into account as of the date on which the disposition referred to in subparagraph (C) occurs")
rule Section1031fRelatedPartyDisqualificationRule(p: Person, t: Transaction, related: Person, last_transfer: Date, disposed_on: Date) defeasible {
    label en official "section 1031(f)(1): a related-party exchange loses nonrecognition if the related person (or the taxpayer) disposes of the exchanged property within 2 years, unless a section 1031(f)(2) exception applies";
    when exchange_with_related_person(t, p, related);
    when last_transfer_date(t, last_transfer);
    when related_party_disposition_within_two_years(t, disposed_on);
    when disposed_on < add_calendar_period(last_transfer, 2 calendar_year);
    when not_known(disposition_excepted_under_1031f2(t));
    then section_1031f_related_party_disqualification(p, t);
}
pub relation section_1031f_related_party_disqualification(p: Person, t: Transaction) kind institutional {
    label en official "section 1031(f): the related-party 2-year disqualification applies — nonrecognition under section 1031(a)/(b) is denied for this exchange";
}

// =============================================================================
// Section 1033: involuntary conversions
// =============================================================================

pub relation involuntary_conversion(t: Transaction, p: Person, converted: Asset) kind empirical {
    label en official "property compulsorily or involuntarily converted (destruction in whole or in part, theft, seizure, or requisition or condemnation, or the threat or imminence thereof) — section 1033(a)";
}
pub relation converted_into_similar_property(t: Transaction, replacement: Asset) kind empirical {
    label en official "the property is converted directly into property similar or related in service or use to the converted property (section 1033(a)(1))";
}
@source(IRC_S1033_A, quote = "Into property similar or related in service or use to the property so converted, no gain shall be recognized.")
rule DirectConversionIntoSimilarPropertyNoGainRule(p: Person, t: Transaction, converted: Asset, replacement: Asset) strict {
    label en official "section 1033(a)(1): no gain is recognized where the converted property is replaced directly by similar-or-related-in-service-or-use property (no money or dissimilar property received)";
    when treated_as_involuntary_conversion(t, p, converted);
    when converted_into_similar_property(t, replacement);
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
}

// (a)(2): conversion into money (or dissimilar property) — gain is
// recognized UNLESS the taxpayer elects to replace, within the statutory
// period, with similar property (or control of a corporation owning such
// property); if elected, recognized gain is limited to the excess of the
// amount realized over the cost of replacement property.
pub relation converted_into_money_or_dissimilar_property(t: Transaction, amount_realized: Money) kind empirical {
    label en official "the converted property is converted into money, or into property not similar or related in service or use (section 1033(a)(2))";
}
pub relation elects_to_replace_converted_property(p: Person, t: Transaction) kind empirical {
    label en official "the taxpayer elects, for the purpose of replacing the converted property, to purchase similar-or-related replacement property or control of a corporation owning such property, within the section 1033(a)(2)(B) period (section 1033(a)(2)(A))";
}
pub relation replacement_property_cost(t: Transaction, amount: Money) kind empirical {
    label en unofficial "the cost of the qualifying replacement property (or stock) purchased within the replacement period";
}
pub relation disposition_of_converted_property_on(t: Transaction, on: Date) kind empirical {
    label en official "the date of disposition of the converted property (destruction, theft, seizure, requisition, condemnation, or a sale/exchange under threat or imminence thereof — section 1033(a)(2)(E)(ii)), or the earliest date of threat or imminence, whichever is earlier";
}
pub relation replacement_period_end(t: Transaction, disposition_on: Date, end: Date) kind institutional {
    label en official "the end of the section 1033(a)(2)(B) replacement period: 2 years after the close of the first taxable year in which any part of the gain is realized, absent an extension the Secretary grants on application, or a longer statutory period under subsection (e)(2)(A), (g)(1) or (g)(4), or (h)";
}
pub relation replacement_purchased_on(t: Transaction, on: Date) kind empirical {
    label en unofficial "the date the replacement property (or stock) was purchased";
}

@source(IRC_S1033_A, quote = "at the election of the taxpayer the gain shall be recognized only to the extent that the amount realized upon such conversion (regardless of whether such amount is received in one or more taxable years) exceeds the cost of such other property or such stock.")
rule ElectedReplacementGainLimitedToExcessRule(p: Person, t: Transaction, converted: Asset, realized: Money, replacement_cost: Money, purchased_on: Date, disposed_on: Date, deadline: Date) strict {
    label en official "section 1033(a)(2)(A): where the taxpayer elects to replace with similar property purchased within the replacement period, gain is recognized only to the extent the amount realized exceeds the replacement cost";
    when treated_as_involuntary_conversion(t, p, converted);
    when converted_into_money_or_dissimilar_property(t, realized);
    when elects_to_replace_converted_property(p, t);
    when not_known(section_1033a_unavailable_by_related_acquisition(t));
    when replacement_property_cost(t, replacement_cost);
    when disposition_of_converted_property_on(t, disposed_on);
    when replacement_period_end(t, disposed_on, deadline);
    when replacement_purchased_on(t, purchased_on);
    when purchased_on >= disposed_on;
    when purchased_on <= deadline;
    when realized > replacement_cost;
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, realized - replacement_cost);
}
rule ElectedReplacementFullyReinvestedNoGainRule(p: Person, t: Transaction, converted: Asset, realized: Money, replacement_cost: Money, purchased_on: Date, disposed_on: Date, deadline: Date) strict {
    label en official "section 1033(a)(2)(A): where the replacement cost equals or exceeds the amount realized, no gain is recognized";
    when treated_as_involuntary_conversion(t, p, converted);
    when converted_into_money_or_dissimilar_property(t, realized);
    when elects_to_replace_converted_property(p, t);
    when not_known(section_1033a_unavailable_by_related_acquisition(t));
    when replacement_property_cost(t, replacement_cost);
    when disposition_of_converted_property_on(t, disposed_on);
    when replacement_period_end(t, disposed_on, deadline);
    when replacement_purchased_on(t, purchased_on);
    when purchased_on >= disposed_on;
    when purchased_on <= deadline;
    when realized <= replacement_cost;
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
}
@source(IRC_S1033_A, quote = "the gain (if any) shall be recognized except to the extent hereinafter provided in this paragraph")
rule NoElectionFullGainRecognizedRule(p: Person, t: Transaction, converted: Asset, realized: Money) defeasible {
    label en official "section 1033(a)(2): absent a timely replacement election, the gain from conversion into money or dissimilar property is fully recognized under the section 1001(c) default (this rule records the section 1033 pathway explicitly for clarity; it does not change the amount)";
    when treated_as_involuntary_conversion(t, p, converted);
    when converted_into_money_or_dissimilar_property(t, realized);
    when not_known(elects_to_replace_converted_property(p, t));
    then gain_recognized(p, t, realized);
}

@source(IRC_S1033_A, quote = "2 years after the close of the first taxable year in which any part of the gain upon the conversion is realized")
rule ReplacementPeriodEndsTwoYearsAfterCloseOfRealizationYearRule(t: Transaction, disposed_on: Date, close_of_year: Date) strict {
    label en official "section 1033(a)(2)(B)(i): the replacement period ends 2 years after the close of the first taxable year in which any part of the gain is realized, absent a Secretary-granted extension or a longer statutory period";
    when disposition_of_converted_property_on(t, disposed_on);
    when close_of_realization_taxable_year(t, close_of_year);
    when not_known(replacement_period_extended_by_secretary(t));
    when not_known(replacement_period_longer_statutory_period(t));
    when not_known(longer_replacement_period_applies_1033(t));
    then replacement_period_end(t, disposed_on, add_calendar_period(close_of_year, 2 calendar_year));
}
relation close_of_realization_taxable_year(t: Transaction, on: Date) kind empirical {
    label en unofficial "the close of the first taxable year in which any part of the gain upon the conversion is realized";
}
relation replacement_period_extended_by_secretary(t: Transaction) kind empirical {
    label en unofficial "the Secretary designated a later date on application by the taxpayer (section 1033(a)(2)(B)(ii)) — the specific later date is a case fact, not re-derived";
}
relation replacement_period_longer_statutory_period(t: Transaction) kind empirical {
    label en unofficial "a longer statutory replacement period applies under section 1033(e)(2)(A) (4 years, weather-related livestock), (g)(1) (3 years, condemned real property), (g)(4) (3 years, outdoor advertising displays) or (h) (4 years, federally declared disasters) — a case-asserted classification, the individual subsections are not separately re-derived this stage";
}

// basis of replacement property (section 1033(b)(1)-(2)).
// JUDGMENT CALL (stratfix3, 26.09.2026): the converted property's basis is
// read through the case-supplied `converted_property_adjusted_basis_at_conversion`
// input, NOT through `us.irc.core::adjusted_basis(p, converted, ...)`. Reading
// the core predicate here closed a predicate-level strict self-loop
// `core#adjusted_basis → core#adjusted_basis` (fatal at execution as
// NON_EXECUTABLE_UNSTRATIFIED, §110/§103: only monotone supported(P) edges may
// cycle), although the transfer is between distinct assets (converted ≠
// replacement), i.e. a basis carryover, not a well-founded recursion. A
// monotone wrapper was rejected: no rule body in the corpus uses
// `monotone()`/`supported()`, while the direct sibling for a carryover between
// persons (section 1015 gift basis, `donor_adjusted_basis_at_gift`) reads the
// transferor's basis as a case fact. No sums are involved (§111-clean); the
// section 1033(b)(1) computation itself (same basis, no money adjustment) is
// unchanged.
pub relation converted_property_adjusted_basis_at_conversion(t: Transaction, p: Person, converted: Asset, on: Date, amount: Money) kind institutional {
    label en unofficial "the taxpayer's adjusted basis in the converted property (adjusted under section 1016 for the period before the conversion), asserted as a case fact so the section 1033(b)(1) carryover does not read back the predicate it writes";
}
@source(IRC_S1033_B, quote = "the basis shall be the same as in the case of the property so converted—")
rule DirectConversionReplacementBasisRule(p: Person, t: Transaction, converted: Asset, replacement: Asset, on: Date, old_basis: Money) strict {
    label en official "section 1033(b)(1): basis of property received on a direct conversion under (a)(1) is the same as the converted property's basis (no money was received to adjust for in a direct conversion)";
    when treated_as_involuntary_conversion(t, p, converted);
    when converted_into_similar_property(t, replacement);
    when converted_property_adjusted_basis_at_conversion(t, p, converted, on, old_basis);
    then substituted_basis_from(p, replacement, p);
    then us.irc.core::adjusted_basis(p, replacement, on, old_basis);
}
@source(IRC_S1033_B, quote = "the basis shall be the cost of such property decreased in the amount of the gain not so recognized")
pub relation replacement_property_of(t: Transaction, replacement: Asset) kind empirical {
    label en unofficial "the replacement property (or stock) purchased in satisfaction of a section 1033(a)(2) election";
}
@source(IRC_S1033_B, relation = formalizes, coverage = partial, quote = "In the case of property purchased by the taxpayer in a transaction described in subsection (a)(2) which resulted in the nonrecognition of any part of the gain realized as the result of a compulsory or involuntary conversion")
rule ElectedReplacementBasisRule(p: Person, t: Transaction, replacement: Asset, on: Date, cost: Money, realized: Money, gain_rec: Money) defeasible {
    label en official "section 1033(b)(2): basis of replacement property purchased under an (a)(2) election is its cost, decreased by the amount of gain not recognized";
    when elects_to_replace_converted_property(p, t);
    when replacement_property_of(t, replacement);
    when replacement_purchased_on(t, on);
    when replacement_property_cost(t, cost);
    when gain_realized(p, t, realized);
    when gain_recognized(p, t, gain_rec);
    then elected_replacement_basis(p, t, replacement, on, cost - (realized - gain_rec));
}

// =============================================================================
// Section 1041: transfers between spouses / incident to divorce
// =============================================================================

pub relation transfer_to_spouse_or_former_spouse(t: Transaction, transferor: Person, transferee: Person) kind empirical {
    label en official "a transfer of property from an individual to (or in trust for the benefit of) a spouse, or a former spouse incident to the divorce (section 1041(a))";
}
pub relation transfer_incident_to_divorce(t: Transaction) kind institutional {
    label en official "the transfer occurs within 1 year after the date the marriage ceases, or is related to the cessation of the marriage (section 1041(c))";
}
pub relation transferee_is_nonresident_alien(t: Transaction, transferee: Person) kind empirical {
    label en official "the transferee spouse or former spouse is a nonresident alien (section 1041(d) exception)";
}
pub relation transfer_liabilities_exceed_basis(t: Transaction, transferor: Person, excess: Money) kind empirical {
    label en unofficial "for a transfer in trust, the sum of liabilities assumed plus liabilities the property is subject to, exceeds the total adjusted basis of the property transferred (section 1041(e))";
}
pub relation marriage_ceased_on(t: Transaction, on: Date) kind empirical {
    label en unofficial "the date the marriage ceases, for the section 1041(c)(1) 1-year test";
}
pub relation transferred_on(t: Transaction, on: Date) kind empirical {
    label en unofficial "the date of the transfer, for the section 1041(c)(1) 1-year test";
}
pub relation transfer_related_to_cessation_of_marriage(t: Transaction) kind empirical {
    label en official "the transfer is related to the cessation of the marriage (section 1041(c)(2))";
}

@source(IRC_S1041_C, quote = "a transfer of property is incident to the divorce if such transfer—")
rule IncidentToDivorceWithinOneYearRule(t: Transaction, ceased_on: Date, transferred: Date) strict {
    label en official "section 1041(c)(1): a transfer within 1 year after the marriage ceases is incident to the divorce";
    when marriage_ceased_on(t, ceased_on);
    when transferred_on(t, transferred);
    when transferred <= add_calendar_period(ceased_on, 1 calendar_year);
    then transfer_incident_to_divorce(t);
}
rule IncidentToDivorceRelatedToCessationRule(t: Transaction) strict {
    label en official "section 1041(c)(2): a transfer related to the cessation of the marriage is incident to the divorce";
    when transfer_related_to_cessation_of_marriage(t);
    then transfer_incident_to_divorce(t);
}

relation has_transfer_liabilities_exceeding_basis(t: Transaction, p: Person) kind institutional {
    label en unofficial "guard: at least one section 1041(e) excess-liabilities fact is asserted for this transfer (avoids an unbound not_known argument)";
}
rule HasTransferLiabilitiesExceedingBasisRule(t: Transaction, p: Person, excess: Money) strict {
    label en unofficial "derives the guard from the asserted excess amount";
    when transfer_liabilities_exceed_basis(t, p, excess);
    then has_transfer_liabilities_exceeding_basis(t, p);
}
@source(IRC_S1041_A, quote = "No gain or loss shall be recognized on a transfer of property from an individual to (or in trust for the benefit of)—")
rule SpousalTransferNonrecognitionRule(p: Person, t: Transaction, transferee: Person) defeasible {
    label en official "section 1041(a): no gain or loss is recognized on a transfer to a spouse, or to a former spouse incident to the divorce, unless the transferee is a nonresident alien (d) or (for a trust transfer) liabilities exceed basis (e), to the extent of that excess";
    when transfer_to_spouse_or_former_spouse(t, p, transferee);
    when is_spouse_transfer_or_incident_to_divorce(t, p, transferee);
    when not_known(transferee_is_nonresident_alien(t, transferee));
    when not_known(has_transfer_liabilities_exceeding_basis(t, p));
    then nonrecognition_exception_applies(p, t);
    then gain_recognized(p, t, 0.00 USD);
    then loss_recognized(p, t, 0.00 USD);
}
relation is_spouse_transfer_or_incident_to_divorce(t: Transaction, transferor: Person, transferee: Person) kind institutional {
    label en unofficial "the transfer is to a spouse, OR to a former spouse and incident to the divorce (section 1041(a)(1)-(2))";
}
rule IsSpouseTransferRule(t: Transaction, transferor: Person, spouse: Person) strict {
    label en unofficial "a transfer to a current spouse needs no incident-to-divorce finding";
    when transfer_to_spouse_or_former_spouse(t, transferor, spouse);
    when current_spouse_of(transferor, spouse);
    then is_spouse_transfer_or_incident_to_divorce(t, transferor, spouse);
}
pub relation current_spouse_of(a: Person, b: Person) kind institutional {
    label en unofficial "a and b are currently married to each other — shape asserted here pending a typed dependency contract on definitions' section 7703 marital-status test";
}
rule IsFormerSpouseIncidentToDivorceTransferRule(t: Transaction, transferor: Person, former: Person) strict {
    label en unofficial "a transfer to a former spouse counts only when incident to the divorce (section 1041(c))";
    when transfer_to_spouse_or_former_spouse(t, transferor, former);
    when transfer_incident_to_divorce(t);
    then is_spouse_transfer_or_incident_to_divorce(t, transferor, former);
}

@source(IRC_S1041_E, quote = "Subsection (a) shall not apply to the transfer of property in trust to the extent that—")
rule TrustTransferExcessLiabilitiesGainRecognizedRule(p: Person, t: Transaction, transferee: Person, excess: Money) strict {
    label en official "section 1041(e): to the extent liabilities assumed/encumbering a trust transfer exceed the total adjusted basis transferred, section 1041(a) nonrecognition does not apply and that excess is recognized gain";
    when transfer_to_spouse_or_former_spouse(t, p, transferee);
    when is_spouse_transfer_or_incident_to_divorce(t, p, transferee);
    when not_known(transferee_is_nonresident_alien(t, transferee));
    when transfer_liabilities_exceed_basis(t, p, excess);
    then gain_recognized(p, t, excess);
}

// JUDGMENT CALL (stratfix3, 26.09.2026): the transferor's basis is read through
// the case-supplied `transferor_adjusted_basis_at_transfer` input, NOT through
// `us.irc.core::adjusted_basis(p, a, ...)`. Reading the core predicate here
// closed a predicate-level strict self-loop `core#adjusted_basis →
// core#adjusted_basis` (fatal at execution as NON_EXECUTABLE_UNSTRATIFIED,
// §110/§103), although the transfer is between distinct persons (transferor ≠
// transferee), i.e. a basis carryover, not a well-founded recursion. This
// mirrors the section 1015 gift-basis sibling (`donor_adjusted_basis_at_gift`,
// which section 1041(b)(2) itself points at: the property "shall be treated as
// acquired by the transferee by gift"). No sums are involved (§111-clean); the
// section 1041(b) computation itself (carryover of the transferor's adjusted
// basis) is unchanged.
pub relation transferor_adjusted_basis_at_transfer(t: Transaction, transferor: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en unofficial "the transferor's adjusted basis in the transferred property (adjusted under section 1016 for the period before the transfer), asserted as a case fact so the section 1041(b) carryover does not read back the predicate it writes";
}
@source(IRC_S1041_B, quote = "for purposes of this subtitle, the property shall be treated as acquired by the transferee by gift, and")
rule SpousalTransferCarryoverBasisRule(p: Person, t: Transaction, transferee: Person, a: Asset, on: Date, basis: Money) strict {
    label en official "section 1041(b): the transferee's basis is the transferor's adjusted basis (carryover), and the property is treated as acquired by gift";
    when transfer_to_spouse_or_former_spouse(t, p, transferee);
    when is_spouse_transfer_or_incident_to_divorce(t, p, transferee);
    when transferred_asset_of(t, a);
    when transferor_adjusted_basis_at_transfer(t, p, a, on, basis);
    then acquired_by_gift(transferee, a, p, on);
    then substituted_basis_from(transferee, a, p);
    then section_1041_transfer(transferee, a, p);
    then us.irc.core::adjusted_basis(transferee, a, on, basis);
}
relation transferred_asset_of(t: Transaction, a: Asset) kind empirical {
    label en unofficial "the asset transferred in this transaction";
}
