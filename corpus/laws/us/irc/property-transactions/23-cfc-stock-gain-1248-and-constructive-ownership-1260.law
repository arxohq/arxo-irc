// Stage 2c (IRC-07, A05). Section 1248 (gain from the sale or exchange of
// stock in certain foreign corporations) and section 1260 (gains from
// constructive ownership transactions).
//
// Modelling notes.
//  * §1248(a): the earnings and profits "attributable to the stock (under
//    regulations)" are a case-supplied amount (EXTERNAL_DEPENDENCY: Treas.
//    Reg. 1.1248-1..); the §1248(d) exclusions are summed over an empirical
//    relation, so an absent exclusion contributes nothing.
//  * §1248(b) (individual tax cap) needs a hypothetical domestic-corporation
//    tax computation: TECH-GAPS G2326.
//  * §1260(a)(2) (rates by reference to the net underlying gain) and §1260(b)
//    (interest charge on the deferral, with the §1274(d) AFR) are TECH-GAPS
//    G2327 / G2328.

// =============================================================================
// §1248
// =============================================================================

use self::{
    Asset,
    IRC_S1248_A,
    IRC_S1248_B,
    IRC_S1248_D,
    IRC_S1248_E,
    IRC_S1248_F,
    IRC_S1248_G,
    IRC_S1248_H,
    IRC_S1248_I,
    IRC_S1248_J,
    IRC_S1260_A,
    IRC_S1260_C,
    IRC_S1260_D,
    IRC_S1260_E,
    IRC_S1260_F,
    Person,
    Transaction,
    gain_recognized,
    total_attributable_earnings_1248,
};

pub relation us_person_sells_foreign_corporation_stock(t: Transaction, p: Person, corp: Person) kind empirical {
    label en official "section 1248(a)(1): a United States person sells or exchanges stock in a foreign corporation (a person is treated as selling or exchanging stock if any provision of the subtitle treats it as realizing gain from the sale or exchange of the stock)";
}
pub relation owned_10_percent_voting_power_while_cfc_in_5_year_period(p: Person, corp: Person, t: Transaction) kind empirical {
    label en official "section 1248(a)(2): the person owns (section 958(a)) or is considered as owning (section 958(b)) 10 percent or more of the total combined voting power at any time during the 5-year period ending on the date of the sale when the foreign corporation was a controlled foreign corporation";
}
pub relation earnings_and_profits_attributable_to_stock(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(a): the earnings and profits of the foreign corporation attributable (under regulations) to the stock which were accumulated in taxable years beginning after December 31, 1962 and during the periods the stock was held by the person while the foreign corporation was a controlled foreign corporation (EXTERNAL_DEPENDENCY: regulations)";
}
pub enum EarningsExclusion1248d {
    PreviouslyTaxedSection951;
    LessDevelopedCountryCorporationPre1976;
    EffectivelyConnectedIncome;
    ForeignTradeIncomeOfFsc;
    PreviouslyTaxedSection1293;
    label en official "the kinds of earnings excluded by section 1248(d)(1), (3), (4), (5), (6)";
}
pub relation earnings_exclusion_1248d(t: Transaction, kind: EarningsExclusion1248d, amount: Money) kind empirical {
    label en official "section 1248(d): an amount excluded from the earnings and profits of the foreign corporation with respect to the United States person";
}
pub relation total_exclusions_1248d(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(d): the sum of the excluded amounts (an aggregate over an empirical relation: an absent exclusion contributes nothing)";
}
@source(IRC_S1248_D, relation = formalizes, coverage = partial, quote = "For purposes of this section, the following amounts shall be excluded, with respect to any United States person, from the earnings and profits of a foreign corporation:")
rule TotalExclusions1248dRule(t: Transaction, attributable: Money) defeasible {
    label en official "section 1248(d)";
    when total_attributable_earnings_1248(t, attributable);
    then total_exclusions_1248d(t, sum all amount: Money for kind: EarningsExclusion1248d where earnings_exclusion_1248d(t, kind, amount));
}
pub relation section_1248_net_earnings(t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(a), (d): the attributable earnings and profits less the excluded amounts (not below zero)";
}
@source(IRC_S1248_D, relation = formalizes, coverage = partial, quote = "For purposes of this section, the following amounts shall be excluded, with respect to any United States person, from the earnings and profits of a foreign corporation:")
rule Section1248NetEarningsPositiveRule(t: Transaction, attributable: Money, excluded: Money) defeasible {
    label en official "section 1248(d): net earnings = attributable earnings - exclusions";
    when total_attributable_earnings_1248(t, attributable);
    when total_exclusions_1248d(t, excluded);
    when attributable > excluded;
    then section_1248_net_earnings(t, attributable - excluded);
}
rule Section1248NetEarningsZeroRule(t: Transaction, attributable: Money, excluded: Money) defeasible {
    label en official "section 1248(d): exclusions that exhaust the attributable earnings leave zero";
    when total_attributable_earnings_1248(t, attributable);
    when total_exclusions_1248d(t, excluded);
    when attributable <= excluded;
    then section_1248_net_earnings(t, 0.00 USD);
}
pub relation us_person_1248(p: Person) kind empirical {
    label en official "the seller is a United States person (section 7701(a)(30); owner: definitions)";
}
pub relation taxpayer_established_earnings_amount_1248h(t: Transaction) kind empirical {
    label en official "section 1248(h): the taxpayer establishes the amount of the earnings and profits to be taken into account (an evidentiary burden, DECISION-0194: adjudicated fact)";
}
pub relation section_1248_inapplicable(t: Transaction) kind institutional {
    label en official "section 1248(g): the section does not apply (section 303 redemption, or an amount otherwise treated as a dividend, ordinary income, or gain on an asset held not more than 1 year)";
}
pub relation section_303_redemption_distribution(t: Transaction) kind empirical {
    label en official "section 1248(g)(1): a distribution to which section 303 applies";
}
pub relation amount_otherwise_treated_as_dividend_ordinary_or_short_term(t: Transaction) kind empirical {
    label en official "section 1248(g)(2): the amount is, under another provision of the title, treated as a dividend (other than under (f)), ordinary income, or gain from an asset held not more than 1 year";
}
@source(IRC_S1248_G, relation = formalizes, coverage = exact, quote = "This section shall not apply to—")
rule Section1248InapplicableRedemptionRule(t: Transaction) defeasible {
    label en official "section 1248(g)(1)";
    when section_303_redemption_distribution(t);
    then section_1248_inapplicable(t);
}
rule Section1248InapplicableOtherTreatmentRule(t: Transaction) defeasible {
    label en official "section 1248(g)(2)";
    when amount_otherwise_treated_as_dividend_ordinary_or_short_term(t);
    then section_1248_inapplicable(t);
}
pub relation section_1248_dividend(p: Person, t: Transaction, amount: Money) kind institutional {
    label en official "section 1248(a): the gain included in gross income as a dividend";
}
@source(IRC_S1248_A, relation = formalizes, coverage = partial, quote = "then the gain recognized on the sale or exchange of such stock shall be included in the gross income of such person as a dividend, to the extent of the earnings and profits of the foreign corporation attributable")
rule Section1248DividendRule(p: Person, t: Transaction, corp: Person, gain: Money, net: Money) defeasible {
    label en official "section 1248(a): dividend = min(gain recognized, net attributable earnings)";
    when us_person_1248(p);
    when us_person_sells_foreign_corporation_stock(t, p, corp);
    when owned_10_percent_voting_power_while_cfc_in_5_year_period(p, corp, t);
    when gain_recognized(p, t, gain);
    when taxpayer_established_earnings_amount_1248h(t);
    when section_1248_net_earnings(t, net);
    when not_known(section_1248_inapplicable(t));
    then section_1248_dividend(p, t, min(gain, net));
}
@source(IRC_S1248_H, relation = formalizes, coverage = exact, quote = "Unless the taxpayer establishes the amount of the earnings and profits of the foreign corporation to be taken into account under subsection (a) or (f), all gain from the sale or exchange shall be considered a dividend under subsection (a) or (f)")
rule Section1248BurdenDefaultRule(p: Person, t: Transaction, corp: Person, gain: Money) defeasible {
    label en official "section 1248(h): without an established earnings amount the whole gain is a dividend";
    when us_person_1248(p);
    when us_person_sells_foreign_corporation_stock(t, p, corp);
    when owned_10_percent_voting_power_while_cfc_in_5_year_period(p, corp, t);
    when gain_recognized(p, t, gain);
    when not_known(taxpayer_established_earnings_amount_1248h(t));
    when not_known(section_1248_inapplicable(t));
    then section_1248_dividend(p, t, gain);
}
pub relation foreign_taxes_established_for_limitation_1248b(p: Person, t: Transaction) kind empirical {
    label en official "section 1248(h), last clause: the taxpayer establishes the amount of foreign taxes to be taken into account under subsection (b); otherwise the limitation of subsection (b) does not apply";
}
pub relation section_1248b_limitation_available(p: Person, t: Transaction) kind institutional {
    label en official "section 1248(b), (h): the individual's tax limitation is available";
}
pub relation seller_is_individual_1248b(p: Person) kind empirical {
    label en official "section 1248(b): the seller is an individual";
}
pub relation stock_is_capital_asset_held_over_one_year(t: Transaction) kind empirical {
    label en official "section 1248(b): the stock sold or exchanged is a capital asset (section 1221) held for more than 1 year";
}
@source(IRC_S1248_B, relation = formalizes, coverage = partial, quote = "In the case of an individual, if the stock sold or exchanged is a capital asset (within the meaning of section 1221) and has been held for more than 1 year")
rule Section1248bLimitationAvailableRule(p: Person, t: Transaction) defeasible {
    label en official "section 1248(b) conditions and the (h) foreign-tax burden; the tax cap computation itself is G2326";
    when seller_is_individual_1248b(p);
    when stock_is_capital_asset_held_over_one_year(t);
    when foreign_taxes_established_for_limitation_1248b(p, t);
    then section_1248b_limitation_available(p, t);
}

// (e): sale of domestic holding-company stock
pub relation domestic_corporation_formed_principally_to_hold_foreign_stock(dom: Person) kind empirical {
    label en official "section 1248(e)(2): the domestic corporation was formed or availed of principally for the holding, directly or indirectly, of stock of one or more foreign corporations (an evaluative element, DECISION-0194: adjudicated fact)";
}
pub relation us_person_sells_domestic_corporation_stock(t: Transaction, p: Person, dom: Person) kind empirical {
    label en official "section 1248(e)(1): a United States person sells or exchanges stock of a domestic corporation";
}
pub relation domestic_corporation_holds_foreign_stock(dom: Person, foreign_corp: Person) kind empirical {
    label en unofficial "the domestic corporation holds stock of the foreign corporation";
}
pub relation treated_as_sale_of_foreign_corporation_stock_1248e(t: Transaction, foreign_corp: Person) kind institutional {
    label en official "section 1248(e): the sale is treated, for this section, as a sale of the stock of the foreign corporation or corporations held by the domestic corporation";
}
@source(IRC_S1248_E, relation = formalizes, coverage = exact, quote = "such sale or exchange shall, for purposes of this section, be treated as a sale or exchange of the stock of the foreign corporation or corporations held by the domestic corporation.")
rule Section1248eLookThroughRule(t: Transaction, p: Person, dom: Person, foreign_corp: Person) defeasible {
    label en official "section 1248(e)";
    when us_person_sells_domestic_corporation_stock(t, p, dom);
    when domestic_corporation_formed_principally_to_hold_foreign_stock(dom);
    when domestic_corporation_holds_foreign_stock(dom, foreign_corp);
    then treated_as_sale_of_foreign_corporation_stock_1248e(t, foreign_corp);
}

// (f): distributions of foreign stock by a domestic corporation
pub relation domestic_corporation_distributes_foreign_stock(t: Transaction, dom: Person, foreign_corp: Person) kind empirical {
    label en official "section 1248(f)(1)(B): the domestic corporation distributes stock of the foreign corporation in a distribution to which section 311(a), 337, 355(c)(1) or 361(c)(1) applies";
}
pub relation domestic_corporation_meets_10_percent_test(dom: Person, foreign_corp: Person) kind empirical {
    label en official "section 1248(f)(1)(A): the domestic corporation satisfies the stock ownership requirements of subsection (a)(2)";
}
pub relation distributee_is_tacked_holder_and_meets_10_percent_test(t: Transaction) kind empirical {
    label en official "section 1248(f)(2): the distribution is to a domestic corporation treated as holding the stock for the distributing corporation's period and immediately afterwards satisfying the ownership requirements";
}
pub relation fair_market_value_of_distributed_stock(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(f)(1): the fair market value of the distributed stock";
}
pub relation adjusted_basis_of_distributed_stock(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(f)(1): the adjusted basis of the distributed stock in the hands of the domestic corporation";
}
pub relation section_1248f_dividend(t: Transaction, dom: Person, amount: Money) kind institutional {
    label en official "section 1248(f)(1): the excess of fair market value over adjusted basis included in the domestic corporation's gross income as a dividend, to the extent of attributable earnings";
}
@source(IRC_S1248_F, relation = formalizes, coverage = partial, quote = "then, notwithstanding any other provision of this subtitle, an amount equal to the excess of the fair market value of such stock over its adjusted basis in the hands of the domestic corporation shall be included in the gross income of the domestic corporation as a dividend")
rule Section1248fDividendRule(t: Transaction, dom: Person, foreign_corp: Person, fmv: Money, basis: Money, net: Money) defeasible {
    label en official "section 1248(f)(1): min(FMV - basis, net attributable earnings) when FMV exceeds basis";
    when domestic_corporation_distributes_foreign_stock(t, dom, foreign_corp);
    when domestic_corporation_meets_10_percent_test(dom, foreign_corp);
    when not_known(distributee_is_tacked_holder_and_meets_10_percent_test(t));
    when fair_market_value_of_distributed_stock(t, fmv);
    when adjusted_basis_of_distributed_stock(t, basis);
    when section_1248_net_earnings(t, net);
    when fmv > basis;
    then section_1248f_dividend(t, dom, min(fmv - basis, net));
}

// (i): exchanges of stock of a 10-percent corporate shareholder for foreign stock
pub relation shareholder_exchanges_shareholder_corporation_stock_for_foreign_stock(t: Transaction, shareholder: Person, ten_percent_holder: Person, foreign_corp: Person) kind empirical {
    label en official "section 1248(i)(1): a shareholder of a 10-percent corporate shareholder of a foreign corporation exchanges stock of the 10-percent corporate shareholder for stock of the foreign corporation";
}
pub relation deemed_distribution_gain_1248i(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(i)(1): the gain as if the foreign stock received had been issued to the 10-percent corporate shareholder and then distributed in redemption or liquidation";
}
pub relation dividend_amount_under_1248_for_1248i(t: Transaction, amount: Money) kind empirical {
    label en official "section 1248(i)(1), last sentence: the amount treated as a dividend under this section";
}
pub relation section_1248i_gain_recognized(t: Transaction, ten_percent_holder: Person, amount: Money) kind institutional {
    label en official "section 1248(i): the gain recognized by the 10-percent corporate shareholder, not exceeding the amount treated as a dividend under this section";
}
@source(IRC_S1248_I, relation = formalizes, coverage = exact, quote = "The amount of gain recognized by such 10-percent corporate shareholder under the preceding sentence shall not exceed the amount treated as a dividend under this section.")
rule Section1248iGainRule(t: Transaction, shareholder: Person, holder: Person, foreign_corp: Person, deemed: Money, dividend: Money) defeasible {
    label en official "section 1248(i)(1): min(deemed gain, dividend amount)";
    when shareholder_exchanges_shareholder_corporation_stock_for_foreign_stock(t, shareholder, holder, foreign_corp);
    when deemed_distribution_gain_1248i(t, deemed);
    when dividend_amount_under_1248_for_1248i(t, dividend);
    then section_1248i_gain_recognized(t, holder, min(deemed, dividend));
}

// (j): section 245A
pub relation domestic_corporation_sells_foreign_stock_held_one_year_or_more(t: Transaction, p: Person) kind empirical {
    label en official "section 1248(j): a domestic corporation sells or exchanges stock in a foreign corporation held for 1 year or more";
}
pub relation section_1248_dividend_treated_as_dividend_for_245a(t: Transaction, p: Person) kind institutional {
    label en official "section 1248(j): any amount treated as a dividend by reason of this section is a dividend for purposes of section 245A";
}
@source(IRC_S1248_J, relation = formalizes, coverage = exact, quote = "any amount received by the domestic corporation which is treated as a dividend by reason of this section shall be treated as a dividend for purposes of applying section 245A.")
rule Section1248jRule(t: Transaction, p: Person, amount: Money) defeasible {
    label en official "section 1248(j)";
    when domestic_corporation_sells_foreign_stock_held_one_year_or_more(t, p);
    when section_1248_dividend(p, t, amount);
    then section_1248_dividend_treated_as_dividend_for_245a(t, p);
}

// =============================================================================
// §1260
// =============================================================================

pub entity ConstructiveOwnershipTransaction : Transaction {
    label en official "a transaction with respect to a financial asset that section 1260(d) treats as a constructive ownership transaction";
}
pub relation transaction_financial_asset(t: ConstructiveOwnershipTransaction, asset: Asset) kind empirical {
    label en unofficial "the financial asset to which the transaction relates";
}
pub enum PassThruEntityKind1260 {
    RegulatedInvestmentCompany;
    RealEstateInvestmentTrust;
    SCorporation;
    PartnershipEntity;
    TrustEntity;
    CommonTrustFund;
    PassiveForeignInvestmentCompany;
    Remic;
    label en official "the pass-thru entities of section 1260(c)(2)(A)-(H)";
}
pub relation equity_interest_in_pass_thru_entity(asset: Asset, kind: PassThruEntityKind1260) kind empirical {
    label en official "section 1260(c)(1)(A): an equity interest in a pass-thru entity of the given kind";
}
pub relation financial_asset_by_regulation_1260c1b(asset: Asset) kind empirical {
    label en official "section 1260(c)(1)(B): a debt instrument, or stock in a non-pass-thru corporation, to the extent provided in regulations (EXTERNAL_DEPENDENCY)";
}
pub relation financial_asset_1260(asset: Asset) kind institutional {
    label en official "section 1260(c)(1): a financial asset";
}
@source(IRC_S1260_C, relation = formalizes, coverage = partial, quote = "(A) any equity interest in any pass-thru entity, and")
rule FinancialAssetPassThruRule(asset: Asset, kind: PassThruEntityKind1260) defeasible {
    label en official "section 1260(c)(1)(A)";
    when equity_interest_in_pass_thru_entity(asset, kind);
    then financial_asset_1260(asset);
}
rule FinancialAssetRegulationRule(asset: Asset) defeasible {
    label en official "section 1260(c)(1)(B)";
    when financial_asset_by_regulation_1260c1b(asset);
    then financial_asset_1260(asset);
}
pub relation right_to_all_or_substantially_all_investment_yield(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(d)(3)(A): the person has the right to be paid (or receive credit for) all or substantially all of the investment yield (including appreciation) on the financial asset for a specified period";
}
pub relation obligated_to_reimburse_all_or_substantially_all_decline(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(d)(3)(B): the person is obligated to reimburse (or provide credit for) all or substantially all of any decline in the value of the financial asset";
}
pub relation long_position_under_notional_principal_contract(p: Person, asset: Asset) kind institutional {
    label en official "section 1260(d)(3): the person holds a long position under a notional principal contract with respect to the financial asset";
}
@source(IRC_S1260_D, relation = formalizes, coverage = exact, quote = "A person shall be treated as holding a long position under a notional principal contract with respect to any financial asset if such person—")
rule LongPositionNotionalPrincipalContractRule(p: Person, asset: Asset) defeasible {
    label en official "section 1260(d)(3)(A)-(B)";
    when right_to_all_or_substantially_all_investment_yield(p, asset);
    when obligated_to_reimburse_all_or_substantially_all_decline(p, asset);
    then long_position_under_notional_principal_contract(p, asset);
}
pub relation enters_forward_or_futures_contract_to_acquire(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(d)(1)(B): the taxpayer enters into a forward or futures contract to acquire the financial asset (forward contract: any contract to acquire in the future, or provide or receive credit for the future value of, any financial asset, (d)(4))";
}
pub relation holder_of_call_and_grantor_of_put_with_equal_strikes_and_maturities(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(d)(1)(C): the taxpayer holds a call option and grants a put option on the financial asset with substantially equal strike prices and substantially contemporaneous maturity dates";
}
pub relation other_transaction_with_substantially_same_effect_by_regulation(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(d)(1)(D): to the extent provided in regulations, other transactions or positions having substantially the same effect (EXTERNAL_DEPENDENCY)";
}
pub relation entered_constructive_ownership_transaction(p: Person, asset: Asset) kind institutional {
    label en official "section 1260(d)(1): the taxpayer is treated as having entered into a constructive ownership transaction with respect to the financial asset";
}
pub relation all_positions_marked_to_market(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(d)(2): all of the positions which are part of the transaction are marked to market under a provision of the title or its regulations";
}
@source(IRC_S1260_D, relation = formalizes, coverage = partial, quote = "(A) holds a long position under a notional principal contract with respect to the financial asset,")
rule ConstructiveOwnershipNotionalRule(p: Person, asset: Asset) defeasible {
    label en official "section 1260(d)(1)(A) with the (d)(2) marked-to-market exclusion";
    when financial_asset_1260(asset);
    when long_position_under_notional_principal_contract(p, asset);
    when not_known(all_positions_marked_to_market(p, asset));
    then entered_constructive_ownership_transaction(p, asset);
}
@source(IRC_S1260_D, relation = formalizes, coverage = partial, quote = "(B) enters into a forward or futures contract to acquire the financial asset,")
rule ConstructiveOwnershipForwardRule(p: Person, asset: Asset) defeasible {
    label en official "section 1260(d)(1)(B) with (d)(2)";
    when financial_asset_1260(asset);
    when enters_forward_or_futures_contract_to_acquire(p, asset);
    when not_known(all_positions_marked_to_market(p, asset));
    then entered_constructive_ownership_transaction(p, asset);
}
rule ConstructiveOwnershipOptionsRule(p: Person, asset: Asset) defeasible {
    label en official "section 1260(d)(1)(C) with (d)(2)";
    when financial_asset_1260(asset);
    when holder_of_call_and_grantor_of_put_with_equal_strikes_and_maturities(p, asset);
    when not_known(all_positions_marked_to_market(p, asset));
    then entered_constructive_ownership_transaction(p, asset);
}
rule ConstructiveOwnershipRegulatoryRule(p: Person, asset: Asset) defeasible {
    label en official "section 1260(d)(1)(D) with (d)(2)";
    when financial_asset_1260(asset);
    when other_transaction_with_substantially_same_effect_by_regulation(p, asset);
    when not_known(all_positions_marked_to_market(p, asset));
    then entered_constructive_ownership_transaction(p, asset);
}

// (a), (e): the recharacterization
pub relation gain_from_constructive_ownership_transaction(p: Person, asset: Asset, amount: Money) kind empirical {
    label en official "section 1260(a): the taxpayer's gain from the constructive ownership transaction";
}
pub relation gain_would_be_long_term_capital_gain(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(a): the gain would (without regard to this section) be treated as long-term capital gain";
}
pub relation net_underlying_long_term_capital_gain_computed(p: Person, asset: Asset, amount: Money) kind empirical {
    label en official "section 1260(e): the aggregate net capital gain the taxpayer would have had if the asset had been acquired for fair market value on the date the transaction was opened and sold for fair market value on the date it was closed, counting only gains and losses from that deemed ownership";
}
pub relation net_underlying_gain_established_by_clear_and_convincing_evidence(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(e), last sentence: the amount of the net underlying long-term capital gain is established by clear and convincing evidence (an evidentiary standard, DECISION-0194: adjudicated fact)";
}
pub relation net_underlying_long_term_capital_gain_used(p: Person, asset: Asset, amount: Money) kind institutional {
    label en official "section 1260(e): the net underlying long-term capital gain, treated as zero unless established by clear and convincing evidence";
}
@source(IRC_S1260_E, relation = formalizes, coverage = exact, quote = "The amount of the net underlying long-term capital gain with respect to any financial asset shall be treated as zero unless the amount thereof is established by clear and convincing evidence.")
rule NetUnderlyingGainEstablishedRule(p: Person, asset: Asset, amount: Money) defeasible {
    label en official "section 1260(e), last sentence: the computed amount is used when established";
    when net_underlying_long_term_capital_gain_computed(p, asset, amount);
    when net_underlying_gain_established_by_clear_and_convincing_evidence(p, asset);
    then net_underlying_long_term_capital_gain_used(p, asset, amount);
}
rule NetUnderlyingGainNotEstablishedRule(p: Person, asset: Asset, amount: Money) defeasible {
    label en official "section 1260(e), last sentence: zero when not established";
    when net_underlying_long_term_capital_gain_computed(p, asset, amount);
    when not_known(net_underlying_gain_established_by_clear_and_convincing_evidence(p, asset));
    then net_underlying_long_term_capital_gain_used(p, asset, 0.00 USD);
}
pub relation section_1260_ordinary_income(p: Person, asset: Asset, amount: Money) kind institutional {
    label en official "section 1260(a)(1): the gain treated as ordinary income to the extent it exceeds the net underlying long-term capital gain";
}
pub relation section_1260_remaining_long_term_gain(p: Person, asset: Asset, amount: Money) kind institutional {
    label en official "section 1260(a)(2): the gain still treated as long-term capital gain after paragraph (1)";
}
@source(IRC_S1260_A, relation = formalizes, coverage = partial, quote = "(1) such gain shall be treated as ordinary income to the extent that such gain exceeds the net underlying long-term capital gain, and")
rule Section1260OrdinaryIncomeRule(p: Person, asset: Asset, gain: Money, underlying: Money) defeasible {
    label en official "section 1260(a)(1)";
    when entered_constructive_ownership_transaction(p, asset);
    when gain_from_constructive_ownership_transaction(p, asset, gain);
    when gain_would_be_long_term_capital_gain(p, asset);
    when net_underlying_long_term_capital_gain_used(p, asset, underlying);
    when gain > underlying;
    then section_1260_ordinary_income(p, asset, gain - underlying);
}
rule Section1260NoOrdinaryIncomeRule(p: Person, asset: Asset, gain: Money, underlying: Money) defeasible {
    label en official "section 1260(a)(1): nothing is recharacterized when the gain does not exceed the net underlying gain";
    when entered_constructive_ownership_transaction(p, asset);
    when gain_from_constructive_ownership_transaction(p, asset, gain);
    when gain_would_be_long_term_capital_gain(p, asset);
    when net_underlying_long_term_capital_gain_used(p, asset, underlying);
    when gain <= underlying;
    then section_1260_ordinary_income(p, asset, 0.00 USD);
}
@source(IRC_S1260_A, relation = formalizes, coverage = partial, quote = "(2) to the extent such gain is treated as a long-term capital gain after the application of paragraph (1)")
rule Section1260RemainingLongTermRule(p: Person, asset: Asset, gain: Money, ordinary: Money) defeasible {
    label en official "section 1260(a)(2): the rest stays long-term (the rate by reference to the underlying gain is G2327)";
    when gain_from_constructive_ownership_transaction(p, asset, gain);
    when section_1260_ordinary_income(p, asset, ordinary);
    then section_1260_remaining_long_term_gain(p, asset, gain - ordinary);
}
pub relation closed_by_taking_delivery(p: Person, asset: Asset) kind empirical {
    label en official "section 1260(f): the constructive ownership transaction is closed by reason of taking delivery";
}
pub relation section_1260f_deemed_sale_gain(p: Person, asset: Asset, amount: Money) kind institutional {
    label en official "section 1260(f): the gain recognized on the deemed sale at fair market value, not exceeding the ordinary income under subsection (a)";
}
pub relation deemed_sale_gain_at_fmv_on_delivery(p: Person, asset: Asset, amount: Money) kind empirical {
    label en official "section 1260(f): the gain on a deemed sale of all the positions for fair market value on the closing date";
}
@source(IRC_S1260_F, relation = formalizes, coverage = exact, quote = "The amount of gain recognized under the preceding sentence shall not exceed the amount of gain treated as ordinary income under subsection (a).")
rule Section1260fDeliveryGainRule(p: Person, asset: Asset, deemed: Money, ordinary: Money) defeasible {
    label en official "section 1260(f): min(deemed gain, ordinary income under (a)); the later adjustments are not modelled";
    when closed_by_taking_delivery(p, asset);
    when deemed_sale_gain_at_fmv_on_delivery(p, asset, deemed);
    when section_1260_ordinary_income(p, asset, ordinary);
    then section_1260f_deemed_sale_gain(p, asset, min(deemed, ordinary));
}
