// Stage 3b (IRC-07, A05). Miscellaneous remainder of the basis, exchange and mitigation
// provisions: section 1001(b)(1)-(2); 1014(d), (f)(3); 1015(b), (c), (d)(3); 1016(c), (d); 1031(e),
// (g); 1037(b); 1042(c)(4)(C), (d); 1092(d)(3)(B), (d)(5)(B); 1222(10); 1250(d)(4)(D); 1301(a);
// 1311(b)(2)-(3); Pub. L. 119-21 section 1062(b)(3).
//
// Method. Each provision is a small derivation over case-supplied amounts and dates. Ratios are
// Decimal dollar facts with div_round to six places, HALF_UP (JUDGMENT CALL). Cross-package
// computations (the section 2032A tax, the gas guzzler tax, the gift tax) are inputs.

// =============================================================================
// Section 1001(b)(1)-(2): real property tax proration
// =============================================================================

use self::{
    Asset,
    CircumstanceOfAdjustment,
    Corporation,
    DebtInstrument,
    Determination,
    IRC_S1001_B,
    IRC_S1014_D,
    IRC_S1014_F,
    IRC_S1015_B,
    IRC_S1015_C,
    IRC_S1015_D,
    IRC_S1016_C,
    IRC_S1016_D,
    IRC_S1031_E,
    IRC_S1031_G,
    IRC_S1037_B,
    IRC_S1042_C,
    IRC_S1042_D,
    IRC_S1092_D,
    IRC_S1222,
    IRC_S1250_D,
    IRC_S1301_A,
    IRC_S1311_B,
    Person,
    TaxableYear,
    Transaction,
    actual_tax_for_prior_year,
    circumstance_of_adjustment,
    decedent_died_on,
    issue_price_of_surrendered_obligation,
    market_discount_basis_after_acquisition,
    other_consideration_paid_to_united_states,
    section_2032_alternate_valuation_elected,
};

pub relation reimbursement_for_purchaser_real_property_taxes(t: Transaction, amount: Money) kind empirical {
    label en official "section 1001(b)(1): an amount received as reimbursement for real property taxes treated under section 164(d) as imposed on the purchaser";
}
pub relation seller_taxes_paid_by_purchaser(t: Transaction, amount: Money) kind empirical {
    label en official "section 1001(b)(2): amounts representing real property taxes treated under section 164(d) as imposed on the taxpayer, to be paid by the purchaser";
}
pub relation money_and_property_received_for_1001b(t: Transaction, amount: Money) kind empirical {
    label en official "section 1001(b): the sum of any money received plus the fair market value of the property (other than money) received";
}
pub relation disposing_taxpayer_1001b(t: Transaction, p: Person) kind empirical {
    label en official "section 1001(b): the taxpayer disposing of the property";
}
pub relation adjusted_amount_realized_1001b(p: Person, t: Transaction, amount: Money) kind institutional {
    label en official "section 1001(b)(1)-(2): the amount realized without the purchaser-tax reimbursement and with the seller taxes the purchaser pays (the case gives 0.00 USD for an absent item)";
}
@source(IRC_S1001_B, relation = formalizes, coverage = exact, quote = "The amount realized from the sale or other disposition of property shall be the sum of any money received plus the fair market value of the property (other than money) received")
rule AdjustedAmountRealizedRule(p: Person, t: Transaction, gross: Money, reimbursed: Money, seller_taxes: Money) defeasible {
    label en official "section 1001(b): received amount less the purchaser-tax reimbursement plus the seller taxes paid by the purchaser";
    when disposing_taxpayer_1001b(t, p);
    when money_and_property_received_for_1001b(t, gross);
    when reimbursement_for_purchaser_real_property_taxes(t, reimbursed);
    when seller_taxes_paid_by_purchaser(t, seller_taxes);
    then adjusted_amount_realized_1001b(p, t, gross - reimbursed + seller_taxes);
}
pub relation reimbursement_excluded_from_amount_realized_1001b1(t: Transaction, amount: Money) kind institutional {
    label en official "section 1001(b)(1): the reimbursement is not taken into account";
}
@source(IRC_S1001_B, relation = formalizes, coverage = exact, quote = "there shall not be taken into account any amount received as reimbursement for real property taxes which are treated under section 164(d) as imposed on the purchaser")
rule ReimbursementExcludedRule(t: Transaction, amount: Money) defeasible {
    label en official "section 1001(b)(1): a purchaser-tax reimbursement is excluded";
    when reimbursement_for_purchaser_real_property_taxes(t, amount);
    then reimbursement_excluded_from_amount_realized_1001b1(t, amount);
}
pub relation seller_taxes_included_in_amount_realized_1001b2(t: Transaction, amount: Money) kind institutional {
    label en official "section 1001(b)(2): the seller taxes the purchaser pays are taken into account";
}
@source(IRC_S1001_B, relation = formalizes, coverage = exact, quote = "there shall be taken into account amounts representing real property taxes which are treated under section 164(d) as imposed on the taxpayer if such taxes are to be paid by the purchaser")
rule SellerTaxesIncludedRule(t: Transaction, amount: Money) defeasible {
    label en official "section 1001(b)(2): seller taxes paid by the purchaser are included";
    when seller_taxes_paid_by_purchaser(t, amount);
    then seller_taxes_included_in_amount_realized_1001b2(t, amount);
}

// =============================================================================
// Section 1014(d), (f)(3)
// =============================================================================

pub relation stock_of_decedent_in_disc_or_former_disc(a: Asset, decedent: Person) kind empirical {
    label en official "section 1014(d): stock owned by a decedent in a DISC or former DISC (as defined in section 992(a))";
}
pub relation new_basis_before_disc_reduction(a: Asset, amount: Money) kind empirical {
    label en official "section 1014(d): the new basis determined before the application of the subsection";
}
pub relation hypothetical_995c_dividend_on_sale_at_valuation_date(a: Asset, amount: Money) kind empirical {
    label en official "section 1014(d): the amount which would have been included in gross income under section 995(c) as a dividend had the decedent lived and sold the stock at fair market value on the estate tax valuation date (basis determined without regard to the last sentence of section 996(e)(2))";
}
pub relation estate_tax_valuation_date_1014d(decedent: Person, on: Date) kind institutional {
    label en official "section 1014(d): the date of the decedent's death or, on a section 2032 election, the alternate valuation date";
}
@source(IRC_S1014_D, relation = formalizes, coverage = exact, quote = "the estate tax valuation date is the date of the decedent's death")
rule ValuationDateDeathRule(decedent: Person, died: Date) defeasible {
    label en official "section 1014(d): the date of death when no section 2032 election is made";
    when decedent_died_on(decedent, died);
    when not_known(section_2032_alternate_valuation_elected(decedent));
    then estate_tax_valuation_date_1014d(decedent, died);
}
pub relation alternate_valuation_date_2032(decedent: Person, on: Date) kind empirical {
    label en official "section 1014(d): the applicable valuation date prescribed by section 2032";
}
rule ValuationDateAlternateRule(decedent: Person, alt: Date) defeasible {
    label en official "section 1014(d): the section 2032 alternate valuation date on an election";
    when section_2032_alternate_valuation_elected(decedent);
    when alternate_valuation_date_2032(decedent, alt);
    then estate_tax_valuation_date_1014d(decedent, alt);
}
pub relation basis_after_disc_reduction_1014d(a: Asset, amount: Money) kind institutional {
    label en official "section 1014(d): the new basis reduced by the hypothetical section 995(c) dividend";
}
@source(IRC_S1014_D, relation = formalizes, coverage = exact, quote = "such basis (determined before the application of this subsection) shall be reduced by the amount (if any) which would have been included in gross income under section 995(c) as a dividend")
rule DiscBasisReductionRule(a: Asset, decedent: Person, basis: Money, dividend: Money) defeasible {
    label en official "section 1014(d): the stepped-up basis of DISC stock less the hypothetical dividend";
    when stock_of_decedent_in_disc_or_former_disc(a, decedent);
    when new_basis_before_disc_reduction(a, basis);
    when hypothetical_995c_dividend_on_sale_at_valuation_date(a, dividend);
    then basis_after_disc_reduction_1014d(a, basis - dividend);
}
pub relation value_shown_on_6018_return_not_contested(a: Asset) kind empirical {
    label en official "section 1014(f)(3)(A): the value is shown on a return under section 6018 and not contested by the Secretary before the time for assessing chapter 11 tax expires";
}
pub relation value_specified_by_secretary_not_timely_contested(a: Asset) kind empirical {
    label en official "section 1014(f)(3)(B): the value is specified by the Secretary and not timely contested by the executor";
}
pub relation value_determined_by_court_or_settlement(a: Asset) kind empirical {
    label en official "section 1014(f)(3)(C): the value is determined by a court or pursuant to a settlement agreement with the Secretary";
}
pub relation chapter_11_value_determined_1014f3(a: Asset) kind institutional {
    label en official "section 1014(f)(3): the final value of the property has been determined for purposes of the estate tax";
}
@source(IRC_S1014_F, relation = formalizes, coverage = exact, quote = "the value of such property is shown on a return under section 6018 and such value is not contested by the Secretary before the expiration of the time for assessing a tax under chapter 11")
rule ValueDeterminedByReturnRule(a: Asset) strict {
    label en official "section 1014(f)(3)(A): a return value not contested in time";
    when value_shown_on_6018_return_not_contested(a);
    then chapter_11_value_determined_1014f3(a);
}
@source(IRC_S1014_F, relation = formalizes, coverage = exact, quote = "the value is specified by the Secretary and such value is not timely contested by the executor of the estate")
rule ValueDeterminedBySecretaryRule(a: Asset) strict {
    label en official "section 1014(f)(3)(B): a value specified by the Secretary and not timely contested";
    when value_specified_by_secretary_not_timely_contested(a);
    when not_known(value_shown_on_6018_return_not_contested(a));
    then chapter_11_value_determined_1014f3(a);
}
@source(IRC_S1014_F, relation = formalizes, coverage = exact, quote = "the value is determined by a court or pursuant to a settlement agreement with the Secretary")
rule ValueDeterminedByCourtRule(a: Asset) strict {
    label en official "section 1014(f)(3)(C): a value determined by a court or settlement";
    when value_determined_by_court_or_settlement(a);
    then chapter_11_value_determined_1014f3(a);
}

// =============================================================================
// Section 1015(b), (c), (d)(3)
// =============================================================================

pub relation acquired_by_non_gift_transfer_in_trust_after_1920(a: Asset) kind empirical {
    label en official "section 1015(b): the property was acquired after December 31, 1920 by a transfer in trust (other than by gift, bequest or devise)";
}
pub relation grantors_basis_1015b(a: Asset, amount: Money) kind empirical {
    label en official "section 1015(b): the basis the property would have in the hands of the grantor";
}
pub relation grantors_net_gain_or_loss_recognized_1015b(a: Asset, signed_amount: Money) kind empirical {
    label en official "section 1015(b): the gain (positive) or loss (negative) recognized to the grantor on the transfer";
}
pub relation trust_transfer_basis_1015b(a: Asset, amount: Money) kind institutional {
    label en official "section 1015(b): the grantor's basis increased by the gain, or decreased by the loss, recognized to the grantor";
}
@source(IRC_S1015_B, relation = formalizes, coverage = exact, quote = "the basis shall be the same as it would be in the hands of the grantor increased in the amount of gain or decreased in the amount of loss recognized to the grantor on such transfer")
rule TrustTransferBasisRule(a: Asset, basis: Money, adjustment: Money) defeasible {
    label en official "section 1015(b): grantor basis plus the recognized gain less the recognized loss";
    when acquired_by_non_gift_transfer_in_trust_after_1920(a);
    when grantors_basis_1015b(a, basis);
    when grantors_net_gain_or_loss_recognized_1015b(a, adjustment);
    then trust_transfer_basis_1015b(a, basis + adjustment);
}
pub relation acquired_by_gift_or_trust_on_or_before_1920(a: Asset, acquired_on: Date) kind empirical {
    label en official "section 1015(c): the property was acquired by gift or transfer in trust on or before December 31, 1920";
}
pub relation fair_market_value_at_acquisition_1015c(a: Asset, amount: Money) kind empirical {
    label en official "section 1015(c): the fair market value of the property at the time of acquisition";
}
pub relation pre_1921_basis_1015c(a: Asset, amount: Money) kind institutional {
    label en official "section 1015(c): the basis is the fair market value at the time of acquisition";
}
@source(IRC_S1015_C, relation = formalizes, coverage = exact, quote = "the basis shall be the fair market value of such property at the time of such acquisition")
rule Pre1921BasisRule(a: Asset, on: Date, fmv: Money) defeasible {
    label en official "section 1015(c): a pre-1921 gift or trust transfer takes the fair market value as basis";
    when acquired_by_gift_or_trust_on_or_before_1920(a, on);
    when on <= @1920-12-31;
    when fair_market_value_at_acquisition_1015c(a, fmv);
    then pre_1921_basis_1015c(a, fmv);
}
pub relation split_gift_election_2513(donor: Person, spouse: Person, a: Asset) kind empirical {
    label en official "section 1015(d)(3): the donor and the spouse elected under section 2513 to have the gift considered as made one-half by each";
}
pub relation gift_tax_paid_on_first_half(a: Asset, amount: Money) kind empirical {
    label en official "section 1015(d)(3): the gift tax paid with respect to the donor's half (computed under paragraph (2))";
}
pub relation gift_tax_paid_on_second_half(a: Asset, amount: Money) kind empirical {
    label en official "section 1015(d)(3): the gift tax paid with respect to the spouse's half (computed under paragraph (2))";
}
pub relation gift_tax_paid_on_split_gift_1015d3(a: Asset, amount: Money) kind institutional {
    label en official "section 1015(d)(3): the gift tax paid on a split gift is the sum of the tax paid on each half";
}
@source(IRC_S1015_D, relation = formalizes, coverage = exact, quote = "the amount of gift tax paid with respect to such gift under chapter 12 shall be the sum of the amounts of tax paid with respect to each half of such gift")
rule SplitGiftTaxRule(donor: Person, spouse: Person, a: Asset, first: Money, second: Money) defeasible {
    label en official "section 1015(d)(3): the two halves' tax is summed";
    when split_gift_election_2513(donor, spouse, a);
    when gift_tax_paid_on_first_half(a, first);
    when gift_tax_paid_on_second_half(a, second);
    then gift_tax_paid_on_split_gift_1015d3(a, first + second);
}

// =============================================================================
// Section 1016(c): additional estate tax election
// =============================================================================

pub relation additional_estate_tax_imposed_2032A_c1(interest: Asset) kind empirical {
    label en official "section 1016(c)(1): an additional estate tax is imposed under section 2032A(c)(1) with respect to the interest";
}
pub relation qualified_heir_elects_1016c(heir: Person, interest: Asset) kind empirical {
    label en official "section 1016(c)(5)(A): the qualified heir elects under subsection (c)";
}
pub relation fair_market_value_of_interest_at_death_or_alternate_date(interest: Asset, amount: Money) kind empirical {
    label en official "section 1016(c)(1)(A): the fair market value of the interest on the date of the decedent's death (or the section 2032 alternate valuation date)";
}
pub relation value_of_interest_under_2032A_a(interest: Asset, amount: Money) kind empirical {
    label en official "section 1016(c)(1)(B): the value of the interest determined under section 2032A(a)";
}
pub relation election_timely_and_in_manner_prescribed_1016c5A(interest: Asset) kind empirical {
    label en official "section 1016(c)(5)(A): the election is made at the time and in the manner the Secretary prescribes by regulations";
}
pub relation election_in_effect_1016c(interest: Asset) kind institutional {
    label en official "section 1016(c)(5)(A): the election is made (and irrevocable)";
}
@source(IRC_S1016_C, relation = formalizes, coverage = exact, quote = "Such an election, once made, shall be irrevocable")
rule Section1016cElectionPower(heir: Person, interest: Asset) strict {
    label en official "section 1016(c)(5)(A): a qualified heir may elect the basis increase; once made it is irrevocable";
    when qualified_heir_elects_1016c(heir, interest);
    then power Section1016cBasisIncreaseElection {
        holder heir;
        over interest;
        exercise qualified_heir_elects_1016c(heir, interest);
        valid_when election_timely_and_in_manner_prescribed_1016c5A(interest);
        effect create(election_in_effect_1016c(interest));
        window [@1976-10-04, infinity);
    };
}
pub relation basis_increase_entire_interest_1016c1(interest: Asset, amount: Money) kind institutional {
    label en official "section 1016(c)(1): the increase in the adjusted basis of the interest - the fair market value at death (or alternate date) over the section 2032A(a) value";
}
@source(IRC_S1016_C, relation = formalizes, coverage = exact, quote = "the adjusted basis of such interest shall be increased by an amount equal to the excess of")
rule BasisIncreaseEntireInterestRule(interest: Asset, fmv: Money, special: Money) defeasible {
    label en official "section 1016(c)(1): the excess of fair market value over the special-use value, on an additional estate tax and an election";
    when additional_estate_tax_imposed_2032A_c1(interest);
    when election_in_effect_1016c(interest);
    when fair_market_value_of_interest_at_death_or_alternate_date(interest, fmv);
    when value_of_interest_under_2032A_a(interest, special);
    when fmv > special;
    then basis_increase_entire_interest_1016c1(interest, fmv - special);
}
pub relation disposition_under_2032A_c2D(interest: Asset) kind empirical {
    label en official "section 2032A(c)(2)(D): a partial disposition or cessation";
}
pub relation disposition_under_2032A_h1B(interest: Asset) kind empirical {
    label en official "section 2032A(h)(1)(B): a partial disposition of qualified replacement property";
}
pub relation disposition_under_2032A_i1B(interest: Asset) kind empirical {
    label en official "section 2032A(i)(1)(B): a partial disposition of qualified exchange property";
}
pub relation partial_disposition_1016c2B(interest: Asset) kind institutional {
    label en official "section 1016(c)(2)(B): a disposition or cessation to which section 2032A(c)(2)(D), (h)(1)(B) or (i)(1)(B) applies";
}
@source(IRC_S1016_C, relation = formalizes, coverage = exact, quote = "the term \"partial disposition\" means any disposition or cessation to which subsection (c)(2)(D), (h)(1)(B), or (i)(1)(B) of section 2032A applies")
rule PartialDispositionC2DRule(interest: Asset) strict {
    label en official "section 1016(c)(2)(B): a section 2032A(c)(2)(D) partial disposition";
    when disposition_under_2032A_c2D(interest);
    then partial_disposition_1016c2B(interest);
}
rule PartialDispositionH1BRule(interest: Asset) strict {
    label en official "section 1016(c)(2)(B): a section 2032A(h)(1)(B) partial disposition";
    when disposition_under_2032A_h1B(interest);
    then partial_disposition_1016c2B(interest);
}
rule PartialDispositionI1BRule(interest: Asset) strict {
    label en official "section 1016(c)(2)(B): a section 2032A(i)(1)(B) partial disposition";
    when disposition_under_2032A_i1B(interest);
    then partial_disposition_1016c2B(interest);
}
pub relation tax_on_partial_disposition_dollars_2032A(interest: Asset, dollars: Decimal) kind empirical {
    label en official "section 1016(c)(2)(A)(ii): the amount of the tax imposed under section 2032A(c)(1) with respect to the disposition";
}
pub relation adjusted_tax_difference_entire_interest_dollars(interest: Asset, dollars: Decimal) kind empirical {
    label en official "section 1016(c)(2)(A)(ii): the adjusted tax difference attributable to the entire interest (section 2032A(c)(2)(B))";
}
pub relation basis_increase_partial_disposition_1016c2A(interest: Asset, amount: Money) kind institutional {
    label en official "section 1016(c)(2)(A): the entire-interest increase in the ratio of the disposition's tax to the entire interest's adjusted tax difference";
}
@source(IRC_S1016_C, relation = formalizes, coverage = exact, quote = "which bears the same ratio to the increase which would be determined under paragraph (1) (without regard to this paragraph) with respect to the entire interest")
rule BasisIncreasePartialRule(interest: Asset, entire: Money, tax: Decimal, difference: Decimal) defeasible {
    label en official "section 1016(c)(2)(A): the entire increase times tax over adjusted tax difference (six-place ratio, cents HALF_UP: JUDGMENT CALL)";
    when partial_disposition_1016c2B(interest);
    when basis_increase_entire_interest_1016c1(interest, entire);
    when tax_on_partial_disposition_dollars_2032A(interest, tax);
    when adjusted_tax_difference_entire_interest_dollars(interest, difference);
    when difference > 0.0;
    then basis_increase_partial_disposition_1016c2A(interest, round(entire * div_round(tax, difference, 6, "HALF_UP"), 2, "HALF_UP"));
}
pub relation disposition_or_cessation_date_2032A(interest: Asset, on: Date) kind empirical {
    label en official "section 1016(c)(3): the date of the disposition or cessation resulting in the tax under section 2032A(c)(1)";
}
pub relation basis_increase_effective_date_1016c3(interest: Asset, on: Date) kind institutional {
    label en official "section 1016(c)(3): the increase is deemed to occur immediately before the disposition or cessation (modelled as the disposition date, the ordering within the day being the case's: JUDGMENT CALL)";
}
@source(IRC_S1016_C, relation = formalizes, coverage = exact, quote = "shall be deemed to have occurred immediately before the disposition or cessation resulting in the imposition of the tax under section 2032A(c)(1)")
rule BasisIncreaseEffectiveDateRule(interest: Asset, on: Date) defeasible {
    label en official "section 1016(c)(3): the effective date of the increase";
    when election_in_effect_1016c(interest);
    when disposition_or_cessation_date_2032A(interest, on);
    then basis_increase_effective_date_1016c3(interest, on);
}
pub relation qualified_replacement_property_of(interest: Asset, converted: Asset) kind empirical {
    label en official "section 1016(c)(4): the interest is qualified replacement property (section 2032A(h)(3)(B)) for the property involuntarily converted";
}
pub relation qualified_exchange_property_of(interest: Asset, exchanged: Asset) kind empirical {
    label en official "section 1016(c)(4): the interest is qualified exchange property (section 2032A(i)(3)) for the property exchanged";
}
pub relation basis_increase_reference_property_1016c4(interest: Asset, ref_asset: Asset) kind institutional {
    label en official "section 1016(c)(4): the increase is made by reference to the property involuntarily converted or exchanged";
}
@source(IRC_S1016_C, relation = formalizes, coverage = exact, quote = "the increase in basis under paragraph (1) shall be made by reference to the property involuntarily converted or exchanged (as the case may be)")
rule ReferenceConvertedPropertyRule(interest: Asset, converted: Asset) defeasible {
    label en official "section 1016(c)(4): replacement property refers to the property converted";
    when qualified_replacement_property_of(interest, converted);
    then basis_increase_reference_property_1016c4(interest, converted);
}
rule ReferenceExchangedPropertyRule(interest: Asset, exchanged: Asset) defeasible {
    label en official "section 1016(c)(4): exchange property refers to the property exchanged";
    when qualified_exchange_property_of(interest, exchanged);
    then basis_increase_reference_property_1016c4(interest, exchanged);
}
pub relation last_date_for_payment_of_2001_tax(interest: Asset, on: Date) kind empirical {
    label en official "section 1016(c)(5)(B): the last date prescribed for payment of the tax imposed by section 2001 with respect to the decedent's estate (as determined for section 6601)";
}
pub relation deemed_last_payment_date_for_6601_1016c5B(interest: Asset, on: Date) kind institutional {
    label en official "section 1016(c)(5)(B): for section 6601 the last date for paying the additional estate tax is the last date for paying the section 2001 tax";
}
@source(IRC_S1016_C, relation = formalizes, coverage = exact, quote = "the last date prescribed for payment of such tax shall be deemed to be the last date prescribed for payment of the tax imposed by section 2001 with respect to the estate of the decedent")
rule DeemedLastPaymentDateRule(interest: Asset, on: Date) defeasible {
    label en official "section 1016(c)(5)(B): the section 2001 payment date applies to the additional tax where the election is made";
    when election_in_effect_1016c(interest);
    when additional_estate_tax_imposed_2032A_c1(interest);
    when last_date_for_payment_of_2001_tax(interest, on);
    then deemed_last_payment_date_for_6601_1016c5B(interest, on);
}

// =============================================================================
// Section 1016(d): gas guzzler tax
// =============================================================================

pub relation automobile_subject_to_4064_tax(a: Asset, tax: Money) kind empirical {
    label en official "section 1016(d)(1): the taxpayer acquires an automobile with respect to which a tax was imposed by section 4064";
}
pub relation first_sale_for_ultimate_use_on(a: Asset, on: Date) kind empirical {
    label en official "section 1016(d)(2): the date of the first sale for ultimate use of the automobile";
}
pub relation automobile_imported(a: Asset) kind empirical {
    label en official "section 1016(d): the automobile was imported";
}
pub relation entry_or_warehouse_withdrawal_date(a: Asset, on: Date) kind empirical {
    label en official "section 1016(d): the date of entry or withdrawal from warehouse for consumption";
}
pub relation taxpayer_use_begins_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "section 1016(d)(2): the date the use of the automobile by the taxpayer begins";
}
pub relation sale_reference_date_1016d(a: Asset, on: Date) kind institutional {
    label en official "section 1016(d): the date of the first sale for ultimate use, or on importation the later entry or withdrawal date";
}
rule ReferenceDateFirstSaleRule(a: Asset, sale: Date) defeasible {
    label en official "section 1016(d): the first-sale date for a domestic automobile";
    when first_sale_for_ultimate_use_on(a, sale);
    when not_known(automobile_imported(a));
    then sale_reference_date_1016d(a, sale);
}
rule ReferenceDateImportedEarlierRule(a: Asset, sale: Date, entry: Date) defeasible {
    label en official "section 1016(d): the first-sale date where the entry date is not later";
    when first_sale_for_ultimate_use_on(a, sale);
    when automobile_imported(a);
    when entry_or_warehouse_withdrawal_date(a, entry);
    when entry <= sale;
    then sale_reference_date_1016d(a, sale);
}
@source(IRC_S1016_D, relation = formalizes, coverage = exact, quote = "if the date of entry or withdrawal from warehouse for consumption is later than the date of the first sale for ultimate use, such later date shall be substituted")
rule ReferenceDateImportedLaterRule(a: Asset, sale: Date, entry: Date) defeasible {
    label en official "section 1016(d): the later entry or withdrawal date replaces the first-sale date on importation";
    when first_sale_for_ultimate_use_on(a, sale);
    when automobile_imported(a);
    when entry_or_warehouse_withdrawal_date(a, entry);
    when entry > sale;
    then sale_reference_date_1016d(a, entry);
}
pub relation basis_reduction_gas_guzzler_1016d(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "section 1016(d): the basis of the automobile is reduced by the section 4064 tax";
}
@source(IRC_S1016_D, relation = formalizes, coverage = exact, quote = "the basis of such automobile shall be reduced by the amount of the tax imposed by section 4064 with respect to such automobile")
rule GasGuzzlerBasisReductionRule(p: Person, a: Asset, tax: Money, ref_date: Date, used: Date) defeasible {
    label en official "section 1016(d): use begins within 1 year of the reference date";
    when automobile_subject_to_4064_tax(a, tax);
    when sale_reference_date_1016d(a, ref_date);
    when taxpayer_use_begins_on(p, a, used);
    when used <= add_calendar_period(ref_date, 1 calendar_year);
    then basis_reduction_gas_guzzler_1016d(p, a, tax);
}

// =============================================================================
// Section 1031(e), (g)
// =============================================================================

pub relation interest_in_partnership_with_761a_election(p: Person, interest: Asset) kind empirical {
    label en official "section 1031(e): an interest in a partnership that has in effect a valid election under section 761(a) to be excluded from all of subchapter K";
}
pub relation asset_of_excluded_partnership(interest: Asset, item: Asset) kind empirical {
    label en official "section 1031(e): an asset of the partnership";
}
pub relation treated_as_interest_in_each_asset_1031e(p: Person, interest: Asset, item: Asset) kind institutional {
    label en official "section 1031(e): the interest is treated as an interest in each of the partnership's assets and not as a partnership interest";
}
@source(IRC_S1031_E, relation = formalizes, coverage = exact, quote = "shall be treated as an interest in each of the assets of such partnership and not as an interest in a partnership")
rule ExcludedPartnershipInterestRule(p: Person, interest: Asset, item: Asset) defeasible {
    label en official "section 1031(e): a subchapter K-excluded partnership interest is an interest in each asset";
    when interest_in_partnership_with_761a_election(p, interest);
    when asset_of_excluded_partnership(interest, item);
    then treated_as_interest_in_each_asset_1031e(p, interest, item);
}
pub relation holder_holds_put_on_property(prop: Asset) kind empirical {
    label en official "section 1031(g)(2)(A): the holder holds a put with respect to the property";
}
pub relation another_person_holds_right_to_acquire(prop: Asset) kind empirical {
    label en official "section 1031(g)(2)(B): another person holds a right to acquire the property";
}
pub relation short_sale_or_other_risk_diminishing_transaction(prop: Asset) kind empirical {
    label en official "section 1031(g)(2)(C): a short sale or any other transaction substantially diminishing the risk of loss";
}
pub relation risk_of_loss_diminished_days(prop: Asset, days: Integer) kind empirical {
    label en official "section 1031(g)(2): the number of days in the period during which the holder's risk of loss is substantially diminished";
}
pub relation risk_of_loss_substantially_diminished_1031g2(prop: Asset) kind institutional {
    label en official "section 1031(g)(2): the holder's risk of loss with respect to the property is substantially diminished";
}
@source(IRC_S1031_G, relation = formalizes, coverage = exact, quote = "the holding of a put with respect to such property")
rule RiskDiminishedByPutRule(prop: Asset) strict {
    label en official "section 1031(g)(2)(A): a put diminishes the risk";
    when holder_holds_put_on_property(prop);
    then risk_of_loss_substantially_diminished_1031g2(prop);
}
@source(IRC_S1031_G, relation = formalizes, coverage = exact, quote = "the holding by another person of a right to acquire such property")
rule RiskDiminishedByRightRule(prop: Asset) strict {
    label en official "section 1031(g)(2)(B): another person's right to acquire diminishes the risk";
    when another_person_holds_right_to_acquire(prop);
    then risk_of_loss_substantially_diminished_1031g2(prop);
}
@source(IRC_S1031_G, relation = formalizes, coverage = exact, quote = "a short sale or any other transaction")
rule RiskDiminishedByShortSaleRule(prop: Asset) strict {
    label en official "section 1031(g)(2)(C): a short sale or other transaction diminishes the risk";
    when short_sale_or_other_risk_diminishing_transaction(prop);
    then risk_of_loss_substantially_diminished_1031g2(prop);
}
pub relation period_1031f1C_suspended_days_1031g1(prop: Asset, days: Integer) kind institutional {
    label en official "section 1031(g)(1): the number of days by which the running of the section 1031(f)(1)(C) period is suspended";
}
@source(IRC_S1031_G, relation = formalizes, coverage = exact, quote = "the running of the period set forth in subsection (f)(1)(C) with respect to such property shall be suspended during such period")
rule PeriodSuspendedRule(prop: Asset, days: Integer) defeasible {
    label en official "section 1031(g)(1): the period is suspended for the days of diminished risk";
    when risk_of_loss_substantially_diminished_1031g2(prop);
    when risk_of_loss_diminished_days(prop, days);
    then period_1031f1C_suspended_days_1031g1(prop, days);
}

// =============================================================================
// Section 1037(b)
// =============================================================================

pub relation later_gain_recognized_on_obligation_received_1037(later_t: Transaction, exchange_t: Transaction) kind empirical {
    label en official "section 1037(b)(1): gain realized but not recognized on the exchange is later recognized by a disposition or redemption of the obligation received";
}
pub relation surrendered_obligation_of_exchange(exchange_t: Transaction, surrendered: Asset) kind empirical {
    label en official "section 1037(b)(1): the obligation surrendered to the Government in the exchange";
}
pub relation treated_as_disposition_of_surrendered_obligation_1037b1(later_t: Transaction, surrendered: Asset) kind institutional {
    label en official "section 1037(b)(1): for the first sentence of section 1271(c)(2) the obligation disposed of or redeemed is treated as the obligation surrendered in the exchange";
}
@source(IRC_S1037_B, relation = formalizes, coverage = partial, quote = "shall apply to such gain as though the obligation disposed of or redeemed were the obligation surrendered to the Government in the exchange rather than the obligation actually disposed of or redeemed")
rule SurrenderedObligationSubstitutionRule(later_t: Transaction, exchange_t: Transaction, surrendered: Asset) defeasible {
    label en official "section 1037(b)(1): the later gain is treated as on the surrendered obligation";
    when later_gain_recognized_on_obligation_received_1037(later_t, exchange_t);
    when surrendered_obligation_of_exchange(exchange_t, surrendered);
    then treated_as_disposition_of_surrendered_obligation_1037b1(later_t, surrendered);
}
pub relation transferable_obligation_issued_at_not_less_than_par(t: Transaction) kind empirical {
    label en official "section 1037(b)(2): the transferable obligation surrendered was issued at not less than par";
}
pub relation issue_price_of_obligation_received_1037b2(t: Transaction, amount: Money) kind institutional {
    label en official "section 1037(b)(2): the issue price of the obligation received - the issue price of the obligation surrendered increased by other consideration paid";
}
@source(IRC_S1037_B, relation = formalizes, coverage = exact, quote = "the issue price of the obligation received from the Government in the exchange shall be considered for purposes of applying subpart A of part V of subchapter P to be the same as the issue price of the obligation surrendered to the Government in the exchange")
rule IssuePriceReceivedParRule(t: Transaction, ip: Money, other: Money) defeasible {
    label en official "section 1037(b)(2): issue price of the surrendered obligation plus other consideration";
    when transferable_obligation_issued_at_not_less_than_par(t);
    when issue_price_of_surrendered_obligation(t, ip);
    when other_consideration_paid_to_united_states(t, other);
    then issue_price_of_obligation_received_1037b2(t, ip + other);
}

// =============================================================================
// Section 1042(c)(4)(C), (d)
// =============================================================================

pub relation owns_control_stock_304c_disregarding_qrp(owner: Corporation, owned: Corporation) kind empirical {
    label en official "section 1042(c)(4)(C)(ii): the corporation owns stock representing control (section 304(c)) of the other, disregarding the taxpayer's qualified replacement property";
}
pub relation treated_as_one_corporation_1042c4C(issuer: Corporation, other: Corporation) kind institutional {
    label en official "section 1042(c)(4)(C)(i): the issuing corporation and the controlling or controlled corporation are treated as one corporation";
}
@source(IRC_S1042_C, relation = formalizes, coverage = partial, quote = "then all such corporations shall be treated as 1 corporation")
rule IssuerControlsOtherRule(issuer: Corporation, other: Corporation) defeasible {
    label en official "section 1042(c)(4)(C)(i)(I): the issuer owns control of another corporation";
    when owns_control_stock_304c_disregarding_qrp(issuer, other);
    then treated_as_one_corporation_1042c4C(issuer, other);
}
rule OtherControlsIssuerRule(issuer: Corporation, other: Corporation) defeasible {
    label en official "section 1042(c)(4)(C)(i)(II): another corporation owns control of the issuer";
    when owns_control_stock_304c_disregarding_qrp(other, issuer);
    then treated_as_one_corporation_1042c4C(issuer, other);
}
pub relation basis_reduction_under_1042d(bond: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1042(d): the reduction in basis of the property";
}
pub relation market_discount_basis_disregarding_1042d(bond: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1042(d): a reduction in basis under the subsection is not taken into account for section 1278(a)(2)(A)(ii)";
}
@source(IRC_S1042_D, relation = formalizes, coverage = exact, quote = "Any reduction in basis under this subsection shall not be taken into account for purposes of section 1278(a)(2)(A)(ii)")
rule MarketDiscountBasisDisregardingRule(bond: DebtInstrument, basis: Money, reduction: Money) defeasible {
    label en official "section 1042(d): the basis for market discount is the basis before the section 1042 reduction";
    when market_discount_basis_after_acquisition(bond, basis);
    when basis_reduction_under_1042d(bond, reduction);
    then market_discount_basis_disregarding_1042d(bond, basis + reduction);
}

// =============================================================================
// Section 1092(d)(3)(B), (d)(5)(B)
// =============================================================================

pub relation includible_corporation_of_affiliated_group_1504a(corp: Corporation, grp: Asset) kind empirical {
    label en official "section 1092(d)(3)(B): an includible corporation of an affiliated group (within the meaning of section 1504(a))";
}
pub relation transaction_in_stock_described_1092d3A_ii(t: Transaction) kind empirical {
    label en official "section 1092(d)(3)(A)(ii): a transaction with respect to stock described in the subparagraph";
}
pub relation affiliated_group_treated_as_one_taxpayer_1092d3B(t: Transaction, c1: Corporation, c2: Corporation) kind institutional {
    label en official "section 1092(d)(3)(B): for section 1092(e) all includible corporations of an affiliated group are treated as 1 taxpayer";
}
@source(IRC_S1092_D, relation = formalizes, coverage = exact, quote = "all includible corporations of an affiliated group (within the meaning of section 1504(a)) shall be treated as 1 taxpayer")
rule AffiliatedGroupOneTaxpayerRule(t: Transaction, c1: Corporation, c2: Corporation, grp: Asset) defeasible {
    label en official "section 1092(d)(3)(B): members of one affiliated group are one taxpayer";
    when transaction_in_stock_described_1092d3A_ii(t);
    when includible_corporation_of_affiliated_group_1504a(c1, grp);
    when includible_corporation_of_affiliated_group_1504a(c2, grp);
    when c1 != c2;
    then affiliated_group_treated_as_one_taxpayer_1092d3B(t, c1, c2);
}
pub relation straddle_offsetting_positions_all_1256_contracts(straddle: Asset) kind empirical {
    label en official "section 1092(d)(5)(B): all of the offsetting positions of the straddle consist of section 1256 contracts";
}
pub relation identified_straddle_subparagraph_A_and_1256a4_disapplied_1092d5B(straddle: Asset) kind institutional {
    label en official "section 1092(d)(5)(B): for section 1092(a)(2) subparagraph (A) and section 1256(a)(4) do not apply to the straddle";
}
@source(IRC_S1092_D, relation = formalizes, coverage = exact, quote = "subparagraph (A) and section 1256(a)(4) shall not apply to a straddle all of the offsetting positions of which consist of section 1256 contracts")
rule Section1256StraddleRule(straddle: Asset) defeasible {
    label en official "section 1092(d)(5)(B): a straddle wholly of section 1256 contracts is outside subparagraph (A) and section 1256(a)(4)";
    when straddle_offsetting_positions_all_1256_contracts(straddle);
    then identified_straddle_subparagraph_A_and_1256a4_disapplied_1092d5B(straddle);
}

// =============================================================================
// Section 1222(10)
// =============================================================================

pub relation capital_losses_from_sales_or_exchanges_1222_10(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1222(10): the losses from sales or exchanges of capital assets";
}
pub relation section_1211_allowed_amount_1222_10(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1222(10): the sum allowed under section 1211";
}
pub relation corporate_taxpayer_1222_10(p: Person) kind empirical {
    label en official "section 1222(10): the taxpayer is a corporation";
}
pub relation short_term_losses_under_1212a1_1222_10(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1222(10): amounts which are short-term capital losses under section 1212(a)(1) (excluded for a corporation)";
}
pub relation net_capital_loss_1222_10(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1222(10): the excess of the losses from sales or exchanges of capital assets over the sum allowed under section 1211 (a corporation excluding its section 1212(a)(1) short-term losses)";
}
@source(IRC_S1222, relation = formalizes, coverage = exact, quote = "The term \"net capital loss\" means the excess of the losses from sales or exchanges of capital assets over the sum allowed under section 1211")
rule NetCapitalLossIndividualRule(p: Person, y: TaxableYear, losses: Money, allowed: Money) defeasible {
    label en official "section 1222(10): losses over the section 1211 allowance";
    when capital_losses_from_sales_or_exchanges_1222_10(p, y, losses);
    when section_1211_allowed_amount_1222_10(p, y, allowed);
    when not_known(corporate_taxpayer_1222_10(p));
    when losses > allowed;
    then net_capital_loss_1222_10(p, y, losses - allowed);
}
rule NetCapitalLossIndividualNoneRule(p: Person, y: TaxableYear, losses: Money, allowed: Money) defeasible {
    label en official "section 1222(10): no net capital loss when the losses do not exceed the allowance";
    when capital_losses_from_sales_or_exchanges_1222_10(p, y, losses);
    when section_1211_allowed_amount_1222_10(p, y, allowed);
    when not_known(corporate_taxpayer_1222_10(p));
    when losses <= allowed;
    then net_capital_loss_1222_10(p, y, 0.00 USD);
}
@source(IRC_S1222, relation = formalizes, coverage = exact, quote = "In the case of a corporation, for the purpose of determining losses under this paragraph, amounts which are short-term capital losses under section 1212(a)(1) shall be excluded")
rule NetCapitalLossCorporationRule(p: Person, y: TaxableYear, losses: Money, allowed: Money, excluded: Money) defeasible {
    label en official "section 1222(10): a corporation excludes its section 1212(a)(1) short-term losses";
    when capital_losses_from_sales_or_exchanges_1222_10(p, y, losses);
    when section_1211_allowed_amount_1222_10(p, y, allowed);
    when corporate_taxpayer_1222_10(p);
    when short_term_losses_under_1212a1_1222_10(p, y, excluded);
    when (losses - excluded) > allowed;
    then net_capital_loss_1222_10(p, y, (losses - excluded) - allowed);
}
rule NetCapitalLossCorporationNoneRule(p: Person, y: TaxableYear, losses: Money, allowed: Money, excluded: Money) defeasible {
    label en official "section 1222(10): a corporation with no excess has no net capital loss";
    when capital_losses_from_sales_or_exchanges_1222_10(p, y, losses);
    when section_1211_allowed_amount_1222_10(p, y, allowed);
    when corporate_taxpayer_1222_10(p);
    when short_term_losses_under_1212a1_1222_10(p, y, excluded);
    when (losses - excluded) <= allowed;
    then net_capital_loss_1222_10(p, y, 0.00 USD);
}

// =============================================================================
// Section 1250(d)(4)(D): ordered application of section 1033(b)(2)
// =============================================================================

pub relation cost_of_purchased_1250_properties_1033a2(t: Transaction, amount: Money) kind empirical {
    label en official "section 1250(d)(4)(D): the cost of the section 1250 properties purchased in a section 1033(a)(2) transaction";
}
pub relation cost_of_all_purchased_properties_1033a2(t: Transaction, amount: Money) kind empirical {
    label en official "section 1250(d)(4)(D)(ii): the cost of all purchased properties to which the sentence applies";
}
pub relation gain_not_taken_into_account_under_1250a_by_reason_of_paragraph(t: Transaction, amount: Money) kind empirical {
    label en official "section 1250(d)(4)(D)(i): the amount of gain not taken into account under subsection (a) by reason of the paragraph";
}
pub relation total_gain_not_recognized_1033a2(t: Transaction, amount: Money) kind empirical {
    label en official "section 1250(d)(4)(D)(ii): the gain not recognized on the transaction";
}
pub relation basis_reduction_stage_one_1250d4Di(t: Transaction, amount: Money) kind institutional {
    label en official "section 1250(d)(4)(D)(i): the reduction applied first solely to the section 1250 properties, up to the gain not taken into account under subsection (a)";
}
@source(IRC_S1250_D, relation = formalizes, coverage = exact, quote = "first solely to section 1250 properties and to the amount of gain not taken into account under subsection (a) by reason of this paragraph")
rule StageOneCostBelowGainRule(t: Transaction, cost: Money, gain: Money) defeasible {
    label en official "section 1250(d)(4)(D)(i): the section 1250 properties absorb the gain up to their cost (cost not larger)";
    when cost_of_purchased_1250_properties_1033a2(t, cost);
    when gain_not_taken_into_account_under_1250a_by_reason_of_paragraph(t, gain);
    when cost <= gain;
    then basis_reduction_stage_one_1250d4Di(t, cost);
}
rule StageOneGainBelowCostRule(t: Transaction, cost: Money, gain: Money) defeasible {
    label en official "section 1250(d)(4)(D)(i): the section 1250 properties absorb the whole gain not taken into account";
    when cost_of_purchased_1250_properties_1033a2(t, cost);
    when gain_not_taken_into_account_under_1250a_by_reason_of_paragraph(t, gain);
    when cost > gain;
    then basis_reduction_stage_one_1250d4Di(t, gain);
}
pub relation basis_reduction_stage_two_1250d4Dii(t: Transaction, amount: Money) kind institutional {
    label en official "section 1250(d)(4)(D)(ii): the reduction then applied to all purchased properties for the remaining gain (JUDGMENT CALL: the remaining gain is the total unrecognized gain less the first-stage amount, capped by the remaining cost)";
}
@source(IRC_S1250_D, relation = formalizes, coverage = partial, quote = "then to all purchased properties to which such sentence applies and to the remaining gain not recognized on the transaction as if the cost of the section 1250 properties were the basis of such properties computed under clause (i)")
rule StageTwoRemainingWithinCostRule(t: Transaction, all_cost: Money, stage1: Money, total_gain: Money) defeasible {
    label en official "section 1250(d)(4)(D)(ii): the remaining gain, when the remaining cost covers it";
    when cost_of_all_purchased_properties_1033a2(t, all_cost);
    when basis_reduction_stage_one_1250d4Di(t, stage1);
    when total_gain_not_recognized_1033a2(t, total_gain);
    when (total_gain - stage1) <= (all_cost - stage1);
    then basis_reduction_stage_two_1250d4Dii(t, total_gain - stage1);
}
rule StageTwoCappedByCostRule(t: Transaction, all_cost: Money, stage1: Money, total_gain: Money) defeasible {
    label en official "section 1250(d)(4)(D)(ii): the remaining gain capped by the remaining cost";
    when cost_of_all_purchased_properties_1033a2(t, all_cost);
    when basis_reduction_stage_one_1250d4Di(t, stage1);
    when total_gain_not_recognized_1033a2(t, total_gain);
    when (total_gain - stage1) > (all_cost - stage1);
    then basis_reduction_stage_two_1250d4Dii(t, all_cost - stage1);
}

// =============================================================================
// Section 1301(a) (last sentence), 1311(b)(2)-(3)
// =============================================================================

pub relation prior_1301_adjustment_for_year(p: Person, prior_y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1301(a): an adjustment under the section for an earlier taxable year";
}
pub relation actual_tax_including_prior_1301_adjustments(p: Person, prior_y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1301(a): the actual tax of a base year, with the earlier adjustments taken into account in a later election year";
}
@source(IRC_S1301_A, relation = formalizes, coverage = partial, quote = "Any adjustment under this section for any taxable year shall be taken into account in applying this section for any subsequent taxable year")
rule PriorAdjustmentsCarriedRule(p: Person, prior_y: TaxableYear, actual: Money, adjustment: Money) defeasible {
    label en official "section 1301(a): earlier adjustments are added to the base year's tax in a later year (the module 15 rule reads the actual tax as supplied: the case supplies it including the adjustments or this relation)";
    when actual_tax_for_prior_year(p, prior_y, actual);
    when prior_1301_adjustment_for_year(p, prior_y, adjustment);
    then actual_tax_including_prior_1301_adjustments(p, prior_y, actual + adjustment);
}
pub relation assessment_or_refund_barred_at_time_of_first_position_1311b2(d: Determination) kind empirical {
    label en official "section 1311(b)(2)(A)-(B): assessment of a deficiency (or credit or refund of the overpayment) was barred at the time the Secretary (or the taxpayer) first maintained the position";
}
pub relation correction_not_barred_at_time_1311b2(d: Determination) kind institutional {
    label en official "section 1311(b)(2): the correction was not barred at the time of the erroneous action";
}
@source(IRC_S1311_B, relation = formalizes, coverage = exact, quote = "adjustment shall be made under this part only if assessment of a deficiency for the taxable year in which the item is includible or against the related taxpayer was not barred")
rule CorrectionNotBarredRule(d: Determination, kind: CircumstanceOfAdjustment) defeasible {
    label en official "section 1311(b)(2)(A)-(B): for a section 1312(3)(B) or (4) determination the correction must not have been barred";
    when circumstance_of_adjustment(d, kind);
    when not_known(assessment_or_refund_barred_at_time_of_first_position_1311b2(d));
    then correction_not_barred_at_time_1311b2(d);
}
pub relation relationship_existed_at_time_of_position_1311b3(d: Determination) kind empirical {
    label en official "section 1311(b)(3): the related taxpayer stands in the relationship at the time the taxpayer first maintains the inconsistent position (or, if not maintained, at the time of the determination)";
}
pub relation deficiency_type_adjustment_for_related_taxpayer(d: Determination) kind empirical {
    label en official "section 1311(b)(3): the adjustment would be assessed and collected as a deficiency against a related taxpayer (other than a section 1312(3)(B) case)";
}
pub relation related_taxpayer_relationship_condition_met_1311b3(d: Determination) kind institutional {
    label en official "section 1311(b)(3): the relationship condition is met (or does not apply)";
}
@source(IRC_S1311_B, relation = formalizes, coverage = exact, quote = "the adjustment shall not be made with respect to a related taxpayer unless he stands in such relationship to the taxpayer at the time the latter first maintains the inconsistent position")
rule RelationshipConditionMetRule(d: Determination) defeasible {
    label en official "section 1311(b)(3): the relationship existed at the time";
    when deficiency_type_adjustment_for_related_taxpayer(d);
    when relationship_existed_at_time_of_position_1311b3(d);
    then related_taxpayer_relationship_condition_met_1311b3(d);
}
rule RelationshipConditionNotApplicableRule(d: Determination, kind: CircumstanceOfAdjustment) defeasible {
    label en official "section 1311(b)(3): the condition applies only to deficiency-type adjustments against a related taxpayer";
    when circumstance_of_adjustment(d, kind);
    when not_known(deficiency_type_adjustment_for_related_taxpayer(d));
    then related_taxpayer_relationship_condition_met_1311b3(d);
}

// =============================================================================
// Pub. L. 119-21, section 1062(b)(3)
// =============================================================================

pub relation deficiency_assessed_on_1062_liability(t: Transaction, p: Person, amount: Money) kind empirical {
    label en official "Pub. L. 119-21 section 70437, section 1062(b)(3): a deficiency has been assessed with respect to the applicable net tax liability";
}
pub relation installments_payable_count_1062(t: Transaction, p: Person, count: Integer) kind empirical {
    label en official "Pub. L. 119-21 section 70437, section 1062(b)(3): the number of installments payable";
}
pub relation deficiency_share_per_installment_1062b3(t: Transaction, p: Person, share: Money) kind institutional {
    label en official "Pub. L. 119-21 section 70437, section 1062(b)(3): the deficiency is prorated to the installments payable (equal shares, cents HALF_UP: JUDGMENT CALL)";
}
@source(us.irc.temporal::PL119_21_S70437, relation = derives_from, coverage = exact, quote = "the deficiency shall be prorated to the installments payable under subsection (a)")
rule DeficiencyProratedRule(t: Transaction, p: Person, deficiency: Money, n: Integer) defeasible {
    label en official "section 1062(b)(3): an equal share of the deficiency per installment payable";
    when deficiency_assessed_on_1062_liability(t, p, deficiency);
    when installments_payable_count_1062(t, p, n);
    when n > 0;
    then deficiency_share_per_installment_1062b3(t, p, div_round(deficiency, n * 1.00, 2, "HALF_UP"));
}
