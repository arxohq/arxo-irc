// Stage 2c (IRC-07, A05). Subpart C of part V of subchapter P and the
// neighbouring debt-instrument sections not reached in stage 2b: §1271
// (retirement of debt instruments; short-term obligations), §§1281-1283
// (current inclusion and deduction limits for short-term obligations), §1286
// (stripped bonds and coupons), §1287 (unregistered obligations), §1288 (OID
// on tax-exempt obligations).
//
// Vocabulary reuses modules 11-12 (`DebtInstrument`, `original_issue_discount`,
// `tax_exempt_obligation`, `purchased_at_premium`, `basis_after_oid_adjustment`).
// Fractions of an amount are written with the exact form
// `div_round(amount * count, days * 1.00, 2, "HALF_UP")` (AGENT-BRIEF money
// forms): cents HALF_UP is a JUDGMENT CALL where the statute names no rounding.
// The election-based yield methods (§1271(a)(3)(E), (a)(4)(D), §1283(b)(2))
// need a daily-compounded yield computation: TECH-GAPS G2338.

// =============================================================================
// §1271: retirement and sale of debt instruments
// =============================================================================

use self::{
    DebtInstrument,
    IRC_S1271_A,
    IRC_S1271_B,
    IRC_S1281_A,
    IRC_S1281_B,
    IRC_S1282_A,
    IRC_S1282_B,
    IRC_S1283_A,
    IRC_S1283_B,
    IRC_S1283_D,
    IRC_S1286_A,
    IRC_S1286_B,
    IRC_S1286_D,
    IRC_S1287_A,
    Person,
    TaxableYear,
    Transaction,
    oid_in_lieu_of_acquisition_discount_1283c1,
    original_issue_discount,
    purchased_at_premium,
    stated_redemption_price_at_maturity,
    tax_exempt_obligation,
    yield_method_election_1271a3E,
    yield_method_election_1271a4D,
    yield_method_election_1283b2,
};

pub relation retirement_receipt_by_holder(holder: Person, instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1271(a)(1): amounts received by the holder on retirement of a debt instrument";
}
pub relation amount_received_in_exchange_on_retirement(holder: Person, instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1271(a)(1): the amounts received on retirement are considered as amounts received in exchange therefor";
}
@source(IRC_S1271_A, relation = formalizes, coverage = exact, quote = "Amounts received by the holder on retirement of any debt instrument shall be considered as amounts received in exchange therefor.")
rule RetirementIsExchangeRule(holder: Person, instr: DebtInstrument, amount: Money) defeasible {
    label en official "section 1271(a)(1)";
    when retirement_receipt_by_holder(holder, instr, amount);
    then amount_received_in_exchange_on_retirement(holder, instr, amount);
}
pub relation intention_to_call_before_maturity_at_original_issue(instr: DebtInstrument) kind empirical {
    label en official "section 1271(a)(2)(A): at the time of original issue there was an intention to call the debt instrument before maturity (an evaluative element, DECISION-0194: adjudicated fact)";
}
pub relation gain_on_sale_or_exchange_of_instrument(t: Transaction, holder: Person, instr: DebtInstrument, amount: Money) kind empirical {
    label en official "sections 1271(a)(2)-(4): the gain realized on the sale or exchange of the instrument";
}
pub relation oid_previously_includible_by_holders(instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1271(a)(2)(A)(ii): the portion of the original issue discount previously includible in the gross income of any holder (without regard to section 1272(a)(7))";
}
pub relation section_1271a2_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1271(a)(2): gain up to the unincluded original issue discount is ordinary income";
}
@source(IRC_S1271_A, relation = formalizes, coverage = partial, quote = "If at the time of original issue there was an intention to call a debt instrument before maturity, any gain realized on the sale or exchange thereof which does not exceed an amount equal to—")
rule Section1271a2OrdinaryIncomeRule(t: Transaction, holder: Person, instr: DebtInstrument, gain: Money, oid: Money, previous: Money) defeasible {
    label en official "section 1271(a)(2)(A): min(gain, original issue discount - previously includible OID), when positive; not for tax-exempt obligations or premium purchasers (B)";
    when intention_to_call_before_maturity_at_original_issue(instr);
    when gain_on_sale_or_exchange_of_instrument(t, holder, instr, gain);
    when original_issue_discount(instr, oid);
    when oid_previously_includible_by_holders(instr, previous);
    when not_known(tax_exempt_obligation(instr));
    when not_known(purchased_at_premium(instr, holder));
    when oid > previous;
    then section_1271a2_ordinary_income(t, min(gain, oid - previous));
}
rule Section1271a2NoUnincludedOidRule(t: Transaction, holder: Person, instr: DebtInstrument, gain: Money, oid: Money, previous: Money) defeasible {
    label en official "section 1271(a)(2)(A): nothing when all the original issue discount was included";
    when intention_to_call_before_maturity_at_original_issue(instr);
    when gain_on_sale_or_exchange_of_instrument(t, holder, instr, gain);
    when original_issue_discount(instr, oid);
    when oid_previously_includible_by_holders(instr, previous);
    when not_known(tax_exempt_obligation(instr));
    when not_known(purchased_at_premium(instr, holder));
    when oid <= previous;
    then section_1271a2_ordinary_income(t, 0.00 USD);
}

// (a)(3): short-term Government obligations
pub relation obligation_of_us_possession_state_or_dc(instr: DebtInstrument) kind empirical {
    label en official "section 1271(a)(3)(B): an obligation of the United States or its possessions, of a State or political subdivision, or of the District of Columbia";
}
pub relation instrument_fixed_maturity_within_one_year_of_issue(instr: DebtInstrument) kind empirical {
    label en official "sections 1271(a)(3)(B), (a)(4)(B)(i), 1283(a)(1): a fixed maturity date not more than 1 year from the date of issue";
}
pub relation short_term_government_obligation(instr: DebtInstrument) kind institutional {
    label en official "section 1271(a)(3)(B): a short-term Government obligation";
}
@source(IRC_S1271_A, relation = formalizes, coverage = partial, quote = "For purposes of this paragraph, the term \"short-term Government obligation\" means any obligation of the United States")
rule ShortTermGovernmentObligationRule(instr: DebtInstrument) defeasible {
    label en official "section 1271(a)(3)(B)";
    when obligation_of_us_possession_state_or_dc(instr);
    when instrument_fixed_maturity_within_one_year_of_issue(instr);
    when not_known(tax_exempt_obligation(instr));
    then short_term_government_obligation(instr);
}
pub relation basis_of_holder_in_obligation(holder: Person, instr: DebtInstrument, amount: Money) kind empirical {
    label en official "the holder's basis in the obligation";
}
pub relation acquisition_discount(holder: Person, instr: DebtInstrument, amount: Money) kind institutional {
    label en official "sections 1271(a)(3)(C), 1283(a)(2): the excess of the stated redemption price at maturity over the taxpayer's basis for the obligation";
}
@source(IRC_S1271_A, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"acquisition discount\" means the excess of the stated redemption price at maturity over the taxpayer's basis for the obligation.")
rule AcquisitionDiscountRule(holder: Person, instr: DebtInstrument, srp: Money, basis: Money) defeasible {
    label en official "sections 1271(a)(3)(C), 1283(a)(2)";
    when stated_redemption_price_at_maturity(instr, srp);
    when basis_of_holder_in_obligation(holder, instr, basis);
    when srp > basis;
    then acquisition_discount(holder, instr, srp - basis);
}
pub relation days_held_short_term(holder: Person, instr: DebtInstrument, days: Integer) kind empirical {
    label en official "sections 1271(a)(3)(D)(i), (a)(4)(C)(i): the number of days the taxpayer held the obligation";
}
pub relation days_from_acquisition_to_maturity_short_term(holder: Person, instr: DebtInstrument, days: Integer) kind empirical {
    label en official "section 1271(a)(3)(D)(ii): the number of days after the date the taxpayer acquired the obligation up to and including its maturity date";
}
pub relation days_from_issue_to_maturity_short_term(instr: DebtInstrument, days: Integer) kind empirical {
    label en official "section 1271(a)(4)(C)(ii): the number of days after the date of original issue up to and including the date of maturity";
}
pub relation ratable_share_of_acquisition_discount(holder: Person, instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1271(a)(3)(D): the acquisition discount times days held over days from acquisition to maturity";
}
@source(IRC_S1271_A, relation = formalizes, coverage = partial, quote = "the ratable share of the acquisition discount is an amount which bears the same ratio to such discount as—")
rule RatableShareAcquisitionDiscountRule(holder: Person, instr: DebtInstrument, discount: Money, held: Integer, total: Integer) defeasible {
    label en official "section 1271(a)(3)(D) (cents HALF_UP: JUDGMENT CALL); the (E) yield-based election is G2338";
    when acquisition_discount(holder, instr, discount);
    when days_held_short_term(holder, instr, held);
    when days_from_acquisition_to_maturity_short_term(holder, instr, total);
    when total > 0;
    when not_known(yield_method_election_1271a3E(holder, instr));
    then ratable_share_of_acquisition_discount(holder, instr, div_round(discount * held, total * 1.00, 2, "HALF_UP"));
}
pub relation section_1271a3_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1271(a)(3)(A): gain up to the ratable share of the acquisition discount on a short-term Government obligation is ordinary income";
}
@source(IRC_S1271_A, relation = formalizes, coverage = partial, quote = "any gain realized which does not exceed an amount equal to the ratable share of the acquisition discount shall be treated as ordinary income.")
rule Section1271a3OrdinaryIncomeRule(t: Transaction, holder: Person, instr: DebtInstrument, gain: Money, share: Money) defeasible {
    label en official "section 1271(a)(3)(A): min(gain, ratable share)";
    when short_term_government_obligation(instr);
    when gain_on_sale_or_exchange_of_instrument(t, holder, instr, gain);
    when ratable_share_of_acquisition_discount(holder, instr, share);
    then section_1271a3_ordinary_income(t, min(gain, share));
}

// (a)(4): short-term nongovernment obligations
pub relation short_term_nongovernment_obligation(instr: DebtInstrument) kind institutional {
    label en official "section 1271(a)(4)(B): an obligation with a fixed maturity not more than 1 year from issue which is not a short-term Government obligation";
}
@source(IRC_S1271_A, relation = formalizes, coverage = partial, quote = "For purposes of this paragraph, the term \"short-term nongovernment obligation\" means any obligation which—")
rule ShortTermNongovernmentObligationRule(instr: DebtInstrument) defeasible {
    label en official "section 1271(a)(4)(B)";
    when instrument_fixed_maturity_within_one_year_of_issue(instr);
    when not_known(obligation_of_us_possession_state_or_dc(instr));
    then short_term_nongovernment_obligation(instr);
}
pub relation ratable_share_of_original_issue_discount(holder: Person, instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1271(a)(4)(C): the original issue discount times days held over days from original issue to maturity";
}
@source(IRC_S1271_A, relation = formalizes, coverage = partial, quote = "the ratable share of the original issue discount is an amount which bears the same ratio to such discount as—")
rule RatableShareOriginalIssueDiscountRule(holder: Person, instr: DebtInstrument, oid: Money, held: Integer, total: Integer) defeasible {
    label en official "section 1271(a)(4)(C) (cents HALF_UP: JUDGMENT CALL); the (D) yield-based election is G2338";
    when original_issue_discount(instr, oid);
    when days_held_short_term(holder, instr, held);
    when days_from_issue_to_maturity_short_term(instr, total);
    when total > 0;
    when not_known(yield_method_election_1271a4D(holder, instr));
    then ratable_share_of_original_issue_discount(holder, instr, div_round(oid * held, total * 1.00, 2, "HALF_UP"));
}
pub relation section_1271a4_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1271(a)(4)(A): gain up to the ratable share of the original issue discount on a short-term nongovernment obligation is ordinary income";
}
@source(IRC_S1271_A, relation = formalizes, coverage = partial, quote = "any gain realized which does not exceed an amount equal to the ratable share of the original issue discount shall be treated as ordinary income.")
rule Section1271a4OrdinaryIncomeRule(t: Transaction, holder: Person, instr: DebtInstrument, gain: Money, share: Money) defeasible {
    label en official "section 1271(a)(4)(A): min(gain, ratable share)";
    when short_term_nongovernment_obligation(instr);
    when gain_on_sale_or_exchange_of_instrument(t, holder, instr, gain);
    when ratable_share_of_original_issue_discount(holder, instr, share);
    then section_1271a4_ordinary_income(t, min(gain, share));
}

// (b): obligations of natural persons
pub relation instrument_issued_by_natural_person_on(instr: DebtInstrument, on: Date) kind empirical {
    label en official "section 1271(b)(1): the obligation is issued by a natural person, on the date";
}
pub relation instrument_purchased_on(instr: DebtInstrument, holder: Person, on: Date) kind empirical {
    label en official "section 1271(b)(2): the date the obligation was purchased (section 1272(d)(1))";
}
pub relation section_1271_applies_to_natural_person_obligation(instr: DebtInstrument, holder: Person) kind institutional {
    label en official "section 1271(b): the section applies to an obligation issued by a natural person, except one issued before June 9, 1997 (and not purchased after June 8, 1997)";
}
@source(IRC_S1271_B, relation = formalizes, coverage = partial, quote = "This section shall not apply to any obligation issued by a natural person before June 9, 1997.")
rule NaturalPersonObligationAfterCutoffRule(instr: DebtInstrument, holder: Person, issued: Date) defeasible {
    label en official "section 1271(b)(1): issued on or after June 9, 1997";
    when instrument_issued_by_natural_person_on(instr, issued);
    when instrument_purchased_on(instr, holder, issued);
    when issued >= @1997-06-09;
    then section_1271_applies_to_natural_person_obligation(instr, holder);
}
@source(IRC_S1271_B, relation = formalizes, coverage = partial, quote = "Paragraph (1) shall not apply to any obligation purchased")
rule NaturalPersonObligationPurchasedAfterCutoffRule(instr: DebtInstrument, holder: Person, issued: Date, purchased: Date) defeasible {
    label en official "section 1271(b)(1)-(2): issued before June 9, 1997 but purchased after June 8, 1997, so paragraph (1) does not shelter it";
    when instrument_issued_by_natural_person_on(instr, issued);
    when instrument_purchased_on(instr, holder, purchased);
    when issued < @1997-06-09;
    when purchased > @1997-06-08;
    then section_1271_applies_to_natural_person_obligation(instr, holder);
}

// =============================================================================
// §1281-§1283: short-term obligations
// =============================================================================

pub relation short_term_obligation_1283(instr: DebtInstrument) kind institutional {
    label en official "section 1283(a)(1): a bond, debenture, note, certificate or other evidence of indebtedness with a fixed maturity not more than 1 year from issue, other than a tax-exempt obligation";
}
@source(IRC_S1283_A, relation = formalizes, coverage = exact, quote = "the term \"short-term obligation\" means any bond, debenture, note, certificate, or other evidence of indebtedness which has a fixed maturity date not more than 1 year from the date of issue.")
rule ShortTermObligation1283Rule(instr: DebtInstrument) defeasible {
    label en official "section 1283(a)(1)(A)-(B)";
    when instrument_fixed_maturity_within_one_year_of_issue(instr);
    when not_known(tax_exempt_obligation(instr));
    then short_term_obligation_1283(instr);
}
pub relation holder_uses_accrual_method(holder: Person) kind empirical {
    label en official "section 1281(b)(1)(A): the holder uses an accrual method of accounting";
}
pub relation held_primarily_for_sale_to_customers(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "section 1281(b)(1)(B): held primarily for sale to customers in the ordinary course";
}
pub relation holder_is_bank_ric_or_common_trust_fund(holder: Person) kind empirical {
    label en official "section 1281(b)(1)(C)-(D): held by a bank (section 581), a regulated investment company or a common trust fund";
}
pub relation identified_as_hedging_transaction_1256e2(instr: DebtInstrument) kind empirical {
    label en official "section 1281(b)(1)(E): identified under section 1256(e)(2) as part of a hedging transaction";
}
pub relation stripped_bond_held_by_stripper(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "section 1281(b)(1)(F): a stripped bond or coupon held by the person who stripped it (or a person with a basis determined by reference to that person's basis)";
}
pub relation section_1281_applies(holder: Person, instr: DebtInstrument) kind institutional {
    label en official "section 1281(b): section 1281 applies to the short-term obligation";
}
@source(IRC_S1281_B, relation = formalizes, coverage = partial, quote = "(A) is held by a taxpayer using an accrual method of accounting,")
rule Section1281AccrualHolderRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1281(b)(1)(A)";
    when short_term_obligation_1283(instr);
    when holder_uses_accrual_method(holder);
    then section_1281_applies(holder, instr);
}
@source(IRC_S1281_B, relation = formalizes, coverage = partial, quote = "(B) is held primarily for sale to customers in the ordinary course of the taxpayer's trade or business,")
rule Section1281DealerRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1281(b)(1)(B)";
    when short_term_obligation_1283(instr);
    when held_primarily_for_sale_to_customers(holder, instr);
    then section_1281_applies(holder, instr);
}
@source(IRC_S1281_B, relation = formalizes, coverage = partial, quote = "(C) is held by a bank (as defined in section 581),")
rule Section1281BankRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1281(b)(1)(C)-(D)";
    when short_term_obligation_1283(instr);
    when holder_is_bank_ric_or_common_trust_fund(holder);
    then section_1281_applies(holder, instr);
}
@source(IRC_S1281_B, relation = formalizes, coverage = partial, quote = "(E) is identified by the taxpayer under section 1256(e)(2) as being part of a hedging transaction, or")
rule Section1281HedgeRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1281(b)(1)(E)";
    when short_term_obligation_1283(instr);
    when identified_as_hedging_transaction_1256e2(instr);
    when instrument_held_by_1281(holder, instr);
    then section_1281_applies(holder, instr);
}
pub relation instrument_held_by_1281(holder: Person, instr: DebtInstrument) kind empirical {
    label en unofficial "the person holds the obligation";
}
@source(IRC_S1281_B, relation = formalizes, coverage = partial, quote = "(F) is a stripped bond or stripped coupon held by the person who stripped the bond or coupon (or by any other person whose basis is determined by reference to the basis in the hands of such person).")
rule Section1281StrippedRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1281(b)(1)(F)";
    when short_term_obligation_1283(instr);
    when stripped_bond_held_by_stripper(holder, instr);
    then section_1281_applies(holder, instr);
}
pub relation pass_thru_formed_to_avoid_1281(holder: Person) kind empirical {
    label en official "section 1281(b)(2)(A)(i): a pass-thru entity formed or availed of for purposes of avoiding the section (an evaluative element, DECISION-0194: adjudicated fact)";
}
pub relation pass_thru_days_with_20_percent_ownership_by_covered_holders(holder: Person, days: Integer) kind empirical {
    label en official "section 1281(b)(2)(C): the number of days in the taxable year on which 20 percent or more of the value of the interests are held by persons described in paragraph (1) or by other pass-thru entities to which (A) applies";
}
pub relation obligation_acquired_by_pass_thru_during_required_accrual_period(holder: Person, instr: DebtInstrument) kind empirical {
    label en official "section 1281(b)(2)(A)(ii): the obligation is acquired by a pass-thru entity during the required accrual period";
}
@source(IRC_S1281_B, relation = formalizes, coverage = partial, quote = "(i) any short-term obligation which is held by a pass-thru entity which is formed or availed of for purposes of avoiding the provisions of this section, and")
rule Section1281PassThruAvoidanceRule(holder: Person, instr: DebtInstrument) defeasible {
    label en official "section 1281(b)(2)(A)(i)";
    when short_term_obligation_1283(instr);
    when instrument_held_by_1281(holder, instr);
    when pass_thru_formed_to_avoid_1281(holder);
    then section_1281_applies(holder, instr);
}
@source(IRC_S1281_B, relation = formalizes, coverage = partial, quote = "(ii) any short-term obligation which is acquired by a pass-thru entity (not described in clause (i)) during the required accrual period.")
rule Section1281PassThruAccrualPeriodRule(holder: Person, instr: DebtInstrument, days: Integer) defeasible {
    label en official "section 1281(b)(2)(A)(ii), (C): acquired during the required accrual period, whose ownership test needs at least 90 days of at least 20 percent ownership";
    when short_term_obligation_1283(instr);
    when obligation_acquired_by_pass_thru_during_required_accrual_period(holder, instr);
    when pass_thru_days_with_20_percent_ownership_by_covered_holders(holder, days);
    when days >= 90;
    then section_1281_applies(holder, instr);
}
pub relation daily_portion_of_acquisition_discount(holder: Person, instr: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1283(b)(1): the acquisition discount divided by the number of days after the acquisition up to and including maturity";
}
@source(IRC_S1283_B, relation = formalizes, coverage = partial, quote = "Except as otherwise provided in this subsection, the daily portion of the acquisition discount is an amount equal to—")
rule DailyPortionRule(holder: Person, instr: DebtInstrument, discount: Money, total: Integer) defeasible {
    label en official "section 1283(b)(1) (cents HALF_UP: JUDGMENT CALL)";
    when acquisition_discount(holder, instr, discount);
    when days_from_acquisition_to_maturity_short_term(holder, instr, total);
    when total > 0;
    then daily_portion_of_acquisition_discount(holder, instr, div_round(discount, total * 1.00, 2, "HALF_UP"));
}
pub relation days_held_in_taxable_year_short_term(holder: Person, instr: DebtInstrument, y: TaxableYear, days: Integer) kind empirical {
    label en official "section 1281(a)(1): the number of days during the taxable year on which the holder held the obligation";
}
pub relation section_1281_accrued_discount_inclusion(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1281(a)(1): the sum of the daily portions of the acquisition discount for each day of the year the holder held the obligation";
}
@source(IRC_S1281_A, relation = formalizes, coverage = partial, quote = "(1) there shall be included in the gross income of the holder an amount equal to the sum of the daily portions of the acquisition discount for each day during the taxable year on which such holder held such obligation, and")
rule Section1281InclusionRule(holder: Person, instr: DebtInstrument, y: TaxableYear, daily: Money, days: Integer, discount: Money, total: Integer) defeasible {
    label en official "section 1281(a)(1): the sum over held days, computed exactly as discount x days / total days (avoids the rounded daily portion; cents HALF_UP: JUDGMENT CALL)";
    when section_1281_applies(holder, instr);
    when acquisition_discount(holder, instr, discount);
    when days_from_acquisition_to_maturity_short_term(holder, instr, total);
    when days_held_in_taxable_year_short_term(holder, instr, y, days);
    when total > 0;
    when not_known(yield_method_election_1283b2(holder, instr));
    when not_known(oid_in_lieu_of_acquisition_discount_1283c1(holder, instr));
    then section_1281_accrued_discount_inclusion(holder, instr, y, div_round(discount * days, total * 1.00, 2, "HALF_UP"));
}
pub relation interest_payable_not_in_acquisition_discount(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1281(a)(2): interest payable on the obligation, other than interest taken into account in determining the acquisition discount, accruing in the year";
}
pub relation section_1281_interest_included_as_accrued(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1281(a)(2): that interest is included in gross income as it accrues";
}
@source(IRC_S1281_A, relation = formalizes, coverage = exact, quote = "(2) any interest payable on the obligation (other than interest taken into account in determining the amount of the acquisition discount) shall be included in gross income as it accrues.")
rule Section1281InterestRule(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1281(a)(2)";
    when section_1281_applies(holder, instr);
    when interest_payable_not_in_acquisition_discount(holder, instr, y, amount);
    then section_1281_interest_included_as_accrued(holder, instr, y, amount);
}
pub relation basis_increase_from_1281_inclusion(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1283(d)(1): the holder's basis in the short-term obligation is increased by the amount included in gross income under section 1281";
}
@source(IRC_S1283_D, relation = formalizes, coverage = exact, quote = "The basis of any short-term obligation in the hands of the holder thereof shall be increased by the amount included in his gross income pursuant to section 1281.")
rule BasisIncreaseFrom1281Rule(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1283(d)(1)";
    when section_1281_accrued_discount_inclusion(holder, instr, y, amount);
    then basis_increase_from_1281_inclusion(holder, instr, y, amount);
}
// §1282: deferral of interest deductions
pub relation net_direct_interest_expense_short_term(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1282(a): the net direct interest expense with respect to the short-term obligation";
}
pub relation accrued_discount_and_interest_for_1282(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1282(a)(1)-(2): the sum of the daily portions of the acquisition discount for the days held and the interest accruing while held that is not included in gross income for the year";
}
pub relation elects_section_1281_for_all_short_term_obligations(holder: Person, y: TaxableYear) kind empirical {
    label en official "section 1282(b)(2)(A): the taxpayer elects to have section 1281 apply to all short-term obligations acquired on or after the first day of the first taxable year to which the election applies";
}
pub relation section_1281_election_in_effect_1282b2(holder: Person, y: TaxableYear) kind institutional {
    label en official "section 1282(b)(2): the election is in effect for the year and all subsequent years unless the Secretary consents to its revocation";
}
@source(IRC_S1282_B, relation = formalizes, coverage = exact, quote = "A taxpayer may make an election under this paragraph to have section 1281 apply to all short-term obligations acquired by the taxpayer on or after the 1st day of the 1st taxable year to which such election applies.")
rule Section1282b2ElectionPower(holder: Person, y: TaxableYear) strict {
    label en official "section 1282(b)(2): the election changes the regime for all later-acquired short-term obligations";
    when elects_section_1281_for_all_short_term_obligations(holder, y);
    then power Section1281AllObligationsElection {
        holder holder;
        over y;
        exercise elects_section_1281_for_all_short_term_obligations(holder, y);
        valid_when holder_uses_accrual_method_or_eligible_for_1282b2(holder);
        effect create(section_1281_election_in_effect_1282b2(holder, y));
        window [@1984-07-18, infinity);
    };
}
relation holder_uses_accrual_method_or_eligible_for_1282b2(holder: Person) kind institutional {
    label en unofficial "single-atom helper for valid_when (§130.3): the section places no condition on the electing taxpayer, so any taxpayer is eligible";
}
rule Section1282b2EligibleRule(holder: Person, y: TaxableYear) defeasible {
    label en official "section 1282(b)(2)(A): no condition on the taxpayer";
    when elects_section_1281_for_all_short_term_obligations(holder, y);
    then holder_uses_accrual_method_or_eligible_for_1282b2(holder);
}
pub relation section_1282_allowed_interest_deduction(holder: Person, instr: DebtInstrument, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1282(a): the net direct interest expense is deductible only to the extent it exceeds the accrued discount and interest";
}
@source(IRC_S1282_A, relation = formalizes, coverage = partial, quote = "Except as otherwise provided in this section, the net direct interest expense with respect to any short-term obligation shall be allowed as a deduction for the taxable year only to the extent such expense exceeds the sum of—")
rule Section1282DeductionLimitRule(holder: Person, instr: DebtInstrument, y: TaxableYear, expense: Money, accrued: Money) defeasible {
    label en official "section 1282(a): allowed = expense - accrued amounts when positive; not for obligations to which section 1281 applies (b)(1)";
    when net_direct_interest_expense_short_term(holder, instr, y, expense);
    when accrued_discount_and_interest_for_1282(holder, instr, y, accrued);
    when not_known(section_1281_applies(holder, instr));
    when not_known(section_1281_election_in_effect_1282b2(holder, y));
    when expense > accrued;
    then section_1282_allowed_interest_deduction(holder, instr, y, expense - accrued);
}
rule Section1282DeductionNoExcessRule(holder: Person, instr: DebtInstrument, y: TaxableYear, expense: Money, accrued: Money) defeasible {
    label en official "section 1282(a): nothing is allowed when the expense does not exceed the accrued amounts";
    when net_direct_interest_expense_short_term(holder, instr, y, expense);
    when accrued_discount_and_interest_for_1282(holder, instr, y, accrued);
    when not_known(section_1281_applies(holder, instr));
    when not_known(section_1281_election_in_effect_1282b2(holder, y));
    when expense <= accrued;
    then section_1282_allowed_interest_deduction(holder, instr, y, 0.00 USD);
}

// =============================================================================
// §1286: stripped bonds and coupons
// =============================================================================

pub entity StrippedItem : Asset {
    label en official "a stripped bond or a stripped coupon (section 1286(d))";
}
pub relation strip_purchase(holder: Person, item: StrippedItem, bought_on: Date) kind empirical {
    label en official "section 1286(a): a person purchases a stripped bond or stripped coupon on the date (section 1272(d)(1) purchase)";
}
pub relation item_stated_redemption_price_or_coupon_amount(item: StrippedItem, amount: Money) kind empirical {
    label en official "section 1286(a)(1): the stated redemption price at maturity (or, for a coupon, the amount payable on its due date)";
}
pub relation item_fair_market_value_on_purchase(item: StrippedItem, amount: Money) kind empirical {
    label en official "section 1286(a), last sentence: the fair market value of the item on the date of purchase";
}
pub relation total_fair_market_value_of_purchased_items(holder: Person, bought_on: Date, amount: Money) kind empirical {
    label en official "section 1286(a): the sum of the fair market values of all items purchased in the transaction";
}
pub relation total_purchase_price_of_items(holder: Person, bought_on: Date, amount: Money) kind empirical {
    label en official "section 1286(a)(2): the purchase price to be shared among the items";
}
pub relation ratable_share_of_purchase_price(item: StrippedItem, amount: Money) kind institutional {
    label en official "section 1286(a)(2): the item's ratable share of the purchase price, by respective fair market values";
}
@source(IRC_S1286_A, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (2), ratable shares shall be determined on the basis of their respective fair market values on the date of purchase.")
rule RatableShareOfPurchasePriceRule(holder: Person, item: StrippedItem, bought_on: Date, fmv: Money, total_fmv: Money, price: Money) defeasible {
    label en official "section 1286(a): price x item value / total value (cents HALF_UP: JUDGMENT CALL)";
    when strip_purchase(holder, item, bought_on);
    when item_fair_market_value_on_purchase(item, fmv);
    when total_fair_market_value_of_purchased_items(holder, bought_on, total_fmv);
    when total_purchase_price_of_items(holder, bought_on, price);
    when total_fmv > 0.00 USD;
    then ratable_share_of_purchase_price(item, div_round(price * (fmv / 1.00 USD), total_fmv / 1.00 USD, 2, "HALF_UP"));
}
pub relation stripped_item_original_issue_discount(item: StrippedItem, amount: Money) kind institutional {
    label en official "section 1286(a): the item is treated as a bond originally issued on the purchase date with an original issue discount equal to the excess of the stated redemption price (or coupon amount) over its ratable share of the purchase price";
}
@source(IRC_S1286_A, relation = formalizes, coverage = partial, quote = "shall be treated for purposes of this part as a bond originally issued on the purchase date and having an original issue discount equal to the excess (if any) of—")
rule StrippedItemOidRule(item: StrippedItem, srp: Money, share: Money) defeasible {
    label en official "section 1286(a)(1)-(2): excess when positive";
    when item_stated_redemption_price_or_coupon_amount(item, srp);
    when ratable_share_of_purchase_price(item, share);
    when srp > share;
    then stripped_item_original_issue_discount(item, srp - share);
}
pub relation stripper_disposes_of_bond_or_coupon(t: Transaction, stripper: Person) kind empirical {
    label en official "section 1286(b): a person strips one or more coupons from a bond and disposes of the bond or such coupon";
}
pub relation interest_accrued_not_previously_included(t: Transaction, amount: Money) kind empirical {
    label en official "section 1286(b)(1)(A): the interest accrued on the bond while held by the person and before the disposition, to the extent not previously included";
}
pub relation accrued_market_discount_not_previously_included(t: Transaction, amount: Money) kind empirical {
    label en official "section 1286(b)(1)(B): the accrued market discount on the bond at the time of disposition, to the extent not previously included";
}
pub relation section_1286b_income_inclusion(t: Transaction, amount: Money) kind institutional {
    label en official "section 1286(b)(1): the amount included in the stripper's gross income";
}
@source(IRC_S1286_B, relation = formalizes, coverage = exact, quote = "(1) such person shall include in gross income an amount equal to the sum of—")
rule StripperInclusionRule(t: Transaction, stripper: Person, interest: Money, discount: Money) defeasible {
    label en official "section 1286(b)(1)(A)+(B)";
    when stripper_disposes_of_bond_or_coupon(t, stripper);
    when interest_accrued_not_previously_included(t, interest);
    when accrued_market_discount_not_previously_included(t, discount);
    then section_1286b_income_inclusion(t, interest + discount);
}
pub relation adjusted_basis_of_bond_and_coupons_before_disposition(t: Transaction, amount: Money) kind empirical {
    label en official "section 1286(b)(2): the basis of the bond and coupons immediately before the disposition, before the increase";
}
pub relation basis_after_1286b2_increase(t: Transaction, amount: Money) kind institutional {
    label en official "section 1286(b)(2): the basis of the bond and coupons increased by the amount included under (b)(1)";
}
@source(IRC_S1286_B, relation = formalizes, coverage = exact, quote = "(2) the basis of the bond and coupons shall be increased by the amount included in gross income under paragraph (1),")
rule StripperBasisIncreaseRule(t: Transaction, basis: Money, inclusion: Money) defeasible {
    label en official "section 1286(b)(2)";
    when adjusted_basis_of_bond_and_coupons_before_disposition(t, basis);
    when section_1286b_income_inclusion(t, inclusion);
    then basis_after_1286b2_increase(t, basis + inclusion);
}
pub relation item_fair_market_value_at_disposition(t: Transaction, item: StrippedItem, amount: Money) kind empirical {
    label en official "section 1286(b)(3): the fair market value of an item retained or disposed of at the disposition";
}
pub relation total_fair_market_value_at_disposition(t: Transaction, amount: Money) kind empirical {
    label en official "section 1286(b)(3): the sum of the fair market values of all the items";
}
pub relation basis_allocated_to_item_1286b3(t: Transaction, item: StrippedItem, amount: Money) kind institutional {
    label en official "section 1286(b)(3): the basis allocated to an item on the basis of respective fair market values";
}
@source(IRC_S1286_B, relation = formalizes, coverage = exact, quote = "(3) the basis of the bond and coupons immediately before the disposition (as adjusted pursuant to paragraph (2)) shall be allocated among the items retained by such person and the items disposed of by such person on the basis of their respective fair market values, and")
rule BasisAllocationRule(t: Transaction, item: StrippedItem, basis: Money, fmv: Money, total: Money) defeasible {
    label en official "section 1286(b)(3) (cents HALF_UP: JUDGMENT CALL)";
    when basis_after_1286b2_increase(t, basis);
    when item_fair_market_value_at_disposition(t, item, fmv);
    when total_fair_market_value_at_disposition(t, total);
    when total > 0.00 USD;
    then basis_allocated_to_item_1286b3(t, item, div_round(basis * (fmv / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation item_retained_by_stripper(t: Transaction, item: StrippedItem) kind empirical {
    label en official "section 1286(b)(4): the item is retained by the person";
}
pub relation retained_item_treated_as_purchased_for_allocated_basis(t: Transaction, item: StrippedItem, amount: Money) kind institutional {
    label en official "section 1286(b)(4): for subsection (a) the person is treated as having purchased each retained item on the date of disposition for the basis allocated to it";
}
@source(IRC_S1286_B, relation = formalizes, coverage = exact, quote = "(4) for purposes of subsection (a), such person shall be treated as having purchased on the date of such disposition each such item which he retains for an amount equal to the basis allocated to such item under paragraph (3).")
rule RetainedItemTreatedAsPurchasedRule(t: Transaction, item: StrippedItem, amount: Money) defeasible {
    label en official "section 1286(b)(4)";
    when item_retained_by_stripper(t, item);
    when basis_allocated_to_item_1286b3(t, item, amount);
    then retained_item_treated_as_purchased_for_allocated_basis(t, item, amount);
}
pub relation coupon_stripped_from_bond_with_ownership_separated(instr: DebtInstrument) kind empirical {
    label en official "section 1286(d)(2): a bond issued with interest coupons where there is a separation in ownership between the bond and a coupon not yet payable";
}
pub relation stripped_bond_1286(instr: DebtInstrument) kind institutional {
    label en official "section 1286(d)(2): a stripped bond";
}
@source(IRC_S1286_D, relation = formalizes, coverage = exact, quote = "The term \"stripped bond\" means a bond issued at any time with interest coupons where there is a separation in ownership between the bond and any coupon which has not yet become payable.")
rule StrippedBondRule(instr: DebtInstrument) defeasible {
    label en official "section 1286(d)(2)";
    when coupon_stripped_from_bond_with_ownership_separated(instr);
    then stripped_bond_1286(instr);
}

// =============================================================================
// §1287: registration-required obligations not in registered form
// =============================================================================

pub relation registration_required_obligation_163f2(instr: DebtInstrument) kind empirical {
    label en official "section 1287(b)(1): a registration-required obligation within the meaning of section 163(f)(2) (owner: deductions; asserted)";
}
pub relation obligation_in_registered_form_163f(instr: DebtInstrument) kind empirical {
    label en official "section 1287(b)(2): in registered form within the meaning of section 163(f)";
}
pub relation issuance_subject_to_tax_under_4701(instr: DebtInstrument) kind empirical {
    label en official "section 1287(a): the issuance of the obligation was subject to the tax under section 4701";
}
pub relation gain_on_disposition_of_unregistered_obligation(t: Transaction, instr: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1287(a): the gain on the sale or other disposition of the obligation";
}
pub relation section_1287_ordinary_income(t: Transaction, amount: Money) kind institutional {
    label en official "section 1287(a): the gain is ordinary income";
}
@source(IRC_S1287_A, relation = formalizes, coverage = exact, quote = "any gain on the sale or other disposition of such obligation shall be treated as ordinary income (unless the issuance of such obligation was subject to tax under section 4701).")
rule Section1287OrdinaryIncomeRule(t: Transaction, instr: DebtInstrument, gain: Money) defeasible {
    label en official "section 1287(a)";
    when registration_required_obligation_163f2(instr);
    when not_known(obligation_in_registered_form_163f(instr));
    when not_known(issuance_subject_to_tax_under_4701(instr));
    when gain_on_disposition_of_unregistered_obligation(t, instr, gain);
    then section_1287_ordinary_income(t, gain);
}
