// Stage 3b (IRC-07, A05). Section 1276 remainder ((a)(2)-(4), (b)(2)(B), (b)(3), (c), (d)) and
// section 1278 remainder ((a)(1)(B)(iii), (a)(1)(C), (a)(2)(B), (a)(4), (b)(2)).
//
// Method. Module 12 carries the accrued market discount and the ordinary-income cap. The
// revised issue price (1278(a)(4)) is issue price plus the OID includible by prior holders (or the
// accrued tax-exempt OID); the market discount of an OID bond reads it in place of the stated
// redemption price (1278(a)(2)(B)); module 12 guards its general rule against OID bonds. Transferee
// and exchanged-basis rules of 1276(c) are carry relations over case-supplied dates and amounts.

// =============================================================================
// Section 1278(a)(4), (a)(2)(B): revised issue price
// =============================================================================

use self::{
    Asset,
    DebtInstrument,
    IRC_S1276_A,
    IRC_S1276_B,
    IRC_S1276_C,
    IRC_S1276_D,
    IRC_S1278_A,
    IRC_S1278_B,
    Person,
    Transaction,
    accrued_market_discount,
    disposes_of_market_discount_bond,
    exchanged_basis_property_1276c2,
    issue_price,
    market_discount,
    market_discount_basis_after_acquisition,
    market_discount_bond,
    partial_principal_payment_ordinary_income,
    section_1276_ordinary_income,
    tax_exempt_obligation,
};

pub relation bond_has_original_issue_discount_1278a2B(bond: DebtInstrument) kind empirical {
    label en official "section 1278(a)(2)(B): the bond has original issue discount";
}
pub relation oid_includible_by_prior_holders(bond: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1278(a)(4)(B): the aggregate original issue discount includible in the gross income of all holders for periods before the taxpayer's acquisition (without regard to section 1272(a)(7))";
}
pub relation tax_exempt_oid_accrued_before_acquisition(bond: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1278(a)(4)(B): for a tax-exempt obligation, the aggregate original issue discount that accrued in the periods before acquisition";
}
pub relation revised_issue_price_1278a4(bond: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1278(a)(4): the revised issue price - the issue price plus the earlier holders' original issue discount";
}
@source(IRC_S1278_A, relation = formalizes, coverage = exact, quote = "The term \"revised issue price\" means the sum of")
rule RevisedIssuePriceTaxableRule(bond: DebtInstrument, price: Money, prior: Money) defeasible {
    label en official "section 1278(a)(4)(A)-(B): issue price plus original issue discount includible by all earlier holders";
    when issue_price(bond, price);
    when oid_includible_by_prior_holders(bond, prior);
    when not_known(tax_exempt_obligation(bond));
    then revised_issue_price_1278a4(bond, price + prior);
}
rule RevisedIssuePriceTaxExemptRule(bond: DebtInstrument, price: Money, prior: Money) defeasible {
    label en official "section 1278(a)(4)(B): for a tax-exempt obligation, the original issue discount that accrued before acquisition";
    when issue_price(bond, price);
    when tax_exempt_obligation(bond);
    when tax_exempt_oid_accrued_before_acquisition(bond, prior);
    then revised_issue_price_1278a4(bond, price + prior);
}
@source(IRC_S1278_A, relation = formalizes, coverage = exact, quote = "the stated redemption price of such bond at maturity shall be treated as equal to its revised issue price")
rule MarketDiscountOidBondRule(bond: DebtInstrument, revised: Money, basis: Money) defeasible {
    label en official "section 1278(a)(2)(B): for an OID bond the market discount is the revised issue price over the post-acquisition basis";
    when bond_has_original_issue_discount_1278a2B(bond);
    when revised_issue_price_1278a4(bond, revised);
    when market_discount_basis_after_acquisition(bond, basis);
    when revised > basis;
    then market_discount(bond, revised - basis);
}

// =============================================================================
// Section 1278(a)(1)(B)(iii), (a)(1)(C), (b)(2)
// =============================================================================

pub relation installment_obligation_to_which_453B_applies(bond: DebtInstrument) kind empirical {
    label en official "section 1278(a)(1)(B)(iii): an installment obligation to which section 453B applies";
}
pub relation excluded_installment_obligation_1278a1Biii(bond: DebtInstrument) kind institutional {
    label en official "section 1278(a)(1)(B)(iii): an installment obligation is not a market discount bond";
}
@source(IRC_S1278_A, relation = formalizes, coverage = exact, quote = "Any installment obligation to which section 453B applies")
rule ExcludedInstallmentObligationRule(bond: DebtInstrument) strict {
    label en official "section 1278(a)(1)(B)(iii): installment obligations are excluded";
    when installment_obligation_to_which_453B_applies(bond);
    then excluded_installment_obligation_1278a1Biii(bond);
}
pub relation market_discount_bond_for_1277(bond: DebtInstrument, taxpayer: Person) kind institutional {
    label en official "section 1278(a)(1)(C): for purposes of section 1277 the term market discount bond does not include a tax-exempt obligation";
}
@source(IRC_S1278_A, relation = formalizes, coverage = exact, quote = "For purposes of section 1277, the term \"market discount bond\" shall not include any tax-exempt obligation")
rule MarketDiscountBondFor1277Rule(bond: DebtInstrument, taxpayer: Person) defeasible {
    label en official "section 1278(a)(1)(C): a market discount bond other than a tax-exempt obligation, for section 1277";
    when market_discount_bond(bond, taxpayer);
    when not_known(tax_exempt_obligation(bond));
    then market_discount_bond_for_1277(bond, taxpayer);
}
pub relation bond_acquired_on(bond: DebtInstrument, taxpayer: Person, on: Date) kind empirical {
    label en official "the date the taxpayer acquired the bond";
}
pub relation first_day_of_first_year_election_applies(taxpayer: Person, first_day: Date) kind empirical {
    label en official "section 1278(b)(2): the first day of the first taxable year to which the election applies";
}
pub relation bond_covered_by_1278b_election(bond: DebtInstrument, taxpayer: Person) kind institutional {
    label en official "section 1278(b)(2): the election applies to all market discount bonds acquired on or after the first day of the first taxable year to which it applies";
}
@source(IRC_S1278_B, relation = formalizes, coverage = exact, quote = "shall apply to all market discount bonds acquired by the taxpayer on or after the 1st day of the 1st taxable year to which such election applies")
rule BondCoveredByElectionRule(bond: DebtInstrument, taxpayer: Person, acquired: Date, first_day: Date) defeasible {
    label en official "section 1278(b)(2): a bond acquired on or after the first day of the first electing year is covered";
    when bond_acquired_on(bond, taxpayer, acquired);
    when first_day_of_first_year_election_applies(taxpayer, first_day);
    when acquired >= first_day;
    then bond_covered_by_1278b_election(bond, taxpayer);
}

// =============================================================================
// Section 1276(a)(2)-(4), (b)
// =============================================================================

pub relation disposition_other_than_sale_exchange_or_conversion(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date) kind empirical {
    label en official "section 1276(a)(2): a disposition of a market discount bond in a transaction other than a sale, exchange or involuntary conversion";
}
pub relation fair_market_value_of_bond(bond: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1276(a)(2): the fair market value of the bond";
}
pub relation deemed_gain_on_nonsale_disposition_1276a2(t: Transaction, taxpayer: Person, gain: Money) kind institutional {
    label en official "section 1276(a)(2): the gain on a non-sale disposition, with the fair market value as the amount realized";
}
@source(IRC_S1276_A, relation = formalizes, coverage = exact, quote = "shall be treated as realizing an amount equal to the fair market value of the bond")
rule NonsaleDeemedGainRule(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date, fmv: Money, basis: Money) defeasible {
    label en official "section 1276(a)(2): fair market value less basis is the gain on a non-sale disposition";
    when disposition_other_than_sale_exchange_or_conversion(t, taxpayer, bond, on);
    when fair_market_value_of_bond(bond, fmv);
    when us.irc.core::adjusted_basis(taxpayer, bond, on, basis);
    then deemed_gain_on_nonsale_disposition_1276a2(t, taxpayer, fmv - basis);
}
@source(IRC_S1276_A, relation = formalizes, coverage = partial, quote = "gain on the disposition of any market discount bond shall be treated as ordinary income to the extent it does not exceed the accrued market discount on such bond")
rule NonsaleOrdinaryIncomeWithinRule(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date, gain: Money, accrued: Money) defeasible {
    label en official "section 1276(a)(1) with (a)(2): non-sale gain up to accrued market discount is ordinary income";
    when disposition_other_than_sale_exchange_or_conversion(t, taxpayer, bond, on);
    when deemed_gain_on_nonsale_disposition_1276a2(t, taxpayer, gain);
    when accrued_market_discount(bond, taxpayer, accrued);
    when gain <= accrued;
    then section_1276_ordinary_income(t, taxpayer, gain);
}
rule NonsaleOrdinaryIncomeCappedRule(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date, gain: Money, accrued: Money) defeasible {
    label en official "section 1276(a)(1) with (a)(2): non-sale gain above accrued market discount is ordinary only up to the accrued amount";
    when disposition_other_than_sale_exchange_or_conversion(t, taxpayer, bond, on);
    when deemed_gain_on_nonsale_disposition_1276a2(t, taxpayer, gain);
    when accrued_market_discount(bond, taxpayer, accrued);
    when gain > accrued;
    then section_1276_ordinary_income(t, taxpayer, accrued);
}
pub relation accrued_market_discount_after_partial_payment_1276a3B(bond: DebtInstrument, taxpayer: Person, on: Date, amount: Money) kind institutional {
    label en official "section 1276(a)(3)(B): for later dispositions and payments the accrued market discount is reduced by the partial principal payment included in gross income";
}
@source(IRC_S1276_A, relation = formalizes, coverage = exact, quote = "the amount of accrued market discount shall be reduced by the amount of such partial principal payment included in gross income")
rule AccruedAfterPartialPaymentRule(bond: DebtInstrument, taxpayer: Person, on: Date, accrued: Money, included: Money) defeasible {
    label en official "section 1276(a)(3)(B): accrued market discount less the ordinary income included on a partial principal payment";
    when accrued_market_discount(bond, taxpayer, accrued);
    when partial_principal_payment_ordinary_income(bond, taxpayer, on, included);
    then accrued_market_discount_after_partial_payment_1276a3B(bond, taxpayer, on, accrued - included);
}
pub relation for_excepted_purpose_1276a4(t: Transaction) kind empirical {
    label en official "section 1276(a)(4): the purpose is one of sections 103, 871(a), 881, 1441, 1442 and 6049 (or another provision specified in regulations)";
}
pub relation ordinary_income_treated_as_interest_1276a4(t: Transaction, taxpayer: Person, amount: Money) kind institutional {
    label en official "section 1276(a)(4): ordinary income under paragraph (1) is treated as interest for purposes of the title";
}
@source(IRC_S1276_A, relation = formalizes, coverage = exact, quote = "any amount treated as ordinary income under paragraph (1) or (3) shall be treated as interest for purposes of this title")
rule TreatedAsInterestDispositionRule(t: Transaction, taxpayer: Person, amount: Money) defeasible {
    label en official "section 1276(a)(4): disposition ordinary income is interest, except for the listed sections";
    when section_1276_ordinary_income(t, taxpayer, amount);
    when not_known(for_excepted_purpose_1276a4(t));
    then ordinary_income_treated_as_interest_1276a4(t, taxpayer, amount);
}
pub relation partial_payment_ordinary_income_treated_as_interest_1276a4(bond: DebtInstrument, taxpayer: Person, on: Date, amount: Money) kind institutional {
    label en official "section 1276(a)(4): ordinary income under paragraph (3) is treated as interest";
}
pub relation partial_payment_for_excepted_purpose_1276a4(bond: DebtInstrument, on: Date) kind empirical {
    label en official "section 1276(a)(4): the partial-payment purpose is an excepted section";
}
rule TreatedAsInterestPartialPaymentRule(bond: DebtInstrument, taxpayer: Person, on: Date, amount: Money) defeasible {
    label en official "section 1276(a)(4): partial-payment ordinary income is interest, except for the listed sections";
    when partial_principal_payment_ordinary_income(bond, taxpayer, on, amount);
    when not_known(partial_payment_for_excepted_purpose_1276a4(bond, on));
    then partial_payment_ordinary_income_treated_as_interest_1276a4(bond, taxpayer, on, amount);
}
pub relation srpm_for_constant_yield_1276b2B(bond: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1276(b)(2)(B)(i): for a bond having original issue discount the stated redemption price at maturity is its revised issue price";
}
@source(IRC_S1276_B, relation = formalizes, coverage = partial, quote = "the stated redemption price at maturity of such bond shall be treated as equal to its revised issue price")
rule ConstantYieldRevisedPriceRule(bond: DebtInstrument, revised: Money) defeasible {
    label en official "section 1276(b)(2)(B)(i): revised issue price replaces the stated redemption price for the constant-yield method";
    when bond_has_original_issue_discount_1278a2B(bond);
    when revised_issue_price_1278a4(bond, revised);
    then srpm_for_constant_yield_1276b2B(bond, revised);
}

// =============================================================================
// Section 1276(c): nonrecognition transactions
// =============================================================================

pub relation bond_transferred_in_nonrecognition_transaction(t: Transaction, transferor: Person, transferee: Person, bond: DebtInstrument) kind empirical {
    label en official "section 1276(c)(1): the market discount bond is transferred in a nonrecognition transaction";
}
pub relation transferee_basis_is_transferred_basis(t: Transaction, bond: DebtInstrument) kind empirical {
    label en official "section 1276(c)(1): the bond is transferred basis property in the transferee's hands";
}
pub relation basis_determined_under_732a_or_b(t: Transaction, bond: DebtInstrument) kind empirical {
    label en official "section 1276(c)(3): the transferee's basis is determined under section 732(a) or (b)";
}
pub relation treated_as_transferred_basis_property_1276c(t: Transaction, bond: DebtInstrument) kind institutional {
    label en official "section 1276(c)(1), (3): the bond is transferred basis property (including where the basis arises under section 732(a) or (b))";
}
@source(IRC_S1276_C, relation = formalizes, coverage = exact, quote = "such property shall be treated as transferred basis property in the hands of such transferee")
rule TransferredBasisFromFactRule(t: Transaction, bond: DebtInstrument) strict {
    label en official "section 1276(c)(1): a bond that is transferred basis property in the transferee's hands";
    when transferee_basis_is_transferred_basis(t, bond);
    then treated_as_transferred_basis_property_1276c(t, bond);
}
rule TransferredBasisFrom732Rule(t: Transaction, bond: DebtInstrument) strict {
    label en official "section 1276(c)(3): a basis determined under section 732(a) or (b) is transferred basis";
    when basis_determined_under_732a_or_b(t, bond);
    then treated_as_transferred_basis_property_1276c(t, bond);
}
pub relation transferor_acquired_bond_on(transferor: Person, bond: DebtInstrument, on: Date) kind empirical {
    label en official "section 1276(c)(1)(A): the date on which the transferor acquired the bond";
}
pub relation transferor_basis_in_bond(transferor: Person, bond: DebtInstrument, amount: Money) kind empirical {
    label en official "section 1276(c)(1)(A): the basis of the transferor";
}
pub relation gain_recognized_by_transferor_1276c1B(t: Transaction, amount: Money) kind empirical {
    label en official "section 1276(c)(1)(B): gain recognized by the transferor on the transfer";
}
pub relation oid_or_market_discount_included_by_transferor(t: Transaction, amount: Money) kind empirical {
    label en official "section 1276(c)(1)(B): original issue discount or market discount included in the transferor's gross income";
}
pub relation transferee_deemed_acquisition_date_1276c1A(transferee: Person, bond: DebtInstrument, on: Date) kind institutional {
    label en official "section 1276(c)(1)(A): the transferee is treated as acquiring the bond on the transferor's acquisition date";
}
@source(IRC_S1276_C, relation = formalizes, coverage = exact, quote = "the transferee shall be treated as having acquired the bond on the date on which it was acquired by the transferor")
rule TransfereeAcquisitionDateRule(t: Transaction, transferor: Person, transferee: Person, bond: DebtInstrument, on: Date) defeasible {
    label en official "section 1276(c)(1)(A): the transferee takes the transferor's acquisition date";
    when bond_transferred_in_nonrecognition_transaction(t, transferor, transferee, bond);
    when treated_as_transferred_basis_property_1276c(t, bond);
    when transferor_acquired_bond_on(transferor, bond, on);
    then transferee_deemed_acquisition_date_1276c1A(transferee, bond, on);
}
pub relation transferee_deemed_acquisition_cost_1276c1A(transferee: Person, bond: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1276(c)(1)(A): the transferee is treated as acquiring the bond for an amount equal to the transferor's basis";
}
@source(IRC_S1276_C, relation = formalizes, coverage = exact, quote = "for an amount equal to the basis of the transferor")
rule TransfereeAcquisitionCostRule(t: Transaction, transferor: Person, transferee: Person, bond: DebtInstrument, basis: Money) defeasible {
    label en official "section 1276(c)(1)(A): the transferee's deemed cost is the transferor's basis";
    when bond_transferred_in_nonrecognition_transaction(t, transferor, transferee, bond);
    when treated_as_transferred_basis_property_1276c(t, bond);
    when transferor_basis_in_bond(transferor, bond, basis);
    then transferee_deemed_acquisition_cost_1276c1A(transferee, bond, basis);
}
pub relation transferee_adjusted_deemed_cost_1276c1B(transferee: Person, bond: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1276(c)(1)(B): the deemed cost adjusted for the gain recognized by the transferor and the discount the transferor included";
}
@source(IRC_S1276_C, relation = formalizes, coverage = exact, quote = "proper adjustments shall be made for gain recognized by the transferor on such transfer")
rule TransfereeAdjustedCostRule(t: Transaction, transferor: Person, transferee: Person, bond: DebtInstrument, basis: Money, gain: Money, included: Money) defeasible {
    label en official "section 1276(c)(1)(B): basis plus the gain recognized plus the discount included (JUDGMENT CALL: the proper adjustment is additive)";
    when bond_transferred_in_nonrecognition_transaction(t, transferor, transferee, bond);
    when treated_as_transferred_basis_property_1276c(t, bond);
    when transferor_basis_in_bond(transferor, bond, basis);
    when gain_recognized_by_transferor_1276c1B(t, gain);
    when oid_or_market_discount_included_by_transferor(t, included);
    then transferee_adjusted_deemed_cost_1276c1B(transferee, bond, basis + gain + included);
}
pub relation accrued_discount_not_yet_ordinary(bond: DebtInstrument, taxpayer: Person, amount: Money) kind empirical {
    label en official "section 1276(c)(2): the accrued market discount of the bond disposed of, to the extent not theretofore treated as ordinary income under subsection (a)";
}
pub relation exchanged_property_is_market_discount_bond(prop: Asset) kind empirical {
    label en official "section 1276(c)(2)(A): the exchanged basis property is a market discount bond";
}
pub relation accrued_market_discount_of_exchanged_bond_1276c2A(taxpayer: Person, prop: Asset, amount: Money) kind institutional {
    label en official "section 1276(c)(2)(A): the carried amount is accrued market discount of the exchanged basis property";
}
@source(IRC_S1276_C, relation = formalizes, coverage = exact, quote = "shall be treated as accrued market discount with respect to the exchanged basis property received by the taxpayer in such transaction if such property is a market discount bond")
rule ExchangedBondCarriesAccruedRule(t: Transaction, taxpayer: Person, bond: DebtInstrument, prop: Asset, amount: Money) defeasible {
    label en official "section 1276(c)(2)(A): accrued discount carries to an exchanged market discount bond";
    when bond_disposed_in_nonrecognition_transaction_for_1276c2(t, taxpayer, bond);
    when exchanged_basis_property_1276c2(bond, prop);
    when exchanged_property_is_market_discount_bond(prop);
    when accrued_discount_not_yet_ordinary(bond, taxpayer, amount);
    then accrued_market_discount_of_exchanged_bond_1276c2A(taxpayer, prop, amount);
}
pub relation bond_disposed_in_nonrecognition_transaction_for_1276c2(t: Transaction, taxpayer: Person, bond: DebtInstrument) kind empirical {
    label en official "section 1276(c)(2): the bond is disposed of in a nonrecognition transaction to which paragraph (1) does not apply";
}
pub relation exchanged_property_disposed_of(prop: Asset, taxpayer: Person) kind empirical {
    label en official "section 1276(c)(2)(B): the exchanged basis property is disposed of";
}
pub relation ordinary_income_on_disposition_of_exchanged_property_1276c2B(taxpayer: Person, prop: Asset, amount: Money) kind institutional {
    label en official "section 1276(c)(2)(B): the carried amount is ordinary income on the disposition of the exchanged property that is not a market discount bond";
}
@source(IRC_S1276_C, relation = formalizes, coverage = exact, quote = "shall be treated as ordinary income on the disposition of the exchanged basis property received by the taxpayer in such exchange if such property is not a market discount bond")
rule ExchangedNonBondOrdinaryIncomeRule(t: Transaction, taxpayer: Person, bond: DebtInstrument, prop: Asset, amount: Money) defeasible {
    label en official "section 1276(c)(2)(B): accrued discount becomes ordinary income on disposing of a non-bond exchanged property";
    when bond_disposed_in_nonrecognition_transaction_for_1276c2(t, taxpayer, bond);
    when exchanged_basis_property_1276c2(bond, prop);
    when not_known(exchanged_property_is_market_discount_bond(prop));
    when exchanged_property_disposed_of(prop, taxpayer);
    when accrued_discount_not_yet_ordinary(bond, taxpayer, amount);
    then ordinary_income_on_disposition_of_exchanged_property_1276c2B(taxpayer, prop, amount);
}

// =============================================================================
// Section 1276(d): section 1245(b)-like rules
// =============================================================================

pub relation transaction_is_gift_1276d(t: Transaction) kind empirical {
    label en official "section 1276(d)(1)(A): a gift (section 1245(b)(1) does not apply)";
}
pub relation exchange_qualifying_354a_355a_356a(t: Transaction) kind empirical {
    label en official "section 1276(d)(1)(B): an exchange qualifying under section 354(a), 355(a) or 356(a) determined without regard to subsection (a) of section 1276";
}
pub relation transaction_of_1245b3_kind_other_than_351(t: Transaction) kind empirical {
    label en official "section 1276(d)(1): a transaction described in section 1245(b)(3) (other than section 351, per (C))";
}
pub relation transaction_under_section_351(t: Transaction) kind empirical {
    label en official "section 1276(d)(1)(C): a section 351 transaction (the reference to it in section 1245(b)(3) is disregarded)";
}
pub relation treated_as_1245b_carryover_transaction_1276d1(t: Transaction) kind institutional {
    label en official "section 1276(d)(1): the transaction is treated as a section 1245(b)(3) transaction for market discount purposes";
}
@source(IRC_S1276_D, relation = formalizes, coverage = partial, quote = "an exchange qualifying under section 354(a), 355(a), or 356(a) (determined without regard to subsection (a) of this section) shall be treated as an exchange described in paragraph (3) of such subsection")
rule CarryoverTransactionExchangeRule(t: Transaction) defeasible {
    label en official "section 1276(d)(1)(B): a section 354/355/356 exchange is a section 1245(b)(3) exchange";
    when exchange_qualifying_354a_355a_356a(t);
    when not_known(transaction_is_gift_1276d(t));
    then treated_as_1245b_carryover_transaction_1276d1(t);
}
rule CarryoverTransactionOtherRule(t: Transaction) defeasible {
    label en official "section 1276(d)(1): another section 1245(b)(3) transaction (not section 351, not a gift)";
    when transaction_of_1245b3_kind_other_than_351(t);
    when not_known(transaction_under_section_351(t));
    when not_known(transaction_is_gift_1276d(t));
    then treated_as_1245b_carryover_transaction_1276d1(t);
}
pub relation basis_adjusted_for_1276a_gain_1276d2(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date, amount: Money) kind institutional {
    label en official "section 1276(d)(2): the basis is adjusted to reflect gain recognized under subsection (a)";
}
@source(IRC_S1276_D, relation = formalizes, coverage = partial, quote = "appropriate adjustments shall be made to the basis of any property to reflect gain recognized under subsection (a)")
rule BasisAdjustedFor1276aGainRule(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date, basis: Money, ordinary: Money) defeasible {
    label en official "section 1276(d)(2): basis plus the ordinary income recognized under subsection (a) (JUDGMENT CALL: additive)";
    when disposes_of_market_discount_bond(t, taxpayer, bond, on);
    when us.irc.core::adjusted_basis(taxpayer, bond, on, basis);
    when section_1276_ordinary_income(t, taxpayer, ordinary);
    then basis_adjusted_for_1276a_gain_1276d2(t, taxpayer, bond, on, basis + ordinary);
}
