// Property transactions -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 1398(g)(3), (4), (7): the estate's succession to the debtor's tax-benefit recovery items, credit carryovers and method of
// accounting is stated by the text of section 1398(g) itself, so the status stubs are derived here from the applicability of the section.
// The amounts and the contents of these items stay with the owners (gross-income, credits, accounting).
//
// NOT wired (recorded in WIRE-9-WORKLIST.json): section 1398(g)(1) and (g)(2) carry an amount that sums several per-year owner relations
// (deductions: nol_carryover_pre2018_arising + nol_carryover_post2017_arising; charitable_carryover per source year); an aggregate over
// derived predicates is a runtime subset limitation (section 111) and a single-valued stub cannot hold one row per source year.

language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

use self::{
    BankruptcyCase,
    BankruptcyEstate,
    IRC_S1398_G,
    Person,
    bankruptcy_estate_of,
    estate_succeeds_to_credit_carryovers,
    estate_succeeds_to_method_of_accounting,
    estate_succeeds_to_tax_benefit_recovery_items,
    section_1398_applies,
};

@source(IRC_S1398_G, relation = formalizes, coverage = partial, quote = "Any amount to which section 111 (relating to recovery of tax benefit items) applies.")
rule W10EstateSucceedsToTaxBenefitRecoveryItemsRule(estate: BankruptcyEstate, debtor: Person, c: BankruptcyCase) defeasible {
    label en official "section 1398(g)(3): the estate succeeds to the debtor's section 111 recovery of tax benefit items";
    when section_1398_applies(c, debtor);
    when bankruptcy_estate_of(c, estate);
    then estate_succeeds_to_tax_benefit_recovery_items(estate, debtor);
}
@source(IRC_S1398_G, relation = formalizes, coverage = partial, quote = "The carryovers of any credit, and all other items which, but for the commencement of the case, would be required to be taken into account by the debtor with respect to any credit.")
rule W10EstateSucceedsToCreditCarryoversRule(estate: BankruptcyEstate, debtor: Person, c: BankruptcyCase) defeasible {
    label en official "section 1398(g)(4): the estate succeeds to the debtor's credit carryovers";
    when section_1398_applies(c, debtor);
    when bankruptcy_estate_of(c, estate);
    then estate_succeeds_to_credit_carryovers(estate, debtor);
}
@source(IRC_S1398_G, relation = formalizes, coverage = partial, quote = "The method of accounting used by the debtor.")
rule W10EstateSucceedsToMethodOfAccountingRule(estate: BankruptcyEstate, debtor: Person, c: BankruptcyCase) defeasible {
    label en official "section 1398(g)(7): the estate succeeds to the debtor's method of accounting";
    when section_1398_applies(c, debtor);
    when bankruptcy_estate_of(c, estate);
    then estate_succeeds_to_method_of_accounting(estate, debtor);
}
