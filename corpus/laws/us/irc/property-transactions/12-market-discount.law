// Stage 2b (IRC-07, A05). Section 1276-1278: market discount bonds — the
// section 1278(a)(2) market discount/de minimis definitions, the section
// 1276(b)(1) ratable-accrual computation and the (b)(2) constant-interest-
// rate election as a power, section 1276(a) ordinary-income-on-disposition
// rule, and section 1277's net-direct-interest-expense limitation.

// =============================================================================
// Section 1278(a): definitions
// =============================================================================

use self::{
    DeMinimisOidRatePerYear,
    DebtInstrument,
    IRC_S1276_A,
    IRC_S1276_B,
    IRC_S1277_A,
    IRC_S1278_A,
    IRC_S1278_B,
    Person,
    TaxableYear,
    Transaction,
    bond_has_original_issue_discount_1278a2B,
    gain_recognized,
    installment_obligation_to_which_453B_applies,
    original_issue_exclusion_applies_1278a1D,
    short_term_obligation_1272a2c,
    stated_redemption_price_at_maturity,
    tax_exempt_obligation,
    united_states_savings_bond,
};

pub relation market_discount_basis_after_acquisition(bond: DebtInstrument, amount: Money) kind empirical {
    label en unofficial "section 1278(a)(2)(A)(ii): the taxpayer's basis in the bond immediately after acquisition";
}
pub relation market_discount(bond: DebtInstrument, amount: Money) kind institutional {
    label en official "section 1278(a)(2)(A): the excess of the stated redemption price at maturity over the taxpayer's basis immediately after acquisition (coordination with OID via revised issue price, (B), is TECH_GAP)";
}
@source(IRC_S1278_A, quote = "the excess (if any) of—")
rule MarketDiscountRule(bond: DebtInstrument, srpm: Money, basis: Money) defeasible {
    label en official "section 1278(a)(2)(A): market discount is the excess of stated redemption price at maturity over post-acquisition basis";
    when stated_redemption_price_at_maturity(bond, srpm);
    when not_known(bond_has_original_issue_discount_1278a2B(bond));
    when market_discount_basis_after_acquisition(bond, basis);
    when srpm > basis;
    then market_discount(bond, srpm - basis);
}

pub relation complete_years_to_maturity_after_acquisition(bond: DebtInstrument, n: Integer) kind empirical {
    label en official "section 1278(a)(2)(C): the number of complete years to maturity after the taxpayer acquired the bond";
}
pub relation market_discount_treated_as_zero(bond: DebtInstrument) kind institutional {
    label en official "section 1278(a)(2)(C): the de minimis rule — market discount below ¼-of-1%-per-complete-year of the stated redemption price at maturity is treated as zero";
}
@source(IRC_S1278_A, quote = "If the market discount is less than ¼ of 1 percent of the stated redemption price of the bond at maturity multiplied by the number of complete years to maturity (after the taxpayer acquired the bond), then the market discount shall be considered to be zero.")
rule MarketDiscountDeMinimisRule(bond: DebtInstrument, discount: Money, srpm: Money, years: Integer) defeasible {
    label en official "section 1278(a)(2)(C): market discount below the de minimis threshold is treated as zero";
    when market_discount(bond, discount);
    when stated_redemption_price_at_maturity(bond, srpm);
    when complete_years_to_maturity_after_acquisition(bond, years);
    when discount < srpm * DeMinimisOidRatePerYear * years;
    then market_discount_treated_as_zero(bond);
}

pub relation bond_held_by(bond: DebtInstrument, taxpayer: Person) kind empirical {
    label en unofficial "the taxpayer holding the bond, for purposes of the market-discount rules";
}
pub relation has_market_discount(bond: DebtInstrument) kind institutional {
    label en unofficial "guard: the bond has (non-zero) market discount";
}
rule HasMarketDiscountRule(bond: DebtInstrument, discount: Money) defeasible {
    when market_discount(bond, discount);
    when not_known(market_discount_treated_as_zero(bond));
    then has_market_discount(bond);
}
pub relation acquired_at_original_issue(bond: DebtInstrument, taxpayer: Person) kind empirical {
    label en official "section 1278(a)(1)(D)(i): the bond was acquired by the taxpayer at its original issue — excluded from market_discount_bond, absent the (D)(ii)-(iv) exceptions (TECH_GAP: those exceptions are not separately derived)";
}
pub relation market_discount_bond(bond: DebtInstrument, taxpayer: Person) kind institutional {
    label en official "section 1278(a)(1): a bond having market discount, other than a short-term obligation, US savings bond, section 453B installment obligation, or (subject to (D)(ii)-(iv)) a bond acquired at original issue";
}
@source(IRC_S1278_A, quote = "the term \"market discount bond\" means any bond having market discount.")
rule MarketDiscountBondRule(bond: DebtInstrument, taxpayer: Person) defeasible {
    label en official "section 1278(a)(1)(A)-(B),(D): a bond with market discount is a market discount bond, unless a short-term obligation, US savings bond, installment obligation, or acquired at original issue";
    when has_market_discount(bond);
    when bond_held_by(bond, taxpayer);
    when not_known(short_term_obligation_1272a2c(bond));
    when not_known(united_states_savings_bond(bond));
    when not_known(original_issue_exclusion_applies_1278a1D(bond, taxpayer));
    when not_known(installment_obligation_to_which_453B_applies(bond));
    then market_discount_bond(bond, taxpayer);
}

// =============================================================================
// Section 1276(b): accrued market discount
// =============================================================================

pub relation days_held_by_taxpayer(bond: DebtInstrument, days: Integer) kind empirical {
    label en official "section 1276(b)(1)(A): the number of days the taxpayer held the bond";
}
pub relation days_from_acquisition_to_maturity(bond: DebtInstrument, days: Integer) kind empirical {
    label en official "section 1276(b)(1)(B): the number of days after the date the taxpayer acquired the bond up to and including its maturity date";
}
pub relation ratable_accrual_election_made(bond: DebtInstrument, taxpayer: Person) kind empirical {
    label en unofficial "guard: no section 1276(b)(2) constant-interest-rate election is in effect for this bond (ratable accrual is the DEFAULT, so this stage models ratable accrual whenever the election is not asserted, per (b)(2)'s own 'in lieu of ratable accrual' framing)";
}
pub relation accrued_market_discount(bond: DebtInstrument, taxpayer: Person, amount: Money) kind institutional {
    label en official "section 1276(b): the accrued market discount on the bond";
}
@source(IRC_S1276_B, quote = "the accrued market discount on any bond shall be an amount which bears the same ratio to the market discount on such bond as—")
rule RatableAccrualMarketDiscountRule(bond: DebtInstrument, taxpayer: Person, discount: Money, held: Integer, total: Integer) defeasible {
    label en official "section 1276(b)(1): ratable accrual — market discount times (days held / days from acquisition to maturity); exact fraction form div_round(discount * held, total * 1.00, 2, HALF_UP) (stage 2c replaced a 10-place decimal approximation of the ratio; cents HALF_UP: JUDGMENT CALL)";
    when market_discount(bond, discount);
    when bond_held_by(bond, taxpayer);
    when not_known(constant_interest_rate_election_in_effect(bond, taxpayer));
    when days_held_by_taxpayer(bond, held);
    when days_from_acquisition_to_maturity(bond, total);
    then accrued_market_discount(bond, taxpayer, div_round(discount * held, total * 1.00, 2, "HALF_UP"));
}

// (b)(2): the constant-interest-rate election, as a taxpayer power
// (irrevocable, per (b)(2)(C)) — modelled as suppressing the ratable-
// accrual rule above (the constant-yield AMOUNT itself would need this
// package's own section 1272(a) one-period step layered on a bond
// origin-date reset, TECH_GAP: not computed, only the election's VALIDITY
// and its suppression effect on ratable accrual are modelled).
pub relation elects_constant_interest_rate_accrual(bond: DebtInstrument, taxpayer: Person) kind empirical {
    label en official "section 1276(b)(2)(A): the taxpayer elects accrual on the basis of a constant interest rate, in lieu of ratable accrual";
}
pub relation constant_interest_rate_election_in_effect(bond: DebtInstrument, taxpayer: Person) kind institutional {
    label en official "section 1276(b)(2): the constant-interest-rate election is in effect for this bond (irrevocable once made, (b)(2)(C))";
}
@source(IRC_S1276_B, quote = "At the election of the taxpayer with respect to any bond, the accrued market discount on such bond shall be the aggregate amount which would have been includible in the gross income of the taxpayer under section 1272(a)")
rule ConstantInterestRateElectionPower(bond: DebtInstrument, taxpayer: Person) strict {
    label en official "section 1276(b)(2)(A): a taxpayer may elect constant-interest-rate accrual for a bond, in lieu of ratable accrual";
    when elects_constant_interest_rate_accrual(bond, taxpayer);
    then power Section1276ConstantInterestRateElection {
        holder taxpayer;
        over bond;
        exercise elects_constant_interest_rate_accrual(bond, taxpayer);
        valid_when elects_constant_interest_rate_accrual(bond, taxpayer);
        effect create(constant_interest_rate_election_in_effect(bond, taxpayer));
        window [@1984-07-19, infinity);
    };
}

// =============================================================================
// Section 1276(a): ordinary income on disposition
// =============================================================================

pub relation disposes_of_market_discount_bond(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date) kind empirical;
pub relation section_1276_ordinary_income(t: Transaction, taxpayer: Person, amount: Money) kind institutional {
    label en official "section 1276(a)(1): gain on the disposition of a market discount bond is ordinary income to the extent it does not exceed accrued market discount";
}
@source(IRC_S1276_A, quote = "gain on the disposition of any market discount bond shall be treated as ordinary income to the extent it does not exceed the accrued market discount on such bond.")
rule Section1276OrdinaryIncomeWithinAccruedDiscountRule(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date, gain: Money, accrued: Money) defeasible {
    label en official "section 1276(a)(1): gain up to accrued market discount is ordinary income";
    when disposes_of_market_discount_bond(t, taxpayer, bond, on);
    when gain_recognized(taxpayer, t, gain);
    when accrued_market_discount(bond, taxpayer, accrued);
    when gain <= accrued;
    then section_1276_ordinary_income(t, taxpayer, gain);
}
rule Section1276OrdinaryIncomeCappedAtAccruedDiscountRule(t: Transaction, taxpayer: Person, bond: DebtInstrument, on: Date, gain: Money, accrued: Money) defeasible {
    label en official "section 1276(a)(1): gain exceeding accrued market discount is ordinary income only up to that accrued amount";
    when disposes_of_market_discount_bond(t, taxpayer, bond, on);
    when gain_recognized(taxpayer, t, gain);
    when accrued_market_discount(bond, taxpayer, accrued);
    when gain > accrued;
    then section_1276_ordinary_income(t, taxpayer, accrued);
}

// (a)(3): partial principal payments included in gross income as ordinary
// income to the extent of accrued market discount.
pub relation partial_principal_payment(bond: DebtInstrument, taxpayer: Person, on: Date, amount: Money) kind empirical {
    label en official "section 1276(a)(3)(A): a partial principal payment on the market discount bond";
}
pub relation partial_principal_payment_ordinary_income(bond: DebtInstrument, taxpayer: Person, on: Date, amount: Money) kind institutional {
    label en official "section 1276(a)(3)(A): a partial principal payment is ordinary income to the extent it does not exceed accrued market discount";
}
@source(IRC_S1276_A, quote = "Any partial principal payment on a market discount bond shall be included in gross income as ordinary income to the extent such payment does not exceed the accrued market discount on such bond.")
rule PartialPrincipalPaymentWithinAccruedDiscountRule(bond: DebtInstrument, taxpayer: Person, on: Date, payment: Money, accrued: Money) defeasible {
    label en official "section 1276(a)(3)(A): partial principal payment up to accrued market discount is ordinary income";
    when partial_principal_payment(bond, taxpayer, on, payment);
    when accrued_market_discount(bond, taxpayer, accrued);
    when payment <= accrued;
    then partial_principal_payment_ordinary_income(bond, taxpayer, on, payment);
}
rule PartialPrincipalPaymentCappedAtAccruedDiscountRule(bond: DebtInstrument, taxpayer: Person, on: Date, payment: Money, accrued: Money) defeasible {
    label en official "section 1276(a)(3)(A): partial principal payment exceeding accrued market discount is ordinary income only up to that accrued amount";
    when partial_principal_payment(bond, taxpayer, on, payment);
    when accrued_market_discount(bond, taxpayer, accrued);
    when payment > accrued;
    then partial_principal_payment_ordinary_income(bond, taxpayer, on, accrued);
}

// =============================================================================
// Section 1277: net direct interest expense limitation
// =============================================================================

pub relation net_direct_interest_expense(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 1277(c): interest paid/accrued to purchase or carry the bond, less interest (incl. OID) includible in gross income on it — case-supplied this stage, the (c) computation itself not derived from raw interest facts";
}
pub relation market_discount_allocable_to_year(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 1277(a): the portion of market discount allocable to the days during the taxable year the bond was held (determined under section 1276(b)'s rules) — case-supplied this stage rather than derived by intersecting the taxable year's own date range with accrued_market_discount's day-count inputs";
}
pub relation net_direct_interest_expense_deduction_disallowed(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1277(a): net direct interest expense is disallowed as a deduction to the extent it does not exceed the market discount allocable to the year";
}
@source(IRC_S1277_A, quote = "the net direct interest expense with respect to any market discount bond shall be allowed as a deduction for the taxable year only to the extent that such expense exceeds the portion of the market discount allocable to the days during the taxable year on which such bond was held by the taxpayer")
rule NetDirectInterestExpenseDisallowedWithinAllocableRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, expense: Money, allocable: Money) defeasible {
    label en official "section 1277(a): expense not exceeding the allocable market discount is entirely disallowed";
    when net_direct_interest_expense(bond, taxpayer, y, expense);
    when market_discount_allocable_to_year(bond, taxpayer, y, allocable);
    when expense <= allocable;
    when not_known(tax_exempt_obligation(bond));
    then net_direct_interest_expense_deduction_disallowed(bond, taxpayer, y, expense);
}
rule NetDirectInterestExpenseDisallowedCappedAtAllocableRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, expense: Money, allocable: Money) defeasible {
    label en official "section 1277(a): where expense exceeds the allocable market discount, only the allocable amount is disallowed (the excess is deductible)";
    when net_direct_interest_expense(bond, taxpayer, y, expense);
    when market_discount_allocable_to_year(bond, taxpayer, y, allocable);
    when expense > allocable;
    when not_known(tax_exempt_obligation(bond));
    then net_direct_interest_expense_deduction_disallowed(bond, taxpayer, y, allocable);
}

// =============================================================================
// Section 1278(b): election to include market discount currently
// =============================================================================

pub relation elects_to_include_market_discount_currently(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "section 1278(b)(1): the taxpayer elects to include market discount currently, in lieu of sections 1276 and 1277";
}
pub relation section_1278b_election_in_effect(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 1278(b)(3): the election applies to the year made and all subsequent years, unless the Secretary consents to revocation";
}
@source(IRC_S1278_B, quote = "sections 1276 and 1277 shall not apply, and")
rule Section1278bElectionPower(taxpayer: Person, y: TaxableYear) strict {
    label en official "section 1278(b)(1): a taxpayer may elect to include market discount currently, displacing sections 1276 and 1277";
    when elects_to_include_market_discount_currently(taxpayer, y);
    then power Section1278CurrentInclusionElection {
        holder taxpayer;
        over y;
        exercise elects_to_include_market_discount_currently(taxpayer, y);
        valid_when elects_to_include_market_discount_currently(taxpayer, y);
        effect create(section_1278b_election_in_effect(taxpayer, y));
        window [@1984-07-19, infinity);
    };
}
pub relation market_discount_included_currently(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1278(b)(1)(B): market discount included in gross income for the years to which it is attributable under section 1276(b)'s rules, once the (b) election is in effect";
}
rule MarketDiscountIncludedCurrentlyRule(bond: DebtInstrument, taxpayer: Person, y: TaxableYear, accrued: Money) defeasible {
    label en official "section 1278(b)(1)(B): once elected, accrued market discount for the year is currently includible";
    when section_1278b_election_in_effect(taxpayer, y);
    when accrued_market_discount(bond, taxpayer, accrued);
    then market_discount_included_currently(bond, taxpayer, y, accrued);
}
// (b)(4) basis adjustment: exposed as its own terminal relation, NOT
// written back into `us.irc.core::adjusted_basis` at the same key (same
// self-loop concern as section 1272(c)(2) above).
pub relation market_discount_amount_included_in_gross_income(taxpayer: Person, bond: DebtInstrument, amount: Money) kind empirical {
    label en unofficial "the amount of market discount actually included in the taxpayer's gross income under the section 1278(b) election";
}
pub relation basis_after_market_discount_inclusion(taxpayer: Person, bond: DebtInstrument, on: Date, amount: Money) kind institutional {
    label en official "section 1278(b)(4): the bond's basis, increased by the market discount included in gross income under the (b) election";
}
@source(IRC_S1278_B, relation = formalizes, coverage = partial, quote = "The basis of any bond in the hands of the taxpayer shall be increased by the amount included in gross income pursuant to this subsection.")
rule BasisAfterMarketDiscountInclusionRule(taxpayer: Person, bond: DebtInstrument, on: Date, basis: Money, included: Money) strict {
    label en official "section 1278(b)(4): basis increases by the amount included in gross income under the (b) election";
    when us.irc.core::adjusted_basis(taxpayer, bond, on, basis);
    when market_discount_amount_included_in_gross_income(taxpayer, bond, included);
    then basis_after_market_discount_inclusion(taxpayer, bond, on, basis + included);
}
