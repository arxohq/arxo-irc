// Stage 3b (IRC-07, A05). Section 1259 remainder: (a)(2) basis and holding-period
// consequences, (b)(2) exclusions from the appreciated financial position, (c)(2) the
// nonpublicly traded sale contract exception, (c)(3)(B) the second closed transaction,
// (c)(4) related persons, (e) special rules.
//
// Method. Module 08 carries the four triggers, the (c)(3)(A) closed-transaction exception
// and the recognized gain. Its constructive-sale rule now reads three guards from this module.
// (Stage 3b fix: the stage 2 guard read the (c)(3)(A) exception at the wrong date argument, so the
// exception never applied; it reads the transaction-keyed relation below.) The (e)(1) re-entry
// heads its own predicates, so the chain is bounded at one re-entry (LDC-E4102 avoidance).

// =============================================================================
// Section 1259(c)(3)(A) wiring, (c)(3)(B) second closed transaction
// =============================================================================

use self::{
    AppreciatedFinancialPosition,
    IRC_S1259_A,
    IRC_S1259_B,
    IRC_S1259_C,
    IRC_S1259_E,
    Person,
    TaxableYear,
    Transaction,
    closed_transaction_exception_applies,
    constructive_sale_of_appreciated_financial_position,
    constructive_sale_transaction,
    held_throughout_60_day_period_from_close,
    marketable_security_453f,
    section_1259_gain_recognized,
    settles_within_1_year,
    transaction_closed_on,
    would_produce_gain_at_fmv,
};

pub relation closed_transaction_exception_disregards_1259c3(p: Person, pos: AppreciatedFinancialPosition, t: Transaction) kind institutional {
    label en official "section 1259(c)(3): the transaction is disregarded (the closed-transaction exception applies to it)";
}
@source(IRC_S1259_C, relation = formalizes, coverage = exact, quote = "there shall be disregarded any transaction (which would otherwise cause a constructive sale) during the taxable year if")
rule ClosedTransactionDisregardedRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, year_end: Date) defeasible {
    label en official "section 1259(c)(3)(A): the closed transaction is disregarded";
    when closed_transaction_exception_applies(p, pos, t, year_end);
    then closed_transaction_exception_disregards_1259c3(p, pos, t);
}

pub relation second_transaction_entered_on(t2: Transaction, on: Date) kind empirical {
    label en official "section 1259(c)(3)(B)(ii): the date another transaction is entered into";
}
pub relation second_transaction_would_defeat_risk_of_loss_test(t1: Transaction, t2: Transaction) kind empirical {
    label en official "section 1259(c)(3)(B)(ii)(I): the second transaction would, but for subparagraph (B), cause the requirement of subparagraph (A)(iii) not to be met with respect to the first transaction";
}
pub relation second_transaction_meets_A_ii_and_iii(t2: Transaction) kind empirical {
    label en official "section 1259(c)(3)(B)(ii)(III): the second transaction meets the requirements of clauses (ii) and (iii) of subparagraph (A)";
}
pub relation first_transaction_closed_in_year_or_30_days_after(t1: Transaction, closed_on: Date) kind empirical {
    label en official "section 1259(c)(3)(B)(i): the first transaction is closed during the taxable year or during the 30 days thereafter";
}
pub relation taxable_year_close_of_first_transaction(t1: Transaction, year_end: Date) kind empirical {
    label en official "section 1259(c)(3)(B)(ii)(II): the close of the taxable year in which the first transaction occurs";
}
pub relation second_transaction_closed_on(t2: Transaction, closed_on: Date) kind empirical {
    label en official "section 1259(c)(3)(B)(ii)(II): the date the second transaction is closed";
}
pub relation second_transaction_disregarded_for_A_iii_1259c3B(t1: Transaction, t2: Transaction) kind institutional {
    label en official "section 1259(c)(3)(B): the second transaction is disregarded in determining whether requirement (A)(iii) is met for the first transaction";
}
@source(IRC_S1259_C, relation = formalizes, coverage = exact, quote = "the transaction referred to in clause (ii) shall be disregarded for purposes of determining whether the requirements of subparagraph (A)(iii) are met with respect to the transaction described in clause (i)")
rule SecondTransactionDisregardedRule(t1: Transaction, t2: Transaction, closed1: Date, entered2: Date, closed2: Date, year_end: Date) defeasible {
    label en official "section 1259(c)(3)(B): a second transaction entered within 60 days after the first is closed, closed within 30 days after the year close and meeting (A)(ii)-(iii) is disregarded for (A)(iii)";
    when first_transaction_closed_in_year_or_30_days_after(t1, closed1);
    when taxable_year_close_of_first_transaction(t1, year_end);
    when closed1 <= add_calendar_period(year_end, 30 calendar_day);
    when second_transaction_entered_on(t2, entered2);
    when entered2 >= closed1;
    when entered2 <= add_calendar_period(closed1, 60 calendar_day);
    when second_transaction_would_defeat_risk_of_loss_test(t1, t2);
    when second_transaction_closed_on(t2, closed2);
    when closed2 <= add_calendar_period(year_end, 30 calendar_day);
    when second_transaction_meets_A_ii_and_iii(t2);
    then second_transaction_disregarded_for_A_iii_1259c3B(t1, t2);
}
pub relation risk_of_loss_diminished_only_by_disregarded_transaction(p: Person, pos: AppreciatedFinancialPosition, closed_on: Date) kind empirical {
    label en official "section 1259(c)(3)(B): the only reduction of risk of loss during the 60-day period is by the second transaction";
}
@source(IRC_S1259_C, relation = formalizes, coverage = exact, quote = "at no time during such 60-day period is the taxpayer's risk of loss with respect to such position reduced")
rule ClosedTransactionExceptionSecondClosedRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, t2: Transaction, closed_on: Date, y: TaxableYear, taxable_year_end: Date) defeasible {
    label en official "section 1259(c)(3)(B): the exception applies where the risk of loss was reduced only by a disregarded second transaction";
    when transaction_closed_on(t, closed_on);
    when us.irc.core::year_of(p, y);
    when us.irc.core::ends(y, taxable_year_end);
    when closed_on <= add_calendar_period(taxable_year_end, 30 calendar_day);
    when held_throughout_60_day_period_from_close(p, pos, closed_on);
    when risk_of_loss_diminished_only_by_disregarded_transaction(p, pos, closed_on);
    when second_transaction_disregarded_for_A_iii_1259c3B(t, t2);
    then closed_transaction_exception_applies(p, pos, t, taxable_year_end);
}

// =============================================================================
// Section 1259(c)(2): nonpublicly traded sale contract exception
// =============================================================================

pub relation contract_for_sale_of_stock_debt_or_partnership_interest(t: Transaction) kind empirical {
    label en official "section 1259(c)(2): a contract for sale of any stock, debt instrument or partnership interest";
}
pub relation sale_contract_relates_to_position(t: Transaction, pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(c)(2): the position the contract for sale relates to";
}
pub relation nonpublic_sale_contract_exception_1259c2(t: Transaction, pos: AppreciatedFinancialPosition) kind institutional {
    label en official "section 1259(c)(2): no constructive sale solely because of a contract to sell a non-marketable security that settles within 1 year";
}
@source(IRC_S1259_C, relation = formalizes, coverage = exact, quote = "if the contract settles within 1 year after the date such contract is entered into")
rule NonpublicSaleContractExceptionRule(t: Transaction, pos: AppreciatedFinancialPosition) strict {
    label en official "section 1259(c)(2): a contract to sell a non-marketable stock, debt instrument or partnership interest that settles within 1 year";
    when contract_for_sale_of_stock_debt_or_partnership_interest(t);
    when sale_contract_relates_to_position(t, pos);
    when not_known(marketable_security_453f(pos));
    when settles_within_1_year(t);
    then nonpublic_sale_contract_exception_1259c2(t, pos);
}

// =============================================================================
// Section 1259(b)(2): exclusions from the appreciated financial position
// =============================================================================

pub relation debt_position_unconditionally_entitles_specified_principal(pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(b)(2)(A)(i): the position unconditionally entitles the holder to receive a specified principal amount";
}
pub relation interest_meets_860G_a1B_i(pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(b)(2)(A)(ii): the interest payments meet the requirements of clause (i) of section 860G(a)(1)(B)";
}
pub relation convertible_into_stock_of_issuer_or_related(pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(b)(2)(A)(iii): the position is convertible (directly or indirectly) into stock of the issuer or any related person";
}
pub relation excluded_debt_position_1259b2A(pos: AppreciatedFinancialPosition) kind institutional {
    label en official "section 1259(b)(2)(A): a position with respect to debt meeting clauses (i)-(iii)";
}
@source(IRC_S1259_B, relation = formalizes, coverage = exact, quote = "any position with respect to debt if")
rule ExcludedDebtPositionRule(pos: AppreciatedFinancialPosition) strict {
    label en official "section 1259(b)(2)(A): a fixed-principal, qualifying-interest, non-convertible debt position is excluded";
    when debt_position_unconditionally_entitles_specified_principal(pos);
    when interest_meets_860G_a1B_i(pos);
    when not_known(convertible_into_stock_of_issuer_or_related(pos));
    then excluded_debt_position_1259b2A(pos);
}
pub relation hedge_of_excluded_debt_position(pos: AppreciatedFinancialPosition, debt_pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(b)(2)(B): a hedge with respect to a position described in subparagraph (A)";
}
pub relation position_marked_to_market_under_title(pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(b)(2)(C): a position marked to market under any provision of the title or regulations";
}
pub relation excluded_from_1259_1259b2(pos: AppreciatedFinancialPosition) kind institutional {
    label en official "section 1259(b)(2): the position is not an appreciated financial position (excluded debt, a hedge of it, or a marked-to-market position)";
}
@source(IRC_S1259_B, relation = formalizes, coverage = exact, quote = "any position which is marked to market under any provision of this title or the regulations thereunder")
rule ExcludedMarkedToMarketRule(pos: AppreciatedFinancialPosition) strict {
    label en official "section 1259(b)(2)(C): a marked-to-market position is excluded";
    when position_marked_to_market_under_title(pos);
    then excluded_from_1259_1259b2(pos);
}
@source(IRC_S1259_B, relation = formalizes, coverage = exact, quote = "any hedge with respect to a position described in subparagraph (A)")
rule ExcludedHedgeRule(pos: AppreciatedFinancialPosition, debt_pos: AppreciatedFinancialPosition) strict {
    label en official "section 1259(b)(2)(B): a hedge of an excluded debt position is excluded";
    when hedge_of_excluded_debt_position(pos, debt_pos);
    when excluded_debt_position_1259b2A(debt_pos);
    then excluded_from_1259_1259b2(pos);
}
rule ExcludedDebtRule(pos: AppreciatedFinancialPosition) strict {
    label en official "section 1259(b)(2)(A): an excluded debt position is excluded";
    when excluded_debt_position_1259b2A(pos);
    then excluded_from_1259_1259b2(pos);
}

// =============================================================================
// Section 1259(c)(4): related persons
// =============================================================================

pub relation relationship_described_in_267b_or_707b(p: Person, q: Person) kind empirical {
    label en official "section 1259(c)(4)(A): the relationship is described in section 267(b) or 707(b)";
}
pub relation transaction_entered_with_view_to_avoiding_1259(t: Transaction) kind empirical {
    label en official "section 1259(c)(4)(B): the transaction is entered into with a view toward avoiding the purposes of this section (an evidentiary fact adjudicated on the case)";
}
pub relation related_person_for_1259c4(p: Person, q: Person, t: Transaction) kind institutional {
    label en official "section 1259(c)(4): q is related to p with respect to the transaction";
}
@source(IRC_S1259_C, relation = formalizes, coverage = exact, quote = "such transaction is entered into with a view toward avoiding the purposes of this section")
rule RelatedPersonRule(p: Person, q: Person, t: Transaction) strict {
    label en official "section 1259(c)(4): a 267(b)/707(b) relationship plus an avoidance purpose makes a related person";
    when relationship_described_in_267b_or_707b(p, q);
    when transaction_entered_with_view_to_avoiding_1259(t);
    then related_person_for_1259c4(p, q, t);
}
pub relation related_person_enters_qualifying_transaction(q: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) kind empirical {
    label en official "section 1259(c)(1)(A)-(D): a related person enters into a short sale, notional principal contract, futures or forward, or acquisition of the same or substantially identical property";
}
@source(IRC_S1259_C, relation = formalizes, coverage = exact, quote = "A taxpayer shall be treated as having made a constructive sale of an appreciated financial position if the taxpayer (or a related person)")
rule ConstructiveSaleByRelatedPersonRule(p: Person, q: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) strict {
    label en official "section 1259(c)(1): a qualifying transaction of a related person is a constructive-sale transaction of the taxpayer";
    when related_person_enters_qualifying_transaction(q, pos, t, on);
    when related_person_for_1259c4(p, q, t);
    then constructive_sale_transaction(p, pos, t, on);
}

// =============================================================================
// Section 1259(a)(2): basis and holding period after the constructive sale
// =============================================================================

pub relation gain_realized_later_on_position(p: Person, pos: AppreciatedFinancialPosition, amount: Money) kind empirical {
    label en official "section 1259(a)(2)(A): the gain or loss subsequently realized with respect to the position";
}
pub relation adjusted_subsequent_gain_1259a2A(p: Person, pos: AppreciatedFinancialPosition, amount: Money) kind institutional {
    label en official "section 1259(a)(2)(A): the subsequently realized gain or loss adjusted for the gain taken into account by reason of paragraph (1)";
}
@source(IRC_S1259_A, relation = formalizes, coverage = exact, quote = "proper adjustment shall be made in the amount of any gain or loss subsequently realized with respect to such position for any gain taken into account by reason of paragraph (1)")
rule SubsequentGainAdjustedRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, realized: Money, taken: Money) defeasible {
    label en official "section 1259(a)(2)(A): the later realized gain is reduced by the gain already taken into account";
    when gain_realized_later_on_position(p, pos, realized);
    when section_1259_gain_recognized(p, pos, t, taken);
    then adjusted_subsequent_gain_1259a2A(p, pos, realized - taken);
}
pub relation position_holding_period_start_1259a2B(p: Person, pos: AppreciatedFinancialPosition, start: Date) kind institutional {
    label en official "section 1259(a)(2)(B): the holding period is determined as if the position were originally acquired on the date of the constructive sale";
}
@source(IRC_S1259_A, relation = formalizes, coverage = exact, quote = "the holding period of such position shall be determined as if such position were originally acquired on the date of such constructive sale")
rule PositionHoldingPeriodRestartRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) defeasible {
    label en official "section 1259(a)(2)(B): the holding period restarts on the constructive-sale date";
    when constructive_sale_of_appreciated_financial_position(p, pos, t, on);
    then position_holding_period_start_1259a2B(p, pos, on);
}

// =============================================================================
// Section 1259(e): special rules
// =============================================================================

pub relation position_disposed_assigned_or_terminated_on(pos: AppreciatedFinancialPosition, on: Date) kind empirical {
    label en official "section 1259(e)(1)(B): the position is subsequently disposed of (an assignment or other termination is a disposition)";
}
pub relation constructive_sale_transaction_open_at_disposition(t: Transaction) kind empirical {
    label en official "section 1259(e)(1)(C): at the time of the disposition the transaction resulting in the constructive sale is open with respect to the taxpayer or any related person";
}
pub relation transaction_would_cause_constructive_sale_of_other_position(t: Transaction, other: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(e)(1): the transaction would cause a constructive sale of the other appreciated financial position (same or substantially identical property)";
}
pub relation reentered_constructive_sale_1259e1(p: Person, other: AppreciatedFinancialPosition, t: Transaction, on: Date) kind institutional {
    label en official "section 1259(e)(1): solely to test a constructive sale of another position, the taxpayer is treated as entering the transaction immediately after the disposition (one re-entry level)";
}
@source(IRC_S1259_E, relation = formalizes, coverage = exact, quote = "the taxpayer shall be treated as entering into such transaction immediately after such disposition")
rule ReentryRule(p: Person, pos: AppreciatedFinancialPosition, other: AppreciatedFinancialPosition, t: Transaction, on: Date, disposed_on: Date) defeasible {
    label en official "section 1259(e)(1): a still-open constructive-sale transaction is treated as re-entered upon the disposition of the position";
    when constructive_sale_of_appreciated_financial_position(p, pos, t, on);
    when position_disposed_assigned_or_terminated_on(pos, disposed_on);
    when constructive_sale_transaction_open_at_disposition(t);
    when transaction_would_cause_constructive_sale_of_other_position(t, other);
    then reentered_constructive_sale_1259e1(p, other, t, disposed_on);
}
pub relation constructive_sale_by_reentry_1259e1(p: Person, other: AppreciatedFinancialPosition, t: Transaction, on: Date) kind institutional {
    label en official "section 1259(e)(1): the re-entered transaction is a constructive sale of the other position (subject to the same exceptions)";
}
rule ReentryConstructiveSaleRule(p: Person, other: AppreciatedFinancialPosition, t: Transaction, on: Date) defeasible {
    label en official "section 1259(e)(1): a re-entered transaction constructively sells the other position unless excluded";
    when reentered_constructive_sale_1259e1(p, other, t, on);
    when not_known(excluded_from_1259_1259b2(other));
    then constructive_sale_by_reentry_1259e1(p, other, t, on);
}
rule ReentryGainRecognizedRule(p: Person, other: AppreciatedFinancialPosition, t: Transaction, on: Date, amount: Money) defeasible {
    label en official "section 1259(a)(1): the re-entered constructive sale recognizes the built-in gain of the other position";
    when constructive_sale_by_reentry_1259e1(p, other, t, on);
    when would_produce_gain_at_fmv(p, other, amount);
    then section_1259_gain_recognized(p, other, t, amount);
}

pub relation interest_in_actively_traded_trust_1092d1(pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(e)(2): an interest in a trust which is actively traded (within the meaning of section 1092(d)(1))";
}
pub relation trust_holds_substantially_all_excluded_debt(pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(e)(2): substantially all (by value) of the property held by the trust is debt described in subsection (b)(2)(A)";
}
pub relation trust_interest_treated_as_stock_1259e2(pos: AppreciatedFinancialPosition) kind institutional {
    label en official "section 1259(e)(2): the trust interest is treated as stock";
}
@source(IRC_S1259_E, relation = formalizes, coverage = exact, quote = "shall be treated as stock unless substantially all (by value) of the property held by the trust is debt described in subsection (b)(2)(A)")
rule TrustInterestAsStockRule(pos: AppreciatedFinancialPosition) strict {
    label en official "section 1259(e)(2): an actively traded trust interest is stock unless substantially all the trust property is excluded debt";
    when interest_in_actively_traded_trust_1092d1(pos);
    when not_known(trust_holds_substantially_all_excluded_debt(pos));
    then trust_interest_treated_as_stock_1259e2(pos);
}

pub relation actual_sale_identification_selects_position(t: Transaction, pos: AppreciatedFinancialPosition) kind empirical {
    label en official "section 1259(e)(3): the position that an actual sale would be treated as selling, under the ordinary identification rules";
}
pub relation position_deemed_sold_1259e3(p: Person, pos: AppreciatedFinancialPosition, t: Transaction) kind institutional {
    label en official "section 1259(e)(3): with multiple positions, the position deemed sold is determined in the same manner as actual sales";
}
@source(IRC_S1259_E, relation = formalizes, coverage = exact, quote = "shall be made in the same manner as actual sales")
rule PositionDeemedSoldRule(p: Person, pos: AppreciatedFinancialPosition, t: Transaction, on: Date) defeasible {
    label en official "section 1259(e)(3): the deemed-sold position is the one an actual sale would identify";
    when constructive_sale_of_appreciated_financial_position(p, pos, t, on);
    when actual_sale_identification_selects_position(t, pos);
    then position_deemed_sold_1259e3(p, pos, t);
}
