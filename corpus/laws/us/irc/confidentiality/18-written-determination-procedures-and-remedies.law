// 26 U.S.C. §6110(b)(3), (d)-(m) — the remainder of public inspection of written determinations:
// reference and general determinations, third-party contact notations, background file documents,
// the notice of intention to disclose and the Tax Court and District Court actions (petitions are
// POWERS of the petitioner with the statutory windows; the notices are duties of the Secretary with
// their windows; the Secretary's protection after notice is an immunity), the postponement and
// special-rule periods of (g)(2)-(5), prior determinations (h), Chief Counsel advice (i), civil
// remedies and damages (j), fees, record disposal and precedent (k), the exclusions (l), and the
// exclusive remedy (m). STAGE 2 (module 08 carries (a), (b)(1)-(2), (c), (g)(1)). The postponement
// periods of (g)(2)-(4) add candidate dates to the stage-1 `written_determination_open_on_candidate`,
// so the stage-1 "if later" rule chooses among them (no maximum term). Amount and date facts the
// text leaves to the Secretary or to court order are case facts.

use self::{
    BackgroundFileDocument,
    DistrictCourt,
    IRC_S6110_B,
    IRC_S6110_D,
    IRC_S6110_E,
    IRC_S6110_F,
    IRC_S6110_G,
    IRC_S6110_H,
    IRC_S6110_I,
    IRC_S6110_J,
    IRC_S6110_K,
    IRC_S6110_L,
    IRC_S6110_M,
    IRS,
    Organ,
    Person,
    Secretary,
    TaxCourt,
    WrittenDetermination,
    background_file_document_of,
    matter_excluded_from_written_determination,
    notice_of_intention_mailed_on,
    restrain_disclosure_petition_decided,
    written_determination_open_latest_no_petition,
    written_determination_open_on_candidate,
    written_determination_open_to_inspection,
};

pub relation is_written_determination(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the document is a ruling, determination letter, technical advice memorandum, or Chief Counsel advice within the meaning of section 6110(b)(1)";
}

external judgment relation secretary_determines_wd_has_significant_reference_value(wd: WrittenDetermination) {
    authority Secretary;
    label en official "the Secretary determines that the written determination has significant reference value — section 6110(b)(3)(A)";
}

pub relation reference_written_determination(wd: WrittenDetermination) kind institutional {
    label en unofficial "the written determination is a \"reference written determination\" within the meaning of section 6110(b)(3)(A)";
}

pub relation general_written_determination(wd: WrittenDetermination) kind institutional {
    label en unofficial "the written determination is a \"general written determination\" within the meaning of section 6110(b)(3)(B)";
}

@source(IRC_S6110_B, relation = formalizes, coverage = exact, quote = "The term \"reference written determination\" means any written determination which has been determined by the Secretary to have significant reference value.")
rule S6110B3AReferenceWrittenDetermination strict {
    for wd: WrittenDetermination;
    when is_written_determination(wd)
        and not_known(matter_excluded_from_written_determination(wd))
        and secretary_determines_wd_has_significant_reference_value(wd);
    then reference_written_determination(wd);
}

@source(IRC_S6110_B, relation = formalizes, coverage = exact, quote = "The term \"general written determination\" means any written determination other than a reference written determination.")
rule S6110B3BGeneralWrittenDetermination strict {
    for wd: WrittenDetermination;
    when is_written_determination(wd)
        and not_known(matter_excluded_from_written_determination(wd))
        and not_known(reference_written_determination(wd));
    then general_written_determination(wd);
}

pub relation matter_to_which_section_6104_or_6105_applies(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the matter is one to which section 6104 or 6105 applies — section 6110(l)(1)";
}

pub relation wd_request_made_on(wd: WrittenDetermination, requestedOn: Date) kind empirical {
    label en unofficial "case fact: the request for the written determination was made on this date";
}

pub relation wd_concerns_exempt_or_foundation_status(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the written determination concerns the exempt status under section 501(a) of an organization described in section 501(c) or (d), its status as a private foundation under section 509(a), or as an operating foundation under section 4942(j)(3) — section 6110(l)(2)(A)";
}

pub relation wd_described_in_g5b(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the general written determination relates solely to approval of the adoption or change of a funding method or plan year (section 412), an annual accounting period (section 442), a method of accounting (section 446(e)), or a partnership's or partner's taxable year (section 706) — section 6110(g)(5)(B)";
}

pub relation wd_is_determination_letter(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the written determination is a determination letter";
}

pub relation wd_is_background_file_document_of_general_wd_issued_on(wd: WrittenDetermination, generalIssuedOn: Date) kind empirical {
    label en unofficial "case fact: the document is a background file document relating to a general written determination issued on this date";
}

pub relation wd_is_6104a1biv_letter_or_document_issued_on(wd: WrittenDetermination, issuedOn: Date) kind empirical {
    label en unofficial "case fact: the document is a letter or other document described in section 6104(a)(1)(B)(iv) issued on this date";
}

pub relation excluded_from_section_6110(wd: WrittenDetermination) kind institutional {
    label en unofficial "the section 6110 does not apply to this document (section 6110(l))";
}

@source(IRC_S6110_L, relation = formalizes, coverage = exact, quote = "(1) any matter to which section 6104 or 6105 applies, or")
rule S6110L1ExcludedMatter strict {
    for wd: WrittenDetermination;
    when matter_to_which_section_6104_or_6105_applies(wd);
    then excluded_from_section_6110(wd);
}

@source(IRC_S6110_L, relation = formalizes, coverage = partial, quote = "(A) written determination issued pursuant to a request made before November 1, 1976, with respect to the exempt status under section 501(a) of an organization described in section 501(c) or (d), the status of an organization as a private foundation")
rule S6110L2AExcludedPre1976ExemptStatus strict {
    for wd: WrittenDetermination;
    for requestedOn: Date;
    when wd_concerns_exempt_or_foundation_status(wd)
        and wd_request_made_on(wd, requestedOn)
        and requestedOn < @1976-11-01;
    then excluded_from_section_6110(wd);
}

@source(IRC_S6110_L, relation = formalizes, coverage = partial, quote = "(B) written determination described in subsection (g)(5)(B) issued pursuant to a request made before November 1, 1976,")
rule S6110L2BExcludedPre1976G5b strict {
    for wd: WrittenDetermination;
    for requestedOn: Date;
    when wd_described_in_g5b(wd)
        and wd_request_made_on(wd, requestedOn)
        and requestedOn < @1976-11-01;
    then excluded_from_section_6110(wd);
}

@source(IRC_S6110_L, relation = formalizes, coverage = partial, quote = "(C) determination letter not otherwise described in subparagraph (A), (B), or (E) issued pursuant to a request made before November 1, 1976,")
rule S6110L2CExcludedPre1976DeterminationLetter strict {
    for wd: WrittenDetermination;
    for requestedOn: Date;
    when wd_is_determination_letter(wd)
        and not_known(wd_concerns_exempt_or_foundation_status(wd))
        and not_known(wd_described_in_g5b(wd))
        and wd_request_made_on(wd, requestedOn)
        and requestedOn < @1976-11-01;
    then excluded_from_section_6110(wd);
}

@source(IRC_S6110_L, relation = formalizes, coverage = partial, quote = "(D) background file document relating to any general written determination issued before July 5, 1967, or")
rule S6110L2DExcludedBackgroundOfPre1967GeneralDetermination strict {
    for wd: WrittenDetermination;
    for generalIssuedOn: Date;
    when wd_is_background_file_document_of_general_wd_issued_on(wd, generalIssuedOn)
        and generalIssuedOn < @1967-07-05;
    then excluded_from_section_6110(wd);
}

@source(IRC_S6110_L, relation = formalizes, coverage = partial, quote = "(E) letter or other document described in section 6104(a)(1)(B)(iv) issued before September 2, 1974 .")
rule S6110L2EExcludedPre1974LetterOrDocument strict {
    for wd: WrittenDetermination;
    for issuedOn: Date;
    when wd_is_6104a1biv_letter_or_document_issued_on(wd, issuedOn)
        and issuedOn < @1974-09-02;
    then excluded_from_section_6110(wd);
}

pub relation prior_written_determination_described_in_h1(wd: WrittenDetermination) kind institutional {
    label en unofficial "the written determination was issued pursuant to a request made before November 1, 1976 and is open or available under subsection (h)";
}

@source(IRC_S6110_H, relation = formalizes, coverage = partial, quote = "Except as otherwise provided in this subsection, a written determination issued pursuant to a request made before November 1, 1976, and any background file document relating to such written determination shall be open or available to public")
rule S6110H1PriorWrittenDetermination strict {
    for wd: WrittenDetermination;
    for requestedOn: Date;
    when wd_request_made_on(wd, requestedOn)
        and requestedOn < @1976-11-01
        and not_known(excluded_from_section_6110(wd));
    then prior_written_determination_described_in_h1(wd);
}

pub entity ThirdPartyCommunication {
    label en unofficial "a communication (written or otherwise) the Internal Revenue Service receives before the issuance of a written determination — section 6110(d)(1)"; 
}

pub relation communication_concerning_wd_before_issuance(comm: ThirdPartyCommunication, wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Internal Revenue Service received the communication before issuance of the written determination, concerning it, a request for it, or any other matter involving it";
}

pub relation communication_from_person_other_than_irs_employee_or_taxpayer_or_representative(comm: ThirdPartyCommunication) kind empirical {
    label en unofficial "case fact: the person making the communication is other than an employee of the Internal Revenue Service or the person to whom the written determination pertains (or his authorized representative)";
}

pub relation communication_made_by_chief_of_staff_of_joint_committee_on_taxation(comm: ThirdPartyCommunication) kind empirical {
    label en unofficial "case fact: the communication was made by the Chief of Staff of the Joint Committee on Taxation — section 6110(d)(2)";
}

pub relation notation_of_category_and_date_indicated_on_open_determination(comm: ThirdPartyCommunication) kind empirical {
    label en unofficial "case fact: the Internal Revenue Service indicated on the written determination open to public inspection the category of the person making the communication and the date of the communication";
}

@source(IRC_S6110_D, relation = formalizes, coverage = exact, quote = "If, before the issuance of a written determination, the Internal Revenue Service receives any communication (written or otherwise) concerning such written determination, any request for such determination, or any other matter involving such written determination from a person other than an employee of the Internal Revenue Service or the person to whom such written determination pertains (or his")
rule S6110D1NotationDutyRule defeasible {
    for comm: ThirdPartyCommunication;
    for wd: WrittenDetermination;
    when communication_concerning_wd_before_issuance(comm, wd)
        and communication_from_person_other_than_irs_employee_or_taxpayer_or_representative(comm);
    then duty S6110D1NotationDuty {
        bearer IRS;
        goal achievement {
            condition notation_of_category_and_date_indicated_on_open_determination(comm);
            window [-infinity, infinity];
        }
    };
    unless communication_made_by_chief_of_staff_of_joint_committee_on_taxation(comm)
        and communication_concerning_wd_before_issuance(comm, wd);
    unless prior_written_determination_described_in_h1(wd)
        and communication_concerning_wd_before_issuance(comm, wd);
    unless excluded_from_section_6110(wd)
        and communication_concerning_wd_before_issuance(comm, wd);
}

pub relation wd_first_open_to_public_inspection_on(wd: WrittenDetermination, firstOpenOn: Date) kind empirical {
    label en unofficial "case fact: the first day the written determination is open to public inspection";
}

pub relation identity_disclosure_petition_filed(wd: WrittenDetermination, petitioner: Person) kind empirical {
    label en unofficial "case fact: the person filed a petition in the United States Tax Court or a complaint in the United States District Court for the District of Columbia for an order requiring that the identity of any person to whom the written determination pertains be disclosed";
}

pub relation wd_subject_to_third_party_notation_rule(wd: WrittenDetermination) kind institutional {
    label en unofficial "the written determination is one to which paragraph (1) applies (a third-party communication before issuance requires a notation)";
}

@source(IRC_S6110_D, relation = formalizes, coverage = partial, quote = "In the case of any written determination to which paragraph (1) applies, any person may file a")
rule S6110D3ProvisionAppliesClassification strict {
    for wd: WrittenDetermination;
    for comm: ThirdPartyCommunication;
    when communication_concerning_wd_before_issuance(comm, wd)
        and communication_from_person_other_than_irs_employee_or_taxpayer_or_representative(comm)
        and not_known(communication_made_by_chief_of_staff_of_joint_committee_on_taxation(comm))
        and not_known(prior_written_determination_described_in_h1(wd));
    then wd_subject_to_third_party_notation_rule(wd);
}

pub relation identity_disclosure_proceeding_pending(wd: WrittenDetermination, petitioner: Person) kind institutional {
    label en unofficial "a proceeding under section 6110(d)(3) is pending";
}

@source(IRC_S6110_D, relation = formalizes, coverage = partial, quote = "In the case of any written determination to which paragraph (1) applies, any person may file a petition in the United States Tax Court or file a complaint in the United States District Court for the District of Columbia for an order requiring that the")
@source(IRC_S6110_D, relation = formalizes, coverage = exact, quote = "No proceeding shall be commenced under paragraph (3) unless a petition is filed before the expiration of 36 months after the first day that the written determination is open to public inspection.")
rule S6110D3IdentityPetitionPowerRule strict {
    for wd: WrittenDetermination;
    for petitioner: Person;
    for firstOpenOn: Date;
    when wd_first_open_to_public_inspection_on(wd, firstOpenOn)
        and identity_disclosure_petition_filed(wd, petitioner);
    then power S6110D3IdentityPetitionPower {
        holder petitioner;
        over Secretary;
        exercise identity_disclosure_petition_filed(wd, petitioner);
        valid_when wd_subject_to_third_party_notation_rule(wd);
        effect create(identity_disclosure_proceeding_pending(wd, petitioner));
        window [firstOpenOn, add_calendar_period(firstOpenOn, 36 calendar_month)];
    };
}

external judgment relation record_evidence_supports_reasonable_conclusion_of_impropriety_or_undue_influence(wd: WrittenDetermination) {
    authority DistrictCourt;
    label en official "there is evidence in the record from which one could reasonably conclude that an impropriety occurred or undue influence was exercised with respect to the written determination by or on behalf of the person — section 6110(d)(3), second sentence";
}

pub relation court_orders_disclosure_of_identity(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the court ordered that the identity of the person to whom the written determination pertains be disclosed";
}

@source(IRC_S6110_D, relation = formalizes, coverage = partial, quote = "The court shall order disclosure of such identity if there is evidence in the record from which one could reasonably conclude that an impropriety occurred or undue influence was exercised with respect to such written determination by or on behalf of such person.")
rule S6110D3CourtOrderDutyRule strict {
    for wd: WrittenDetermination;
    for petitioner: Person;
    when identity_disclosure_proceeding_pending(wd, petitioner)
        and record_evidence_supports_reasonable_conclusion_of_impropriety_or_undue_influence(wd);
    then duty S6110D3CourtOrderDuty {
        bearer DistrictCourt;
        beneficiary petitioner;
        goal achievement {
            condition court_orders_disclosure_of_identity(wd);
            window [-infinity, infinity];
        }
    };
}

pub relation background_file_document_requested_in_writing_by(doc: BackgroundFileDocument, requester: Person) kind empirical {
    label en unofficial "case fact: the person requested in writing the background file document relating to a written determination that is open to public inspection";
}

pub relation background_file_document_made_available_to(doc: BackgroundFileDocument, requester: Person) kind empirical {
    label en unofficial "case fact: the Secretary made the background file document available to the requester";
}

@source(IRC_S6110_E, relation = formalizes, coverage = exact, quote = "Whenever the Secretary makes a written determination open to public inspection under this section, he shall also make available to any person, but only upon the written request of that person, any background file document relating to the written determination.")
rule S6110EBackgroundFileDutyRule defeasible {
    for doc: BackgroundFileDocument;
    for wd: WrittenDetermination;
    for requester: Person;
    when background_file_document_of(doc, wd)
        and written_determination_open_to_inspection(wd)
        and background_file_document_requested_in_writing_by(doc, requester);
    then duty S6110EBackgroundFileDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition background_file_document_made_available_to(doc, requester);
            window [-infinity, infinity];
        }
    };
}

pub relation wd_pertains_to(wd: WrittenDetermination, person: Person) kind empirical {
    label en unofficial "case fact: the written determination pertains to this person (or the person is a successor in interest, executor, or other person authorized by law to act for him)";
}

pub relation wd_issued_or_background_document_request_received_on(wd: WrittenDetermination, onDate: Date) kind empirical {
    label en unofficial "case fact: the written determination was issued, or a request for a background file document was received, on this date";
}

pub relation notice_of_intention_to_disclose_mailed(wd: WrittenDetermination) kind institutional {
    label en unofficial "the notice of intention to disclose was mailed";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "Except as otherwise provided by subsection (i), the Secretary shall upon issuance of any written determination, or upon receipt of a request for a background file document, mail a notice of intention")
rule S6110F1NoticeMailedClassification strict {
    for wd: WrittenDetermination;
    for mailedOn: Date;
    when notice_of_intention_mailed_on(wd, mailedOn);
    then notice_of_intention_to_disclose_mailed(wd);
}

pub relation wd_is_nontaxpayer_specific_chief_counsel_advice(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Chief Counsel advice is written without reference to a specific taxpayer or group of specific taxpayers — section 6110(i)(4)(A)";
}

@source(IRC_S6110_F, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by subsection (i), the Secretary shall upon issuance of any written determination, or upon receipt of a request for a background file document, mail a notice of intention to disclose such determination or document to any person to whom the written determination pertains (or a successor in interest, executor, or other person authorized by law to act for or on behalf of")
rule S6110F1NoticeDutyRule defeasible {
    for wd: WrittenDetermination;
    for person: Person;
    for onDate: Date;
    when wd_pertains_to(wd, person)
        and wd_issued_or_background_document_request_received_on(wd, onDate);
    then duty S6110F1NoticeDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition notice_of_intention_to_disclose_mailed(wd);
            window [onDate, infinity);
        }
    };
    unless wd_is_nontaxpayer_specific_chief_counsel_advice(wd)
        and wd_pertains_to(wd, person)
        and wd_issued_or_background_document_request_received_on(wd, onDate);
    unless excluded_from_section_6110(wd)
        and wd_pertains_to(wd, person)
        and wd_issued_or_background_document_request_received_on(wd, onDate);
}

pub relation regulations_establishing_administrative_remedies_prescribed(secretary: Organ) kind empirical {
    label en unofficial "case fact: the Secretary has prescribed regulations establishing administrative remedies with respect to requests for additional disclosure of any written determination or background file document and requests to restrain disclosure";
}

@source(IRC_S6110_F, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe regulations establishing administrative remedies with respect to—")
rule S6110F2RemediesRegulationsDutyRule strict {
    then duty S6110F2RemediesRegulationsDuty {
        bearer Secretary;
        goal achievement {
            condition regulations_establishing_administrative_remedies_prescribed(Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation petitioner_has_direct_interest_or_is_person_to_whom_wd_pertains(wd: WrittenDetermination, petitioner: Person) kind empirical {
    label en unofficial "case fact: the petitioner is a person to whom the written determination pertains (or a successor, executor, or other authorized person), or has a direct interest in maintaining the confidentiality of the written determination or background file document (or portion) — section 6110(f)(3)(A)(i)";
}

pub relation petitioner_disagrees_with_failure_to_make_deletion(wd: WrittenDetermination, petitioner: Person) kind empirical {
    label en unofficial "case fact: the petitioner disagrees with a failure to make a deletion with respect to the portion of the written determination or background file document which is to be open or available to public inspection — (A)(ii)";
}

pub relation petitioner_exhausted_administrative_remedies_under_f2(wd: WrittenDetermination, petitioner: Person) kind empirical {
    label en unofficial "case fact: the petitioner has exhausted his administrative remedies prescribed under paragraph (2) — (A)(iii) and (4)(A)";
}

pub relation eligible_to_petition_to_restrain_disclosure(wd: WrittenDetermination, petitioner: Person) kind institutional {
    label en unofficial "the petitioner meets each of the three requirements of section 6110(f)(3)(A)(i)-(iii)";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "(i) to whom a written determination pertains (or a successor in interest, executor, or other person authorized by law to act for or on behalf of such person), or who has a direct interest in maintaining the confidentiality of any such written determination or")
@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "(ii) who disagrees with any failure to make a deletion with respect to that portion of any written determination or any background file document which is to be open or available to public inspection, and")
@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "(iii) who has exhausted his administrative remedies as prescribed pursuant to paragraph (2),")
rule S6110F3AEligiblePetitionerClassification strict {
    for wd: WrittenDetermination;
    for petitioner: Person;
    when petitioner_has_direct_interest_or_is_person_to_whom_wd_pertains(wd, petitioner)
        and petitioner_disagrees_with_failure_to_make_deletion(wd, petitioner)
        and petitioner_exhausted_administrative_remedies_under_f2(wd, petitioner);
    then eligible_to_petition_to_restrain_disclosure(wd, petitioner);
}

pub relation restrain_disclosure_petition_filed(wd: WrittenDetermination, petitioner: Person) kind empirical {
    label en unofficial "case fact: the person filed the petition in the United States Tax Court (anonymously, if appropriate) for a determination with respect to the portion of the written determination or background file document which is to be open to public inspection";
}

pub relation restrain_petition_pending(wd: WrittenDetermination, petitioner: Person) kind institutional {
    label en unofficial "a petition under section 6110(f)(3) is pending";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "Any person—")
@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "may, within 60 days after the mailing by the Secretary of a notice of intention to disclose any written determination or background file document under paragraph (1), together with the proposed deletions, file a petition in the United States Tax Court (anonymously, if appropriate) for a determination with respect to that portion of such written determination or background file document which is")
rule S6110F3APetitionPowerRule strict {
    for wd: WrittenDetermination;
    for petitioner: Person;
    for mailedOn: Date;
    when notice_of_intention_mailed_on(wd, mailedOn)
        and restrain_disclosure_petition_filed(wd, petitioner);
    then power S6110F3APetitionPower {
        holder petitioner;
        over TaxCourt;
        exercise restrain_disclosure_petition_filed(wd, petitioner);
        valid_when eligible_to_petition_to_restrain_disclosure(wd, petitioner);
        effect create(restrain_petition_pending(wd, petitioner));
        window [mailedOn, add_calendar_period(mailedOn, 60 calendar_day)];
    };
}

pub relation f3_petition_served_on_secretary_on(wd: WrittenDetermination, servedOn: Date) kind empirical {
    label en unofficial "case fact: the petition under paragraph (3) was served on the Secretary on this date";
}

pub relation f3_notice_of_petition_sent_by_registered_or_certified_mail_to_last_known_address_on(wd: WrittenDetermination, person: Person, sentOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary sent the notice of the filing of the petition to the person by registered or certified mail to his last known address on this date";
}

pub relation f3_petition_notice_timely(wd: WrittenDetermination, person: Person) kind institutional {
    label en unofficial "the notice of the petition was sent within 15 days after the petition was served on the Secretary";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "The Secretary shall send such notice by registered or certified mail to the last known address of such person within 15 days after such petition is served on the Secretary.")
rule S6110F3BNoticeTimelyClassification strict {
    for wd: WrittenDetermination;
    for person: Person;
    for servedOn: Date;
    for sentOn: Date;
    when f3_petition_served_on_secretary_on(wd, servedOn)
        and f3_notice_of_petition_sent_by_registered_or_certified_mail_to_last_known_address_on(wd, person, sentOn)
        and sentOn <= add_calendar_period(servedOn, 15 calendar_day);
    then f3_petition_notice_timely(wd, person);
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "The Secretary shall notify any person to whom a written determination pertains (unless such person is the petitioner) of the filing of a petition under this paragraph with respect to such written determination or related background file document, and any such")
rule S6110F3BNoticeDutyRule strict {
    for wd: WrittenDetermination;
    for person: Person;
    for petitioner: Person;
    for servedOn: Date;
    when wd_pertains_to(wd, person)
        and restrain_petition_pending(wd, petitioner)
        and f3_petition_served_on_secretary_on(wd, servedOn)
        and person != petitioner;
    then duty S6110F3BNoticeDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition f3_petition_notice_timely(wd, person);
            window [servedOn, add_calendar_period(servedOn, 15 calendar_day)];
        }
    };
}

pub relation f3_notice_of_petition_received_by(wd: WrittenDetermination, person: Person) kind empirical {
    label en unofficial "case fact: the person received the notice of the filing of the petition";
}

pub relation person_filed_petition_after_receiving_notice(wd: WrittenDetermination, person: Person) kind empirical {
    label en unofficial "case fact: the person who received the notice thereafter filed a petition under paragraph (3) with respect to the written determination or background file document";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "No person who has received such a notice may thereafter file any petition under this paragraph with respect to such written determination or background file document with respect to which such notice was received.")
rule S6110F3BNoLaterPetitionRule strict {
    for wd: WrittenDetermination;
    for person: Person;
    when f3_notice_of_petition_received_by(wd, person);
    then prohibition S6110F3BNoLaterPetition {
        bearer person;
        action person_filed_petition_after_receiving_notice(wd, person);
        window [-infinity, infinity];
    };
}

pub relation person_intervenes_in_f3_proceeding(wd: WrittenDetermination, person: Person) kind empirical {
    label en unofficial "case fact: the person intervenes (anonymously, if appropriate) in the proceeding conducted under paragraph (3)";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "and any such person may intervene (anonymously, if appropriate) in any proceeding conducted pursuant to this paragraph.")
rule S6110F3BInterventionLibertyRule strict {
    for wd: WrittenDetermination;
    for person: Person;
    for petitioner: Person;
    when wd_pertains_to(wd, person)
        and restrain_petition_pending(wd, petitioner)
        and person != petitioner;
    then liberty S6110F3BInterventionLiberty {
        holder person;
        action person_intervenes_in_f3_proceeding(wd, person);
        window [-infinity, infinity];
    };
}

pub relation additional_disclosure_petition_filed(wd: WrittenDetermination, petitioner: Person) kind empirical {
    label en unofficial "case fact: the person filed a petition in the United States Tax Court or a complaint in the United States District Court for the District of Columbia for an order requiring that the written determination or background file document (or portion) be made open or available to public inspection";
}

pub relation additional_disclosure_petitioner_exhausted_remedies(wd: WrittenDetermination, petitioner: Person) kind empirical {
    label en unofficial "case fact: the petitioner has exhausted the administrative remedies prescribed under paragraph (2) with respect to a request for disclosure — section 6110(f)(4)(A)";
}

pub relation additional_disclosure_proceeding_pending(wd: WrittenDetermination, petitioner: Person) kind institutional {
    label en unofficial "a proceeding under section 6110(f)(4) is pending";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "Any person who has exhausted the administrative remedies prescribed pursuant to paragraph (2) with respect to a request for disclosure may file a petition in the United States Tax Court or a complaint in the United States District Court for the District of")
rule S6110F4APetitionPowerRule strict {
    for wd: WrittenDetermination;
    for petitioner: Person;
    when additional_disclosure_petition_filed(wd, petitioner);
    then power S6110F4APetitionPower {
        holder petitioner;
        over Secretary;
        exercise additional_disclosure_petition_filed(wd, petitioner);
        valid_when additional_disclosure_petitioner_exhausted_remedies(wd, petitioner);
        effect create(additional_disclosure_proceeding_pending(wd, petitioner));
    };
}

pub relation names_and_addresses_in_wd_persons(wd: WrittenDetermination, person: Person) kind empirical {
    label en unofficial "case fact: the person is identified by name and address in the written determination or background file document";
}

pub relation f4_notice_of_petition_served_on_secretary_on(wd: WrittenDetermination, servedOn: Date) kind empirical {
    label en unofficial "case fact: notice of the petition under subparagraph (A) was served on the Secretary on this date";
}

pub relation f4_notice_of_commencement_sent_on(wd: WrittenDetermination, person: Person, sentOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary sent notice of the commencement of the proceeding to the person by registered or certified mail to his last known address on this date";
}

pub relation f4_commencement_notice_timely(wd: WrittenDetermination, person: Person) kind institutional {
    label en unofficial "the notice of commencement was sent within 15 days after notice of the petition was served on the Secretary";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "If a proceeding is commenced under this paragraph with respect to any written determination or background file document, the Secretary shall, within 15 days after notice of the petition filed under subparagraph (A) is served on him, send notice of")
rule S6110F4BNoticeTimelyClassification strict {
    for wd: WrittenDetermination;
    for person: Person;
    for servedOn: Date;
    for sentOn: Date;
    when f4_notice_of_petition_served_on_secretary_on(wd, servedOn)
        and f4_notice_of_commencement_sent_on(wd, person, sentOn)
        and sentOn <= add_calendar_period(servedOn, 15 calendar_day);
    then f4_commencement_notice_timely(wd, person);
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "If a proceeding is commenced under this paragraph with respect to any written determination or background file document, the Secretary shall, within 15 days after notice of the petition filed under subparagraph (A) is served on him, send notice of the")
rule S6110F4BNoticeDutyRule strict {
    for wd: WrittenDetermination;
    for person: Person;
    for petitioner: Person;
    for servedOn: Date;
    when names_and_addresses_in_wd_persons(wd, person)
        and additional_disclosure_proceeding_pending(wd, petitioner)
        and f4_notice_of_petition_served_on_secretary_on(wd, servedOn);
    then duty S6110F4BNoticeDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition f4_commencement_notice_timely(wd, person);
            window [servedOn, add_calendar_period(servedOn, 15 calendar_day)];
        }
    };
}

pub relation secretary_liable_for_public_disclosure_per_final_decision(wd: WrittenDetermination) kind institutional {
    label en unofficial "the Secretary is liable for public disclosure of the written determination or background file document (or a portion) made in accordance with the final decision of the court";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "If such notice is sent, the Secretary shall not be required to defend the action and shall not be liable for public disclosure of the written determination or background file document (or any portion thereof) in accordance with the final decision of the court.")
rule S6110F4BSecretaryImmunityRule strict {
    for wd: WrittenDetermination;
    for person: Person;
    for petitioner: Person;
    for sentOn: Date;
    when additional_disclosure_proceeding_pending(wd, petitioner)
        and f4_notice_of_commencement_sent_on(wd, person, sentOn);
    then immunity S6110F4BSecretaryImmunity {
        holder Secretary;
        protected_effect create(secretary_liable_for_public_disclosure_per_final_decision(wd));
    };
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "Any person to whom such determination or background file document pertains may intervene in the proceeding (anonymously, if appropriate).")
rule S6110F4BInterventionLibertyRule strict {
    for wd: WrittenDetermination;
    for person: Person;
    for petitioner: Person;
    when wd_pertains_to(wd, person)
        and additional_disclosure_proceeding_pending(wd, petitioner);
    then liberty S6110F4BInterventionLiberty {
        holder person;
        action person_intervenes_in_f4_proceeding(wd, person);
        window [-infinity, infinity];
    };
}

pub relation person_intervenes_in_f4_proceeding(wd: WrittenDetermination, person: Person) kind empirical {
    label en unofficial "case fact: the person intervenes (anonymously, if appropriate) in the proceeding under paragraph (4)";
}

@source(IRC_S6110_F, relation = formalizes, coverage = partial, quote = "Notwithstanding sections 7458 and 7461, the Tax Court may, in order to preserve the anonymity, privacy, or confidentiality of any person under this section, provide by rules adopted under section 7453 that portions of hearings, testimony, evidence, and")
rule S6110F6TaxCourtClosedHearingsLibertyRule strict {
    for wd: WrittenDetermination;
    for petitioner: Person;
    when restrain_petition_pending(wd, petitioner);
    then liberty S6110F6TaxCourtClosedHearingsLiberty {
        holder TaxCourt;
        action tax_court_provides_by_rules_for_closed_hearings(wd);
        window [-infinity, infinity];
    };
}

pub relation tax_court_provides_by_rules_for_closed_hearings(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Tax Court provides by rules adopted under section 7453 that portions of hearings, testimony, evidence, and reports in connection with the proceeding may be closed to the public or to inspection by the public, to preserve anonymity, privacy, or confidentiality";
}

pub relation court_extension_ordered_until(wd: WrittenDetermination, until: Date) kind empirical {
    label en unofficial "case fact: the court extended the period referred to in paragraph (1)(B) until this date, for such time as it found necessary to allow the Secretary to comply with its decision";
}

pub relation court_extension_in_force(wd: WrittenDetermination) kind institutional {
    label en unofficial "a court extension of the section 6110(g)(1)(B) period is in force";
}

pub relation court_extension_order_made(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the court made the order extending the period";
}

@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "The court may extend the period referred to in paragraph (1)(B) for such time as the court finds necessary to allow the Secretary to comply with its decision.")
rule S6110G2CourtExtensionPowerRule strict {
    for wd: WrittenDetermination;
    when court_extension_order_made(wd);
    then power S6110G2CourtExtensionPower {
        holder DistrictCourt;
        over Secretary;
        exercise court_extension_order_made(wd);
        valid_when restrain_disclosure_petition_decided(wd);
        effect create(court_extension_in_force(wd));
    };
}

@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "The court may extend the period referred to in paragraph (1)(B) for such time as the court finds necessary to allow the Secretary to comply with its decision.")
rule S6110G2ExtendedOpenOnCandidate strict {
    for wd: WrittenDetermination;
    for until: Date;
    when court_extension_in_force(wd)
        and court_extension_ordered_until(wd, until);
    then written_determination_open_on_candidate(wd, until);
}

pub relation postponement_requested_in_writing_by(wd: WrittenDetermination, requester: Person) kind empirical {
    label en unofficial "case fact: the person by whom or on whose behalf the request for the written determination was made asked in writing for the postponement — section 6110(g)(3)";
}

pub relation requester_of_the_written_determination(wd: WrittenDetermination, requester: Person) kind empirical {
    label en unofficial "case fact: the person is the one by whom, or on whose behalf, the request for the written determination was made";
}

pub relation requester_status_established(wd: WrittenDetermination) kind institutional {
    label en unofficial "the person asking for postponement is the requesting party of the written determination";
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "At the written request of the person by whom or on whose behalf the request for the written determination was made, the period referred to in paragraph (1)(A) shall be extended (for not to exceed an")
rule S6110G3RequesterStatus strict {
    for wd: WrittenDetermination;
    for requester: Person;
    when postponement_requested_in_writing_by(wd, requester)
        and requester_of_the_written_determination(wd, requester);
    then requester_status_established(wd);
}

pub relation postponement_up_to_90_days_in_force(wd: WrittenDetermination) kind institutional {
    label en unofficial "the section 6110(g)(3) postponement (up to an additional 90 days) is in force";
}

@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "At the written request of the person by whom or on whose behalf the request for the written determination was made, the period referred to in paragraph (1)(A) shall be extended (for not to exceed an additional 90 days) until the day which is 15 days after the date of the Secretary's determination that the transaction set forth in the written determination has been completed.")
rule S6110G3PostponementPowerRule strict {
    for wd: WrittenDetermination;
    for requester: Person;
    when postponement_requested_in_writing_by(wd, requester);
    then power S6110G3PostponementPower {
        holder requester;
        over Secretary;
        exercise postponement_requested_in_writing_by(wd, requester);
        valid_when requester_status_established(wd);
        effect create(postponement_up_to_90_days_in_force(wd));
    };
}

pub relation transaction_completion_determined_on(wd: WrittenDetermination, determinedOn: Date) kind empirical {
    label en unofficial "case fact: the date of the Secretary's determination that the transaction set forth in the written determination has been completed";
}

pub relation postponed_candidate_min_of(wd: WrittenDetermination, candidate: Date) kind institutional {
    label en unofficial "a candidate end date of the section 6110(g)(3) period: 15 days after the Secretary's completion determination, or the cap of an additional 90 days";
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "At the written request of the person by whom or on whose behalf the request for the written determination was made, the period referred to in paragraph (1)(A) shall be extended (for not to exceed an additional 90 days) until the day which is 15 days after the date of the Secretary's determination")
rule S6110G3CandidateFifteenDaysAfterCompletion strict {
    for wd: WrittenDetermination;
    for determinedOn: Date;
    when postponement_up_to_90_days_in_force(wd)
        and transaction_completion_determined_on(wd, determinedOn);
    then postponed_candidate_min_of(wd, add_calendar_period(determinedOn, 15 calendar_day));
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "the period referred to in paragraph (1)(A) shall be extended (for not to exceed an additional 90 days)")
rule S6110G3CandidateCapNinetyDays strict {
    for wd: WrittenDetermination;
    for latest: Date;
    when postponement_up_to_90_days_in_force(wd)
        and written_determination_open_latest_no_petition(wd, latest);
    then postponed_candidate_min_of(wd, add_calendar_period(latest, 90 calendar_day));
}

pub relation earlier_postponed_candidate_exists(wd: WrittenDetermination, candidate: Date) kind institutional {
    label en unofficial "another section 6110(g)(3) candidate date for this written determination is strictly earlier than this one";
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "At the written request of the person by whom or on whose behalf the request for the written determination was made, the period referred to in paragraph (1)(A) shall be extended (for not to exceed an additional 90 days) until the day which is 15 days after the date of the Secretary's determination")
rule S6110G3EarlierCandidateExists strict {
    for wd: WrittenDetermination;
    for candidate: Date;
    for other: Date;
    when postponed_candidate_min_of(wd, candidate)
        and postponed_candidate_min_of(wd, other)
        and other < candidate;
    then earlier_postponed_candidate_exists(wd, candidate);
}

pub relation postponed_open_on(wd: WrittenDetermination, openOn: Date) kind institutional {
    label en unofficial "the written determination is open to public inspection on this date under a section 6110(g)(3) postponement: the earlier of 15 days after the completion determination and the 90-day cap";
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "At the written request of the person by whom or on whose behalf the request for the written determination was made, the period referred to in paragraph (1)(A) shall be extended (for not to exceed an additional 90 days) until the day which is 15 days after the date of the Secretary's determination")
rule S6110G3PostponedOpenOn defeasible {
    for wd: WrittenDetermination;
    for candidate: Date;
    when postponed_candidate_min_of(wd, candidate)
        and not_known(earlier_postponed_candidate_exists(wd, candidate));
    then postponed_open_on(wd, candidate);
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "At the written request of the person by whom or on whose behalf the request for the written determination was made, the period referred to in paragraph (1)(A) shall be extended (for not to exceed an additional 90 days) until the day which is 15 days after the date of the Secretary's determination")
rule S6110G3PostponedOpenOnCandidate defeasible {
    for wd: WrittenDetermination;
    for openOn: Date;
    when postponed_open_on(wd, openOn);
    then written_determination_open_on_candidate(wd, openOn);
}

external judgment relation requester_establishes_to_the_satisfaction_of_the_secretary_good_cause_for_additional_delay(wd: WrittenDetermination) {
    authority Secretary;
    label en official "the person by whom or on whose behalf the request for the written determination was made establishes to the satisfaction of the Secretary that good cause exists for additional delay in opening the written determination to public inspection — section 6110(g)(4)(B)";
}

pub relation transaction_not_completed_during_period_of_paragraph_3(wd: WrittenDetermination) kind institutional {
    label en unofficial "the transaction set forth in the written determination was not completed during the period set forth in paragraph (3)";
}

@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(A) the transaction set forth in the written determination is not completed during the period set forth in paragraph (3), and")
rule S6110G4ATransactionNotCompleted defeasible {
    for wd: WrittenDetermination;
    for capEnd: Date;
    for determinedOn: Date;
    when postponed_open_on(wd, capEnd)
        and transaction_completion_determined_on(wd, determinedOn)
        and determinedOn > capEnd;
    then transaction_not_completed_during_period_of_paragraph_3(wd);
}

pub relation additional_180_days_in_force(wd: WrittenDetermination) kind institutional {
    label en unofficial "the further extension of up to 180 days under section 6110(g)(4) is in force";
}

pub relation additional_180_days_requested(wd: WrittenDetermination, requester: Person) kind empirical {
    label en unofficial "case fact: the requesting party asked for the further extension";
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "If—")
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "the period referred to in paragraph (3) shall be further extended (for not to exceed an additional 180 days) until the day which is 15 days after the date of the Secretary's determination that the transaction set forth in the written determination has been completed.")
rule S6110G4ExtensionPowerRule strict {
    for wd: WrittenDetermination;
    for requester: Person;
    when additional_180_days_requested(wd, requester);
    then power S6110G4ExtensionPower {
        holder requester;
        over Secretary;
        exercise additional_180_days_requested(wd, requester);
        valid_when additional_180_days_conditions_met(wd);
        effect create(additional_180_days_in_force(wd));
    };
}

pub relation additional_180_days_conditions_met(wd: WrittenDetermination) kind institutional {
    label en unofficial "both conditions of section 6110(g)(4) are met: the transaction was not completed during the (3) period and good cause is established to the Secretary's satisfaction";
}

@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(A) the transaction set forth in the written determination is not completed during the period set forth in paragraph (3), and")
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(B) the person by whom or on whose behalf the request for the written determination was made establishes to the satisfaction of the Secretary that good cause exists for additional delay in opening the written determination to public inspection,")
rule S6110G4ConditionsMetClassification defeasible {
    for wd: WrittenDetermination;
    when transaction_not_completed_during_period_of_paragraph_3(wd)
        and requester_establishes_to_the_satisfaction_of_the_secretary_good_cause_for_additional_delay(wd);
    then additional_180_days_conditions_met(wd);
}

pub relation additional_candidate_min_of(wd: WrittenDetermination, candidate: Date) kind institutional {
    label en unofficial "a candidate end date of the section 6110(g)(4) period: 15 days after the completion determination, or the cap of an additional 180 days beyond the (3) period";
}

@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "the period referred to in paragraph (3) shall be further extended (for not to exceed an additional 180 days) until the day which is 15 days after the date of the Secretary's determination that the transaction set forth in the written determination has been completed.")
rule S6110G4CandidateFifteenDaysAfterCompletion strict {
    for wd: WrittenDetermination;
    for determinedOn: Date;
    when additional_180_days_in_force(wd)
        and transaction_completion_determined_on(wd, determinedOn);
    then additional_candidate_min_of(wd, add_calendar_period(determinedOn, 15 calendar_day));
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "the period referred to in paragraph (3) shall be further extended (for not to exceed an additional 180 days)")
rule S6110G4CandidateCap180Days defeasible {
    for wd: WrittenDetermination;
    for capEnd: Date;
    when additional_180_days_in_force(wd)
        and postponed_candidate_min_of(wd, capEnd)
        and not_known(earlier_postponed_candidate_exists(wd, capEnd));
    then additional_candidate_min_of(wd, add_calendar_period(capEnd, 180 calendar_day));
}

pub relation earlier_additional_candidate_exists(wd: WrittenDetermination, candidate: Date) kind institutional {
    label en unofficial "another section 6110(g)(4) candidate date is strictly earlier than this one";
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "the period referred to in paragraph (3) shall be further extended (for not to exceed an additional 180 days) until the day which is 15 days after the date of the Secretary's determination that the transaction set forth in the written determination has been completed.")
rule S6110G4EarlierCandidateExists defeasible {
    for wd: WrittenDetermination;
    for candidate: Date;
    for other: Date;
    when additional_candidate_min_of(wd, candidate)
        and additional_candidate_min_of(wd, other)
        and other < candidate;
    then earlier_additional_candidate_exists(wd, candidate);
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "the period referred to in paragraph (3) shall be further extended (for not to exceed an additional 180 days) until the day which is 15 days after the date of the Secretary's determination that the transaction set forth in the written determination has been completed.")
rule S6110G4AdditionalOpenOnCandidate defeasible {
    for wd: WrittenDetermination;
    for candidate: Date;
    when additional_candidate_min_of(wd, candidate)
        and not_known(earlier_additional_candidate_exists(wd, candidate));
    then written_determination_open_on_candidate(wd, candidate);
}

pub relation wd_is_tam_or_chief_counsel_advice_or_related_background_document_in_fraud_or_criminal_or_jeopardy_matter(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the document is a technical advice memorandum, Chief Counsel advice, or related background file document involving a matter which is the subject of a civil fraud or criminal investigation or jeopardy or termination assessment";
}

pub relation action_relating_to_investigation_or_assessment_completed(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: any action relating to the investigation or assessment is completed";
}

pub relation secretary_withholds_from_public(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary does not make the document available to the public";
}

@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "Notwithstanding the provisions of paragraph (1), the Secretary shall not be required to make available to the public—")
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(A) any technical advice memorandum, any Chief Counsel advice, and any related background file document involving any matter which is the subject of a civil fraud or criminal investigation or jeopardy or termination assessment until after any action relating to such investigation or assessment is completed, or")
rule S6110G5ASecretaryWithholdingLibertyRule strict {
    for wd: WrittenDetermination;
    when wd_is_tam_or_chief_counsel_advice_or_related_background_document_in_fraud_or_criminal_or_jeopardy_matter(wd)
        and not_known(action_relating_to_investigation_or_assessment_completed(wd));
    then liberty S6110G5ASecretaryWithholdingLiberty {
        holder Secretary;
        action secretary_withholds_from_public(wd);
        window [-infinity, infinity];
    };
}

@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(B) any general written determination and any related background file document that relates solely to approval of the Secretary of any adoption or")
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(i) the funding method or plan year of a plan under section 412,")
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(ii) a taxpayer's annual accounting period under section 442,")
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(iii) a taxpayer's method of accounting under section 446(e), or")
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "(iv) a partnership's or partner's taxable year under section 706,")
rule S6110G5BSecretaryWithholdingLibertyRule strict {
    for wd: WrittenDetermination;
    when general_written_determination(wd)
        and wd_described_in_g5b(wd);
    then liberty S6110G5BSecretaryWithholdingLiberty {
        holder Secretary;
        action secretary_withholds_from_public(wd);
        window [-infinity, infinity];
    };
}

pub relation g5b_request_in_writing_after_date_it_would_otherwise_be_open(wd: WrittenDetermination, requester: Person) kind empirical {
    label en unofficial "case fact: any person requested the written determination and related background file document in writing after the date on which (except for subparagraph (B)) it would be open to public inspection";
}

pub relation g5b_made_available_on_request(wd: WrittenDetermination, requester: Person) kind empirical {
    label en unofficial "case fact: the Secretary made the written determination and related background file document available to the requester";
}

@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "but the Secretary shall make any such written determination and related background file document available upon the written request of any person after the date on which (except for this subparagraph) such determination would be open to public inspection.")
rule S6110G5BAvailableOnRequestDutyRule strict {
    for wd: WrittenDetermination;
    for requester: Person;
    when general_written_determination(wd)
        and wd_described_in_g5b(wd)
        and g5b_request_in_writing_after_date_it_would_otherwise_be_open(wd, requester);
    then duty S6110G5BAvailableOnRequestDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition g5b_made_available_on_request(wd, requester);
            window [-infinity, infinity];
        }
    };
}

pub relation h4_notice_mailed_on(wd: WrittenDetermination, mailedOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary mailed the notice under (f)(1) or (f)(3)(A) for the prior written determination on this date";
}

pub relation h4_portion_opened_on(wd: WrittenDetermination, openedOn: Date) kind empirical {
    label en unofficial "case fact: the date the portion of the prior written determination is (to be) open to public inspection";
}

pub relation h4_notice_at_least_90_days_before_opening(wd: WrittenDetermination) kind institutional {
    label en unofficial "the notice was mailed not less than 90 days before the portion was opened to public inspection";
}

@source(IRC_S6110_H, relation = formalizes, coverage = exact, quote = "Notwithstanding the provisions of subsections (f)(1) and (f)(3)(A), not less than 90 days before making any portion of a written determination described in this subsection open to public inspection, the Secretary shall issue public notice in the Federal Register that such written determination is to be made open to public inspection. The person who received a written determination may, within 75")
rule S6110H4NoticeTimelyClassification strict {
    for wd: WrittenDetermination;
    for mailedOn: Date;
    for openedOn: Date;
    when h4_notice_mailed_on(wd, mailedOn)
        and h4_portion_opened_on(wd, openedOn)
        and add_calendar_period(mailedOn, 90 calendar_day) <= openedOn;
    then h4_notice_at_least_90_days_before_opening(wd);
}

@source(IRC_S6110_H, relation = formalizes, coverage = exact, quote = "Notwithstanding the provisions of subsections (f)(1) and (f)(3)(A), not less than 90 days before making any portion of a written determination described in this subsection open to public inspection, the Secretary shall issue public notice in the Federal Register that such written determination is to be made open to public inspection. The person who received a written determination may, within 75")
rule S6110H4NoticeDutyRule strict {
    for wd: WrittenDetermination;
    for openedOn: Date;
    when prior_written_determination_described_in_h1(wd)
        and h4_portion_opened_on(wd, openedOn);
    then duty S6110H4NoticeDuty {
        bearer Secretary;
        goal achievement {
            condition h4_notice_at_least_90_days_before_opening(wd);
            window [-infinity, openedOn];
        }
    };
}

pub enum RevenueProvisionKind {
    InternalRevenueLaw;
    Regulation;
    RevenueRuling;
    RevenueProcedure;
    OtherPublishedGuidance;
    OtherUnpublishedGuidance;
    TaxTreaty;
}

pub relation revenue_provision_of_kind(wd: WrittenDetermination, kind: RevenueProvisionKind) kind empirical {
    label en unofficial "case fact: the authority (an existing or former internal revenue law, regulation, revenue ruling, revenue procedure, other published or unpublished guidance, or tax treaty, in general or as applied to specific taxpayers) the advice conveys an interpretation of, or a position on — section 6110(i)(1)(B)";
}

pub relation prepared_by_national_office_component_of_chief_counsel(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the written advice or instruction, under whatever name or designation, was prepared by a national office component of the Office of Chief Counsel";
}

pub relation issued_to_field_service_center_regional_or_district_employees(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the advice is issued to field or service center employees of the Service or regional or district employees of the Office of Chief Counsel — (A)(i)";
}

pub relation conveys_legal_interpretation_or_position_of_revenue_provision(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the advice conveys a legal interpretation of a revenue provision; an Internal Revenue Service or Office of Chief Counsel position or policy concerning a revenue provision; or a legal interpretation of State law, foreign law, or other Federal law relating to the assessment or collection of any liability under a revenue provision — (A)(ii)(I)-(III)";
}

pub relation chief_counsel_advice(wd: WrittenDetermination) kind institutional {
    label en unofficial "the written advice is \"Chief Counsel advice\" within the meaning of section 6110(i)(1)(A) (or is treated as such under (i)(2))";
}

@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"Chief Counsel advice\" means written advice or instruction, under whatever name or designation, prepared by any national office component of the Office of Chief Counsel which—")
@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(i) is issued to field or service center employees of the Service or regional or district employees of the Office of Chief Counsel; and")
@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(ii) conveys—")
@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(I) any legal interpretation of a revenue provision;")
@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(II) any Internal Revenue Service or Office of Chief Counsel position or policy concerning a revenue provision; or")
@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(III) any legal interpretation of State law, foreign law, or other Federal law relating to the assessment or collection of any liability under a revenue provision.")
@source(IRC_S6110_I, relation = formalizes, coverage = partial, quote = "For purposes of subparagraph (A), the term \"revenue provision\" means any existing or former internal revenue law, regulation, revenue ruling, revenue procedure, other published or unpublished guidance, or tax treaty, either in general or as applied")
rule S6110I1AChiefCounselAdviceDefinition strict {
    for wd: WrittenDetermination;
    for kind: RevenueProvisionKind;
    when prepared_by_national_office_component_of_chief_counsel(wd)
        and issued_to_field_service_center_regional_or_district_employees(wd)
        and conveys_legal_interpretation_or_position_of_revenue_provision(wd)
        and revenue_provision_of_kind(wd, kind);
    then chief_counsel_advice(wd);
}

pub relation advice_prepared_and_issued_by_chief_counsel_not_described_in_i1(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the advice or instruction was prepared and issued by the Office of Chief Counsel and is not described in paragraph (1)";
}

pub relation regulation_applies_section_6110_to_advice(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary provided by regulation that section 6110 applies to the advice — section 6110(i)(2)";
}

@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "The Secretary may by regulation provide that this section shall apply to any advice or instruction prepared and issued by the Office of Chief Counsel which is not described in paragraph (1).")
rule S6110I2ExtensionPowerRule strict {
    for wd: WrittenDetermination;
    when regulation_applies_section_6110_to_advice(wd);
    then power S6110I2ExtensionPower {
        holder Secretary;
        over IRS;
        exercise regulation_applies_section_6110_to_advice(wd);
        valid_when advice_prepared_and_issued_by_chief_counsel_not_described_in_i1(wd);
        effect create(chief_counsel_advice(wd));
    };
}

pub relation secretary_makes_foia_deletions_from_chief_counsel_advice(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary makes deletions of material from the Chief Counsel advice and related background file documents in accordance with 5 U.S.C. 552(b) and (c), taking no statutory provision of this title into account for 552(b)(3)";
}

@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(B) the Secretary may make deletions of material in accordance with subsections (b) and (c) of section 552 of title 5, United States Code, except that in applying subsection (b)(3) of such section, no statutory provision of this title shall be taken into account.")
rule S6110I3FoiaDeletionsLibertyRule defeasible {
    for wd: WrittenDetermination;
    when chief_counsel_advice(wd)
        and written_determination_open_to_inspection(wd);
    then liberty S6110I3FoiaDeletionsLiberty {
        holder Secretary;
        action secretary_makes_foia_deletions_from_chief_counsel_advice(wd);
        window [-infinity, infinity];
    };
}

pub relation chief_counsel_advice_issued_on(wd: WrittenDetermination, issuedOn: Date) kind empirical {
    label en unofficial "case fact: the Chief Counsel advice was issued on this date";
}

pub relation i4a_deletions_completed_and_advice_made_open_on(wd: WrittenDetermination, doneOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary completed any deletions described in subsection (c)(1) or paragraph (3) and made the Chief Counsel advice, as so edited, open for public inspection on this date";
}

pub relation i4a_made_open_in_60_days(wd: WrittenDetermination) kind institutional {
    label en unofficial "the nontaxpayer-specific Chief Counsel advice was made open within 60 days after issuance";
}

@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(ii) the Secretary shall, within 60 days after the issuance of the Chief Counsel advice, complete any deletions described in subsection (c)(1) or paragraph (3) and make the Chief Counsel advice, as so edited, open for public inspection.")
rule S6110I4AMadeOpenTimelyClassification strict {
    for wd: WrittenDetermination;
    for issuedOn: Date;
    for doneOn: Date;
    when chief_counsel_advice_issued_on(wd, issuedOn)
        and i4a_deletions_completed_and_advice_made_open_on(wd, doneOn)
        and doneOn <= add_calendar_period(issuedOn, 60 calendar_day);
    then i4a_made_open_in_60_days(wd);
}

@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "In the case of Chief Counsel advice which is written without reference to a specific taxpayer or group of specific taxpayers—")
@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(i) subsection (f)(1) shall not apply; and")
@source(IRC_S6110_I, relation = formalizes, coverage = exact, quote = "(ii) the Secretary shall, within 60 days after the issuance of the Chief Counsel advice, complete any deletions described in subsection (c)(1) or paragraph (3) and make the Chief Counsel advice, as so edited, open for public inspection.")
rule S6110I4AOpenDutyRule strict {
    for wd: WrittenDetermination;
    for issuedOn: Date;
    when chief_counsel_advice(wd)
        and wd_is_nontaxpayer_specific_chief_counsel_advice(wd)
        and chief_counsel_advice_issued_on(wd, issuedOn);
    then duty S6110I4AOpenDuty {
        bearer Secretary;
        goal achievement {
            condition i4a_made_open_in_60_days(wd);
            window [issuedOn, add_calendar_period(issuedOn, 60 calendar_day)];
        }
    };
}

pub relation i4b_notice_mailed_to_each_taxpayer_on(wd: WrittenDetermination, mailedOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary mailed the notice required by subsection (f)(1) (with a copy of the Chief Counsel advice indicating the proposed deletions) to each taxpayer on this date";
}

pub relation i4b_notice_timely(wd: WrittenDetermination) kind institutional {
    label en unofficial "the taxpayer-specific Chief Counsel advice notice was mailed within 60 days after issuance";
}

@source(IRC_S6110_I, relation = formalizes, coverage = partial, quote = "In the case of Chief Counsel advice which is written with respect to a specific taxpayer or group of specific taxpayers, the Secretary shall, within 60 days after the issuance of the Chief Counsel advice, mail the notice required by subsection")
rule S6110I4BNoticeTimelyClassification strict {
    for wd: WrittenDetermination;
    for issuedOn: Date;
    for mailedOn: Date;
    when chief_counsel_advice_issued_on(wd, issuedOn)
        and i4b_notice_mailed_to_each_taxpayer_on(wd, mailedOn)
        and mailedOn <= add_calendar_period(issuedOn, 60 calendar_day);
    then i4b_notice_timely(wd);
}

@source(IRC_S6110_I, relation = formalizes, coverage = partial, quote = "In the case of Chief Counsel advice which is written with respect to a specific taxpayer or group of specific taxpayers, the Secretary shall, within 60 days after the issuance of the Chief Counsel advice, mail the notice required by subsection (f)(1) to each such taxpayer. The notice shall include a copy of the Chief Counsel advice on which is indicated the information that the Secretary proposes")
rule S6110I4BNoticeDutyRule strict {
    for wd: WrittenDetermination;
    for issuedOn: Date;
    for person: Person;
    when chief_counsel_advice(wd)
        and not_known(wd_is_nontaxpayer_specific_chief_counsel_advice(wd))
        and chief_counsel_advice_issued_on(wd, issuedOn)
        and wd_pertains_to(wd, person);
    then duty S6110I4BNoticeDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition i4b_notice_timely(wd);
            window [issuedOn, add_calendar_period(issuedOn, 60 calendar_day)];
        }
    };
}

pub relation secretary_failed_to_make_required_deletions(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary failed to make deletions required in accordance with subsection (c) — section 6110(j)(1)(A)";
}

pub relation secretary_failed_to_follow_procedures_of_g_or_i4b(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary failed to follow the procedures in subsection (g) or (i)(4)(B) — section 6110(j)(1)(B)";
}

pub relation recipient_of_wd_or_person_identified_in_wd(wd: WrittenDetermination, person: Person) kind empirical {
    label en unofficial "case fact: the person is the recipient of the written determination or a person identified in it";
}

pub relation section_6110j_civil_action_filed(wd: WrittenDetermination, person: Person) kind empirical {
    label en unofficial "case fact: the person filed an action against the Secretary in the United States Court of Federal Claims";
}

pub relation secretary_failure_established(wd: WrittenDetermination) kind institutional {
    label en unofficial "the Secretary failed to make required deletions or to follow the (g) or (i)(4)(B) procedures";
}

@source(IRC_S6110_J, relation = formalizes, coverage = exact, quote = "(A) fails to make deletions required in accordance with subsection (c), or")
rule S6110J1FailureA strict {
    for wd: WrittenDetermination;
    when secretary_failed_to_make_required_deletions(wd);
    then secretary_failure_established(wd);
}

@source(IRC_S6110_J, relation = formalizes, coverage = exact, quote = "(B) fails to follow the procedures in subsection (g) or (i)(4)(B),")
rule S6110J1FailureB strict {
    for wd: WrittenDetermination;
    when secretary_failed_to_follow_procedures_of_g_or_i4b(wd);
    then secretary_failure_established(wd);
}

pub relation civil_action_against_secretary_pending(wd: WrittenDetermination, person: Person) kind institutional {
    label en unofficial "an action against the Secretary under section 6110(j)(1) is pending";
}

@source(IRC_S6110_J, relation = formalizes, coverage = partial, quote = "Whenever the Secretary—")
@source(IRC_S6110_J, relation = formalizes, coverage = exact, quote = "the recipient of the written determination or any person identified in the written determination shall have as an exclusive civil remedy an action against the Secretary in the United States Court of Federal Claims, which shall have jurisdiction to hear any action under this paragraph.")
rule S6110J1CivilActionPowerRule strict {
    for wd: WrittenDetermination;
    for person: Person;
    when recipient_of_wd_or_person_identified_in_wd(wd, person)
        and section_6110j_civil_action_filed(wd, person);
    then power S6110J1CivilActionPower {
        holder person;
        over Secretary;
        exercise section_6110j_civil_action_filed(wd, person);
        valid_when secretary_failure_established(wd);
        effect create(civil_action_against_secretary_pending(wd, person));
    };
}

pub relation other_civil_action_against_secretary_over_written_determination(wd: WrittenDetermination) kind empirical {
    label en unofficial "a civil action against the Secretary over the written determination outside section 6110(j)(1) proceeds";
}

@source(IRC_S6110_J, relation = formalizes, coverage = partial, quote = "shall have as an exclusive civil remedy an action against the Secretary in the United States Court of Federal Claims, which shall have jurisdiction to hear any action under this paragraph.")
rule S6110J1ExclusiveRemedyImmunityRule strict {
    for wd: WrittenDetermination;
    when is_written_determination(wd);
    then immunity S6110J1ExclusiveRemedyImmunity {
        holder Secretary;
        protected_effect create(other_civil_action_against_secretary_over_written_determination(wd));
    };
}

pub relation employee_intentionally_or_willfully_failed_to_delete_or_to_follow_procedures(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the court determines that an employee of the Internal Revenue Service intentionally or willfully failed to delete in accordance with subsection (c) (suit under (1)(A)), or intentionally or willfully failed to act in accordance with subsection (g) or (i)(4)(B) (suit under (1)(B))";
}

pub relation actual_damages_sustained(wd: WrittenDetermination, person: Person, amount: Money) kind empirical {
    label en unofficial "case fact: the actual damages the person sustained";
}

pub relation costs_and_attorneys_fees_determined(wd: WrittenDetermination, person: Person, amount: Money) kind empirical {
    label en unofficial "case fact: the costs of the action together with reasonable attorney's fees as determined by the court";
}

pub relation united_states_liable_damages_core(wd: WrittenDetermination, person: Person, amount: Money) kind institutional {
    label en unofficial "the actual damages the United States is liable for under section 6110(j)(2)(A): the sum of the actual damages sustained but in no case less than $1,000";
}

@source(IRC_S6110_J, relation = formalizes, coverage = exact, quote = "(A) actual damages sustained by the person but in no case shall a person be entitled to receive less than the sum of $1,000, and")
rule S6110J2AActualDamagesAboveFloor strict {
    for wd: WrittenDetermination;
    for person: Person;
    for actual: Money;
    when civil_action_against_secretary_pending(wd, person)
        and employee_intentionally_or_willfully_failed_to_delete_or_to_follow_procedures(wd)
        and actual_damages_sustained(wd, person, actual)
        and actual >= 1000.00 USD;
    then united_states_liable_damages_core(wd, person, actual);
}

@source(IRC_S6110_J, relation = formalizes, coverage = exact, quote = "(A) actual damages sustained by the person but in no case shall a person be entitled to receive less than the sum of $1,000, and")
rule S6110J2AActualDamagesBelowFloor strict {
    for wd: WrittenDetermination;
    for person: Person;
    for actual: Money;
    when civil_action_against_secretary_pending(wd, person)
        and employee_intentionally_or_willfully_failed_to_delete_or_to_follow_procedures(wd)
        and actual_damages_sustained(wd, person, actual)
        and actual < 1000.00 USD;
    then united_states_liable_damages_core(wd, person, 1000.00 USD);
}

pub relation united_states_liable_total(wd: WrittenDetermination, person: Person, amount: Money) kind institutional {
    label en unofficial "the total the United States is liable for under section 6110(j)(2): the section 6110(j)(2)(A) damages plus the costs of the action and reasonable attorney's fees";
}

@source(IRC_S6110_J, relation = formalizes, coverage = partial, quote = "In any suit brought under the provisions of paragraph (1)(A) in which the Court determines that an employee of the Internal Revenue Service intentionally or willfully failed to delete in accordance with subsection (c), or in any suit brought under subparagraph (1)(B) in which the Court determines that an employee intentionally or willfully failed to act in accordance with subsection (g) or")
@source(IRC_S6110_J, relation = formalizes, coverage = exact, quote = "(B) the costs of the action together with reasonable attorney's fees as determined by the Court.")
rule S6110J2TotalLiability strict {
    for wd: WrittenDetermination;
    for person: Person;
    for damages: Money;
    for costs: Money;
    when united_states_liable_damages_core(wd, person, damages)
        and costs_and_attorneys_fees_determined(wd, person, costs);
    then united_states_liable_total(wd, person, damages + costs);
}

pub relation fee_assessment_for_duplication_or_deletion_search(requester: Person, wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary assesses the actual costs for duplication of the document made open or available to the public, or incurred in searching for and making deletions required under (c)(1) or (i)(3) from a document available to public inspection only upon written request — section 6110(k)(1)(A)-(B)";
}

pub relation actual_costs_of_duplication_or_deletion_search_assessed(requester: Person, wd: WrittenDetermination) kind empirical {
    label en unofficial "a fee assessment for actual costs is in effect against the requester";
}

pub relation secretary_assesses_actual_costs(requester: Person, wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary exercises the authority to assess actual costs";
}

@source(IRC_S6110_K, relation = formalizes, coverage = partial, quote = "The Secretary is authorized to assess actual")
@source(IRC_S6110_K, relation = formalizes, coverage = exact, quote = "(A) for duplication of any written determination or background file document made open or available to the public under this section, and")
@source(IRC_S6110_K, relation = formalizes, coverage = exact, quote = "(B) incurred in searching for and making deletions required under subsection (c)(1) or (i)(3) from any written determination or background file document which is available to public inspection only upon written request.")
rule S6110K1FeeAssessmentPowerRule strict {
    for requester: Person;
    for wd: WrittenDetermination;
    when fee_assessment_for_duplication_or_deletion_search(requester, wd)
        and secretary_assesses_actual_costs(requester, wd);
    then power S6110K1FeeAssessmentPower {
        holder Secretary;
        over requester;
        exercise secretary_assesses_actual_costs(requester, wd);
        valid_when fee_assessment_for_duplication_or_deletion_search_scope_met(wd);
        effect create(actual_costs_of_duplication_or_deletion_search_assessed(requester, wd));
    };
}

pub relation fee_assessment_for_duplication_or_deletion_search_scope_met(wd: WrittenDetermination) kind empirical {
    label en unofficial "the document is one the fee power reaches: open or available to the public (duplication), or available only upon written request (search and deletions)";
}

pub relation wd_open_or_available_to_public(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the document is made open or available to the public under this section";
}

@source(IRC_S6110_K, relation = formalizes, coverage = partial, quote = "(A) for duplication of any written determination or background file document made open or available to the public under this section, and")
rule S6110K1FeeScopeClassification strict {
    for wd: WrittenDetermination;
    when wd_open_or_available_to_public(wd);
    then fee_assessment_for_duplication_or_deletion_search_scope_met(wd);
}

external judgment relation secretary_determines_fee_waiver_in_public_interest_primarily_benefiting_general_public(wd: WrittenDetermination) {
    authority Secretary;
    label en official "the Secretary determines that waiver or reduction of the fee is in the public interest because furnishing the determination or background file document can be considered as primarily benefiting the general public — section 6110(k)(1), last sentence";
}

pub relation document_furnished_without_charge_or_reduced_charge(wd: WrittenDetermination, requester: Person) kind empirical {
    label en unofficial "case fact: the Secretary furnished the document without charge or at a reduced charge";
}

pub relation requester_of_document(wd: WrittenDetermination, requester: Person) kind empirical {
    label en unofficial "case fact: the person requested the written determination or background file document";
}

@source(IRC_S6110_K, relation = formalizes, coverage = exact, quote = "The Secretary shall furnish any written determination or background file document without charge or at a reduced charge if he determines that waiver or reduction of the fee is in the public interest because furnishing such determination or background file document can be considered as primarily benefiting the general public.")
rule S6110K1WaiverDutyRule strict {
    for wd: WrittenDetermination;
    for requester: Person;
    when requester_of_document(wd, requester)
        and secretary_determines_fee_waiver_in_public_interest_primarily_benefiting_general_public(wd);
    then duty S6110K1WaiverDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition document_furnished_without_charge_or_reduced_charge(wd, requester);
            window [-infinity, infinity];
        }
    };
}

pub relation secretary_disposes_of_reference_written_determination_or_related_background_document(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary disposes of a reference written determination or a related background file document";
}

@source(IRC_S6110_K, relation = formalizes, coverage = partial, quote = "The Secretary shall not dispose of any reference written determinations and related background file documents.")
rule S6110K2NoDisposalOfReferenceRule strict {
    for wd: WrittenDetermination;
    when reference_written_determination(wd);
    then prohibition S6110K2NoDisposalOfReference {
        bearer Secretary;
        action secretary_disposes_of_reference_written_determination_or_related_background_document(wd);
        window [-infinity, infinity];
    };
}

pub relation wd_disposed_of_on(wd: WrittenDetermination, disposedOn: Date) kind empirical {
    label en unofficial "case fact: the date the Secretary disposes of the general written determination or background file document";
}

pub relation general_wd_first_open_on(wd: WrittenDetermination, firstOpenOn: Date) kind empirical {
    label en unofficial "case fact: the date the general written determination is first made open to public inspection";
}

pub relation funds_appropriated_before_1979_01_20_for_disposal_of_h_determination(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: funds were appropriated before January 20, 1979 for the disposal of the (h) general written determination";
}

pub relation general_wd_described_in_h(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the general written determination is one described in subsection (h)";
}

pub relation disposal_before_permitted_date(wd: WrittenDetermination) kind institutional {
    label en unofficial "the general written determination or background file document is disposed of earlier than section 6110(k)(2) allows";
}

@source(IRC_S6110_K, relation = formalizes, coverage = partial, quote = "but such disposal shall, except as provided in the following sentence, occur not earlier than 3 years after such written determination is first made open to public inspection.")
rule S6110K2GeneralDisposalTooEarly strict {
    for wd: WrittenDetermination;
    for disposedOn: Date;
    for firstOpenOn: Date;
    when general_written_determination(wd)
        and not_known(general_wd_described_in_h(wd))
        and wd_disposed_of_on(wd, disposedOn)
        and general_wd_first_open_on(wd, firstOpenOn)
        and disposedOn < add_calendar_period(firstOpenOn, 3 calendar_year);
    then disposal_before_permitted_date(wd);
}

@source(IRC_S6110_K, relation = formalizes, coverage = partial, quote = "the Secretary may dispose of such determination and any related background file document in accordance with such procedures but such disposal shall not occur earlier than 3 years after such written determination is first made open to public inspection if funds are appropriated for such purpose before January 20, 1979")
rule S6110K2HDisposalTooEarlyFundsAppropriated strict {
    for wd: WrittenDetermination;
    for disposedOn: Date;
    for firstOpenOn: Date;
    when general_written_determination(wd)
        and general_wd_described_in_h(wd)
        and funds_appropriated_before_1979_01_20_for_disposal_of_h_determination(wd)
        and wd_disposed_of_on(wd, disposedOn)
        and general_wd_first_open_on(wd, firstOpenOn)
        and disposedOn < add_calendar_period(firstOpenOn, 3 calendar_year);
    then disposal_before_permitted_date(wd);
}

@source(IRC_S6110_K, relation = formalizes, coverage = partial, quote = "or not earlier than January 20, 1979, if funds are not appropriated before such date")
rule S6110K2HDisposalTooEarlyFundsNotAppropriated strict {
    for wd: WrittenDetermination;
    for disposedOn: Date;
    when general_written_determination(wd)
        and general_wd_described_in_h(wd)
        and not_known(funds_appropriated_before_1979_01_20_for_disposal_of_h_determination(wd))
        and wd_disposed_of_on(wd, disposedOn)
        and disposedOn < @1979-01-20;
    then disposal_before_permitted_date(wd);
}

pub relation secretary_disposed_of_document_too_early(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary disposed of the document at the date recorded";
}

@source(IRC_S6110_K, relation = formalizes, coverage = partial, quote = "Nothing in this section shall prevent the Secretary from disposing of any general written determination or background file document described in subsection (b) in accordance with established records disposition procedures, but such disposal shall, except as")
rule S6110K2EarlyDisposalBarRule strict {
    for wd: WrittenDetermination;
    when general_written_determination(wd);
    then prohibition S6110K2EarlyDisposalBar {
        bearer Secretary;
        action secretary_disposed_of_document_too_early(wd);
        window [-infinity, infinity];
    };
}

pub relation regulations_otherwise_establish_precedential_use(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary otherwise established by regulations that the written determination may be used or cited as precedent";
}

pub relation wd_concerns_taxes_imposed_by_subtitle_d(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the written determination is with regard to taxes imposed by subtitle D";
}

pub relation written_determination_may_not_be_used_or_cited_as_precedent(wd: WrittenDetermination) kind institutional {
    label en unofficial "the written determination may not be used or cited as precedent";
}

@source(IRC_S6110_K, relation = formalizes, coverage = exact, quote = "Unless the Secretary otherwise establishes by regulations, a written determination may not be used or cited as precedent. The preceding sentence shall not apply to change the precedential status (if any) of written determinations with regard to")
rule S6110K3NoPrecedent strict {
    for wd: WrittenDetermination;
    when is_written_determination(wd)
        and not_known(regulations_otherwise_establish_precedential_use(wd))
        and not_known(wd_concerns_taxes_imposed_by_subtitle_d(wd));
    then written_determination_may_not_be_used_or_cited_as_precedent(wd);
}

pub relation court_order_provided_for_in_this_title(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the court order is one otherwise provided for in this title (for example under subsection (d)(3), (f)(3), (f)(4), or (j))";
}

pub relation discovery_order_in_judicial_proceeding(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the court order is a discovery order made in connection with a judicial proceeding";
}

pub relation secretary_required_by_court_to_open_or_refrain(wd: WrittenDetermination) kind institutional {
    label en unofficial "the Secretary is required by a court to make a written determination or background file document open or to refrain from disclosure of it";
}

@source(IRC_S6110_M, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this title, or with respect to a discovery order made in connection with a judicial proceeding, the Secretary shall not be required by any Court to make any written determination or background file document open or available to public inspection, or to refrain from disclosure of any such documents.")
rule S6110MExclusiveRemedyImmunityRule defeasible {
    for wd: WrittenDetermination;
    when is_written_determination(wd);
    then immunity S6110MExclusiveRemedyImmunity {
        holder Secretary;
        protected_effect create(secretary_required_by_court_to_open_or_refrain(wd));
    };
    unless court_order_provided_for_in_this_title(wd)
        and is_written_determination(wd);
    unless discovery_order_in_judicial_proceeding(wd)
        and is_written_determination(wd);
}
