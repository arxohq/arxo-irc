// 26 U.S.C. §6103(b) — Definitions used throughout this package. STAGE 1
// FULL for (b)(1)-(4); (b)(5) ("State") is modeled only for the core
// 50-states/DC/territories list used by §6103(d) — the municipality/
// regional-income-tax-agency extension of (b)(5)(A)(ii)-(iii)/(B) is left
// `unreviewed` (TECH_GAP: needs decennial-census population data this
// package cannot pin, see report); (b)(6)-(11) are local naming
// definitions used contextually by later modules, not independently
// executed here (see coverage rows 26/6103/b/6..11).
//
// `Person` and `Organ` are `us.irc.core`; the taxpayer of a
// `ReturnInformation` item is a `Person`, the recipient/discloser of a
// `Disclosure` may be a natural person, an officer/employee, or (for state
// tax agencies, committees of Congress, etc.) an `Organ` instance the case
// asserts with `entity_ref`.

// ---------------------------------------------------------------------
// Entities
// ---------------------------------------------------------------------

use self::{
    IRC_S6103_A,
    IRC_S6103_B,
    Organ,
    Person,
};

pub entity ReturnInformation {
    label en unofficial "a unit of a return, or of return information within the meaning of section 6103(b)(1)-(2), pertaining to a taxpayer";
}

pub entity Disclosure {
    label en unofficial "an instance of making known, in any manner, a return or return information to a person — section 6103(b)(8)";
}

// ---------------------------------------------------------------------
// (b)(2) Return information
// ---------------------------------------------------------------------

relation return_information_candidate(info: ReturnInformation) kind empirical {
    label en unofficial "case fact: the item is data described in section 6103(b)(2)(A)-(D) — taxpayer identity, income/deduction/liability/examination data received by or for the Secretary with respect to a return or a liability determination, a written determination or background file document not open under section 6110, an advance pricing agreement (and related background information), or a section 7121 closing agreement (and related background information)";
}

relation data_not_associable_with_taxpayer(info: ReturnInformation) kind empirical {
    label en unofficial "the flush language of section 6103(b)(2): the data is in a form which cannot be associated with, or otherwise identify, directly or indirectly, a particular taxpayer";
}

pub relation return_information(info: ReturnInformation) kind institutional {
    label en unofficial "the item is \"return information\" within the meaning of section 6103(b)(2)";
}
@source(IRC_S6103_B, relation = formalizes, coverage = partial, quote = "The term \"return information\" means")
rule S6103BReturnInformationClassification defeasible {
    for info: ReturnInformation;
    when return_information_candidate(info);
    then return_information(info);
    unless data_not_associable_with_taxpayer(info) and return_information_candidate(info);
}

// ---------------------------------------------------------------------
// (b)(3) Taxpayer return information
// ---------------------------------------------------------------------

pub relation about_taxpayer(info: ReturnInformation, taxpayer: Person) kind empirical {
    label en unofficial "the return information relates to this taxpayer";
}
pub relation filed_by_or_on_behalf_of_taxpayer(info: ReturnInformation, taxpayer: Person) kind empirical {
    label en unofficial "the return information was filed with, or furnished to, the Secretary by or on behalf of the taxpayer to whom it relates — section 6103(b)(3)";
}

pub relation taxpayer_return_information(info: ReturnInformation, taxpayer: Person) kind institutional {
    label en unofficial "the item is \"taxpayer return information\" within the meaning of section 6103(b)(3): return information filed with, or furnished to, the Secretary by or on behalf of the taxpayer to whom it relates";
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "The term \"taxpayer return information\" means return information as defined in paragraph (2) which is filed with, or furnished to, the Secretary by or on behalf of the taxpayer to whom such return information relates.")
rule S6103BTaxpayerReturnInformation defeasible {
    for info: ReturnInformation;
    for taxpayer: Person;
    when return_information(info) and about_taxpayer(info, taxpayer) and filed_by_or_on_behalf_of_taxpayer(info, taxpayer);
    then taxpayer_return_information(info, taxpayer);
}

// ---------------------------------------------------------------------
// (b)(4) Tax administration
// ---------------------------------------------------------------------
// JUDGMENT CALL: "tax administration" purpose is modeled as a single
// empirical case fact per disclosure rather than a further-decomposed
// classification of the (A)(i)-(ii)/(B) list; the list itself (assessment,
// collection, enforcement, litigation, publication, statistical gathering,
// and Federal tax policy development) is broad enough that a scenario
// asserting the purpose is a defensible simplification — see report.

pub relation tax_administration_purpose(d: Disclosure) kind empirical {
    label en unofficial "the disclosure or inspection is for \"tax administration\" within the meaning of section 6103(b)(4): administration, management, conduct, direction, and supervision of the internal revenue laws (or equivalent State laws) and tax conventions, including assessment, collection, enforcement, litigation, publication, and statistical gathering, or the development of Federal tax policy";
}

// ---------------------------------------------------------------------
// (b)(5) State (partial: core 50-states/DC/territories list only)
// ---------------------------------------------------------------------

pub relation state_within_6103b5(agency: Organ) kind empirical {
    label en unofficial "case fact: the agency, body, or commission is charged under the laws of one of the 50 States, the District of Columbia, Puerto Rico, the Virgin Islands, Guam, American Samoa, or the Commonwealth of the Northern Mariana Islands, with responsibility for the administration of that jurisdiction's tax laws — section 6103(b)(5)(A)(i). The municipality/regional-income-tax-agency extension of (b)(5)(A)(ii)-(iii) and (B) is NOT modeled here: it needs decennial-census population data and a Secretary agreement this package does not pin (TECH_GAP, see report row for 26/6103/b/5).";
}

// ---------------------------------------------------------------------
// (a) bearer classes — who is bound by the general prohibition
// ---------------------------------------------------------------------
// JUDGMENT CALL: (a)(2)/(a)(3) each cross-reference a long, specific list
// of the OTHER subsections through which the person could have gained
// access ((i)(1)(C), (7)(A), (l)(7)(D) for (a)(2); (c), (e)(1)(D)(iii),
// and a dozen enumerated (k)/(l)/(m)/(n) paragraphs for (a)(3)). This
// package models the three bearer classes as case facts asserting
// membership directly (the "has or had access under ..." nature of the
// text is a status, not a further computation this stage builds), rather
// than deriving membership from each cross-referenced subsection's own
// access grant. A person who is a recipient of a permitted disclosure the
// case does not additionally assert as `former_officer_or_employee`/
// `state_officer_with_access`/`other_person_with_access` is simply not a
// bearer of subsection (a) at all for that scenario (case-fact absence),
// which matches the statute's own scoping (a)(3): it binds only "other
// persons ... who has or had access ... under" the named provisions.

pub relation federal_officer_or_employee(p: Person) kind empirical {
    label en unofficial "section 6103(a)(1): an officer or employee of the United States (including a FORMER officer or employee, per the subsection's closing sentence)";
}
pub relation state_officer_with_access(p: Person) kind empirical {
    label en unofficial "section 6103(a)(2): an officer or employee of any State (or a listed local law enforcement/child support/benefit agency) who has or had access to returns or return information under this section or section 6104(c)";
}
pub relation other_person_with_access(p: Person) kind empirical {
    label en unofficial "section 6103(a)(3): any other person (or officer or employee thereof) who has or had access to returns or return information under one of the subsections (a)(3) enumerates (subsection (c); (e)(1)(D)(iii); certain paragraphs of (k), (l), (m); or subsection (n))";
}

pub relation covered_person(p: Person) kind institutional {
    label en unofficial "the person is bound by the section 6103(a) confidentiality prohibition (one of the three bearer classes of (a)(1)-(3))";
}
@source(IRC_S6103_A, relation = formalizes, coverage = exact, quote = "no officer or employee of the United States,")
rule S6103ACoveredFederalOfficer strict {
    for p: Person;
    when federal_officer_or_employee(p);
    then covered_person(p);
}
@source(IRC_S6103_A, relation = formalizes, coverage = partial, quote = "no officer or employee of any State,")
rule S6103ACoveredStateOfficer strict {
    for p: Person;
    when state_officer_with_access(p);
    then covered_person(p);
}
@source(IRC_S6103_A, relation = formalizes, coverage = partial, quote = "no other person (or officer or employee thereof) who has or had access to returns or return information under subsection (c),")
rule S6103ACoveredOtherPerson strict {
    for p: Person;
    when other_person_with_access(p);
    then covered_person(p);
}
