// 26 U.S.C. §6110 — Public inspection of written determinations. STAGE 1
// PARTIAL: (a) general rule, (b) definitions ((b)(1)-(2) only), (c)
// deletions (as a classification enumerating the seven categories, not a
// modeled `must_delete` computation per document), and (g)(1)-(2) timing
// are modeled. (d) third-party-contact notations/disclosure-of-identity
// litigation, (e) background file document availability duty, (f)
// dispute-resolution powers (notice/administrative remedies/Tax Court
// actions), (g)(3)-(5) postponement, (h) pre-1976 determinations, (i)
// Chief Counsel advice special rules, (j)-(l) are `unreviewed`.

use self::{
    IRC_S6110_A,
    IRC_S6110_G,
    excluded_from_section_6110,
};

pub entity WrittenDetermination {
    label en unofficial "a ruling, determination letter, technical advice memorandum, or Chief Counsel advice — section 6110(b)(1)(A), excluding any matter referred to in section 6103(b)(2)(C) or (D)";
}
pub entity BackgroundFileDocument {
    label en unofficial "the request for a written determination, supporting material, or IRS/outside communication received before issuance — section 6110(b)(2)";
}
pub relation background_file_document_of(doc: BackgroundFileDocument, wd: WrittenDetermination) kind empirical;

// ---------------------------------------------------------------------
// (a) General rule — open to public inspection, subject to (c) deletions
// ---------------------------------------------------------------------

pub enum DeletionCategory {
    IdentifyingDetails;
    NationalDefenseOrForeignPolicy;
    OtherStatutoryExemption;
    TradeSecretsOrFinancial;
    PersonalPrivacyInvasion;
    FinancialInstitutionReports;
    GeologicalAndGeophysicalData;
}
pub relation deletion_category_applies(wd: WrittenDetermination, category: DeletionCategory) kind empirical {
    label en unofficial "case fact: material in the written determination or background file document falls into this section 6110(c)(1)-(7) deletion category";
}
pub relation deletions_made(wd: WrittenDetermination) kind empirical {
    label en unofficial "case fact: the Secretary has made the deletions section 6110(c) calls for (or the taxpayer has agreed to, or a court under (f)(3) has ordered, the deletions), so the redacted text may be opened to inspection";
}

pub relation written_determination_open_to_inspection(wd: WrittenDetermination) kind institutional {
    label en unofficial "the text of the written determination (as redacted under section 6110(c)) is open to public inspection under section 6110(a)";
}
@source(IRC_S6110_A, relation = formalizes, coverage = exact, quote = "the text of any written determination and any background file document relating to such written determination shall be open to public inspection at such place as the Secretary may by regulations prescribe.")
rule S6110AOpenToInspection defeasible {
    for wd: WrittenDetermination;
    when deletions_made(wd);
    then written_determination_open_to_inspection(wd);
    // Stage 2: section 6110(l) — the section does not apply to the excluded matters (module 18).
    unless excluded_from_section_6110(wd) and deletions_made(wd);
}

// ---------------------------------------------------------------------
// (g)(1)-(2) Time for disclosure
// ---------------------------------------------------------------------

pub relation notice_of_intention_mailed_on(wd: WrittenDetermination, mailedOn: Date) kind empirical {
    label en unofficial "case fact: the section 6110(f)(1) notice of intention to disclose was mailed on this date";
}
pub relation court_decision_under_f3_final_on(wd: WrittenDetermination, finalOn: Date) kind empirical {
    label en unofficial "case fact: a court decision under section 6110(f)(3) became final on this date (only applicable if a petition to restrain disclosure was filed)";
}

pub relation written_determination_open_earliest(wd: WrittenDetermination, earliest: Date) kind institutional {
    label en unofficial "the earliest date the written determination may be opened to public inspection under section 6110(g)(1)(A): no earlier than 75 days after the section 6110(f)(1) notice was mailed";
}
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "no earlier than 75 days, and no later than 90 days, after the notice provided in subsection (f)(1) is mailed, or, if later,")
rule S6110G1AEarliestDate strict {
    for wd: WrittenDetermination;
    for mailedOn: Date;
    when notice_of_intention_mailed_on(wd, mailedOn);
    then written_determination_open_earliest(wd, add_calendar_period(mailedOn, 75 calendar_day));
}
pub relation written_determination_open_latest_no_petition(wd: WrittenDetermination, latest: Date) kind institutional {
    label en unofficial "the latest date the written determination must be opened under section 6110(g)(1)(A), absent a later (g)(1)(B) court-decision date: no later than 90 days after the section 6110(f)(1) notice was mailed";
}
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "no earlier than 75 days, and no later than 90 days, after the notice provided in subsection (f)(1) is mailed, or, if later,")
rule S6110G1ALatestDate strict {
    for wd: WrittenDetermination;
    for mailedOn: Date;
    when notice_of_intention_mailed_on(wd, mailedOn);
    then written_determination_open_latest_no_petition(wd, add_calendar_period(mailedOn, 90 calendar_day));
}
pub relation written_determination_open_on(wd: WrittenDetermination, openOn: Date) kind institutional {
    label en unofficial "the date, computed under section 6110(g), on which the written determination is open to public inspection: within 30 days after a section 6110(f)(3) court decision becomes final, if that is later than the (g)(1)(A) 90-day date";
}
// "(A) ... no later than 90 days ... or, if later, (B) within 30 days after
// ... becomes final": the governing date is the LATER of the two. Maximum
// without a MAX term — each paragraph yields a candidate and the governing
// one is the candidate for which no strictly later candidate exists (the
// `us.irc.excise_entities` §4941(e)(1) pattern, TECH-GAPS G136, mirrored).
// The previous stage took (B) unconditionally whenever a petition was
// decided, so a court decision final well before the 90-day date moved the
// date EARLIER (TECH-GAPS G170).
relation written_determination_open_on_candidate(wd: WrittenDetermination, openOn: Date) kind institutional {
    label en unofficial "a section 6110(g)(1)(A) or (B) date competing for the \"if later\" comparison";
}
@source(IRC_S6110_G, relation = formalizes, coverage = partial, quote = "no earlier than 75 days, and no later than 90 days, after the notice provided in subsection (f)(1) is mailed, or, if later,")
rule S6110G1AOpenOnCandidate strict {
    for wd: WrittenDetermination;
    for latest: Date;
    when written_determination_open_latest_no_petition(wd, latest);
    then written_determination_open_on_candidate(wd, latest);
}
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "within 30 days after the date on which a court decision under subsection (f)(3) becomes final.")
rule S6110G1BOpenOnCandidate strict {
    for wd: WrittenDetermination;
    for finalOn: Date;
    when court_decision_under_f3_final_on(wd, finalOn);
    then written_determination_open_on_candidate(wd, add_calendar_period(finalOn, 30 calendar_day));
}
relation later_written_determination_open_on_candidate_exists(wd: WrittenDetermination, openOn: Date) kind institutional {
    label en unofficial "another section 6110(g)(1) candidate date for this written determination is strictly later than this one";
}
rule S6110G1LaterCandidateExists defeasible {
    for wd: WrittenDetermination;
    for openOn: Date;
    for later: Date;
    when written_determination_open_on_candidate(wd, openOn)
        and written_determination_open_on_candidate(wd, later)
        and later > openOn;
    then later_written_determination_open_on_candidate_exists(wd, openOn);
}
@source(IRC_S6110_G, relation = formalizes, coverage = exact, quote = "or, if later,")
rule S6110G1OpenOnLaterOfCandidates defeasible {
    for wd: WrittenDetermination;
    for openOn: Date;
    when written_determination_open_on_candidate(wd, openOn);
    unless later_written_determination_open_on_candidate_exists(wd, openOn);
    then written_determination_open_on(wd, openOn);
}

pub relation restrain_disclosure_petition_decided(wd: WrittenDetermination) kind institutional {
    label en unofficial "a section 6110(f)(3) petition to restrain disclosure of this written determination was filed and decided";
}
rule S6110RestrainPetitionDecidedClassification strict {
    for wd: WrittenDetermination;
    for finalOn: Date;
    when court_decision_under_f3_final_on(wd, finalOn);
    then restrain_disclosure_petition_decided(wd);
}
