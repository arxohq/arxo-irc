// 26 U.S.C. §6103(d)(2)-(6) — State audit agencies, section 7624 payments, the
// death-information contract bar, combined employment tax reporting and regional
// agencies — and §6103(e)(1)(A)(ii)-(F), (e)(2)-(6), (e)(8)-(11) — the remainder of
// the material-interest exception. STAGE 2. Every permission below is a defeater of
// the section 6103(a) prohibition through the `disclosure_permitted` aggregator of
// module 01; every "shall" addressed to the Secretary is a duty with the requester as
// beneficiary; every restriction on the recipient or on the content of a disclosure
// is a prohibition. Recipient classes and the limits each paragraph states (purpose,
// extent, listed content) are case facts of the shared vocabulary (module 09).

use self::{
    Disclosure,
    IRC_S6103_D,
    Organ,
    Person,
    Recipient,
    Secretary,
    disclosure_on,
    disclosure_permitted,
    disclosure_to,
    recipient_is,
    state_tax_agency_written_request,
    state_within_6103b5,
};

pub relation d2_state_audit_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the inspection or disclosure is for the purpose of, and only to the extent necessary in, making an audit of the State agency, body, or commission that obtained the returns under paragraph (1) — section 6103(d)(2)(A)";
}

@source(IRC_S6103_D, relation = formalizes, coverage = partial, quote = "Any returns or return information obtained under paragraph (1) by any State agency, body, or commission may be open to inspection by, or disclosure to, officers and employees of the State audit")
rule S6103D2StateAuditAgencyDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, StateAuditAgencyOfficer)
        and d2_state_audit_scope(d);
    then disclosure_permitted(d);
}

pub relation state_agency_audits_state_revenues_and_programs(agency: Organ) kind empirical {
    label en unofficial "case fact: the State agency, body, or commission is charged under the laws of the State with the responsibility of auditing State revenues and programs — section 6103(d)(2)(B)";
}

pub relation state_audit_agency(agency: Organ) kind institutional {
    label en unofficial "the agency is a \"State audit agency\" within the meaning of section 6103(d)(2)(B)";
}

@source(IRC_S6103_D, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"State audit agency\" means any State agency, body, or commission which is charged under the laws of the State with the responsibility of auditing State")
rule S6103D2BStateAuditAgencyDefinition strict {
    for agency: Organ;
    when state_within_6103b5(agency) and state_agency_audits_state_revenues_and_programs(agency);
    then state_audit_agency(agency);
}

pub relation d3_recovered_taxes_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is confined to the amount of recovered taxes with respect to which a section 7624 payment may be made to the State or local law enforcement agency — section 6103(d)(3)";
}

@source(IRC_S6103_D, relation = formalizes, coverage = partial, quote = "Nothing in this section shall be construed to prevent the Secretary from disclosing to any State or local law enforcement agency which may receive a payment under section 7624 the amount of the")
rule S6103D3RecoveredTaxesToLawEnforcementDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, LawEnforcementAgencyPayee7624)
        and d3_recovered_taxes_scope(d);
    then disclosure_permitted(d);
}

// (d)(4): the Secretary may not disclose under (d)(1) to a State agency during any
// period in which no death-information contract with the Secretary of Health and
// Human Services is in effect. The bar defeats the (d)(1) exception (module 02
// carries the matching `unless`) and is at the same time a prohibition addressed to
// the Secretary (the action is the disclosure itself, so it is VIOLATED when a
// disclosure to the State agency is established while the bar stands).

pub relation death_contract_requires_state_to_furnish_death_certificate_information(agency: Organ) kind empirical {
    label en unofficial "case fact: the contract between the State and the Secretary of Health and Human Services requires the State to furnish information concerning individuals with respect to whom death certificates (or equivalent documents) have been officially filed with it — section 6103(d)(4)(B)(i)";
}

pub relation death_contract_has_no_use_restriction_beyond_erroneous_payment_control(agency: Organ) kind empirical {
    label en unofficial "case fact: the contract includes no restriction on the use of the information obtained by the Secretary of Health and Human Services, except that it may confine the use to ensuring that Federal benefits or other payments are not erroneously paid to deceased individuals — section 6103(d)(4)(B)(ii)";
}

pub relation death_contract_in_effect_between_state_and_hhs(agency: Organ) kind empirical {
    label en unofficial "case fact: a contract between the State and the Secretary of Health and Human Services is in effect during the period in question — section 6103(d)(4)(A)";
}

pub relation state_not_furnishing_death_information_on_1993_07_01(agency: Organ) kind empirical {
    label en unofficial "case fact: on July 1, 1993 the State was not, pursuant to a contract, furnishing the Secretary of Health and Human Services information concerning individuals with respect to whom death certificates have been officially filed — section 6103(d)(4)(C)";
}

pub relation disclosed_to_state_tax_agency_under_d1(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure d was made to a State agency, body, or commission (or its legal representative) under section 6103(d)(1)";
}

pub relation qualifying_death_information_contract_in_effect(agency: Organ) kind institutional {
    label en unofficial "the agency's State has a contract in effect with the Secretary of Health and Human Services that meets the requirements of section 6103(d)(4)(B)";
}

@source(IRC_S6103_D, relation = formalizes, coverage = exact, quote = "A contract meets the requirements of this subparagraph if—")
rule S6103D4BQualifyingContract strict {
    for agency: Organ;
    when death_contract_in_effect_between_state_and_hhs(agency)
        and death_contract_requires_state_to_furnish_death_certificate_information(agency)
        and death_contract_has_no_use_restriction_beyond_erroneous_payment_control(agency);
    then qualifying_death_information_contract_in_effect(agency);
}

pub relation state_disclosure_barred_for_want_of_death_contract(d: Disclosure) kind institutional {
    label en unofficial "the disclosure d to a State agency under section 6103(d)(1) is barred by section 6103(d)(4)(A): no qualifying death-information contract is in effect and the (d)(4)(C) exemption does not apply";
}

@source(IRC_S6103_D, relation = formalizes, coverage = exact, quote = "No returns or return information may be disclosed under paragraph (1) to any agency, body, or commission of any State (or any legal representative thereof) during any period during which a contract")
rule S6103D4ABarClassification strict {
    for d: Disclosure;
    for agency: Organ;
    for headOfAgency: Person;
    when state_tax_agency_written_request(d, agency, headOfAgency)
        and not_known(qualifying_death_information_contract_in_effect(agency))
        and not_known(state_exempt_from_death_contract_bar(agency));
    then state_disclosure_barred_for_want_of_death_contract(d);
}
@source(IRC_S6103_D, relation = formalizes, coverage = exact, quote = "The provisions of subparagraph (A) shall not apply to any State which on July 1, 1993, was not, pursuant to a contract, furnishing the Secretary of Health and Human Services information concerning")
rule S6103D4CExemptionNote strict {
    for agency: Organ;
    when state_not_furnishing_death_information_on_1993_07_01(agency);
    then state_exempt_from_death_contract_bar(agency);
}

pub relation state_exempt_from_death_contract_bar(agency: Organ) kind institutional {
    label en unofficial "the State is not subject to the section 6103(d)(4)(A) bar (it was not furnishing death information under a contract on July 1, 1993 — section 6103(d)(4)(C))";
}

@source(IRC_S6103_D, relation = formalizes, coverage = exact, quote = "No returns or return information may be disclosed under paragraph (1) to any agency, body, or commission of any State (or any legal representative thereof) during any period during which a contract")
rule S6103D4ASecretaryBarRule strict {
    for d: Disclosure;
    for agency: Organ;
    for headOfAgency: Person;
    when state_tax_agency_written_request(d, agency, headOfAgency)
        and state_disclosure_barred_for_want_of_death_contract(d);
    then prohibition S6103D4ADisclosureBar {
        bearer Secretary;
        action disclosed_to_state_tax_agency_under_d1(d);
        window [-infinity, infinity];
    };
}

// (d)(5): combined Federal and State employment tax reporting. The sunset of (d)(5)(B)
// is a window on the permission (disclosures on or before December 31, 2007). The
// second sentence of (A) (subsections (a)(2), (p)(4) and sections 7213, 7213A do not
// apply to these disclosures) is not carried into the bearer classes, which are case
// facts (module 00): a case must not assert `state_officer_with_access` for a
// recipient whose only access is this paragraph. Coverage note: INTERPRETATION.

pub relation d5_combined_reporting_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of taxpayer identity information and signatures to a State agency, body, or commission for the purpose of carrying out a combined Federal and State employment tax reporting program approved by the Secretary — section 6103(d)(5)(A)";
}

@source(IRC_S6103_D, relation = formalizes, coverage = partial, quote = "The Secretary may disclose taxpayer identity information and signatures to any agency, body, or commission of any State for the purpose of carrying out with such agency, body, or commission a")
@source(IRC_S6103_D, relation = formalizes, coverage = exact, quote = "The Secretary may not make any disclosure under this paragraph after December 31, 2007.")
rule S6103D5CombinedReportingDisclosurePermitted strict {
    for d: Disclosure;
    for on: Date;
    when recipient_is(d, StateAgencyCombinedEmploymentReporting)
        and d5_combined_reporting_scope(d)
        and disclosure_on(d, on)
        and on <= @2007-12-31;
    then disclosure_permitted(d);
}

// (d)(6): an entity described in (b)(5)(A)(iii) (a regional income tax agency of
// member municipalities). The class itself is a case fact: the (b)(5)(A)(ii)-(iii)
// municipality extension is a stage-1 technical gap (population data, TECH-GAPS
// G172). The redisclosure ban is a prohibition of the recipient entity.

pub relation d6_regional_agency_purpose_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the inspection by or disclosure to an entity described in section 6103(b)(5)(A)(iii) is for the purpose of, and only to the extent necessary in, the administration of the laws of the member municipalities relating to the imposition of a tax on income or wages — section 6103(d)(6)";
}

pub relation d6_regional_agency_redisclosed_to_member_municipality(d: Disclosure) kind empirical {
    label en unofficial "case fact: the entity redisclosed the returns or return information received under paragraph (1) to a member municipality";
}

@source(IRC_S6103_D, relation = formalizes, coverage = partial, quote = "For purposes of paragraph (1), inspection by or disclosure to an entity described in subsection (b)(5)(A)(iii) shall be for the purpose of, and only to the extent necessary in, the administration of")
rule S6103D6RegionalAgencyDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, RegionalIncomeTaxAgency) and d6_regional_agency_purpose_scope(d);
    then disclosure_permitted(d);
}
@source(IRC_S6103_D, relation = formalizes, coverage = exact, quote = "Such entity may not redisclose any return or return information received pursuant to paragraph (1) to any such member municipality.")
rule S6103D6NoRedisclosureRule strict {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, RegionalIncomeTaxAgency)
        and d6_regional_agency_purpose_scope(d);
    then prohibition S6103D6NoRedisclosure {
        bearer recipient;
        action d6_regional_agency_redisclosed_to_member_municipality(d);
        window [-infinity, infinity];
    };
}
