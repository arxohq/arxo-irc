// 26 U.S.C. §6103(p)(3)-(4) — Records of inspection and disclosure, and
// safeguards. STAGE 1 PARTIAL: (p)(4)'s safeguards conditions (A)-(E) are
// modeled as ONE consolidated maintenance duty (a judgment call — the
// statute lists five distinct record/area/access/other-safeguard/report
// requirements; this stage does not give each its own bearer-observable
// case fact, see report) plus the Secretary's power to withhold further
// disclosure on noncompliance (E-0239 pattern). (p)(3)(A)'s recordkeeping
// duty is modeled for the Secretary only, not (p)(3)(B)/(C)'s own report
// deadlines (90 days — TECH_GAP-adjacent, deferred to a later stage: see
// coverage row 26/6103/p/3/b). (p)(1)/(2)/(5)-(9) are `unreviewed`.

// ---------------------------------------------------------------------
// (p)(4) Safeguards
// ---------------------------------------------------------------------

use self::{
    Congress,
    Disclosure,
    IRC_S6103_P,
    Organ,
    Secretary,
};

pub relation receives_returns_or_return_information(recipient: Organ, d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient organ is a Federal agency, the Government Accountability Office, the Congressional Budget Office, a State agency described in subsection (d), or another entity section 6103(p)(4) enumerates, which received returns or return information under disclosure d";
}

pub relation safeguards_required(recipient: Organ) kind institutional {
    label en unofficial "the recipient is subject to the section 6103(p)(4) safeguards duties as a condition of receiving returns or return information";
}
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "shall, as a condition for receiving returns or return information")
rule S6103P4SafeguardsRequiredClassification strict {
    for recipient: Organ;
    for d: Disclosure;
    when receives_returns_or_return_information(recipient, d);
    then safeguards_required(recipient);
}

pub relation maintains_p4_safeguards(recipient: Organ) kind empirical {
    label en unofficial "case fact: the recipient establishes and maintains the (p)(4)(A)-(E) system of records, secure area, access restriction, other Secretary-prescribed safeguards, and furnishes the required report, to the Secretary's satisfaction — a consolidated case fact for this stage (see module header judgment call)";
}
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "establish and maintain, to the satisfaction of the Secretary, a permanent system of standardized records with respect to any request, the reason for such request, and the date of such request made by or of it and any disclosure of return or return information made by or to it;")
rule S6103P4SafeguardsDutyRule strict {
    for recipient: Organ;
    for d: Disclosure;
    when safeguards_required(recipient) and receives_returns_or_return_information(recipient, d);
    then duty S6103P4SafeguardsDuty {
        bearer recipient;
        beneficiary Secretary;
        goal maintenance {
            condition maintains_p4_safeguards(recipient);
            window [-infinity, infinity];
        }
    };
}

// The Secretary's power to withhold further disclosure on noncompliance.
external judgment relation secretary_determines_agency_failed_safeguards(recipient: Organ) {
    authority Secretary;
    label en official "the Secretary determines that the agency, body, or commission has failed to, or does not, meet the safeguards requirements of section 6103(p)(4), after any (p)(7) administrative review proceedings";
}
pub relation secretary_withholds_further_disclosure(recipient: Organ) kind empirical {
    label en unofficial "the Secretary's exercise of the section 6103(p)(4) power: refusing to disclose returns or return information to the noncompliant recipient until the Secretary determines the requirements have been or will be met";
}
@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "he may, after any proceedings for review established under paragraph (7), take such actions as are necessary to ensure such requirements are met, including refusing to disclose returns or return information to such agency, body, or commission")
rule S6103P4WithholdDisclosurePowerRule strict {
    for recipient: Organ;
    when secretary_determines_agency_failed_safeguards(recipient) and secretary_withholds_further_disclosure(recipient);
    then power S6103P4WithholdDisclosurePower {
        holder Secretary;
        over recipient;
        exercise secretary_withholds_further_disclosure(recipient);
        valid_when secretary_determines_agency_failed_safeguards(recipient);
        effect create(safeguards_noncompliance_bar(recipient));
    };
}
pub relation safeguards_noncompliance_bar(recipient: Organ) kind institutional {
    label en unofficial "the legal effect of a valid section 6103(p)(4) withholding power exercise: further disclosure to this recipient is barred until the Secretary determines the safeguards requirements have been or will be met";
}

// ---------------------------------------------------------------------
// (p)(3)(A) Records of inspection and disclosure — the Secretary's own
// recordkeeping duty (main clause only; the extensive list of
// subsections excepted from the recordkeeping requirement in the second
// sentence is NOT modeled — TECH_GAP-adjacent enumeration, see report).
// ---------------------------------------------------------------------

pub relation maintains_p3_recordkeeping_system(secretary: Organ) kind empirical {
    label en unofficial "case fact: the Secretary maintains the permanent system of standardized records or accountings of requests for, and inspections/disclosures of, returns and return information required by section 6103(p)(3)(A)";
}
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "the Secretary shall maintain a permanent system of standardized records or accountings of all requests for inspection or disclosure of returns and return information (including the reasons for and dates of such requests) and of returns and return information inspected or disclosed under this section and section 6104(c).")
rule S6103P3RecordkeepingDutyRule strict {
    then duty S6103P3RecordkeepingDuty {
        bearer Secretary;
        beneficiary Congress;
        goal maintenance {
            condition maintains_p3_recordkeeping_system(Secretary);
            window [-infinity, infinity];
        }
    };
}
