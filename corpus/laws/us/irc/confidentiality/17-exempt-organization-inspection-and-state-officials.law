// 26 U.S.C. §6104(a)-(c) and the remainder of (d) — public inspection of applications for tax
// exemption and notices of status, of pension plan applications, of annual returns, and of
// section 527(j) reports; publication to State officials; and the exceptions from and definitions
// of (d). STAGE 2 (module 06 carries (d)(1), (d)(2), (d)(4)). "Shall be open to public
// inspection" is a duty of the Secretary owed to the person who asks; what the Secretary is not
// required to disclose is a liberty to withhold (the negation of the duty), and what the
// Secretary is barred from disclosing (contributor names and addresses) is a prohibition. The
// State-officer disclosures are permissions (defeaters of the section 6103(a) prohibition),
// each cut back by the Secretary's section 6104(c)(5) impairment determination (an external
// judgment relation). `exempt-organizations` (section 501, 527, 509, 6033) is not imported: the
// organization statuses are case facts (module 06 placeholders), pending in the dependency file.

use self::{
    Disclosure,
    IRC_S6104_A,
    IRC_S6104_B,
    IRC_S6104_C,
    IRC_S6104_D,
    Person,
    Recipient,
    Return,
    ReturnInformation,
    Secretary,
    annual_return_in_3_year_window,
    deadline_for_527i_notice_for_duty,
    described_501c_or_d_or_527a,
    disclosure_permitted,
    disclosure_to,
    disclosure_upon_written_request,
    public_inspection_required,
    recipient_is,
};

pub entity PublicInspectionDocument {
    label en unofficial "an application, notice of status, supporting paper, letter or other document, annual return, or report that section 6104 opens to public inspection"; 
}

pub relation inspection_requested_by(doc: PublicInspectionDocument, requester: Person) kind empirical {
    label en unofficial "case fact: this person asked to inspect the document (or, where the paragraph says so, for a copy or statement about it)";
}

pub relation inspection_or_copy_made_available_to(doc: PublicInspectionDocument, requester: Person) kind empirical {
    label en unofficial "case fact: the Secretary made the document available for inspection (or furnished the copy or statement) to this person";
}

pub relation exemption_application_or_notice_document_of(doc: PublicInspectionDocument, org: Person) kind empirical {
    label en unofficial "case fact: the document is the application filed by the organization on which the Secretary made his determination of exemption under section 501(a), or its notice of status under section 527(i), together with any papers submitted in support of it, or any letter or other document the Internal Revenue Service issued with respect to it — section 6104(a)(1)(A)";
}

pub relation application_or_notice_filed_after_enactment_of_a1a(doc: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the application or notice was filed after the date of the enactment of subparagraph (A) (the date is set by the enacting Public Law, a statutory note this package pins only as the row for that note)";
}

@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "If an organization described in section 501(c) or (d) is exempt from taxation under section 501(a) for any taxable year or a political organization is exempt from taxation under section 527 for any taxable year, the application filed by the organization with")
rule S6104A1AInspectionDutyRule strict {
    for doc: PublicInspectionDocument;
    for org: Person;
    for requester: Person;
    when exemption_application_or_notice_document_of(doc, org)
        and described_501c_or_d_or_527a(org)
        and inspection_requested_by(doc, requester);
    then duty S6104A1AInspectionDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition inspection_or_copy_made_available_to(doc, requester);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "In the case of any application or notice filed after the date of the enactment of this subparagraph, a copy of such application or notice and such letter or document shall be open to public inspection at the appropriate field office of the Internal Revenue Service (determined under regulations prescribed by the Secretary).")
rule S6104A1AFieldOfficeCopyDutyRule strict {
    for doc: PublicInspectionDocument;
    for org: Person;
    for requester: Person;
    when exemption_application_or_notice_document_of(doc, org)
        and described_501c_or_d_or_527a(org)
        and application_or_notice_filed_after_enactment_of_a1a(doc)
        and inspection_requested_by(doc, requester);
    then duty S6104A1AFieldOfficeCopyDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition inspection_or_copy_made_available_to(doc, requester);
            window [-infinity, infinity];
        }
    };
}

pub relation exemption_application_opened_to_public_inspection(doc: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the application for exemption from tax under section 501(a) has been opened to public inspection under subparagraph (A)";
}

pub relation statement_of_501_subsection_and_paragraph_furnished_to(org: Person, requester: Person) kind empirical {
    label en unofficial "case fact: the Secretary furnished the statement indicating the subsection and paragraph of section 501 which it has been determined describes the organization";
}

pub relation statement_requested_by(org: Person, requester: Person) kind empirical {
    label en unofficial "case fact: this person requested the statement with respect to the organization";
}

@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "After the application of any organization for exemption from taxation under section 501(a) has been opened to public inspection under this subparagraph, the Secretary shall, on the request of any person with respect to such organization, furnish a statement indicating the subsection and paragraph of section 501 which it has been determined describes such organization.")
rule S6104A1AStatementDutyRule strict {
    for doc: PublicInspectionDocument;
    for org: Person;
    for requester: Person;
    when exemption_application_or_notice_document_of(doc, org)
        and exemption_application_opened_to_public_inspection(doc)
        and statement_requested_by(org, requester);
    then duty S6104A1AStatementDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition statement_of_501_subsection_and_paragraph_furnished_to(org, requester);
            window [-infinity, infinity];
        }
    };
}

pub relation pension_plan_document_of(doc: PublicInspectionDocument, plan: Person) kind empirical {
    label en unofficial "case fact: the document is an application with respect to the qualification of a pension, profit-sharing, or stock bonus plan under section 401(a) or 403(a), an individual retirement account (section 408(a)) or annuity (section 408(b)), an application for exemption under section 501(a) of an organization forming part of such a plan or account, papers submitted in support, or a letter or document issued by the Internal Revenue Service dealing with the qualification or exemption — section 6104(a)(1)(B)(i)-(iv)";
}

pub relation plan_participant_count(plan: Person, participants: Integer) kind empirical {
    label en unofficial "case fact: the plan has this number of participants";
}

pub relation requester_is_participant_in_plan(requester: Person, plan: Person) kind empirical {
    label en unofficial "case fact: the requester is a participant in the plan";
}

pub relation request_seeks_information_from_which_compensation_may_be_ascertained(doc: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the request is for information from which the compensation (including deferred compensation) of any individual may be ascertained — section 6104(a)(1)(C)";
}

pub relation plan_application_inspectable_by(doc: PublicInspectionDocument, requester: Person) kind institutional {
    label en unofficial "the requester may inspect the plan application: the plan has more than 25 participants, or the requester is a plan participant (section 6104(a)(1)(B), last sentence)";
}

@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "Except in the case of a plan participant, this subparagraph shall not apply to any plan referred to in clause (i) having not more than 25 participants.")
rule S6104A1BInspectableClassification strict {
    for doc: PublicInspectionDocument;
    for plan: Person;
    for requester: Person;
    for participants: Integer;
    when pension_plan_document_of(doc, plan)
        and plan_participant_count(plan, participants)
        and (participants > 25 or requester_is_participant_in_plan(requester, plan));
    then plan_application_inspectable_by(doc, requester);
}

@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "The following shall be open to public inspection at such times and in such places as the Secretary may prescribe:")
@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "(i) any application filed with respect to the qualification of a pension, profit-sharing, or stock bonus plan under section 401(a) or 403(a), an individual retirement account described in section 408(a), or an individual retirement annuity described")
@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "(ii) any application filed with respect to the exemption from tax under section 501(a) of an organization forming part of a plan or account referred to in clause (i),")
@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "(iii) any papers submitted in support of an application referred to in clause (i) or (ii), and")
@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "(iv) any letter or other document issued by the Internal Revenue Service and dealing with the qualification referred to in clause (i) or the exemption from tax referred to in clause (ii).")
@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "In the case of any application, document, or other papers, referred to in subparagraph (B), information from which the compensation (including deferred compensation) of any individual may be ascertained shall not be open to public inspection under")
rule S6104A1BPensionPlanInspectionDutyRule defeasible {
    for doc: PublicInspectionDocument;
    for requester: Person;
    when plan_application_inspectable_by(doc, requester)
        and inspection_requested_by(doc, requester);
    then duty S6104A1BPensionPlanInspectionDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition inspection_or_copy_made_available_to(doc, requester);
            window [-infinity, infinity];
        }
    };
    unless request_seeks_information_from_which_compensation_may_be_ascertained(doc)
        and inspection_requested_by(doc, requester);
}

external judgment relation secretary_determines_information_relates_to_trade_secret_and_disclosure_would_adversely_affect_organization(doc: PublicInspectionDocument) {
    authority Secretary;
    label en official "the Secretary determines that information in the supporting papers relates to a trade secret, patent, process, style of work, or apparatus of the organization and that public disclosure would adversely affect the organization — section 6104(a)(1)(D), first sentence";
}

external judgment relation secretary_determines_disclosure_would_adversely_affect_national_defense(doc: PublicInspectionDocument) {
    authority Secretary;
    label en official "the Secretary determines that public disclosure of information in the supporting papers would adversely affect the national defense — section 6104(a)(1)(D), second sentence";
}

pub relation organization_requested_withholding_of_supporting_paper_information(doc: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the organization submitting the supporting papers requested that the information be withheld from public inspection";
}

pub relation information_withheld_from_public_inspection(doc: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the Secretary withheld the information from public inspection";
}

@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "Upon request of the organization submitting any supporting papers described in subparagraph (A) or (B), the Secretary shall withhold from public inspection any information contained therein which he determines relates to any trade secret")
rule S6104A1DTradeSecretWithholdingDutyRule strict {
    for doc: PublicInspectionDocument;
    when organization_requested_withholding_of_supporting_paper_information(doc)
        and secretary_determines_information_relates_to_trade_secret_and_disclosure_would_adversely_affect_organization(doc);
    then duty S6104A1DTradeSecretWithholdingDuty {
        bearer Secretary;
        goal achievement {
            condition information_withheld_from_public_inspection(doc);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6104_A, relation = formalizes, coverage = partial, quote = "The Secretary shall withhold from public inspection any information contained in supporting papers described in subparagraph (A) or (B) the public disclosure of which he determines would adversely affect the national defense.")
rule S6104A1DNationalDefenseWithholdingDutyRule strict {
    for doc: PublicInspectionDocument;
    when secretary_determines_disclosure_would_adversely_affect_national_defense(doc);
    then duty S6104A1DNationalDefenseWithholdingDuty {
        bearer Secretary;
        goal achievement {
            condition information_withheld_from_public_inspection(doc);
            window [-infinity, infinity];
        }
    };
}

pub relation application_paper_of_exempt_organization_or_notice_of_527(info: ReturnInformation) kind empirical {
    label en unofficial "case fact: the paper is the application for exemption of an organization described in section 501(c) or (d) that is exempt under 501(a), the notice of status of a political organization exempt under section 527, an application referred to in (a)(1)(B), or any other paper in the possession of the Secretary that relates to such application — section 6104(a)(2)(A)-(B)";
}

pub relation treated_as_return_for_section_6103f(info: ReturnInformation) kind institutional {
    label en unofficial "the paper is treated as a return for the purposes of section 6103(f)";
}

@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "Section 6103(f) shall apply with respect to—")
@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "(A) the application for exemption of any organization described in section 501(c) or (d) which is exempt from taxation under section 501(a) for any taxable year or notice of status of any political organization which is exempt from taxation under")
@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "(B) any other papers which are in the possession of the Secretary and which relate to such application,")
@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "as if such papers constituted returns.")
rule S6104A2TreatedAsReturnFor6103f strict {
    for info: ReturnInformation;
    when application_paper_of_exempt_organization_or_notice_of_527(info);
    then treated_as_return_for_section_6103f(info);
}

pub relation notice_of_status_under_527i_received_on(org: Person, receivedOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary received a notice from the political organization under section 527(i) on this date";
}

pub relation five_business_day_deadline_for_527i_notice(org: Person, due: Date) kind empirical {
    label en unofficial "case fact: the date five business days after the Secretary received the section 527(i) notice (business days need the federal calendar snapshot, which this package does not pin — TECH-GAPS, see the coverage row)";
}

pub relation political_organization_information_made_public_on(org: Person, madePublicOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary made the list of political organizations and the name, address, electronic mailing address, custodian of records, and contact person publicly available on the Internet and at the offices of the Internal Revenue Service on this date";
}

pub relation political_organization_information_public_in_time(org: Person) kind institutional {
    label en unofficial "the information about the political organization was made publicly available not later than 5 business days after the notice was received";
}

@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "The Secretary shall make available the information required under subparagraph (A) not later than 5 business days after the Secretary receives a notice from a political organization under section 527(i).")
rule S6104A3BPublicInTimeClassification strict {
    for org: Person;
    for madeOn: Date;
    for due: Date;
    when political_organization_information_made_public_on(org, madeOn)
        and deadline_for_527i_notice_for_duty(org, due)
        and madeOn <= due;
    then political_organization_information_public_in_time(org);
}

@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "The Secretary shall make publicly available, on the Internet and at the offices of the Internal Revenue Service—")
@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "(i) a list of all political organizations which file a notice with the Secretary under section 527(i), and")
@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "(ii) the name, address, electronic mailing address, custodian of records, and contact person for such organization.")
@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "The Secretary shall make available the information required under subparagraph (A) not later than 5 business days after the Secretary receives a notice from a political organization under section 527(i).")
rule S6104A3PublicListDutyRule strict {
    for org: Person;
    for receivedOn: Date;
    for due: Date;
    when notice_of_status_under_527i_received_on(org, receivedOn)
        and deadline_for_527i_notice_for_duty(org, due);
    then duty S6104A3PublicListDuty {
        bearer Secretary;
        goal achievement {
            condition political_organization_information_public_in_time(org);
            window [receivedOn, due];
        }
    };
}

pub relation annual_return_of(ret: Return, org: Person) kind empirical {
    label en unofficial "case fact: the annual return (or information required to be furnished) is this organization's or trust's under section 6033, 6034, or 6058 — section 6104(b)";
}

pub relation annual_return_information_required_by_6033_6034_or_6058(ret: Return) kind empirical {
    label en unofficial "case fact: the return contains the information required to be furnished by section 6033, 6034, or 6058";
}

pub relation section_511_annual_return_of_501c3_filed_under_6011(ret: Return) kind empirical {
    label en unofficial "case fact: the annual return is filed under section 6011 by an organization described in section 501(c)(3) and relates to a tax imposed by section 511 (unrelated business income tax)";
}

pub relation annual_return_treated_as_furnished_under_6033(ret: Return) kind institutional {
    label en unofficial "the annual return is treated for purposes of subsection (b) in the same manner as if furnished under section 6033";
}

@source(IRC_S6104_B, relation = formalizes, coverage = partial, quote = "Any annual return which is filed under section 6011 by an organization described in section 501(c)(3) and which relates to any tax imposed by section 511 (relating to imposition of tax on unrelated business income of charitable, etc., organizations) shall be treated for purposes of this subsection in the same manner as if furnished under section 6033.")
rule S6104BUnrelatedBusinessReturnTreatedAsSection6033 strict {
    for ret: Return;
    when section_511_annual_return_of_501c3_filed_under_6011(ret);
    then annual_return_treated_as_furnished_under_6033(ret);
}

pub relation public_request_for_annual_return(ret: Return, requester: Person) kind empirical {
    label en unofficial "case fact: a member of the public asked for the annual return information";
}

pub relation annual_return_information_made_available_to_public(ret: Return, requester: Person) kind empirical {
    label en unofficial "case fact: the Secretary made the information available to the requester";
}

pub relation annual_return_is_6031b_copy_of_501d_organization(ret: Return) kind empirical {
    label en unofficial "case fact: the return is a copy referred to in section 6031(b) of an organization described in section 501(d) — section 6104(b), third sentence";
}

@source(IRC_S6104_B, relation = formalizes, coverage = partial, quote = "The information required to be furnished by sections 6033, 6034, and 6058, together with the names and addresses of such organizations and trusts, shall be made available to the public at such times and in such places as the Secretary may prescribe.")
rule S6104BAvailabilityDutyRule defeasible {
    for ret: Return;
    for requester: Person;
    when (annual_return_information_required_by_6033_6034_or_6058(ret) or annual_return_treated_as_furnished_under_6033(ret))
        and public_request_for_annual_return(ret, requester);
    then duty S6104BAvailabilityDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition annual_return_information_made_available_to_public(ret, requester);
            window [-infinity, infinity];
        }
    };
    unless annual_return_is_6031b_copy_of_501d_organization(ret)
        and public_request_for_annual_return(ret, requester);
}

pub relation secretary_disclosed_contributor_name_or_address(ret: Return) kind empirical {
    label en unofficial "case fact: the Secretary disclosed the name or address of a contributor to the organization or trust";
}

pub relation organization_is_private_foundation_or_political_organization_under_527(org: Person) kind empirical {
    label en unofficial "case fact: the organization is a private foundation (section 509(a)) or a political organization exempt under section 527";
}

@source(IRC_S6104_B, relation = formalizes, coverage = partial, quote = "Nothing in this subsection shall authorize the Secretary to disclose the name or address of any contributor to any organization or trust (other than a private foundation, as defined in section 509(a) or a political organization exempt from taxation under section 527) which is required to furnish such information.")
rule S6104BContributorIdentityBarRule strict {
    for ret: Return;
    for org: Person;
    when annual_return_of(ret, org)
        and not_known(organization_is_private_foundation_or_political_organization_under_527(org));
    then prohibition S6104BContributorIdentityBar {
        bearer Secretary;
        action secretary_disclosed_contributor_name_or_address(ret);
        window [-infinity, infinity];
    };
}

pub relation annual_return_information_concerns_beneficiaries_not_170c_organizations_of_6034a_trust(ret: Return) kind empirical {
    label en unofficial "case fact: the information regards beneficiaries of a trust required to file under section 6034(a) that are not organizations described in section 170(c)";
}

pub relation secretary_withholds_non_170c_beneficiary_information(ret: Return) kind empirical {
    label en unofficial "case fact: the Secretary withholds the information regarding non-170(c) beneficiaries";
}

@source(IRC_S6104_B, relation = formalizes, coverage = partial, quote = "In the case of a trust which is required to file a return under section 6034(a), this subsection shall not apply to information regarding beneficiaries which are not organizations described in section 170(c).")
rule S6104BNon170cBeneficiariesLibertyRule strict {
    for ret: Return;
    when annual_return_information_concerns_beneficiaries_not_170c_organizations_of_6034a_trust(ret);
    then liberty S6104BNon170cBeneficiariesLiberty {
        holder Secretary;
        action secretary_withholds_non_170c_beneficiary_information(ret);
        window [-infinity, infinity];
    };
}

pub relation annual_return_made_available_in_machine_readable_format(ret: Return) kind empirical {
    label en unofficial "case fact: the Secretary made the electronically filed annual return available to the public as soon as practicable in a machine readable format";
}

pub relation annual_return_required_to_be_filed_electronically_under_6033n(ret: Return) kind empirical {
    label en unofficial "case fact: the annual return is required to be filed electronically under section 6033(n)";
}

@source(IRC_S6104_B, relation = formalizes, coverage = partial, quote = "Any annual return required to be filed electronically under section 6033(n) shall be made available by the Secretary to the public as soon as practicable in a machine readable format.")
rule S6104BMachineReadableDutyRule strict {
    for ret: Return;
    when annual_return_required_to_be_filed_electronically_under_6033n(ret);
    then duty S6104BMachineReadableDuty {
        bearer Secretary;
        goal achievement {
            condition annual_return_made_available_in_machine_readable_format(ret);
            window [-infinity, infinity];
        }
    };
}

pub relation state_attorney_general(person: Person) kind empirical {
    label en unofficial "case fact: the person is a State attorney general — section 6104(c)(6)(B)(i)";
}

pub relation state_tax_officer(person: Person) kind empirical {
    label en unofficial "case fact: the person is a State tax officer — section 6104(c)(6)(B)(ii)";
}

pub relation state_official_charged_with_overseeing_501c3_organizations(person: Person) kind empirical {
    label en unofficial "case fact: the person is another State official charged with overseeing organizations of the type described in section 501(c)(3) — section 6104(c)(6)(B)(iii)";
}

pub relation head_of_agency_designated_by_state_attorney_general_for_charitable_solicitation(person: Person) kind empirical {
    label en unofficial "case fact: the person is the head of an agency designated by the State attorney general as having primary responsibility for overseeing the solicitation of funds for charitable purposes — section 6104(c)(6)(B)(iv)";
}

pub relation organization_subject_to_c1(org: Person) kind empirical {
    label en unofficial "case fact: the organization is described in section 501(c)(3) and exempt from taxation under section 501(a), or has applied under section 508(a) for recognition as such an organization — section 6104(c)(1)";
}

pub relation organization_subject_to_c3(org: Person) kind empirical {
    label en unofficial "case fact: the organization is described in section 501(c) other than paragraph (1) or (3) — section 6104(c)(3)";
}

pub relation appropriate_state_officer(person: Person, org: Person) kind institutional {
    label en unofficial "the person is an \"appropriate State officer\" for the organization within the meaning of section 6104(c)(6)(B)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = exact, quote = "(i) the State attorney general,")
rule S6104C6BiAttorneyGeneralIsAppropriateOfficer strict {
    for person: Person;
    for org: Person;
    when state_attorney_general(person)
        and organization_regulated_by_state(org);
    then appropriate_state_officer(person, org);
}

pub relation organization_regulated_by_state(org: Person) kind empirical {
    label en unofficial "case fact: the organization is one the State regulates (the organization about which the State officer is acting)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = exact, quote = "(ii) the State tax officer,")
rule S6104C6BiiTaxOfficerIsAppropriateOfficer strict {
    for person: Person;
    for org: Person;
    when state_tax_officer(person)
        and organization_regulated_by_state(org);
    then appropriate_state_officer(person, org);
}

@source(IRC_S6104_C, relation = formalizes, coverage = exact, quote = "(iii) in the case of an organization to which paragraph (1) applies, any other State official charged with overseeing organizations of the type described in section 501(c)(3), and")
rule S6104C6BiiiOverseerIsAppropriateOfficerForC1Organization strict {
    for person: Person;
    for org: Person;
    when state_official_charged_with_overseeing_501c3_organizations(person)
        and organization_subject_to_c1(org);
    then appropriate_state_officer(person, org);
}

@source(IRC_S6104_C, relation = formalizes, coverage = exact, quote = "(iv) in the case of an organization to which paragraph (3) applies, the head of an agency designated by the State attorney general as having primary responsibility for overseeing the solicitation of funds for charitable purposes.")
rule S6104C6BivSolicitationOverseerIsAppropriateOfficerForC3Organization strict {
    for person: Person;
    for org: Person;
    when head_of_agency_designated_by_state_attorney_general_for_charitable_solicitation(person)
        and organization_subject_to_c3(org);
    then appropriate_state_officer(person, org);
}

pub relation c1_refusal_to_recognize_or_nonconforming_operation(org: Person) kind empirical {
    label en unofficial "case fact: the Secretary refused to recognize the organization as an organization described in section 501(c)(3), or the organization operates in a manner which does not meet, or no longer meets, the requirements of its exemption — section 6104(c)(1)(A)";
}

pub relation c1_notice_of_deficiency_mailed_under_507_or_chapter_41_or_42(org: Person) kind empirical {
    label en unofficial "case fact: a notice of deficiency of tax imposed under section 507 or chapter 41 or 42 was mailed — section 6104(c)(1)(B)";
}

pub relation c1_state_officer_notified_of_refusal_or_nonconformity(org: Person, officer: Person) kind empirical {
    label en unofficial "case fact: the Secretary notified the appropriate State officer of the refusal or nonconforming operation";
}

pub relation c1_state_officer_notified_of_notice_of_deficiency(org: Person, officer: Person) kind empirical {
    label en unofficial "case fact: the Secretary notified the appropriate State officer of the mailing of the notice of deficiency";
}

external judgment relation secretary_determines_c5_disclosure_would_seriously_impair_federal_tax_administration(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that disclosure under section 6104(c) (or in a proceeding under (c)(4)) would seriously impair Federal tax administration — section 6104(c)(5)";
}

external judgment relation secretary_determines_c5_impairment_for_c1_disclosure(org: Person, officer: Person) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure to the appropriate State officer under section 6104(c)(1) would seriously impair Federal tax administration — section 6104(c)(5)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = partial, quote = "In the case of any organization which is described in section 501(c)(3) and exempt from taxation under section 501(a), or has applied under section 508(a) for recognition as an organization described in section 501(c)(3), the Secretary at such times and in")
@source(IRC_S6104_C, relation = formalizes, coverage = exact, quote = "(A) notify the appropriate State officer of a refusal to recognize such organization as an organization described in section 501(c)(3), or of the operation of such organization in a manner which does not meet, or no longer meets, the requirements of")
rule S6104C1ARefusalNoticeDutyRule defeasible {
    for org: Person;
    for officer: Person;
    when organization_subject_to_c1(org)
        and c1_refusal_to_recognize_or_nonconforming_operation(org)
        and appropriate_state_officer(officer, org);
    then duty S6104C1ARefusalNoticeDuty {
        bearer Secretary;
        beneficiary officer;
        goal achievement {
            condition c1_state_officer_notified_of_refusal_or_nonconformity(org, officer);
            window [-infinity, infinity];
        }
    };
    unless secretary_determines_c5_impairment_for_c1_disclosure(org, officer)
        and organization_subject_to_c1(org)
        and c1_refusal_to_recognize_or_nonconforming_operation(org)
        and appropriate_state_officer(officer, org);
}

@source(IRC_S6104_C, relation = formalizes, coverage = exact, quote = "(B) notify the appropriate State officer of the mailing of a notice of deficiency of tax imposed under section 507 or chapter 41 or 42, and")
rule S6104C1BDeficiencyNoticeDutyRule defeasible {
    for org: Person;
    for officer: Person;
    when organization_subject_to_c1(org)
        and c1_notice_of_deficiency_mailed_under_507_or_chapter_41_or_42(org)
        and appropriate_state_officer(officer, org);
    then duty S6104C1BDeficiencyNoticeDuty {
        bearer Secretary;
        beneficiary officer;
        goal achievement {
            condition c1_state_officer_notified_of_notice_of_deficiency(org, officer);
            window [-infinity, infinity];
        }
    };
    unless secretary_determines_c5_impairment_for_c1_disclosure(org, officer)
        and organization_subject_to_c1(org)
        and c1_notice_of_deficiency_mailed_under_507_or_chapter_41_or_42(org)
        and appropriate_state_officer(officer, org);
}

pub relation c1_request_by_appropriate_state_officer_for_inspection_and_copying(org: Person, officer: Person) kind empirical {
    label en unofficial "case fact: the appropriate State officer requested that the returns, filed statements, records, reports, and other information relating to a determination under (A) or (B), relevant to any determination under State law, be made available for inspection and copying";
}

pub relation c1_records_made_available_to_state_officer(org: Person, officer: Person) kind empirical {
    label en unofficial "case fact: the Secretary made the requested returns and information available for inspection and copying";
}

@source(IRC_S6104_C, relation = formalizes, coverage = exact, quote = "(C) at the request of such appropriate State officer, make available for inspection and copying such returns, filed statements, records, reports, and other information, relating to a determination under subparagraph (A) or (B) as are relevant to any determination under State law.")
rule S6104C1CInspectionDutyRule defeasible {
    for org: Person;
    for officer: Person;
    when organization_subject_to_c1(org)
        and appropriate_state_officer(officer, org)
        and c1_request_by_appropriate_state_officer_for_inspection_and_copying(org, officer);
    then duty S6104C1CInspectionDuty {
        bearer Secretary;
        beneficiary officer;
        goal achievement {
            condition c1_records_made_available_to_state_officer(org, officer);
            window [-infinity, infinity];
        }
    };
    unless secretary_determines_c5_impairment_for_c1_disclosure(org, officer)
        and organization_subject_to_c1(org)
        and appropriate_state_officer(officer, org)
        and c1_request_by_appropriate_state_officer_for_inspection_and_copying(org, officer);
}

pub relation disclosure_about_organization(d: Disclosure, org: Person) kind empirical {
    label en unofficial "case fact: the returns or return information disclosed concern this organization";
}

pub relation disclosure_to_appropriate_state_officer(d: Disclosure) kind institutional {
    label en unofficial "the disclosure d is made to a person who is an appropriate State officer for the organization concerned";
}

@source(IRC_S6104_C, relation = formalizes, coverage = partial, quote = "In the case of an organization to which paragraph (1) applies, the Secretary may disclose to the appropriate State")
rule S6104CDisclosureToAppropriateStateOfficerClassification strict {
    for d: Disclosure;
    for officer: Person;
    for org: Person;
    when disclosure_to(d, officer)
        and disclosure_about_organization(d, org)
        and appropriate_state_officer(officer, org);
    then disclosure_to_appropriate_state_officer(d);
}

pub relation c2a_notifications_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary discloses to the appropriate State officer, for an organization to which paragraph (1) applies, a notice of proposed refusal to recognize the organization as described in section 501(c)(3) or of proposed revocation of its recognition as exempt, the issuance of a letter of proposed deficiency of tax imposed under section 507 or chapter 41 or 42, or the names, addresses, and taxpayer identification numbers of organizations which have applied for recognition as section 501(c)(3) organizations — section 6104(c)(2)(A)(i)-(iii); only for the purpose of, and to the extent necessary in, the administration of State laws regulating such organizations — (C)(ii)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = partial, quote = "(i) a notice of proposed refusal to recognize such organization as an organization described in section 501(c)(3) or a notice of proposed revocation of such organization's recognition as an organization exempt from taxation,")
rule S6104C2AProposedActionNotificationsToStateOfficerDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, AppropriateStateOfficer)
        and disclosure_upon_written_request(d)
        and c2a_notifications_scope(d)
        and disclosure_to_appropriate_state_officer(d);
    then disclosure_permitted(d);
    unless secretary_determines_c5_disclosure_would_seriously_impair_federal_tax_administration(d) and recipient_is(d, AppropriateStateOfficer);
}

pub relation c2b_additional_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: returns and return information of an organization with respect to which information is disclosed under subparagraph (A) are made available for inspection by or disclosed to an appropriate State officer, only for the purpose of, and to the extent necessary in, the administration of State laws regulating such organizations — section 6104(c)(2)(B), (C)(ii)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = partial, quote = "Returns and return information of organizations with respect to which information is disclosed under subparagraph (A) may be made available for inspection by or disclosed to an appropriate State officer.")
rule S6104C2BReturnsAndReturnInformationToStateOfficerDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, AppropriateStateOfficer)
        and disclosure_upon_written_request(d)
        and c2b_additional_scope(d)
        and disclosure_to_appropriate_state_officer(d);
    then disclosure_permitted(d);
    unless secretary_determines_c5_disclosure_would_seriously_impair_federal_tax_administration(d) and recipient_is(d, AppropriateStateOfficer);
}

pub relation c2d_evidence_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary makes available for inspection or discloses returns and return information of an organization to which paragraph (1) applies to an appropriate State officer of any State — section 6104(c)(2)(D)";
}

external judgment relation secretary_determines_returns_may_constitute_evidence_of_noncompliance_under_state_law(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the returns or return information may constitute evidence of noncompliance under the laws within the jurisdiction of the appropriate State officer — section 6104(c)(2)(D)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = partial, quote = "The Secretary may make available for inspection or disclose returns and return information of an organization to which paragraph (1) applies to an appropriate State officer of any State if the Secretary determines that such returns or return")
rule S6104C2DNoncomplianceEvidenceToStateOfficerDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, AppropriateStateOfficer)
        and c2d_evidence_scope(d)
        and secretary_determines_returns_may_constitute_evidence_of_noncompliance_under_state_law(d)
        and disclosure_to_appropriate_state_officer(d);
    then disclosure_permitted(d);
    unless secretary_determines_c5_disclosure_would_seriously_impair_federal_tax_administration(d) and recipient_is(d, AppropriateStateOfficer);
}

pub relation c3_other_exempt_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary makes available for inspection or discloses returns and return information of an organization described in section 501(c) (other than paragraph (1) or (3) organizations) to the appropriate State officer, for the purpose of, and only to the extent necessary in, the administration of State laws regulating the solicitation or administration of the charitable funds or charitable assets of such organizations — section 6104(c)(3)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = partial, quote = "Upon written request by an appropriate State officer, the Secretary may make available for inspection or disclosure returns and return information of any organization described in section 501(c) (other than organizations described in paragraph (1)")
rule S6104C3OtherExemptOrganizationInformationToStateOfficerDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, AppropriateStateOfficer)
        and disclosure_upon_written_request(d)
        and c3_other_exempt_scope(d)
        and disclosure_to_appropriate_state_officer(d);
    then disclosure_permitted(d);
    unless secretary_determines_c5_disclosure_would_seriously_impair_federal_tax_administration(d) and recipient_is(d, AppropriateStateOfficer);
}

pub relation c2c_designated_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the person other than the appropriate State officer is an officer or employee of the State designated by the appropriate State officer to receive the returns or return information on his behalf — section 6104(c)(2)(C), last sentence (and (c)(3), last sentence)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = partial, quote = "Such information may only be inspected by or disclosed to a person other than the appropriate State officer if such person is an officer or employee of the State and is designated by the appropriate State officer to receive the returns or return")
rule S6104C2CDesignatedStateEmployeeOfAppropriateOfficerDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, DesignatedStateEmployee)
        and c2c_designated_scope(d);
    then disclosure_permitted(d);
    unless secretary_determines_c5_disclosure_would_seriously_impair_federal_tax_administration(d) and recipient_is(d, DesignatedStateEmployee);
}

pub relation c4_state_proceedings_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: returns and return information disclosed pursuant to subsection (c) are disclosed in a civil administrative or civil judicial proceeding pertaining to the enforcement of State laws regulating such organizations, in a manner prescribed by the Secretary similar to that for tax administration proceedings under section 6103(h)(4)";
}

@source(IRC_S6104_C, relation = formalizes, coverage = partial, quote = "Returns and return information disclosed pursuant to this subsection may be disclosed in civil administrative and civil judicial proceedings pertaining to the enforcement of State laws regulating such organizations in a manner prescribed by the")
rule S6104C4StateEnforcementProceedingDisclosureDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, StateEnforcementProceeding)
        and c4_state_proceedings_scope(d);
    then disclosure_permitted(d);
    unless secretary_determines_c5_disclosure_would_seriously_impair_federal_tax_administration(d) and recipient_is(d, StateEnforcementProceeding);
}

pub relation organization_is_private_foundation_or_political_organization_527(org: Person) kind empirical {
    label en unofficial "case fact: the organization is a private foundation (section 509(a)) or a political organization exempt from taxation under section 527";
}

pub relation organization_is_501d_religious_or_apostolic_organization(org: Person) kind empirical {
    label en unofficial "case fact: the organization is described in section 501(d)";
}

pub relation organization_withholds_contributor_name_or_address(org: Person) kind empirical {
    label en unofficial "case fact: the organization does not disclose the name or address of any contributor";
}

@source(IRC_S6104_D, relation = formalizes, coverage = partial, quote = "In the case of an organization which is not a private foundation (within the meaning of section 509(a)) or a political organization exempt from taxation under section 527, paragraph (1) shall not require the disclosure of the name or address of any contributor to the organization.")
rule S6104D3AContributorIdentityLibertyRule strict {
    for org: Person;
    when described_501c_or_d_or_527a(org)
        and not_known(organization_is_private_foundation_or_political_organization_527(org));
    then liberty S6104D3AContributorIdentityLiberty {
        holder org;
        action organization_withholds_contributor_name_or_address(org);
        window [-infinity, infinity];
    };
}

pub relation organization_withholds_6031b_copies(org: Person) kind empirical {
    label en unofficial "case fact: the organization does not disclose the copies referred to in section 6031(b)";
}

@source(IRC_S6104_D, relation = formalizes, coverage = partial, quote = "In the case of an organization described in section 501(d), paragraph (1) shall not require the disclosure of the copies referred to in section 6031(b) with respect to such organization.")
rule S6104D3A501dCopiesLibertyRule strict {
    for org: Person;
    when organization_is_501d_religious_or_apostolic_organization(org);
    then liberty S6104D3A501dCopiesLiberty {
        holder org;
        action organization_withholds_6031b_copies(org);
        window [-infinity, infinity];
    };
}

pub relation organization_withholds_information_withheld_by_secretary_under_a1d(org: Person) kind empirical {
    label en unofficial "case fact: the organization does not disclose information the Secretary withheld from public inspection under subsection (a)(1)(D)";
}

pub relation information_withheld_by_secretary_under_a1d(org: Person) kind empirical {
    label en unofficial "case fact: the Secretary withheld the information from public inspection under subsection (a)(1)(D)";
}

@source(IRC_S6104_D, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not require the disclosure of any information if the Secretary withheld such information from public inspection under subsection (a)(1)(D).")
rule S6104D3BWithheldInformationLibertyRule strict {
    for org: Person;
    when described_501c_or_d_or_527a(org)
        and information_withheld_by_secretary_under_a1d(org);
    then liberty S6104D3BWithheldInformationLiberty {
        holder org;
        action organization_withholds_information_withheld_by_secretary_under_a1d(org);
        window [-infinity, infinity];
    };
}

pub relation is_application_for_recognition_of_exemption_under_501(doc: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the document is the application for recognition of exemption under section 501";
}

pub relation is_notice_of_status_under_527i(doc: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the document is the notice of status filed under section 527(i)";
}

pub relation is_paper_submitted_in_support_of(doc: PublicInspectionDocument, main: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the document is a paper submitted in support of the main document";
}

pub relation is_irs_letter_or_document_with_respect_to(doc: PublicInspectionDocument, main: PublicInspectionDocument) kind empirical {
    label en unofficial "case fact: the document is a letter or other document issued by the Internal Revenue Service with respect to the main document";
}

pub relation exempt_status_application_materials(doc: PublicInspectionDocument) kind institutional {
    label en unofficial "the document is \"exempt status application materials\" within the meaning of section 6104(d)(5)";
}

@source(IRC_S6104_D, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the term \"exempt status application materials\" means the application for recognition of exemption under section 501 and any papers submitted in support of such application and any letter or other document issued by the Internal Revenue Service with respect to such")
rule S6104D5ExemptStatusApplicationMaterialsDefinition strict {
    for doc: PublicInspectionDocument;
    for main: PublicInspectionDocument;
    when (is_application_for_recognition_of_exemption_under_501(doc) or (is_paper_submitted_in_support_of(doc, main) and is_application_for_recognition_of_exemption_under_501(main)) or (is_irs_letter_or_document_with_respect_to(doc, main) and is_application_for_recognition_of_exemption_under_501(main)));
    then exempt_status_application_materials(doc);
}

pub relation notice_materials(doc: PublicInspectionDocument) kind institutional {
    label en unofficial "the document is \"notice materials\" within the meaning of section 6104(d)(6)";
}

@source(IRC_S6104_D, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the term \"notice materials\" means the notice of status filed under section 527(i) and any papers submitted in support of such notice and any letter or other document issued by the Internal Revenue Service with respect to such notice.")
rule S6104D6NoticeMaterialsDefinition strict {
    for doc: PublicInspectionDocument;
    for main: PublicInspectionDocument;
    when (is_notice_of_status_under_527i(doc) or (is_paper_submitted_in_support_of(doc, main) and is_notice_of_status_under_527i(main)) or (is_irs_letter_or_document_with_respect_to(doc, main) and is_notice_of_status_under_527i(main)));
    then notice_materials(doc);
}

pub relation section_527j_report_of(ret: Return, org: Person) kind empirical {
    label en unofficial "case fact: the report is filed by the organization under section 527(j) (required disclosure of expenditures and contributions)";
}

pub relation public_request_for_527j_report(ret: Return, requester: Person) kind empirical {
    label en unofficial "case fact: a member of the public asked for the section 527(j) report";
}

pub relation section_527j_report_made_available_to(ret: Return, requester: Person) kind empirical {
    label en unofficial "case fact: the Secretary made the section 527(j) report available to the requester";
}

@source(IRC_S6104_D, relation = formalizes, coverage = exact, quote = "Any report filed by an organization under section 527(j) (relating to required disclosure of expenditures and contributions) shall be made available to the public at such times and in such places as the Secretary may prescribe.")
rule S6104D7ReportsAvailabilityDutyRule strict {
    for ret: Return;
    for org: Person;
    for requester: Person;
    when section_527j_report_of(ret, org)
        and public_request_for_527j_report(ret, requester);
    then duty S6104D7ReportsAvailabilityDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition section_527j_report_made_available_to(ret, requester);
            window [-infinity, infinity];
        }
    };
}

pub relation nonexempt_charitable_trust_or_private_foundation_under_6033d(org: Person) kind empirical {
    label en unofficial "case fact: the organization is one referred to in section 6033(d)(1) or (2) (a nonexempt charitable trust or a nonexempt private foundation)";
}

@source(IRC_S6104_D, relation = formalizes, coverage = exact, quote = "The organizations referred to in paragraphs (1) and (2) of section 6033(d) shall comply with the requirements of this subsection relating to annual returns filed under section 6033 in the same manner as the organizations referred to in paragraph (1).")
rule S6104D8NonexemptOrganizationSubjectToInspectionDuty strict {
    for org: Person;
    when nonexempt_charitable_trust_or_private_foundation_under_6033d(org)
        and annual_return_in_3_year_window(org);
    then public_inspection_required(org);
}
