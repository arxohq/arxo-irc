// 26 U.S.C. §6103(c) — Disclosure to designee of taxpayer, and §6103(d)(1)
// — Disclosure to State tax officials. STAGE 1 FULL for (c) and (d)(1);
// (d)(2)-(6) (State audit agencies, §7624 reimbursement, death information
// contracts, combined employment tax reporting, regional agencies) are
// `unreviewed` — each is its own multi-condition sub-norm the priority
// list did not reach this stage (see coverage rows 26/6103/d/2..6).

// ---------------------------------------------------------------------
// (c) Disclosure to designee of taxpayer
// ---------------------------------------------------------------------

use self::{
    Disclosure,
    IRC_S6103_C,
    IRC_S6103_D,
    Organ,
    Person,
    ReturnInformation,
    about_taxpayer,
    disclosure_of,
    disclosure_permitted,
    disclosure_to,
    state_disclosure_barred_for_want_of_death_contract,
    state_for_extended_purposes_6103b5,
    tax_administration_purpose,
};

pub relation designated_by_taxpayer(d: Disclosure, taxpayer: Person) kind empirical {
    label en unofficial "case fact: the recipient of disclosure d was designated by the taxpayer in a request for or consent to the disclosure, or the disclosure is made at the taxpayer's request to the extent necessary to comply with the taxpayer's own request for information or assistance — section 6103(c)";
}

// DECISION-0194 evaluative channel: "would seriously impair Federal tax
// administration" is committed to the Secretary's determination by the
// text itself.
external judgment relation secretary_determines_disclosure_would_seriously_impair_administration(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that disclosure to the taxpayer's designee would seriously impair Federal tax administration — section 6103(c)";
}

@source(IRC_S6103_C, relation = formalizes, coverage = partial, quote = "The Secretary may, subject to such requirements and conditions as he may prescribe by regulations, disclose the return of any taxpayer, or return information with respect to such taxpayer, to such person or persons as the taxpayer may designate in a request for or consent to such disclosure,")
rule S6103CDesigneeDisclosurePermitted defeasible {
    for d: Disclosure;
    for taxpayer: Person;
    for info: ReturnInformation;
    when designated_by_taxpayer(d, taxpayer)
        and disclosure_of(d, info)
        and about_taxpayer(info, taxpayer);
    then disclosure_permitted(d);
    unless secretary_determines_disclosure_would_seriously_impair_administration(d)
        and designated_by_taxpayer(d, taxpayer)
        and disclosure_of(d, info)
        and about_taxpayer(info, taxpayer);
}

// Downstream duty of the designee itself (not a section 6103(a) bearer
// duty — a separate, self-standing use/redisclosure restriction on the
// designee).
pub relation designee_uses_for_other_purpose(d: Disclosure) kind empirical {
    label en unofficial "case fact: the taxpayer's designee under (c) used the return information for a purpose other than the express purpose for which consent was granted, or redisclosed it without the taxpayer's express permission or request";
}
@source(IRC_S6103_C, relation = formalizes, coverage = exact, quote = "Persons designated by the taxpayer under this subsection to receive return information shall not use the information for any purpose other than the express purpose for which consent was granted and shall not disclose return information to any other person without the express permission of, or request by, the taxpayer.")
rule S6103CDesigneeMisuseRule defeasible {
    for d: Disclosure;
    for taxpayer: Person;
    for recipient: Person;
    when designated_by_taxpayer(d, taxpayer)
        and disclosure_to(d, recipient)
        and designee_uses_for_other_purpose(d);
    then prohibition S6103CDesigneeMisuseProhibition {
        bearer recipient;
        action designee_uses_for_other_purpose(d);
        window [-infinity, infinity];
    };
}

// ---------------------------------------------------------------------
// (d)(1) Disclosure to State tax officials
// ---------------------------------------------------------------------

pub relation state_tax_agency_written_request(d: Disclosure, agency: Organ, head_of_agency: Person) kind empirical {
    label en unofficial "case fact: the head of the State agency, body, or commission charged with administering State tax laws made a written request for this disclosure, designating the representatives who are to inspect or receive the returns/return information on the agency's behalf — section 6103(d)(1)";
}
pub relation designated_representative_of_state_agency(d: Disclosure, recipient: Person, agency: Organ) kind empirical {
    label en unofficial "case fact: the recipient is one of the representatives designated in the (d)(1) written request, and is an employee or legal representative of the agency (not its chief executive officer)";
}

external judgment relation secretary_determines_disclosure_would_identify_informant_or_impair_investigation(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure would identify a confidential informant or seriously impair any civil or criminal tax investigation — section 6103(d)(1) proviso";
}

@source(IRC_S6103_D, relation = formalizes, coverage = partial, quote = "Returns and return information with respect to taxes imposed by chapters 1, 2, 6, 11, 12, 21, 23, 24, 31, 32, 44, 51, and 52 and subchapter D of chapter 36 shall be open to inspection by, or disclosure to, any State agency, body, or commission, or its legal representative, which is charged under the laws of such State with responsibility for the administration of State tax laws for the purpose of, and only to the extent necessary in, the administration of such laws,")
@source(IRC_S6103_D, relation = formalizes, coverage = exact, quote = "Such inspection shall be permitted, or such disclosure made, only upon written request by the head of such agency, body, or commission, and only to the representatives of such agency, body, or commission designated in such written request")
rule S6103D1StateTaxOfficialDisclosurePermitted defeasible {
    for d: Disclosure;
    for agency: Organ;
    for headOfAgency: Person;
    for recipient: Person;
    for info: ReturnInformation;
    when state_tax_agency_written_request(d, agency, headOfAgency)
        and state_for_extended_purposes_6103b5(agency)
        and designated_representative_of_state_agency(d, recipient, agency)
        and disclosure_to(d, recipient)
        and disclosure_of(d, info)
        and tax_administration_purpose(d);
    then disclosure_permitted(d);
    unless secretary_determines_disclosure_would_identify_informant_or_impair_investigation(d)
        and state_tax_agency_written_request(d, agency, headOfAgency)
        and designated_representative_of_state_agency(d, recipient, agency)
        and disclosure_to(d, recipient)
        and disclosure_of(d, info);
    // Stage 2: section 6103(d)(4)(A) — no disclosure under (d)(1) while no qualifying
    // death-information contract is in effect (module 10).
    unless state_disclosure_barred_for_want_of_death_contract(d)
        and state_tax_agency_written_request(d, agency, headOfAgency)
        and designated_representative_of_state_agency(d, recipient, agency)
        and disclosure_to(d, recipient)
        and disclosure_of(d, info);
}
