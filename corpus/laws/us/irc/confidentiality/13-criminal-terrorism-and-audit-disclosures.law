// 26 U.S.C. §6103(i) — Disclosure to Federal officers or employees for administration of
// Federal laws not relating to tax administration. STAGE 2. The three ex parte order
// paragraphs ((1)(A)-(B), (5), (7)(C)-(D)) are POWERS of the district court: the order
// is valid only if the application was authorized by a named official and the court made
// every finding the paragraph requires; a valid exercise creates the fact that an order
// is in force, which opens the disclosure exception (a defeater of the section 6103(a)
// prohibition). Invalid exercise has no effect (E-0239). The written-request paragraphs
// ((2), (3), (7)(A)-(B)) are permissions, and (2) is also a duty of the Secretary.
// (6) is a bar on the Secretary and defeats every (i) exception. (8) (Comptroller
// General) carries the redisclosure ban on the recipients and the Joint Committee
// disapproval bar. Findings of the court are case facts of the order proceeding: the
// court is the deciding organ, so whether a finding was made is not re-evaluated here.

use self::{
    ComptrollerGeneral,
    Disclosure,
    DistrictCourt,
    IRC_S6103_I,
    JointCommitteeOnTaxation,
    Organ,
    Person,
    Recipient,
    Secretary,
    disclosure_by,
    disclosure_permitted,
    disclosure_to,
    disclosure_upon_written_request,
    recipient_is,
    recipient_organ,
};

external judgment relation secretary_determines_i6_informant_or_impairment(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure would identify a confidential informant or seriously impair a civil or criminal tax investigation — section 6103(i)(6)";
}

pub relation i1_order_application_authorized(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Attorney General, the Deputy Attorney General, the Associate Attorney General, an Assistant Attorney General, a United States attorney, a special prosecutor appointed under 28 U.S.C. 593, or an attorney in charge of a criminal division organized crime strike force authorized the application — section 6103(i)(1)(B)";
}

pub relation i1_order_finding_specific_criminal_act(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that there is reasonable cause to believe, based upon information believed to be reliable, that a specific criminal act has been committed — (i)";
}

pub relation i1_order_finding_return_relevant(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that there is reasonable cause to believe the return or return information is or may be relevant to a matter relating to the commission of such act — (ii)";
}

pub relation i1_order_finding_exclusive_use_and_no_other_source(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that the return or return information is sought exclusively for use in a Federal criminal investigation or proceeding concerning such act (or any criminal investigation or proceeding for a missing or exploited child matter), and the information cannot reasonably be obtained under the circumstances from another source — (iii)";
}

pub relation i1_order_findings_made(d: Disclosure) kind institutional {
    label en unofficial "the application was authorized and every finding the paragraph requires for the order was made — i1_order";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "The Attorney General, the Deputy Attorney General, the Associate Attorney General, any Assistant Attorney General, any United States attorney, any")
rule S6103I1CriminalInvestigationFindingsClassification strict {
    for d: Disclosure;
    when i1_order_application_authorized(d)
        and i1_order_finding_specific_criminal_act(d)
        and i1_order_finding_return_relevant(d)
        and i1_order_finding_exclusive_use_and_no_other_source(d);
    then i1_order_findings_made(d);
}

pub relation i1_order_order_granted(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate granted the ex parte order (the exercise of the court's power) — i1_order";
}

pub relation i1_order_order_in_force(d: Disclosure) kind institutional {
    label en unofficial "an ex parte order authorizing the disclosure is in force — i1_order";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), any return or return information with respect to any specified taxable period or periods shall, pursuant to and")
rule S6103I1CriminalInvestigationOrderPowerRule strict {
    for d: Disclosure;
    when i1_order_order_granted(d);
    then power S6103I1CriminalInvestigationOrderPower {
        holder DistrictCourt;
        over Secretary;
        exercise i1_order_order_granted(d);
        valid_when i1_order_findings_made(d);
        effect create(i1_order_order_in_force(d));
    };
}

pub relation i1_order_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the officers and employees of the Federal agency are personally and directly engaged in preparation for a judicial or administrative proceeding pertaining to enforcement of a specifically designated Federal criminal statute (not involving tax administration) or to a missing or exploited child case, an investigation that may result in such a proceeding, or a Federal grand jury proceeding, and the information is solely for their use there and limited to what the order provides — section 6103(i)(1)(A)(i)-(iii)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), any return or return information with respect to any specified taxable period or periods shall, pursuant to and")
rule S6103I1CriminalInvestigationDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, FederalAgencyOfficerCriminalInvestigation)
        and i1_order_order_in_force(d)
        and i1_order_scope(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_informant_or_impairment(d)
        and recipient_is(d, FederalAgencyOfficerCriminalInvestigation);
}

pub relation i1c_state_local_team_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the investigation pertains to a missing or exploited child; the head of the Federal agency (or his designee) discloses return information obtained under (i)(1)(A); the State or local law enforcement agency is part of a team with the Federal agency in the investigation; and the information goes only to officers and employees personally and directly engaged in the investigation — section 6103(i)(1)(C)(i)(I)-(II)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "In the case of an investigation pertaining to a missing or exploited child, the head of any Federal agency, or his designee, may disclose any return or return information obtained under subparagraph (A) to officers and employees of any State or")
rule S6103I1CMissingChildStateLocalTeamDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, StateLocalLawEnforcementTeamMemberOnChildCase)
        and i1c_state_local_team_scope(d);
    then disclosure_permitted(d);
}

pub relation i1c_state_local_team_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the officer or employee used the information for a purpose other than locating the missing child, a grand jury proceeding, or preparation for, or an investigation which may result in, a judicial or administrative proceeding";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Information disclosed under this subparagraph shall be solely for the use of such officers and employees in locating the missing child, in a grand jury proceeding, or in any preparation for, or investigation which may result in, a judicial or")
rule S6103I1CMissingChildUseUseLimitRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, StateLocalLawEnforcementTeamMemberOnChildCase)
        and i1c_state_local_team_scope(d);
    then prohibition S6103I1CMissingChildUseUseLimit {
        bearer recipient;
        action i1c_state_local_team_misuse(d);
        window [-infinity, infinity];
    };
}

pub relation minor_with_reason_to_believe_specified_offense_against_minor_occurring(child: Person) kind empirical {
    label en unofficial "case fact: there is reason to believe that a specified offense against a minor (as defined by section 111(7) of the Sex Offender Registration and Notification Act, 42 U.S.C. 16911(7)) has or is occurring with respect to the minor";
}

pub relation exploited_child(child: Person) kind institutional {
    label en unofficial "the minor is an \"exploited child\" within the meaning of section 6103(i)(1)(C)(iv)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, the term \"exploited child\" means a minor with respect to whom there is reason to believe that a specified offense against a minor (as defined by section 111(7) of the Sex Offender Registration and Notification Act")
rule S6103I1CivExploitedChildDefinition strict {
    for child: Person;
    when minor_with_reason_to_believe_specified_offense_against_minor_occurring(child);
    then exploited_child(child);
}

pub relation i2_request_sets_forth_taxpayer_name_and_address(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request sets forth the name and address of the taxpayer with respect to whom the requested return information relates — section 6103(i)(2)(B)(i)";
}

pub relation i2_request_sets_forth_taxable_periods(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request sets forth the taxable period or periods to which the return information relates — section 6103(i)(2)(B)(ii)";
}

pub relation i2_request_sets_forth_statutory_authority(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request sets forth the statutory authority under which the proceeding or investigation is being conducted — section 6103(i)(2)(B)(iii)";
}

pub relation i2_request_sets_forth_reasons_relevant(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request sets forth the specific reason or reasons why the disclosure is, or may be, relevant to the proceeding or investigation — section 6103(i)(2)(B)(iv)";
}

pub relation i2_request_in_writing_by_authorized_head(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request is in writing and made by the head of a Federal agency or its Inspector General, or, in the case of the Department of Justice, by the Attorney General, the Deputy Attorney General, the Associate Attorney General, an Assistant Attorney General, the Director of the Federal Bureau of Investigation, the Administrator of the Drug Enforcement Administration, a United States attorney, a special prosecutor appointed under 28 U.S.C. 593, or an attorney in charge of a criminal division organized crime strike force — section 6103(i)(2)(A)";
}

pub relation i2_recipients_personally_and_directly_engaged_solely_for_use(d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipients are officers and employees of the agency personally and directly engaged in preparation for a proceeding described in paragraph (1)(A)(i), an investigation which may result in such a proceeding, or a grand jury proceeding described in paragraph (1)(A)(iii), and the information is solely for their use there; the information is return information other than taxpayer return information (a taxpayer's identity is not taxpayer return information — (C))";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), upon receipt by the Secretary of a request which meets the requirements of subparagraph (B) from the head of any Federal agency or the Inspector General thereof, or, in the case of the Department of Justice, the")
@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "A request meets the requirements of this subparagraph if the request is in writing and sets forth—")
rule S6103I2CriminalInvestigationDisclosurePermitted defeasible {
    for d: Disclosure;
    when i2_request_in_writing_by_authorized_head(d)
        and i2_request_sets_forth_taxpayer_name_and_address(d)
        and i2_request_sets_forth_taxable_periods(d)
        and i2_request_sets_forth_statutory_authority(d)
        and i2_request_sets_forth_reasons_relevant(d)
        and i2_recipients_personally_and_directly_engaged_solely_for_use(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_informant_or_impairment(d)
        and i2_request_in_writing_by_authorized_head(d);
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), upon receipt by the Secretary of a request which meets the requirements of subparagraph (B) from the head of any Federal agency or the Inspector General thereof, or, in the case of the Department of Justice, the")
rule S6103I2CriminalInvestigationFurnishDutyRule defeasible {
    for d: Disclosure;
    for agency: Organ;
    when i2_request_in_writing_by_authorized_head(d)
        and i2_request_sets_forth_taxpayer_name_and_address(d)
        and i2_request_sets_forth_taxable_periods(d)
        and i2_request_sets_forth_statutory_authority(d)
        and i2_request_sets_forth_reasons_relevant(d)
        and i2_recipients_personally_and_directly_engaged_solely_for_use(d)
        and recipient_organ(d, agency);
    then duty S6103I2CriminalInvestigationFurnishDuty {
        bearer Secretary;
        beneficiary agency;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
    unless secretary_determines_i6_informant_or_impairment(d)
        and i2_request_in_writing_by_authorized_head(d)
        and recipient_organ(d, agency);
}

pub relation i3a_head_of_agency_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: written disclosure of return information (other than taxpayer return information; taxpayer identity may also be disclosed) that may constitute evidence of a violation of a Federal criminal law not involving tax administration, to the extent necessary to apprise the head of the appropriate Federal agency charged with enforcing it — section 6103(i)(3)(A)(i)-(ii)";
}

external judgment relation secretary_determines_i6_bar_for_i3(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure would identify a confidential informant or seriously impair a civil or criminal tax investigation — section 6103(i)(6), applied to (i)(3)(A) and (C)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the Secretary may disclose in writing return information (other than taxpayer return information) which may constitute evidence of a violation of any Federal criminal law (not involving tax administration) to the")
rule S6103I3AApprisingAgencyHeadOfCriminalViolationDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, HeadOfFederalAgencyEnforcingCriminalLaw)
        and i3a_head_of_agency_scope(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_bar_for_i3(d) and recipient_is(d, HeadOfFederalAgencyEnforcingCriminalLaw);
}

pub relation i3a_agency_officers_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the head of the agency discloses the return information to officers and employees of the agency to the extent necessary to enforce the Federal criminal law — section 6103(i)(3)(A)(i), last sentence";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the Secretary may disclose in writing return information (other than taxpayer return information) which may constitute evidence of a violation of any Federal")
rule S6103I3A2AgencyHeadRedisclosureToOfficersDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, OfficerOrEmployeeOfFederalAgencyEnforcingCriminalLaw)
        and i3a_agency_officers_scope(d);
    then disclosure_permitted(d);
}

pub relation i3b1_danger_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: circumstances involve an imminent danger of death or physical injury to an individual, and the return information is disclosed only to the extent necessary to apprise appropriate officers or employees of a Federal or State law enforcement agency of them — section 6103(i)(3)(B)(i)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Under circumstances involving an imminent danger of death or physical injury to any individual, the Secretary may disclose return information to the extent necessary to apprise appropriate officers or employees of any Federal or State law")
rule S6103I3B1ImminentDangerToLawEnforcementDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, FederalOrStateLawEnforcementOfficer)
        and i3b1_danger_scope(d);
    then disclosure_permitted(d);
}

pub relation i3b2_flight_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: circumstances involve the imminent flight of an individual from Federal prosecution, and the return information is disclosed only to the extent necessary to apprise appropriate officers or employees of a Federal law enforcement agency of them — section 6103(i)(3)(B)(ii)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Under circumstances involving the imminent flight of any individual from Federal prosecution, the Secretary may disclose return information to the extent necessary to apprise appropriate officers or employees of any Federal law enforcement agency of")
rule S6103I3B2ImminentFlightToFederalLawEnforcementDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, FederalLawEnforcementOfficer)
        and i3b2_flight_scope(d);
    then disclosure_permitted(d);
}

pub relation i3c_terrorist_incident_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: written disclosure of return information (other than taxpayer return information; taxpayer identity is not taxpayer return information — (C)(iii)) that may be related to a terrorist incident, threat, or activity, to the extent necessary to apprise the head of the appropriate Federal law enforcement agency responsible for investigating or responding to it — section 6103(i)(3)(C)(i)";
}

external judgment relation secretary_determines_i6_bar_for_i3c(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure would identify a confidential informant or seriously impair a civil or criminal tax investigation — section 6103(i)(6), applied to (i)(3)(C)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the Secretary may disclose in writing return information (other than taxpayer return information) that may be related to a terrorist incident, threat, or activity to the extent necessary to apprise the head of")
rule S6103I3CTerroristActivityToAgencyHeadDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, HeadOfFederalLawEnforcementAgencyOnTerrorism)
        and i3c_terrorist_incident_scope(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_bar_for_i3c(d) and recipient_is(d, HeadOfFederalLawEnforcementAgencyOnTerrorism);
}

pub relation i3c2_agency_officers_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the head of the agency discloses the information to officers and employees of the agency to the extent necessary to investigate or respond to the terrorist incident, threat, or activity — section 6103(i)(3)(C)(i), last sentence";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the Secretary may disclose in writing return information (other than taxpayer return information) that may be related to a terrorist incident, threat, or activity")
rule S6103I3C2AgencyHeadTerroristRedisclosureDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, OfficerOrEmployeeOfFederalLawEnforcementAgencyOnTerrorism)
        and i3c2_agency_officers_scope(d);
    then disclosure_permitted(d);
}

pub relation i3c3_attorney_general_application_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: returns and taxpayer return information are disclosed to the Attorney General to the extent necessary for, and solely for use in preparing, an application under paragraph (7)(D) — section 6103(i)(3)(C)(ii)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Returns and taxpayer return information may also be disclosed to the Attorney General under clause (i) to the extent necessary for, and solely for use in preparing, an application under paragraph (7)(D).")
rule S6103I3C3ReturnsToAttorneyGeneralForOrderApplicationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, AttorneyGeneralPreparingOrderApplication)
        and i3c3_attorney_general_application_scope(d);
    then disclosure_permitted(d);
}

external judgment relation court_finds_return_probative_of_matter_in_issue(d: Disclosure) {
    authority DistrictCourt;
    label en official "the court finds that the return or taxpayer return information is probative of a matter in issue relevant in establishing the commission of a crime or the guilt or liability of a party — section 6103(i)(4)(A)(i)";
}

external judgment relation secretary_determines_and_notifies_admission_would_identify_informant(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines and notifies the Attorney General or his delegate or the head of the Federal agency that admission would identify a confidential informant or seriously impair a civil or criminal tax investigation — section 6103(i)(4)(C)";
}

pub relation i4_proceeding_on_designated_federal_criminal_statute_or_civil_forfeiture(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is in a judicial or administrative proceeding pertaining to enforcement of a specifically designated Federal criminal statute or related civil forfeiture (not involving tax administration) to which the United States or a Federal agency is a party — section 6103(i)(4)(A)-(B)";
}

pub relation i4_returns_obtained_under_i1_or_i7c(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or taxpayer return information was obtained under paragraph (1) or (7)(C)";
}

pub relation i4_information_other_than_taxpayer_return_information_obtained_under_i_paragraphs(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return information (other than taxpayer return information) was obtained under paragraph (1), (2), (3)(A) or (C), or (7)";
}

pub relation i4_required_by_court_order_under_3500_or_rule_16(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to the extent required by order of the court pursuant to 18 U.S.C. 3500 or Rule 16 of the Federal Rules of Criminal Procedure — section 6103(i)(4)(A)(ii)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraph (C), any return or taxpayer return information obtained under paragraph (1) or (7)(C) may be disclosed in any judicial or administrative proceeding pertaining to enforcement of a specifically designated Federal")
@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "(i) if the court finds that such return or taxpayer return information is probative of a matter in issue relevant in establishing the commission of a crime or the guilt or liability of a party, or")
rule S6103I4AiProbativeDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, CriminalOrForfeitureProceeding)
        and i4_proceeding_on_designated_federal_criminal_statute_or_civil_forfeiture(d)
        and i4_returns_obtained_under_i1_or_i7c(d)
        and court_finds_return_probative_of_matter_in_issue(d);
    then disclosure_permitted(d);
    unless secretary_determines_and_notifies_admission_would_identify_informant(d)
        and recipient_is(d, CriminalOrForfeitureProceeding);
}

@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "(ii) to the extent required by order of the court pursuant to section 3500 of title 18, United States Code, or rule 16 of the Federal Rules of Criminal Procedure.")
rule S6103I4AiiCourtOrderDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, CriminalOrForfeitureProceeding)
        and i4_proceeding_on_designated_federal_criminal_statute_or_civil_forfeiture(d)
        and i4_returns_obtained_under_i1_or_i7c(d)
        and i4_required_by_court_order_under_3500_or_rule_16(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraph (C), any return information (other than taxpayer return information) obtained under paragraph (1), (2), (3)(A) or (C), or (7) may be disclosed in any judicial or administrative proceeding pertaining to enforcement of a specifically designated Federal criminal")
rule S6103I4BReturnInformationDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, CriminalOrForfeitureProceeding)
        and i4_proceeding_on_designated_federal_criminal_statute_or_civil_forfeiture(d)
        and i4_information_other_than_taxpayer_return_information_obtained_under_i_paragraphs(d);
    then disclosure_permitted(d);
    unless secretary_determines_and_notifies_admission_would_identify_informant(d)
        and recipient_is(d, CriminalOrForfeitureProceeding);
}

pub relation i5_order_application_authorized(d: Disclosure) kind empirical {
    label en unofficial "case fact: a person described in paragraph (1)(B) (the Attorney General, the Deputy Attorney General, the Associate Attorney General, an Assistant Attorney General, a United States attorney, a special prosecutor, or an organized crime strike force attorney) authorized the application — section 6103(i)(5)(B)";
}

pub relation i5_order_finding_arrest_warrant_for_felony_fugitive(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that a Federal arrest warrant relating to the commission of a Federal felony offense has been issued for an individual who is a fugitive from justice — (i)";
}

pub relation i5_order_finding_sought_exclusively_to_locate(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that the return or return information about such individual is sought exclusively for use in locating him — (ii)";
}

pub relation i5_order_finding_reasonable_cause_relevant_to_location(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that there is reasonable cause to believe that the return or return information may be relevant in determining the location of the individual — (iii)";
}

pub relation i5_order_findings_made(d: Disclosure) kind institutional {
    label en unofficial "the application was authorized and every finding the paragraph requires for the order was made — i5_order";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Any person described in paragraph (1)(B) may authorize an application to a Federal district court judge or magistrate judge for an order referred to")
rule S6103I5FugitiveLocationFindingsClassification strict {
    for d: Disclosure;
    when i5_order_application_authorized(d)
        and i5_order_finding_arrest_warrant_for_felony_fugitive(d)
        and i5_order_finding_sought_exclusively_to_locate(d)
        and i5_order_finding_reasonable_cause_relevant_to_location(d);
    then i5_order_findings_made(d);
}

pub relation i5_order_order_granted(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate granted the ex parte order (the exercise of the court's power) — i5_order";
}

pub relation i5_order_order_in_force(d: Disclosure) kind institutional {
    label en unofficial "an ex parte order authorizing the disclosure is in force — i5_order";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the return of an individual or return information with respect to such individual shall, pursuant to and upon")
rule S6103I5FugitiveLocationOrderPowerRule strict {
    for d: Disclosure;
    when i5_order_order_granted(d);
    then power S6103I5FugitiveLocationOrderPower {
        holder DistrictCourt;
        over Secretary;
        exercise i5_order_order_granted(d);
        valid_when i5_order_findings_made(d);
        effect create(i5_order_order_in_force(d));
    };
}

pub relation i5_order_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return of the individual or return information about the individual is inspected or disclosed only to the extent necessary as provided in the order, to officers and employees of a Federal agency exclusively for use in locating the individual — section 6103(i)(5)(A)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the return of an individual or return information with respect to such individual shall, pursuant to and upon")
rule S6103I5FugitiveLocationDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, FederalAgencyOfficerLocatingFugitive)
        and i5_order_order_in_force(d)
        and i5_order_scope(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_informant_or_impairment(d)
        and recipient_is(d, FederalAgencyOfficerLocatingFugitive);
}

pub relation i6_disclosure_under_i_paragraph_1_2_3a_3c_5_7_or_8(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is made (or requested) under paragraph (1), (2), (3)(A) or (C), (5), (7), or (8) of section 6103(i)";
}

pub relation i6_request_pursuant_to_court_order_under_i1b_or_i5b(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request for disclosure is made pursuant to a court order described in paragraph (1)(B) or (5)(B)";
}

pub relation secretary_disclosed_despite_i6_determination(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary made the disclosure although he had determined that it would identify a confidential informant or seriously impair a civil or criminal tax investigation";
}

pub relation secretary_certified_i6_determination_to_court(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary certified his determination to the court";
}

@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "The Secretary shall not disclose any return or return information under paragraph (1), (2), (3)(A) or (C), (5), (7), or (8) if the Secretary determines (and, in the case of a request for disclosure pursuant to a court order described in paragraph")
rule S6103I6SecretaryBarRule strict {
    for d: Disclosure;
    when i6_disclosure_under_i_paragraph_1_2_3a_3c_5_7_or_8(d)
        and secretary_determines_i6_informant_or_impairment(d);
    then prohibition S6103I6SecretaryBar {
        bearer Secretary;
        action secretary_disclosed_despite_i6_determination(d);
        window [-infinity, infinity];
    };
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "and, in the case of a request for disclosure pursuant to a court order described in paragraph (1)(B) or (5)(B), certifies to the court")
rule S6103I6CertifyToCourtDutyRule strict {
    for d: Disclosure;
    when i6_disclosure_under_i_paragraph_1_2_3a_3c_5_7_or_8(d)
        and secretary_determines_i6_informant_or_impairment(d)
        and i6_request_pursuant_to_court_order_under_i1b_or_i5b(d);
    then duty S6103I6CertifyToCourtDuty {
        bearer Secretary;
        beneficiary DistrictCourt;
        goal achievement {
            condition secretary_certified_i6_determination_to_court(d);
            window [-infinity, infinity];
        }
    };
}

pub relation i7a_law_enforcement_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information (other than taxpayer return information; a taxpayer's identity is not taxpayer return information — (A)(v)) is disclosed to officers and employees of a Federal law enforcement agency personally and directly engaged in the response to or investigation of a terrorist incident, threat, or activity — section 6103(i)(7)(A)(i)";
}

pub relation i7a_request_by_head_of_federal_law_enforcement_agency_flag(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request meets (A)(iii)(I) and (II): made by the head of a Federal law enforcement agency involved in the response or investigation, setting forth the specific reasons the disclosure may be relevant to a terrorist incident, threat, or activity";
}

external judgment relation secretary_determines_i6_bar_for_i7a(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure would identify a confidential informant or seriously impair a civil or criminal tax investigation — section 6103(i)(6), applied to (i)(7)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), upon receipt by the Secretary of a written request which meets the requirements of clause (iii), the Secretary may disclose return information (other than")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(I) the request is made by the head of any Federal law enforcement agency (or his delegate) involved in the response to or investigation of any terrorist incident, threat, or activity, and")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(II) the request sets forth the specific reason or reasons why such disclosure may be relevant to a terrorist incident, threat, or activity.")
rule S6103I7ATerroristIncidentToLawEnforcementDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, FederalLawEnforcementOfficerOnTerrorism)
        and disclosure_upon_written_request(d)
        and i7a_law_enforcement_scope(d)
        and i7a_request_by_head_of_federal_law_enforcement_agency_flag(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_bar_for_i7a(d) and recipient_is(d, FederalLawEnforcementOfficerOnTerrorism);
}

pub relation i7a2_state_local_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the head of the Federal law enforcement agency discloses return information obtained under (A)(i) to officers and employees of a State or local law enforcement agency that is part of a team with the Federal agency in the response or investigation, only to those personally and directly engaged in it — section 6103(i)(7)(A)(ii)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "The head of any Federal law enforcement agency may disclose return information obtained under clause (i) to officers and employees of any State or local law enforcement agency but only if such agency is part of a team with the Federal law")
rule S6103I7A2TerroristIncidentToStateLocalTeamDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, StateLocalLawEnforcementTeamMemberOnTerrorism)
        and i7a2_state_local_scope(d);
    then disclosure_permitted(d);
}

pub relation i7a2_state_local_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the officer or employee used the information for a purpose other than the response to or investigation of the terrorist incident, threat, or activity";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Information disclosed under this subparagraph shall be solely for the use of the officers and employees to whom such information is disclosed in such response or investigation.")
rule S6103I7A2TerroristUseUseLimitRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, StateLocalLawEnforcementTeamMemberOnTerrorism)
        and i7a2_state_local_scope(d);
    then prohibition S6103I7A2TerroristUseUseLimit {
        bearer recipient;
        action i7a2_state_local_misuse(d);
        window [-infinity, infinity];
    };
}

pub relation i7b_intelligence_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information (other than taxpayer return information; a taxpayer's identity is not taxpayer return information — (B)(iv)) is disclosed to officers and employees of the Department of Justice, the Department of the Treasury, and other Federal intelligence agencies personally and directly engaged in the collection or analysis of intelligence and counterintelligence information or investigation concerning a terrorist incident, threat, or activity, solely for their use there — section 6103(i)(7)(B)(i)";
}

pub relation i7b_request_meets_requirements_flag(d: Disclosure) kind empirical {
    label en unofficial "case fact: the written request is made by an individual described in (B)(iii) and sets forth the specific reasons the disclosure may be relevant to a terrorist incident, threat, or activity — (B)(ii)-(iii)";
}

external judgment relation secretary_determines_i6_bar_for_i7b(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure would identify a confidential informant or seriously impair a civil or criminal tax investigation — section 6103(i)(6), applied to (i)(7)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), upon receipt by the Secretary of a written request which meets the requirements of clause (ii), the Secretary may disclose return information (other than taxpayer")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(I) is made by an individual described in clause (iii), and")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(II) sets forth the specific reason or reasons why such disclosure may be relevant to a terrorist incident, threat, or activity.")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(I) who is an officer or employee of the Department of Justice or the Department of the Treasury who is appointed by the President with the advice and consent of the Senate or who is the Director of")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(II) who is responsible for the collection and analysis of intelligence and counterintelligence information concerning any terrorist incident, threat, or activity.")
rule S6103I7BTerroristIncidentToIntelligenceAgenciesDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, IntelligenceOfficerOnTerrorism)
        and disclosure_upon_written_request(d)
        and i7b_intelligence_scope(d)
        and i7b_request_meets_requirements_flag(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_bar_for_i7b(d) and recipient_is(d, IntelligenceOfficerOnTerrorism);
}

pub relation i7c_order_application_authorized(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Attorney General, the Deputy Attorney General, the Associate Attorney General, an Assistant Attorney General, or a United States attorney authorized the application — section 6103(i)(7)(C)(ii)";
}

pub relation i7c_order_finding_reasonable_cause_relevant_to_incident(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that there is reasonable cause to believe, based upon information believed to be reliable, that the return or return information may be relevant to a matter relating to the terrorist incident, threat, or activity — (I)";
}

pub relation i7c_order_finding_sought_exclusively_for_federal_investigation(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that the return or return information is sought exclusively for use in a Federal investigation, analysis, or proceeding concerning any terrorist incident, threat, or activity — (II)";
}

pub relation i7c_order_findings_made(d: Disclosure) kind institutional {
    label en unofficial "the application was authorized and every finding the paragraph requires for the order was made — i7c_order";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "The Attorney General, the Deputy Attorney General, the Associate Attorney General, any Assistant Attorney General, or any United States attorney may")
rule S6103I7CTerroristIncidentFindingsClassification strict {
    for d: Disclosure;
    when i7c_order_application_authorized(d)
        and i7c_order_finding_reasonable_cause_relevant_to_incident(d)
        and i7c_order_finding_sought_exclusively_for_federal_investigation(d);
    then i7c_order_findings_made(d);
}

pub relation i7c_order_order_granted(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate granted the ex parte order (the exercise of the court's power) — i7c_order";
}

pub relation i7c_order_order_in_force(d: Disclosure) kind institutional {
    label en unofficial "an ex parte order authorizing the disclosure is in force — i7c_order";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), any return or return information with respect to any specified taxable period or periods shall, pursuant to and")
rule S6103I7CTerroristIncidentOrderPowerRule strict {
    for d: Disclosure;
    when i7c_order_order_granted(d);
    then power S6103I7CTerroristIncidentOrderPower {
        holder DistrictCourt;
        over Secretary;
        exercise i7c_order_order_granted(d);
        valid_when i7c_order_findings_made(d);
        effect create(i7c_order_order_in_force(d));
    };
}

pub relation i7c_order_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information is inspected or disclosed only to the extent necessary as provided in the order, to officers and employees of a Federal law enforcement agency or Federal intelligence agency personally and directly engaged in an investigation, response to, or analysis concerning a terrorist incident, threat, or activity, solely for their use in it and in related judicial, administrative, or grand jury proceedings — section 6103(i)(7)(C)(i)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), any return or return information with respect to any specified taxable period or periods shall, pursuant to and")
rule S6103I7CTerroristIncidentDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, FederalLawEnforcementOrIntelligenceOfficerOnTerrorism)
        and i7c_order_order_in_force(d)
        and i7c_order_scope(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_informant_or_impairment(d)
        and recipient_is(d, FederalLawEnforcementOrIntelligenceOfficerOnTerrorism);
}

pub relation i7d_order_application_authorized(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary authorized the application for the order — section 6103(i)(7)(D)(i)";
}

pub relation i7d_order_finding_reasonable_cause_relevant_to_incident(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate determined, on the facts submitted by the applicant, that the requirement of subparagraph (C)(ii)(I) is met: there is reasonable cause to believe, based upon information believed to be reliable, that the return or return information may be relevant to a matter relating to the terrorist incident, threat, or activity";
}

pub relation i7d_order_findings_made(d: Disclosure) kind institutional {
    label en unofficial "the application was authorized and every finding the paragraph requires for the order was made — i7d_order";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the Secretary may authorize an application to a Federal district court judge or magistrate for the order referred to in subparagraph (C)(i). Upon such")
rule S6103I7DTerroristIncidentIrsFindingsClassification strict {
    for d: Disclosure;
    when i7d_order_application_authorized(d)
        and i7d_order_finding_reasonable_cause_relevant_to_incident(d);
    then i7d_order_findings_made(d);
}

pub relation i7d_order_order_granted(d: Disclosure) kind empirical {
    label en unofficial "case fact: the judge or magistrate granted the ex parte order (the exercise of the court's power) — i7d_order";
}

pub relation i7d_order_order_in_force(d: Disclosure) kind institutional {
    label en unofficial "an ex parte order authorizing the disclosure is in force — i7d_order";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the Secretary may authorize an application to a Federal district court judge or magistrate for the order referred to in subparagraph (C)(i). Upon such")
rule S6103I7DTerroristIncidentIrsOrderPowerRule strict {
    for d: Disclosure;
    when i7d_order_order_granted(d);
    then power S6103I7DTerroristIncidentIrsOrderPower {
        holder DistrictCourt;
        over Secretary;
        exercise i7d_order_order_granted(d);
        valid_when i7d_order_findings_made(d);
        effect create(i7d_order_order_in_force(d));
    };
}

pub relation i7d_order_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: information disclosed under the (D)(i) order is disclosed only to the extent necessary to apprise the head of the appropriate Federal law enforcement agency responsible for investigating or responding to a terrorist incident, threat, or activity, and is solely for use in a Federal investigation, analysis, or proceeding concerning it (the head may disclose it to officers and employees of the agency to the extent necessary) — section 6103(i)(7)(D)(ii)";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (6), the Secretary may authorize an application to a Federal district court judge or magistrate for the order referred to in subparagraph (C)(i). Upon such")
rule S6103I7DTerroristIncidentIrsDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, HeadOfFederalLawEnforcementAgencyOnTerrorismByOrder)
        and i7d_order_order_in_force(d)
        and i7d_order_scope(d);
    then disclosure_permitted(d);
    unless secretary_determines_i6_informant_or_impairment(d)
        and recipient_is(d, HeadOfFederalLawEnforcementAgencyOnTerrorismByOrder);
}

pub relation i8_written_request_by_comptroller_general(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request is in writing and made by the Comptroller General of the United States — section 6103(i)(8)(A)";
}

pub relation i8a_audit_of_irs_atf_or_ttb_or_p6_audit(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is for the purpose of, and to the extent necessary in, an audit of the Internal Revenue Service, the Bureau of Alcohol, Tobacco, Firearms, and Explosives, or the Tax and Trade Bureau which may be required by 31 U.S.C. 713, or an audit authorized by subsection (p)(6)";
}

pub relation i8b_audit_of_other_agency_program_written_request_to_agency_head(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return information obtained by a Federal agency (other than those in (A)) or by a Trustee (District of Columbia Retirement Protection Act of 1997) for use in a program or activity is disclosed to the Government Accountability Office for, and to the extent necessary in, an audit authorized by law of that program or activity, upon the Comptroller General's written request to the head of the agency — section 6103(i)(8)(B)(i)";
}

pub relation i8b_secretary_information_not_sufficient_written_request(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Comptroller General determined that the information available under (B)(i) is not sufficient and requested in writing from the Secretary the type of information subsection (l) or (m) authorizes for the agency's program or activity — section 6103(i)(8)(B)(ii)";
}

pub relation i8_comptroller_general_notified_joint_committee_of_audit(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Comptroller General notified the Joint Committee on Taxation in writing of the audit — section 6103(i)(8)(C)(i)";
}

pub relation i8_joint_committee_notice_received_on(d: Disclosure, receivedOn: Date) kind empirical {
    label en unofficial "case fact: the day the Joint Committee on Taxation received the notice of the audit";
}

pub relation i8_joint_committee_disapproved_by_vote_on(d: Disclosure, votedOn: Date, votesFor: Integer, members: Integer) kind empirical {
    label en unofficial "case fact: the Joint Committee on Taxation voted to disapprove the audit on this day, with this number of votes of this number of members";
}

pub relation i8_disapproval_by_two_thirds_within_30_day_period(d: Disclosure) kind institutional {
    label en unofficial "the Joint Committee on Taxation disapproved the audit by a vote of at least two-thirds of its members within the 30-day period beginning on the day it received the notice";
}

@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "(ii) if the Joint Committee on Taxation disapproves such audit by a vote of at least two-thirds of its members within the 30-day period beginning on the day the Joint Committee on Taxation receives such notice.")
rule S6103I8CDisapprovalClassification strict {
    for d: Disclosure;
    for receivedOn: Date;
    for votedOn: Date;
    for votesFor: Integer;
    for members: Integer;
    when i8_joint_committee_notice_received_on(d, receivedOn)
        and i8_joint_committee_disapproved_by_vote_on(d, votedOn, votesFor, members)
        and votedOn >= receivedOn
        and votedOn <= add_calendar_period(receivedOn, 29 calendar_day)
        and votesFor * 3 >= members * 2;
    then i8_disapproval_by_two_thirds_within_30_day_period(d);
}

pub relation i8_audit_barred(d: Disclosure) kind institutional {
    label en unofficial "returns and return information may not be opened to inspection or disclosed for the audit: the Comptroller General did not notify the Joint Committee on Taxation, or the Joint Committee disapproved the audit by two-thirds within 30 days";
}

@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "(i) unless the Comptroller General of the United States notifies in writing the Joint Committee on Taxation of such audit, and")
rule S6103I8CNoNoticeBar strict {
    for d: Disclosure;
    when i8_written_request_by_comptroller_general(d)
        and not_known(i8_comptroller_general_notified_joint_committee_of_audit(d));
    then i8_audit_barred(d);
}

@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "(ii) if the Joint Committee on Taxation disapproves such audit by a vote of at least two-thirds of its members within the 30-day period beginning on the day the Joint Committee on Taxation receives such notice.")
rule S6103I8CDisapprovedBar strict {
    for d: Disclosure;
    when i8_disapproval_by_two_thirds_within_30_day_period(d);
    then i8_audit_barred(d);
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraph (C), upon written request by the Comptroller General of the United States, returns and return information shall be open to inspection by, or disclosure to, officers and employees of the Government Accountability")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(i) an audit of the Internal Revenue Service, the Bureau of Alcohol, Tobacco, Firearms, and Explosives, Department of Justice, or the Tax and Trade Bureau, Department of the Treasury, which may be")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(ii) any audit authorized by subsection (p)(6),")
rule S6103I8AAuditOfIrsDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, GovernmentAccountabilityOfficeOfficer)
        and i8_written_request_by_comptroller_general(d)
        and i8a_audit_of_irs_atf_or_ttb_or_p6_audit(d);
    then disclosure_permitted(d);
    unless i8_audit_barred(d)
        and recipient_is(d, GovernmentAccountabilityOfficeOfficer);
    unless secretary_determines_i6_informant_or_impairment(d)
        and recipient_is(d, GovernmentAccountabilityOfficeOfficer);
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "Nothing in this section shall prohibit any return or return information obtained under this title by any Federal agency (other than an agency referred to in subparagraph (A)) or by a Trustee as defined in the District of Columbia Retirement")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(I) for purposes of, and to the extent necessary in, making an audit authorized by law of such program or activity, and")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "(II) pursuant to a written request by the Comptroller General of the United States to the head of such Federal agency.")
rule S6103I8BAuditOfOtherAgencyDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, GovernmentAccountabilityOfficeOfficer)
        and i8b_audit_of_other_agency_program_written_request_to_agency_head(d);
    then disclosure_permitted(d);
    unless i8_audit_barred(d)
        and recipient_is(d, GovernmentAccountabilityOfficeOfficer);
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "If the Comptroller General of the United States determines that the returns or return information available under clause (i) are not sufficient for purposes of making an audit of any program or activity of a Federal agency (other than an agency referred to in subparagraph (A)), upon written request")
rule S6103I8BSecretaryInformationDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, GovernmentAccountabilityOfficeOfficer)
        and i8b_secretary_information_not_sufficient_written_request(d);
    then disclosure_permitted(d);
    unless i8_audit_barred(d)
        and recipient_is(d, GovernmentAccountabilityOfficeOfficer);
}

pub relation i8_gao_officer_disclosed_to_person_who_is_not_official_gao_colleague(d: Disclosure) kind empirical {
    label en unofficial "case fact: the GAO officer or employee disclosed returns or return information (described in section 4424(a), or any other, in a form which can be associated with or identify a particular taxpayer) to a person other than another GAO officer or employee whose official duties require the disclosure, except as subsection (f) or (p)(6) authorizes or as expressly provided by law — section 6103(i)(8)(A), last clause";
}

@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "except that no such officer or employee shall, except to the extent authorized by subsection (f) or (p)(6), disclose to any person, other than another officer or employee of such office whose official duties require such disclosure, any return or")
@source(IRC_S6103_I, relation = formalizes, coverage = partial, quote = "The restrictions contained in subparagraph (A) on the disclosure of any returns or return information open to inspection or disclosed under such subparagraph shall also apply to returns and return information open to inspection or disclosed under")
rule S6103I8GaoRedisclosureBanRule strict {
    for d: Disclosure;
    for officer: Person;
    when disclosure_to(d, officer)
        and recipient_is(d, GovernmentAccountabilityOfficeOfficer);
    then prohibition S6103I8GaoRedisclosureBan {
        bearer officer;
        action i8_gao_officer_disclosed_to_person_who_is_not_official_gao_colleague(d);
        window [-infinity, infinity];
    };
}

pub relation i8b_audit_completed_on(d: Disclosure, completedOn: Date) kind empirical {
    label en unofficial "case fact: the date the audit for which returns or return information were opened to inspection or disclosed under (B)(i) or (ii) was completed";
}

pub relation i8b_notification_to_joint_committee_filed_on(d: Disclosure, notifiedOn: Date) kind empirical {
    label en unofficial "case fact: the date the Comptroller General notified the Joint Committee on Taxation in writing of the completion of the audit, with the description of use, recommendations, and the statement on confidentiality impact — section 6103(i)(8)(B)(iii)(I)-(III)";
}

pub relation i8b_completion_notice_timely(d: Disclosure) kind institutional {
    label en unofficial "the Comptroller General notified the Joint Committee on Taxation of the completion of the audit within 90 days";
}

@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "Within 90 days after the completion of an audit with respect to which returns or return information were opened to inspection or disclosed under clause (i) or (ii), the Comptroller General of the United States shall notify in writing the Joint")
rule S6103I8BiiiNoticeTimelyClassification strict {
    for d: Disclosure;
    for completedOn: Date;
    for notifiedOn: Date;
    when i8b_audit_completed_on(d, completedOn)
        and i8b_notification_to_joint_committee_filed_on(d, notifiedOn)
        and notifiedOn <= add_calendar_period(completedOn, 90 calendar_day);
    then i8b_completion_notice_timely(d);
}

@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "Within 90 days after the completion of an audit with respect to which returns or return information were opened to inspection or disclosed under clause (i) or (ii), the Comptroller General of the United States shall notify in writing the Joint")
@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "(I) a description of the use of the returns and return information by the Federal agency involved,")
@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "(II) such recommendations with respect to the use of returns and return information by such Federal")
@source(IRC_S6103_I, relation = formalizes, coverage = exact, quote = "(III) a statement on the impact of any such recommendations on confidentiality of returns and")
rule S6103I8BiiiCompletionNoticeDutyRule strict {
    for d: Disclosure;
    for completedOn: Date;
    when i8b_audit_completed_on(d, completedOn);
    then duty S6103I8BiiiCompletionNoticeDuty {
        bearer ComptrollerGeneral;
        beneficiary JointCommitteeOnTaxation;
        goal achievement {
            condition i8b_completion_notice_timely(d);
            window [completedOn, add_calendar_period(completedOn, 90 calendar_day)];
        }
    };
}
