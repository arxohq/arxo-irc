// 26 U.S.C. §6103(e) — Disclosure to persons having material interest.
// STAGE 1 PARTIAL: (e)(1)(A)(i) the individual himself, (e)(1)(B) either
// spouse on a joint return, (e)(1)(D)(iii) a bona fide shareholder of
// record owning 1 percent or more of a corporation's outstanding stock,
// and (e)(7) (return information, subject to the Secretary's
// non-impairment determination) are modeled. (e)(1)(A)(ii)-(iii), (C),
// (D)(i)(ii)(iv)(v), (E), (F), (2)-(6), (8)-(11) are `unreviewed` — each
// names its own bearer class and its own conditions (spousal gift-
// splitting consent, child support, partnership membership, corporate
// board resolution, S-corp shareholder-during-election, dissolved
// corporation, estate/trust fiduciaries and material-interest findings,
// incompetency, decedents, bankruptcy trustees/receivers, attorneys in
// fact, joint-return collection-activity disclosure, section 6672
// co-liability disclosure, whistleblower-investigation-status disclosure)
// and was not reached this stage (coverage rows list each individually).

// ---------------------------------------------------------------------
// (e)(1)(A)(i) — the individual whose return it is
// ---------------------------------------------------------------------

use self::{
    Corporation,
    Disclosure,
    IRC_S6103_E,
    Individual,
    Person,
    ReturnInformation,
    about_taxpayer,
    disclosure_of,
    disclosure_permitted,
    disclosure_to,
};

pub relation return_of_individual(info: ReturnInformation, individual: Individual) kind empirical {
    label en unofficial "case fact: the return information is the return of this individual — section 6103(e)(1)(A)";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "The return of a person shall, upon written request, be open to inspection by or disclosure to")
@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "that individual,")
rule S6103E1AiSelfDisclosurePermitted strict {
    for d: Disclosure;
    for individual: Individual;
    for info: ReturnInformation;
    when disclosure_of(d, info)
        and disclosure_to(d, individual)
        and return_of_individual(info, individual)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation written_request_for_inspection(d: Disclosure) kind empirical {
    label en unofficial "case fact: the inspection or disclosure under section 6103(e) was made upon written request, as every paragraph of (e) requires";
}

// ---------------------------------------------------------------------
// (e)(1)(B) — either spouse on a joint return
// ---------------------------------------------------------------------

pub relation joint_return_of(info: ReturnInformation, spouseOne: Individual, spouseTwo: Individual) kind empirical {
    label en unofficial "case fact: the return information is an income tax return filed jointly by these two individuals — section 6103(e)(1)(B)";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "in the case of an income tax return filed jointly, either of the individuals with respect to whom the return is filed;")
rule S6103E1BJointReturnDisclosurePermitted strict {
    for d: Disclosure;
    for spouseOne: Individual;
    for spouseTwo: Individual;
    for recipient: Individual;
    for info: ReturnInformation;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and joint_return_of(info, spouseOne, spouseTwo)
        and (recipient == spouseOne or recipient == spouseTwo)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

// ---------------------------------------------------------------------
// (e)(1)(D)(iii) — bona fide shareholder of record owning >= 1 percent
// ---------------------------------------------------------------------

pub relation return_of_corporation(info: ReturnInformation, corp: Corporation) kind empirical {
    label en unofficial "case fact: the return information is the return of this corporation (or a subsidiary thereof) — section 6103(e)(1)(D)";
}
pub relation shareholder_of_record_percent(d: Disclosure, shareholder: Person, corp: Corporation, percent: Decimal) kind empirical {
    label en unofficial "case fact: the recipient is a bona fide shareholder of record owning this percentage of the outstanding stock of the corporation as of the disclosure";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "any bona fide shareholder of record owning 1 percent or more of the outstanding stock of such corporation,")
rule S6103E1DiiiShareholderDisclosurePermitted strict {
    for d: Disclosure;
    for recipient: Person;
    for corp: Corporation;
    for info: ReturnInformation;
    for percent: Decimal;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_corporation(info, corp)
        and shareholder_of_record_percent(d, recipient, corp, percent)
        and percent >= 0.01
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

// ---------------------------------------------------------------------
// (e)(7) — return information (as opposed to the return itself)
// ---------------------------------------------------------------------

external judgment relation secretary_determines_disclosure_would_not_seriously_impair_administration_e7(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that disclosure of return information (as opposed to the return itself) to a person otherwise authorized by section 6103(e) would not seriously impair Federal tax administration — section 6103(e)(7)";
}
pub relation authorized_under_e_for_return(d: Disclosure, taxpayer: Person) kind empirical {
    label en unofficial "case fact: the recipient of d is a person this package's (e)(1)(A)/(B)/(D)(iii) rules would authorize to inspect a RETURN of this taxpayer — the (e)(7) bridge to return INFORMATION about the same taxpayer";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "Return information with respect to any taxpayer may be open to inspection by or disclosure to any person authorized by this subsection to inspect any return of such taxpayer if the Secretary determines that such disclosure would not seriously impair Federal tax administration.")
rule S6103E7ReturnInformationDisclosurePermitted defeasible {
    for d: Disclosure;
    for taxpayer: Person;
    for info: ReturnInformation;
    when authorized_under_e_for_return(d, taxpayer)
        and about_taxpayer(info, taxpayer)
        and disclosure_of(d, info)
        and secretary_determines_disclosure_would_not_seriously_impair_administration_e7(d);
    then disclosure_permitted(d);
}
