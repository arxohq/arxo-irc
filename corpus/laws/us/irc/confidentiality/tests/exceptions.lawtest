        assert "f1": chairman_of_committee(entity_ref("urn:test:s6103f1:t1#chairman"), entity_ref("urn:test:s6103f1:t1#committee")) { origin case_input; }
        assert "f2": named_f1_committee(entity_ref("urn:test:s6103f1:t1#committee")) { origin case_input; }
