test "S6103P4-02-NONCOMPLIANT-AGENCY-WITHHOLDING-POWER-VALID" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": secretary_determines_agency_failed_safeguards(entity_ref("urn:test:s6103p4:t2#agency")) { origin case_input; }
        assert "f1": secretary_withholds_further_disclosure(entity_ref("urn:test:s6103p4:t2#agency")) { origin case_input; }
    }
    evaluate positions();
    expect position(S6103P4WithholdDisclosurePower, VALIDLY_EXERCISED);
