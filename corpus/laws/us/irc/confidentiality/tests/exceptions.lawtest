// Scenarios for §6103(c) designee, (d)(1) State tax officials, (e)
// material interest, (f)(1) committees of Congress, (p)(3)/(4) safeguards.
// package us.irc.confidentiality, modules 02-05. NOT executed in this
// stage — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.confidentiality version "0.1.1";
namespace "urn:us:irc:confidentiality:clir";

// --- (c) designee of taxpayer -------------------------------------------

test "S6103C-01-WRITTEN-CONSENT-DESIGNEE-DISCLOSURE-PERMITTED" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": designated_by_taxpayer(entity_ref("urn:test:s6103c:t1#d"), entity_ref("urn:test:s6103c:t1#taxpayer")) { origin case_input; }
        assert "f1": disclosure_of(entity_ref("urn:test:s6103c:t1#d"), entity_ref("urn:test:s6103c:t1#info")) { origin case_input; }
        assert "f2": about_taxpayer(entity_ref("urn:test:s6103c:t1#info"), entity_ref("urn:test:s6103c:t1#taxpayer")) { origin case_input; }
    }
    evaluate truth(disclosure_permitted(entity_ref("urn:test:s6103c:t1#d")));
    expect truth_status == TRUE_ONLY;
}

