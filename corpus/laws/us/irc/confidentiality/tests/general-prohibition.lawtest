// Scenarios for §6103(a) general prohibition and the covered-person
// bearer classes, package us.irc.confidentiality, module
// 00-vocabulary.law / 01-general-prohibition.law. NOT executed in this
// stage — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.confidentiality version "0.1.1";
namespace "urn:us:irc:confidentiality:clir";

test "S6103A-01-FEDERAL-OFFICER-DISCLOSES-WITHOUT-EXCEPTION-VIOLATED" {
    given {
        context {
            legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00;
            knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": federal_officer_or_employee(entity_ref("urn:test:s6103a:t1#officer")) { origin case_input; }
        assert "f1": return_information_candidate(entity_ref("urn:test:s6103a:t1#info")) { origin case_input; }
        assert "f2": disclosure_by(entity_ref("urn:test:s6103a:t1#d"), entity_ref("urn:test:s6103a:t1#officer")) { origin case_input; }
        assert "f3": disclosure_to(entity_ref("urn:test:s6103a:t1#d"), entity_ref("urn:test:s6103a:t1#stranger")) { origin case_input; }
        assert "f4": disclosure_of(entity_ref("urn:test:s6103a:t1#d"), entity_ref("urn:test:s6103a:t1#info")) { origin case_input; }
    }
    evaluate positions();
    expect position(S6103AProhibition, VIOLATED);
}

test "S6103A-02-FEDERAL-OFFICER-PERMITTED-DISCLOSURE-PROHIBITION-DEFEATED" {
    // Stage 2 correction: the prohibition of (a) is instantiated per disclosure (its action is the
    // disclosure itself, E-0179), so a standing ACTIVE position without any disclosure does not
    // exist. A disclosure the (c) designee exception authorizes defeats the prohibition instead.
    given {
        context {
            legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00;
            knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": federal_officer_or_employee(entity_ref("urn:test:s6103a:t2#officer")) { origin case_input; }
        assert "f1": return_information_candidate(entity_ref("urn:test:s6103a:t2#info")) { origin case_input; }
        assert "f2": disclosure_by(entity_ref("urn:test:s6103a:t2#d"), entity_ref("urn:test:s6103a:t2#officer")) { origin case_input; }
        assert "f3": disclosure_to(entity_ref("urn:test:s6103a:t2#d"), entity_ref("urn:test:s6103a:t2#designee")) { origin case_input; }
        assert "f4": disclosure_of(entity_ref("urn:test:s6103a:t2#d"), entity_ref("urn:test:s6103a:t2#info")) { origin case_input; }
        assert "f5": designated_by_taxpayer(entity_ref("urn:test:s6103a:t2#d"), entity_ref("urn:test:s6103a:t2#taxpayer")) { origin case_input; }
        assert "f6": about_taxpayer(entity_ref("urn:test:s6103a:t2#info"), entity_ref("urn:test:s6103a:t2#taxpayer")) { origin case_input; }
    }
    evaluate positions();
    expect position(S6103AProhibition, DEFEATED);
}

test "S6103A-03-UNCOVERED-PERSON-DISCLOSES-NOT-A-BEARER" {
    // A person the case does not assert as a federal/state officer or an
    // "other person with access" is simply not bound by (a) at all for
    // this scenario (module 00 header judgment call).
    given {
        context {
            legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00;
            knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": return_information_candidate(entity_ref("urn:test:s6103a:t3#info")) { origin case_input; }
        assert "f1": disclosure_by(entity_ref("urn:test:s6103a:t3#d"), entity_ref("urn:test:s6103a:t3#bystander")) { origin case_input; }
        assert "f2": disclosure_to(entity_ref("urn:test:s6103a:t3#d"), entity_ref("urn:test:s6103a:t3#stranger")) { origin case_input; }
        assert "f3": disclosure_of(entity_ref("urn:test:s6103a:t3#d"), entity_ref("urn:test:s6103a:t3#info")) { origin case_input; }
    }
    evaluate truth(covered_person(entity_ref("urn:test:s6103a:t3#bystander")));
    expect truth_status == NEITHER;
}

test "S6103A-04-NOT-ASSOCIABLE-DATA-NOT-RETURN-INFORMATION" {
    given {
        context {
            legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00;
            knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": return_information_candidate(entity_ref("urn:test:s6103a:t4#info")) { origin case_input; }
        assert "f1": data_not_associable_with_taxpayer(entity_ref("urn:test:s6103a:t4#info")) { origin case_input; }
    }
    evaluate truth(return_information(entity_ref("urn:test:s6103a:t4#info")));
    // Stage 2 correction: the defeater removes the conclusion; a negation is not asserted, so the status is NEITHER.
    expect truth_status == NEITHER;
}

test "S6103A-05-UNAUTHORIZED-DISCLOSURE-PUBLISHED-FOR-JUDICIAL-PROCEEDINGS" {
    given {
        context {
            legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00;
            knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": federal_officer_or_employee(entity_ref("urn:test:s6103a:t5#officer")) { origin case_input; }
        assert "f1": return_information_candidate(entity_ref("urn:test:s6103a:t5#info")) { origin case_input; }
        assert "f2": disclosure_by(entity_ref("urn:test:s6103a:t5#d"), entity_ref("urn:test:s6103a:t5#officer")) { origin case_input; }
        assert "f3": disclosure_to(entity_ref("urn:test:s6103a:t5#d"), entity_ref("urn:test:s6103a:t5#stranger")) { origin case_input; }
        assert "f4": disclosure_of(entity_ref("urn:test:s6103a:t5#d"), entity_ref("urn:test:s6103a:t5#info")) { origin case_input; }
    }
    evaluate truth(unauthorized_disclosure(entity_ref("urn:test:s6103a:t5#d")));
    expect truth_status == TRUE_ONLY;
}
