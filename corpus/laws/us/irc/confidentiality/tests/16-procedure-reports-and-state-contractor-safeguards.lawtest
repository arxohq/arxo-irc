        assert "f0": disclosure_upon_written_request(entity_ref("urn:test:p2a:1#d")) { origin case_input; }
        assert "f1": disclosure_to(entity_ref("urn:test:p2a:1#d"), entity_ref("urn:test:p2a:1#person")) { origin case_input; }
        assert "f2": disclosure_of(entity_ref("urn:test:p2a:1#d"), entity_ref("urn:test:p2a:1#info")) { origin case_input; }
        assert "f3": designated_by_taxpayer(entity_ref("urn:test:p2a:1#d"), entity_ref("urn:test:p2a:1#taxpayer")) { origin case_input; }
