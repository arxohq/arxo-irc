// Section 6103(p)(1) regulation reader (IRC-G/G4, CFR wiring 27.09.2026).
// Вывод / нет факта источника: a request/inspection following the
// Secretary-prescribed manner, time and place satisfies (p)(1) (TRUE_ONLY);
// without that fact nothing derives (NEITHER). Expectations from the
// statutory text.

language "law.core" version "0.2";
package us.irc.confidentiality version "0.1.1";
namespace "urn:us:irc:confidentiality:clir";

test "S6103-CFR-01-PRESCRIBED-MANNER-DERIVES" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f1": request_or_inspection_in_secretary_prescribed_manner_6103p1(entity_ref("urn:test:s6103cfr:1#d")) { origin case_input; }
    }
    evaluate truth(inspection_or_disclosure_in_prescribed_manner_time_place_6103p1(entity_ref("urn:test:s6103cfr:1#d")));
    expect truth_status == TRUE_ONLY;
}

test "S6103-CFR-02-WITHOUT-PRESCRIBED-MANNER-NEITHER" {
    given {
        context { legal_time @2025-04-15; decision_time @2025-04-15T09:00:00-05:00; knowledge_time @2025-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f1": disclosure_permitted(entity_ref("urn:test:s6103cfr:2#d")) { origin case_input; }
    }
    // permission alone does not establish the (p)(1) manner/time/place compliance.
    evaluate truth(inspection_or_disclosure_in_prescribed_manner_time_place_6103p1(entity_ref("urn:test:s6103cfr:2#d")));
    expect truth_status == NEITHER;
}
