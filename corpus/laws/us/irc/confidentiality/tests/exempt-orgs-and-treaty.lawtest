// Scenarios for §6104(d) public inspection of exempt organizations and
// §6105 treaty confidentiality. package us.irc.confidentiality, modules
// 06-07. NOT executed in this stage — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.confidentiality version "0.1.1";
namespace "urn:us:irc:confidentiality:clir";

// --- §6104(d): in-person immediate vs. written 30-day; day 30 vs day 31 --

test "S6104D-01-IN-PERSON-REQUEST-PROVIDED-SAME-DAY-TIMELY" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-04:00; knowledge_time @2026-05-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": copy_request_made(entity_ref("urn:test:s6104d:t1#org"), entity_ref("urn:test:s6104d:t1#requester"), @2026-05-01) { origin case_input; }
        assert "f1": copy_request_in_person(entity_ref("urn:test:s6104d:t1#org"), entity_ref("urn:test:s6104d:t1#requester")) { origin case_input; }
        assert "f2": copy_provided_on(entity_ref("urn:test:s6104d:t1#org"), entity_ref("urn:test:s6104d:t1#requester"), @2026-05-01) { origin case_input; }
    }
    evaluate truth(copy_provided_timely(entity_ref("urn:test:s6104d:t1#org"), entity_ref("urn:test:s6104d:t1#requester")));
    expect truth_status == TRUE_ONLY;
}

test "S6104D-02-WRITTEN-REQUEST-PROVIDED-ON-DAY-30-TIMELY" {
    given {
        context { legal_time @2026-06-01; decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": copy_request_made(entity_ref("urn:test:s6104d:t2#org"), entity_ref("urn:test:s6104d:t2#requester"), @2026-05-01) { origin case_input; }
        assert "f1": copy_provided_on(entity_ref("urn:test:s6104d:t2#org"), entity_ref("urn:test:s6104d:t2#requester"), @2026-05-31) { origin case_input; }
    }
    evaluate truth(copy_provided_timely(entity_ref("urn:test:s6104d:t2#org"), entity_ref("urn:test:s6104d:t2#requester")));
    expect truth_status == TRUE_ONLY;
}

test "S6104D-03-WRITTEN-REQUEST-PROVIDED-ON-DAY-31-NOT-TIMELY" {
    given {
        context { legal_time @2026-06-02; decision_time @2026-06-02T09:00:00-04:00; knowledge_time @2026-06-02T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": copy_request_made(entity_ref("urn:test:s6104d:t3#org"), entity_ref("urn:test:s6104d:t3#requester"), @2026-05-01) { origin case_input; }
        assert "f1": copy_provided_on(entity_ref("urn:test:s6104d:t3#org"), entity_ref("urn:test:s6104d:t3#requester"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(copy_provided_timely(entity_ref("urn:test:s6104d:t3#org"), entity_ref("urn:test:s6104d:t3#requester")));
    // Stage 2 correction: no negation is asserted for a late copy; the timely-copy conclusion is simply not derived.
    expect truth_status == NEITHER;
}

test "S6104D-04-WIDELY-AVAILABLE-EXCEPTION-BLOCKS-COPY-DUTY" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-04:00; knowledge_time @2026-05-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": described_501c_or_d_or_527a(entity_ref("urn:test:s6104d:t4#org")) { origin case_input; }
        assert "f1": annual_return_in_3_year_window(entity_ref("urn:test:s6104d:t4#org")) { origin case_input; }
        assert "f2": copy_request_made(entity_ref("urn:test:s6104d:t4#org"), entity_ref("urn:test:s6104d:t4#requester"), @2026-05-01) { origin case_input; }
        assert "f3": widely_available(entity_ref("urn:test:s6104d:t4#org")) { origin case_input; }
    }
    evaluate positions();
    expect not position(S6104D1BCopyDuty, ACTIVE);
}

// --- §6105: treaty confidentiality ----------------------------------------

test "S6105-01-DISCLOSURE-NOT-ENTITLED-VIOLATED" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": tax_convention_disclosure_by(entity_ref("urn:test:s6105:t1#d"), entity_ref("urn:test:s6105:t1#officer")) { origin case_input; }
        assert "f1": tax_convention_disclosure_of(entity_ref("urn:test:s6105:t1#d"), entity_ref("urn:test:s6105:t1#info")) { origin case_input; }
    }
    evaluate positions();
    expect position(S6105AProhibition, VIOLATED);
}

test "S6105-02-DISCLOSURE-TO-ENTITLED-AUTHORITY-PERMITTED" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": tax_convention_disclosure_to(entity_ref("urn:test:s6105:t2#d"), entity_ref("urn:test:s6105:t2#court")) { origin case_input; }
        assert "f1": entitled_by_tax_convention(entity_ref("urn:test:s6105:t2#court"), entity_ref("urn:test:s6105:t2#d")) { origin case_input; }
    }
    evaluate truth(tax_convention_disclosure_permitted(entity_ref("urn:test:s6105:t2#d")));
    expect truth_status == TRUE_ONLY;
}
