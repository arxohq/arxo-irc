// Scenarios for §6110 written-determination public inspection timing.
// package us.irc.confidentiality, module 08-written-determinations.law.
// NOT executed in this stage — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.confidentiality version "0.1.1";
namespace "urn:us:irc:confidentiality:clir";

test "S6110G-01-NO-PETITION-OPEN-AT-90-DAYS" {
    given {
        context { legal_time @2026-09-01; decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": notice_of_intention_mailed_on(entity_ref("urn:test:s6110g:t1#wd"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(written_determination_open_on(entity_ref("urn:test:s6110g:t1#wd"), @2026-08-30));
    expect truth_status == TRUE_ONLY;
}

test "S6110G-02-EARLIEST-DATE-IS-75-DAYS-AFTER-MAILING" {
    given {
        context { legal_time @2026-09-01; decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": notice_of_intention_mailed_on(entity_ref("urn:test:s6110g:t2#wd"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(written_determination_open_earliest(entity_ref("urn:test:s6110g:t2#wd"), @2026-08-15));
    expect truth_status == TRUE_ONLY;
}

test "S6110G-03-PETITION-DECIDED-OPEN-30-DAYS-AFTER-FINAL" {
    given {
        context { legal_time @2026-09-01; decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": notice_of_intention_mailed_on(entity_ref("urn:test:s6110g:t3#wd"), @2026-06-01) { origin case_input; }
        assert "f1": court_decision_under_f3_final_on(entity_ref("urn:test:s6110g:t3#wd"), @2026-08-01) { origin case_input; }
    }
    evaluate truth(written_determination_open_on(entity_ref("urn:test:s6110g:t3#wd"), @2026-08-31));
    expect truth_status == TRUE_ONLY;
}

// G170: the court decision is final so early that the (A) 90-day date is
// later — "if later" keeps the 90-day date, not 30 days after the decision.
test "S6110G-04-EARLY-COURT-DECISION-KEEPS-THE-LATER-90-DAY-DATE" {
    given {
        context { legal_time @2026-09-01; decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": notice_of_intention_mailed_on(entity_ref("urn:test:s6110g:t4#wd"), @2026-06-01) { origin case_input; }
        assert "f1": court_decision_under_f3_final_on(entity_ref("urn:test:s6110g:t4#wd"), @2026-06-15) { origin case_input; }
    }
    evaluate truth(written_determination_open_on(entity_ref("urn:test:s6110g:t4#wd"), @2026-08-30));
    expect truth_status == TRUE_ONLY;
}

test "S6110G-05-EARLIER-30-DAY-DATE-IS-NOT-THE-OPEN-DATE" {
    given {
        context { legal_time @2026-09-01; decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": notice_of_intention_mailed_on(entity_ref("urn:test:s6110g:t5#wd"), @2026-06-01) { origin case_input; }
        assert "f1": court_decision_under_f3_final_on(entity_ref("urn:test:s6110g:t5#wd"), @2026-06-15) { origin case_input; }
    }
    evaluate truth(written_determination_open_on(entity_ref("urn:test:s6110g:t5#wd"), @2026-07-15));
    expect truth_status == NEITHER;
}

test "S6110G-06-LATE-COURT-DECISION-DISPLACES-THE-90-DAY-DATE" {
    given {
        context { legal_time @2026-09-01; decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": notice_of_intention_mailed_on(entity_ref("urn:test:s6110g:t6#wd"), @2026-06-01) { origin case_input; }
        assert "f1": court_decision_under_f3_final_on(entity_ref("urn:test:s6110g:t6#wd"), @2026-08-01) { origin case_input; }
    }
    evaluate truth(written_determination_open_on(entity_ref("urn:test:s6110g:t6#wd"), @2026-08-30));
    expect truth_status == NEITHER;
}

test "S6110A-01-DELETIONS-MADE-OPEN-TO-INSPECTION" {
    given {
        context { legal_time @2026-09-01; decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": deletions_made(entity_ref("urn:test:s6110a:t1#wd")) { origin case_input; }
    }
    evaluate truth(written_determination_open_to_inspection(entity_ref("urn:test:s6110a:t1#wd")));
    expect truth_status == TRUE_ONLY;
}

test "S6110A-02-NO-DELETIONS-YET-NOT-OPEN" {
    given {
        context { legal_time @2026-09-01; decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": deletion_category_applies(entity_ref("urn:test:s6110a:t2#wd"), IdentifyingDetails) { origin case_input; }
    }
    evaluate truth(written_determination_open_to_inspection(entity_ref("urn:test:s6110a:t2#wd")));
    expect truth_status == NEITHER;
}
