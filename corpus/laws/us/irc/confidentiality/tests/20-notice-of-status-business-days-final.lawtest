// Final TECH_GAP pass (26.09.2026): section 6104(a)(3)(B) (G6889). NOT EXECUTED (implemented_unverified).
// The test family carries the business-day calendar snapshot derived from 5 U.S.C. 6103 (`us.code.clir.federal_calendar`, 2026).

language "law.core" version "0.2";
package us.irc.confidentiality version "0.1.1";
namespace "urn:us:irc:confidentiality:clir";

test "S6104A3B-01-FIFTH-BUSINESS-DAY-AFTER-A-2026-09-30-NOTICE" {
    // received Wed 2026-09-30: 10/1, 10/2, 10/5, 10/6, 10/7 = 5 business days; the holiday of Mon 2026-10-12 lies outside the window.
    given {
        context {
            legal_time @2026-10-08;
            decision_time @2026-10-08T09:00:00-05:00;
            knowledge_time @2026-10-08T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.confidentiality::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": notice_of_status_under_527i_received_on(entity_ref("urn:test:s6104:1#o"), @2026-09-30) { origin case_input; }
    }
    evaluate truth(computed_five_business_day_deadline_for_527i_notice(entity_ref("urn:test:s6104:1#o"), @2026-10-07));
    expect truth_status == TRUE_ONLY;
}

test "S6104A3B-02-INFORMATION-MADE-PUBLIC-BY-THE-COMPUTED-DEADLINE" {
    // notice 2026-09-30, information public 2026-10-07: in time.
    given {
        context {
            legal_time @2026-10-08;
            decision_time @2026-10-08T09:00:00-05:00;
            knowledge_time @2026-10-08T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.confidentiality::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": notice_of_status_under_527i_received_on(entity_ref("urn:test:s6104:2#o"), @2026-09-30) { origin case_input; }
        assert "f1": political_organization_information_made_public_on(entity_ref("urn:test:s6104:2#o"), @2026-10-07) { origin case_input; }
    }
    evaluate truth(political_organization_information_public_in_time(entity_ref("urn:test:s6104:2#o")));
    expect truth_status == TRUE_ONLY;
}

test "S6104A3B-03-INFORMATION-MADE-PUBLIC-AFTER-THE-COMPUTED-DEADLINE" {
    // information public 2026-10-08: not in time.
    given {
        context {
            legal_time @2026-10-08;
            decision_time @2026-10-08T09:00:00-05:00;
            knowledge_time @2026-10-08T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.confidentiality::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": notice_of_status_under_527i_received_on(entity_ref("urn:test:s6104:3#o"), @2026-09-30) { origin case_input; }
        assert "f1": political_organization_information_made_public_on(entity_ref("urn:test:s6104:3#o"), @2026-10-08) { origin case_input; }
    }
    evaluate truth(political_organization_information_public_in_time(entity_ref("urn:test:s6104:3#o")));
    expect truth_status == NEITHER;
}

test "S6104A3B-04-HOLIDAY-INSIDE-THE-WINDOW-IS-SKIPPED" {
    // received Thu 2026-10-08: 10/9, 10/13 (10/12 is a holiday), 10/14, 10/15, 10/16 = the 5th business day is 2026-10-16.
    given {
        context {
            legal_time @2026-10-08;
            decision_time @2026-10-08T09:00:00-05:00;
            knowledge_time @2026-10-08T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.confidentiality::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": notice_of_status_under_527i_received_on(entity_ref("urn:test:s6104:4#o"), @2026-10-08) { origin case_input; }
    }
    evaluate truth(computed_five_business_day_deadline_for_527i_notice(entity_ref("urn:test:s6104:4#o"), @2026-10-16));
    expect truth_status == TRUE_ONLY;
}

test "S6104A3B-05-ASSERTED-DEADLINE-WHEN-NO-RECEIPT-DATE" {
    // only the asserted deadline: the duty reads it.
    given {
        context {
            legal_time @2026-10-08;
            decision_time @2026-10-08T09:00:00-05:00;
            knowledge_time @2026-10-08T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.confidentiality::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": five_business_day_deadline_for_527i_notice(entity_ref("urn:test:s6104:5#o"), @2026-10-07) { origin case_input; }
    }
    evaluate truth(deadline_for_527i_notice_for_duty(entity_ref("urn:test:s6104:5#o"), @2026-10-07));
    expect truth_status == TRUE_ONLY;
}
