pub relation l15_6050i_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of information contained on returns filed under section 6050I (cash received in a trade or business), on the same basis and subject to the same conditions as apply to disclosures of information on reports filed under section 5313 of title 31, United States Code — section 6103(l)(15)";
