// 26 U.S.C. §6103(l) — Disclosure of returns and return information for purposes other than
// tax administration: the Social Security Administration and Railroad Retirement Board,
// Labor and the PBGC, Federal loan agencies, personnel and practitioner matters, child
// support enforcement, means-tested programs, Federal Employees' Retirement System,
// Medicare and health coverage programs, student financial aid, Customs, section 6050I
// returns, the District of Columbia Retirement Protection Act, the National Archives, the
// advance credit program, and Medicare program integrity. STAGE 2.
// Each paragraph is a permission (a defeater of the section 6103(a) prohibition) and, where
// the text says "shall", also a duty of the discloser (the Secretary or the Commissioner of
// Social Security) with the requesting organ as beneficiary. "For use only / solely /
// only for purposes of" limits on the recipient are prohibitions that stand while the
// disclosure is within the paragraph. The statutory item lists of what may be disclosed
// ("limited to (i)-(viii)") are one scope fact per paragraph (interpretive consolidation,
// flagged INTERPRETATION per list in the coverage rows, as for the (b)(2) lists in stage 1).
// External statutes (the Social Security Act, the Higher Education Act, ERISA, Title 38) are
// not pinned: the programs named are recorded as facts of the disclosure, not evaluated.

use self::{
    CommissionerOfSocialSecurity,
    Disclosure,
    IRC_S6103_L,
    Individual,
    Organ,
    Person,
    Recipient,
    Secretary,
    disclosure_by,
    disclosure_permitted,
    disclosure_to,
    disclosure_upon_written_request,
    recipient_is,
    recipient_organ,
};

pub relation l1a_ssa_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the returns and return information relate to taxes imposed by chapters 2, 21, and 24 and are disclosed to the Social Security Administration for purposes of its administration of the Social Security Act — section 6103(l)(1)(A)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(A) taxes imposed by chapters 2, 21, and 24, to the Social Security Administration for purposes of its administration of the Social Security Act;")
rule S6103L1ASocialSecurityActAdministrationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, SocialSecurityAdministrationOfficerL1)
        and disclosure_upon_written_request(d)
        and l1a_ssa_scope(d);
    then disclosure_permitted(d);
}

pub relation l1b_ssa_plans_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the returns and return information relate to a plan to which part I of subchapter D of chapter 1 applies, are disclosed to the Social Security Administration for carrying out its responsibility under section 1131 of the Social Security Act, and are limited to return information described in section 6057(d) — section 6103(l)(1)(B)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(B) a plan to which part I of subchapter D of chapter 1 applies, to the Social Security Administration for purposes of carrying out its responsibility under section 1131 of the Social Security Act,")
rule S6103L1BSocialSecurityPlanInformationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, SocialSecurityAdministrationOfficerL1B)
        and disclosure_upon_written_request(d)
        and l1b_ssa_plans_scope(d);
    then disclosure_permitted(d);
}

pub relation l1c_rrb_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the returns and return information relate to taxes imposed by chapter 22 and are disclosed to the Railroad Retirement Board for purposes of its administration of the Railroad Retirement Act — section 6103(l)(1)(C)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(C) taxes imposed by chapter 22, to the Railroad Retirement Board for purposes of its administration of the Railroad Retirement Act.")
rule S6103L1CRailroadRetirementAdministrationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, RailroadRetirementBoardOfficer)
        and disclosure_upon_written_request(d)
        and l1c_rrb_scope(d);
    then disclosure_permitted(d);
}

pub relation l2_dol_pbgc_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: returns and return information are furnished to the proper officers and employees of the Department of Labor and the Pension Benefit Guaranty Corporation for purposes of, but only to the extent necessary in, the administration of titles I and IV of the Employee Retirement Income Security Act of 1974 — section 6103(l)(2)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary may, upon written request, furnish returns and return information to the proper officers and employees of the Department of Labor and the Pension Benefit Guaranty Corporation for")
rule S6103L2LaborAndPbgcErisaDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, DepartmentOfLaborOrPbgcOfficer)
        and disclosure_upon_written_request(d)
        and l2_dol_pbgc_scope(d);
    then disclosure_permitted(d);
}

pub entity FederalProgram {
    label en unofficial "a program of the United States or a Federal agency (loan, benefit, or assistance program) named by section 6103(l)";
}

pub relation program_makes_guarantees_or_insures_loans_of_united_states_or_federal_agency(program: FederalProgram) kind empirical {
    label en unofficial "case fact: the program is one under which the United States or a Federal agency makes, guarantees, or insures loans — section 6103(l)(3)(C)";
}

pub relation included_federal_loan_program(program: FederalProgram) kind institutional {
    label en unofficial "the program is an \"included Federal loan program\" within the meaning of section 6103(l)(3)(C)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"included Federal loan program\" means any program under which the United States or a Federal agency makes, guarantees, or insures loans.")
rule S6103L3CIncludedFederalLoanProgramDefinition strict {
    for program: FederalProgram;
    when program_makes_guarantees_or_insures_loans_of_united_states_or_federal_agency(program);
    then included_federal_loan_program(program);
}

pub relation l3_disclosure_program(d: Disclosure, program: FederalProgram) kind empirical {
    label en unofficial "case fact: the disclosure d is to the head of the agency administering this loan program";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "Upon written request, the Secretary may disclose to the head of the Federal agency administering any included Federal loan program whether or not an applicant for a loan under such program has a tax delinquent account.")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Any disclosure under subparagraph (A) shall be made only for the purpose of, and to the extent necessary in, determining the creditworthiness of the applicant for the loan in question.")
rule S6103L3AApplicantTaxDelinquencyDisclosurePermitted strict {
    for d: Disclosure;
    for program: FederalProgram;
    when recipient_is(d, HeadOfFederalLoanAgency)
        and disclosure_upon_written_request(d)
        and l3_disclosure_program(d, program)
        and included_federal_loan_program(program)
        and l3a_creditworthiness_scope(d);
    then disclosure_permitted(d);
}

pub relation l3a_creditworthiness_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is whether or not an applicant for a loan under the program has a tax delinquent account, made only for the purpose of, and to the extent necessary in, determining the creditworthiness of the applicant for the loan in question — section 6103(l)(3)(A)-(B)";
}

external judgment relation secretary_determines_l4_returns_relevant_and_material_to_action(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the returns or return information is or may be relevant and material to the action or proceeding — section 6103(l)(4)(A), tail";
}

pub relation l4ai_employee_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to an employee or former employee of the Department of the Treasury (or his duly authorized legal representative) who is or may be a party to an administrative action or proceeding affecting the personnel rights of the employee, solely for use in the action or proceeding or in preparation for it — section 6103(l)(4)(A)(i)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(i) to an employee or former employee of the Department of the Treasury, or to the duly authorized legal representative of such employee or former employee, who is or may be a party to any administrative action or proceeding affecting the personnel")
rule S6103L4AiTreasuryEmployeePersonnelActionDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, TreasuryEmployeeOrRepresentativeInPersonnelAction)
        and disclosure_upon_written_request(d)
        and l4ai_employee_scope(d)
        and secretary_determines_l4_returns_relevant_and_material_to_action(d);
    then disclosure_permitted(d);
}

pub relation l4aii_practitioner_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to a person (or his duly authorized legal representative) whose rights are or may be affected by an administrative action or proceeding under section 330 of title 31, United States Code, solely for use in the action or proceeding or in preparation for it — section 6103(l)(4)(A)(ii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(ii) to any person, or to the duly authorized legal representative of such person, whose rights are or may be affected by an administrative action or proceeding under section 330 of title 31, United States Code,")
rule S6103L4AiiSection330ProceedingPersonDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, PersonAffectedBySection330Proceeding)
        and disclosure_upon_written_request(d)
        and l4aii_practitioner_scope(d)
        and secretary_determines_l4_returns_relevant_and_material_to_action(d);
    then disclosure_permitted(d);
}

pub relation l4b_treasury_officers_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to officers and employees of the Department of the Treasury for use in an action or proceeding described in subparagraph (A) (or its preparation), to the extent necessary to advance or protect the interests of the United States — section 6103(l)(4)(B)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(B) to officers and employees of the Department of the Treasury for use in any action or proceeding described in subparagraph (A), or in preparation for such action or proceeding, to the extent necessary to advance or protect the interests of the")
rule S6103L4BTreasuryOfficersInPersonnelOrPractitionerActionDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, TreasuryOfficerInPersonnelOrSection330Action)
        and l4b_treasury_officers_scope(d);
    then disclosure_permitted(d);
}

pub relation l5_ssa_information_returns_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: information returns filed under part III of subchapter A of chapter 61 are disclosed upon the written request of the Commissioner of Social Security for carrying out, under an agreement under section 232 of the Social Security Act, an effective return processing program, or for providing information on the mortality status of individuals for epidemiological and similar research in accordance with section 1106(d) of that Act — section 6103(l)(5)(A)-(B)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Upon written request by the Commissioner of Social Security, the Secretary may disclose information returns filed pursuant to part III of subchapter A of chapter 61 of this subtitle for the purpose")
rule S6103L5SocialSecurityInformationReturnsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, SocialSecurityAdministrationOfficerL5)
        and disclosure_upon_written_request(d)
        and l5_ssa_information_returns_scope(d);
    then disclosure_permitted(d);
}

pub relation agency_operating_under_approved_title_iv_d_plan(agency: Organ) kind empirical {
    label en unofficial "case fact: the agency of a State or political subdivision is operating pursuant to a plan described in section 454 of the Social Security Act which has been approved by the Secretary of Health and Human Services under part D of title IV — section 6103(l)(6)(D)(i)";
}

pub relation tribal_child_support_agency_receiving_455f_grant(agency: Organ) kind empirical {
    label en unofficial "case fact: the child support enforcement agency of an Indian tribe or tribal organization receives a grant under section 455(f) of the Social Security Act — section 6103(l)(6)(D)(ii)";
}

pub relation child_support_enforcement_agency(agency: Organ) kind institutional {
    label en unofficial "the agency is treated as a State, tribal, or local child support enforcement agency for section 6103(l)(6) and (8)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "(i) Any agency of a State or political subdivision thereof operating pursuant to a plan described in section 454 of the Social Security Act which has been approved by the Secretary of Health and Human Services under part D of title IV of such Act.")
rule S6103L6DiChildSupportAgencyStatePlan strict {
    for agency: Organ;
    when agency_operating_under_approved_title_iv_d_plan(agency);
    then child_support_enforcement_agency(agency);
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "(ii) Any child support enforcement agency of an Indian tribe or tribal organization receiving a grant under section 455(f) of the Social Security Act.")
rule S6103L6DiiChildSupportAgencyTribal strict {
    for agency: Organ;
    when tribal_child_support_agency_receiving_455f_grant(agency);
    then child_support_enforcement_agency(agency);
}

pub relation l6_recipient_agency(d: Disclosure, agency: Organ) kind empirical {
    label en unofficial "case fact: the disclosure d is made to this child support enforcement agency";
}

pub relation l6a_i_master_file_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of available return information from the Internal Revenue Service master files relating to the social security account number(s), address, filing status, amounts and nature of income, and number of dependents reported on a return filed by or with respect to an individual for whom child support obligations are sought to be established or enforced under part D of title IV of the Social Security Act, or an individual to whom such support is owing — section 6103(l)(6)(A)(i); the purpose is establishing and collecting child support obligations from, and locating, individuals owing them — (C)";
}

pub relation l6a_ii_gross_income_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of available return information reflected on a return relating to the individual's gross income (section 61), or the names and addresses of payors of such income and the names of dependents reported — section 6103(l)(6)(A)(ii); the purpose is establishing and collecting child support obligations — (C)";
}

pub relation l6a_ii_not_reasonably_available_from_any_other_source(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return information is not reasonably available from any other source — section 6103(l)(6)(A)(ii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary may, upon written request, disclose to the appropriate Federal, State, tribal, or local child support enforcement agency—")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(i) available return information from the master files of the Internal Revenue Service relating to the social security account number (or numbers, if the individual involved has more than one such number), address, filing status, amounts and nature")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Information may be disclosed under this paragraph only for purposes of, and to the extent necessary in, establishing and collecting child support obligations from, and locating, individuals owing such obligations.")
rule S6103L6AiMasterFileDisclosurePermitted strict {
    for d: Disclosure;
    for agency: Organ;
    when disclosure_upon_written_request(d)
        and l6_recipient_agency(d, agency)
        and child_support_enforcement_agency(agency)
        and l6a_i_master_file_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(ii) available return information reflected on any return filed by, or with respect to, any individual described in clause (i) relating to the amount of such individual's gross income (as defined in section 61) or consisting of the names and")
rule S6103L6AiiGrossIncomeDisclosurePermitted strict {
    for d: Disclosure;
    for agency: Organ;
    when disclosure_upon_written_request(d)
        and l6_recipient_agency(d, agency)
        and child_support_enforcement_agency(agency)
        and l6a_ii_gross_income_scope(d)
        and l6a_ii_not_reasonably_available_from_any_other_source(d);
    then disclosure_permitted(d);
}

pub relation l6b_agents_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the child support enforcement agency discloses the information it received under (A) about an individual for whom obligations are sought to be established or enforced to an agent under contract with the agency to carry out the purposes of subparagraph (C) (establishing and collecting child support obligations from, and locating, individuals owing them) — section 6103(l)(6)(B)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The information disclosed to any child support enforcement agency under subparagraph (A) with respect to any individual with respect to whom child support obligations are sought to be established or enforced may be disclosed by such agency to any")
rule S6103L6BChildSupportAgencyContractAgentDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, ContractAgentOfChildSupportAgency)
        and l6b_agents_scope(d);
    then disclosure_permitted(d);
}

pub enum MeansTestedProgram {
    TanfStateProgram;
    MedicaidOrPartDSubsidy;
    SupplementalSecurityIncome;
    TerritorialSocialSecurityActBenefits;
    UnemploymentCompensation;
    FoodAndNutritionAssistance;
    StateAdministeredSupplementaryPayments;
    VeteransNeedsBasedPension;
    VeteransParentsDependencyAndIndemnityCompensation;
    VeteransHealthCareServices;
    VeteransUnemployabilityCompensation;
    HudHousingAssistance;
}

pub relation l7_agency_administers_program(d: Disclosure, program: MeansTestedProgram) kind empirical {
    label en unofficial "case fact: the Federal, State, or local agency to which the disclosure is made administers this program listed in subparagraph (D) — section 6103(l)(7)(D)(i)-(ix)";
}

pub relation l7a_ssa_information_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of return information from returns with respect to net earnings from self-employment (section 1402), wages (section 3121(a) or 3401(a)), and payments of retirement income, which have been disclosed to the Social Security Administration under paragraph (1) or (5), only for purposes of, and to the extent necessary in, determining eligibility for, or the correct amount of, benefits under the listed program — section 6103(l)(7)(A), (C)";
}

pub relation l7b_irs_unearned_income_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of current return information from returns with respect to unearned income from the Internal Revenue Service files, only for purposes of, and to the extent necessary in, determining eligibility for, or the correct amount of, benefits under the listed program — section 6103(l)(7)(B), (C)";
}

pub relation l7_hud_request_by_secretary_of_housing_and_urban_development(d: Disclosure) kind empirical {
    label en unofficial "case fact: for a housing assistance program, the request is written and made by the Secretary of Housing and Urban Development, and the information is for use only by officers and employees of HUD with respect to applicants for and participants in the program — section 6103(l)(7)(D)(ix)";
}

pub relation l7_program_is_hud_without_hud_request(d: Disclosure) kind institutional {
    label en unofficial "the program is a housing assistance program and the HUD request condition of clause (ix) is not met";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(ix) any housing assistance program administered by the Department of Housing and Urban Development that involves initial and periodic review of an applicant's or participant's income, except that return information may be disclosed under this")
rule S6103L7DixHudRequestConditionClassification strict {
    for d: Disclosure;
    when l7_agency_administers_program(d, HudHousingAssistance)
        and not_known(l7_hud_request_by_secretary_of_housing_and_urban_development(d));
    then l7_program_is_hud_without_hud_request(d);
}

pub relation l7_va_unemployability_program_with_information_beyond_earnings_and_wages(d: Disclosure) kind empirical {
    label en unofficial "case fact: for compensation described in clause (viii)(IV), the disclosed return information includes more than return information from returns with respect to net earnings from self-employment and wages — section 6103(l)(7), last sentence";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security shall, upon written request, disclose return information from returns with respect to net earnings from self-employment (as defined in section 1402), wages (as defined in section 3121(a) or 3401(a)), and payments")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security and the Secretary shall disclose return information under subparagraphs (A) and (B) only for purposes of, and to the extent necessary in, determining eligibility for, or the correct amount of, benefits under a")
rule S6103L7ASsaInformationDisclosurePermitted defeasible {
    for d: Disclosure;
    for program: MeansTestedProgram;
    when recipient_is(d, AgencyAdministeringMeansTestedProgramBySsa)
        and disclosure_upon_written_request(d)
        and l7a_ssa_information_scope(d)
        and l7_agency_administers_program(d, program);
    then disclosure_permitted(d);
    unless l7_va_unemployability_program_with_information_beyond_earnings_and_wages(d)
        and l7_agency_administers_program(d, program);
    unless l7_program_is_hud_without_hud_request(d)
        and l7_agency_administers_program(d, program);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security shall, upon written request, disclose return information from returns with respect to net earnings from self-employment (as defined in section 1402), wages (as defined in section 3121(a) or 3401(a)), and payments")
rule S6103L7ASsaInformationDutyRule defeasible {
    for d: Disclosure;
    for program: MeansTestedProgram;
    for organ: Organ;
    when recipient_is(d, AgencyAdministeringMeansTestedProgramBySsa)
        and disclosure_upon_written_request(d)
        and l7a_ssa_information_scope(d)
        and l7_agency_administers_program(d, program)
        and recipient_organ(d, organ);
    then duty S6103L7ASsaDisclosureDuty {
        bearer CommissionerOfSocialSecurity;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, CommissionerOfSocialSecurity);
            window [-infinity, infinity];
        }
    };
    unless l7_va_unemployability_program_with_information_beyond_earnings_and_wages(d)
        and l7_agency_administers_program(d, program)
        and recipient_organ(d, organ);
    unless l7_program_is_hud_without_hud_request(d)
        and l7_agency_administers_program(d, program)
        and recipient_organ(d, organ);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request, disclose current return information from returns with respect to unearned income from the Internal Revenue Service files to any Federal, State, or local agency administering a program listed in subparagraph")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security and the Secretary shall disclose return information under subparagraphs (A) and (B) only for purposes of, and to the extent necessary in, determining eligibility for, or the correct amount of, benefits under a")
rule S6103L7BIrsUnearnedIncomeDisclosurePermitted defeasible {
    for d: Disclosure;
    for program: MeansTestedProgram;
    when recipient_is(d, AgencyAdministeringMeansTestedProgramByIrs)
        and disclosure_upon_written_request(d)
        and l7b_irs_unearned_income_scope(d)
        and l7_agency_administers_program(d, program);
    then disclosure_permitted(d);
    unless l7_va_unemployability_program_with_information_beyond_earnings_and_wages(d)
        and l7_agency_administers_program(d, program);
    unless l7_program_is_hud_without_hud_request(d)
        and l7_agency_administers_program(d, program);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request, disclose current return information from returns with respect to unearned income from the Internal Revenue Service files to any Federal, State, or local agency administering a program listed in subparagraph")
rule S6103L7BIrsUnearnedIncomeDutyRule defeasible {
    for d: Disclosure;
    for program: MeansTestedProgram;
    for organ: Organ;
    when recipient_is(d, AgencyAdministeringMeansTestedProgramByIrs)
        and disclosure_upon_written_request(d)
        and l7b_irs_unearned_income_scope(d)
        and l7_agency_administers_program(d, program)
        and recipient_organ(d, organ);
    then duty S6103L7BIrsDisclosureDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
    unless l7_va_unemployability_program_with_information_beyond_earnings_and_wages(d)
        and l7_agency_administers_program(d, program)
        and recipient_organ(d, organ);
    unless l7_program_is_hud_without_hud_request(d)
        and l7_agency_administers_program(d, program)
        and recipient_organ(d, organ);
}

pub relation l8_ssa_to_child_support_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Commissioner of Social Security discloses directly to officers and employees of a Federal, State, tribal, or local child support enforcement agency return information from returns with respect to social security account numbers, net earnings from self-employment, wages, and payments of retirement income which have been disclosed to the Social Security Administration under paragraph (1) or (5), only for purposes of, and to the extent necessary in, establishing and collecting child support obligations (obligations enforced under part D of title IV of the Social Security Act) from, and locating, individuals owing such obligations — section 6103(l)(8)(A)-(B)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Upon written request, the Commissioner of Social Security shall disclose directly to officers and employees of a Federal, State, tribal, or local child support enforcement agency return information")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security shall disclose return information under subparagraph (A) only for purposes of, and to the extent necessary in, establishing and collecting child support")
rule S6103L8SsaToChildSupportAgenciesDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, ChildSupportEnforcementAgencyOfficerBySsa)
        and disclosure_upon_written_request(d)
        and l8_ssa_to_child_support_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Upon written request, the Commissioner of Social Security shall disclose directly to officers and employees of a Federal, State, tribal, or local child support enforcement agency return information")
rule S6103L8SsaChildSupportDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, ChildSupportEnforcementAgencyOfficerBySsa)
        and disclosure_upon_written_request(d)
        and l8_ssa_to_child_support_scope(d)
        and recipient_organ(d, organ);
    then duty S6103L8SsaChildSupportDuty {
        bearer CommissionerOfSocialSecurity;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, CommissionerOfSocialSecurity);
            window [-infinity, infinity];
        }
    };
}

pub relation l8b_agents_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the child support enforcement agency discloses the information it received under (A) about an individual for whom obligations are sought to be established or enforced to an agent under contract with the agency for purposes of, and to the extent necessary in, establishing and collecting child support obligations from, and locating, individuals owing them — section 6103(l)(8)(B), last sentence";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The information disclosed to any child support enforcement agency under subparagraph (A) with respect to any individual with respect to whom child support obligations are sought to be established or enforced may be disclosed by such agency to any agent of such agency which is under contract with such agency for purposes of, and to the extent necessary in, establishing and collecting child support obligations from, and locating, individuals owing such obligations.")
rule S6103L8BChildSupportAgencyAgentOfSsaInformationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, ContractAgentOfChildSupportAgencyL8)
        and l8b_agents_scope(d);
    then disclosure_permitted(d);
}

pub relation l9_alcohol_fuel_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the name and address of a person qualified to produce alcohol for fuel use under section 5181 and the location of premises to be used, to a State agency, body, or commission (or its legal representative) charged with responsibility for administration of State alcohol laws, solely for use in the administration of such laws — section 6103(l)(9)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Notwithstanding any other provision of this section, the Secretary may disclose—")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "to any State agency, body, or commission, or its legal representative, which is charged under the laws of such State with responsibility for administration of State alcohol laws solely for use in the")
rule S6103L9AlcoholFuelProducersToStateAlcoholAgenciesDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, StateAlcoholLawAgency)
        and l9_alcohol_fuel_scope(d);
    then disclosure_permitted(d);
}

pub relation l10_refund_offset_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure to officers and employees of an agency seeking a reduction under section 6402(c), (d), (e), or (f), of the Department of Labor (to facilitate the data exchange for a notice under section 6402(f)(5)(C)), or of the Department of the Treasury in connection with the reduction, is of taxpayer identity information (including that of another person filing a joint return), the fact and amount of a reduction, whether a joint return was filed, and the fact and amount of a payment to the spouse on the basis of a joint return — section 6103(l)(10)(A)(i)-(v)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary may, upon receiving a written request, disclose to officers and employees of any agency seeking a reduction under subsection (c), (d), (e), or (f) of section 6402, to officers and employees of the Department of Labor for purposes of")
rule S6103L10RefundOffsetInformationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, AgencySeekingSection6402Reduction)
        and disclosure_upon_written_request(d)
        and l10_refund_offset_scope(d);
    then disclosure_permitted(d);
}

pub relation l10_refund_offset_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the officer or employee used the information for a purpose other than establishing appropriate agency records, locating any person with respect to whom a reduction is sought for collecting the debt, or defending litigation or an administrative procedure ensuing from a reduction under section 6402(c), (d), (e), or (f)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(i) Any officers and employees of an agency receiving return information under subparagraph (A) shall use such information only for the purposes of, and to the extent necessary in, establishing appropriate agency records, locating any person with")
rule S6103L10RefundOffsetUseLimitRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, AgencySeekingSection6402Reduction)
        and l10_refund_offset_scope(d);
    then prohibition S6103L10RefundOffsetUseLimit {
        bearer recipient;
        action l10_refund_offset_misuse(d);
        window [-infinity, infinity];
    };
}

pub relation l10bii_icon_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information disclosed to officers and employees of the Department of Labor is accessed by agents who maintain and provide technological support to the Department's Interstate Connection Network (ICON) solely for the purpose of providing that maintenance and support — section 6103(l)(10)(B)(ii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(ii) Notwithstanding clause (i), return information disclosed to officers and employees of the Department of Labor may be accessed by agents who maintain and provide technological support to the Department of Labor's Interstate Connection Network")
rule S6103L10BiiIconSupportAgentsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, IconMaintenanceAgentOfDepartmentOfLabor)
        and l10bii_icon_scope(d);
    then disclosure_permitted(d);
}

pub relation l10biii_agents_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the child support enforcement agency discloses the information received under (A) about an individual for whom obligations are sought to be established or enforced to an agent under contract with the agency, for purposes of, and to the extent necessary in, establishing and collecting child support obligations from, and locating, individuals owing them — section 6103(l)(10)(B)(iii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(iii) The information disclosed to any child support enforcement agency under subparagraph (A) with respect to any individual with respect to whom child support obligations are sought to be established or enforced may be disclosed by such agency to")
rule S6103L10BiiiRefundOffsetChildSupportAgencyAgentDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, ContractAgentOfChildSupportAgencyL10)
        and l10biii_agents_scope(d);
    then disclosure_permitted(d);
}

pub relation l11_opm_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Commissioner of Social Security discloses to the Office of Personnel Management return information from returns with respect to net earnings from self-employment, wages, and payments of retirement income which have been disclosed to the Social Security Administration under paragraph (1) or (5), only for purposes of, and to the extent necessary in, the administration of chapters 83 and 84 of title 5, United States Code — section 6103(l)(11)(A)-(B)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security shall, on written request, disclose to the Office of Personnel Management return information from returns with respect to net earnings from self-employment (as")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security shall disclose return information under subparagraph (A) only for purposes of, and to the extent necessary in, the administration of chapters 83 and 84 of title 5,")
rule S6103L11SsaToOfficeOfPersonnelManagementDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, OfficeOfPersonnelManagementOfficer)
        and disclosure_upon_written_request(d)
        and l11_opm_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security shall, on written request, disclose to the Office of Personnel Management return information from returns with respect to net earnings from self-employment (as")
rule S6103L11SsaToOpmDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, OfficeOfPersonnelManagementOfficer)
        and disclosure_upon_written_request(d)
        and l11_opm_scope(d)
        and recipient_organ(d, organ);
    then duty S6103L11SsaToOpmDuty {
        bearer CommissionerOfSocialSecurity;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, CommissionerOfSocialSecurity);
            window [-infinity, infinity];
        }
    };
}

pub relation written_statements_furnished_by_employer_count(employer: Person, calendarYear: Integer, count: Integer) kind empirical {
    label en unofficial "case fact: the employer furnished this number of written statements under section 6051 for wages paid in the calendar year";
}

pub relation qualified_employer_for_year(employer: Person, calendarYear: Integer) kind institutional {
    label en unofficial "the employer is a \"qualified employer\" for the calendar year within the meaning of section 6103(l)(12)(E)(iii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "The term \"qualified employer\" means, for a calendar year, an employer which has furnished written statements under section 6051 with respect to at least 20 individuals for wages paid in the year.")
rule S6103L12EiiiQualifiedEmployerDefinition strict {
    for employer: Person;
    for calendarYear: Integer;
    for count: Integer;
    when written_statements_furnished_by_employer_count(employer, calendarYear, count)
        and count >= 20;
    then qualified_employer_for_year(employer, calendarYear);
}

pub relation medicare_beneficiary_entitled_or_enrolled(individual: Individual) kind empirical {
    label en unofficial "case fact: the individual is entitled to benefits under part A, or enrolled under part B, of title XVIII of the Social Security Act — section 6103(l)(12)(E)(i)";
}

pub relation medicare_beneficiary_enrolled_in_part_a_under_section_1818(individual: Individual) kind empirical {
    label en unofficial "case fact: the individual is enrolled in part A under section 1818 (the premium-part-A buy-in)";
}

pub relation medicare_beneficiary(individual: Individual) kind institutional {
    label en unofficial "the individual is a \"medicare beneficiary\" within the meaning of section 6103(l)(12)(E)(i)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "The term \"medicare beneficiary\" means an individual entitled to benefits under part A, or enrolled under part B, of title XVIII of the Social Security Act, but does not include such an individual enrolled in part A under section 1818.")
rule S6103L12EiMedicareBeneficiaryDefinition strict {
    for individual: Individual;
    when medicare_beneficiary_entitled_or_enrolled(individual)
        and not_known(medicare_beneficiary_enrolled_in_part_a_under_section_1818(individual));
    then medicare_beneficiary(individual);
}

pub relation l12a_filing_status_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of available filing status and taxpayer identity information from the individual master files as to whether a medicare beneficiary identified by the Commissioner was a married individual (section 7703) for a specified year after 1986 and, if so, the name and TIN of the spouse, only for purposes of, and to the extent necessary in, determining the extent to which a medicare beneficiary is covered under a group health plan — section 6103(l)(12)(A), (D)(i)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Commissioner of Social Security, disclose to the Commissioner available filing status and taxpayer identity information from the individual master files of the Internal Revenue Service relating to")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Information may be disclosed under this paragraph only for purposes of, and to the extent necessary in, determining the extent to which any medicare beneficiary is covered under any group health plan.")
rule S6103L12AFilingStatusToSocialSecurityForMedicareDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, SocialSecurityAdministrationOfficerL12)
        and disclosure_upon_written_request(d)
        and l12a_filing_status_scope(d);
    then disclosure_permitted(d);
}

pub relation l12b_ssa_to_cms_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Commissioner of Social Security discloses to the CMS Administrator the name and TIN of each medicare beneficiary identified as having received wages (above the amount HHS specifies) from a qualified employer in a previous year, the beneficiary and spouse names and TINs for a beneficiary identified as married whose spouse received such wages, and for each qualified employer its name, address, TIN, and the number of section 6051 statements furnished — section 6103(l)(12)(B)(i)-(iii); only for determining coverage under a group health plan — (D)(i)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security shall, upon written request from the Administrator of the Centers for Medicare & Medicaid Services, disclose to the Administrator the following information:")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Information may be disclosed under this paragraph only for purposes of, and to the extent necessary in, determining the extent to which any medicare beneficiary is covered under any group health plan.")
rule S6103L12BSsaWageInformationToCmsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, CentersForMedicareAndMedicaidServicesAdministrator)
        and disclosure_upon_written_request(d)
        and l12b_ssa_to_cms_scope(d);
    then disclosure_permitted(d);
}

pub relation l12ci_employer_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the CMS Administrator discloses to the qualified employer the name and TIN of each individual identified as having received wages from it, for determining the period during which the employee or spouse may be (or have been) covered under its group health plan and what benefits are or were covered — section 6103(l)(12)(C)(i)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(i) to the qualified employer referred to in such subparagraph the name and TIN of each individual identified under such subparagraph as having received wages from the employer (hereinafter in this subparagraph referred to as the \"employee\") for")
rule S6103L12CiCmsDisclosureToQualifiedEmployerDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, QualifiedEmployerOfMedicareBeneficiary)
        and l12ci_employer_scope(d);
    then disclosure_permitted(d);
}

pub relation l12cii_plan_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the CMS Administrator discloses to a group health plan which provides or provided coverage to the employee or spouse the names of the employee and spouse and the name and address of the employer, and, for presenting a claim to the plan, the TIN of the employee or spouse if title XVIII benefits were paid during a period in which the plan was a primary plan (section 1862(b)(2)(A)) — section 6103(l)(12)(C)(ii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(ii) to any group health plan which provides or provided coverage to such an employee or spouse, the name of such employee and the employee's spouse (if the spouse is a medicare beneficiary) and the name and address of the employer, and, for the")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(I) the TIN of such employee if benefits were paid under title XVIII of the Social Security Act with respect to the employee during a period in which the plan was a primary plan (as defined in section 1862(b)(2)(A) of the Social Security Act), and")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(II) the TIN of such spouse if benefits were paid under such title with respect to the spouse during such period, and")
rule S6103L12CiiCmsDisclosureToGroupHealthPlanDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, GroupHealthPlanCoveringMedicareBeneficiary)
        and l12cii_plan_scope(d);
    then disclosure_permitted(d);
}

pub relation l12ciii_agent_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the CMS Administrator discloses the information referred to in subparagraph (B) to an agent of the Administrator for purposes of carrying out clauses (i) and (ii) on behalf of the Administrator — section 6103(l)(12)(C)(iii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(iii) to any agent of such Administrator the information referred to in subparagraph (B) for purposes of carrying out clauses (i) and (ii) on behalf of such Administrator.")
rule S6103L12CiiiCmsDisclosureToAgentDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, AgentOfCentersForMedicareAndMedicaidServices)
        and l12ciii_agent_scope(d);
    then disclosure_permitted(d);
}

pub relation l12_request_made_on(d: Disclosure, madeOn: Date) kind empirical {
    label en unofficial "case fact: the request under subparagraph (A) or (B) was made on this date";
}

pub relation l12_request_complied_with_on(d: Disclosure, compliedOn: Date) kind empirical {
    label en unofficial "case fact: the request was complied with on this date";
}

pub relation l12_request_complied_within_120_days(d: Disclosure) kind institutional {
    label en unofficial "the request was complied with no later than 120 days after the date it was made";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "Any request made under subparagraph (A) or (B) shall be complied with as soon as possible but in no event later than 120 days after the date the request was made.")
rule S6103L12DiiTimelyClassification strict {
    for d: Disclosure;
    for madeOn: Date;
    for compliedOn: Date;
    when l12_request_made_on(d, madeOn)
        and l12_request_complied_with_on(d, compliedOn)
        and compliedOn <= add_calendar_period(madeOn, 120 calendar_day);
    then l12_request_complied_within_120_days(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Commissioner of Social Security, disclose to the Commissioner available filing status and taxpayer identity information from the individual master files of the Internal Revenue Service relating to")
@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "Any request made under subparagraph (A) or (B) shall be complied with as soon as possible but in no event later than 120 days after the date the request was made.")
rule S6103L12ASecretaryDutyRule strict {
    for d: Disclosure;
    for madeOn: Date;
    when recipient_is(d, SocialSecurityAdministrationOfficerL12)
        and l12_request_made_on(d, madeOn)
        and l12a_filing_status_scope(d);
    then duty S6103L12ASecretaryDuty {
        bearer Secretary;
        beneficiary CommissionerOfSocialSecurity;
        goal achievement {
            condition l12_request_complied_within_120_days(d);
            window [madeOn, add_calendar_period(madeOn, 120 calendar_day)];
        }
    };
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Commissioner of Social Security shall, upon written request from the Administrator of the Centers for Medicare & Medicaid Services, disclose to the Administrator the following information:")
@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "Any request made under subparagraph (A) or (B) shall be complied with as soon as possible but in no event later than 120 days after the date the request was made.")
rule S6103L12BCommissionerDutyRule strict {
    for d: Disclosure;
    for madeOn: Date;
    when recipient_is(d, CentersForMedicareAndMedicaidServicesAdministrator)
        and l12_request_made_on(d, madeOn)
        and l12b_ssa_to_cms_scope(d);
    then duty S6103L12BCommissionerDuty {
        bearer CommissionerOfSocialSecurity;
        beneficiary CentersForMedicareAndMedicaidServices;
        goal achievement {
            condition l12_request_complied_within_120_days(d);
            window [madeOn, add_calendar_period(madeOn, 120 calendar_day)];
        }
    };
}

pub const CentersForMedicareAndMedicaidServices: Organ = entity_ref("urn:us:irc:confidentiality:clir#CentersForMedicareAndMedicaidServices") {
    label en unofficial "the Centers for Medicare & Medicaid Services";
}

pub enum StudentAidDisclosureSubparagraph {
    IncomeContingentRepayment;
    DisabilityDischarge;
    FederalStudentFinancialAid;
}

pub relation department_of_education_officer_employee_or_contractor(person: Person) kind empirical {
    label en unofficial "case fact: the person is an officer, employee, or contractor of the Department of Education — section 6103(l)(13)(E)(i)";
}

pub relation specifically_authorized_and_designated_by_secretary_of_education_for(person: Person, sub: StudentAidDisclosureSubparagraph) kind empirical {
    label en unofficial "case fact: the Secretary of Education specifically authorized and designated the person for the purposes of this subparagraph (applied separately to each) — section 6103(l)(13)(E)(ii)";
}

pub relation authorized_person_for_student_aid_disclosure(person: Person, sub: StudentAidDisclosureSubparagraph) kind institutional {
    label en unofficial "the person is an \"authorized person\" for the subparagraph within the meaning of section 6103(l)(13)(E)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"authorized person\" means, with respect to information disclosed under subparagraph (A), (B), or (C), any person who—")
@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "(i) is an officer, employee, or contractor, of the Department of Education, and")
@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "(ii) is specifically authorized and designated by the Secretary of Education for purposes of such subparagraph (applied separately with respect to each such subparagraph).")
rule S6103L13EAuthorizedPersonDefinition strict {
    for person: Person;
    for sub: StudentAidDisclosureSubparagraph;
    when department_of_education_officer_employee_or_contractor(person)
        and specifically_authorized_and_designated_by_secretary_of_education_for(person, sub);
    then authorized_person_for_student_aid_disclosure(person, sub);
}

pub relation l13_written_request_from_secretary_of_education(d: Disclosure, sub: StudentAidDisclosureSubparagraph) kind empirical {
    label en unofficial "case fact: the written request of the Secretary of Education for the disclosure under this subparagraph";
}

pub relation l13_individual_certified_as_having_approved_disclosure(d: Disclosure, sub: StudentAidDisclosureSubparagraph) kind empirical {
    label en unofficial "case fact: the individual is certified by the Secretary of Education as having provided the approval under section 494(a) of the Higher Education Act of 1965 (paragraph (1), (2), or (3) for this subparagraph) for the disclosure";
}

pub relation l13_information_and_purpose_scope(d: Disclosure, sub: StudentAidDisclosureSubparagraph) kind empirical {
    label en unofficial "case fact: the disclosure is limited to the return information the subparagraph lists (identity, filing status, adjusted gross income, exemptions, dependents, no-return fact; for (C) the further income, tax, credit, retirement, tax-exempt-interest and schedule items; for (B) the (A) items (i), (ii), (vi) and the (C)(ii) items) for the taxable year the Secretary of Education specified as relevant (for (C), the year used for section 480(a) of the Higher Education Act), and is only for the purpose of, and to the extent necessary in, the subparagraph's purpose (income-contingent or income-based repayment; monitoring and reinstating loans discharged for total and permanent disability; eligibility for and amount of Federal student financial aid)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Secretary of Education, disclose to any authorized person, only for the purpose of (and to the extent necessary in) determining eligibility for, or repayment obligations under, income-contingent or")
rule S6103L13AHigherEducationActDisclosurePermitted strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and authorized_person_for_student_aid_disclosure(person, IncomeContingentRepayment)
        and l13_written_request_from_secretary_of_education(d, IncomeContingentRepayment)
        and l13_individual_certified_as_having_approved_disclosure(d, IncomeContingentRepayment)
        and l13_information_and_purpose_scope(d, IncomeContingentRepayment);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Secretary of Education, disclose to any authorized person, only for the purpose of (and to the extent necessary in) determining eligibility for, or repayment obligations under, income-contingent or")
rule S6103L13AHigherEducationActDutyRule strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and authorized_person_for_student_aid_disclosure(person, IncomeContingentRepayment)
        and l13_written_request_from_secretary_of_education(d, IncomeContingentRepayment)
        and l13_individual_certified_as_having_approved_disclosure(d, IncomeContingentRepayment)
        and l13_information_and_purpose_scope(d, IncomeContingentRepayment);
    then duty S6103L13ADisclosureDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Secretary of Education, disclose to any authorized person, only for the purpose of (and to the extent necessary in) monitoring and reinstating loans under title IV of the Higher Education Act of")
rule S6103L13BHigherEducationActDisclosurePermitted strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and authorized_person_for_student_aid_disclosure(person, DisabilityDischarge)
        and l13_written_request_from_secretary_of_education(d, DisabilityDischarge)
        and l13_individual_certified_as_having_approved_disclosure(d, DisabilityDischarge)
        and l13_information_and_purpose_scope(d, DisabilityDischarge);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Secretary of Education, disclose to any authorized person, only for the purpose of (and to the extent necessary in) monitoring and reinstating loans under title IV of the Higher Education Act of")
rule S6103L13BHigherEducationActDutyRule strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and authorized_person_for_student_aid_disclosure(person, DisabilityDischarge)
        and l13_written_request_from_secretary_of_education(d, DisabilityDischarge)
        and l13_individual_certified_as_having_approved_disclosure(d, DisabilityDischarge)
        and l13_information_and_purpose_scope(d, DisabilityDischarge);
    then duty S6103L13BDisclosureDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Secretary of Education, disclose to any authorized person, only for the purpose of (and to the extent necessary in) determining eligibility for, and amount of, Federal student financial aid under a")
rule S6103L13CHigherEducationActDisclosurePermitted strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and authorized_person_for_student_aid_disclosure(person, FederalStudentFinancialAid)
        and l13_written_request_from_secretary_of_education(d, FederalStudentFinancialAid)
        and l13_individual_certified_as_having_approved_disclosure(d, FederalStudentFinancialAid)
        and l13_information_and_purpose_scope(d, FederalStudentFinancialAid);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Secretary of Education, disclose to any authorized person, only for the purpose of (and to the extent necessary in) determining eligibility for, and amount of, Federal student financial aid under a")
rule S6103L13CHigherEducationActDutyRule strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and authorized_person_for_student_aid_disclosure(person, FederalStudentFinancialAid)
        and l13_written_request_from_secretary_of_education(d, FederalStudentFinancialAid)
        and l13_individual_certified_as_having_approved_disclosure(d, FederalStudentFinancialAid)
        and l13_information_and_purpose_scope(d, FederalStudentFinancialAid);
    then duty S6103L13CDisclosureDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation l13d_use_for_criminal_investigation_or_prosecution(d: Disclosure) kind empirical {
    label en unofficial "case fact: the authorized person used the return information for the conduct of a criminal investigation or prosecution — section 6103(l)(13)(D)(ii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "The purposes described in clause (i) shall not include the conduct of criminal investigations or prosecutions.")
rule S6103L13DiiCriminalUseBanRule strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and (authorized_person_for_student_aid_disclosure(person, IncomeContingentRepayment) or authorized_person_for_student_aid_disclosure(person, DisabilityDischarge) or authorized_person_for_student_aid_disclosure(person, FederalStudentFinancialAid));
    then prohibition S6103L13DiiCriminalUseBan {
        bearer person;
        action l13d_use_for_criminal_investigation_or_prosecution(d);
        window [-infinity, infinity];
    };
}

pub relation l13di_additional_uses_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information disclosed under (A), (B), or (C) is used by an authorized person, with respect to income-contingent or income-based repayment plans, awards of Federal student financial aid, and discharges of loans based on total and permanent disability, for reducing the net cost of improper payments, Inspector General oversight activities under the Inspector General Act of 1978, and conducting analyses and forecasts for estimating costs — section 6103(l)(13)(D)(i)(I)-(III)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "In addition to the purposes for which information is disclosed under subparagraphs (A), (B), and (C), return information so disclosed may be used by an authorized person, with respect to income-contingent or income-based repayment plans, awards of")
rule S6103L13DiAdditionalUsesOfDisclosedInformationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, DepartmentOfEducationAuthorizedPerson)
        and l13di_additional_uses_scope(d);
    then disclosure_permitted(d);
}

pub relation l13diii_redisclosure_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: an authorized person redisclosed return information received under subparagraph (C) solely for use in the application, award, and administration of financial aid to a participating institution of higher education, a State higher education agency, or a scholarship organization designated by the Secretary of Education (or a contractor designated by such an institution or agency)";
}

pub relation l13diii_taxpayer_written_consent_to_secretary_of_education(d: Disclosure) kind empirical {
    label en unofficial "case fact: the taxpayer with respect to whom the return information relates provided written consent for the redisclosure to the Secretary of Education — section 6103(l)(13)(D)(iii), last paragraph";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Authorized persons may redisclose return information received under subparagraph (C), solely for the use in the application, award, and administration of financial aid awarded by the Federal government or awarded by a person described in subclause")
rule S6103L13DiiiRedisclosureToInstitutionsWithConsentDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, HigherEducationInstitutionStateAgencyOrScholarshipOrganization)
        and l13diii_redisclosure_scope(d)
        and l13diii_taxpayer_written_consent_to_secretary_of_education(d);
    then disclosure_permitted(d);
}

pub relation l13div_further_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information redisclosed under clause (iii) is further disclosed by the persons described there to the Office of Inspector General of the Department of Education and independent auditors conducting audits of the administration of the programs, and by institutions and State agencies to their contractors, only to the extent necessary in carrying out the purposes of clause (iii) — section 6103(l)(13)(D)(iv)(I)-(II)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Any return information which is redisclosed under clause (iii)—")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(I) may be further disclosed by persons described in subclauses (I), (II), or (III) of clause (iii) or persons designated in the last sentence of clause (iii) to the Office of Inspector General of")
@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "(II) may be further disclosed by persons described in subclauses (I), (II), or (III) of clause (iii) to contractors of such entities,")
rule S6103L13DivFurtherDisclosureToInspectorGeneralAndAuditorsAndContractorsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, InspectorGeneralOrIndependentAuditorOfAidRecipient)
        and l13div_further_scope(d);
    then disclosure_permitted(d);
}

pub relation l13dv_family_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information disclosed under (A) and (C), or redisclosed under clause (iii), is further disclosed to an individual certified by the Secretary of Education as having provided approval under paragraph (1) or (2) of section 494(a) of the Higher Education Act of 1965, for disclosure related to the income-contingent or income-based repayment plan or to the eligibility for and amount of Federal student financial aid — section 6103(l)(13)(D)(v)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "In addition to the purposes for which information is disclosed and used under subparagraphs (A) and (C), or redisclosed under clause (iii), any return information so disclosed or redisclosed may be further disclosed to any individual certified by")
rule S6103L13DvRedisclosureToFamilyMembersApprovedDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, FamilyMemberApprovedByIndividual)
        and l13dv_family_scope(d);
    then disclosure_permitted(d);
}

pub relation l13dvi_fafsa_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information received under subparagraph (C) is redisclosed in accordance with subsection (c) of section 494 of the Higher Education Act of 1965 (as in effect on the date of enactment of the COVID-related Tax Relief Act of 2020) to carry out the purposes specified in that subsection — section 6103(l)(13)(D)(vi)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Return information received under subparagraph (C) may be redisclosed in accordance with subsection (c) of section 494 of the Higher Education Act of 1965 (as in effect on the date of enactment of the COVID-related Tax Relief Act of 2020) to carry")
