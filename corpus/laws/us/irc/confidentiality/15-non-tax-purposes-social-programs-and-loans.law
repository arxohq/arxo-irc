pub relation l17_nara_officer_disclosed_to_person_other_than_secretary_or_colleague(d: Disclosure) kind empirical {
    label en unofficial "case fact: the NARA officer or employee disclosed the return or return information to a person other than the Secretary or another NARA officer or employee whose official duties require the disclosure for the appraisal, without authorization by subsection (f), (i)(8), or (p) — section 6103(l)(17), second sentence";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "No such officer or employee shall, except to the extent authorized by subsection (f), (i)(8), or (p), disclose any return or return information disclosed under the preceding sentence to any person other than to the Secretary, or to another officer or employee of the National Archives and Records Administration whose official duties require such disclosure for purposes of such appraisal.")
rule S6103L17NaraRedisclosureBanRule strict {
    for d: Disclosure;
    for officer: Person;
    when disclosure_to(d, officer)
        and recipient_is(d, NationalArchivesOfficer)
