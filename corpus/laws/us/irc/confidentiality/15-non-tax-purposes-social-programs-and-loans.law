pub relation l19_information_available_for_taxable_year_ending(taxpayer: Person, yearEnd: Date) kind empirical {
    label en unofficial "case fact: return information for the taxable year ending on this date is available in the Internal Revenue Service's taxpayer data information systems";
}

pub relation l19_later_year_with_information_exists(taxpayer: Person, yearEnd: Date) kind institutional {
    label en unofficial "a taxable year ending strictly later than this one has information available in the Internal Revenue Service's taxpayer data information systems";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "For the purposes of this subsection, the term \"applicable year\" means the most recent taxable year for which information is available in the Internal Revenue Service's taxpayer data information")
rule S6103L19BLaterYearWithInformationExists strict {
    for taxpayer: Person;
    for yearEnd: Date;
    for laterEnd: Date;
    when l19_information_available_for_taxable_year_ending(taxpayer, yearEnd)
        and l19_information_available_for_taxable_year_ending(taxpayer, laterEnd)
        and laterEnd > yearEnd;
    then l19_later_year_with_information_exists(taxpayer, yearEnd);
}

pub relation applicable_year_for_discount_card_ending(taxpayer: Person, yearEnd: Date) kind institutional {
    label en unofficial "the \"applicable year\" of section 6103(l)(19)(B) is the taxable year ending on this date: the most recent taxable year for which information is available in the Internal Revenue Service's taxpayer data information systems";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "For the purposes of this subsection, the term \"applicable year\" means the most recent taxable year for which information is available in the Internal Revenue Service's taxpayer data information")
rule S6103L19BApplicableYearMostRecentAvailable strict {
    for taxpayer: Person;
    for yearEnd: Date;
    when l19_information_available_for_taxable_year_ending(taxpayer, yearEnd)
        and not_known(l19_later_year_with_information_exists(taxpayer, yearEnd));
    then applicable_year_for_discount_card_ending(taxpayer, yearEnd);
}

