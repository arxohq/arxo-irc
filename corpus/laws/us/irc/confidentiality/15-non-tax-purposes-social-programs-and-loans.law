@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary, upon written request from the Secretary of Health and Human Services pursuant to carrying out section 1860D–31 of the Social Security Act, shall disclose to officers, employees, and contractors of the Department of Health and Human")
