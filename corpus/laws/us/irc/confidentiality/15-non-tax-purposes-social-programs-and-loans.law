pub relation l16_dc_retirement_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: available return information (wage income amounts, the name, address, and identifying number of payors of wage income, taxpayer identity, and occupational status) with respect to an individual whose eligibility for, or the correct amount of, benefits under the District of Columbia Retirement Protection Act of 1997 is sought to be determined is disclosed to a duly authorized officer or employee of the Department of the Treasury, or a Trustee or its designated officer, employee, or actuary, whose official duties require it, solely for the purpose of, and to the extent necessary in, that determination — section 6103(l)(16)(A)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Upon written request available return information (including such information disclosed to the Social Security Administration under paragraph (1) or (5) of this subsection), relating to the amount of wage income (as defined in section 3121(a) or")
rule S6103L16DistrictOfColumbiaRetirementBenefitsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, TreasuryOrTrusteeOfficerOnDcRetirementBenefits)
        and disclosure_upon_written_request(d)
        and l16_dc_retirement_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Upon written request available return information (including such information disclosed to the Social Security Administration under paragraph (1) or (5) of this subsection), relating to the amount of wage income (as defined in section 3121(a) or")
rule S6103L16CommissionerDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, TreasuryOrTrusteeOfficerOnDcRetirementBenefits)
        and disclosure_upon_written_request(d)
        and l16_dc_retirement_scope(d)
        and recipient_organ(d, organ);
    then duty S6103L16CommissionerDuty {
        bearer CommissionerOfSocialSecurity;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, CommissionerOfSocialSecurity);
            window [-infinity, infinity];
        }
    };
}

pub relation l16_information_not_available_from_social_security_administration(d: Disclosure) kind empirical {
