pub relation l15_disclosure_for_administration_of_any_tax_law(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is made for purposes of the administration of a tax law — section 6103(l)(15), last clause";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary may, upon written request, disclose to officers and employees of—")
rule S6103L15Section6050IReturnsToAgenciesDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, FederalStateLocalOrForeignAgencyOfficer)
        and disclosure_upon_written_request(d)
