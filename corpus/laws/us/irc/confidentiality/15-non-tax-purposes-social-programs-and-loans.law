}

pub relation l21_aca_eligibility_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure to officers, employees, and contractors of the Department of Health and Human Services is of return information of a taxpayer whose income is relevant in determining a premium tax credit under section 36B, a cost-sharing reduction under section 1402 of the Patient Protection and Affordable Care Act, or eligibility for a State medicaid program, a State children's health insurance program, or a basic health program under section 1331 of that Act, limited to taxpayer identity information, filing status, the number of individuals for whom a section 151 deduction is allowed, modified adjusted gross income, other information the Secretary prescribes by regulation, and the taxable year (or the fact that the information is not available) — section 6103(l)(21)(A)(i)-(vi)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary, upon written request from the Secretary of Health and Human Services, shall disclose to officers, employees, and contractors of the Department of Health and Human Services return information of any taxpayer whose income is relevant in")
rule S6103L21ExchangeAndMedicaidEligibilityInformationToHhsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, HhsOfficerOnExchangeEligibility)
        and disclosure_upon_written_request(d)
        and l21_aca_eligibility_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary, upon written request from the Secretary of Health and Human Services, shall disclose to officers, employees, and contractors of the Department of Health and Human Services return information of any taxpayer whose income is relevant in")
rule S6103L21ExchangeEligibilityDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, HhsOfficerOnExchangeEligibility)
        and disclosure_upon_written_request(d)
        and l21_aca_eligibility_scope(d)
        and recipient_organ(d, organ);
    then duty S6103L21ExchangeEligibilityDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation l21b_inconsistency_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary of Health and Human Services discloses to an Exchange established under the Patient Protection and Affordable Care Act or its contractors, or to a State agency administering a State program described in subparagraph (A) or its contractors, any inconsistency between the information the Exchange or State agency provided to the Secretary and the information provided under subparagraph (A) — section 6103(l)(21)(B)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary of Health and Human Services may disclose to an Exchange established under the Patient Protection and Affordable Care Act or its contractors, or to a State agency administering a State program described in subparagraph (A) or its")
rule S6103L21BHhsInconsistencyDisclosureToExchangesDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, ExchangeOrStateAgencyOrContractor)
        and l21b_inconsistency_scope(d);
    then disclosure_permitted(d);
}

pub relation l21_aca_eligibility_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return information was used for a purpose other than establishing eligibility for participation in the Exchange, verifying the amount of a credit or reduction, or determining eligibility for the State programs";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Return information disclosed under subparagraph (A) or (B) may be used by officers, employees, and contractors of the Department of Health and Human Services, an Exchange, or a State agency only for the purposes of, and to the extent necessary in—")
rule S6103L21ExchangeEligibilityUseUseLimitRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, HhsOfficerOnExchangeEligibility)
        and l21_aca_eligibility_scope(d);
    then prohibition S6103L21ExchangeEligibilityUseUseLimit {
        bearer recipient;
        action l21_aca_eligibility_misuse(d);
        window [-infinity, infinity];
    };
}

pub entity TaxDebt {
    label en unofficial "an outstanding debt under Title 26 (section 6103(l)(22)(C))";
}

pub relation outstanding_debt_notice_of_lien_filed_under_6323(debt: TaxDebt) kind empirical {
    label en unofficial "case fact: the outstanding debt under this title is one for which a notice of lien has been filed pursuant to section 6323";
}

pub relation debt_paid_timely_under_installment_or_compromise_agreement(debt: TaxDebt) kind empirical {
    label en unofficial "case fact: the debt is being paid in a timely manner pursuant to an agreement under section 6159 or 7122";
}

pub relation debt_with_collection_due_process_hearing_and_no_payment_required(debt: TaxDebt) kind empirical {
    label en unofficial "case fact: a collection due process hearing under section 6330 with respect to the debt is requested, pending, or completed and no payment is required";
}

pub relation delinquent_tax_debt(debt: TaxDebt) kind institutional {
    label en unofficial "the debt is a \"delinquent tax debt\" within the meaning of section 6103(l)(22)(C)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"delinquent tax debt\" means an outstanding debt under this title for which a notice of lien has been filed pursuant to section 6323, but the term does not include a debt that is being paid in a timely manner pursuant to an agreement under section 6159 or")
rule S6103L22CDelinquentTaxDebtDefinition defeasible {
    for debt: TaxDebt;
    when outstanding_debt_notice_of_lien_filed_under_6323(debt);
    then delinquent_tax_debt(debt);
    unless debt_paid_timely_under_installment_or_compromise_agreement(debt)
        and outstanding_debt_notice_of_lien_filed_under_6323(debt);
    unless debt_with_collection_due_process_hearing_and_no_payment_required(debt)
        and outstanding_debt_notice_of_lien_filed_under_6323(debt);
}

pub relation l22_medicare_integrity_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure to officers and employees of the Department of Health and Human Services is of return information with respect to a taxpayer who applied to enroll or reenroll as a provider of services or supplier under the Medicare program, limited to the taxpayer identity information, the amount of the delinquent tax debt owed, and the taxable year to which the debt pertains — section 6103(l)(22)(A)(i)-(iii)";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Secretary of Health and Human Services, disclose to officers and employees of the Department of Health and Human Services return information with respect to a taxpayer who has applied to enroll, or")
rule S6103L22DelinquentTaxDebtToHhsForMedicareEnrollmentDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, HhsOfficerOnMedicareProviderEnrollment)
        and disclosure_upon_written_request(d)
        and l22_medicare_integrity_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon written request from the Secretary of Health and Human Services, disclose to officers and employees of the Department of Health and Human Services return information with respect to a taxpayer who has applied to enroll, or")
rule S6103L22MedicareIntegrityDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, HhsOfficerOnMedicareProviderEnrollment)
        and disclosure_upon_written_request(d)
        and l22_medicare_integrity_scope(d)
        and recipient_organ(d, organ);
    then duty S6103L22MedicareIntegrityDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation l22_medicare_integrity_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return information was used for a purpose other than establishing the taxpayer's eligibility for enrollment or reenrollment in Medicare, an administrative or judicial proceeding relating to or arising from a denial of enrollment, or determining the level of enhanced oversight under section 1866(j)(3) of the Social Security Act";
}

@source(IRC_S6103_L, relation = formalizes, coverage = partial, quote = "Return information disclosed under subparagraph (A) may be used by officers and employees of the Department of Health and Human Services for the purposes of, and to the extent necessary in, establishing the taxpayer's eligibility for enrollment or")
rule S6103L22MedicareIntegrityUseUseLimitRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, HhsOfficerOnMedicareProviderEnrollment)
        and l22_medicare_integrity_scope(d);
    then prohibition S6103L22MedicareIntegrityUseUseLimit {
        bearer recipient;
        action l22_medicare_integrity_misuse(d);
        window [-infinity, infinity];
    };
}
