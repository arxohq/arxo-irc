// 26 U.S.C. §6103(f)(2)-(5), (g), (h) — the Joint Committee Chief of Staff and other
// committees of Congress, the President and certain other persons, and Federal officers
// and employees for tax administration (Treasury, Justice, judicial and administrative
// tax proceedings, the Social Security Administration and Railroad Retirement Board,
// the former Oversight Board). STAGE 2. Permissions are defeaters of the section
// 6103(a) prohibition; "shall furnish/disclose upon written request" is a duty of the
// Secretary with the requester as beneficiary; "shall not disclose" and the pay-level
// bar are prohibitions; the 3-day notice and the quarterly report are duties with
// computed windows. The named organs are declared in module 09.

use self::{
    DepartmentOfJustice,
    Disclosure,
    IRC_S6103_F,
    IRC_S6103_G,
    IRC_S6103_H,
    JointCommitteeOnTaxation,
    Organ,
    Person,
    President,
    Recipient,
    ReturnInformation,
    Secretary,
    TreasuryInspectorGeneralForTaxAdministration,
    about_taxpayer,
    chairman_of_committee,
    committee_sitting_in_closed_executive_session,
    disclosure_by,
    disclosure_of,
    disclosure_permitted,
    disclosure_to,
    disclosure_upon_written_request,
    identifies_particular_taxpayer,
    named_f1_committee,
    recipient_is,
    recipient_organ,
    taxpayer_consents_in_writing_to_committee_disclosure,
};

pub relation chief_of_staff_of_joint_committee(chief: Person) kind empirical {
    label en unofficial "case fact: the person is the Chief of Staff of the Joint Committee on Taxation — section 6103(f)(2)";
}

pub relation chief_of_staff_written_request(d: Disclosure, chief: Person) kind empirical {
    label en unofficial "case fact: the Chief of Staff of the Joint Committee on Taxation made a written request specifying the return or return information sought — section 6103(f)(2)";
}

pub relation submitted_by_chief_of_staff_to_f1_committee(d: Disclosure, committee: Organ) kind empirical {
    label en unofficial "case fact: the Chief of Staff submitted the return or return information to this committee described in paragraph (1)";
}

@source(IRC_S6103_F, relation = formalizes, coverage = exact, quote = "Upon written request by the Chief of Staff of the Joint Committee on Taxation, the Secretary shall furnish him with any return or return information specified in such")
rule S6103F2FurnishToChiefOfStaffDutyRule strict {
    for d: Disclosure;
    for chief: Person;
    when chief_of_staff_of_joint_committee(chief)
        and chief_of_staff_written_request(d, chief)
        and disclosure_to(d, chief);
    then duty S6103F2FurnishToChiefOfStaffDuty {
        bearer Secretary;
        beneficiary chief;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6103_F, relation = formalizes, coverage = exact, quote = "Upon written request by the Chief of Staff of the Joint Committee on Taxation, the Secretary shall furnish him with any return or return information specified in such")
rule S6103F2ChiefOfStaffDisclosurePermitted strict {
    for d: Disclosure;
    for chief: Person;
    when chief_of_staff_of_joint_committee(chief)
        and chief_of_staff_written_request(d, chief)
        and disclosure_to(d, chief);
    then disclosure_permitted(d);
}

@source(IRC_S6103_F, relation = formalizes, coverage = partial, quote = "Such Chief of Staff may submit such return or return information to any committee described in paragraph (1), except that any return or return information which can be associated with, or otherwise identify, directly or indirectly, a particular taxpayer shall be furnished to such committee only when sitting in closed executive")
rule S6103F2SubmissionToCommitteeClosedSessionPermitted strict {
    for d: Disclosure;
    for committee: Organ;
    for info: ReturnInformation;
    for taxpayer: Person;
    when submitted_by_chief_of_staff_to_f1_committee(d, committee)
        and named_f1_committee(committee)
        and disclosure_of(d, info)
        and identifies_particular_taxpayer(info)
        and about_taxpayer(info, taxpayer)
        and (committee_sitting_in_closed_executive_session(d) or taxpayer_consents_in_writing_to_committee_disclosure(d, taxpayer));
    then disclosure_permitted(d);
}

@source(IRC_S6103_F, relation = formalizes, coverage = partial, quote = "Such Chief of Staff may submit such return or return information to any committee described in paragraph (1)")
rule S6103F2SubmissionNonIdentifyingPermitted strict {
    for d: Disclosure;
    for committee: Organ;
    for info: ReturnInformation;
    when submitted_by_chief_of_staff_to_f1_committee(d, committee)
        and named_f1_committee(committee)
        and disclosure_of(d, info)
        and not_known(identifies_particular_taxpayer(info));
    then disclosure_permitted(d);
}

pub relation other_committee_specially_authorized_by_resolution(committee: Organ) kind empirical {
    label en unofficial "case fact: the committee (of the Senate or the House, or a joint committee other than the one in paragraph (1)) is specially authorized to inspect returns or return information by a resolution of the Senate or the House, or by concurrent resolution for a joint committee — section 6103(f)(3)";
}

pub relation authorizing_resolution_specifies_purpose_and_no_other_source(committee: Organ) kind empirical {
    label en unofficial "case fact: the resolution specifies the purpose for which the return or return information is to be furnished and that the information cannot reasonably be obtained from any other source — section 6103(f)(3), second sentence";
}

pub relation other_committee_chairman_written_request(d: Disclosure, chairman: Person, committee: Organ) kind empirical {
    label en unofficial "case fact: the chairman of the committee acted, and made a written request, for the return or return information the resolution authorizes";
}

pub relation other_committee_sitting_in_closed_executive_session(d: Disclosure) kind empirical {
    label en unofficial "case fact: the committee or duly authorized and designated subcommittee receiving the disclosure is sitting in closed executive session";
}

@source(IRC_S6103_F, relation = formalizes, coverage = partial, quote = "Pursuant to an action by, and upon written request by the chairman of, a committee of the Senate or the House of Representatives (other than a committee specified in paragraph (1)) specially authorized to inspect any return or return information by a resolution")
rule S6103F3OtherCommitteeFurnishDutyRule strict {
    for d: Disclosure;
    for chairman: Person;
    for committee: Organ;
    when other_committee_chairman_written_request(d, chairman, committee)
        and chairman_of_committee(chairman, committee)
        and other_committee_specially_authorized_by_resolution(committee)
        and authorizing_resolution_specifies_purpose_and_no_other_source(committee);
    then duty S6103F3OtherCommitteeFurnishDuty {
        bearer Secretary;
        beneficiary committee;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6103_F, relation = formalizes, coverage = partial, quote = "the Secretary shall furnish such committee, or a duly authorized and designated subcommittee thereof, sitting in closed executive session, with any return or return information which such resolution authorizes the committee or subcommittee to inspect")
rule S6103F3OtherCommitteeDisclosurePermitted strict {
    for d: Disclosure;
    for chairman: Person;
    for committee: Organ;
    when other_committee_chairman_written_request(d, chairman, committee)
        and chairman_of_committee(chairman, committee)
        and other_committee_specially_authorized_by_resolution(committee)
        and authorizing_resolution_specifies_purpose_and_no_other_source(committee)
        and other_committee_sitting_in_closed_executive_session(d);
    then disclosure_permitted(d);
}

pub relation agents_designated_by_chairman(committee: Organ, number: Integer) kind empirical {
    label en unofficial "case fact: the number of examiners or agents the chairman of the committee designated or appointed in writing — section 6103(f)(4)(B)";
}

pub relation agents_designated_by_ranking_minority_member(committee: Organ, number: Integer) kind empirical {
    label en unofficial "case fact: the number of examiners or agents the ranking minority member designated or appointed in writing";
}

pub relation agent_designation_valid(committee: Organ) kind institutional {
    label en unofficial "the committee's designation of examiners or agents meets section 6103(f)(4)(B): no more than four, designated in equal numbers by the chairman and the ranking minority member";
}

@source(IRC_S6103_F, relation = formalizes, coverage = exact, quote = "Any committee or subcommittee described in paragraph (3) shall have the right, acting directly, or by or through no more than four examiners or agents, designated or appointed in writing in equal numbers by the chairman and ranking")
rule S6103F4BAgentDesignationValid strict {
    for committee: Organ;
    for byChairman: Integer;
    for byRanking: Integer;
    when agents_designated_by_chairman(committee, byChairman)
        and agents_designated_by_ranking_minority_member(committee, byRanking)
        and byChairman == byRanking
        and byChairman + byRanking <= 4;
    then agent_designation_valid(committee);
}

pub relation committee_inspects_returns_directly_or_through_agents(committee: Organ) kind empirical {
    label en unofficial "case fact: the committee (or the Chief of Staff of the Joint Committee on Taxation) inspects returns and return information, acting directly or through examiners or agents";
}

@source(IRC_S6103_F, relation = formalizes, coverage = exact, quote = "Any committee described in paragraph (1) or the Chief of Staff of the Joint Committee on Taxation shall have the authority, acting directly, or by or through such examiners or agents as the chairman")
rule S6103F4AInspectionLibertyRule strict {
    for committee: Organ;
    when named_f1_committee(committee);
    then liberty S6103F4AInspectionLiberty {
        holder committee;
        action committee_inspects_returns_directly_or_through_agents(committee);
        window [-infinity, infinity];
    };
}
@source(IRC_S6103_F, relation = formalizes, coverage = exact, quote = "Any committee or subcommittee described in paragraph (3) shall have the right, acting directly, or by or through no more than four examiners or agents, designated or appointed in writing in equal")
rule S6103F4BInspectionLibertyRule strict {
    for committee: Organ;
    when other_committee_specially_authorized_by_resolution(committee) and agent_designation_valid(committee);
    then liberty S6103F4BInspectionLiberty {
        holder committee;
        action committee_inspects_returns_directly_or_through_agents(committee);
        window [-infinity, infinity];
    };
}

pub relation submitted_to_senate_or_house(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information obtained by or on behalf of the committee is submitted by the committee to the Senate or the House of Representatives, or both — section 6103(f)(4)";
}

@source(IRC_S6103_F, relation = formalizes, coverage = partial, quote = "Any return or return information obtained by or on behalf of such committee pursuant to the provisions of this subsection may be submitted by the committee to the Senate or the House of Representatives, or to both.")
@source(IRC_S6103_F, relation = formalizes, coverage = partial, quote = "may be submitted by the committee to the Senate or the House of Representatives, or to both, except that any return or return information which can be associated with, or otherwise identify, directly or indirectly, a particular taxpayer, shall be furnished to the Senate or the House of Representatives only when sitting in closed executive session unless such taxpayer otherwise consents in writing to such disclosure.")
rule S6103F4SubmissionToChamberNonIdentifyingPermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    when submitted_to_senate_or_house(d)
        and disclosure_of(d, info)
        and not_known(identifies_particular_taxpayer(info));
    then disclosure_permitted(d);
}

pub relation chamber_sitting_in_closed_executive_session(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Senate or the House of Representatives is sitting in closed executive session when the identifying return information is furnished to it";
}

@source(IRC_S6103_F, relation = formalizes, coverage = partial, quote = "shall be furnished to the Senate or the House of Representatives only when sitting in closed executive session unless such taxpayer otherwise consents in writing to such disclosure.")
rule S6103F4SubmissionToChamberIdentifyingPermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for taxpayer: Person;
    when submitted_to_senate_or_house(d)
        and disclosure_of(d, info)
        and identifies_particular_taxpayer(info)
        and about_taxpayer(info, taxpayer)
        and (chamber_sitting_in_closed_executive_session(d) or taxpayer_consents_in_writing_to_committee_disclosure(d, taxpayer));
    then disclosure_permitted(d);
}

pub relation f5_whistleblower_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the person making the disclosure believes the return or return information may relate to possible misconduct, maladministration, or taxpayer abuse — section 6103(f)(5)";
}

@source(IRC_S6103_F, relation = formalizes, coverage = partial, quote = "Any person who otherwise has or had access to any return or return information under this section may disclose such return or return information to a committee referred to in paragraph (1) or any individual authorized")
rule S6103F5WhistleblowerToCommitteeDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, CommitteeOrAuthorizedIndividual)
        and f5_whistleblower_scope(d);
    then disclosure_permitted(d);
}

pub relation president_request_states_taxpayer_name_and_address(d: Disclosure) kind empirical {
    label en unofficial "case fact: the President's request states the name and address of the taxpayer whose return or return information is to be disclosed — section 6103(g)(1)(A)";
}

pub relation president_request_states_kind_of_return_or_information(d: Disclosure) kind empirical {
    label en unofficial "case fact: the President's request states the kind of return or return information which is to be disclosed — section 6103(g)(1)(B)";
}

pub relation president_request_states_taxable_periods(d: Disclosure) kind empirical {
    label en unofficial "case fact: the President's request states the taxable period or periods covered by such return or return information — section 6103(g)(1)(C)";
}

pub relation president_request_states_specific_reason(d: Disclosure) kind empirical {
    label en unofficial "case fact: the President's request states the specific reason why the inspection or disclosure is requested — section 6103(g)(1)(D)";
}

pub relation president_written_request_signed_personally(d: Disclosure) kind empirical {
    label en unofficial "case fact: the written request by the President was signed by him personally — section 6103(g)(1)";
}

pub relation g_recipient_designated_by_name(d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient is the President or an employee of the White House Office the President designated by name in the request";
}

pub relation g_disclosure_to_employee_below_level_5316_pay(d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient employee's annual rate of basic pay is less than the annual rate specified for positions subject to section 5 U.S.C. 5316 (the rate is set by that section)";
}

@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "Upon written request by the President, signed by him personally, the Secretary shall furnish to the President, or to such employee or employees of the White House Office as the President may designate by name in such request, a return or")
@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "(A) the name and address of the taxpayer whose return or return information is to be disclosed,")
rule S6103G1PresidentFurnishDutyRule strict {
    for d: Disclosure;
    for requester: Person;
    when recipient_organ(d, President)
        and disclosure_to(d, requester)
        and president_written_request_signed_personally(d)
        and g_recipient_designated_by_name(d)
        and president_request_states_taxpayer_name_and_address(d)
        and president_request_states_kind_of_return_or_information(d)
        and president_request_states_taxable_periods(d)
        and president_request_states_specific_reason(d);
    then duty S6103G1PresidentFurnishDuty {
        bearer Secretary;
        beneficiary President;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "Upon written request by the President, signed by him personally, the Secretary shall furnish to the President, or to such employee or employees of the White House Office as the President may designate by name in such request, a return or")
rule S6103G1PresidentDisclosurePermitted defeasible {
    for d: Disclosure;
    when president_written_request_signed_personally(d)
        and g_recipient_designated_by_name(d)
        and president_request_states_taxpayer_name_and_address(d)
        and president_request_states_kind_of_return_or_information(d)
        and president_request_states_taxable_periods(d)
        and president_request_states_specific_reason(d);
    then disclosure_permitted(d);
    unless g_disclosure_to_employee_below_level_5316_pay(d)
        and president_written_request_signed_personally(d);
}

pub relation g2_appointee_information_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return information relates to an individual designated as being under consideration for appointment to a position in the executive or judicial branch, and is limited to whether the individual (A) has filed chapter 1 returns for not more than the immediately preceding 3 years; (B) has failed to pay any tax within 10 days after notice and demand, or has been assessed a negligence penalty in the current year or immediately preceding 3 years; (C) has been or is under investigation for possible criminal offenses under the internal revenue laws, and the results; or (D) has been assessed a civil fraud penalty — section 6103(g)(2)(A)-(D)";
}

pub relation g2_written_request_by_president_or_agency_head(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request was written and made by the President or the head of the Federal agency (the Federal Bureau of Investigation acting on behalf of and upon that written request)";
}

@source(IRC_S6103_G, relation = formalizes, coverage = partial, quote = "The Secretary may disclose to a duly authorized representative of the Executive Office of the President or to the head of any Federal agency, upon written request by the President or head of such agency, or to the Federal Bureau of Investigation on behalf of and upon written request by the President or such head,")
rule S6103G2AppointeeInformationDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, ExecutiveOfficeOrAgencyHeadOrFbiForAppointment)
        and g2_written_request_by_president_or_agency_head(d)
        and g2_appointee_information_scope(d);
    then disclosure_permitted(d);
    unless g_disclosure_to_employee_below_level_5316_pay(d)
        and recipient_is(d, ExecutiveOfficeOrAgencyHeadOrFbiForAppointment);
}

pub relation g2_request_received_on(d: Disclosure, receivedOn: Date) kind empirical {
    label en unofficial "case fact: the date the Secretary received the request for return information about the individual under paragraph (2)";
}

pub relation g2_individual_notified_in_writing_on(d: Disclosure, notifiedOn: Date) kind empirical {
    label en unofficial "case fact: the date the Secretary notified the individual in writing that the information has been requested";
}

pub relation g2_individual_notified_within_3_days(d: Disclosure) kind institutional {
    label en unofficial "the individual was notified in writing within 3 days of receipt of the request";
}

@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "Within 3 days of the receipt of any request for any return information with respect to any individual under this paragraph, the Secretary shall notify such individual in writing that such information")
rule S6103G2NoticeTimelyClassification strict {
    for d: Disclosure;
    for receivedOn: Date;
    for notifiedOn: Date;
    when g2_request_received_on(d, receivedOn)
        and g2_individual_notified_in_writing_on(d, notifiedOn)
        and notifiedOn <= add_calendar_period(receivedOn, 3 calendar_day);
    then g2_individual_notified_within_3_days(d);
}

@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "Within 3 days of the receipt of any request for any return information with respect to any individual under this paragraph, the Secretary shall notify such individual in writing that such information")
rule S6103G2NoticeToIndividualDutyRule strict {
    for d: Disclosure;
    for individual: Person;
    for receivedOn: Date;
    when g2_request_received_on(d, receivedOn)
        and disclosure_to(d, individual);
    then duty S6103G2NoticeToIndividualDuty {
        bearer Secretary;
        beneficiary individual;
        goal achievement {
            condition g2_individual_notified_within_3_days(d);
            window [receivedOn, add_calendar_period(receivedOn, 3 calendar_day)];
        }
    };
}

pub relation g_employee_redisclosed_without_personal_written_direction(d: Disclosure) kind empirical {
    label en unofficial "case fact: the employee redisclosed the returns or return information to a person other than the President or the head of the agency without the personal written direction of the President or the agency head — section 6103(g)(3)";
}

pub relation g_disclosure_within_subsection(d: Disclosure) kind institutional {
    label en unofficial "the disclosure was made under subsection (g) (paragraph (1) or (2))";
}

@source(IRC_S6103_G, relation = formalizes, coverage = partial, quote = "The employees to whom returns and return information are disclosed under this subsection shall not disclose such")
rule S6103GDisclosureWithinSubsectionFromParagraph1 strict {
    for d: Disclosure;
    when president_written_request_signed_personally(d)
        and g_recipient_designated_by_name(d)
        and president_request_states_taxpayer_name_and_address(d)
        and president_request_states_kind_of_return_or_information(d)
        and president_request_states_taxable_periods(d)
        and president_request_states_specific_reason(d);
    then g_disclosure_within_subsection(d);
}

@source(IRC_S6103_G, relation = formalizes, coverage = partial, quote = "The employees to whom returns and return information are disclosed under this subsection shall not disclose such")
rule S6103GDisclosureWithinSubsectionFromParagraph2 strict {
    for d: Disclosure;
    when recipient_is(d, ExecutiveOfficeOrAgencyHeadOrFbiForAppointment)
        and g2_written_request_by_president_or_agency_head(d)
        and g2_appointee_information_scope(d);
    then g_disclosure_within_subsection(d);
}

@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "The employees to whom returns and return information are disclosed under this subsection shall not disclose such returns and return information to any other person except the President or the head of such agency without the personal written direction of the")
rule S6103G3RedisclosureBanRule strict {
    for d: Disclosure;
    for employee: Person;
    when disclosure_to(d, employee)
        and g_disclosure_within_subsection(d);
    then prohibition S6103G3RedisclosureBan {
        bearer employee;
        action g_employee_redisclosed_without_personal_written_direction(d);
        window [-infinity, infinity];
    };
}

@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "Disclosure of returns and return information under this subsection shall not be made to any employee whose annual rate of basic pay is less than the annual rate of basic pay specified for positions subject to section 5316 of title 5, United States Code.")
rule S6103G4PayLevelBarRule strict {
    for d: Disclosure;
    for discloser: Person;
    when disclosure_by(d, discloser)
        and g_disclosure_within_subsection(d);
    then prohibition S6103G4PayLevelBar {
        bearer discloser;
        action g_disclosure_to_employee_below_level_5316_pay(d);
        window [-infinity, infinity];
    };
}

pub relation g5_requested_during_quarter_ending(requester: Person, quarterEnd: Date) kind empirical {
    label en unofficial "case fact: the President or the head of an agency requested returns or return information under subsection (g) during the calendar quarter ending on this date";
}

pub relation g5_report_filed_with_joint_committee_on(requester: Person, quarterEnd: Date, filedOn: Date) kind empirical {
    label en unofficial "case fact: the report (taxpayers, the returns or return information involved, the reasons) was filed with the Joint Committee on Taxation on this date";
}

pub relation g5_report_filed_timely(requester: Person, quarterEnd: Date) kind institutional {
    label en unofficial "the report for the quarter was filed with the Joint Committee on Taxation within 30 days after the close of the quarter";
}

@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "Within 30 days after the close of each calendar quarter, the President and the head of any agency requesting returns and return information under this subsection shall each file a report with the")
rule S6103G5ReportTimelyClassification strict {
    for requester: Person;
    for quarterEnd: Date;
    for filedOn: Date;
    when g5_report_filed_with_joint_committee_on(requester, quarterEnd, filedOn)
        and filedOn <= add_calendar_period(quarterEnd, 30 calendar_day);
    then g5_report_filed_timely(requester, quarterEnd);
}

pub relation g5_president_requests_only_about_executive_branch_officers_or_employees(requester: Person, quarterEnd: Date) kind empirical {
    label en unofficial "case fact: every request the President made during the quarter concerned an individual who was an officer or employee of the executive branch at the time of the request — section 6103(g)(5), second sentence";
}

@source(IRC_S6103_G, relation = formalizes, coverage = exact, quote = "Within 30 days after the close of each calendar quarter, the President and the head of any agency requesting returns and return information under this subsection shall each file a report with the Joint Committee on Taxation setting forth the taxpayers with")
@source(IRC_S6103_G, relation = formalizes, coverage = partial, quote = "The President shall not be required to report on any request for returns and return information pertaining to an individual who was an officer or employee of the executive branch of the Federal Government at the time such request was made.")
rule S6103G5QuarterlyReportDutyRule defeasible {
    for requester: Person;
    for quarterEnd: Date;
    when g5_requested_during_quarter_ending(requester, quarterEnd);
    then duty S6103G5QuarterlyReportDuty {
        bearer requester;
        beneficiary JointCommitteeOnTaxation;
        goal achievement {
            condition g5_report_filed_timely(requester, quarterEnd);
            window [quarterEnd, add_calendar_period(quarterEnd, 30 calendar_day)];
        }
    };
    unless g5_president_requests_only_about_executive_branch_officers_or_employees(requester, quarterEnd)
        and g5_requested_during_quarter_ending(requester, quarterEnd);
}

pub relation g5d_joint_committee_report_disclosure_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Joint Committee on Taxation discloses a report filed under (g)(5) (including identifying details) — section 6103(g)(5), third sentence";
}

external judgment relation joint_committee_determines_g5_report_disclosure_in_the_national_interest(d: Disclosure) {
    authority Secretary;
    label en official "the Joint Committee on Taxation determines that disclosure of the report (including identifying details) would be in the national interest — section 6103(g)(5), third sentence";
}

@source(IRC_S6103_G, relation = formalizes, coverage = partial, quote = "Reports filed pursuant to this paragraph shall not be disclosed unless the Joint Committee on Taxation determines that disclosure thereof (including identifying details) would be in the national interest.")
rule S6103G5DJointCommitteeDisclosureOfG5ReportDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, PersonReceivingG5Report)
        and g5d_joint_committee_report_disclosure_scope(d)
        and joint_committee_determines_g5_report_disclosure_in_the_national_interest(d);
    then disclosure_permitted(d);
}

pub relation g5_report_retained_by_joint_committee_until(requester: Person, quarterEnd: Date, filedOn: Date, retainedUntil: Date) kind empirical {
    label en unofficial "case fact: the Joint Committee on Taxation retained the report (filed on the date given) until this date";
}

pub relation joint_committee_determined_within_2_years_that_disclosure_to_congress_is_necessary(requester: Person, quarterEnd: Date) kind empirical {
    label en unofficial "case fact: within the 2-year period the Joint Committee on Taxation determined that a disclosure to the Congress is necessary — section 6103(g)(5), last sentence";
}

pub relation g5_retention_beyond_two_years(requester: Person, quarterEnd: Date) kind institutional {
    label en unofficial "the Joint Committee retained the report for more than 2 years after it was filed";
}

@source(IRC_S6103_G, relation = formalizes, coverage = partial, quote = "Such reports shall be maintained by the Joint Committee on Taxation for a period not exceeding 2 years unless, within such period, the Joint Committee on Taxation determines that a disclosure to the Congress is necessary.")
rule S6103G5RetentionBeyondTwoYears strict {
    for requester: Person;
    for quarterEnd: Date;
    for filedOn: Date;
    for retainedUntil: Date;
    when g5_report_retained_by_joint_committee_until(requester, quarterEnd, filedOn, retainedUntil)
        and retainedUntil > add_calendar_period(filedOn, 2 calendar_year);
    then g5_retention_beyond_two_years(requester, quarterEnd);
}

@source(IRC_S6103_G, relation = formalizes, coverage = partial, quote = "Such reports shall be maintained by the Joint Committee on Taxation for a period not exceeding 2 years unless, within such period, the Joint Committee on Taxation determines that a disclosure to the Congress is necessary.")
rule S6103G5RetentionLimitRule defeasible {
    for requester: Person;
    for quarterEnd: Date;
    when g5_requested_during_quarter_ending(requester, quarterEnd);
    then prohibition S6103G5RetentionLimit {
        bearer JointCommitteeOnTaxation;
        action g5_retention_beyond_two_years(requester, quarterEnd);
        window [-infinity, infinity];
    };
    unless joint_committee_determined_within_2_years_that_disclosure_to_congress_is_necessary(requester, quarterEnd)
        and g5_requested_during_quarter_ending(requester, quarterEnd);
}

pub relation h1_treasury_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the officer or employee of the Department of the Treasury has official duties that require the inspection or disclosure for tax administration purposes — section 6103(h)(1)";
}

@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "Returns and return information shall, without written request, be open to inspection by or disclosure to officers and employees of the Department of the Treasury whose official duties require such inspection or disclosure for tax administration")
rule S6103H1TreasuryOfficersForTaxAdministrationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, TreasuryOfficerOrEmployee)
        and h1_treasury_scope(d);
    then disclosure_permitted(d);
}

pub relation h2_matter_involving_tax_administration(d: Disclosure) kind empirical {
    label en unofficial "case fact: the matter involves tax administration";
}

pub relation h2_recipient_personally_and_directly_engaged_solely_for_proceeding_use(d: Disclosure) kind empirical {
    label en unofficial "case fact: the officers and employees are personally and directly engaged in, and use the information solely for, a proceeding before a Federal grand jury or its preparation (or an investigation that may result in one) or a Federal or State court proceeding";
}

pub relation h2_taxpayer_is_party_or_proceeding_arose_from_liability(d: Disclosure) kind empirical {
    label en unofficial "case fact: the taxpayer is or may be a party to the proceeding, or it arose out of, or in connection with, determining the taxpayer's civil or criminal liability, or collecting civil liability, in respect of any tax imposed under this title — (h)(2)(A)";
}

pub relation h2_item_treatment_related_to_issue(d: Disclosure) kind empirical {
    label en unofficial "case fact: the treatment of an item reflected on the return is or may be related to the resolution of an issue in the proceeding or investigation — (h)(2)(B)";
}

pub relation h2_transactional_relationship_may_affect_issue(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information relates or may relate to a transactional relationship between a person who is or may be a party and the taxpayer which affects or may affect the resolution of an issue — (h)(2)(C)";
}

pub relation h3_case_referred_or_chapter_76_subchapter_b_proceeding(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary referred the case to the Department of Justice, or the proceeding is authorized by subchapter B of chapter 76 — (h)(3)(A)";
}

pub relation h3_written_request_by_attorney_general_deputy_or_assistant(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary received a written request from the Attorney General, the Deputy Attorney General, or an Assistant Attorney General for the return or return information of a person named in the request, setting forth the need for the disclosure — (h)(3)(B)";
}

@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "In a matter involving tax administration, a return or return information shall be open to inspection by or disclosure to officers and employees of the Department of Justice (including United States attorneys) personally and directly engaged in, and solely for their use in, any proceeding before a Federal grand jury or")
@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "(A) if the Secretary has referred the case to the Department of Justice, or if the proceeding is authorized by subchapter B of chapter 76, the Secretary may make such disclosure on his own motion, or")
rule S6103H2JusticeDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, DepartmentOfJusticeOfficer)
        and h2_matter_involving_tax_administration(d)
        and h2_recipient_personally_and_directly_engaged_solely_for_proceeding_use(d)
        and (h2_taxpayer_is_party_or_proceeding_arose_from_liability(d) or h2_item_treatment_related_to_issue(d) or h2_transactional_relationship_may_affect_issue(d))
        and (h3_case_referred_or_chapter_76_subchapter_b_proceeding(d) or h3_written_request_by_attorney_general_deputy_or_assistant(d));
    then disclosure_permitted(d);
}

@source(IRC_S6103_H, relation = formalizes, coverage = exact, quote = "(B) if the Secretary receives a written request from the Attorney General, the Deputy Attorney General, or an Assistant Attorney General for a return of, or return information relating to, a person named in such request and setting forth the need")
rule S6103H3BJusticeFurnishDutyRule strict {
    for d: Disclosure;
    when recipient_is(d, DepartmentOfJusticeOfficer)
        and h2_matter_involving_tax_administration(d)
        and h2_recipient_personally_and_directly_engaged_solely_for_proceeding_use(d)
        and (h2_taxpayer_is_party_or_proceeding_arose_from_liability(d) or h2_item_treatment_related_to_issue(d) or h2_transactional_relationship_may_affect_issue(d))
        and h3_written_request_by_attorney_general_deputy_or_assistant(d)
        and recipient_organ(d, DepartmentOfJustice);
    then duty S6103H3BJusticeFurnishDuty {
        bearer Secretary;
        beneficiary DepartmentOfJustice;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation h4_proceeding_pertaining_to_tax_administration(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is in a Federal or State judicial or administrative proceeding pertaining to tax administration — section 6103(h)(4)";
}

pub relation h4_taxpayer_is_party_or_proceeding_arose_from_liability(d: Disclosure) kind empirical {
    label en unofficial "case fact: the taxpayer is a party, or the proceeding arose out of, or in connection with, determining the taxpayer's civil or criminal liability, or the collection of such civil liability, in respect of any tax — (h)(4)(A)";
}

pub relation h4_item_treatment_directly_related_to_issue(d: Disclosure) kind empirical {
    label en unofficial "case fact: the treatment of an item reflected on the return is directly related to the resolution of an issue in the proceeding — (h)(4)(B)";
}

pub relation h4_transactional_relationship_directly_affects_issue(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information directly relates to a transactional relationship between a party and the taxpayer which directly affects the resolution of an issue — (h)(4)(C)";
}

pub relation h4_required_by_court_order_under_3500_or_rule_16(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to the extent required by an order of a court pursuant to 18 U.S.C. 3500 or Rule 16 of the Federal Rules of Criminal Procedure — (h)(4)(D)";
}

external judgment relation secretary_determines_h4_disclosure_would_identify_informant_or_impair_investigation(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure would identify a confidential informant or seriously impair a civil or criminal tax investigation — section 6103(h)(4), last sentence";
}

@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "A return or return information may be disclosed in a Federal or State judicial or administrative proceeding pertaining to tax administration, but only—")
@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "(A) if the taxpayer is a party to the proceeding, or the proceeding arose out of, or in connection with, determining the taxpayer's civil or criminal")
@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "(B) if the treatment of an item reflected on such return is directly related to the resolution of an issue in the")
@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "(C) if such return or return information directly relates to a transactional relationship between a person who is a party to the proceeding and the")
@source(IRC_S6103_H, relation = formalizes, coverage = exact, quote = "However, such return or return information shall not be disclosed as provided in subparagraph (A), (B), or (C) if the Secretary determines that such disclosure would identify a confidential informant or seriously impair a civil or criminal tax")
rule S6103H4ProceedingDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, TaxProceeding)
        and h4_proceeding_pertaining_to_tax_administration(d)
        and (h4_taxpayer_is_party_or_proceeding_arose_from_liability(d) or h4_item_treatment_directly_related_to_issue(d) or h4_transactional_relationship_directly_affects_issue(d));
    then disclosure_permitted(d);
    unless secretary_determines_h4_disclosure_would_identify_informant_or_impair_investigation(d)
        and recipient_is(d, TaxProceeding)
        and h4_proceeding_pertaining_to_tax_administration(d);
}

@source(IRC_S6103_H, relation = formalizes, coverage = exact, quote = "(D) to the extent required by order of a court pursuant to section 3500 of title 18, United States Code, or rule 16 of the Federal Rules of Criminal Procedure, such court being authorized in the issuance of such order")
rule S6103H4DCourtOrderDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, TaxProceeding)
        and h4_proceeding_pertaining_to_tax_administration(d)
        and h4_required_by_court_order_under_3500_or_rule_16(d);
    then disclosure_permitted(d);
}

pub relation h5_ssa_rrb_withholding_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of available return information from the Internal Revenue Service master files with respect to the address and status of an individual as a nonresident alien or as a citizen or resident of the United States, for purposes of carrying out the recipient's responsibilities for withholding tax under section 1441 from social security benefits (section 86(d)); the request is that of the payor agency — section 6103(h)(5)";
}

@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "Upon written request of the payor agency, the Secretary may disclose available return information from the master files of the Internal Revenue Service with respect to the address and status of an individual as a nonresident alien or as a citizen or")
rule S6103H5SocialSecurityWithholdingStatusDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, SocialSecurityAdministrationOrRailroadRetirementBoard)
        and disclosure_upon_written_request(d)
        and h5_ssa_rrb_withholding_scope(d);
    then disclosure_permitted(d);
}

pub relation disclosure_to_oversight_board_member_or_staff(d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient is a member of the Oversight Board described in section 7802(b)(1)(A) or (D), or an employee or detailee of the Board, by reason of service with the Board — section 6103(h)(6)(A)";
}

@source(IRC_S6103_H, relation = formalizes, coverage = exact, quote = "Notwithstanding paragraph (1), and except as provided in subparagraph (B), no return or return information may be disclosed to any member of the Oversight Board described in subparagraph (A) or (D) of section 7802(b)(1)")
rule S6103H6AOversightBoardBarRule strict {
    for d: Disclosure;
    for discloser: Person;
    when disclosure_by(d, discloser)
        and recipient_is(d, OversightBoardMemberOrStaff);
    then prohibition S6103H6AOversightBoardBar {
        bearer discloser;
        action disclosure_to_oversight_board_member_or_staff(d);
        window [-infinity, infinity];
    };
}

pub relation oversight_board_request_or_contact_received_by_irs_employee(employee: Person) kind empirical {
    label en unofficial "case fact: an officer or employee of the Internal Revenue Service received a request for information not permitted to be disclosed under the first sentence, or a contact relating to a specific taxpayer, from an Oversight Board member, employee, or detailee";
}

pub relation oversight_board_contact_reported_to_secretary(employee: Person) kind empirical {
    label en unofficial "case fact: the officer or employee reported the request or contact to the Secretary";
}

@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "Any request for information not permitted to be disclosed under the preceding sentence, and any contact relating to a specific taxpayer, made by any such individual to an officer or employee of the Internal Revenue Service shall be reported by such officer or employee to the Secretary, the Treasury Inspector General for Tax Administration, and the Joint Committee on Taxation.")
rule S6103H6AReportToSecretaryDutyRule strict {
    for employee: Person;
    when oversight_board_request_or_contact_received_by_irs_employee(employee);
    then duty S6103H6AReportToSecretaryDuty {
        bearer employee;
        beneficiary Secretary;
        goal achievement {
            condition oversight_board_contact_reported_to_secretary(employee);
            window [-infinity, infinity];
        }
    };
}

pub relation oversight_board_contact_reported_to_inspectorgeneral(employee: Person) kind empirical {
    label en unofficial "case fact: the officer or employee reported the request or contact to the Treasury Inspector General for Tax Administration";
}

@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "Any request for information not permitted to be disclosed under the preceding sentence, and any contact relating to a specific taxpayer, made by any such individual to an officer or employee of the Internal Revenue Service shall be reported by such officer or employee to the Secretary, the Treasury Inspector General for Tax Administration, and the Joint Committee on Taxation.")
rule S6103H6AReportToInspectorGeneralDutyRule strict {
    for employee: Person;
    when oversight_board_request_or_contact_received_by_irs_employee(employee);
    then duty S6103H6AReportToInspectorGeneralDuty {
        bearer employee;
        beneficiary TreasuryInspectorGeneralForTaxAdministration;
        goal achievement {
            condition oversight_board_contact_reported_to_inspectorgeneral(employee);
            window [-infinity, infinity];
        }
    };
}

pub relation oversight_board_contact_reported_to_jointcommittee(employee: Person) kind empirical {
    label en unofficial "case fact: the officer or employee reported the request or contact to the Joint Committee on Taxation";
}

@source(IRC_S6103_H, relation = formalizes, coverage = partial, quote = "Any request for information not permitted to be disclosed under the preceding sentence, and any contact relating to a specific taxpayer, made by any such individual to an officer or employee of the Internal Revenue Service shall be reported by such officer or employee to the Secretary, the Treasury Inspector General for Tax Administration, and the Joint Committee on Taxation.")
rule S6103H6AReportToJointCommitteeDutyRule strict {
    for employee: Person;
    when oversight_board_request_or_contact_received_by_irs_employee(employee);
    then duty S6103H6AReportToJointCommitteeDuty {
        bearer employee;
        beneficiary JointCommitteeOnTaxation;
        goal achievement {
            condition oversight_board_contact_reported_to_jointcommittee(employee);
            window [-infinity, infinity];
        }
    };
}

external judgment relation commissioner_or_tigta_determines_return_information_necessary_for_board(d: Disclosure) {
    authority Commissioner;
    label en official "the Commissioner or the Treasury Inspector General for Tax Administration determines it is necessary to include the return or return information in the report or other matter to enable the Board to carry out its duties — section 6103(h)(6)(B)(ii)";
}

pub relation h6b_report_prepared_for_oversight_board(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Commissioner or the Treasury Inspector General for Tax Administration prepared the report or other matter for the Oversight Board to assist the Board in carrying out its duties — section 6103(h)(6)(B)(i)";
}

pub relation h6b_excludes_taxpayer_identity_information(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information disclosed to the Board is other than information regarding taxpayer identity and is disclosed solely for the purpose of carrying out the Board's duties";
}

@source(IRC_S6103_H, relation = formalizes, coverage = exact, quote = "(i) the Commissioner or the Treasury Inspector General for Tax Administration prepares any report or other matter for the Oversight Board in order to assist the Board in carrying out its duties; and")
@source(IRC_S6103_H, relation = formalizes, coverage = exact, quote = "(ii) the Commissioner or such Inspector General determines it is necessary to include any return or return information in such report or other matter to enable the Board to carry out such duties,")
@source(IRC_S6103_H, relation = formalizes, coverage = exact, quote = "such return or return information (other than information regarding taxpayer identity) may be disclosed to members, employees, or detailees of the Board solely for the purpose of carrying out such duties.")
rule S6103H6BReportToBoardDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, OversightBoardMemberOrStaff)
        and h6b_report_prepared_for_oversight_board(d)
        and commissioner_or_tigta_determines_return_information_necessary_for_board(d)
        and h6b_excludes_taxpayer_identity_information(d);
    then disclosure_permitted(d);
}
