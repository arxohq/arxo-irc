// 26 U.S.C. §6103(p) remainder — procedure and recordkeeping: reproductions, the annual reports
// (Secretary to the Joint Committee on Taxation and to the committees, Comptroller General to the
// Secretary and the committees), the Comptroller General's audit of safeguards, State return
// attachments and contractors — and §6103(q). STAGE 2 (the stage-1 modules 05 carry (p)(3)(A) and
// (p)(4)). Duties of the Secretary and of the Comptroller General are achievement duties with the
// statutory window (90 days after the close of the calendar year is a date computed from the year-end
// date, a case fact); restrictions on what a report may contain and on disclosure to certain State
// officers and contractors are prohibitions; "to the satisfaction of the Secretary" is an external
// judgment relation (DECISION-0194).

use self::{
    ComptrollerGeneral,
    Disclosure,
    IRC_S6103_P,
    JointCommitteeOnTaxation,
    Organ,
    Person,
    Recipient,
    Secretary,
    disclosure_by,
    disclosure_on,
    disclosure_permitted,
    disclosure_to,
    disclosure_upon_written_request,
    named_f1_committee,
    recipient_is,
};

pub relation p2a_reproduction_furnished(d: Disclosure) kind empirical {
    label en unofficial "case fact: a reproduction or certified reproduction of the return was furnished to the person to whom disclosure or inspection of the return is authorized";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "A reproduction or certified reproduction of a return shall, upon written request, be furnished to any person to whom disclosure or inspection of such return is authorized under this section.")
rule S6103P2AReproductionDutyRule defeasible {
    for d: Disclosure;
    for person: Person;
    when disclosure_upon_written_request(d)
        and disclosure_to(d, person)
        and disclosure_permitted(d);
    then duty S6103P2AReproductionDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition p2a_reproduction_furnished(d);
            window [-infinity, infinity];
        }
    };
}

pub relation p2b_return_information_provided_in_the_mode_secretary_determines_appropriate(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return information is provided in the form of written documents, reproductions, films or photoimpressions, electronically produced tapes, disks, or records, or by any other mode or means which the Secretary determines necessary or appropriate — section 6103(p)(2)(B)";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "Return information disclosed to any person under the provisions of this title may be provided in the form of written documents, reproductions of such documents, films or photoimpressions, or electronically produced tapes, disks, or records, or by any other")
rule S6103P2BModeOfDisclosureLibertyRule defeasible {
    for d: Disclosure;
    when disclosure_permitted(d);
    then liberty S6103P2BModeOfDisclosureLiberty {
        holder Secretary;
        action p2b_return_information_provided_in_the_mode_secretary_determines_appropriate(d);
        window [-infinity, infinity];
    };
}

pub entity Reproduction {
    label en unofficial "a reproduction of a return, document, or other matter made in accordance with section 6103(p)(2)";
}

pub relation reproduction_made_in_accordance_with_p2(copy: Reproduction) kind empirical {
    label en unofficial "case fact: the reproduction of a return, document, or other matter was made in accordance with paragraph (2)";
}

pub relation reproduction_properly_authenticated(copy: Reproduction) kind empirical {
    label en unofficial "case fact: the reproduction is properly authenticated";
}

pub relation reproduction_has_legal_status_of_original(copy: Reproduction) kind institutional {
    label en unofficial "the reproduction has the same legal status as the original";
}

pub relation reproduction_admissible_as_if_original(copy: Reproduction) kind institutional {
    label en unofficial "the reproduction is admissible in evidence in any judicial or administrative proceeding as if it were the original, whether or not the original is in existence";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "Any reproduction of any return, document, or other matter made in accordance with this paragraph shall have the same legal status as the original")
rule S6103P2CLegalStatusOfReproduction strict {
    for copy: Reproduction;
    when reproduction_made_in_accordance_with_p2(copy);
    then reproduction_has_legal_status_of_original(copy);
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "and any such reproduction shall, if properly authenticated, be admissible in evidence in any judicial or administrative proceeding as if it were the original, whether or not the original is in existence.")
rule S6103P2CAdmissibleAsOriginal strict {
    for copy: Reproduction;
    when reproduction_made_in_accordance_with_p2(copy)
        and reproduction_properly_authenticated(copy);
    then reproduction_admissible_as_if_original(copy);
}

pub relation calendar_year_closed_on(yearEnd: Date) kind empirical {
    label en unofficial "case fact: a calendar year closed on this date (the last day of the calendar year)";
}

pub relation p3b_report_furnished_to_joint_committee_on(yearEnd: Date, furnishedOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary furnished the report or summary of the records or accountings of paragraph (3)(A) for the year to the Joint Committee on Taxation on this date";
}

pub relation p3b_report_timely(yearEnd: Date) kind institutional {
    label en unofficial "the report for the calendar year was furnished within 90 days after the close of the year";
}

@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "The Secretary shall, within 90 days after the close of each calendar year, furnish to the Joint Committee on Taxation a report with respect to, or summary of, the records or accountings described in subparagraph (A) in such form and containing such")
rule S6103P3BReportTimelyClassification strict {
    for yearEnd: Date;
    for furnishedOn: Date;
    when p3b_report_furnished_to_joint_committee_on(yearEnd, furnishedOn)
        and furnishedOn <= add_calendar_period(yearEnd, 90 calendar_day);
    then p3b_report_timely(yearEnd);
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "The Secretary shall, within 90 days after the close of each calendar year, furnish to the Joint Committee on Taxation a report with respect to, or summary of, the records or accountings described in subparagraph (A) in such form and containing such")
rule S6103P3BReportDutyRule strict {
    for yearEnd: Date;
    when calendar_year_closed_on(yearEnd);
    then duty S6103P3BReportDuty {
        bearer Secretary;
        beneficiary JointCommitteeOnTaxation;
        goal achievement {
            condition p3b_report_timely(yearEnd);
            window [yearEnd, add_calendar_period(yearEnd, 90 calendar_day)];
        }
    };
}

pub relation p3b_report_includes_president_g_request_record_about_executive_branch_individual(yearEnd: Date) kind empirical {
    label en unofficial "case fact: the report or summary includes a record or accounting of a request by the President under subsection (g), or the disclosure in response, concerning an individual who at the time of the request was an officer or employee of the executive branch";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "Such report or summary shall not, however, include a record or accounting of any request by the President under subsection (g) for, or the disclosure in response to such request of, any return or return information with respect to any individual who, at the time of such request, was an officer or employee of the executive branch of the Federal Government.")
rule S6103P3BExecutiveBranchExclusionRule strict {
    for yearEnd: Date;
    when calendar_year_closed_on(yearEnd);
    then prohibition S6103P3BExecutiveBranchExclusion {
        bearer Secretary;
        action p3b_report_includes_president_g_request_record_about_executive_branch_individual(yearEnd);
        window [-infinity, infinity];
    };
}

pub relation p3b_joint_committee_disclosure_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Joint Committee on Taxation discloses the report or summary, or any part of it, to such persons and for such purposes as it determines — section 6103(p)(3)(B), last sentence";
}

pub relation p3b_joint_committee_majority_record_vote(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Joint Committee determined the persons and purposes by record vote of a majority of its members";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "Such report or summary, or any part thereof, may be disclosed by such joint committee to such persons and for such purposes as the joint committee may, by record vote of a majority of the members of the joint committee, determine.")
rule S6103P3BJointCommitteeDisclosureOfReportDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, PersonReceivingJointCommitteeReport)
        and p3b_joint_committee_disclosure_scope(d)
        and p3b_joint_committee_majority_record_vote(d);
    then disclosure_permitted(d);
}

pub relation p3c_public_report_furnished_to_joint_committee_on(yearEnd: Date, furnishedOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary furnished to the Joint Committee on Taxation, for disclosure to the public, the report on requests, instances of disclosure, taxpayers whose returns were disclosed, and the general purposes of the requests, for each Federal agency, State agency, Government Accountability Office and Congressional Budget Office, on this date — section 6103(p)(3)(C)";
}

pub relation p3c_report_timely(yearEnd: Date) kind institutional {
    label en unofficial "the public report was furnished within 90 days after the close of the calendar year";
}

@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "The Secretary shall, within 90 days after the close of each calendar year, furnish to the Joint Committee on Taxation for disclosure to the public a report with respect to the records or accountings described in subparagraph (A) which—")
rule S6103P3CReportTimelyClassification strict {
    for yearEnd: Date;
    for furnishedOn: Date;
    when p3c_public_report_furnished_to_joint_committee_on(yearEnd, furnishedOn)
        and furnishedOn <= add_calendar_period(yearEnd, 90 calendar_day);
    then p3c_report_timely(yearEnd);
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "The Secretary shall, within 90 days after the close of each calendar year, furnish to the Joint Committee on Taxation for disclosure to the public a report with respect to the records or accountings described in subparagraph (A) which—")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(i) provides with respect to each Federal agency, each agency, body, or commission described in subsection (d), (i)(3)(B)(i) or (7)(A)(ii), or (l)(6), and the Government Accountability Office the number of—")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(I) requests for disclosure of returns and return information,")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(II) instances in which returns and return information were disclosed pursuant to such requests or")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(III) taxpayers whose returns, or return information with respect to whom, were disclosed pursuant")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(ii) describes the general purposes for which such requests were made.")
rule S6103P3CReportDutyRule strict {
    for yearEnd: Date;
    when calendar_year_closed_on(yearEnd);
    then duty S6103P3CReportDuty {
        bearer Secretary;
        beneficiary JointCommitteeOnTaxation;
        goal achievement {
            condition p3c_report_timely(yearEnd);
            window [yearEnd, add_calendar_period(yearEnd, 90 calendar_day)];
        }
    };
}

pub relation p5_report_on_procedures_and_safeguards_furnished(committee: Organ, yearEnd: Date) kind empirical {
    label en unofficial "case fact: the Secretary furnished the committee the report describing the procedures and safeguards established and utilized by the agencies, bodies, or commissions, the Government Accountability Office, and the Congressional Budget Office, including instances of deficiencies and failure to establish or utilize them — section 6103(p)(5)";
}

@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "After the close of each calendar year, the Secretary shall furnish to each committee described in subsection (f)(1) a report which describes the procedures and safeguards established and utilized by such agencies, bodies, or commissions, the Government")
rule S6103P5SafeguardsReportDutyRule strict {
    for committee: Organ;
    for yearEnd: Date;
    when named_f1_committee(committee)
        and calendar_year_closed_on(yearEnd);
    then duty S6103P5SafeguardsReportDuty {
        bearer Secretary;
        beneficiary committee;
        goal achievement {
            condition p5_report_on_procedures_and_safeguards_furnished(committee, yearEnd);
            window [yearEnd, infinity);
        }
    };
}

pub entity SafeguardsAudit {
    label en unofficial "an audit of the procedures and safeguards established by agencies, bodies, or commissions and the Congressional Budget Office under section 6103(p)";
}

pub relation safeguards_audit_conducted_on(audit: SafeguardsAudit, conductedOn: Date) kind empirical {
    label en unofficial "case fact: the Comptroller General conducts the audit on this date — section 6103(p)(6)(A)";
}

pub relation safeguards_audit_secretary_notified_on(audit: SafeguardsAudit, notifiedOn: Date) kind empirical {
    label en unofficial "case fact: the Comptroller General notified the Secretary of the audit on this date";
}

pub relation safeguards_audit_secretary_notified_before_audit(audit: SafeguardsAudit) kind institutional {
    label en unofficial "the Comptroller General notified the Secretary before the audit was conducted";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "The Comptroller General shall notify the Secretary before any such audit is conducted.")
rule S6103P6ANoticeBeforeAuditClassification strict {
    for audit: SafeguardsAudit;
    for conductedOn: Date;
    for notifiedOn: Date;
    when safeguards_audit_conducted_on(audit, conductedOn)
        and safeguards_audit_secretary_notified_on(audit, notifiedOn)
        and notifiedOn < conductedOn;
    then safeguards_audit_secretary_notified_before_audit(audit);
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "The Comptroller General shall notify the Secretary before any such audit is conducted.")
rule S6103P6ANoticeDutyRule strict {
    for audit: SafeguardsAudit;
    for conductedOn: Date;
    when safeguards_audit_conducted_on(audit, conductedOn);
    then duty S6103P6ANoticeDuty {
        bearer ComptrollerGeneral;
        beneficiary Secretary;
        goal achievement {
            condition safeguards_audit_secretary_notified_before_audit(audit);
            window [-infinity, conductedOn];
        }
    };
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "The Comptroller General may audit the procedures and safeguards established by such agencies, bodies, or commissions and the Congressional Budget Office pursuant to this subsection to determine whether such safeguards and procedures meet the requirements of")
rule S6103P6AAuditLibertyRule strict {
    for audit: SafeguardsAudit;
    for conductedOn: Date;
    when safeguards_audit_conducted_on(audit, conductedOn);
    then liberty S6103P6AAuditLiberty {
        holder ComptrollerGeneral;
        action safeguards_audit_conducted_on(audit, conductedOn);
        window [-infinity, infinity];
    };
}

pub relation p6b_records_system_maintained_by_comptroller_general(yearEnd: Date) kind empirical {
    label en unofficial "case fact: the Comptroller General maintains a permanent system of standardized records and accountings of returns and return information inspected by GAO officers and employees under subsection (i)(8)(A)(ii)";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(i) maintain a permanent system of standardized records and accountings of returns and return information inspected by officers and employees of the Government Accountability Office under subsection (i)(8)(A)(ii) and shall, within 90 days after the close of")
rule S6103P6BiRecordsDutyRule strict {
    for yearEnd: Date;
    when calendar_year_closed_on(yearEnd);
    then duty S6103P6BiRecordsDuty {
        bearer ComptrollerGeneral;
        beneficiary Secretary;
        goal maintenance {
            condition p6b_records_system_maintained_by_comptroller_general(yearEnd);
            window [-infinity, infinity];
        }
    };
}

pub relation p6b_report_furnished_to_secretary_on(yearEnd: Date, furnishedOn: Date) kind empirical {
    label en unofficial "case fact: the Comptroller General furnished the report or summary of such records and accountings to the Secretary on this date";
}

pub relation p6b_report_to_secretary_timely(yearEnd: Date) kind institutional {
    label en unofficial "the Comptroller General furnished the report to the Secretary within 90 days after the close of the calendar year";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(i) maintain a permanent system of standardized records and accountings of returns and return information inspected by officers and employees of the Government Accountability Office under subsection (i)(8)(A)(ii) and shall, within 90 days after the close of")
rule S6103P6BiReportTimelyClassification strict {
    for yearEnd: Date;
    for furnishedOn: Date;
    when p6b_report_furnished_to_secretary_on(yearEnd, furnishedOn)
        and furnishedOn <= add_calendar_period(yearEnd, 90 calendar_day);
    then p6b_report_to_secretary_timely(yearEnd);
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(i) maintain a permanent system of standardized records and accountings of returns and return information inspected by officers and employees of the Government Accountability Office under subsection (i)(8)(A)(ii) and shall, within 90 days after the close of")
rule S6103P6BiReportDutyRule strict {
    for yearEnd: Date;
    when calendar_year_closed_on(yearEnd);
    then duty S6103P6BiReportDuty {
        bearer ComptrollerGeneral;
        beneficiary Secretary;
        goal achievement {
            condition p6b_report_to_secretary_timely(yearEnd);
            window [yearEnd, add_calendar_period(yearEnd, 90 calendar_day)];
        }
    };
}

pub relation committee_described_in_subsection_f(committee: Organ) kind empirical {
    label en unofficial "case fact: the committee is a committee described in subsection (f)";
}

pub relation p6b_findings_report_furnished_to_committee_and_secretary(committee: Organ, yearEnd: Date) kind empirical {
    label en unofficial "case fact: the Comptroller General furnished the annual report setting forth his findings with respect to any audit conducted under subparagraph (A) to the committee and to the Secretary";
}

@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "(ii) furnish an annual report to each committee described in subsection (f) and to the Secretary setting forth his findings with respect to any audit conducted pursuant to subparagraph (A).")
rule S6103P6BiiFindingsReportDutyRule strict {
    for committee: Organ;
    for yearEnd: Date;
    when committee_described_in_subsection_f(committee)
        and calendar_year_closed_on(yearEnd);
    then duty S6103P6BiiFindingsReportDuty {
        bearer ComptrollerGeneral;
        beneficiary committee;
        goal achievement {
            condition p6b_findings_report_furnished_to_committee_and_secretary(committee, yearEnd);
            window [yearEnd, infinity);
        }
    };
}

pub relation p6b4_secretary_to_joint_committee_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary discloses to the Joint Committee on Taxation a report furnished to the Secretary under clause (i) — section 6103(p)(6)(B), last sentence";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "The Secretary may disclose to the Joint Committee any report furnished to him under clause (i).")
rule S6103P6B4SecretaryDisclosureOfGaoReportToJointCommitteeDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, JointCommitteeOnTaxationReceivingGaoReport)
        and p6b4_secretary_to_joint_committee_scope(d);
    then disclosure_permitted(d);
}

pub relation p7_regulations_prescribing_administrative_review_of_p4_determinations_issued(secretary: Organ) kind empirical {
    label en unofficial "case fact: the Secretary has by regulations prescribed procedures which provide for administrative review of any determination under paragraph (4) that an agency, body, or commission described in subsection (d) has failed to meet the requirements of that paragraph";
}

@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "The Secretary shall by regulations prescribe procedures which provide for administrative review of any determination under paragraph (4) that any agency, body, or commission described in subsection (d) has failed to meet the requirements of such paragraph.")
rule S6103P7ReviewProceduresDutyRule strict {
    then duty S6103P7ReviewProceduresDuty {
        bearer Secretary;
        goal achievement {
            condition p7_regulations_prescribing_administrative_review_of_p4_determinations_issued(Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation p8_state_requires_attachment_of_federal_return_portion(d: Disclosure) kind empirical {
    label en unofficial "case fact: the State of the officer or employee requires a taxpayer to attach to, or include in, a State tax return a copy of a portion of his Federal return, or information reflected on it — section 6103(p)(8)(A)";
}

pub relation p8_state_adopted_confidentiality_provisions_for_attached_copy(d: Disclosure) kind empirical {
    label en unofficial "case fact: the State adopted provisions of law which protect the confidentiality of the copy of the Federal return (or portion) attached to, or the Federal return information reflected on, the State return";
}

pub relation p8_disclosed_to_state_officer_of_attaching_state(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information was disclosed to an officer or employee of such a State";
}

pub relation p8_state_bar_applies(d: Disclosure) kind institutional {
    label en unofficial "the disclosure is made after December 31, 1978 to an officer or employee of a State which requires a taxpayer to attach or include a copy of his Federal return (or information reflected on it) in the State return — the section 6103(p)(8)(A) bar condition";
}

@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of this section, no return or return information shall be disclosed after December 31, 1978, to any officer or employee of any State which requires a taxpayer to attach to, or include in, any State tax return a copy of any portion of his Federal return, or")
rule S6103P8ABarAppliesClassification strict {
    for d: Disclosure;
    for on: Date;
    when disclosure_on(d, on)
        and on > @1978-12-31
        and p8_state_requires_attachment_of_federal_return_portion(d);
    then p8_state_bar_applies(d);
}

@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of this section, no return or return information shall be disclosed after December 31, 1978, to any officer or employee of any State which requires a taxpayer to attach to, or include in, any State tax return a copy of any portion of his Federal return, or")
rule S6103P8AStateSafeguardBarRule defeasible {
    for d: Disclosure;
    when p8_state_bar_applies(d);
    then prohibition S6103P8AStateSafeguardBar {
        bearer Secretary;
        action p8_disclosed_to_state_officer_of_attaching_state(d);
        window [-infinity, infinity];
    };
    unless p8_state_adopted_confidentiality_provisions_for_attached_copy(d)
        and p8_state_bar_applies(d);
}

pub relation p8b_state_internal_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: an officer or employee of a State discloses a copy of any portion of a Federal return, or any information on a Federal return which is required to be attached or included in a State return, to another officer or employee of the State (or political subdivision) — section 6103(p)(8)(B)";
}

pub relation p8b_specifically_authorized_by_state_law(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is specifically authorized by State law";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "Nothing in subparagraph (A) or paragraph (9) shall be construed to prohibit the disclosure by an officer or employee of any State of any copy of any portion of a Federal return or any information on a Federal return which is required to be attached")
rule S6103P8BStateOfficerDisclosureOfAttachedFederalReturnCopyDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, OtherOfficerOrEmployeeOfStateOrPoliticalSubdivision)
        and p8b_state_internal_scope(d)
        and p8b_specifically_authorized_by_state_law(d);
    then disclosure_permitted(d);
}

pub relation p9_agency_requires_contractor_safeguards(d: Disclosure) kind empirical {
    label en unofficial "case fact: the agency has requirements in effect which require each contractor or other agent with access to returns or return information to provide safeguards (within the meaning of paragraph (4)) to protect their confidentiality — (A)";
}

pub relation p9_agency_agrees_to_conduct_review_every_3_years(d: Disclosure) kind empirical {
    label en unofficial "case fact: the agency agrees to conduct an on-site review every 3 years (or a mid-point review for contracts or agreements of less than 3 years) of each contractor or other agent to determine compliance — (B)";
}

pub relation p9_agency_submits_findings_of_most_recent_review(d: Disclosure) kind empirical {
    label en unofficial "case fact: the agency submits the findings of the most recent review to the Secretary as part of the report required by paragraph (4)(E) — (C)";
}

pub relation p9_agency_certifies_annual_compliance_of_agents(d: Disclosure) kind empirical {
    label en unofficial "case fact: the agency certifies to the Secretary for the most recent annual period that each contractor or other agent is in compliance with all such requirements, the certification including the name and address of each contractor or other agent, a description of the contract or agreement, and its duration — (D) and the following sentence";
}

external judgment relation secretary_is_satisfied_agency_meets_p9_conditions(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary is satisfied that the agency meets the conditions of section 6103(p)(9)(A)-(D) (\"to the satisfaction of the Secretary\")";
}

pub relation p9_disclosure_to_contractor_or_agent_of_agency(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information is disclosed to a contractor or other agent of a Federal, State, tribal, or local agency";
}

pub relation p9_disclosure_pursuant_to_subsection_n_for_federal_tax_administration(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is pursuant to subsection (n) for purposes of Federal tax administration (the requirements of paragraph (9) do not apply) — section 6103(p)(9), last sentence";
}

pub relation p9_disclosed_without_agency_meeting_conditions(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return or return information was disclosed to the contractor or agent although the agency did not, to the satisfaction of the Secretary, meet the conditions";
}

pub relation p9_agency_conditions_met(d: Disclosure) kind institutional {
    label en unofficial "the agency meets, to the satisfaction of the Secretary, the conditions of section 6103(p)(9)(A)-(D)";
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(A) has requirements in effect which require each such contractor or other agent which would have access to returns or return information to provide safeguards (within the meaning of paragraph (4)) to protect the confidentiality of such returns or")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(B) agrees to conduct an on-site review every 3 years (or a mid-point review in the case of contracts or agreements of less than 3 years in duration) of each contractor or other agent to determine compliance with such requirements,")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(C) submits the findings of the most recent review conducted under subparagraph (B) to the Secretary as part of the report required by paragraph (4)(E), and")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "(D) certifies to the Secretary for the most recent annual period that such contractor or other agent is in compliance with all such requirements.")
rule S6103P9ConditionsMetClassification strict {
    for d: Disclosure;
    when p9_agency_requires_contractor_safeguards(d)
        and p9_agency_agrees_to_conduct_review_every_3_years(d)
        and p9_agency_submits_findings_of_most_recent_review(d)
        and p9_agency_certifies_annual_compliance_of_agents(d)
        and secretary_is_satisfied_agency_meets_p9_conditions(d);
    then p9_agency_conditions_met(d);
}

@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "Notwithstanding any other provision of this section, no return or return information shall be disclosed to any contractor or other agent of a Federal, State, tribal, or local agency unless such agency, to the satisfaction of the Secretary—")
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "The certification required by subparagraph (D) shall include the name and address of each contractor or other agent, a description of the contract or agreement with such contractor or other agent, and the duration of such contract or agreement. The")
rule S6103P9ContractorBarRule defeasible {
    for d: Disclosure;
    for discloser: Person;
    when disclosure_by(d, discloser)
        and p9_disclosure_to_contractor_or_agent_of_agency(d);
    then prohibition S6103P9ContractorBar {
        bearer discloser;
        action p9_disclosed_without_agency_meeting_conditions(d);
        window [-infinity, infinity];
    };
    unless p9_agency_conditions_met(d)
        and disclosure_by(d, discloser);
    unless p9_disclosure_pursuant_to_subsection_n_for_federal_tax_administration(d)
        and disclosure_by(d, discloser);
}

// --- §6103(p)(1): regulation reader (IRC-G/G4, CFR wiring 27.09.2026) -------
// "in such manner and at such time and place as shall be prescribed by the
// Secretary": the manner/time/place leg is 26 CFR 601.702 and the Statement
// of Procedural Rules, pinned phase-0 as us.cfr.t26_601_702 — addressable,
// rule-less, not yet a dependency (registry/lock gap, cfr-wire STATUS). The
// case-selected relation below names the prescribed manner/time/place as
// applied; the rule derives the (p)(1) compliance status. Citation check
// 27.09.2026: the row's note names exactly 601.702 + Statement of Procedural
// Rules, so 601.702 is the right section (no skip). Coverage row
// 26/6103/p/1/u1 stays EXTERNAL_DEPENDENCY (flip only after execution,
// owner gate step 6).

relation request_or_inspection_in_secretary_prescribed_manner_6103p1(d: Disclosure) kind empirical {
    label en unofficial "case fact: the request for inspection or disclosure (and the inspection or disclosure itself) follows the manner, time and place prescribed by the Secretary (case-selected: the 26 CFR 601.702 content enters as case facts)";
}
pub relation inspection_or_disclosure_in_prescribed_manner_time_place_6103p1(d: Disclosure) kind institutional {
    label en unofficial "the inspection or disclosure satisfies section 6103(p)(1): made in the prescribed manner, time and place";
}
@source(IRC_S6103_P, relation = formalizes, coverage = partial, quote = "Requests for the inspection or disclosure of a return or return information and such inspection or disclosure shall be made in such manner and at such time and place as shall be prescribed by the Secretary.")
rule S6103P1MannerTimePlaceBySecretary(d: Disclosure) strict {
    label en unofficial "section 6103(p)(1): the Secretary-prescribed manner, time and place govern the request and the inspection or disclosure";
    when request_or_inspection_in_secretary_prescribed_manner_6103p1(d);
    then inspection_or_disclosure_in_prescribed_manner_time_place_6103p1(d);
}
