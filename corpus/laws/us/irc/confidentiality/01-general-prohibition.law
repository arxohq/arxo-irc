// 26 U.S.C. §6103(a) — General rule: confidentiality and the prohibition
// on disclosure. STAGE 1 FULL. The prohibition is modeled per E-0179: an
// established disclosure (`disclosure_by`) by a `covered_person` (module
// 00) of `return_information` (module 00) is itself the violating action,
// unless a named exception classifies the disclosure as
// `disclosure_permitted` — the aggregator every exception module (02-08)
// contributes to with its own rule(s) concluding the same head.
//
// `pub relation disclosure_permitted(d: Disclosure)` and
// `pub relation unauthorized_disclosure(d: Disclosure)` are this package's
// public interface for consumers: `judicial-proceedings` (§7431 civil
// damages for unauthorized disclosure) imports `unauthorized_disclosure`
// directly instead of re-deriving the prohibition (see HANDOFF.md and
// coverage row 26/6103/a/u1 for the publication).

// ---------------------------------------------------------------------
// Case facts describing a Disclosure
// ---------------------------------------------------------------------

use self::{
    Disclosure,
    IRC_S6103_A,
    Person,
    ReturnInformation,
    covered_person,
    return_information,
};

pub relation disclosure_by(d: Disclosure, discloser: Person) kind empirical {
    label en unofficial "case fact: the disclosure d was made by this person";
}
pub relation disclosure_to(d: Disclosure, recipient: Person) kind empirical {
    label en unofficial "case fact: the disclosure d was made to this recipient";
}
pub relation disclosure_of(d: Disclosure, info: ReturnInformation) kind empirical {
    label en unofficial "case fact: the disclosure d discloses this item of return information";
}
pub relation disclosure_on(d: Disclosure, on: Date) kind empirical {
    label en unofficial "case fact: the date the disclosure d was made";
}

// ---------------------------------------------------------------------
// The aggregator: every named exception (modules 02-08) contributes a
// rule concluding this same head for a Disclosure it classifies as
// permitted. Declared here with no rule of its own so that a Disclosure
// with no exception asserted simply never derives it (fixpoint absence,
// not a negative fact) — `not_known` below reads that absence directly.
// ---------------------------------------------------------------------

pub relation disclosure_permitted(d: Disclosure) kind institutional {
    label en unofficial "the disclosure d is authorized by one of the section 6103(c)-(q)/section 6104(c)/section 6105(b) exceptions this package models (aggregator; see modules 02-08)";
}

// ---------------------------------------------------------------------
// (a) The prohibition itself
// ---------------------------------------------------------------------

@source(IRC_S6103_A, relation = formalizes, coverage = exact, quote = "Returns and return information shall be confidential, and except as authorized by this title")
@source(IRC_S6103_A, relation = formalizes, coverage = exact, quote = "shall disclose any return or return information obtained by him in any manner in connection with his service as such an officer or an employee or otherwise or under the provisions of this section.")
rule S6103AConfidentialityProhibition defeasible {
    for d: Disclosure;
    for discloser: Person;
    for recipient: Person;
    for info: ReturnInformation;
    when disclosure_by(d, discloser)
        and disclosure_to(d, recipient)
        and disclosure_of(d, info)
        and covered_person(discloser)
        and return_information(info);
    then prohibition S6103AProhibition {
        bearer discloser;
        action disclosure_by(d, discloser);
        window [-infinity, infinity];
    };
    unless disclosure_permitted(d)
        and disclosure_by(d, discloser)
        and disclosure_to(d, recipient)
        and disclosure_of(d, info)
        and covered_person(discloser)
        and return_information(info);
}

// ---------------------------------------------------------------------
// Public classification for consumers (judicial-proceedings §7431)
// ---------------------------------------------------------------------

pub relation unauthorized_disclosure(d: Disclosure) kind institutional {
    label en unofficial "the disclosure d was made by a covered person, of return information, with no section 6103(a)-exception classifying it as permitted — the section 6103(a) violation `judicial-proceedings` reads for section 7431 civil damages";
}
@source(IRC_S6103_A, relation = formalizes, coverage = exact, quote = "shall disclose any return or return information obtained by him in any manner in connection with his service as such an officer or an employee or otherwise or under the provisions of this section.")
rule S6103AUnauthorizedDisclosureClassification defeasible {
    for d: Disclosure;
    for discloser: Person;
    for recipient: Person;
    for info: ReturnInformation;
    when disclosure_by(d, discloser)
        and disclosure_to(d, recipient)
        and disclosure_of(d, info)
        and covered_person(discloser)
        and return_information(info)
        and not_known(disclosure_permitted(d));
    then unauthorized_disclosure(d);
}
