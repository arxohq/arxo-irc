// 26 U.S.C. §6104(d) — Public inspection of certain annual returns,
// reports, applications for exemption, and notices of status. STAGE 1
// FULL for the (d)(1) duty (in-person/immediate vs. written/30-day
// windows), (d)(2) 3-year limitation (as a case fact, not a computed
// due-date-plus-extension test — see below), and (d)(4) widely-available
// exception. (d)(3) (contributor/withheld-information nondisclosure),
// (d)(5)-(8) are `unreviewed`.
//
// `exempt_organization` is NOT YET importable: `us.irc.exempt-organizations`
// (`corpus/laws/us/irc/exempt-organizations/package.law`) is still a
// package skeleton with no `pub` symbols (checked 25.09.2026). This module
// declares its own local case-fact placeholder
// (`described_501c_or_d_or_527a`) and records the pending import in
// `docs/foundations/us-irc/coverage/confidentiality.deps.json`.
//
// JUDGMENT CALL: (d)(2)'s "3-year period beginning on the last day
// prescribed for filing ... (determined with regard to any extension of
// time for filing)" is modeled as a single empirical case fact
// (`annual_return_in_3_year_window`) rather than a computed comparison
// against section 6072/6081 due dates and extensions (owned by
// `information-reporting`/`administration`) — this package does not
// re-derive another owner's due-date computation for a boundary test.

use self::{
    IRC_S6104_D,
    Person,
};

pub relation described_501c_or_d_or_527a(org: Person) kind empirical {
    label en unofficial "case fact: the organization is described in section 501(c) or (d) and exempt under section 501(a), or is a political organization exempt under section 527(a) — pending import of `us.irc.exempt_organizations::exempt_organization` once that package publishes it";
}

pub relation annual_return_in_3_year_window(org: Person) kind empirical {
    label en unofficial "case fact: the annual return sought is within the section 6104(d)(2) 3-year period beginning on the last day prescribed for filing it (determined with regard to any extension of time for filing)";
}

pub relation widely_available(org: Person) kind empirical {
    label en unofficial "case fact: in accordance with Secretary regulations, the organization has made the requested documents widely available — section 6104(d)(4)";
}
external judgment relation secretary_determines_harassment_campaign(org: Person) {
    authority Secretary;
    label en official "the Secretary determines, upon the organization's application, that the request is part of a harassment campaign and that compliance is not in the public interest — section 6104(d)(4)";
}

pub relation copy_request_made(org: Person, requester: Person, madeOn: Date) kind empirical {
    label en unofficial "case fact: the individual requested a copy of the annual return, exempt status application materials, or notice materials, at the organization's principal (or a qualifying regional/district) office — section 6104(d)(1)(B)";
}
pub relation copy_request_in_person(org: Person, requester: Person) kind empirical {
    label en unofficial "case fact: the (d)(1)(B) request was made in person (as opposed to in writing)";
}
pub relation copy_provided_on(org: Person, requester: Person, providedOn: Date) kind empirical {
    label en unofficial "case fact: the organization provided the requested copy on this date";
}

pub relation copy_response_due(org: Person, requester: Person, due: Date) kind institutional {
    label en unofficial "the section 6104(d)(1) deadline for providing the requested copy: the same day if the request was made in person (\"provided immediately\"), or within 30 days if made in writing";
}
@source(IRC_S6104_D, relation = formalizes, coverage = exact, quote = "If such request is made in person, such copy shall be provided immediately")
rule S6104D1InPersonDeadline strict {
    for org: Person;
    for requester: Person;
    for madeOn: Date;
    when copy_request_made(org, requester, madeOn) and copy_request_in_person(org, requester);
    then copy_response_due(org, requester, madeOn);
}
@source(IRC_S6104_D, relation = formalizes, coverage = exact, quote = "and, if made in writing, shall be provided within 30 days.")
rule S6104D1WrittenDeadline strict {
    for org: Person;
    for requester: Person;
    for madeOn: Date;
    when copy_request_made(org, requester, madeOn) and not_known(copy_request_in_person(org, requester));
    then copy_response_due(org, requester, add_calendar_period(madeOn, 30 calendar_day));
}

pub relation copy_provided_timely(org: Person, requester: Person) kind institutional {
    label en unofficial "the organization provided the requested copy on or before the section 6104(d)(1) deadline";
}
rule S6104D1TimelyClassification strict {
    for org: Person;
    for requester: Person;
    for due: Date;
    for providedOn: Date;
    when copy_response_due(org, requester, due)
        and copy_provided_on(org, requester, providedOn)
        and providedOn <= due;
    then copy_provided_timely(org, requester);
}

pub relation public_inspection_required(org: Person) kind institutional {
    label en unofficial "the organization is under the section 6104(d)(1)(A) duty to make its annual return, section 6033/6011(511)/501/527 application and notice materials, and section 527(j) reports available for inspection at its offices";
}
@source(IRC_S6104_D, relation = formalizes, coverage = partial, quote = "shall be made available by such organization for inspection during regular business hours by any individual at the principal office of such organization")
rule S6104D1InspectionDutyClassification strict {
    for org: Person;
    when described_501c_or_d_or_527a(org) and annual_return_in_3_year_window(org);
    then public_inspection_required(org);
}

@source(IRC_S6104_D, relation = formalizes, coverage = exact, quote = "upon request of an individual made at such principal office or such a regional or district office, a copy of such annual return, reports, and exempt status application materials or such notice materials shall be provided to such individual without charge other than a reasonable fee for any reproduction and mailing costs.")
rule S6104D1BCopyDutyRule defeasible {
    for org: Person;
    for requester: Person;
    for madeOn: Date;
    when public_inspection_required(org)
        and copy_request_made(org, requester, madeOn);
    then duty S6104D1BCopyDuty {
        bearer org;
        beneficiary requester;
        goal achievement {
            condition copy_provided_timely(org, requester);
            window [-infinity, infinity];
        }
    };
    unless widely_available(org) and public_inspection_required(org) and copy_request_made(org, requester, madeOn);
    unless secretary_determines_harassment_campaign(org) and public_inspection_required(org) and copy_request_made(org, requester, madeOn);
}
