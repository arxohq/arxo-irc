// 26 U.S.C. §6103(e)(1)(A)(ii)-(F), (e)(2)-(6), (e)(8)-(11) — the remainder of the
// material-interest exception. STAGE 2. Each class of person of section 6103(e) is a
// permission (a defeater of the section 6103(a) prohibition through `disclosure_permitted`);
// the two "shall disclose" paragraphs, (e)(8) and (e)(9), are duties of the Secretary
// with the requester as beneficiary; (e)(10) is a prohibition on the content of the
// disclosure. "Only if the Secretary finds ... a material interest" is a positive
// condition read from an external judgment relation (DECISION-0194), not a case fact.
// Facts reuse the stage-1 vocabulary of module 03 (`return_of_individual`,
// `return_of_corporation`, `written_request_for_inspection`, `about_taxpayer`).

use self::{
    Corporation,
    Disclosure,
    Estate,
    IRC_S6103_E,
    Individual,
    Partnership,
    Person,
    Recipient,
    ReturnInformation,
    Secretary,
    Trust,
    about_taxpayer,
    disclosure_by,
    disclosure_of,
    disclosure_permitted,
    disclosure_to,
    joint_return_of,
    recipient_is,
    return_of_corporation,
    return_of_individual,
    written_request_for_inspection,
};

pub relation gift_splitting_consent_signified(individual: Individual, spouse: Individual) kind empirical {
    label en unofficial "case fact: the individual and the spouse have signified their consent to consider a gift reported on the return as made one-half by him and one-half by the spouse under section 2513";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(ii) the spouse of that individual if the individual and such spouse have signified their consent to consider a gift reported on such return as made one-half by him and one-half by the spouse pursuant to the provisions of section 2513; or")
rule S6103E1AiiGiftSplittingSpouseDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for individual: Individual;
    for spouse: Individual;
    when disclosure_of(d, info)
        and disclosure_to(d, spouse)
        and return_of_individual(info, individual)
        and gift_splitting_consent_signified(individual, spouse)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation child_or_legal_representative_of(recipient: Person, parent: Individual) kind empirical {
    label en unofficial "case fact: the recipient is the child of the individual, or the child's legal representative — section 6103(e)(1)(A)(iii)";
}

pub relation disclosure_necessary_to_comply_with_1g(d: Disclosure) kind empirical {
    label en unofficial "case fact: the inspection or disclosure is to the extent necessary to comply with the provisions of section 1(g) (kiddie tax)";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(iii) the child of that individual (or such child's legal representative) to the extent necessary to comply with the provisions of section 1(g);")
rule S6103E1AiiiChildDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for parent: Individual;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_individual(info, parent)
        and child_or_legal_representative_of(recipient, parent)
        and disclosure_necessary_to_comply_with_1g(d)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation return_of_partnership(info: ReturnInformation, partnership: Partnership) kind empirical {
    label en unofficial "case fact: the return information is the return of this partnership — section 6103(e)(1)(C)";
}

pub relation member_of_partnership_during_period_covered(member: Person, partnership: Partnership) kind empirical {
    label en unofficial "case fact: the person was a member of the partnership during any part of the period covered by the return";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(C) in the case of the return of a partnership, any person who was a member of such partnership during any part of the period covered by the return;")
rule S6103E1CPartnerDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for partnership: Partnership;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_partnership(info, partnership)
        and member_of_partnership_during_period_covered(recipient, partnership)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation designated_by_board_resolution(recipient: Person, corp: Corporation) kind empirical {
    label en unofficial "case fact: the recipient is a person designated by resolution of the corporation's board of directors or other similar governing body — section 6103(e)(1)(D)(i)";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(i) any person designated by resolution of its board of directors or other similar governing body,")
rule S6103E1DiBoardDesigneeDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for corp: Corporation;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_corporation(info, corp)
        and designated_by_board_resolution(recipient, corp)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation officer_or_employee_of_corporation(recipient: Person, corp: Corporation) kind empirical {
    label en unofficial "case fact: the recipient is an officer or employee of the corporation — section 6103(e)(1)(D)(ii)";
}

pub relation request_signed_by_principal_officer_and_attested(d: Disclosure) kind empirical {
    label en unofficial "case fact: the written request is signed by a principal officer of the corporation and attested by the secretary or another officer";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(ii) any officer or employee of such corporation upon written request signed by any principal officer and attested to by the secretary or other officer,")
rule S6103E1DiiOfficerOrEmployeeDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for corp: Corporation;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_corporation(info, corp)
        and officer_or_employee_of_corporation(recipient, corp)
        and written_request_for_inspection(d)
        and request_signed_by_principal_officer_and_attested(d);
    then disclosure_permitted(d);
}

pub relation shareholder_during_s_election_period_covered(recipient: Person, corp: Corporation) kind empirical {
    label en unofficial "case fact: the corporation was an S corporation and the recipient was a shareholder during any part of the period covered by the return during which an election under section 1362(a) was in effect — section 6103(e)(1)(D)(iv)";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(iv) if the corporation was an S corporation, any person who was a shareholder during any part of the period covered by such return during which an election under section 1362(a) was in effect, or")
rule S6103E1DivSCorporationShareholderDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for corp: Corporation;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_corporation(info, corp)
        and shareholder_during_s_election_period_covered(recipient, corp)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation corporation_dissolved(corp: Corporation) kind empirical {
    label en unofficial "case fact: the corporation has been dissolved — section 6103(e)(1)(D)(v)";
}

pub relation authorized_by_state_law_to_act_for_corporation(recipient: Person, corp: Corporation) kind empirical {
    label en unofficial "case fact: the recipient is authorized by applicable State law to act for the dissolved corporation";
}

external judgment relation secretary_finds_recipient_has_material_interest_affected(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary finds that the recipient has a material interest which will be affected by information contained in the return — section 6103(e)(1)(D)(v), (E)(ii), (F)(ii), (3)(B), (4)";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(v) if the corporation has been dissolved, any person authorized by applicable State law to act for the corporation or any person who the Secretary finds to have a material interest which will be affected by information contained therein;")
rule S6103E1DvDissolvedCorporationDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for corp: Corporation;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_corporation(info, corp)
        and corporation_dissolved(corp)
        and written_request_for_inspection(d)
        and authorized_by_state_law_to_act_for_corporation(recipient, corp);
    then disclosure_permitted(d);
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(v) if the corporation has been dissolved, any person authorized by applicable State law to act for the corporation or any person who the Secretary finds to have a material interest which will be affected by information contained therein;")
rule S6103E1DvDissolvedCorporationMaterialInterestDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for corp: Corporation;
    when disclosure_of(d, info)
        and return_of_corporation(info, corp)
        and corporation_dissolved(corp)
        and written_request_for_inspection(d)
        and secretary_finds_recipient_has_material_interest_affected(d);
    then disclosure_permitted(d);
}

pub relation return_of_estate(info: ReturnInformation, estate: Estate) kind empirical {
    label en unofficial "case fact: the return information is the return of this estate — section 6103(e)(1)(E)";
}

pub relation administrator_executor_or_trustee_of_estate(recipient: Person, estate: Estate) kind empirical {
    label en unofficial "case fact: the recipient is the administrator, executor, or trustee of the estate";
}

pub relation heir_next_of_kin_or_beneficiary_of_decedent_of_estate(recipient: Person, estate: Estate) kind empirical {
    label en unofficial "case fact: the recipient is an heir at law, next of kin, or beneficiary under the will of the decedent whose estate made the return";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(i) the administrator, executor, or trustee of such estate, and")
rule S6103E1EiFiduciaryDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for estate: Estate;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_estate(info, estate)
        and administrator_executor_or_trustee_of_estate(recipient, estate)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(ii) any heir at law, next of kin, or beneficiary under the will, of the decedent, but only if the Secretary finds that such heir at law, next of kin, or beneficiary has a material interest which will be affected by information contained therein; and")
rule S6103E1EiiHeirDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for estate: Estate;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_estate(info, estate)
        and heir_next_of_kin_or_beneficiary_of_decedent_of_estate(recipient, estate)
        and written_request_for_inspection(d)
        and secretary_finds_recipient_has_material_interest_affected(d);
    then disclosure_permitted(d);
}

pub relation return_of_trust(info: ReturnInformation, trust: Trust) kind empirical {
    label en unofficial "case fact: the return information is the return of this trust — section 6103(e)(1)(F)";
}

pub relation trustee_of_trust(recipient: Person, trust: Trust) kind empirical {
    label en unofficial "case fact: the recipient is a trustee of the trust (jointly or separately)";
}

pub relation beneficiary_of_trust(recipient: Person, trust: Trust) kind empirical {
    label en unofficial "case fact: the recipient is a beneficiary of the trust";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(i) the trustee or trustees, jointly or separately, and")
rule S6103E1FiTrusteeDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for trust: Trust;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_trust(info, trust)
        and trustee_of_trust(recipient, trust)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(ii) any beneficiary of such trust, but only if the Secretary finds that such beneficiary has a material interest which will be affected by information contained therein.")
rule S6103E1FiiBeneficiaryDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for trust: Trust;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_trust(info, trust)
        and beneficiary_of_trust(recipient, trust)
        and written_request_for_inspection(d)
        and secretary_finds_recipient_has_material_interest_affected(d);
    then disclosure_permitted(d);
}

pub relation legally_incompetent_individual(individual: Individual) kind empirical {
    label en unofficial "case fact: the individual described in paragraph (1) is legally incompetent — section 6103(e)(2)";
}

pub relation committee_trustee_or_guardian_of_estate_of(recipient: Person, individual: Individual) kind empirical {
    label en unofficial "case fact: the recipient is the committee, trustee, or guardian of the individual's estate";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "If an individual described in paragraph (1) is legally incompetent, the applicable return shall, upon written request, be open to inspection by or disclosure to the committee, trustee, or guardian of his estate.")
rule S6103E2IncompetentIndividualDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for individual: Individual;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_individual(info, individual)
        and legally_incompetent_individual(individual)
        and committee_trustee_or_guardian_of_estate_of(recipient, individual)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation return_of_decedent(info: ReturnInformation, decedent: Individual) kind empirical {
    label en unofficial "case fact: the return information is the return of this decedent — section 6103(e)(3)";
}

pub relation administrator_executor_or_trustee_of_estate_of_decedent(recipient: Person, decedent: Individual) kind empirical {
    label en unofficial "case fact: the recipient is the administrator, executor, or trustee of the decedent's estate";
}

pub relation heir_next_of_kin_beneficiary_or_donee_of_decedent(recipient: Person, decedent: Individual) kind empirical {
    label en unofficial "case fact: the recipient is an heir at law, next of kin, or beneficiary under the will of the decedent, or a donee of property";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(A) the administrator, executor, or trustee of his estate, and")
rule S6103E3ADecedentFiduciaryDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for decedent: Individual;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_decedent(info, decedent)
        and administrator_executor_or_trustee_of_estate_of_decedent(recipient, decedent)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(B) any heir at law, next of kin, or beneficiary under the will, of such decedent, or a donee of property, but only if the Secretary finds that such heir at law, next of kin, beneficiary, or donee has a material interest which will be affected by")
rule S6103E3BDecedentHeirDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for decedent: Individual;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and return_of_decedent(info, decedent)
        and heir_next_of_kin_beneficiary_or_donee_of_decedent(recipient, decedent)
        and written_request_for_inspection(d)
        and secretary_finds_recipient_has_material_interest_affected(d);
    then disclosure_permitted(d);
}

pub relation title_11_trustee_of_debtor_who_filed_the_return(recipient: Person, debtor: Person) kind empirical {
    label en unofficial "case fact: the recipient is a trustee in a title 11 case in which the debtor is the person with respect to whom the return is filed — section 6103(e)(4)(A)";
}

pub relation receiver_of_substantially_all_property_of(recipient: Person, debtor: Person) kind empirical {
    label en unofficial "case fact: substantially all of the property of the person with respect to whom the return is filed is in the hands of the recipient as receiver — section 6103(e)(4)(B)";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(A) there is a trustee in a title 11 case in which the debtor is the person with respect to whom the return is filed, or")
@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "such return or returns for prior years of such person shall, upon written request, be open to inspection by or disclosure to such trustee or receiver, but only if the Secretary finds that such trustee or receiver, in his fiduciary capacity, has a")
rule S6103E4TrusteeDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for debtor: Person;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and about_taxpayer(info, debtor)
        and title_11_trustee_of_debtor_who_filed_the_return(recipient, debtor)
        and written_request_for_inspection(d)
        and secretary_finds_recipient_has_material_interest_affected(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(B) substantially all of the property of the person with respect to whom the return is filed is in the hands of a receiver,")
@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "such return or returns for prior years of such person shall, upon written request, be open to inspection by or disclosure to such trustee or receiver, but only if the Secretary finds that such trustee or receiver, in his fiduciary capacity, has a")
rule S6103E4ReceiverDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for debtor: Person;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and about_taxpayer(info, debtor)
        and receiver_of_substantially_all_property_of(recipient, debtor)
        and written_request_for_inspection(d)
        and secretary_finds_recipient_has_material_interest_affected(d);
    then disclosure_permitted(d);
}

pub relation section_1398_case_debtor(debtor: Person) kind empirical {
    label en unofficial "case fact: section 1398 applies to the debtor (determined without regard to section 1398(b)(1)) — section 6103(e)(5)(A)";
}

pub relation trustee_in_section_1398_case(recipient: Person, debtor: Person) kind empirical {
    label en unofficial "case fact: the recipient is the trustee in the section 1398 case of the debtor";
}

pub relation return_year_is_case_year_or_preceding(info: ReturnInformation) kind empirical {
    label en unofficial "case fact: the return is for the taxable year in which the case commenced or any preceding taxable year";
}

pub relation section_1398_estate_return_of_debtor(info: ReturnInformation, debtor: Person) kind empirical {
    label en unofficial "case fact: the return information is a return of an estate in a case to which section 1398 applies, and the debtor is the debtor in that case — section 6103(e)(5)(B)";
}

pub relation involuntary_case_before_order_for_relief(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is in an involuntary case and the order for relief has not yet been entered by the court having jurisdiction — section 6103(e)(5)(C)";
}

pub relation court_finds_disclosure_appropriate_for_relief_determination(d: Disclosure) kind empirical {
    label en unofficial "case fact: the court finds the disclosure appropriate for purposes of determining whether an order for relief should be entered";
}

pub relation involuntary_case_disclosure_barred(d: Disclosure) kind institutional {
    label en unofficial "the disclosure to a trustee in an involuntary case is barred by section 6103(e)(5)(C): no order for relief has been entered and the court has not found the disclosure appropriate";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "In an involuntary case, no disclosure shall be made under subparagraph (A) until the order for relief has been entered by the court having jurisdiction of such case unless such court finds that such disclosure is appropriate for purposes of determining whether an order for relief should be entered.")
rule S6103E5CInvoluntaryCaseBarClassification strict {
    for d: Disclosure;
    when involuntary_case_before_order_for_relief(d)
        and not_known(court_finds_disclosure_appropriate_for_relief_determination(d));
    then involuntary_case_disclosure_barred(d);
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "In any case to which section 1398 applies (determined without regard to section 1398(b)(1)), any return of the debtor for the taxable year in which the case commenced or any preceding taxable year shall, upon written request, be open to inspection")
rule S6103E5ATrusteeDisclosurePermitted defeasible {
    for d: Disclosure;
    for info: ReturnInformation;
    for debtor: Person;
    for recipient: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and about_taxpayer(info, debtor)
        and section_1398_case_debtor(debtor)
        and trustee_in_section_1398_case(recipient, debtor)
        and return_year_is_case_year_or_preceding(info)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
    unless involuntary_case_disclosure_barred(d)
        and disclosure_of(d, info)
        and disclosure_to(d, recipient)
        and about_taxpayer(info, debtor);
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "Any return of an estate in a case to which section 1398 applies shall, upon written request, be open to inspection by or disclosure to the debtor in such case.")
rule S6103E5BEstateReturnToDebtorDisclosurePermitted strict {
    for d: Disclosure;
    for info: ReturnInformation;
    for debtor: Person;
    when disclosure_of(d, info)
        and disclosure_to(d, debtor)
        and section_1398_estate_return_of_debtor(info, debtor)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation attorney_in_fact_authorized_in_writing_by_principal(d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient is the attorney in fact duly authorized in writing to inspect the return or receive the information on behalf of a person described in paragraph (1), (2), (3), (4), (5), (8), or (9) — section 6103(e)(6)";
}

pub relation principal_meets_the_conditions_of_the_e_paragraph(d: Disclosure) kind empirical {
    label en unofficial "case fact: the principal would himself meet the conditions the applicable paragraph of subsection (e) provides (written request, Secretary findings), as (e)(6) makes the attorney in fact's access subject to those conditions";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "Any return to which this subsection applies shall, upon written request, also be open to inspection by or disclosure to the attorney in fact duly authorized in writing by any of the persons described in paragraph (1), (2), (3), (4), (5), (8), or (9)")
rule S6103E6AttorneyInFactDisclosurePermitted strict {
    for d: Disclosure;
    when attorney_in_fact_authorized_in_writing_by_principal(d)
        and principal_meets_the_conditions_of_the_e_paragraph(d)
        and written_request_for_inspection(d);
    then disclosure_permitted(d);
}

pub relation deficiency_assessed_on_joint_return(info: ReturnInformation) kind empirical {
    label en unofficial "case fact: a deficiency of tax with respect to the joint return has been assessed — section 6103(e)(8)";
}

pub relation joint_filers_no_longer_married_or_same_household(spouseOne: Individual, spouseTwo: Individual) kind empirical {
    label en unofficial "case fact: the individuals filing the joint return are no longer married or no longer reside in the same household";
}

pub relation written_request_by_individual(d: Disclosure, requester: Person) kind empirical {
    label en unofficial "case fact: the request for the disclosure d was made in writing by this person";
}

pub relation collection_activities_disclosed_in_writing(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary disclosed in writing whether it attempted to collect, the general nature of the collection activities, and the amount collected";
}

pub relation deficiency_uncollectible_by_reason_of_6502(info: ReturnInformation) kind empirical {
    label en unofficial "case fact: the deficiency may not be collected by reason of section 6502 (expiration of the collection period); pending import from the collection owner";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "If any deficiency of tax with respect to a joint return is assessed and the individuals filing such return are no longer married or no longer reside in the same household, upon request in writing by either of such individuals, the Secretary shall disclose in writing to the individual making the request whether the Secretary has attempted to collect such deficiency from such")
rule S6103E8CollectionActivitiesDutyRule defeasible {
    for d: Disclosure;
    for info: ReturnInformation;
    for spouseOne: Individual;
    for spouseTwo: Individual;
    for requester: Individual;
    when joint_return_of(info, spouseOne, spouseTwo)
        and deficiency_assessed_on_joint_return(info)
        and joint_filers_no_longer_married_or_same_household(spouseOne, spouseTwo)
        and disclosure_of(d, info)
        and disclosure_to(d, requester)
        and (requester == spouseOne or requester == spouseTwo)
        and written_request_by_individual(d, requester);
    then duty S6103E8CollectionActivitiesDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition collection_activities_disclosed_in_writing(d);
            window [-infinity, infinity];
        }
    };
    unless deficiency_uncollectible_by_reason_of_6502(info)
        and joint_return_of(info, spouseOne, spouseTwo)
        and disclosure_of(d, info)
        and disclosure_to(d, requester)
        and written_request_by_individual(d, requester);
}

pub relation secretary_determined_liable_for_6672_penalty(person: Person) kind empirical {
    label en unofficial "case fact: the Secretary has determined that the person is liable for a penalty under section 6672(a) with respect to a failure — section 6103(e)(9)";
}

pub relation other_person_determined_liable_for_same_failure(person: Person, other: Person) kind empirical {
    label en unofficial "case fact: the Secretary has determined the other person liable for the same section 6672(a) penalty with respect to the same failure";
}

pub relation co_liable_persons_and_collection_status_disclosed_in_writing(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary disclosed in writing the name of each other person determined liable and whether it attempted to collect from that person, the general nature of the collection activities, and the amount collected";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "If the Secretary determines that a person is liable for a penalty under section 6672(a) with respect to any failure, upon request in writing of such person, the Secretary shall disclose in writing to such person—")
@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(A) the name of any other person whom the Secretary has determined to be liable for such penalty with respect to such failure, and")
@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "(B) whether the Secretary has attempted to collect such penalty from such other person, the general nature of such collection activities, and the amount collected.")
rule S6103E9CoLiablePersonsDutyRule strict {
    for d: Disclosure;
    for requester: Person;
    for other: Person;
    when secretary_determined_liable_for_6672_penalty(requester)
        and other_person_determined_liable_for_same_failure(requester, other)
        and disclosure_to(d, requester)
        and written_request_by_individual(d, requester);
    then duty S6103E9CoLiablePersonsDuty {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition co_liable_persons_and_collection_status_disclosed_in_writing(d);
            window [-infinity, infinity];
        }
    };
}

pub relation e_return_of_partnership_s_corporation_trust_or_estate(d: Disclosure) kind empirical {
    label en unofficial "case fact: the inspection or disclosure under subsection (e) relates to the return of a partnership, S corporation, trust, or an estate — section 6103(e)(10)";
}

pub relation disclosure_includes_schedule_with_third_party_identity(d: Disclosure) kind empirical {
    label en unofficial "case fact: the information disclosed includes a supporting schedule, attachment, or list which includes the taxpayer identity information of a person other than the entity making the return or the person conducting the inspection or to whom the disclosure is made";
}

@source(IRC_S6103_E, relation = formalizes, coverage = exact, quote = "In the case of an inspection or disclosure under this subsection relating to the return of a partnership, S corporation, trust, or an estate, the information inspected or disclosed shall not include any supporting schedule, attachment, or list which includes the taxpayer identity information of a")
rule S6103E10ContentLimitRule strict {
    for d: Disclosure;
    for discloser: Person;
    when disclosure_by(d, discloser)
        and written_request_for_inspection(d)
        and e_return_of_partnership_s_corporation_trust_or_estate(d);
    then prohibition S6103E10ThirdPartySchedulesExcluded {
        bearer discloser;
        action disclosure_includes_schedule_with_third_party_identity(d);
        window [-infinity, infinity];
    };
}

pub relation e11_investigation_status_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to the person who provided information indicating a violation of section 7213, 7213A, or 7214 with respect to that person's return or return information (or that person's designee), and is limited to whether an investigation was initiated and is open or closed, whether it substantiated a violation by any individual, and whether action was taken (including referral for prosecution) — section 6103(e)(11)(A)-(C)";
}

@source(IRC_S6103_E, relation = formalizes, coverage = partial, quote = "In the case of a person who provides to the Secretary information indicating a violation of section 7213, 7213A, or 7214 with respect to any return or return information of such person, the Secretary may disclose to such person (or such person's")
rule S6103E11InvestigationStatusToInformantDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, InformantOfUnauthorizedDisclosure)
        and e11_investigation_status_scope(d);
    then disclosure_permitted(d);
}
