// 26 U.S.C. §6105 — Confidentiality of information arising under treaty
// obligations. STAGE 1 FULL for (a) the prohibition and (b)(1)-(2), (b)(4)
// exceptions; (b)(3) (disclosure on the same terms as section 6103(i)(3)
// (C)/(7)) is `unreviewed` (depends on this package's own (i) module,
// not built this stage). (c) definitions are absorbed as local case-fact
// predicates rather than separate classification rules (the "tax
// convention information"/"tax convention" terms are used only to scope
// this module's own relations). (d) is a pure cross-reference —
// NON_NORMATIVE.

use self::{
    Disclosure,
    IRC_S6105_A,
    IRC_S6105_B,
    Person,
};

pub entity TaxConventionInformation {
    label en unofficial "information within the meaning of section 6105(c)(1): an agreement, application for relief, background information, implementing document, or other exchanged information under a tax convention, treated as confidential under the convention";
}

pub relation tax_convention_disclosure_by(d: Disclosure, discloser: Person) kind empirical;
pub relation tax_convention_disclosure_of(d: Disclosure, info: TaxConventionInformation) kind empirical;
pub relation tax_convention_disclosure_to(d: Disclosure, recipient: Person) kind empirical;

pub relation tax_convention_disclosure_permitted(d: Disclosure) kind institutional {
    label en unofficial "the disclosure of tax convention information is authorized by one of the section 6105(b) exceptions";
}

@source(IRC_S6105_A, relation = formalizes, coverage = exact, quote = "Tax convention information shall not be disclosed.")
rule S6105AConfidentialityProhibition defeasible {
    for d: Disclosure;
    for discloser: Person;
    for info: TaxConventionInformation;
    when tax_convention_disclosure_by(d, discloser) and tax_convention_disclosure_of(d, info);
    then prohibition S6105AProhibition {
        bearer discloser;
        action tax_convention_disclosure_by(d, discloser);
        window [-infinity, infinity];
    };
    unless tax_convention_disclosure_permitted(d) and tax_convention_disclosure_by(d, discloser) and tax_convention_disclosure_of(d, info);
}

// (b)(1) — persons/authorities entitled by the convention itself
pub relation entitled_by_tax_convention(recipient: Person, d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient is a person or authority (including a court or administrative body) entitled to the disclosure pursuant to the tax convention itself — section 6105(b)(1)";
}
@source(IRC_S6105_B, relation = formalizes, coverage = exact, quote = "to the disclosure of tax convention information to persons or authorities (including courts and administrative bodies) which are entitled to such disclosure pursuant to a tax convention,")
rule S6105B1EntitledDisclosurePermitted strict {
    for d: Disclosure;
    for recipient: Person;
    when tax_convention_disclosure_to(d, recipient) and entitled_by_tax_convention(recipient, d);
    then tax_convention_disclosure_permitted(d);
}

// (b)(2) — generally applicable procedural rules on convention-relief applications
pub relation generally_applicable_procedural_rule_disclosure(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of a generally applicable procedural rule regarding applications for relief under a tax convention — section 6105(b)(2)";
}
@source(IRC_S6105_B, relation = formalizes, coverage = exact, quote = "to any generally applicable procedural rules regarding applications for relief under a tax convention,")
rule S6105B2ProceduralRuleDisclosurePermitted strict {
    for d: Disclosure;
    when generally_applicable_procedural_rule_disclosure(d);
    then tax_convention_disclosure_permitted(d);
}

// (b)(4) — non-taxpayer-specific disclosure, Secretary determination after consultation
pub relation not_relating_to_particular_taxpayer(info: TaxConventionInformation) kind empirical {
    label en unofficial "case fact: the tax convention information does not relate to a particular taxpayer — section 6105(b)(4)";
}
external judgment relation secretary_determines_disclosure_would_not_impair_tax_administration_treaty(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary, after consultation with each other party to the tax convention, determines that the disclosure would not impair tax administration — section 6105(b)(4)";
}
@source(IRC_S6105_B, relation = formalizes, coverage = exact, quote = "in any case not described in paragraph (1), (2), or (3), to the disclosure of any tax convention information not relating to a particular taxpayer if the Secretary determines, after consultation with each other party to the tax convention, that such disclosure would not impair tax administration.")
rule S6105B4NonTaxpayerSpecificDisclosurePermitted defeasible {
    for d: Disclosure;
    for info: TaxConventionInformation;
    when tax_convention_disclosure_of(d, info)
        and not_relating_to_particular_taxpayer(info)
        and secretary_determines_disclosure_would_not_impair_tax_administration_treaty(d);
    then tax_convention_disclosure_permitted(d);
}
