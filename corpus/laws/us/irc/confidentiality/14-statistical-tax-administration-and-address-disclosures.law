// 26 U.S.C. §6103(j) statistical use, (k) certain returns and return information for tax
// administration purposes, (m) taxpayer identity information, (n) certain other persons,
// (o) taxes under subtitles E, chapter 35 and section 4481. STAGE 2. Each paragraph is a
// permission (a defeater of the section 6103(a) prohibition) built from the shared
// vocabulary of module 09; where the text says the Secretary "shall furnish/disclose" the
// same conditions also open a duty of the Secretary (beneficiary: the requesting organ or
// person). Use limits ("for use only by ...", "solely for") on the recipient are
// prohibitions that stand while the disclosure is within the paragraph and are VIOLATED when
// the misuse is established. "The Secretary determines/deems" is an external judgment
// relation read as a positive condition (DECISION-0194). Regulations that "prescribe" the
// scope are not pinned here: the scope fact records that the disclosure is within them.

use self::{
    Disclosure,
    IRC_S6103_J,
    IRC_S6103_K,
    IRC_S6103_M,
    IRC_S6103_N,
    IRC_S6103_O,
    Organ,
    Person,
    Recipient,
    Secretary,
    disclosure_by,
    disclosure_permitted,
    disclosure_to,
    disclosure_upon_written_request,
    recipient_is,
    recipient_organ,
};

pub relation j1_commerce_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the returns (or return information reflected on them) go to officers and employees of the Bureau of the Census, and return information reflected on returns of corporations to the Bureau of Economic Analysis, as the Secretary prescribes by regulation, for the purpose of, and only to the extent necessary in, the structuring of censuses and national economic accounts and conducting related statistical activities authorized by law — section 6103(j)(1)(A)-(B)";
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Upon request in writing by the Secretary of Commerce, the Secretary shall furnish—")
rule S6103J1CommerceCensusAndEconomicAnalysisDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, CensusBureauOrBureauOfEconomicAnalysis)
        and disclosure_upon_written_request(d)
        and j1_commerce_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Upon request in writing by the Secretary of Commerce, the Secretary shall furnish—")
rule S6103J1CommerceFurnishDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, CensusBureauOrBureauOfEconomicAnalysis)
        and disclosure_upon_written_request(d)
        and j1_commerce_scope(d)
        and recipient_organ(d, organ);
    then duty S6103J1CommerceFurnishDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation j2_ftc_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the return information reflected on a corporation's return with respect to the chapter 1 tax goes to officers and employees of the Division of Financial Statistics of the Bureau of Economics of the Federal Trade Commission as the Secretary prescribes by regulation, for the purpose of, and only to the extent necessary in, administration by that division of legally authorized economic surveys of corporations — section 6103(j)(2)";
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Upon request in writing by the Chairman of the Federal Trade Commission, the Secretary shall furnish such return information reflected on any return of a corporation with respect")
rule S6103J2FederalTradeCommissionEconomicSurveysDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, FederalTradeCommissionFinancialStatisticsDivision)
        and disclosure_upon_written_request(d)
        and j2_ftc_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Upon request in writing by the Chairman of the Federal Trade Commission, the Secretary shall furnish such return information reflected on any return of a corporation with respect")
rule S6103J2FtcFurnishDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, FederalTradeCommissionFinancialStatisticsDivision)
        and disclosure_upon_written_request(d)
        and j2_ftc_scope(d)
        and recipient_organ(d, organ);
    then duty S6103J2FtcFurnishDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation j3_treasury_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the officers and employees of the Department of the Treasury have official duties that require the inspection or disclosure for the purpose of, but only to the extent necessary in, preparing economic or financial forecasts, projections, analyses, and statistical studies and conducting related activities — section 6103(j)(3), first sentence";
}

pub relation j3_request_states_reasons_and_signed_by_bureau_head(d: Disclosure) kind empirical {
    label en unofficial "case fact: the written request sets forth the specific reason or reasons why the inspection or disclosure is necessary and is signed by the head of the bureau or office of the Department of the Treasury requesting it — section 6103(j)(3), second sentence";
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Returns and return information shall be open to inspection by or disclosure to officers and employees of the Department of the Treasury whose official duties require such inspection or disclosure for")
rule S6103J3TreasuryForecastsAndStatisticsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, TreasuryOfficerForEconomicForecasts)
        and disclosure_upon_written_request(d)
        and j3_treasury_scope(d)
        and j3_request_states_reasons_and_signed_by_bureau_head(d);
    then disclosure_permitted(d);
}

pub relation j5_agriculture_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the returns (or return information reflected thereon) go, as the Secretary prescribes by regulation, to officers and employees of the Department of Agriculture whose official duties require access, for the purpose of, but only to the extent necessary in, structuring, preparing, and conducting the census of agriculture under the Census of Agriculture Act of 1997 (Public Law 105-113) — section 6103(j)(5)";
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Upon request in writing by the Secretary of Agriculture, the Secretary shall furnish such returns, or return information reflected thereon, as the Secretary may prescribe by")
rule S6103J5AgricultureCensusDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, AgricultureDepartmentCensusOfficer)
        and disclosure_upon_written_request(d)
        and j5_agriculture_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Upon request in writing by the Secretary of Agriculture, the Secretary shall furnish such returns, or return information reflected thereon, as the Secretary may prescribe by")
rule S6103J5AgricultureFurnishDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, AgricultureDepartmentCensusOfficer)
        and disclosure_upon_written_request(d)
        and j5_agriculture_scope(d)
        and recipient_organ(d, organ);
    then duty S6103J5AgricultureFurnishDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation j6_cbo_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information goes to officers and employees of the Congressional Budget Office for the purpose of, but only to the extent necessary for, long-term models of the social security and medicare programs — section 6103(j)(6)";
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Upon written request by the Director of the Congressional Budget Office, the Secretary shall furnish to officers and employees of the Congressional Budget Office return")
rule S6103J6CongressionalBudgetOfficeModelsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, CongressionalBudgetOfficeOfficer)
        and disclosure_upon_written_request(d)
        and j6_cbo_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_J, relation = formalizes, coverage = partial, quote = "Upon written request by the Director of the Congressional Budget Office, the Secretary shall furnish to officers and employees of the Congressional Budget Office return")
rule S6103J6CboFurnishDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, CongressionalBudgetOfficeOfficer)
        and disclosure_upon_written_request(d)
        and j6_cbo_scope(d)
        and recipient_organ(d, organ);
    then duty S6103J6CboFurnishDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation j4_recipient_disclosed_in_identifying_form_to_person_other_than_taxpayer(d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient disclosed the return or return information to a person other than the taxpayer to whom it relates in a form which can be associated with, or otherwise identify, directly or indirectly, a particular taxpayer — section 6103(j)(4)";
}

@source(IRC_S6103_J, relation = formalizes, coverage = exact, quote = "No person who receives a return or return information under this subsection shall disclose such return or return information to any person other than the taxpayer to whom it relates except in a form which cannot be associated with, or otherwise identify,")
rule S6103J4AnonymousFormRule strict {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and (recipient_is(d, CensusBureauOrBureauOfEconomicAnalysis) or recipient_is(d, FederalTradeCommissionFinancialStatisticsDivision) or recipient_is(d, TreasuryOfficerForEconomicForecasts) or recipient_is(d, AgricultureDepartmentCensusOfficer) or recipient_is(d, CongressionalBudgetOfficeOfficer));
    then prohibition S6103J4AnonymousFormOnly {
        bearer recipient;
        action j4_recipient_disclosed_in_identifying_form_to_person_other_than_taxpayer(d);
        window [-infinity, infinity];
    };
}

pub relation k1_offers_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: return information is disclosed to the extent necessary to permit inspection of an accepted offer-in-compromise under section 7122 relating to the liability for a tax imposed by this title — section 6103(k)(1)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Return information shall be disclosed to members of the general public to the extent necessary to permit inspection of any accepted offer-in-compromise under section 7122 relating to the liability")
rule S6103K1AcceptedOfferInCompromiseInspectionDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, MemberOfGeneralPublic)
        and k1_offers_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Return information shall be disclosed to members of the general public to the extent necessary to permit inspection of any accepted offer-in-compromise under section 7122 relating to the liability")
rule S6103K1OfferInspectionDutyRule strict {
    for d: Disclosure;
    for person: Person;
    when recipient_is(d, MemberOfGeneralPublic)
        and k1_offers_scope(d)
        and disclosure_to(d, person);
    then duty S6103K1OfferInspectionDuty {
        bearer Secretary;
        beneficiary person;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation k2_lien_amount_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: a notice of lien has been filed pursuant to section 6323(f); the person furnished satisfactory written evidence that he has a right in the property subject to the lien or intends to obtain such a right; the disclosure is of the amount of the outstanding obligation secured by the lien — section 6103(k)(2)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "If a notice of lien has been filed pursuant to section 6323(f), the amount of the outstanding obligation secured by such lien may be disclosed to any person who furnishes satisfactory written")
rule S6103K2OutstandingLienAmountToInterestedPersonDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, PersonWithRightInLienedProperty)
        and k2_lien_amount_scope(d);
    then disclosure_permitted(d);
}

pub relation k3_misstatement_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of return information or other information about a specific taxpayer, to the extent necessary for tax administration purposes to correct a misstatement of fact published or disclosed with respect to the taxpayer's return or any transaction of the taxpayer with the Internal Revenue Service — section 6103(k)(3)";
}

pub relation k3_joint_committee_on_taxation_approved(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Joint Committee on Taxation approved the disclosure before it was made — section 6103(k)(3)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "The Secretary may, but only following approval by the Joint Committee on Taxation, disclose such return information or any other information with respect to any specific taxpayer to the extent")
rule S6103K3CorrectionOfMisstatementOfFactDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, RecipientOfMisstatementCorrection)
        and k3_misstatement_scope(d)
        and k3_joint_committee_on_taxation_approved(d);
    then disclosure_permitted(d);
}

pub relation k4_convention_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the government has an income tax, gift and estate tax, or other convention or bilateral agreement with the United States relating to the exchange of tax information, and the disclosure is only to the extent provided in, and subject to the terms and conditions of, that convention or agreement — section 6103(k)(4)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "A return or return information may be disclosed to a competent authority of a foreign government which has an income tax or gift and estate tax convention, or other convention or bilateral agreement")
rule S6103K4CompetentAuthorityUnderConventionDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, ForeignCompetentAuthority)
        and k4_convention_scope(d);
    then disclosure_permitted(d);
}

pub relation k5_preparers_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of taxpayer identity information of a tax return preparer, and whether a penalty has been assessed against the preparer under section 6694, 6695, or 7216, to an agency, body, or commission lawfully charged under State or local law with the licensing, registration, or regulation of tax return preparers, on the written request of its head designating the officers or employees to receive it — section 6103(k)(5)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Taxpayer identity information with respect to any tax return preparer, and information as to whether or not any penalty has been assessed against such tax return preparer under section 6694, 6695, or 7216, may be furnished to any agency, body, or")
rule S6103K5PreparerRegulatorInformationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, StatePreparerRegulator)
        and disclosure_upon_written_request(d)
        and k5_preparers_scope(d);
    then disclosure_permitted(d);
}

pub relation k5_preparers_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the information was furnished or used for a purpose other than the licensing, registration, or regulation of tax return preparers";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "Information may be furnished and used under this paragraph only for purposes of the licensing, registration, or regulation of tax return preparers.")
rule S6103K5PreparerRegulatorUseUseLimitRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, StatePreparerRegulator)
        and k5_preparers_scope(d);
    then prohibition S6103K5PreparerRegulatorUseUseLimit {
        bearer recipient;
        action k5_preparers_misuse(d);
        window [-infinity, infinity];
    };
}

pub relation k6_disclosure_necessary_to_obtain_information_not_otherwise_reasonably_available(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is by an internal revenue officer or employee, or an officer or employee of the Office of Treasury Inspector General for Tax Administration, in connection with official duties relating to an audit, collection activity, or civil or criminal tax investigation or another offense under the internal revenue laws, to the extent necessary in obtaining information not otherwise reasonably available with respect to the correct determination of tax, liability for tax, or the amount to be collected, or the enforcement of any other provision of this title — section 6103(k)(6), first sentence";
}

pub relation k6_within_situations_and_conditions_prescribed_by_regulation(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is made only in such situations and under such conditions as the Secretary prescribes by regulation — section 6103(k)(6), second sentence";
}

pub relation k13a_disclosure_to_whistleblower(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to an individual providing information relating to a purpose described in section 7623(a)(1) or (2) and is made under paragraph (13)(A)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "An internal revenue officer or employee and an officer or employee of the Office of Treasury Inspector General for Tax Administration may, in connection with his official duties relating to any audit, collection activity, or civil or criminal tax")
rule S6103K6InvestigativeDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, SourceOfInformationInTaxInvestigation)
        and k6_disclosure_necessary_to_obtain_information_not_otherwise_reasonably_available(d)
        and k6_within_situations_and_conditions_prescribed_by_regulation(d);
    then disclosure_permitted(d);
    unless k13a_disclosure_to_whistleblower(d)
        and recipient_is(d, SourceOfInformationInTaxInvestigation);
}

pub relation k7_excise_registration_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the name, address, and registration number of each person registered under any provision of subtitle D (and, for a registered terminal operator, the address of each terminal operated), or the registration status of any person — section 6103(k)(7)(A)-(B)";
}

external judgment relation secretary_determines_k7_disclosure_necessary_for_effective_administration_of_subtitle_d(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that disclosure is necessary to permit the effective administration of subtitle D — section 6103(k)(7)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "To the extent the Secretary determines that disclosure is necessary to permit the effective administration of subtitle D, the Secretary may disclose—")
rule S6103K7ExciseRegistrationInformationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, AnyPersonForExciseAdministration)
        and k7_excise_registration_scope(d)
        and secretary_determines_k7_disclosure_necessary_for_effective_administration_of_subtitle_d(d);
    then disclosure_permitted(d);
}

pub entity GovernmentPayment {
    label en unofficial "a Federal or other payment certified to the Financial Management Service for disbursement — section 6103(k)(8)(C)";
}

pub relation payment_certified_to_financial_management_service(payment: GovernmentPayment) kind empirical {
    label en unofficial "case fact: the payment is certified to the Financial Management Service for disbursement";
}

pub relation federal_payment_eligibility_based_on_income_or_assets(payment: GovernmentPayment) kind empirical {
    label en unofficial "case fact: eligibility for the Federal payment is based on the income or assets (or both) of the payee";
}

pub relation federal_payment_kind(payment: GovernmentPayment) kind empirical {
    label en unofficial "case fact: the payment is a Federal payment";
}

pub relation secretary_designated_payment_by_published_notice(payment: GovernmentPayment) kind empirical {
    label en unofficial "case fact: the Secretary designated the payment by published notice";
}

pub relation applicable_government_payment(payment: GovernmentPayment) kind institutional {
    label en unofficial "the payment is an \"applicable government payment\" within the meaning of section 6103(k)(8)(C)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(i) any Federal payment (other than a payment for which eligibility is based on the income or assets (or both) of a payee) certified to the Financial Management Service for disbursement, and")
rule S6103K8CiFederalPaymentIsApplicableGovernmentPayment strict {
    for payment: GovernmentPayment;
    when federal_payment_kind(payment)
        and payment_certified_to_financial_management_service(payment)
        and not_known(federal_payment_eligibility_based_on_income_or_assets(payment));
    then applicable_government_payment(payment);
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(ii) any other payment which is certified to the Financial Management Service for disbursement and which the Secretary designates by published notice.")
rule S6103K8CiiDesignatedPaymentIsApplicableGovernmentPayment strict {
    for payment: GovernmentPayment;
    when payment_certified_to_financial_management_service(payment)
        and secretary_designated_payment_by_published_notice(payment);
    then applicable_government_payment(payment);
}

pub relation k8_levied_payment(d: Disclosure, payment: GovernmentPayment) kind empirical {
    label en unofficial "case fact: the notice of levy, or release of levy, that the disclosure serves relates to this payment";
}

pub relation k8_disclosure_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure to officers and employees of the Financial Management Service is of return information (including taxpayer identity information), the amount of the unpaid liability (including penalties and interest), and the type of tax and tax period — section 6103(k)(8)(A)(i)-(iii)";
}

pub relation k8_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Financial Management Service officer or employee used the information other than for transferring levied funds in satisfaction of the levy, maintaining appropriate agency records in regard to the levy or its release, notifying the taxpayer and the certifying agency that the levy has been honored, or defending litigation ensuing from the honor of the levy — section 6103(k)(8)(B)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "In serving a notice of levy, or release of such levy, with respect to any applicable government payment, the Secretary may disclose to officers and employees of the Financial Management Service—")
rule S6103K8FinancialManagementServiceDisclosurePermitted strict {
    for d: Disclosure;
    for payment: GovernmentPayment;
    when recipient_is(d, FinancialManagementServiceOfficer)
        and k8_levied_payment(d, payment)
        and applicable_government_payment(payment)
        and k8_disclosure_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "Return information disclosed under subparagraph (A) may be used by officers and employees of the Financial Management Service only for the purpose of, and to the extent necessary in, transferring levied funds in satisfaction of the levy, maintaining")
rule S6103K8UseLimitRule strict {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, FinancialManagementServiceOfficer)
        and k8_disclosure_scope(d);
    then prohibition S6103K8UseLimit {
        bearer recipient;
        action k8_misuse(d);
        window [-infinity, infinity];
    };
}

pub relation k9_6311_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: returns or return information are disclosed to financial institutions and others for the administration of section 6311; disclosures for purposes other than accepting payments by checks or money orders are made only to the extent authorized by written procedures promulgated by the Secretary — section 6103(k)(9)";
}

external judgment relation secretary_deems_k9_disclosure_necessary_for_administration_of_section_6311(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary deems the disclosure necessary for the administration of section 6311 — section 6103(k)(9)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "The Secretary may disclose returns or return information to financial institutions and others to the extent the Secretary deems necessary for the administration of section 6311. Disclosures of")
rule S6103K9FinancialInstitutionsForSection6311DisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, FinancialInstitutionOrOtherForPayments)
        and k9_6311_scope(d)
        and secretary_deems_k9_disclosure_necessary_for_administration_of_section_6311(d);
    then disclosure_permitted(d);
}

pub relation k10a_prisons_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of returns or return information with respect to individuals incarcerated in Federal or State prison systems, to officers and employees of the Federal Bureau of Prisons or a State agency charged with the responsibility for administration of prisons, under such procedures as the Secretary prescribes — section 6103(k)(10)(A)";
}

external judgment relation secretary_determines_k10_incarcerated_individual_may_have_filed_false_return(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary has determined that the incarcerated individual may have filed or facilitated the filing of a false or fraudulent return — section 6103(k)(10)(A)";
}

external judgment relation secretary_determines_k10_disclosure_necessary_for_federal_tax_administration(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines that the disclosure is necessary to permit effective Federal tax administration — section 6103(k)(10)(A)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Under such procedures as the Secretary may prescribe, the Secretary may disclose to officers and employees of the Federal Bureau of Prisons and of any State agency charged with the responsibility for administration of prisons any returns or return")
rule S6103K10APrisonAuthorityFalseReturnPreventionDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, PrisonAuthorityOfficer)
        and k10a_prisons_scope(d)
        and secretary_determines_k10_incarcerated_individual_may_have_filed_false_return(d)
        and secretary_determines_k10_disclosure_necessary_for_federal_tax_administration(d);
    then disclosure_permitted(d);
}

pub relation k10b_contractors_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure authorized by subparagraph (A) is made to a contractor responsible for the operation of a Federal or State prison on behalf of the Bureau or State agency, under such procedures as the Secretary prescribes — section 6103(k)(10)(B)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Under such procedures as the Secretary may prescribe, the disclosures authorized by subparagraph (A) may be made to contractors responsible for the operation of a Federal or State prison on behalf of such Bureau or agency.")
rule S6103K10BPrisonContractorFalseReturnPreventionDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, PrisonOperatingContractor)
        and k10b_contractors_scope(d)
        and secretary_determines_k10_incarcerated_individual_may_have_filed_false_return(d)
        and secretary_determines_k10_disclosure_necessary_for_federal_tax_administration(d);
    then disclosure_permitted(d);
}

pub relation k10a_prisons_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the information was used for a purpose other than taking administrative action to prevent the filing of false and fraudulent returns (including actions on possible violations of prison administrative rules, and the related administrative and judicial proceedings)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Any return or return information received under this paragraph shall be used only for the purposes of and to the extent necessary in taking administrative action to prevent the filing of false and fraudulent returns, including administrative actions")
rule S6103K10APrisonUseUseLimitRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, PrisonAuthorityOfficer)
        and k10a_prisons_scope(d);
    then prohibition S6103K10APrisonUseUseLimit {
        bearer recipient;
        action k10a_prisons_misuse(d);
        window [-infinity, infinity];
    };
}

pub relation k10_redisclosed_outside_prison_administration_personnel(d: Disclosure) kind empirical {
    label en unofficial "case fact: the officer, employee, or contractor disclosed information obtained under paragraph (10) to a person other than an officer, employee, or contractor of the Bureau or State agency personally and directly engaged in the administration of prison facilities — section 6103(k)(10)(D)(i)";
}

pub relation k10_redisclosure_to_duly_authorized_legal_representative_for_the_action(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to the duly authorized legal representative of the Bureau, State agency, or contractor, or of the incarcerated individual who is a party to a subparagraph (C) action or proceeding, solely in preparation for or for use in that action or proceeding — section 6103(k)(10)(D)(ii)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), any officer, employee, or contractor of the Federal Bureau of Prisons or of any State agency charged with the responsibility for administration of prisons shall not disclose any information obtained under this paragraph to")
rule S6103K10DRedisclosureBanRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and (recipient_is(d, PrisonAuthorityOfficer) or recipient_is(d, PrisonOperatingContractor))
        and (k10a_prisons_scope(d) or k10b_contractors_scope(d));
    then prohibition S6103K10DRedisclosureBan {
        bearer recipient;
        action k10_redisclosed_outside_prison_administration_personnel(d);
        window [-infinity, infinity];
    };
    unless k10_redisclosure_to_duly_authorized_legal_representative_for_the_action(d)
        and disclosure_to(d, recipient);
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "The returns and return information disclosed under this paragraph may be disclosed to the duly authorized legal representative of the Federal Bureau of Prisons, State agency, or contractor charged with the responsibility for administration of prisons, or of")
rule S6103K10DLegalRepresentativeDisclosurePermitted strict {
    for d: Disclosure;
    when k10_redisclosure_to_duly_authorized_legal_representative_for_the_action(d)
        and recipient_is(d, PrisonLegalRepresentative);
    then disclosure_permitted(d);
}

pub relation k11_passport_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary received a certification described in section 7345 and the disclosure is of return information with respect to a taxpayer with a seriously delinquent tax debt, limited to the taxpayer identity information and the amount of the seriously delinquent tax debt — section 6103(k)(11)(A)(i)-(ii)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon receiving a certification described in section 7345, disclose to the Secretary of State return information with respect to a taxpayer who has a seriously delinquent tax debt described in such section. Such return")
rule S6103K11PassportRevocationDisclosureToStateDepartmentDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, DepartmentOfStateOfficer)
        and k11_passport_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "The Secretary shall, upon receiving a certification described in section 7345, disclose to the Secretary of State return information with respect to a taxpayer who has a seriously delinquent tax debt described in such section. Such return")
rule S6103K11StateDepartmentDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, DepartmentOfStateOfficer)
        and k11_passport_scope(d)
        and recipient_organ(d, organ);
    then duty S6103K11StateDepartmentDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation k11_passport_misuse(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Department of State officer or employee used the information for a purpose other than carrying out the requirements of section 32101 of the FAST Act";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Return information disclosed under subparagraph (A) may be used by officers and employees of the Department of State for the purposes of, and to the extent necessary in, carrying out the requirements of section 32101 of the FAST Act.")
rule S6103K11PassportUseUseLimitRule defeasible {
    for d: Disclosure;
    for recipient: Person;
    when disclosure_to(d, recipient)
        and recipient_is(d, DepartmentOfStateOfficer)
        and k11_passport_scope(d);
    then prohibition S6103K11PassportUseUseLimit {
        bearer recipient;
        action k11_passport_misuse(d);
        window [-infinity, infinity];
    };
}

pub relation k12_contractors_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the persons providing services under a qualified tax collection contract under section 6306, speaking to a person who identified himself or herself as having the name of the taxpayer to whom a tax receivable relates, identify themselves as contractors of the Internal Revenue Service and disclose the contractor's business name and the nature, subject, and reason for the contact — section 6103(k)(12), first sentence";
}

pub relation k12_situation_and_conditions_approved_by_secretary(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is made only in such situations and under such conditions as the Secretary has approved — section 6103(k)(12), second sentence";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Persons providing services pursuant to a qualified tax collection contract under section 6306 may, if speaking to a person who has identified himself or herself as having the name of the taxpayer to which a tax receivable (within the meaning of such")
rule S6103K12QualifiedTaxCollectionContractorIdentificationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, PersonIdentifyingAsNamedTaxpayer)
        and k12_contractors_scope(d)
        and k12_situation_and_conditions_approved_by_secretary(d);
    then disclosure_permitted(d);
}

pub relation k13a_whistleblower_info_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is to an individual providing information relating to a purpose described in section 7623(a)(1) or (2), of return information related to the investigation of a taxpayer with respect to whom the individual has provided such information, and only to the extent necessary in obtaining information not otherwise reasonably available with respect to the correct determination of tax liability, the amount to be collected, or the enforcement of any other provision of this title — section 6103(k)(13)(A)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "The Secretary may disclose, to any individual providing information relating to any purpose described in paragraph (1) or (2) of section 7623(a), return information related to the investigation of any taxpayer with respect to whom the individual has")
rule S6103K13AReturnInformationToWhistleblowerDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, IndividualProvidingSection7623Information)
        and k13a_whistleblower_info_scope(d);
    then disclosure_permitted(d);
}

pub relation k13_case_referred_for_audit_or_examination_on(individual: Person, referredOn: Date) kind empirical {
    label en unofficial "case fact: a case for which the individual provided information was referred for an audit or examination on this date";
}

pub relation k13_referral_notice_sent_on(individual: Person, sentOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary sent the individual a notice with respect to the referral on this date";
}

pub relation k13_referral_notice_timely(individual: Person) kind institutional {
    label en unofficial "the referral notice was sent not later than 60 days after the case was referred";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(i) Not later than 60 days after a case for which the individual has provided information has been referred for an audit or examination, a notice with respect to such referral.")
rule S6103K13BiReferralNoticeTimelyClassification strict {
    for individual: Person;
    for referredOn: Date;
    for sentOn: Date;
    when k13_case_referred_for_audit_or_examination_on(individual, referredOn)
        and k13_referral_notice_sent_on(individual, sentOn)
        and sentOn <= add_calendar_period(referredOn, 60 calendar_day);
    then k13_referral_notice_timely(individual);
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "The Secretary shall disclose to an individual providing information relating to any purpose described in paragraph (1) or (2) of section 7623(a) the following:")
@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(i) Not later than 60 days after a case for which the individual has provided information has been referred for an audit or examination, a notice with respect to such referral.")
rule S6103K13BiReferralNoticeDutyRule strict {
    for individual: Person;
    for referredOn: Date;
    when k13_case_referred_for_audit_or_examination_on(individual, referredOn);
    then duty S6103K13BiReferralNoticeDuty {
        bearer Secretary;
        beneficiary individual;
        goal achievement {
            condition k13_referral_notice_timely(individual);
            window [referredOn, add_calendar_period(referredOn, 60 calendar_day)];
        }
    };
}

pub relation k13_taxpayer_paid_tax_related_to_information_on(individual: Person, paidOn: Date) kind empirical {
    label en unofficial "case fact: a taxpayer with respect to whom the individual provided information made a payment of tax with respect to the liability to which the information relates on this date";
}

pub relation k13_payment_notice_sent_on(individual: Person, sentOn: Date) kind empirical {
    label en unofficial "case fact: the Secretary sent the individual a notice with respect to the payment on this date";
}

pub relation k13_payment_notice_timely(individual: Person) kind institutional {
    label en unofficial "the payment notice was sent not later than 60 days after the taxpayer's payment";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(ii) Not later than 60 days after a taxpayer with respect to whom the individual has provided information has made a payment of tax with respect to tax liability to which such information relates, a notice with respect to such payment.")
rule S6103K13BiiPaymentNoticeTimelyClassification strict {
    for individual: Person;
    for paidOn: Date;
    for sentOn: Date;
    when k13_taxpayer_paid_tax_related_to_information_on(individual, paidOn)
        and k13_payment_notice_sent_on(individual, sentOn)
        and sentOn <= add_calendar_period(paidOn, 60 calendar_day);
    then k13_payment_notice_timely(individual);
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(ii) Not later than 60 days after a taxpayer with respect to whom the individual has provided information has made a payment of tax with respect to tax liability to which such information relates, a notice with respect to such payment.")
rule S6103K13BiiPaymentNoticeDutyRule strict {
    for individual: Person;
    for paidOn: Date;
    when k13_taxpayer_paid_tax_related_to_information_on(individual, paidOn);
    then duty S6103K13BiiPaymentNoticeDuty {
        bearer Secretary;
        beneficiary individual;
        goal achievement {
            condition k13_payment_notice_timely(individual);
            window [paidOn, add_calendar_period(paidOn, 60 calendar_day)];
        }
    };
}

pub relation k13_written_request_for_status_and_award_reasons(individual: Person) kind empirical {
    label en unofficial "case fact: the individual made a written request for information on the status and stage of any investigation or action related to the information, or (for a section 7623(b) award determination) the reasons for the determination — section 6103(k)(13)(B)(iii)";
}

pub relation k13_status_and_reasons_disclosed(individual: Person) kind empirical {
    label en unofficial "case fact: the Secretary disclosed the requested status and stage information (and, for an award determination, the reasons)";
}

external judgment relation secretary_determines_k13_status_disclosure_would_seriously_impair_tax_administration(individual: Person) {
    authority Secretary;
    label en official "the Secretary determines that disclosure of the status and stage information (clause (iii)) would seriously impair Federal tax administration — section 6103(k)(13)(B), last paragraph";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(iii) Subject to such requirements and conditions as are prescribed by the Secretary, upon a written request by such individual—")
@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(I) information on the status and stage of any investigation or action related to such information,")
@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(II) in the case of a determination of the amount of any award under section 7623(b), the reasons for such determination.")
@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Clause (iii) shall not apply to any information if the Secretary determines that disclosure of such")
rule S6103K13BiiiStatusDutyRule defeasible {
    for individual: Person;
    when k13_written_request_for_status_and_award_reasons(individual);
    then duty S6103K13BiiiStatusDuty {
        bearer Secretary;
        beneficiary individual;
        goal achievement {
            condition k13_status_and_reasons_disclosed(individual);
            window [-infinity, infinity];
        }
    };
    unless secretary_determines_k13_status_disclosure_would_seriously_impair_tax_administration(individual)
        and k13_written_request_for_status_and_award_reasons(individual);
}

pub relation k13d_designee_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: information described in clauses (i), (ii), and (iii) is disclosed to a designee of the individual providing the information, in accordance with guidance provided by the Secretary — section 6103(k)(13)(B), last sentence";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Clause (iii) shall not apply to any information if the Secretary determines that disclosure of such information would seriously impair Federal tax administration. Information described in clauses (i), (ii), and (iii) may be disclosed to a designee")
rule S6103K13DWhistleblowerDesigneeDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, DesigneeOfWhistleblower)
        and k13d_designee_scope(d);
    then disclosure_permitted(d);
}

pub relation designated_by_secretary_for_isac_function(person: Person) kind empirical {
    label en unofficial "case fact: the Secretary designated the person as having primary responsibility for a function performed with respect to the information sharing and analysis center described in section 2003(a) of the Taxpayer First Act — section 6103(k)(14)(B)(i)(I)";
}

pub relation subject_to_section_7216_and_isac_participant(person: Person) kind empirical {
    label en unofficial "case fact: the person is subject to the requirements of section 7216 and is a participant in the information sharing and analysis center — section 6103(k)(14)(B)(i)(II)";
}

pub relation written_isac_agreement_with_secretary(person: Person) kind empirical {
    label en unofficial "case fact: the person entered into a written agreement with the Secretary setting forth the terms and conditions for the disclosure, including requirements for protection and safeguarding and for reporting any unauthorized access or system breach to the Treasury Inspector General for Tax Administration — section 6103(k)(14)(B)(ii), (E)";
}

pub relation specified_isac_participant(person: Person) kind institutional {
    label en unofficial "the person is a \"specified ISAC participant\" within the meaning of section 6103(k)(14)(B)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(I) any person designated by the Secretary as having primary responsibility for a function performed with respect to the information sharing and analysis center described in section 2003(a) of the Taxpayer First Act, and")
@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Such term shall not include any person unless such person has entered into a written agreement with the Secretary setting forth the terms and conditions for the disclosure of information to such")
@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Return information disclosed under this paragraph shall be subject to such protections and safeguards as the Secretary may require in regulations or other guidance or in the written agreement referred to in subparagraph (B)(ii). Such written")
rule S6103K14BDesignatedParticipant strict {
    for person: Person;
    when designated_by_secretary_for_isac_function(person)
        and written_isac_agreement_with_secretary(person);
    then specified_isac_participant(person);
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(II) any person subject to the requirements of section 7216 and which is a participant in such information sharing and analysis center.")
@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Such term shall not include any person unless such person has entered into a written agreement with the Secretary setting forth the terms and conditions for the disclosure of information to such")
@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Return information disclosed under this paragraph shall be subject to such protections and safeguards as the Secretary may require in regulations or other guidance or in the written agreement referred to in subparagraph (B)(ii). Such written")
rule S6103K14BReturnPreparerParticipant strict {
    for person: Person;
    when subject_to_section_7216_and_isac_participant(person)
        and written_isac_agreement_with_secretary(person);
    then specified_isac_participant(person);
}

pub relation k14_specified_return_information_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of \"specified return information\": for a return connected with a case of potential identity theft refund fraud, the electronic filing characteristics (IP address, device identification, email domain name, speed of completion, method of authentication, refund method) and preparer identifying information; for a confirmed case, that information plus the name and TIN on the return and refund bank account and routing information; for a cybersecurity threat to the IRS, similar information — section 6103(k)(14)(C)(i)-(iii)";
}

external judgment relation secretary_determines_k14_disclosure_furthers_effective_tax_administration(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary determines the disclosure is in furtherance of effective Federal tax administration relating to the detection or prevention of identity theft tax refund fraud, validation of taxpayer identity, authentication of taxpayer returns, or detection or prevention of cybersecurity threats — section 6103(k)(14)(A)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "Under such procedures and subject to such conditions as the Secretary may prescribe, the Secretary may disclose specified return information to specified ISAC participants to the extent that the Secretary determines such disclosure is in furtherance of")
rule S6103K14ADisclosureToIsacParticipantPermitted strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and specified_isac_participant(person)
        and k14_specified_return_information_scope(d)
        and secretary_determines_k14_disclosure_furthers_effective_tax_administration(d);
    then disclosure_permitted(d);
}

pub relation k14_designated_participant_used_beyond_permitted_purposes(d: Disclosure) kind empirical {
    label en unofficial "case fact: the person designated under (B)(i)(I) used the return information for a purpose other than performing the designated function, facilitating disclosures to (B)(i)(II) participants, or facilitating disclosures under subsection (d) to participants in the center — section 6103(k)(14)(D)(i)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "Any return information received by a person described in subparagraph (B)(i)(I) shall be used only for the purposes of and to the extent necessary in—")
@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(I) performing the function such person is designated to perform under such subparagraph,")
@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(II) facilitating disclosures authorized under subparagraph (A) to persons described in")
@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "(III) facilitating disclosures authorized under subsection (d) to participants in such information")
rule S6103K14DiDesignatedUseLimitRule strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and specified_isac_participant(person)
        and designated_by_secretary_for_isac_function(person)
        and k14_specified_return_information_scope(d);
    then prohibition S6103K14DiDesignatedUseLimit {
        bearer person;
        action k14_designated_participant_used_beyond_permitted_purposes(d);
        window [-infinity, infinity];
    };
}

pub relation section_7216_return_preparation_information(d: Disclosure) kind institutional {
    label en unofficial "the return information received by a preparer participant is treated for section 7216 as information furnished for, or in connection with, the preparation of a return of the chapter 1 tax";
}

@source(IRC_S6103_K, relation = formalizes, coverage = exact, quote = "Any return information received by a person described in subparagraph (B)(i)(II) shall be treated for purposes of section 7216 as information furnished to such person for, or in connection with, the preparation of a return of the tax imposed under chapter 1.")
rule S6103K14DiiSection7216Treatment strict {
    for d: Disclosure;
    for person: Person;
    when disclosure_to(d, person)
        and specified_isac_participant(person)
        and subject_to_section_7216_and_isac_participant(person);
    then section_7216_return_preparation_information(d);
}

pub relation k15_ssa_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the taxpayer identity and date of birth of an individual involved with a tax receivable the Secretary identified for possible collection under a qualified tax collection contract (section 6306(b)), to officers, employees, and contractors of the Social Security Administration to determine whether the receivable is not eligible for such collection by reason of section 6306(d)(3)(E) — section 6103(k)(15)";
}

@source(IRC_S6103_K, relation = formalizes, coverage = partial, quote = "In the case of any individual involved with a tax receivable which the Secretary has identified for possible collection pursuant to a qualified tax collection contract (as defined in section 6306(b)), the Secretary may disclose the taxpayer identity")
rule S6103K15TaxReceivableIneligibilityToSocialSecurityDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, SocialSecurityAdministrationOfficerOnCollectionContract)
        and k15_ssa_scope(d);
    then disclosure_permitted(d);
}

pub relation m1_press_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of taxpayer identity information, for purposes of notifying persons entitled to tax refunds whom the Secretary has been unable to locate — section 6103(m)(1)";
}

external judgment relation secretary_after_reasonable_effort_and_lapse_of_time_unable_to_locate_refund_payee(d: Disclosure) {
    authority Secretary;
    label en official "the Secretary, after reasonable effort and lapse of time, has been unable to locate the persons entitled to the tax refunds — section 6103(m)(1)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "The Secretary may disclose taxpayer identity information to the press and other media for purposes of notifying persons entitled to tax refunds when the Secretary, after reasonable effort and lapse")
rule S6103M1RefundPayeeNoticeToPressDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, PressAndOtherMedia)
        and m1_press_scope(d)
        and secretary_after_reasonable_effort_and_lapse_of_time_unable_to_locate_refund_payee(d);
    then disclosure_permitted(d);
}

pub relation m2a_federal_claims_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the mailing address of a taxpayer for use by officers, employees, or agents of a Federal agency for purposes of locating the taxpayer to collect or compromise a Federal claim against the taxpayer in accordance with 31 U.S.C. 3711, 3717, and 3718 — section 6103(m)(2)(A)";
}

pub relation m2_recipient_is_consumer_reporting_agency_agent(d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient is an agent of a Federal agency which is a consumer reporting agency within the meaning of section 603(f) of the Fair Credit Reporting Act (15 U.S.C. 1681a(f)) — section 6103(m)(2)(B)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraph (B), the Secretary may, upon written request, disclose the mailing address of a taxpayer for use by officers, employees, or agents of a Federal agency for purposes of locating such taxpayer to collect or compromise")
rule S6103M2AMailingAddressForFederalClaimDisclosurePermitted defeasible {
    for d: Disclosure;
    when recipient_is(d, FederalAgencyLocatingTaxpayerForClaim)
        and disclosure_upon_written_request(d)
        and m2a_federal_claims_scope(d);
    then disclosure_permitted(d);
    unless m2_recipient_is_consumer_reporting_agency_agent(d) and recipient_is(d, FederalAgencyLocatingTaxpayerForClaim);
}

pub relation m2b_consumer_reporting_agent_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the consumer reporting agency agent receives the mailing address only for the purpose of preparing a commercial credit report on the taxpayer for use by the Federal agency in accordance with 31 U.S.C. 3711, 3717, and 3718 — section 6103(m)(2)(B)";
}

pub relation m2b_recipient_is_consumer_reporting_agency_agent_flag(d: Disclosure) kind empirical {
    label en unofficial "case fact: the recipient is an agent of a Federal agency which is a consumer reporting agency (section 603(f) of the Fair Credit Reporting Act)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "In the case of an agent of a Federal agency which is a consumer reporting agency (within the meaning of section 603(f) of the Fair Credit Reporting Act (15 U.S.C. 1681a(f))), the mailing address of a taxpayer may be disclosed to such agent under")
rule S6103M2BMailingAddressForCommercialCreditReportDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, FederalAgencyLocatingTaxpayerForClaim)
        and disclosure_upon_written_request(d)
        and m2b_consumer_reporting_agent_scope(d)
        and m2b_recipient_is_consumer_reporting_agency_agent_flag(d);
    then disclosure_permitted(d);
}

pub relation m3_niosh_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the mailing address of taxpayers solely for the purpose of locating individuals who are, or may have been, exposed to occupational hazards in order to determine the status of their health or to inform them of the possible need for medical care and treatment — section 6103(m)(3)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Upon written request, the Secretary may disclose the mailing address of taxpayers to officers and employees of the National Institute for Occupational Safety and Health solely for the purpose of")
rule S6103M3MailingAddressToNioshDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, NioshOfficer)
        and disclosure_upon_written_request(d)
        and m3_niosh_scope(d);
    then disclosure_permitted(d);
}

pub relation m4a_education_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the mailing address of a taxpayer who owes an overpayment of a Federal Pell Grant (subpart 1 of part A of title IV of the Higher Education Act of 1965) or who has defaulted on a loan under part B, D, or E of title IV, or a loan made under section 3(a)(1) of the Migration and Refugee Assistance Act of 1962, for use only by officers, employees, or agents of the Department of Education for locating the taxpayer for collecting the overpayment or loan — section 6103(m)(4)(A)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Upon written request by the Secretary of Education, the Secretary may disclose the mailing address of any taxpayer—")
rule S6103M4AMailingAddressToDepartmentOfEducationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, DepartmentOfEducationOfficer)
        and disclosure_upon_written_request(d)
        and m4a_education_scope(d);
    then disclosure_permitted(d);
}

pub relation m4b_lenders_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary of Education discloses a mailing address disclosed under (A)(i) to a lender or State or nonprofit guarantee agency participating under part B or D of title IV, or an educational institution with which the Secretary of Education has an agreement under subpart 1 of part A, or part D or E, of title IV, for use only by their officers, employees, or agents whose duties relate to the collection of student loans, for locating individuals who have defaulted on such loans — section 6103(m)(4)(B)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Any mailing address disclosed under subparagraph (A)(i) may be disclosed by the Secretary of Education to—")
rule S6103M4BMailingAddressToLendersAndInstitutionsDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, LenderGuaranteeAgencyOrInstitutionOnEducationLoans)
        and m4b_lenders_scope(d);
    then disclosure_permitted(d);
}

pub relation m5a_hhs_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the mailing address of a taxpayer who has defaulted on a loan under part C of title VII, or under subpart II of part B of title VIII, of the Public Health Service Act, for use only by officers, employees, or agents of the Department of Health and Human Services for locating the taxpayer for collecting the loan — section 6103(m)(5)(A)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Upon written request by the Secretary of Health and Human Services, the Secretary may disclose the mailing address of any taxpayer who has defaulted on a loan made under part C [1] of title VII of")
rule S6103M5AMailingAddressToDepartmentOfHealthLoansDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, HealthAndHumanServicesOfficerOnHealthLoans)
        and disclosure_upon_written_request(d)
        and m5a_hhs_scope(d);
    then disclosure_permitted(d);
}

pub relation m5b_schools_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Secretary of Health and Human Services discloses a mailing address disclosed under (A) to a school with an agreement under subpart II of part C of title VII (or subpart II of part B of title VIII), or an eligible lender participating under subpart I of part C of title VII, of the Public Health Service Act, for use only by officers, employees, or agents whose duties relate to the collection of student loans, for locating defaulters — section 6103(m)(5)(B)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Any mailing address disclosed under subparagraph (A) may be disclosed by the Secretary of Health and Human Services to—")
rule S6103M5BMailingAddressToSchoolsAndEligibleLendersDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, SchoolOrEligibleLenderOnHealthLoans)
        and m5b_schools_scope(d);
    then disclosure_permitted(d);
}

pub relation m6_blood_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the mailing address of taxpayers, upon written request pursuant to section 1141 of the Social Security Act, only for purposes of, and to the extent necessary in, assisting authorized persons (section 1141(h)(1)) in locating blood donors who have or may have the virus for acquired immune deficiency syndrome, in order to inform them of the possible need for medical care and treatment — section 6103(m)(6)(A)-(B)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Upon written request pursuant to section 1141 of the Social Security Act, the Secretary shall disclose the mailing address of taxpayers to officers and employees of the Blood Donor Locator Service in")
@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "The Secretary shall disclose return information under subparagraph (A) only for purposes of, and to the extent necessary in, assisting under the Blood Donor Locator Service authorized persons (as")
rule S6103M6AMailingAddressToBloodDonorLocatorServiceDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, BloodDonorLocatorServiceOfficer)
        and disclosure_upon_written_request(d)
        and m6_blood_scope(d);
    then disclosure_permitted(d);
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Upon written request pursuant to section 1141 of the Social Security Act, the Secretary shall disclose the mailing address of taxpayers to officers and employees of the Blood Donor Locator Service in")
rule S6103M6BloodDonorLocatorDutyRule strict {
    for d: Disclosure;
    for organ: Organ;
    when recipient_is(d, BloodDonorLocatorServiceOfficer)
        and disclosure_upon_written_request(d)
        and m6_blood_scope(d)
        and recipient_organ(d, organ);
    then duty S6103M6BloodDonorLocatorDuty {
        bearer Secretary;
        beneficiary organ;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

pub relation blood_donor_disclosure_completed(d: Disclosure) kind empirical {
    label en unofficial "case fact: the use of the blood donor records in making the disclosure required under (A) is completed";
}

pub relation blood_donor_records_in_treasury_destroyed(d: Disclosure) kind empirical {
    label en unofficial "case fact: the Department of the Treasury destroyed all related blood donor records (section 1141(h)(2) of the Social Security Act) in its possession, so as to make them undisclosable";
}

@source(IRC_S6103_M, relation = formalizes, coverage = exact, quote = "The Secretary shall destroy all related blood donor records (as defined in section 1141(h)(2) of the Social Security Act) in the possession of the Department of the Treasury upon completion of their use in making the disclosure required under subparagraph")
rule S6103M6CDestroyRecordsDutyRule strict {
    for d: Disclosure;
    when blood_donor_disclosure_completed(d);
    then duty S6103M6CDestroyBloodDonorRecordsDuty {
        bearer Secretary;
        beneficiary Secretary;
        goal achievement {
            condition blood_donor_records_in_treasury_destroyed(d);
            window [-infinity, infinity];
        }
    };
}

pub relation m7_ssa_statement_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is of the mailing address of a taxpayer entitled to receive a social security account statement under section 1143(c) of the Social Security Act, for use only by officers, employees, or agents of the Social Security Administration for purposes of mailing the statement — section 6103(m)(7)";
}

@source(IRC_S6103_M, relation = formalizes, coverage = partial, quote = "Upon written request by the Commissioner of Social Security, the Secretary may disclose the mailing address of any taxpayer who is entitled to receive a social security account statement pursuant to")
rule S6103M7MailingAddressForSocialSecurityStatementDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, SocialSecurityAdministrationOfficerOnStatements)
        and disclosure_upon_written_request(d)
        and m7_ssa_statement_scope(d);
    then disclosure_permitted(d);
}

pub relation n_others_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: returns and return information are disclosed to a person (including a person described in section 7513(a)) to the extent necessary in connection with the processing, storage, transmission, and reproduction of returns and return information, the programming, maintenance, repair, testing, and procurement of equipment, and the providing of other services, for purposes of tax administration — section 6103(n)";
}

pub relation n_pursuant_to_regulations(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure is pursuant to regulations prescribed by the Secretary";
}

@source(IRC_S6103_N, relation = formalizes, coverage = partial, quote = "Pursuant to regulations prescribed by the Secretary, returns and return information may be disclosed to any person, including any person described in section 7513(a), to the extent necessary in connection with the processing, storage, transmission,")
rule S6103NProcessingAndServicesForTaxAdministrationDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, ContractorForTaxAdministrationServices)
        and n_others_scope(d)
        and n_pursuant_to_regulations(d);
    then disclosure_permitted(d);
}

pub relation o1a_subtitle_e_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the returns and return information relate to taxes imposed by subtitle E (alcohol, tobacco, and firearms) and the officers and employees of the Federal agency have official duties that require the inspection or disclosure — section 6103(o)(1)(A)";
}

@source(IRC_S6103_O, relation = formalizes, coverage = partial, quote = "Returns and return information with respect to taxes imposed by subtitle E (relating to taxes on alcohol, tobacco, and firearms) shall be open to inspection by or disclosure to officers and employees of a Federal agency whose official duties require")
rule S6103O1ASubtitleETaxesToFederalAgenciesDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, FederalAgencyOfficerOnSubtitleEDuties)
        and o1a_subtitle_e_scope(d);
    then disclosure_permitted(d);
}

pub relation o1b_use_in_section_625_action(agency: Organ) kind empirical {
    label en unofficial "case fact: the Federal agency uses the returns or return information in an action or proceeding (or its preparation) brought under section 625 of the American Jobs Creation Act of 2004 for the collection of an unpaid assessment or penalty arising under that Act";
}

@source(IRC_S6103_O, relation = formalizes, coverage = exact, quote = "Returns and return information disclosed to a Federal agency under subparagraph (A) may be used in an action or proceeding (or in preparation for such action or proceeding) brought under section 625 of the American Jobs Creation Act of 2004 for the collection")
rule S6103O1BUseInSection625ActionLibertyRule strict {
    for agency: Organ;
    for d: Disclosure;
    when recipient_organ(d, agency)
        and recipient_is(d, FederalAgencyOfficerOnSubtitleEDuties)
        and o1a_subtitle_e_scope(d);
    then liberty S6103O1BUseInSection625ActionLiberty {
        holder agency;
        action o1b_use_in_section_625_action(agency);
        window [-infinity, infinity];
    };
}

pub relation wagering_tax_return_information_disclosed_outside_section_4424(d: Disclosure) kind empirical {
    label en unofficial "case fact: returns or return information with respect to taxes imposed by chapter 35 (wagering) were disclosed to a person or for a purpose other than those section 4424 prescribes";
}

pub relation o2_chapter_35_wagering_information(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure concerns returns or return information with respect to taxes imposed by chapter 35 (taxes on wagering)";
}

@source(IRC_S6103_O, relation = formalizes, coverage = exact, quote = "Returns and return information with respect to taxes imposed by chapter 35 (relating to taxes on wagering) shall, notwithstanding any other provision of this section, be open to inspection by or disclosure only to such person or persons and for such purpose")
rule S6103O2WageringInformationLimitRule strict {
    for d: Disclosure;
    for discloser: Person;
    when disclosure_by(d, discloser)
        and o2_chapter_35_wagering_information(d);
    then prohibition S6103O2WageringInformationLimit {
        bearer discloser;
        action wagering_tax_return_information_disclosed_outside_section_4424(d);
        window [-infinity, infinity];
    };
}

pub relation o3_section_4481_scope(d: Disclosure) kind empirical {
    label en unofficial "case fact: the returns and return information relate to taxes imposed by section 4481 and the officers and employees of United States Customs and Border Protection have official duties that require the inspection or disclosure for purposes of administering that section — section 6103(o)(3)";
}

@source(IRC_S6103_O, relation = formalizes, coverage = partial, quote = "Returns and return information with respect to taxes imposed by section 4481 shall be open to inspection by or disclosure to officers and employees of United States Customs and Border Protection of the Department of Homeland Security whose official")
rule S6103O3HeavyVehicleUseTaxToCustomsAndBorderProtectionDisclosurePermitted strict {
    for d: Disclosure;
    when recipient_is(d, CustomsAndBorderProtectionOfficer)
        and o3_section_4481_scope(d);
    then disclosure_permitted(d);
}
