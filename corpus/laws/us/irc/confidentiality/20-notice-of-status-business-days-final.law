// Confidentiality -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): section 6104(a)(3)(B) (G6889), "not
// later than 5 business days after the Secretary receives a notice".
//
// TECHNIQUE (the pattern of the Fannie Mae package `us.fnma.selling_income`): the deadline is `add_business_days(received, 5
// business_day, "23:59:59")` under a package deadline policy (the count starts the day after the receipt, the last day is
// included). The business-day calendar of section 85 is NOT carried by the package: a scenario or a consumer world supplies the
// calendar snapshot (`us.code.clir.federal_calendar`, derived from 5 U.S.C. 6103, in the `concat` of the test family); without it
// the date is not computed (MISSING_CALENDAR), and the asserted `five_business_day_deadline_for_527i_notice` (module 17) stays
// the channel that the duty and its classification read (`deadline_for_527i_notice_for_duty`).

language "law.core" version "0.2";
package us.irc.confidentiality version "0.1.1";
namespace "urn:us:irc:confidentiality:clir";

use self::{
    IRC_S6104_A,
    Person,
    five_business_day_deadline_for_527i_notice,
    notice_of_status_under_527i_received_on,
};

pub deadline policy IRC_BUSINESS_DAY_COUNT {
    start_count next_day;
    include_end true;
    roll next_working_day;
}

pub relation computed_five_business_day_deadline_for_527i_notice(org: Person, due: Date) kind institutional {
    label en official "the date five business days after the Secretary received the section 527(i) notice, by the federal business-day calendar of the world (section 6104(a)(3)(B))";
}
@source(IRC_S6104_A, relation = formalizes, coverage = exact, quote = "The Secretary shall make available the information required under subparagraph (A) not later than 5 business days after the Secretary receives a notice from a political organization under section 527(i).")
rule S6104A3BComputedDeadline strict {
    for org: Person;
    for receivedOn: Date;
    when notice_of_status_under_527i_received_on(org, receivedOn);
    then computed_five_business_day_deadline_for_527i_notice(org, add_business_days(receivedOn, 5 business_day, "23:59:59"));
}
relation has_computed_deadline_for_527i_notice(org: Person) kind institutional {
    label en unofficial "bridge for the absence test";
}
rule S6104A3BHasComputedDeadline strict {
    for org: Person;
    for due: Date;
    when computed_five_business_day_deadline_for_527i_notice(org, due);
    then has_computed_deadline_for_527i_notice(org);
}
pub relation deadline_for_527i_notice_for_duty(org: Person, due: Date) kind institutional {
    label en unofficial "the deadline the duty of section 6104(a)(3)(B) and its classification read: the computed date where the calendar is in the world, else the asserted date";
}
rule S6104A3BDeadlineComputed strict {
    for org: Person;
    for due: Date;
    when computed_five_business_day_deadline_for_527i_notice(org, due);
    then deadline_for_527i_notice_for_duty(org, due);
}
rule S6104A3BDeadlineAsserted strict {
    for org: Person;
    for due: Date;
    when five_business_day_deadline_for_527i_notice(org, due)
        and not_known(has_computed_deadline_for_527i_notice(org));
    then deadline_for_527i_notice_for_duty(org, due);
}
