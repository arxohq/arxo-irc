// 26 U.S.C. §6103(f) — Disclosure to Committees of Congress. STAGE 1 FULL
// for (f)(1) (Ways and Means / Finance / Joint Committee on Taxation) and
// the closed-executive-session/taxpayer-consent condition shared by
// (f)(1)-(4); (f)(2)-(4)'s own additional machinery (Chief of Staff
// submission chain, "other committees" resolution requirement, agent
// designation counts) and (f)(5) (whistleblower disclosure) are
// `unreviewed`.
//
// This module PUBLISHES the symbol `corpus/laws/us/irc/joint-committee/
// 02-powers-and-duties.law` is waiting on (its comment at line 42: "the
// power to obtain and inspect income returns is section 6103(f)'s own
// norm"): `committee_written_request` + `S6103F1CommitteeInspectionDuty`
// below give the Secretary's duty to furnish; `joint-committee` (or the
// coordinator) can import `committee_written_request`/
// `chairman_of_committee` from this package once it is ready to state its
// own §8021(a) cross-reference as a real dependency rather than
// EXTERNAL_DEPENDENCY. Not wired from this side (never edit a neighbour's
// package) — see HANDOFF.md section for this package.

// ---------------------------------------------------------------------
// (f)(1) Ways and Means, Finance, Joint Committee on Taxation
// ---------------------------------------------------------------------

use self::{
    Disclosure,
    IRC_S6103_F,
    Organ,
    Person,
    ReturnInformation,
    Secretary,
    about_taxpayer,
    disclosure_by,
    disclosure_of,
    disclosure_permitted,
};

pub relation named_f1_committee(committee: Organ) kind empirical {
    label en unofficial "case fact: the committee is the Committee on Ways and Means of the House, the Committee on Finance of the Senate, or the Joint Committee on Taxation — section 6103(f)(1)";
}
pub relation chairman_of_committee(chairman: Person, committee: Organ) kind empirical {
    label en unofficial "case fact: the person is the chairman of the named committee";
}
pub relation committee_written_request(d: Disclosure, chairman: Person, committee: Organ) kind empirical {
    label en unofficial "case fact: the chairman of the committee made a written request specifying the return or return information sought — section 6103(f)(1)";
}
pub relation identifies_particular_taxpayer(info: ReturnInformation) kind empirical {
    label en unofficial "case fact: the return or return information can be associated with, or otherwise identify, directly or indirectly, a particular taxpayer";
}
pub relation committee_sitting_in_closed_executive_session(d: Disclosure) kind empirical {
    label en unofficial "case fact: the committee receiving the disclosure was sitting in closed executive session at the time";
}
pub relation taxpayer_consents_in_writing_to_committee_disclosure(d: Disclosure, taxpayer: Person) kind empirical {
    label en unofficial "case fact: the taxpayer identified by the return information otherwise consented in writing to the disclosure to the committee";
}

// The Secretary's duty to furnish, once a proper written request is made.
@source(IRC_S6103_F, relation = formalizes, coverage = exact, quote = "Upon written request from the chairman of the Committee on Ways and Means of the House of Representatives, the chairman of the Committee on Finance of the Senate, or the chairman of the Joint Committee on Taxation, the Secretary shall furnish such committee with any return or return information specified in such request,")
rule S6103F1CommitteeInspectionDuty strict {
    for d: Disclosure;
    for chairman: Person;
    for committee: Organ;
    for info: ReturnInformation;
    when committee_written_request(d, chairman, committee)
        and chairman_of_committee(chairman, committee)
        and named_f1_committee(committee)
        and disclosure_of(d, info);
    then duty S6103F1FurnishDuty {
        bearer Secretary;
        beneficiary committee;
        goal achievement {
            condition disclosure_by(d, Secretary);
            window [-infinity, infinity];
        }
    };
}

// Whether that furnishing is a PERMITTED disclosure under (a): identifying
// information requires closed session or taxpayer consent; non-identifying
// information (or a committee not shown to identify a taxpayer) needs
// neither.
@source(IRC_S6103_F, relation = formalizes, coverage = exact, quote = "except that any return or return information which can be associated with, or otherwise identify, directly or indirectly, a particular taxpayer shall be furnished to such committee only when sitting in closed executive session unless such taxpayer otherwise consents in writing to such disclosure.")
rule S6103F1IdentifyingDisclosurePermittedClosedSession defeasible {
    for d: Disclosure;
    for chairman: Person;
    for committee: Organ;
    for info: ReturnInformation;
    for taxpayer: Person;
    when committee_written_request(d, chairman, committee)
        and chairman_of_committee(chairman, committee)
        and named_f1_committee(committee)
        and disclosure_of(d, info)
        and identifies_particular_taxpayer(info)
        and about_taxpayer(info, taxpayer)
        and (committee_sitting_in_closed_executive_session(d)
            or taxpayer_consents_in_writing_to_committee_disclosure(d, taxpayer));
    then disclosure_permitted(d);
}
rule S6103F1NonIdentifyingDisclosurePermitted strict {
    for d: Disclosure;
    for chairman: Person;
    for committee: Organ;
    for info: ReturnInformation;
    when committee_written_request(d, chairman, committee)
        and chairman_of_committee(chairman, committee)
        and named_f1_committee(committee)
        and disclosure_of(d, info)
        and not_known(identifies_particular_taxpayer(info));
    then disclosure_permitted(d);
}
