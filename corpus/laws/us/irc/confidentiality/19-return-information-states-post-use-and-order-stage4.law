// Confidentiality — stage 4 (26.09.2026, DECISION-0379, implemented_unverified): rows that stages 1-2
// left as TECH_GAP and could be expressed.
//
// Covered: §6103(b)(2)(C)-(D) (advance pricing and closing agreements are return information);
// §6103(b)(5)(A)(ii)-(iii), (B) (municipalities and regional income tax agencies as "State", the
// qualified group, and the conditions on disclosure to their contractors); §6103(l)(19)(B) (the fallback
// year); §6103(p)(4)(F) (what a recipient does when its use of returns is complete); §6105(b)(3)
// (tax convention information on the same terms); §6110(b)(1)(B) (matters excluded from "written
// determination"), §6110(c) last sentence (the Secretary's shield for deletions), §6110(f)(4)(A) (the
// burden of proof), §6110(h)(3) (the order of release).
//
// METHOD AND JUDGMENT CALLS.
//  - "State" for the listed subsections. The extension of (b)(5)(A)(ii)-(iii) applies only "for purposes of
//    subsections (a)(2), (b)(4), (d)(1), (h)(4), and (p)"; `state_within_6103b5` (the core list) is unchanged
//    and `state_for_extended_purposes_6103b5` adds the municipalities and regional agencies. The (d)(1)
//    disclosure rule of module 02 reads the extended relation; the other listed subsections have no
//    consumer of the relation in this package.
//  - "To the satisfaction of the Secretary" ((b)(5)(B)(iii)) is an external judgment (authority Secretary).
//  - Population "as determined under the most recent decennial census" is a case-supplied integer.
//  - §6103(p)(4)(F): the completion of use is a case fact; the alternatives of (ii) are separate duties of
//    the recipient with a shared condition (one of the three is enough).
//  - §6110(h)(3): the order is enforced as a prohibition on opening a determination before one that must
//    come first (by category, and within a category most recent first); a determination that must come
//    first and was never opened counts as opened later.

language "law.core" version "0.2";
package us.irc.confidentiality version "0.1.1";
namespace "urn:us:irc:confidentiality:clir";

use self::{
    Disclosure,
    IRC_S6103_B,
    IRC_S6103_L,
    IRC_S6103_P,
    IRC_S6105_B,
    IRC_S6110_B,
    IRC_S6110_C,
    IRC_S6110_F,
    IRC_S6110_H,
    Organ,
    Person,
    ReturnInformation,
    Secretary,
    TaxConventionInformation,
    WrittenDetermination,
    applicable_year_for_discount_card_ending,
    data_not_associable_with_taxpayer,
    disclosure_by,
    disclosure_permitted,
    return_information,
    state_within_6103b5,
    tax_convention_disclosure_of,
    tax_convention_disclosure_permitted,
    written_determination_open_on,
};

// ============================================================================
// §6103(b)(2)(C), (D) — agreements that are return information
// ============================================================================

pub relation advance_pricing_agreement_matter(info: ReturnInformation) kind empirical {
    label en official "an advance pricing agreement entered into by a taxpayer and the Secretary, or background information related to such an agreement or to an application for one";
}
pub relation section_7121_or_similar_agreement_matter(info: ReturnInformation) kind empirical {
    label en official "an agreement under section 7121 or any similar agreement, or background information related to such an agreement or a request for it";
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "(C) any advance pricing agreement entered into by a taxpayer and the Secretary and any background information related to such agreement or any application for an advance pricing agreement, and")
rule S6103b2CAdvancePricingAgreementIsReturnInformation defeasible {
    label en official "an advance pricing agreement and its background are return information";
    for info: ReturnInformation;
    when advance_pricing_agreement_matter(info);
    then return_information(info);
    unless data_not_associable_with_taxpayer(info) and advance_pricing_agreement_matter(info);
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "(D) any agreement under section 7121, and any similar agreement, and any background information related to such an agreement or request for such an agreement,")
rule S6103b2DClosingAgreementIsReturnInformation defeasible {
    label en official "an agreement under section 7121 or a similar agreement, and its background, are return information";
    for info: ReturnInformation;
    when section_7121_or_similar_agreement_matter(info);
    then return_information(info);
    unless data_not_associable_with_taxpayer(info) and section_7121_or_similar_agreement_matter(info);
}

// ============================================================================
// §6103(b)(5)(A)(ii)-(iii), (B) — municipalities and regional income tax agencies
// ============================================================================

pub relation population_by_latest_census(m: Organ, population: Integer) kind empirical {
    label en official "the population of the municipality as determined under the most recent decennial United States census data available";
}
pub relation imposes_tax_on_income_or_wages(m: Organ) kind empirical {
    label en official "the municipality imposes a tax on income or wages";
}
pub relation secretary_agreement_regarding_disclosure(agency: Organ) kind empirical {
    label en official "the Secretary (in his sole discretion) has entered into an agreement regarding disclosure with the municipality or governmental entity";
}
pub relation municipality_is_state_for_extended_purposes(m: Organ) kind institutional {
    label en official "a municipality with a population over 250,000 that imposes a tax on income or wages and has a disclosure agreement with the Secretary is a State for the listed subsections";
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "(I) with a population in excess of 250,000 (as determined under the most recent decennial United States census data available),")
rule S6103b5AiiMunicipalityIsState defeasible {
    label en official "a large municipality that taxes income or wages and has a disclosure agreement is a State";
    for m: Organ;
    for population: Integer;
    when population_by_latest_census(m, population)
        and population > 250000
        and imposes_tax_on_income_or_wages(m)
        and secretary_agreement_regarding_disclosure(m);
    then municipality_is_state_for_extended_purposes(m);
}
pub relation regional_governmental_entity(regionalBody: Organ) kind empirical {
    label en official "the governmental entity that municipalities form and operate";
}
pub relation entity_member_municipality(regionalBody: Organ, m: Organ) kind empirical {
    label en official "the municipality is one of the municipalities that form and operate the governmental entity";
}
pub relation municipality_administers_tax_through_entity_by_state_statute(m: Organ, regionalBody: Organ) kind empirical {
    label en official "the municipality, under the authority of a State statute, administers the laws relating to the imposition of its income or wage tax through the entity";
}
pub relation entity_formed_by_qualified_group(regionalBody: Organ) kind institutional {
    label en official "the entity is formed and operated by a qualified group of municipalities: two or more municipalities each imposing an income or wage tax, each administering it through the entity under a State statute, with a collective population over 250,000";
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "The term \"qualified group of municipalities\" means, with respect to any governmental entity, 2 or more municipalities—")
rule S6103b5BiQualifiedGroup defeasible {
    label en official "a qualified group is 2 or more municipalities that each tax income or wages and administer it through the entity by State statute, over 250,000 in total";
    for regionalBody: Organ;
    when regional_governmental_entity(regionalBody)
        and count(collect m: Organ where entity_member_municipality(regionalBody, m) and imposes_tax_on_income_or_wages(m) and municipality_administers_tax_through_entity_by_state_statute(m, regionalBody)) >= 2
        and sum(collect all population: Integer, m: Organ where entity_member_municipality(regionalBody, m) and population_by_latest_census(m, population)) > 250000;
    then entity_formed_by_qualified_group(regionalBody);
}
pub relation governmental_entity_is_state_for_extended_purposes(regionalBody: Organ) kind institutional {
    label en official "a governmental entity formed and operated by a qualified group of municipalities and having a disclosure agreement with the Secretary is a State for the listed subsections";
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "(iii) for purposes of subsections (a)(2), (b)(4), (d)(1), (h)(4), and (p), any governmental entity—")
rule S6103b5AiiiRegionalEntityIsState defeasible {
    label en official "a regional income tax agency of a qualified group with a disclosure agreement is a State";
    for regionalBody: Organ;
    when entity_formed_by_qualified_group(regionalBody) and secretary_agreement_regarding_disclosure(regionalBody);
    then governmental_entity_is_state_for_extended_purposes(regionalBody);
}
pub relation state_for_extended_purposes_6103b5(agency: Organ) kind institutional {
    label en official "the agency is a State for the subsections named in (b)(5)(A)(ii)-(iii): the core list, a qualifying municipality, or a qualifying regional entity";
}
rule S6103b5ACoreListIsStateForExtendedPurposes defeasible {
    for agency: Organ;
    when state_within_6103b5(agency);
    then state_for_extended_purposes_6103b5(agency);
}
rule S6103b5AiiMunicipalityStateForExtendedPurposes defeasible {
    for agency: Organ;
    when municipality_is_state_for_extended_purposes(agency);
    then state_for_extended_purposes_6103b5(agency);
}
rule S6103b5AiiiEntityStateForExtendedPurposes defeasible {
    for agency: Organ;
    when governmental_entity_is_state_for_extended_purposes(agency);
    then state_for_extended_purposes_6103b5(agency);
}
pub relation references_to_state_law_read_as_municipal_law(regionalBody: Organ) kind institutional {
    label en official "for a regional entity any reference to State law, proceedings or tax returns is a reference to the law, proceedings or tax returns of the municipalities that form and operate it";
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "any reference in such subsections to State law, proceedings, or tax returns shall be treated as references to the law, proceedings, or tax returns, as the case may be, of the municipalities which form and operate the governmental entity referred to in such subparagraph.")
rule S6103b5BiiReferencesReadAsMunicipal defeasible {
    label en official "references to State law are read as references to the law of the municipalities forming the entity";
    for regionalBody: Organ;
    when governmental_entity_is_state_for_extended_purposes(regionalBody);
    then references_to_state_law_read_as_municipal_law(regionalBody);
}
pub relation entity_requires_contractor_safeguards(regionalBody: Organ) kind empirical {
    label en official "the entity has requirements in effect which require each contractor or other agent with access to returns or return information to provide safeguards (within the meaning of subsection (p)(4))";
}
pub relation entity_agrees_to_on_site_review_every_three_years(regionalBody: Organ) kind empirical {
    label en official "the entity agrees to conduct an on-site review every 3 years (or a mid-point review for contracts of less than 3 years) of each contractor or other agent";
}
pub relation entity_submits_review_findings_with_p4E_report(regionalBody: Organ) kind empirical {
    label en official "the entity submits the findings of the most recent review to the Secretary as part of the report required by subsection (p)(4)(E)";
}
pub relation entity_certifies_contractor_compliance_for_latest_year(regionalBody: Organ) kind empirical {
    label en official "the entity certifies to the Secretary for the most recent annual period that each contractor or other agent complies with all the requirements";
}
pub relation certification_lists_contractors_descriptions_and_durations(regionalBody: Organ) kind empirical {
    label en official "the certification includes the name and address of each contractor and other agent, a description of the contract or agreement, and its duration";
}
external judgment relation entity_conditions_met_to_satisfaction_of_secretary(regionalBody: Organ) {
    authority Secretary;
    label en official "the entity meets, to the satisfaction of the Secretary, the conditions of subclauses (I)-(IV)";
}
pub relation contractor_disclosure_conditions_met(regionalBody: Organ) kind institutional {
    label en official "the conditions on disclosure to a contractor or agent of a regional governmental entity are met";
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "(IV) certifies to the Secretary for the most recent annual period that such contractor or other agent is in compliance with all such requirements.")
rule S6103b5BiiiConditionsMet defeasible {
    label en official "safeguard requirements, on-site reviews, findings and a full certification, to the Secretary's satisfaction";
    for regionalBody: Organ;
    when governmental_entity_is_state_for_extended_purposes(regionalBody)
        and entity_requires_contractor_safeguards(regionalBody)
        and entity_agrees_to_on_site_review_every_three_years(regionalBody)
        and entity_submits_review_findings_with_p4E_report(regionalBody)
        and entity_certifies_contractor_compliance_for_latest_year(regionalBody)
        and certification_lists_contractors_descriptions_and_durations(regionalBody)
        and entity_conditions_met_to_satisfaction_of_secretary(regionalBody);
    then contractor_disclosure_conditions_met(regionalBody);
}
pub relation disclosure_to_contractor_of_regional_entity(d: Disclosure, regionalBody: Organ) kind empirical {
    label en official "the disclosure is made to a contractor or other agent of the governmental entity";
}
pub relation disclosure_pursuant_to_6103n_for_federal_tax_administration(d: Disclosure) kind empirical {
    label en official "the disclosure is made pursuant to subsection (n) for purposes of Federal tax administration";
}
@source(IRC_S6103_B, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of this section, no return or return information shall be disclosed to any contractor or other agent of a governmental entity referred to in subparagraph (A)(iii) unless such entity, to the satisfaction of the Secretary—")
rule S6103b5BiiiNoDisclosureToContractorWithoutConditions defeasible {
    label en official "no return or return information may be disclosed to a contractor of a regional entity unless the entity's conditions are met";
    for d: Disclosure;
    for discloser: Person;
    for regionalBody: Organ;
    when disclosure_by(d, discloser)
        and disclosure_to_contractor_of_regional_entity(d, regionalBody)
        and governmental_entity_is_state_for_extended_purposes(regionalBody)
        and not_known(contractor_disclosure_conditions_met(regionalBody));
    then prohibition S6103b5BiiiNoContractorDisclosureProhibition {
        bearer discloser;
        action disclosure_by(d, discloser);
        window [-infinity, infinity];
    };
    unless disclosure_pursuant_to_6103n_for_federal_tax_administration(d)
        and disclosure_by(d, discloser)
        and disclosure_to_contractor_of_regional_entity(d, regionalBody)
        and governmental_entity_is_state_for_extended_purposes(regionalBody);
}

// ============================================================================
// §6103(l)(19)(B) — the applicable year, with its fallback
// ============================================================================

pub relation l19_return_filed_for_taxable_year_ending(taxpayer: Person, yearEnd: Date) kind empirical {
    label en official "a return is filed for the taxpayer for the taxable year ending on this date";
}
pub relation l19_preceding_taxable_year_ending(yearEnd: Date, priorEnd: Date) kind empirical {
    label en unofficial "the taxable year that precedes the year ending on `yearEnd` ends on `priorEnd` (case-supplied: the language has no predecessor-year function, TECH-GAPS G10)";
}
pub relation applicable_year_for_l19(taxpayer: Person, yearEnd: Date) kind institutional {
    label en official "the applicable year: the most recent taxable year for which information is available, or, if no return is filed for the taxpayer for that year, the prior taxable year";
}
@source(IRC_S6103_L, relation = formalizes, coverage = exact, quote = "or, if there is no return filed for such taxpayer for such year, the prior taxable year.")
rule S6103L19BApplicableYearWhenReturnFiled defeasible {
    label en official "the most recent available year is the applicable year when a return was filed for it";
    for taxpayer: Person;
    for yearEnd: Date;
    when applicable_year_for_discount_card_ending(taxpayer, yearEnd)
        and l19_return_filed_for_taxable_year_ending(taxpayer, yearEnd);
    then applicable_year_for_l19(taxpayer, yearEnd);
}
rule S6103L19BApplicableYearFallsBackToPriorYear defeasible {
    label en official "when no return is filed for the most recent available year the prior taxable year is the applicable year";
    for taxpayer: Person;
    for yearEnd: Date;
    for priorEnd: Date;
    when applicable_year_for_discount_card_ending(taxpayer, yearEnd)
        and not_known(l19_return_filed_for_taxable_year_ending(taxpayer, yearEnd))
        and l19_preceding_taxable_year_ending(yearEnd, priorEnd);
    then applicable_year_for_l19(taxpayer, priorEnd);
}

// ============================================================================
// §6103(p)(4)(F) — what a recipient does when its use is complete
// ============================================================================

pub enum PostUseClass {
    RecipientOfClauseI;     // (F)(i): agencies of (d), (i)(3)(B)(i), (k)(10), (l)(6)-(9), (16), appropriate State officers, other listed persons
    RecipientOfClauseII;    // (F)(ii): agencies of (h)(2), (h)(5), (i)(1)-(3), (5), (7), (j), (k), (l), (o), GAO, CBO
    HhsUnderM6;             // (F)(iii)
    label en unofficial "the three classes of recipient of section 6103(p)(4)(F)";
}
pub relation p4f_recipient_class(recipient: Person, class: PostUseClass) kind empirical {
    label en official "the recipient is of the class named in clause (i), (ii) or (iii)";
}
pub relation p4f_use_of_returns_completed_on(recipient: Person, completedOn: Date) kind empirical {
    label en official "the recipient's use of the returns or return information is complete";
}
pub relation p4f_returned_to_secretary(recipient: Person) kind empirical {
    label en official "the returns or return information (with all copies) are returned to the Secretary";
}
pub relation p4f_made_undisclosable(recipient: Person) kind empirical {
    label en official "the returns or return information are otherwise made undisclosable";
}
pub relation p4f_written_report_of_manner_furnished(recipient: Person) kind empirical {
    label en official "a written report describing the manner in which the information was made undisclosable is furnished to the Secretary";
}
pub relation p4f_conditions_continue_to_be_met(recipient: Person) kind empirical {
    label en official "the recipient ensures that the conditions of subparagraphs (A)-(E) continue to be met for the returns or return information not returned or made undisclosable";
}
pub relation p4f_information_destroyed_upon_completion(recipient: Person) kind empirical {
    label en official "all such return information is destroyed so as to make it undisclosable";
}
pub relation p4f_made_part_of_public_record(recipient: Person) kind empirical {
    label en official "the return or return information is disclosed in a judicial or administrative proceeding and made part of its public record";
}
pub relation p4f_clause_i_completed(recipient: Person) kind institutional {
    label en unofficial "clause (i) is satisfied: returned to the Secretary or made undisclosable, with the written report";
}
rule S6103p4FiSatisfiedByReturn defeasible {
    for recipient: Person;
    when p4f_returned_to_secretary(recipient) and p4f_written_report_of_manner_furnished(recipient);
    then p4f_clause_i_completed(recipient);
}
rule S6103p4FiSatisfiedByUndisclosable defeasible {
    for recipient: Person;
    when p4f_made_undisclosable(recipient) and p4f_written_report_of_manner_furnished(recipient);
    then p4f_clause_i_completed(recipient);
}
pub relation p4f_clause_ii_completed(recipient: Person) kind institutional {
    label en unofficial "clause (ii) is satisfied: returned, made undisclosable, or the conditions continue to be met";
}
@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "(I) return to the Secretary such returns or return information (along with any copies made therefrom),")
rule S6103p4FiiIReturned defeasible {
    label en official "clause (ii)(I): the returns are returned to the Secretary";
    for recipient: Person;
    when p4f_returned_to_secretary(recipient);
    then p4f_clause_ii_completed(recipient);
}
@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "(II) otherwise make such returns or return information undisclosable, or")
rule S6103p4FiiIIUndisclosable defeasible {
    label en official "clause (ii)(II): the returns are made undisclosable";
    for recipient: Person;
    when p4f_made_undisclosable(recipient);
    then p4f_clause_ii_completed(recipient);
}
@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "(III) to the extent not so returned or made undisclosable, ensure that the conditions of subparagraphs (A), (B), (C), (D), and (E) of this paragraph continue to be met with respect to such returns or return information, and")
rule S6103p4FiiIIIConditionsContinue defeasible {
    label en official "clause (ii)(III): the safeguard conditions continue to be met for what is not returned or made undisclosable";
    for recipient: Person;
    when p4f_conditions_continue_to_be_met(recipient);
    then p4f_clause_ii_completed(recipient);
}
@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "(F) upon completion of use of such returns or return information—")
rule S6103p4FCompletionOfUseDutyClauseI defeasible {
    label en official "on completion of use a clause (i) recipient returns the returns or makes them undisclosable and furnishes a written report";
    for recipient: Person;
    for completedOn: Date;
    when p4f_recipient_class(recipient, RecipientOfClauseI)
        and p4f_use_of_returns_completed_on(recipient, completedOn)
        and not_known(p4f_made_part_of_public_record(recipient));
    then duty S6103p4FiCompletionDuty {
        bearer recipient;
        beneficiary Secretary;
        goal achievement {
            condition p4f_clause_i_completed(recipient);
            window [completedOn, infinity];
        }
    };
}
@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "(ii) in the case of an agency described in subsection (h)(2), (h)(5), (i)(1), (2), (3), (5) or (7), (j)(1), (2), or (5), (k)(8), (10), (11), or (15), (l)(1), (2), (3), (5), (10), (11), (12), (13)(A), (13)(B), (13)(C), (13)(D)(i), (14), (15), (17), or (22),,[3] (o)(1)(A), or (o)(3) or any entity described in subsection (l)(21), the Government Accountability Office, or the Congressional Budget Office, either—")
rule S6103p4FCompletionOfUseDutyClauseII defeasible {
    label en official "on completion of use a clause (ii) recipient either returns the returns, makes them undisclosable, or ensures the safeguard conditions continue";
    for recipient: Person;
    for completedOn: Date;
    when p4f_recipient_class(recipient, RecipientOfClauseII)
        and p4f_use_of_returns_completed_on(recipient, completedOn)
        and not_known(p4f_made_part_of_public_record(recipient));
    then duty S6103p4FiiCompletionDuty {
        bearer recipient;
        beneficiary Secretary;
        goal achievement {
            condition p4f_clause_ii_completed(recipient);
            window [completedOn, infinity];
        }
    };
}
@source(IRC_S6103_P, relation = formalizes, coverage = exact, quote = "(iii) in the case of the Department of Health and Human Services for purposes of subsection (m)(6), destroy all such return information upon completion of its use in providing the notification for which the information was obtained, so as to make such information undisclosable;")
rule S6103p4FCompletionOfUseDutyClauseIII defeasible {
    label en official "on completion of use the Department of Health and Human Services destroys the return information";
    for recipient: Person;
    for completedOn: Date;
    when p4f_recipient_class(recipient, HhsUnderM6)
        and p4f_use_of_returns_completed_on(recipient, completedOn);
    then duty S6103p4FiiiDestroyDuty {
        bearer recipient;
        beneficiary Secretary;
        goal achievement {
            condition p4f_information_destroyed_upon_completion(recipient);
            window [completedOn, infinity];
        }
    };
}

// ============================================================================
// §6105(b)(3) — tax convention information on the same terms as return information
// ============================================================================

pub relation analogous_return_information_disclosure(d: Disclosure, analog: Disclosure) kind empirical {
    label en official "the return information disclosure whose terms the tax convention disclosure follows (paragraph (3)(C) or (7) of section 6103(i))";
}
pub relation analog_permitted_under_6103i3C_or_i7(analog: Disclosure) kind empirical {
    label en official "the analog disclosure is permitted on the terms of section 6103(i)(3)(C) or (i)(7)";
}
pub relation convention_information_provided_by_foreign_government(info: TaxConventionInformation) kind empirical {
    label en official "the tax convention information was provided by a foreign government";
}
pub relation foreign_government_written_consent_to_disclosure(d: Disclosure) kind empirical {
    label en official "the foreign government consented in writing to the disclosure";
}
pub relation foreign_consent_missing(d: Disclosure, info: TaxConventionInformation) kind institutional {
    label en unofficial "the information came from a foreign government and its written consent is missing";
}
rule S6105b3ForeignConsentMissing defeasible {
    for d: Disclosure;
    for info: TaxConventionInformation;
    when tax_convention_disclosure_of(d, info)
        and convention_information_provided_by_foreign_government(info)
        and not_known(foreign_government_written_consent_to_disclosure(d));
    then foreign_consent_missing(d, info);
}
@source(IRC_S6105_B, relation = formalizes, coverage = exact, quote = "(3) to the disclosure of tax convention information on the same terms as return information may be disclosed under paragraph (3)(C) or (7) of section 6103(i), except that in the case of tax convention information provided by a foreign government, no disclosure may be made under this paragraph without the written consent of the foreign government, or")
rule S6105B3SameTermsAsReturnInformation defeasible {
    label en official "tax convention information may be disclosed on the terms on which return information may be disclosed under 6103(i)(3)(C) or (7), with the foreign government's written consent for its information";
    for d: Disclosure;
    for info: TaxConventionInformation;
    for analog: Disclosure;
    when tax_convention_disclosure_of(d, info)
        and analogous_return_information_disclosure(d, analog)
        and disclosure_permitted(analog)
        and analog_permitted_under_6103i3C_or_i7(analog);
    then tax_convention_disclosure_permitted(d);
    unless foreign_consent_missing(d, info) and tax_convention_disclosure_of(d, info) and analogous_return_information_disclosure(d, analog) and disclosure_permitted(analog) and analog_permitted_under_6103i3C_or_i7(analog);
}

// ============================================================================
// §6110(b)(1)(B), (c), (f)(4)(A), (h)(3)
// ============================================================================

pub relation matter_referred_to_in_6103b2C_or_D(wd: WrittenDetermination) kind empirical {
    label en official "the matter is an advance pricing agreement or an agreement under section 7121 (or their background) referred to in section 6103(b)(2)(C) or (D)";
}
pub relation matter_excluded_from_written_determination(wd: WrittenDetermination) kind institutional {
    label en official "the matter is excluded from the term \"written determination\"";
}
@source(IRC_S6110_B, relation = formalizes, coverage = exact, quote = "Such term shall not include any matter referred to in subparagraph (C) or (D) of section 6103(b)(2).")
rule S6110b1BExcludedMatter strict {
    label en official "a matter referred to in section 6103(b)(2)(C) or (D) is not a written determination";
    for wd: WrittenDetermination;
    when matter_referred_to_in_6103b2C_or_D(wd);
    then matter_excluded_from_written_determination(wd);
}
pub relation secretary_agreed_to_deletions(wd: WrittenDetermination) kind empirical {
    label en official "the Secretary has agreed to the deletions";
}
pub relation court_ordered_deletions_under_f3(wd: WrittenDetermination) kind empirical {
    label en official "a court, in a proceeding under subsection (f)(3), ordered the Secretary to make the deletions";
}
pub relation intentional_or_willful_disregard_of_6110c(wd: WrittenDetermination) kind empirical {
    label en official "the Secretary intentionally or willfully disregards subsection (c)";
}
pub relation secretary_would_be_required_or_liable_for_deletions(wd: WrittenDetermination) kind empirical {
    label en official "the Secretary is called on to make the deletions or to answer for not making them";
}
@source(IRC_S6110_C, relation = formalizes, coverage = exact, quote = "shall not be required to make such deletions (nor be liable for failure to make deletions) unless the Secretary has agreed to such deletions or has been ordered by a court (in a proceeding under subsection (f)(3)) to make such deletions.")
rule S6110cSecretaryNotRequiredNorLiableForDeletions defeasible {
    label en official "except for intentional or willful disregard, the Secretary is not required to make deletions nor liable for not making them unless he agreed or a court ordered them";
    for wd: WrittenDetermination;
    when secretary_would_be_required_or_liable_for_deletions(wd);
    then immunity S6110cDeletionShield {
        holder Secretary;
        protected_effect secretary_would_be_required_or_liable_for_deletions(wd);
        window [-infinity, infinity];
    };
    unless secretary_agreed_to_deletions(wd) and secretary_would_be_required_or_liable_for_deletions(wd);
    unless court_ordered_deletions_under_f3(wd) and secretary_would_be_required_or_liable_for_deletions(wd);
    unless intentional_or_willful_disregard_of_6110c(wd) and secretary_would_be_required_or_liable_for_deletions(wd);
}
pub relation secretary_determines_extent_of_deletions(wd: WrittenDetermination) kind empirical {
    label en official "the Secretary determines the appropriate extent of the deletions";
}
pub relation deletion_extent_set_by_secretary(wd: WrittenDetermination) kind institutional {
    label en official "the Secretary determines the appropriate extent of the deletions";
}
@source(IRC_S6110_C, relation = formalizes, coverage = exact, quote = "The Secretary shall determine the appropriate extent of such deletions and, except in the case of intentional or willful disregard of this subsection,")
rule S6110cSecretaryDeterminesExtent defeasible {
    label en official "the Secretary determines the appropriate extent of the deletions";
    for wd: WrittenDetermination;
    when secretary_determines_extent_of_deletions(wd);
    then deletion_extent_set_by_secretary(wd);
}
pub relation disclosure_action_pending_under_f4(pr: Person, wd: WrittenDetermination) kind empirical {
    label en official "a petition in the Tax Court or a complaint in the District Court for the District of Columbia to obtain additional disclosure of the written determination or background file document";
}
pub relation person_seeks_to_restrain_disclosure(pr: Person, p: Person) kind empirical {
    label en official "the person seeks to restrain disclosure in the proceeding";
}
pub relation burden_of_proof_on_secretary_for_disclosure(pr: Person) kind institutional {
    label en official "the burden of proof with respect to the issue of disclosure of any information is on the Secretary";
}
pub relation burden_of_proof_on_person_restraining_disclosure(pr: Person, p: Person) kind institutional {
    label en official "the burden of proof with respect to the issue of disclosure is also on any other person seeking to restrain disclosure";
}
@source(IRC_S6110_F, relation = formalizes, coverage = exact, quote = "The burden of proof with respect to the issue of disclosure of any information shall be on the Secretary and any other person seeking to restrain disclosure.")
rule S6110f4ABurdenOnSecretary defeasible {
    label en official "the Secretary bears the burden of proof on disclosure in an action under (f)(4)";
    for pr: Person;
    for wd: WrittenDetermination;
    when disclosure_action_pending_under_f4(pr, wd);
    then burden_of_proof_on_secretary_for_disclosure(pr);
}
rule S6110f4ABurdenOnRestrainingPerson defeasible {
    label en official "any other person seeking to restrain disclosure also bears the burden of proof";
    for pr: Person;
    for wd: WrittenDetermination;
    for p: Person;
    when disclosure_action_pending_under_f4(pr, wd) and person_seeks_to_restrain_disclosure(pr, p);
    then burden_of_proof_on_person_restraining_disclosure(pr, p);
}
pub enum ReleaseCategory {
    ReferenceUnderThisTitle;       // (h)(3)(A)
    GeneralIssuedAfterJuly41967;   // (h)(3)(B)
    ReferenceUnder1939Code;        // (h)(3)(C)
    GeneralNotInB;                 // last sentence of (h)(3): on written request, after (A)-(C)
    label en unofficial "the categories of the order of release of section 6110(h)(3)";
}
pub relation written_determination_release_category(wd: WrittenDetermination, category: ReleaseCategory) kind empirical {
    label en official "the category of the written determination in the order of release";
}
pub relation written_determination_issue_date(wd: WrittenDetermination, issuedOn: Date) kind empirical {
    label en official "the date the written determination was issued";
}
pub relation release_category_rank(category: ReleaseCategory, rank: Integer) kind institutional {
    label en unofficial "the position of the category in the order of release";
}
rule S6110h3ARank strict { then release_category_rank(ReferenceUnderThisTitle, 1); }
rule S6110h3BRank strict { then release_category_rank(GeneralIssuedAfterJuly41967, 2); }
rule S6110h3CRank strict { then release_category_rank(ReferenceUnder1939Code, 3); }
rule S6110h3DRank strict { then release_category_rank(GeneralNotInB, 4); }
pub relation must_open_before(first: WrittenDetermination, later: WrittenDetermination) kind institutional {
    label en official "the first written determination must be open to public inspection before the later one: an earlier category, or the same category and issued later (most recent first)";
}
@source(IRC_S6110_H, relation = formalizes, coverage = exact, quote = "shall be open or available to public inspection in the following order starting with the most recent written determination in each category:")
rule S6110h3EarlierCategoryFirst defeasible {
    label en official "a determination of an earlier category is opened before one of a later category";
    for first: WrittenDetermination;
    for later: WrittenDetermination;
    for c1: ReleaseCategory;
    for c2: ReleaseCategory;
    for r1: Integer;
    for r2: Integer;
    when written_determination_release_category(first, c1)
        and written_determination_release_category(later, c2)
        and release_category_rank(c1, r1)
        and release_category_rank(c2, r2)
        and r1 < r2;
    then must_open_before(first, later);
}
rule S6110h3MostRecentFirstWithinCategory defeasible {
    label en official "within a category the most recent determination is opened first";
    for first: WrittenDetermination;
    for later: WrittenDetermination;
    for c: ReleaseCategory;
    for i1: Date;
    for i2: Date;
    when written_determination_release_category(first, c)
        and written_determination_release_category(later, c)
        and written_determination_issue_date(first, i1)
        and written_determination_issue_date(later, i2)
        and i1 > i2;
    then must_open_before(first, later);
}
pub relation exists_written_determination_open_date(wd: WrittenDetermination) kind institutional {
    label en unofficial "existential wrapper over the dates the determination is open to inspection";
}
rule S6110h3ExistsOpenDate defeasible {
    for wd: WrittenDetermination;
    for openOn: Date;
    when written_determination_open_on(wd, openOn);
    then exists_written_determination_open_date(wd);
}
pub relation opening_out_of_order(later: WrittenDetermination) kind institutional {
    label en official "the determination was opened while one that must be opened before it was still closed";
}
@source(IRC_S6110_H, relation = formalizes, coverage = exact, quote = "(A) reference written determinations issued under this title;")
rule S6110h3OpenedBeforeAPredecessorOpened defeasible {
    label en official "the determination is opened before a determination that must come first is opened";
    for first: WrittenDetermination;
    for later: WrittenDetermination;
    for firstOn: Date;
    for laterOn: Date;
    when must_open_before(first, later)
        and written_determination_open_on(first, firstOn)
        and written_determination_open_on(later, laterOn)
        and firstOn > laterOn;
    then opening_out_of_order(later);
}
rule S6110h3OpenedWhilePredecessorNeverOpened defeasible {
    label en official "the determination is opened while a determination that must come first was never opened";
    for first: WrittenDetermination;
    for later: WrittenDetermination;
    for laterOn: Date;
    when must_open_before(first, later)
        and written_determination_open_on(later, laterOn)
        and not_known(exists_written_determination_open_date(first));
    then opening_out_of_order(later);
}
@source(IRC_S6110_H, relation = formalizes, coverage = exact, quote = "General written determinations not described in subparagraph (B) shall be open to public inspection on written request, but not until after the written determinations referred to in subparagraphs (A), (B), and (C) are open to public inspection.")
rule S6110h3OrderOfReleaseProhibition defeasible {
    label en official "written determinations shall be opened in the prescribed order";
    for later: WrittenDetermination;
    for openOn: Date;
    when opening_out_of_order(later) and written_determination_open_on(later, openOn);
    then prohibition S6110h3OpenOutOfOrderProhibition {
        bearer Secretary;
        action written_determination_open_on(later, openOn);
        window [-infinity, infinity];
    };
}
