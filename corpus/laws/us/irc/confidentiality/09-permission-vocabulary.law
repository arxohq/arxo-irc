pub relation recipient_is(d: Disclosure, class: Recipient) kind empirical {
    label en unofficial "case fact: the recipient of the disclosure d receives it in this capacity (a recipient class named by the paragraph that permits the disclosure)";
}

pub relation disclosure_upon_written_request(d: Disclosure) kind empirical {
    label en unofficial "case fact: the disclosure was made upon a written request, where the paragraph that permits it operates only upon written request";
}

pub relation recipient_organ(d: Disclosure, organ: Organ) kind empirical {
    label en unofficial "case fact: the organ (agency, body, committee) to which, or on behalf of which, the disclosure d is made";
}

pub const JointCommitteeOnTaxation: Organ = entity_ref("urn:us:irc:confidentiality:clir#JointCommitteeOnTaxation") {
    label en unofficial "the Joint Committee on Taxation (declared here because the constant of `us.irc.joint_committee` is not `pub`; same body, own URN — recorded in the dependency file)";
}

pub const President: Organ = entity_ref("urn:us:irc:confidentiality:clir#President") {
    label en unofficial "the President of the United States";
}

pub const DepartmentOfJustice: Organ = entity_ref("urn:us:irc:confidentiality:clir#DepartmentOfJustice") {
    label en unofficial "the Department of Justice";
}

pub const TreasuryInspectorGeneralForTaxAdministration: Organ = entity_ref("urn:us:irc:confidentiality:clir#TreasuryInspectorGeneralForTaxAdministration") {
    label en unofficial "the Treasury Inspector General for Tax Administration";
}

pub const Commissioner: Organ = entity_ref("urn:us:irc:definitions:clir#commissioner") {
    label en unofficial "the Commissioner of Internal Revenue (same URN as the `us.irc.definitions` constant, which is not imported here)";
}

pub const CommissionerOfSocialSecurity: Organ = entity_ref("urn:us:irc:confidentiality:clir#CommissionerOfSocialSecurity") {
    label en unofficial "the Commissioner of Social Security";
}

pub const ComptrollerGeneral: Organ = entity_ref("urn:us:irc:confidentiality:clir#ComptrollerGeneral") {
    label en unofficial "the Comptroller General of the United States";
}
