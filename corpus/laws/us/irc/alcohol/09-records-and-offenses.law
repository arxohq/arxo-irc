// Sections 5555 (records, statements, and returns), 5601(a) (criminal
// penalties), 5611 (release of distillery before judgment), 5612
// (forfeiture of taxpaid distilled spirits remaining on bonded premises).

// --- Section 5555(a): records/statements/returns duty (maintenance) --------

use self::{
    DistilledSpiritsPlant,
    IRC_S5555_A,
    IRC_S5601_A,
    IRC_S5612_A,
    Person,
    SpiritsRemoval,
    operates_as_distiller_warehouseman_or_processor,
    plant_registered,
    records_requirement_waived,
};

pub relation is_liable_under_chapter51(p: Person) kind empirical {
    label en official "p is liable to a tax imposed by chapter 51, or for the collection thereof (section 5555(a))";
}
pub relation keeps_required_records_and_returns(p: Person) kind empirical {
    label en official "the person keeps the records, renders the statements, makes the returns, and complies with the rules and regulations the Secretary prescribes under section 5555(a)";
}
@source(IRC_S5555_A, coverage = exact, quote = "Every person liable to any tax imposed by this chapter, or for the collection thereof, shall keep such records, render such statements, make such returns, and comply with such rules and regulations as the Secretary may prescribe.")
rule Section5555aRecordsDutyRule(p: Person) defeasible {
    label en official "section 5555(a): the recordkeeping/statement/return duty of every person liable to chapter 51 tax or for its collection, lifted by a waiver under section 5555(b) (stage 3)";
    when is_liable_under_chapter51(p);
    unless records_requirement_waived(p) and is_liable_under_chapter51(p);
    then duty Section5555RecordsDuty {
        bearer p;
        goal maintenance {
            condition keeps_required_records_and_returns(p);
            window [-infinity, infinity];
        }
    };
}
// (b): the Secretary's power to WAIVE the requirement (not the payment of
// tax) is an institutional effect on the duty above, not a separate
// obligation — TECH_GAP/INTERPRETATION this stage: no rule models a waiver
// LIFTING the maintenance duty's condition (the duty as modelled has no
// escape once waived). (c): authorization to retain photographic/microfilm
// reproductions in lieu of originals is NON_NORMATIVE relative to the
// records duty itself (a method-of-compliance permission, not a new norm).

// --- Section 5601(a): criminal penalties (classification, not execution) ---
//
// Thirteen offense elements (numbered paragraphs (1)-(15), two numbers
// reserved/renumbered in the current text) each describe conduct that
// constitutes a FEDERAL CRIME; the punishment ("fined not more than
// $10,000, or imprisoned not more than 5 years, or both") is adjudicated by
// a court, not computed by this package (method: "no criminal conclusion
// from a civil breach"). Modelled as a `classification` of the conduct as
// an offense under section 5601(a), with the punishment itself an
// EXTERNAL_DEPENDENCY (judicial). Only paragraph (a)(2) (engaging in the
// business of distiller/processor without the section 5171(c) registration)
// is named in the "fully" priority list; the sibling offense elements this
// package already has the underlying conduct predicates for
// (unregistered-operation of module 07) are modelled alongside it since
// they share the identical structure, the rest of (a)(1),(3)-(15) stay
// `unreviewed` (their own conduct predicates — unregistered stills,
// forged bonds, unlawful mash fermentation, etc. — are sections 5171-5182,
// 5216-5223, 5601-5650 territory this stage does not own the underlying
// facts for).

pub relation section_5601a_offense(p: Person, paragraph: Text) kind institutional {
    label en official "the person's conduct falls within a numbered offense element of section 5601(a) (the paragraph identifies which)";
}
@source(IRC_S5601_A, coverage = exact, quote = "engages in the business of a distiller or processor without having filed application for and received notice of registration, as required by section 5171(c)")
rule Section5601a2OffenseClassificationRule(p: Person, plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5601(a)(2): engaging in the business of a distiller or processor without the section 5171(c) registration is a section 5601(a) offense (classification only — the fine/imprisonment sentence is the court's own judgment, EXTERNAL_DEPENDENCY)";
    when operates_as_distiller_warehouseman_or_processor(p, plant);
    unless plant_registered(plant, p) and operates_as_distiller_warehouseman_or_processor(p, plant);
    then section_5601a_offense(p, "5601(a)(2)");
}
pub relation section_5601a_punishment(p: Person, paragraph: Text) kind institutional {
    label en unofficial "the section 5601(a) punishment (fine of not more than $10,000, imprisonment of not more than 5 years, or both) for this offense — a court's own sentencing judgment, not computed here (EXTERNAL_DEPENDENCY: judicial)";
}
// (b): the evidentiary presumption from the defendant's presence at the
// site/time of an unbonded operation (rebuttable to the jury's/court's
// satisfaction) is itself an EVALUATIVE/adjudicative fact-finding rule
// (DECISION-0194, court channel), not an arithmetic guard — not modelled.

// --- Section 5611: release of distillery before judgment (court power) -----
//
// The court's OWN discretionary power to release a seized distillery to a
// receiver pending final judgment is an institutional effect of a judicial
// proceeding this package does not own the underlying `Proceeding`/seizure
// facts for beyond `us.irc.core::Proceeding`/`Lien`/`Levy` identity —
// EXTERNAL_DEPENDENCY (judicial discretion, "in the discretion of the
// court"), not modelled as an executable power this stage.

// --- Section 5612: forfeiture of taxpaid spirits remaining on bonded premises

pub relation taxpaid_spirits_on_bonded_premises(r: SpiritsRemoval, plant: DistilledSpiritsPlant) kind empirical {
    label en official "distilled spirits on which tax has been paid or determined are stored or remain on the bonded premises of a distilled spirits plant (section 5612(a))";
}
pub relation in_process_of_prompt_removal(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are in the process of prompt removal from bonded premises on payment or determination of the tax (section 5612(b)(1))";
}
pub relation returned_under_5215a(r: SpiritsRemoval) kind empirical {
    label en official "the spirits were returned to bonded premises in accordance with section 5215(a) (section 5612(b)(2))";
}
pub relation forfeited_under_5612(r: SpiritsRemoval, plant: DistilledSpiritsPlant) kind institutional {
    label en official "the distilled spirits are forfeited under section 5612(a) for remaining, taxpaid, on bonded premises";
}
pub relation exempt_from_5612_forfeiture(r: SpiritsRemoval) kind institutional {
    label en unofficial "either section 5612(b) exception applies (single-atom helper for the unless clause)";
}
rule ExemptFromForfeitureByPromptRemovalRule(r: SpiritsRemoval) strict {
    label en unofficial "exempt because the spirits are in the process of prompt removal";
    when in_process_of_prompt_removal(r);
    then exempt_from_5612_forfeiture(r);
}
rule ExemptFromForfeitureByReturnRule(r: SpiritsRemoval) strict {
    label en unofficial "exempt because the spirits were returned under section 5215(a)";
    when returned_under_5215a(r);
    then exempt_from_5612_forfeiture(r);
}
@source(IRC_S5612_A, coverage = exact, quote = "No distilled spirits on which tax has been paid or determined shall be stored or allowed to remain on the bonded premises of any distilled spirits plant, under the penalty of forfeiture of all spirits so found.")
rule Section5612ForfeitureRule(r: SpiritsRemoval, plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5612(a): taxpaid spirits stored or remaining on bonded premises are forfeited, unless they are in the process of prompt removal or were returned under section 5215(a) (section 5612(b))";
    when taxpaid_spirits_on_bonded_premises(r, plant);
    unless exempt_from_5612_forfeiture(r) and taxpaid_spirits_on_bonded_premises(r, plant);
    then forfeited_under_5612(r, plant);
}
