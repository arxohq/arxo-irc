// Section 5041 — Imposition and rate of tax (wine), subsections (a)-(c).
// (d)-(h) (wine-gallon definition, tolerances, non-bonded production,
// hard-cider/mead/low-ABV-wine classification tests) stay `unreviewed`
// this stage except where a rule below needs to cite them directly.

use self::{
    IRC_S5041_A,
    IRC_S5041_B,
    IRC_S5041_C,
    Person,
    SemiGenericWineName,
    wine_taxed_as_hard_cider,
};

pub entity WineRemoval {
    label en unofficial "a removal (for consumption or sale) of wine, or a wine production event outside bonded premises taxed under section 5041(f) — the taxable event of section 5041(a)";
}
pub enum WineClass { StillLow; StillMedium; StillHigh; Champagne; ArtificiallyCarbonated; HardCider; }
pub relation wine_removal_class(w: WineRemoval, class: WineClass) kind empirical {
    label en official "the section 5041(b) rate class this wine removal falls into — case-asserted per the wine's own alcohol content/carbonation/composition tests of section 5041(a),(g),(h) (those classification tests themselves are INTERPRETATION-folded into this fact this stage, not independently derived)";
}
pub relation removed_wine_gallons(w: WineRemoval, gallons: Decimal) kind empirical {
    label en official "the quantity of wine in this removal, in wine gallons (section 5041(a)/(d))";
}
pub relation wine_removed_by(w: WineRemoval, producer: Person) kind empirical {
    label en official "the person (producer, or electing importer under (c)(6)) who removed this wine for consumption or sale";
}
pub relation wine_removed_in_calendar_year(w: WineRemoval, year: Integer) kind empirical {
    label en official "the calendar year of the wine removal (section 5041(c)(1))";
}
pub relation prior_ytd_wine_gallons(w: WineRemoval, gallons: Decimal) kind empirical {
    label en unofficial "the producer's cumulative wine gallons already removed for consumption or sale in the SAME calendar year, before this removal — case-asserted running total (same judgment call as the section 5001(c) tiers: no self-accumulating ledger is derived, TECH_GAP)";
}

// --- (a)/(b): imposition and rate by class -----------------------------------

pub relation wine_tax(w: WineRemoval, amount: Money) kind institutional {
    label en official "the tax imposed by section 5041(a) on this removal of wine, before the section 5041(c) credit";
}
@source(IRC_S5041_A, coverage = partial, quote = "having not in excess of 24 percent of alcohol by volume, in bond in, produced in, or imported into, the United States, taxes at the rates shown in subsection (b), such taxes to be determined as of the time of removal for consumption or sale.")
rule Section5041aStillLowRateRule(w: WineRemoval, gallons: Decimal) strict {
    label en official "section 5041(b)(1): $1.07 per wine gallon on still wines not more than 16 percent alcohol by volume";
    when wine_removal_class(w, StillLow);
    when removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateStillLow);
}
@source(IRC_S5041_B, coverage = exact, quote = "On still wines containing more than 16 percent and not exceeding 21 percent of alcohol by volume, $1.57 per wine gallon;")
rule Section5041bStillMediumRateRule(w: WineRemoval, gallons: Decimal) strict {
    label en official "section 5041(b)(2): $1.57 per wine gallon on still wines more than 16 and not exceeding 21 percent alcohol by volume";
    when wine_removal_class(w, StillMedium);
    when removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateStillMedium);
}
@source(IRC_S5041_B, coverage = exact, quote = "On still wines containing more than 21 percent and not exceeding 24 percent of alcohol by volume, $3.15 per wine gallon;")
rule Section5041bStillHighRateRule(w: WineRemoval, gallons: Decimal) strict {
    label en official "section 5041(b)(3): $3.15 per wine gallon on still wines more than 21 and not exceeding 24 percent alcohol by volume";
    when wine_removal_class(w, StillHigh);
    when removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateStillHigh);
}
@source(IRC_S5041_B, coverage = exact, quote = "On champagne and other sparkling wines, $3.40 per wine gallon;")
rule Section5041bChampagneRateRule(w: WineRemoval, gallons: Decimal) strict {
    label en official "section 5041(b)(4): $3.40 per wine gallon on champagne and other sparkling wines";
    when wine_removal_class(w, Champagne);
    when removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateChampagne);
}
@source(IRC_S5041_B, coverage = exact, quote = "On artificially carbonated wines, $3.30 per wine gallon; and")
rule Section5041bArtificiallyCarbonatedRateRule(w: WineRemoval, gallons: Decimal) strict {
    label en official "section 5041(b)(5): $3.30 per wine gallon on artificially carbonated wines";
    when wine_removal_class(w, ArtificiallyCarbonated);
    when removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateArtificiallyCarbonated);
}
@source(IRC_S5041_B, coverage = exact, quote = "On hard cider, 22.6 cents per wine gallon.")
rule Section5041bHardCiderRateRule(w: WineRemoval, gallons: Decimal) strict {
    label en official "section 5041(b)(6): 22.6 cents per wine gallon on hard cider";
    when wine_removal_class(w, HardCider);
    when removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateHardCider);
}
@source(IRC_S5041_A, coverage = exact, quote = "All wines containing more than 24 percent of alcohol by volume shall be classed as distilled spirits and taxed accordingly.")
rule Section5041aOver24PctClassifiedAsSpiritsRule strict {
    label en official "section 5041(a), second sentence: wine over 24 percent alcohol by volume is taxed under section 5001 as distilled spirits, not under section 5041 (classification cross-reference to module 01, not a second wine-tax rule)";
    for w: WineRemoval;
    when wine_over_24_pct_abv(w);
    then classified_as_distilled_spirits(w);
}
pub relation wine_over_24_pct_abv(w: WineRemoval) kind empirical {
    label en official "the wine removed exceeds 24 percent alcohol by volume (section 5001(a)(3)/5041(a))";
}
pub relation classified_as_distilled_spirits(w: WineRemoval) kind institutional {
    label en official "the article is classified and taxed as distilled spirits under section 5001, not as wine under section 5041 (section 5041(a))";
}

// --- (c): small-producer/importer tax credit, cumulative tiers --------------

pub relation wine_credit_applies(w: WineRemoval) kind institutional {
    label en official "the removal is eligible for the section 5041(c) credit (a removal by the producer, or by an electing importer under paragraph (6) — the foreign-producer assignment/transferee mechanism of (c)(5)-(6) is not separately modelled this stage, see the package report)";
}
pub relation is_wine_producer(p: Person) kind empirical {
    label en unofficial "positive anchor: p is asserted by the case as the producer of the wine removed (section 5041(c)(1)(A))";
}
@source(IRC_S5041_C, coverage = partial, quote = "There shall be allowed as a credit against any tax imposed by this title (other than chapters 2, 21, and 22) an amount equal to the sum of")
rule Section5041cCreditEligibilityRule(w: WineRemoval, p: Person) strict {
    label en official "section 5041(c)(1)(A): the credit is available to the wine's own producer's removals";
    when wine_removed_by(w, p);
    when is_wine_producer(p);
    then wine_credit_applies(w);
}
pub relation wine_credit_tier1_portion(w: WineRemoval, gallons: Decimal) kind institutional {
    label en official "the portion of this removal's wine gallons within the first (c)(1)(A)(i) tier";
}
pub relation wine_credit_tier2_portion(w: WineRemoval, gallons: Decimal) kind institutional {
    label en official "the portion of this removal's wine gallons within the second (c)(1)(A)(ii) tier";
}
pub relation wine_credit_tier3_portion(w: WineRemoval, gallons: Decimal) kind institutional {
    label en official "the portion of this removal's wine gallons within the third (c)(1)(A)(iii) tier";
}
@source(IRC_S5041_C, relation = formalizes, coverage = exact, quote = "$1 per wine gallon on the first 30,000 wine gallons of wine, plus")
rule Section5041cTier1PortionRule(w: WineRemoval, prior: Decimal, gallons: Decimal) strict {
    label en official "the slice of this removal inside [0, 30000) wine gallons of the producer's calendar-year cumulative total";
    when wine_credit_applies(w);
    when prior_ytd_wine_gallons(w, prior);
    when removed_wine_gallons(w, gallons);
    then wine_credit_tier1_portion(w, max(0.0, min(prior + gallons, WineCreditTier1Cap) - prior));
}
@source(IRC_S5041_C, relation = formalizes, coverage = exact, quote = "90 cents per wine gallon on the first 100,000 wine gallons of wine to which clause (i) does not apply, plus")
rule Section5041cTier2PortionRule(w: WineRemoval, prior: Decimal, gallons: Decimal) strict {
    label en official "the slice of this removal inside [30000, 130000) wine gallons of the producer's calendar-year cumulative total";
    when wine_credit_applies(w);
    when prior_ytd_wine_gallons(w, prior);
    when removed_wine_gallons(w, gallons);
    then wine_credit_tier2_portion(w, max(0.0, min(prior + gallons, WineCreditTier1Cap + WineCreditTier2Cap) - max(prior, WineCreditTier1Cap)));
}
@source(IRC_S5041_C, relation = formalizes, coverage = exact, quote = "53.5 cents per wine gallon on the first 620,000 wine gallons of wine to which clauses (i) and (ii) do not apply,")
rule Section5041cTier3PortionRule(w: WineRemoval, prior: Decimal, gallons: Decimal) strict {
    label en official "the slice of this removal inside [130000, 750000) wine gallons of the producer's calendar-year cumulative total";
    when wine_credit_applies(w);
    when prior_ytd_wine_gallons(w, prior);
    when removed_wine_gallons(w, gallons);
    then wine_credit_tier3_portion(w, max(0.0, min(prior + gallons, WineCreditTier1Cap + WineCreditTier2Cap + WineCreditTier3Cap) - max(prior, WineCreditTier1Cap + WineCreditTier2Cap)));
}
pub relation wine_credit_amount(w: WineRemoval, amount: Money) kind institutional {
    label en official "the total section 5041(c)(1) credit against the tax on this wine removal";
}
@source(IRC_S5041_C, coverage = exact, quote = "an amount equal to the sum of")
rule Section5041cCreditAmountRule(w: WineRemoval, t1: Decimal, t2: Decimal, t3: Decimal) strict {
    label en official "section 5041(c)(1)(A): the credit is the sum of each tier's portion times its own per-gallon rate";
    when wine_credit_tier1_portion(w, t1);
    when wine_credit_tier2_portion(w, t2);
    when wine_credit_tier3_portion(w, t3);
    when not_known(wine_taxed_as_hard_cider(w));
    then wine_credit_amount(w, t1 * WineCreditTier1Rate + t2 * WineCreditTier2Rate + t3 * WineCreditTier3Rate);
}
// (c)(1)(B): the hard-cider variant substitutes 6.2/5.6/3.3 cents for the
// three rates above — a distinct rate set for HardCider-class removals;
// TECH_GAP this stage (not pinned as separate .lawparam.json values, since
// the "fully" priority list stops at (c) in general and does not name the
// hard-cider sub-variant specifically); flagged, not silently applied.
