// Stage 2. Subchapter B (distilled spirits plants) parts II-IX:
// 5201-5207 general and records, 5211-5215 operations on bonded premises,
// 5221-5223 production, 5231-5236 storage and import transfers, 5241-5243
// denaturation, 5271-5276 permits, 5291 returns, 5301 containers,
// 5311-5314 miscellaneous. Where a norm says "under such regulations as the
// Secretary may prescribe" without stating a testable condition the row is
// EXTERNAL_DEPENDENCY in the coverage file and no rule is written.

use self::{
    AlcoholicLot,
    DistilledSpiritsPlant,
    IRC_S5203_A,
    IRC_S5203_B,
    IRC_S5203_C,
    IRC_S5203_D,
    IRC_S5206_D,
    IRC_S5206_E,
    IRC_S5207_A,
    IRC_S5207_C,
    IRC_S5211,
    IRC_S5212,
    IRC_S5213,
    IRC_S5214_A,
    IRC_S5215_A,
    IRC_S5215_C,
    IRC_S5221_A,
    IRC_S5222_A,
    IRC_S5223_D,
    IRC_S5223_E,
    IRC_S5231,
    IRC_S5232_A,
    IRC_S5232_B,
    IRC_S5236,
    IRC_S5242,
    IRC_S5271_A,
    IRC_S5271_C,
    IRC_S5271_E,
    IRC_S5271_F,
    IRC_S5271_G,
    IRC_S5272_B,
    IRC_S5273_A,
    IRC_S5273_B,
    IRC_S5273_D,
    IRC_S5275,
    IRC_S5291_A,
    IRC_S5301_C,
    IRC_S5301_D,
    IRC_S5311,
    IRC_S5314_A,
    IRC_S5314_B,
    Person,
    SpiritsRemoval,
    is_proprietor_of_producing_plant,
};

pub const SpiritsMinimumProofForRedistillationOrDenaturationOfImports: Decimal = 185.0 {
    label en official "imported bulk spirits transferred to a plant may be redistilled or denatured only if of 185 degrees or more of proof (section 5232(b)(1))";
};
pub const PermitDormancyYears: Integer = 2 {
    label en official "a permit holder has not engaged in any authorized operation for a period of more than 2 years (section 5271(e)(8))";
};
pub const SameControlledGroupBulkWaiverAfter: Date = @2017-12-31 {
    label en official "spirits transferred in bond AFTER December 31, 2017 between premises of the same person or controlled group are treated without regard to bulk (section 5212; Pub. L. 115-97, section 13808(b))";
};

// =============================================================================
// Section 5203: keys, entry, facilities, breaking up grounds
// =============================================================================

pub relation is_proprietor_of_plant(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the person is the proprietor of the distilled spirits plant";
}
pub relation keys_furnished_and_premises_kept_accessible(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the proprietor has furnished the Secretary the keys internal revenue officers require to gain access and the premises are always kept accessible to any officer having such keys (section 5203(a))";
}
@source(IRC_S5203_A, coverage = exact, quote = "Every proprietor of a distilled spirits plant shall furnish the Secretary such keys as may be required for internal revenue officers to gain access to the premises and any structures thereon, and such premises shall always be kept accessible to any officer having such keys.")
rule Section5203aKeysDutyRule(p: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5203(a): every proprietor furnishes the keys needed for officers' access and keeps the premises accessible";
    when is_proprietor_of_plant(p, plant);
    then duty Section5203aKeysDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition keys_furnished_and_premises_kept_accessible(p, plant);
            window [-infinity, infinity];
        }
    };
}
pub relation officer_enters_plant_or_operations_premises(o: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "an internal revenue officer enters a distilled spirits plant or other premises where distilled spirits operations are carried on, examines materials, equipment, and facilities, and makes gauges and inventories (section 5203(b))";
}
pub relation is_internal_revenue_officer(o: Person) kind empirical {
    label en official "the person is an internal revenue officer";
}
@source(IRC_S5203_B, coverage = exact, quote = "It shall be lawful for any internal revenue officer at all times, as well by night as by day, to enter any distilled spirits plant")
rule Section5203bEntryLibertyRule(o: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5203(b): it is lawful for an internal revenue officer at all times, by night or by day, to enter a plant or other premises where operations are carried on, examine, and make gauges and inventories; force may be used to gain entry after a demand for admittance is refused";
    when is_internal_revenue_officer(o);
    when officer_enters_plant_or_operations_premises(o, plant);
    then liberty Section5203bOfficerEntry {
        holder o;
        action officer_enters_plant_or_operations_premises(o, plant);
        window [-infinity, infinity];
    };
}
pub entity OfficerDemandForFacilities {
    label en unofficial "a demand by an internal revenue officer or agent for facilities and assistance to gauge or examine (section 5203(c))";
}
pub relation officer_demands_facilities_on(d: OfficerDemandForFacilities, proprietor: Person, plant: DistilledSpiritsPlant, on: Date) kind empirical {
    label en official "the officer or agent demands that the proprietor furnish the necessary facilities and assistance, and open doors, boxes, packages, casks, barrels, and other vessels (section 5203(c))";
}
pub relation proprietor_furnished_facilities_and_opened_vessels(d: OfficerDemandForFacilities) kind empirical {
    label en official "the proprietor furnished the necessary facilities and assistance to gauge and examine and opened the requested doors, boxes, packages, casks, barrels, and vessels";
}
@source(IRC_S5203_C, coverage = exact, quote = "On the demand of any internal revenue officer or agent, every proprietor of a distilled spirits plant shall furnish the necessary facilities and assistance to enable the officer or agent to gauge the spirits in any container or to examine any apparatus, equipment, containers, or materials on such premises.")
rule Section5203cFacilitiesDutyRule(d: OfficerDemandForFacilities, p: Person, plant: DistilledSpiritsPlant, on: Date) strict {
    label en official "section 5203(c): on the officer's demand the proprietor furnishes facilities and assistance and opens vessels; INTERPRETATION: 'on demand' is modelled as the day of the demand (window [demand date, demand date]) because the text names no later time";
    when officer_demands_facilities_on(d, p, plant, on);
    then duty Section5203cFacilitiesOnDemandDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition proprietor_furnished_facilities_and_opened_vessels(d);
            window [on, on];
        }
    };
}
pub relation officer_or_aide_breaks_up_ground_or_walls_to_search(o: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the officer, or a person acting in his aid, breaks up the ground of a plant, adjoining ground, or a wall or partition to search for any pipe, cock, private conveyance, or utensil (section 5203(d))";
}
@source(IRC_S5203_D, coverage = partial, quote = "It shall be lawful for any internal revenue officer, and any person acting in his aid, to break up the ground on any part of a distilled spirits plant")
rule Section5203dBreakUpGroundLibertyRule(o: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5203(d): it is lawful for an officer, and a person acting in his aid, to break up ground or walls at or near a plant to search for a concealed pipe, cock, conveyance, or utensil and to break the conveyance found";
    when is_internal_revenue_officer(o);
    when officer_or_aide_breaks_up_ground_or_walls_to_search(o, plant);
    then liberty Section5203dBreakUpGround {
        holder o;
        action officer_or_aide_breaks_up_ground_or_walls_to_search(o, plant);
        window [-infinity, infinity];
    };
}

// =============================================================================
// Section 5206: containers — scope and effacing marks
// =============================================================================

pub entity SpiritsContainer {
    label en unofficial "a container (or case) of distilled spirits";
}
pub relation container_is_for_industrial_use(c: SpiritsContainer) kind empirical {
    label en official "the container holds distilled spirits for industrial use (section 5206(e))";
}
pub relation container_capacity_over_one_gallon(c: SpiritsContainer) kind empirical {
    label en official "the container has a capacity of more than one gallon (section 5206(e))";
}
pub relation container_is_case_of_bottles_or_containers(c: SpiritsContainer) kind empirical {
    label en official "the container is a case containing bottles or other containers of distilled spirits (section 5206(e))";
}
pub relation container_is_for_non_industrial_use(c: SpiritsContainer) kind empirical {
    label en official "the container holds spirits for other than industrial use";
}
pub relation section_5206_applies_to_container(c: SpiritsContainer) kind institutional {
    label en official "section 5206 applies exclusively to containers for industrial use, containers of more than one gallon for other than industrial use, and cases containing bottles or other containers (section 5206(e))";
}
@source(IRC_S5206_E, coverage = exact, quote = "This section shall be applicable exclusively with respect to containers of distilled spirits for industrial use")
rule Section5206eIndustrialScopeRule(c: SpiritsContainer) strict {
    label en official "section 5206(e): industrial-use containers are within section 5206";
    when container_is_for_industrial_use(c);
    then section_5206_applies_to_container(c);
}
@source(IRC_S5206_E, coverage = exact, quote = "with respect to containers of distilled spirits of a capacity of more than one gallon for other than industrial use")
rule Section5206eLargeNonIndustrialScopeRule(c: SpiritsContainer) strict {
    label en official "section 5206(e): non-industrial containers of more than one gallon are within section 5206";
    when container_is_for_non_industrial_use(c);
    when container_capacity_over_one_gallon(c);
    then section_5206_applies_to_container(c);
}
@source(IRC_S5206_E, coverage = exact, quote = "and with respect to cases containing bottles or other containers of distilled spirits")
rule Section5206eCasesScopeRule(c: SpiritsContainer) strict {
    label en official "section 5206(e): cases containing bottles or other containers are within section 5206";
    when container_is_case_of_bottles_or_containers(c);
    then section_5206_applies_to_container(c);
}
pub entity ContainerEmptying {
    label en unofficial "the emptying of a container of distilled spirits bearing a mark or brand required by law";
}
pub relation container_emptied_by(e: ContainerEmptying, p: Person, c: SpiritsContainer, on: Date) kind empirical {
    label en official "the person empties or causes to be emptied the container, on this date (section 5206(d))";
}
pub relation container_bears_required_mark_or_brand(c: SpiritsContainer) kind empirical {
    label en official "the container bears a mark or brand required by law or regulations (section 5206(d))";
}
pub relation mark_effaced_and_obliterated_at_emptying(e: ContainerEmptying) kind empirical {
    label en official "the mark or brand is effaced and obliterated at the time of emptying (section 5206(d))";
}
pub relation efface_requirement_waived_by_regulation(c: SpiritsContainer) kind empirical {
    label en official "the Secretary has by regulations waived the effacing requirement for containers where no jeopardy to the revenue is involved (section 5206(d) proviso)";
}
@source(IRC_S5206_D, coverage = exact, quote = "shall at the time of emptying such container efface and obliterate such mark or brand")
rule Section5206dEffaceDutyRule(e: ContainerEmptying, p: Person, c: SpiritsContainer, on: Date) defeasible {
    label en official "section 5206(d): whoever empties a container bearing a required mark or brand effaces and obliterates it at the time of emptying, unless the Secretary has waived the requirement; INTERPRETATION: 'at the time' = the day of emptying";
    when container_emptied_by(e, p, c, on);
    when container_bears_required_mark_or_brand(c);
    unless efface_requirement_waived_by_regulation(c) and container_emptied_by(e, p, c, on) and container_bears_required_mark_or_brand(c);
    then duty Section5206dEffaceMarkDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition mark_effaced_and_obliterated_at_emptying(e);
            window [on, on];
        }
    };
}

// =============================================================================
// Section 5207: proprietor records and reports
// =============================================================================

pub enum PlantRecordCategory {
    ProductionMaterialsReceivedAndUsed;
    ProductionSpiritsReceivedForRedistillation;
    ProductionSpiritsProduced;
    StorageEnteredIntoStorage;
    StorageRemovedAndPurpose;
    StorageReturnedToStorage;
    DenaturationDenaturantsReceivedAndUsed;
    DenaturationSpiritsDenatured;
    DenaturationDenaturedSpiritsRemoved;
    ProcessingReceivedOrTransferred;
    ProcessingPackagedOrBottled;
    ProcessingRemovedFromPremises;
}
pub relation plant_conducts_recorded_activity(p: Person, cat: PlantRecordCategory) kind empirical {
    label en official "the proprietor conducts the activity of this section 5207(a) category (production, storage, denaturation, or processing activity)";
}
pub relation plant_record_kept(p: Person, cat: PlantRecordCategory) kind empirical {
    label en official "the proprietor keeps records, in the form the Secretary prescribes, of the kind and quantity of this section 5207(a) category";
}
pub relation is_proprietor_of_any_plant(p: Person) kind empirical {
    label en official "the person is a distilled spirits plant proprietor";
}
@source(IRC_S5207_A, coverage = exact, quote = "Every distilled spirits plant proprietor shall keep records in such form and manner as the Secretary shall by regulations prescribe of:")
rule Section5207aRecordsDutyRule(p: Person, cat: PlantRecordCategory) strict {
    label en official "section 5207(a)(1)-(4): a proprietor keeps records of each production, storage, denaturation, and processing activity it conducts (one duty instance per category; the paragraph (5) additional information is regulation-defined, EXTERNAL_DEPENDENCY)";
    when is_proprietor_of_any_plant(p);
    when plant_conducts_recorded_activity(p, cat);
    then duty Section5207aPlantRecordsDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition plant_record_kept(p, cat);
            window [-infinity, infinity];
        }
    };
}
pub relation plant_records_and_report_copies_available_and_preserved(p: Person) kind empirical {
    label en official "the records and a copy of each report are available for inspection by any internal revenue officer during business hours and preserved for the period the Secretary prescribes (section 5207(c))";
}
@source(IRC_S5207_C, coverage = exact, quote = "The records required by subsection (a) and a copy of each report required by subsection (b) shall be available for inspection by any internal revenue officer during business hours, and shall be preserved by the person required to keep such records and reports for such period as the Secretary shall by regulations prescribe.")
rule Section5207cPreservationDutyRule(p: Person) strict {
    label en official "section 5207(c): plant records and report copies are kept available for inspection and preserved";
    when is_proprietor_of_any_plant(p);
    then duty Section5207cPreservationDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition plant_records_and_report_copies_available_and_preserved(p);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// Section 5211: production gauge and entry
// =============================================================================

pub relation spirits_held_before_production_gauge_no_longer_than_reasonably_necessary(plant: DistilledSpiritsPlant) kind empirical {
    label en official "spirits in process of production are held before the production gauge only as long as is reasonably necessary to complete the process (section 5211) — DECISION-0194: evaluative, asserted with origin adjudicated where disputed";
}
pub relation production_gauged_and_recorded_within_reasonable_time(plant: DistilledSpiritsPlant) kind empirical {
    label en official "all spirits produced are gauged and the gauge recorded within a reasonable time after production is completed (section 5211) — DECISION-0194: evaluative";
}
@source(IRC_S5211, relation = formalizes, coverage = partial, quote = "may be held prior to the production gauge only for so long as is reasonably necessary to complete the process of production.")
rule Section5211HoldingDutyRule(p: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5211, first and second sentences: spirits are held before gauge no longer than reasonably necessary and are gauged and recorded within a reasonable time (maintenance duties of the proprietor; both time limits are evaluative facts, DECISION-0194)";
    when is_proprietor_of_producing_plant(p, plant);
    then duty Section5211ProductionGaugeDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition production_gauged_and_recorded_within_reasonable_time(plant);
            window [-infinity, infinity];
        }
    };
}
pub enum ProductionGaugeEntryKind {
    DepositOnBondedPremisesForStorageOrProcessing;
    WithdrawalUponDeterminationOfTax;
    WithdrawalUnderSection5214;
    TransferForRedistillationUnderSection5223;
}
pub relation production_gauge_made(plant: DistilledSpiritsPlant, r: SpiritsRemoval) kind empirical {
    label en official "the production gauge of these spirits has been made (section 5211)";
}
pub relation appropriate_entry_made_for(r: SpiritsRemoval, k: ProductionGaugeEntryKind) kind empirical {
    label en official "the proprietor has made appropriate entry for the deposit, withdrawal, or transfer";
}
pub relation intended_disposition_after_gauge(r: SpiritsRemoval, k: ProductionGaugeEntryKind) kind empirical {
    label en official "the disposition (deposit, withdrawal on determination, section 5214 withdrawal, or transfer for redistillation) chosen for the gauged spirits";
}
@source(IRC_S5211, relation = formalizes, coverage = exact, quote = "The proprietor shall, pursuant to such production gauge and in accordance with such regulations as the Secretary shall prescribe, make appropriate entry for—")
rule Section5211EntryDutyRule(p: Person, plant: DistilledSpiritsPlant, r: SpiritsRemoval, k: ProductionGaugeEntryKind) strict {
    label en official "section 5211(1)-(4): pursuant to the production gauge the proprietor makes the appropriate entry for the chosen disposition";
    when is_proprietor_of_producing_plant(p, plant);
    when production_gauge_made(plant, r);
    when intended_disposition_after_gauge(r, k);
    then duty Section5211EntryDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition appropriate_entry_made_for(r, k);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// Section 5212: transfers in bond between bonded premises
// =============================================================================

pub relation spirits_untaxed_and_transferred_in_bond(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "spirits on which the tax has not been paid or determined are transferred in bond between bonded premises on this date (section 5212)";
}
pub relation transfer_container_is_approved_container(r: SpiritsRemoval) kind empirical {
    label en official "the transfer is in an approved container (section 5002(a)(13))";
}
pub relation transferred_spirits_are_bulk(r: SpiritsRemoval) kind empirical {
    label en official "the spirits transferred are bulk distilled spirits";
}
pub relation bottled_industrial_alcohol_under_5235(r: SpiritsRemoval) kind empirical {
    label en official "alcohol bottled under section 5235 that is to be withdrawn for industrial purposes (section 5212)";
}
pub relation transfer_between_premises_of_same_person_or_controlled_group(r: SpiritsRemoval) kind empirical {
    label en official "the transfer is between bonded premises belonging to the same person or members of the same controlled group (within the meaning of section 5001(c)(2)) — case-asserted; the group derivation is module 01's alcohol_controlled_group_member";
}
pub relation transferor_retains_title_throughout_for_bottling_or_storage(r: SpiritsRemoval) kind empirical {
    label en official "spirits transferred by the distiller/processor to another for bottling or storage and returned to the transferor for removal, the transferor retaining title the entire period (section 5212 last sentence)";
}
pub relation transfer_in_bond_permitted(r: SpiritsRemoval) kind institutional {
    label en official "the section 5212 transfer in bond is permitted";
}
@source(IRC_S5212, relation = formalizes, coverage = partial, quote = "Bulk distilled spirits on which the internal revenue tax has not been paid or determined as authorized by law may, under such regulations as the Secretary shall prescribe, be transferred in bond between bonded premises in any approved container.")
rule Section5212BulkTransferRule(r: SpiritsRemoval, on: Date) strict {
    label en official "section 5212, first sentence: untaxed bulk spirits may be transferred in bond in an approved container";
    when spirits_untaxed_and_transferred_in_bond(r, on);
    when transferred_spirits_are_bulk(r);
    when transfer_container_is_approved_container(r);
    then transfer_in_bond_permitted(r);
}
@source(IRC_S5212, relation = formalizes, coverage = exact, quote = "The provisions of this section restricting transfers to bulk distilled spirits shall not apply to alcohol bottled under the provisions of section 5235 which is to be withdrawn for industrial purposes.")
rule Section5212IndustrialAlcoholNonBulkRule(r: SpiritsRemoval, on: Date) strict {
    label en official "section 5212, third sentence: the bulk restriction does not apply to alcohol bottled under section 5235 for industrial withdrawal";
    when spirits_untaxed_and_transferred_in_bond(r, on);
    when bottled_industrial_alcohol_under_5235(r);
    when transfer_container_is_approved_container(r);
    then transfer_in_bond_permitted(r);
}
@source(IRC_S5212, relation = formalizes, coverage = exact, quote = "In the case of distilled spirits transferred in bond after December 31, 2017, between bonded premises belonging to the same person or members of the same controlled group (within the meaning of section 5001(c)(2)) this section shall be applied without regard to whether distilled spirits are bulk distilled spirits.")
rule Section5212SameGroupNonBulkAfter2017Rule(r: SpiritsRemoval, on: Date) strict {
    label en official "section 5212, fourth sentence (Pub. L. 115-97 section 13808(b), applying to transfers after December 31, 2017): transfers between premises of the same person or controlled group ignore the bulk limit";
    when spirits_untaxed_and_transferred_in_bond(r, on);
    when on > SameControlledGroupBulkWaiverAfter;
    when transfer_between_premises_of_same_person_or_controlled_group(r);
    when transfer_container_is_approved_container(r);
    then transfer_in_bond_permitted(r);
}
@source(IRC_S5212, relation = formalizes, coverage = exact, quote = "this section shall be applied without regard to whether distilled spirits are bulk distilled spirits, but only if the transferor retains title during the entire period between such distillation, or processing, and removal.")
rule Section5212TransferorRetainsTitleNonBulkRule(r: SpiritsRemoval, on: Date) strict {
    label en official "section 5212, last sentence: bottling or storage transfers to another person, with the transferor retaining title until removal, ignore the bulk limit";
    when spirits_untaxed_and_transferred_in_bond(r, on);
    when transferor_retains_title_throughout_for_bottling_or_storage(r);
    when transfer_container_is_approved_container(r);
    then transfer_in_bond_permitted(r);
}
pub relation transfer_in_bond_is_not_a_withdrawal_from_bonded_premises(r: SpiritsRemoval) kind institutional {
    label en official "the removal of bulk spirits for transfer in bond between bonded premises is not a withdrawal from bonded premises for chapter 51 (section 5212, second sentence)";
}
@source(IRC_S5212, relation = formalizes, coverage = exact, quote = "the removal of bulk distilled spirits for transfer in bond between bonded premises shall not be construed to be a withdrawal from bonded premises.")
rule Section5212NotAWithdrawalRule(r: SpiritsRemoval, on: Date) defeasible {
    label en official "section 5212, second sentence: a permitted transfer in bond is not a withdrawal (so no section 5006 determination arises from it)";
    when spirits_untaxed_and_transferred_in_bond(r, on);
    when transfer_in_bond_permitted(r);
    then transfer_in_bond_is_not_a_withdrawal_from_bonded_premises(r);
}

// =============================================================================
// Section 5213/5214/5215: withdrawals and returns
// =============================================================================

pub relation withdrawn_on_payment_or_determination_in_approved_containers(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "the spirits are withdrawn from bonded premises on payment or determination of tax, in approved containers (section 5213)";
}
@source(IRC_S5213, coverage = partial, quote = "distilled spirits may be withdrawn from the bonded premises of a distilled spirits plant on payment or determination of tax thereon, in approved containers")
rule Section5213WithdrawalLibertyRule(r: SpiritsRemoval, p: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5213: subject to section 5173 (bond) and regulations, spirits may be withdrawn from bonded premises on payment or determination of tax in approved containers (liberty of the proprietor)";
    when is_proprietor_of_plant(p, plant);
    when withdrawn_on_payment_or_determination_in_approved_containers(r, p);
    then liberty Section5213WithdrawOnPaymentOrDetermination {
        holder p;
        action withdrawn_on_payment_or_determination_in_approved_containers(r, p);
        window [-infinity, infinity];
    };
}
pub enum SpiritsWithdrawalPurpose {
    DenaturedForExportation;
    DenaturedForChemicalSubstanceNotInFinishedProduct;
    DenaturedForOtherUseInArtsIndustriesFuelLightPower;
    GovernmentNonbeveragePurposes;
    InstitutionalNonbeverageNotForResale;
    WithoutPaymentForExportation;
    WithoutPaymentForWineProduction;
    WithoutPaymentForManufacturingBondedWarehouse;
    WithoutPaymentForVesselsAndAircraft;
    WithoutPaymentForForeignTradeZone;
    WithoutPaymentForCustomsBondedWarehouseStorage;
    WithoutPaymentForResearchDevelopmentOrTesting;
    FreeWhenContainedInArticle;
    FreeWhenProducedUnderSection5181;
    WithoutPaymentForBondedWineCellarProductionOfUnfitWine;
    FreeForHandSanitizerRemovedIn2020;
}
pub relation spirits_withdrawal_purpose(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) kind empirical {
    label en official "the purpose for which the spirits are withdrawn from the bonded premises of a distilled spirits plant in approved containers (section 5214(a))";
}
pub relation spirits_withdrawn_in_approved_containers(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are withdrawn from bonded premises in approved containers (section 5214(a) lead-in)";
}
pub relation spirits_withdrawn_on_date(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "the date the spirits are removed from the bonded premises";
}
pub relation spirits_tax_not_paid_or_determined(r: SpiritsRemoval) kind empirical {
    label en official "the internal revenue tax has not been paid or determined on the spirits (section 5214(a) lead-in)";
}
pub relation spirits_denatured_before_withdrawal(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are denatured in the manner prescribed by law before withdrawal (section 5214(a)(1))";
}
pub relation withdrawal_use_prohibited_by_5273b_or_d(r: SpiritsRemoval) kind empirical {
    label en official "the intended use is prohibited by section 5273(b) or (d) (section 5214(a)(1)(C) exclusion)";
}
pub relation withdrawer_is_government_or_agency(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are withdrawn by and for the use of the United States or a governmental agency, a State, a political subdivision, or the District of Columbia (section 5214(a)(2))";
}
pub relation withdrawer_is_qualifying_institution_for_5214a3(r: SpiritsRemoval) kind empirical {
    label en official "the user is an educational organization described in section 170(b)(1)(A)(ii) exempt under section 501(a), a scientific university or college, a laboratory used exclusively for research, a hospital, blood bank, sanitarium (or pathological laboratory serving them), or a charity clinic (section 5214(a)(3)(A)-(D))";
}
pub relation withdrawal_is_for_nonbeverage_purposes(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are for nonbeverage purposes";
}
pub relation withdrawal_is_for_resale_or_use_in_product_for_sale(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are for resale or for use in the manufacture of any product for sale";
}
pub relation withdrawal_export_bond_and_entries_satisfied(r: SpiritsRemoval) kind empirical {
    label en official "the exporter has made the application and entries and filed the bonds required by section 5175 and complied with the regulations (section 5214(a)(4))";
}
pub relation withdrawal_contained_in_article(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are contained in an article within the meaning of section 5002(a)(14) (section 5214(a)(11))";
}
pub relation withdrawal_spirits_produced_under_5181(r: SpiritsRemoval) kind empirical {
    label en official "the spirits were produced under section 5181 (section 5214(a)(12))";
}
pub relation withdrawal_hand_sanitizer_consistent_with_fda_guidance(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are for use in or contained in hand sanitizer produced and distributed consistently with FDA guidance related to SARS-CoV-2/COVID-19 (section 5214(a)(14))";
}
pub relation spirits_withdrawal_authorized_by_5214(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) kind institutional {
    label en official "the withdrawal of untaxed spirits from the bonded premises for this purpose is authorized by section 5214(a)";
}
@source(IRC_S5214_A, relation = formalizes, coverage = exact, quote = "(1) free of tax after denaturation of such spirits in the manner prescribed by law for—")
rule Section5214a1DenaturedRule(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) defeasible {
    label en official "section 5214(a)(1): denatured spirits may be withdrawn free of tax for exportation, for manufacture of a chemical substance in which they do not appear, or for other arts-and-industry, fuel, light, and power uses (except uses prohibited by section 5273(b) or (d))";
    when spirits_tax_not_paid_or_determined(r);
    when spirits_withdrawn_in_approved_containers(r);
    when spirits_denatured_before_withdrawal(r);
    when spirits_withdrawal_purpose(r, purpose);
    when purpose == DenaturedForExportation or purpose == DenaturedForChemicalSubstanceNotInFinishedProduct or purpose == DenaturedForOtherUseInArtsIndustriesFuelLightPower;
    unless withdrawal_use_prohibited_by_5273b_or_d(r) and spirits_denatured_before_withdrawal(r) and spirits_withdrawal_purpose(r, purpose);
    then spirits_withdrawal_authorized_by_5214(r, purpose);
}
@source(IRC_S5214_A, relation = formalizes, coverage = exact, quote = "(2) free of tax by, and for the use of, the United States or any governmental agency thereof, any State, any political subdivision of a State, or the District of Columbia, for nonbeverage purposes; or")
rule Section5214a2GovernmentRule(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) strict {
    label en official "section 5214(a)(2): free withdrawal by and for a government, for nonbeverage purposes";
    when spirits_tax_not_paid_or_determined(r);
    when spirits_withdrawn_in_approved_containers(r);
    when spirits_withdrawal_purpose(r, purpose);
    when purpose == GovernmentNonbeveragePurposes;
    when withdrawer_is_government_or_agency(r);
    when withdrawal_is_for_nonbeverage_purposes(r);
    then spirits_withdrawal_authorized_by_5214(r, purpose);
}
@source(IRC_S5214_A, relation = formalizes, coverage = exact, quote = "(3) free of tax for nonbeverage purposes and not for resale or use in the manufacture of any product for sale—")
rule Section5214a3InstitutionRule(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) defeasible {
    label en official "section 5214(a)(3): free withdrawal for a listed institution for nonbeverage purposes and not for resale or use in the manufacture of a product for sale";
    when spirits_tax_not_paid_or_determined(r);
    when spirits_withdrawn_in_approved_containers(r);
    when spirits_withdrawal_purpose(r, purpose);
    when purpose == InstitutionalNonbeverageNotForResale;
    when withdrawer_is_qualifying_institution_for_5214a3(r);
    when withdrawal_is_for_nonbeverage_purposes(r);
    unless withdrawal_is_for_resale_or_use_in_product_for_sale(r) and spirits_withdrawal_purpose(r, purpose);
    then spirits_withdrawal_authorized_by_5214(r, purpose);
}
@source(IRC_S5214_A, relation = formalizes, coverage = exact, quote = "(4) without payment of tax for exportation, after making such application and entries, filing such bonds as are required by section 5175, and complying with such other requirements as may by regulations be prescribed; or")
rule Section5214a4ExportRule(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) strict {
    label en official "section 5214(a)(4): withdrawal without payment of tax for exportation after the section 5175 application, entries, and bonds";
    when spirits_tax_not_paid_or_determined(r);
    when spirits_withdrawn_in_approved_containers(r);
    when spirits_withdrawal_purpose(r, purpose);
    when purpose == WithoutPaymentForExportation;
    when withdrawal_export_bond_and_entries_satisfied(r);
    then spirits_withdrawal_authorized_by_5214(r, purpose);
}
@source(IRC_S5214_A, relation = formalizes, coverage = partial, quote = "(5) without payment of tax for use in wine production, as authorized by section 5373; or")
rule Section5214a5to10OtherWithoutPaymentPurposesRule(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) strict {
    label en official "section 5214(a)(5)-(10), (13): withdrawals without payment of tax for wine production, manufacturing bonded warehouses, vessels and aircraft, foreign-trade zones, customs bonded warehouses (storage pending exportation), research/development/testing, and bonded-wine-cellar production of unfit wine are authorized 'as authorized by law' — the underlying conditions live in the cross-referenced sections and in regulations (EXTERNAL_DEPENDENCY); here the purpose match only";
    when spirits_tax_not_paid_or_determined(r);
    when spirits_withdrawn_in_approved_containers(r);
    when spirits_withdrawal_purpose(r, purpose);
    when purpose == WithoutPaymentForWineProduction or purpose == WithoutPaymentForManufacturingBondedWarehouse or purpose == WithoutPaymentForVesselsAndAircraft or purpose == WithoutPaymentForForeignTradeZone or purpose == WithoutPaymentForCustomsBondedWarehouseStorage or purpose == WithoutPaymentForResearchDevelopmentOrTesting or purpose == WithoutPaymentForBondedWineCellarProductionOfUnfitWine;
    then spirits_withdrawal_authorized_by_5214(r, purpose);
}
@source(IRC_S5214_A, relation = formalizes, coverage = exact, quote = "(11) free of tax when contained in an article (within the meaning of section 5002(a)(14)); or")
rule Section5214a11ArticleRule(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) strict {
    label en official "section 5214(a)(11): free withdrawal when the spirits are contained in an article";
    when spirits_tax_not_paid_or_determined(r);
    when spirits_withdrawn_in_approved_containers(r);
    when spirits_withdrawal_purpose(r, purpose);
    when purpose == FreeWhenContainedInArticle;
    when withdrawal_contained_in_article(r);
    then spirits_withdrawal_authorized_by_5214(r, purpose);
}
@source(IRC_S5214_A, relation = formalizes, coverage = exact, quote = "(12) free of tax in the case of distilled spirits produced under section 5181; or")
rule Section5214a12FuelPlantRule(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose) strict {
    label en official "section 5214(a)(12): free withdrawal of spirits produced under section 5181";
    when spirits_tax_not_paid_or_determined(r);
    when spirits_withdrawn_in_approved_containers(r);
    when spirits_withdrawal_purpose(r, purpose);
    when purpose == FreeWhenProducedUnderSection5181;
    when withdrawal_spirits_produced_under_5181(r);
    then spirits_withdrawal_authorized_by_5214(r, purpose);
}
@source(IRC_S5214_A, relation = formalizes, coverage = exact, quote = "(14) with respect to distilled spirits removed after December 31, 2019, and before January 1, 2021, free of tax for use in or contained in hand sanitizer produced and distributed in a manner consistent with any guidance issued by the Food and Drug Administration that is related to the outbreak of virus SARS–CoV–2 or coronavirus disease 2019 (COVID–19).")
rule Section5214a14HandSanitizerRule(r: SpiritsRemoval, purpose: SpiritsWithdrawalPurpose, on: Date) strict {
    label en official "section 5214(a)(14) (Pub. L. 116-136 section 2308(b)): spirits removed after December 31, 2019 and before January 1, 2021 are free of tax for FDA-guidance hand sanitizer (a temporal window; the provision is spent after 2020)";
    when spirits_tax_not_paid_or_determined(r);
    when spirits_withdrawn_in_approved_containers(r);
    when spirits_withdrawal_purpose(r, purpose);
    when purpose == FreeForHandSanitizerRemovedIn2020;
    when spirits_withdrawn_on_date(r, on);
    when on > @2019-12-31;
    when on < @2021-01-01;
    when withdrawal_hand_sanitizer_consistent_with_fda_guidance(r);
    then spirits_withdrawal_authorized_by_5214(r, purpose);
}

pub enum SpiritsReturnPurpose { Destruction; Denaturation; Redistillation; Reconditioning; Rebottling; Relabeling; Reclosing; OtherPurpose; }
pub relation taxpaid_spirits_returned_to_bonded_premises(r: SpiritsRemoval, purpose: SpiritsReturnPurpose) kind empirical {
    label en official "distilled spirits on which tax has been determined or paid are returned to the bonded premises of a plant for this purpose (section 5215(a))";
}
pub relation return_to_bonded_premises_permitted(r: SpiritsRemoval) kind institutional {
    label en official "the return of taxpaid spirits to bonded premises is permitted: only for destruction, denaturation, redistillation, reconditioning, or rebottling (section 5215(a)); bottled spirits may also be returned for relabeling or reclosing (section 5215(c))";
}
@source(IRC_S5215_A, coverage = exact, quote = "may be returned to the bonded premises of a distilled spirits plant but only for destruction, denaturation, redistillation, reconditioning, or rebottling.")
rule Section5215aReturnPurposesRule(r: SpiritsRemoval, purpose: SpiritsReturnPurpose) strict {
    label en official "section 5215(a): the listed purposes are the only permitted purposes for returning taxpaid spirits to bonded premises";
    when taxpaid_spirits_returned_to_bonded_premises(r, purpose);
    when purpose == Destruction or purpose == Denaturation or purpose == Redistillation or purpose == Reconditioning or purpose == Rebottling;
    then return_to_bonded_premises_permitted(r);
}
@source(IRC_S5215_C, coverage = exact, quote = "bottled distilled spirits withdrawn from bonded premises may be returned to bonded premises for relabeling or reclosing, and the tax under section 5001 shall not again be collected on such spirits.")
rule Section5215cRelabelReclosePermittedRule(r: SpiritsRemoval, purpose: SpiritsReturnPurpose) strict {
    label en official "section 5215(c): bottled spirits may be returned for relabeling or reclosing";
    when taxpaid_spirits_returned_to_bonded_premises(r, purpose);
    when purpose == Relabeling or purpose == Reclosing;
    then return_to_bonded_premises_permitted(r);
}
pub relation section_5001_tax_not_again_collected(r: SpiritsRemoval) kind institutional {
    label en official "the tax under section 5001 is not collected again on bottled spirits returned for relabeling or reclosing (section 5215(c))";
}
@source(IRC_S5215_C, coverage = exact, quote = "and the tax under section 5001 shall not again be collected on such spirits.")
rule Section5215cNoSecondTaxRule(r: SpiritsRemoval, purpose: SpiritsReturnPurpose) strict {
    label en official "section 5215(c): no second collection of the section 5001 tax on relabeling/reclosing returns";
    when taxpaid_spirits_returned_to_bonded_premises(r, purpose);
    when purpose == Relabeling or purpose == Reclosing;
    then section_5001_tax_not_again_collected(r);
}

// =============================================================================
// Sections 5221-5223: production notices, mash, redistillation
// =============================================================================

pub relation proprietor_commences_production_operations(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the proprietor of a plant authorized to produce distilled spirits commences production operations (section 5221(a))";
}
pub relation written_notice_of_commencement_given_to_secretary(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "written notice has been given to the Secretary stating when operations will begin (section 5221(a))";
}
@source(IRC_S5221_A, coverage = exact, quote = "The proprietor of a distilled spirits plant authorized to produce distilled spirits shall not commence production operations until written notice has been given to the Secretary stating when operations will begin.")
rule Section5221aCommencementProhibitionRule(p: Person, plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5221(a): production operations may not commence until written notice of commencement has been given to the Secretary";
    when proprietor_commences_production_operations(p, plant);
    unless written_notice_of_commencement_given_to_secretary(p, plant) and proprietor_commences_production_operations(p, plant);
    then prohibition Section5221CommenceBeforeNoticeProhibition {
        bearer p;
        action proprietor_commences_production_operations(p, plant);
        window [-infinity, infinity];
    };
}
pub relation proprietor_produces_spirits_after_suspension_time(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "after the time stated in a suspension notice the proprietor produces distilled spirits on the premises (section 5221(a))";
}
pub relation written_notice_of_resumption_given_to_secretary(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the proprietor again gives written notice stating the time when operations will resume (section 5221(a))";
}
pub relation suspension_caused_by_unavoidable_accident(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the suspension was caused by an unavoidable accident, governed by regulations instead (section 5221(a) last sentence)";
}
@source(IRC_S5221_A, coverage = exact, quote = "No proprietor, after having given such notice, shall, after the time stated therein, produce distilled spirits on such premises until he again gives notice in writing to the Secretary stating the time when he will resume operations.")
rule Section5221aProduceAfterSuspensionProhibitionRule(p: Person, plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5221(a): after a suspension notice, no production until written notice of resumption (not for suspensions caused by unavoidable accidents)";
    when proprietor_produces_spirits_after_suspension_time(p, plant);
    unless written_notice_of_resumption_given_to_secretary(p, plant) and proprietor_produces_spirits_after_suspension_time(p, plant);
    unless suspension_caused_by_unavoidable_accident(p, plant) and proprietor_produces_spirits_after_suspension_time(p, plant);
    then prohibition Section5221ProduceAfterSuspensionProhibition {
        bearer p;
        action proprietor_produces_spirits_after_suspension_time(p, plant);
        window [-infinity, infinity];
    };
}
pub enum MashOrDistillationActivity { MakeOrFermentMashOffBondedPremises; RemoveMashBeforeDistillation; ProduceSpiritsAsNonAuthorizedDistiller; }
pub relation mash_or_distillation_activity(p: Person, a: MashOrDistillationActivity) kind empirical {
    label en official "the person makes or ferments mash, wort, or wash fit for distillation off the bonded premises of an authorized plant; removes such mash before distillation without the Secretary's authorization; or, not being an authorized distiller, produces distilled spirits from any mash, wort, wash, or other material (section 5222(a)(1))";
}
pub relation mash_activity_within_5222a2_exception(p: Person) kind empirical {
    label en official "the activity is within a section 5222(a)(2) exception: authorized vinegar-plant operations, authorized production and removal of fermented materials on brewery or bonded wine cellar premises, products exempt under section 5042 or 5053(e), or fermented materials used in vinegar by fermentation";
}
pub relation mash_removal_authorized_by_secretary(p: Person) kind empirical {
    label en official "the Secretary has authorized removal of the mash, wort, or wash before distillation (section 5222(a)(1))";
}
@source(IRC_S5222_A, coverage = exact, quote = "No mash, wort, or wash fit for distillation or for the production of distilled spirits shall be made or fermented in any building or on any premises other than on the bonded premises of a distilled spirits plant duly authorized to produce distilled spirits according to law")
rule Section5222a1MashProhibitionRule(p: Person, a: MashOrDistillationActivity) defeasible {
    label en official "section 5222(a)(1): making or fermenting mash off authorized bonded premises, removing mash before distillation without authorization, and producing spirits by any process other than as an authorized distiller are prohibited; the section 5222(a)(2) exceptions apply";
    when mash_or_distillation_activity(p, a);
    unless mash_activity_within_5222a2_exception(p) and mash_or_distillation_activity(p, a);
    unless mash_removal_authorized_by_secretary(p) and mash_or_distillation_activity(p, a) and a == RemoveMashBeforeDistillation;
    then prohibition Section5222MashProhibition {
        bearer p;
        action mash_or_distillation_activity(p, a);
        window [-infinity, infinity];
    };
}
pub relation redistilled_spirits_recovered_from_denatured_spirits_or_articles(r: SpiritsRemoval) kind empirical {
    label en official "distilled spirits recovered by redistillation of denatured spirits or of section 5223(c) articles or residues (section 5223(d))";
}
pub relation recovered_spirits_withdrawn_for_industrial_use_or_after_denaturation(r: SpiritsRemoval) kind empirical {
    label en official "the recovered spirits are withdrawn for industrial use or after denaturation as prescribed by law (section 5223(d))";
}
pub relation recovered_spirits_withdrawn_from_bonded_premises(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "the recovered spirits are withdrawn from bonded premises by this person";
}
@source(IRC_S5223_D, coverage = exact, quote = "may not be withdrawn from bonded premises except for industrial use or after denaturation thereof in the manner prescribed by law.")
rule Section5223dRecoveredSpiritsProhibitionRule(r: SpiritsRemoval, p: Person) defeasible {
    label en official "section 5223(d): spirits recovered by redistilling denatured spirits or articles may leave bonded premises only for industrial use or after denaturation";
    when redistilled_spirits_recovered_from_denatured_spirits_or_articles(r);
    when recovered_spirits_withdrawn_from_bonded_premises(r, p);
    unless recovered_spirits_withdrawn_for_industrial_use_or_after_denaturation(r) and recovered_spirits_withdrawn_from_bonded_premises(r, p);
    then prohibition Section5223dRecoveredSpiritsWithdrawalProhibition {
        bearer p;
        action recovered_spirits_withdrawn_from_bonded_premises(r, p);
        window [-infinity, infinity];
    };
}
pub relation spirits_redistilled_on_bonded_premises_after_production_gauge(r: SpiritsRemoval) kind empirical {
    label en official "the spirits are redistilled on bonded premises subsequent to production gauge (section 5223(e))";
}
pub relation treated_as_originally_produced_by_redistiller(r: SpiritsRemoval) kind institutional {
    label en official "the redistilled spirits are treated as if originally produced by the redistiller, and all provisions applicable to original production apply (section 5223(e))";
}
pub relation prior_tax_lien_and_bond_obligations_extinguished(r: SpiritsRemoval) kind institutional {
    label en official "any prior obligation as to taxes, liens, and bonds with respect to the spirits is extinguished on redistillation (section 5223(e))";
}
@source(IRC_S5223_E, coverage = exact, quote = "shall be treated the same as if such spirits had been originally produced by the redistiller")
rule Section5223eTreatedAsProducedRule(r: SpiritsRemoval) strict {
    label en official "section 5223(e): redistilled spirits are treated as originally produced by the redistiller";
    when spirits_redistilled_on_bonded_premises_after_production_gauge(r);
    then treated_as_originally_produced_by_redistiller(r);
}
@source(IRC_S5223_E, coverage = exact, quote = "Any prior obligation as to taxes, liens, and bonds with respect to such distilled spirits shall be extinguished on redistillation.")
rule Section5223eExtinguishRule(r: SpiritsRemoval) strict {
    label en official "section 5223(e): prior tax, lien, and bond obligations on redistilled spirits are extinguished";
    when spirits_redistilled_on_bonded_premises_after_production_gauge(r);
    then prior_tax_lien_and_bond_obligations_extinguished(r);
}

// =============================================================================
// Section 5231-5236: storage, imports in bulk, discontinuance
// =============================================================================

pub relation spirits_deposited_in_facility_designated_in_entry(r: SpiritsRemoval) kind empirical {
    label en official "the spirits entered for deposit under section 5211 are deposited in the facilities on the bonded premises designated in the entry (section 5231)";
}
pub relation spirits_entered_for_deposit_under_5211(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "the spirits are entered for deposit on the bonded premises (section 5231)";
}
@source(IRC_S5231, coverage = exact, quote = "shall, under such regulations as the Secretary shall prescribe, be deposited in the facilities on the bonded premises designated in the entry for deposit.")
rule Section5231DepositDutyRule(r: SpiritsRemoval, p: Person) strict {
    label en official "section 5231: spirits entered for deposit are deposited in the facilities designated in the entry";
    when spirits_entered_for_deposit_under_5211(r, p);
    then duty Section5231DepositInDesignatedFacilityDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition spirits_deposited_in_facility_designated_in_entry(r);
            window [-infinity, infinity];
        }
    };
}
pub relation bulk_import_transferred_to_plant_from_customs_custody(r: SpiritsRemoval, operator: Person, importer: Person) kind empirical {
    label en official "distilled spirits imported in bulk containers are transferred from customs custody, in such containers or by pipeline, to the bonded premises of a plant without payment of tax; the operator of the premises and the importer (section 5232(a))";
}
pub relation spirits_released_from_customs_custody_on(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "the date of release of the spirits from customs custody";
}
pub relation liable_for_spirits_tax_from_customs_release(p: Person, r: SpiritsRemoval, on: Date) kind institutional {
    label en official "the person operating the receiving bonded premises becomes liable for the tax upon release of the spirits from customs custody (section 5232(a))";
}
pub relation importer_relieved_of_spirits_tax_on_customs_transfer(p: Person, r: SpiritsRemoval) kind institutional {
    label en official "the importer, or person bringing the spirits into the United States, is thereupon relieved of liability (section 5232(a))";
}
@source(IRC_S5232_A, coverage = exact, quote = "The person operating the bonded premises of the distilled spirits plant to which such spirits are transferred shall become liable for the tax on distilled spirits withdrawn from customs custody under this section upon release of the spirits from customs custody")
rule Section5232aOperatorLiableRule(r: SpiritsRemoval, operator: Person, importer: Person, on: Date) strict {
    label en official "section 5232(a): the operator of the receiving bonded premises becomes liable for the tax on release from customs custody";
    when bulk_import_transferred_to_plant_from_customs_custody(r, operator, importer);
    when spirits_released_from_customs_custody_on(r, on);
    then liable_for_spirits_tax_from_customs_release(operator, r, on);
}
@source(IRC_S5232_A, coverage = exact, quote = "and the importer, or the person bringing such distilled spirits into the United States, shall thereupon be relieved of his liability for such tax.")
rule Section5232aImporterRelievedRule(r: SpiritsRemoval, operator: Person, importer: Person) strict {
    label en official "section 5232(a): the importer is relieved of liability on the transfer";
    when bulk_import_transferred_to_plant_from_customs_custody(r, operator, importer);
    then importer_relieved_of_spirits_tax_on_customs_transfer(importer, r);
}
pub relation transferred_import_spirits_proof(r: SpiritsRemoval, proof: Decimal) kind empirical {
    label en official "the proof of the spirits transferred under section 5232(a)";
}
pub relation transferred_import_spirits_redistilled_or_denatured(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "the transferred spirits are redistilled or denatured (section 5232(b)(1))";
}
@source(IRC_S5232_B, coverage = exact, quote = "(1) may be redistilled or denatured only if of 185 degrees or more of proof, and")
rule Section5232b1ProofProhibitionRule(r: SpiritsRemoval, p: Person, proof: Decimal) strict {
    label en official "section 5232(b)(1): spirits transferred from customs custody may be redistilled or denatured only if of 185 proof or more";
    when transferred_import_spirits_proof(r, proof);
    when proof < SpiritsMinimumProofForRedistillationOrDenaturationOfImports;
    when transferred_import_spirits_redistilled_or_denatured(r, p);
    then prohibition Section5232LowProofRedistillationProhibition {
        bearer p;
        action transferred_import_spirits_redistilled_or_denatured(r, p);
        window [-infinity, infinity];
    };
}
external judgment relation secretary_finds_storage_facilities_unsafe_or_spirits_subject_to_great_loss(plant: DistilledSpiritsPlant) {
    authority Secretary;
    label en official "the Secretary finds storage facilities on bonded premises unsafe or unfit for use, or the spirits contained therein subject to great loss or wastage (section 5236) — DECISION-0194 external judgment";
}
pub relation secretary_requires_discontinuance_and_transfer(plant: DistilledSpiritsPlant) kind empirical {
    label en official "the Secretary requires discontinuance of the use of the facilities and transfer of the spirits to other facilities the Secretary designates (section 5236)";
}
pub relation storage_transfer_required(plant: DistilledSpiritsPlant) kind institutional {
    label en official "the owner or warehouseman must transfer the spirits, at the time and under the supervision the Secretary requires, at its own expense (section 5236)";
}
@source(IRC_S5236, coverage = partial, quote = "he may require the discontinuance of the use of such facilities and require the spirits contained therein to be transferred to such other storage facilities as he may designate.")
rule Section5236DiscontinuancePowerRule(plant: DistilledSpiritsPlant) strict {
    label en official "section 5236: the Secretary's power to require discontinuance of unsafe storage facilities and transfer of the spirits is valid only on the Secretary's finding (an external judgment); the expense is borne by the owner or warehouseman; the seizure-and-sale remedy on failure to transfer (second sentence) is TECH_GAP (sale on distraint, proceeds application)";
    when secretary_requires_discontinuance_and_transfer(plant);
    then power Section5236DiscontinuanceOrder {
        holder us.irc.core::Secretary;
        over plant;
        exercise secretary_requires_discontinuance_and_transfer(plant);
        valid_when secretary_finds_storage_facilities_unsafe_or_spirits_subject_to_great_loss(plant);
        effect create(storage_transfer_required(plant));
        window [-infinity, infinity];
    };
}

// =============================================================================
// Sections 5241-5243: denaturation
// =============================================================================

pub relation denaturing_materials_render_spirits_unfit_for_beverage_or_internal_medicinal_use(r: SpiritsRemoval) kind empirical {
    label en official "the denaturing materials used render the spirits unfit for beverage or internal human medicinal use, and are suitable to the intended use (section 5242)";
}
pub relation spirits_are_being_denatured_by(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "the person denatures these spirits (section 5242)";
}
@source(IRC_S5242, coverage = partial, quote = "Denaturing materials shall be such as to render the spirits with which they are admixed unfit for beverage or internal human medicinal use.")
rule Section5242DenaturingMaterialsDutyRule(r: SpiritsRemoval, p: Person) strict {
    label en official "section 5242: methanol or other suitable denaturing materials are used, rendering the spirits unfit for beverage or internal human medicinal use (character and quantity per regulations — EXTERNAL_DEPENDENCY)";
    when spirits_are_being_denatured_by(r, p);
    then duty Section5242DenaturingMaterialsDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition denaturing_materials_render_spirits_unfit_for_beverage_or_internal_medicinal_use(r);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// Sections 5271-5276: permits for free-of-tax use and denatured spirits
// =============================================================================

pub enum PermitActivity { ProcureOrUseSpiritsFreeOfTax; ProcureDealInOrUseSpeciallyDenaturedSpirits; RecoverSpeciallyOrCompletelyDenaturedSpirits; }
pub relation person_conducts_permit_activity(p: Person, a: PermitActivity) kind empirical {
    label en official "the person procures or uses spirits free of tax under section 5214(a)(2) or (3); procures, deals in, or uses specially denatured spirits; or recovers specially or completely denatured spirits (section 5271(a))";
}
pub relation person_filed_application_and_received_permit(p: Person, a: PermitActivity) kind empirical {
    label en official "the person has filed an application with and received a permit from the Secretary (section 5271(a))";
}
@source(IRC_S5271_A, coverage = exact, quote = "No person shall—")
rule Section5271aPermitProhibitionRule(p: Person, a: PermitActivity) defeasible {
    label en official "section 5271(a): no person procures or uses spirits free of tax, procures/deals in/uses specially denatured spirits, or recovers denatured spirits until the person has filed an application and received a permit";
    when person_conducts_permit_activity(p, a);
    unless person_filed_application_and_received_permit(p, a) and person_conducts_permit_activity(p, a);
    then prohibition Section5271UnpermittedActivityProhibition {
        bearer p;
        action person_conducts_permit_activity(p, a);
        window [-infinity, infinity];
    };
}
pub entity PermitApplication5271 {
    label en unofficial "an application for a permit under section 5271 and the permit issued on it";
}
external judgment relation secretary_finds_applicant_not_authorized_to_withdraw_or_use_free_of_tax_spirits(a: PermitApplication5271) {
    authority Secretary;
    label en official "the Secretary, after notice and opportunity for hearing, finds that the applicant to withdraw and use spirits free of tax is not authorized by law or regulations (section 5271(c)(1)) — DECISION-0194 external judgment";
}
external judgment relation secretary_finds_applicant_not_likely_to_maintain_compliant_operations(a: PermitApplication5271) {
    authority Secretary;
    label en official "the Secretary, after notice and hearing, finds the applicant (including a corporation's officer, director, or principal stockholder, or a partnership's partner) by reason of business experience, financial standing, or trade connections not likely to maintain operations in compliance (section 5271(c)(2)) — DECISION-0194 external judgment";
}
pub relation applicant_failed_to_disclose_material_information_or_made_false_statement(a: PermitApplication5271) kind empirical {
    label en official "the applicant has failed to disclose material information required, or made a false statement as to a material fact, in the application (section 5271(c)(3))";
}
external judgment relation secretary_finds_premises_inadequate_to_protect_revenue(a: PermitApplication5271) {
    authority Secretary;
    label en official "the Secretary, after notice and hearing, finds the premises on which it is proposed to conduct the business not adequate to protect the revenue (section 5271(c)(4)) — DECISION-0194 external judgment";
}
pub relation permit_denial_ground_exists(a: PermitApplication5271) kind institutional {
    label en unofficial "at least one section 5271(c)(1)-(4) ground for disapproval exists (single-atom helper)";
}
rule Section5271cGround1Rule(a: PermitApplication5271) strict {
    label en unofficial "ground (c)(1) supports denial";
    when secretary_finds_applicant_not_authorized_to_withdraw_or_use_free_of_tax_spirits(a);
    then permit_denial_ground_exists(a);
}
rule Section5271cGround2Rule(a: PermitApplication5271) strict {
    label en unofficial "ground (c)(2) supports denial";
    when secretary_finds_applicant_not_likely_to_maintain_compliant_operations(a);
    then permit_denial_ground_exists(a);
}
rule Section5271cGround3Rule(a: PermitApplication5271) strict {
    label en unofficial "ground (c)(3) supports denial (an objective fact)";
    when applicant_failed_to_disclose_material_information_or_made_false_statement(a);
    then permit_denial_ground_exists(a);
}
rule Section5271cGround4Rule(a: PermitApplication5271) strict {
    label en unofficial "ground (c)(4) supports denial";
    when secretary_finds_premises_inadequate_to_protect_revenue(a);
    then permit_denial_ground_exists(a);
}
pub relation secretary_denies_permit_after_notice_and_hearing(a: PermitApplication5271) kind empirical {
    label en official "the Secretary disapproves the application and denies the permit after notice and opportunity for hearing (section 5271(c))";
}
pub relation permit_denied(a: PermitApplication5271) kind institutional {
    label en official "the section 5271 permit is denied";
}
@source(IRC_S5271_C, coverage = exact, quote = "Any application submitted under this section may be disapproved and the permit denied if the Secretary, after notice and opportunity for hearing, finds that—")
rule Section5271cDenialPowerRule(a: PermitApplication5271) strict {
    label en official "section 5271(c): the Secretary's power to disapprove and deny the permit is validly exercised only when at least one of the four grounds exists (E-0239: otherwise POWER_INVALID_EXERCISE, no denial)";
    when secretary_denies_permit_after_notice_and_hearing(a);
    then power Section5271PermitDenial {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_denies_permit_after_notice_and_hearing(a);
        valid_when permit_denial_ground_exists(a);
        effect create(permit_denied(a));
        window [-infinity, infinity];
    };
}
pub entity Permit5271 {
    label en unofficial "a permit issued under section 5271";
}
pub relation permit_holder_not_in_good_faith_compliance(t: Permit5271) kind empirical {
    label en official "the holder has not in good faith complied with this chapter or regulations (section 5271(e)(1)) — DECISION-0194 evaluative (good faith)";
}
pub relation permit_holder_violated_permit_conditions(t: Permit5271) kind empirical {
    label en official "the holder has violated the conditions of the permit (section 5271(e)(2))";
}
pub relation permit_holder_made_false_statement_in_application(t: Permit5271) kind empirical {
    label en official "the holder made a false statement as to a material fact in the application (section 5271(e)(3))";
}
pub relation permit_holder_failed_to_disclose_required_material_information(t: Permit5271) kind empirical {
    label en official "the holder failed to disclose material information required to be furnished (section 5271(e)(4))";
}
pub relation permit_holder_violated_liquor_law_or_convicted_of_felony_under_title(t: Permit5271) kind empirical {
    label en official "the holder violated or conspired to violate any US law relating to intoxicating liquor, or was convicted of a felony under this title or of conspiracy to commit one (section 5271(e)(5))";
}
pub relation permit_holder_no_longer_warranted_in_procuring_or_using_spirits(t: Permit5271) kind empirical {
    label en official "by reason of operations a holder of a (a)(1) or (a)(2) permit is no longer warranted in procuring or using the spirits authorized (section 5271(e)(6))";
}
pub relation permit_holder_manufactured_nonconforming_articles(t: Permit5271) kind empirical {
    label en official "a holder of an (a)(2) permit manufactured articles not corresponding to the descriptions and limitations prescribed (section 5271(e)(7))";
}
pub relation permit_last_operation_on(t: Permit5271, on: Date) kind empirical {
    label en official "the date of the last operation the permit authorized";
}
pub relation revocation_decision_on(t: Permit5271, on: Date) kind empirical {
    label en official "the date the Secretary decides on revocation or suspension";
}
pub relation permit_dormant_more_than_two_years(t: Permit5271) kind institutional {
    label en official "the holder has not engaged in any of the authorized operations for a period of more than 2 years (section 5271(e)(8))";
}
rule Section5271e8DormancyRule(t: Permit5271, last_op: Date, decided: Date) strict {
    label en official "section 5271(e)(8): more than 2 years since the last authorized operation";
    when permit_last_operation_on(t, last_op);
    when revocation_decision_on(t, decided);
    when decided > add_calendar_period(last_op, 2 calendar_year);
    then permit_dormant_more_than_two_years(t);
}
pub relation permit_revocation_ground_exists(t: Permit5271) kind institutional {
    label en unofficial "at least one section 5271(e)(1)-(8) ground exists (single-atom helper)";
}
rule Section5271eGround1Rule(t: Permit5271) strict {
    label en unofficial "ground (e)(1)";
    when permit_holder_not_in_good_faith_compliance(t);
    then permit_revocation_ground_exists(t);
}
rule Section5271eGround2Rule(t: Permit5271) strict {
    label en unofficial "ground (e)(2)";
    when permit_holder_violated_permit_conditions(t);
    then permit_revocation_ground_exists(t);
}
rule Section5271eGround3Rule(t: Permit5271) strict {
    label en unofficial "ground (e)(3)";
    when permit_holder_made_false_statement_in_application(t);
    then permit_revocation_ground_exists(t);
}
rule Section5271eGround4Rule(t: Permit5271) strict {
    label en unofficial "ground (e)(4)";
    when permit_holder_failed_to_disclose_required_material_information(t);
    then permit_revocation_ground_exists(t);
}
rule Section5271eGround5Rule(t: Permit5271) strict {
    label en unofficial "ground (e)(5)";
    when permit_holder_violated_liquor_law_or_convicted_of_felony_under_title(t);
    then permit_revocation_ground_exists(t);
}
rule Section5271eGround6Rule(t: Permit5271) strict {
    label en unofficial "ground (e)(6)";
    when permit_holder_no_longer_warranted_in_procuring_or_using_spirits(t);
    then permit_revocation_ground_exists(t);
}
rule Section5271eGround7Rule(t: Permit5271) strict {
    label en unofficial "ground (e)(7)";
    when permit_holder_manufactured_nonconforming_articles(t);
    then permit_revocation_ground_exists(t);
}
rule Section5271eGround8Rule(t: Permit5271) strict {
    label en unofficial "ground (e)(8)";
    when permit_dormant_more_than_two_years(t);
    then permit_revocation_ground_exists(t);
}
pub relation secretary_revokes_or_suspends_permit_after_notice_and_hearing(t: Permit5271) kind empirical {
    label en official "after notice and hearing the Secretary revokes the permit in whole or in part or suspends it for such period as the Secretary deems proper (section 5271(e))";
}
pub relation permit_revoked_or_suspended(t: Permit5271) kind institutional {
    label en official "the permit is revoked (in whole or part) or suspended";
}
@source(IRC_S5271_E, coverage = exact, quote = "such permit may, in whole or in part, be revoked or be suspended for such period as the Secretary deems proper.")
rule Section5271eRevocationPowerRule(t: Permit5271) strict {
    label en official "section 5271(e): the Secretary's revocation/suspension power, exercised after notice and hearing, is valid only when a listed ground exists (E-0239); the period of suspension is the Secretary's discretion";
    when secretary_revokes_or_suspends_permit_after_notice_and_hearing(t);
    then power Section5271PermitRevocation {
        holder us.irc.core::Secretary;
        over t;
        exercise secretary_revokes_or_suspends_permit_after_notice_and_hearing(t);
        valid_when permit_revocation_ground_exists(t);
        effect create(permit_revoked_or_suspended(t));
        window [-infinity, infinity];
    };
}
pub relation permit_terminated_by_its_terms_suspended_revoked_or_surrendered(t: Permit5271) kind empirical {
    label en official "the permit has terminated by its terms, been suspended or revoked, or been voluntarily surrendered (section 5271(f))";
}
pub relation permit_continues_in_effect(t: Permit5271) kind institutional {
    label en official "the permit continues in effect until suspended or revoked, or voluntarily surrendered (section 5271(f))";
}
pub relation permit_issued_and_held(t: Permit5271) kind empirical {
    label en official "the permit has been issued and is held";
}
@source(IRC_S5271_F, coverage = exact, quote = "unless terminated by the terms of the permit, shall continue in effect until suspended or revoked as provided in this section, or until voluntarily surrendered.")
rule Section5271fContinuationRule(t: Permit5271) defeasible {
    label en official "section 5271(f): a section 5271 permit continues in effect until it is suspended, revoked, or voluntarily surrendered, unless it terminates by its own terms";
    when permit_issued_and_held(t);
    unless permit_terminated_by_its_terms_suspended_revoked_or_surrendered(t) and permit_issued_and_held(t);
    then permit_continues_in_effect(t);
}
pub relation permit_kept_posted_available_for_inspection_on_premises(t: Permit5271) kind empirical {
    label en official "the permit is kept posted available for inspection on the premises covered by the permit (section 5271(g))";
}
pub relation permit_holder_of(t: Permit5271, p: Person) kind empirical {
    label en official "the person holds the permit";
}
@source(IRC_S5271_G, coverage = exact, quote = "shall be kept posted available for inspection on the premises covered by the permit.")
rule Section5271gPostingDutyRule(t: Permit5271, p: Person) defeasible {
    label en official "section 5271(g): a permit holder keeps the permit posted available for inspection on the covered premises";
    when permit_holder_of(t, p);
    when permit_continues_in_effect(t);
    then duty Section5271gPermitPostingDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition permit_kept_posted_available_for_inspection_on_premises(t);
            window [-infinity, infinity];
        }
    };
}
pub relation permit_applicant_is_government_body(p: Person) kind empirical {
    label en official "the permit is issued to the United States or a governmental agency, to a State or political subdivision, or to the District of Columbia (section 5272(b))";
}
pub relation permit_bond_not_required(p: Person) kind institutional {
    label en official "no bond shall be required for permits issued to governmental bodies (section 5272(b))";
}
@source(IRC_S5272_B, coverage = exact, quote = "No bond shall be required in the case of permits issued to the United States or any governmental agency thereof, or to the several States or any political subdivision thereof, or to the District of Columbia.")
rule Section5272bNoBondForGovernmentRule(p: Person) strict {
    label en official "section 5272(b): government permittees furnish no bond";
    when permit_applicant_is_government_body(p);
    then permit_bond_not_required(p);
}
pub enum SpeciallyDenaturedSpiritsUse { ManufactureOfArticle; MedicinalOrFlavoringForInternalHumanUse; SaleOfMedicinalOrFlavoringForInternalHumanUse; BeverageWithdrawalOrSale; }
pub relation person_uses_specially_denatured_spirits(p: Person, u: SpeciallyDenaturedSpiritsUse) kind empirical {
    label en official "the person uses specially denatured spirits in the manufacture or production of an article; uses denatured spirits in medicinal preparations or flavoring extracts for internal human use; sells such products; or withdraws or sells denatured spirits or articles for beverage purposes (section 5273)";
}
pub relation article_formula_and_process_approved_by_secretary(p: Person) kind empirical {
    label en official "approval of the article, formula, and process has been obtained from the Secretary (section 5273(a))";
}
pub relation spirits_remain_in_finished_product(p: Person) kind empirical {
    label en official "any of the denatured spirits remains in the finished medicinal preparation or flavoring extract (section 5273(b))";
}
@source(IRC_S5273_A, coverage = partial, quote = "no person shall use specially denatured distilled spirits in the manufacture or production of any article until approval of the article, formula, and process has been obtained from the Secretary.")
rule Section5273aUnapprovedManufactureProhibitionRule(p: Person, u: SpeciallyDenaturedSpiritsUse) defeasible {
    label en official "section 5273(a): specially denatured spirits may not be used in manufacture of an article until the Secretary approves article, formula, and process";
    when person_uses_specially_denatured_spirits(p, u);
    when u == ManufactureOfArticle;
    unless article_formula_and_process_approved_by_secretary(p) and person_uses_specially_denatured_spirits(p, u);
    then prohibition Section5273aUnapprovedManufactureProhibition {
        bearer p;
        action person_uses_specially_denatured_spirits(p, u);
        window [-infinity, infinity];
    };
}
@source(IRC_S5273_B, coverage = exact, quote = "No person shall use denatured distilled spirits in the manufacture of medicinal preparations or flavoring extracts for internal human use where any of the spirits remains in the finished product.")
rule Section5273b1MedicinalUseProhibitionRule(p: Person, u: SpeciallyDenaturedSpiritsUse) strict {
    label en official "section 5273(b)(1): denatured spirits may not be used in medicinal preparations or flavoring extracts for internal human use where spirits remain in the finished product";
    when person_uses_specially_denatured_spirits(p, u);
    when u == MedicinalOrFlavoringForInternalHumanUse;
    when spirits_remain_in_finished_product(p);
    then prohibition Section5273b1MedicinalUseProhibition {
        bearer p;
        action person_uses_specially_denatured_spirits(p, u);
        window [-infinity, infinity];
    };
}
@source(IRC_S5273_B, coverage = exact, quote = "No person shall sell or offer for sale for internal human use any medicinal preparations or flavoring extracts manufactured from denatured distilled spirits where any of the spirits remains in the finished product.")
rule Section5273b2SaleProhibitionRule(p: Person, u: SpeciallyDenaturedSpiritsUse) strict {
    label en official "section 5273(b)(2): such preparations may not be sold or offered for sale for internal human use";
    when person_uses_specially_denatured_spirits(p, u);
    when u == SaleOfMedicinalOrFlavoringForInternalHumanUse;
    when spirits_remain_in_finished_product(p);
    then prohibition Section5273b2SaleProhibition {
        bearer p;
        action person_uses_specially_denatured_spirits(p, u);
        window [-infinity, infinity];
    };
}
@source(IRC_S5273_D, coverage = exact, quote = "No person shall withdraw or sell denatured distilled spirits, or sell any article containing denatured distilled spirits for beverage purposes.")
rule Section5273dBeverageProhibitionRule(p: Person, u: SpeciallyDenaturedSpiritsUse) strict {
    label en official "section 5273(d): no person withdraws or sells denatured spirits, or sells an article containing them, for beverage purposes";
    when person_uses_specially_denatured_spirits(p, u);
    when u == BeverageWithdrawalOrSale;
    then prohibition Section5273dBeveragePurposesProhibition {
        bearer p;
        action person_uses_specially_denatured_spirits(p, u);
        window [-infinity, infinity];
    };
}
pub relation person_procures_uses_or_recovers_denatured_spirits_under_permit(p: Person) kind empirical {
    label en official "the person procures or uses spirits withdrawn under section 5214(a)(2) or (3), or procures, deals in, uses, or recovers specially or completely denatured spirits (section 5275)";
}
pub relation permit_activity_records_kept_and_reports_filed(p: Person) kind empirical {
    label en official "the person keeps the records and files the reports of receipt, disposition, use, recovery, and manufacture that the Secretary prescribes (section 5275)";
}
@source(IRC_S5275, coverage = partial, quote = "shall keep such records and file such reports of the receipt and use of distilled spirits withdrawn free of tax")
rule Section5275RecordsDutyRule(p: Person) strict {
    label en official "section 5275: persons procuring or using free-of-tax spirits or dealing in or recovering denatured spirits keep records and file reports (content per regulations — EXTERNAL_DEPENDENCY)";
    when person_procures_uses_or_recovers_denatured_spirits_under_permit(p);
    then duty Section5275RecordsAndReportsDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition permit_activity_records_kept_and_reports_filed(p);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// Sections 5291, 5301: returns of dispositions; container regulation
// =============================================================================

pub relation person_disposes_of_spirits_making_substance_or_recoverable_articles(p: Person) kind empirical {
    label en official "the person disposes of any substance of the character used in the manufacture of distilled spirits, or of denatured spirits or articles from which spirits may be recovered (section 5291(a))";
}
pub relation secretary_requires_disposition_return_from(p: Person) kind empirical {
    label en official "the Secretary requires the person to render a return of dispositions (section 5291(a): 'when required by the Secretary')";
}
pub relation disposition_return_rendered(p: Person) kind empirical {
    label en official "the person renders a correct return showing the name and address of each transferee and the quantity";
}
@source(IRC_S5291_A, coverage = exact, quote = "shall, when required by the Secretary, render a correct return")
rule Section5291aReturnDutyRule(p: Person) strict {
    label en official "section 5291(a): a person disposing of spirits-making substances, denatured spirits, or recoverable articles renders a return of each disposition when the Secretary requires it";
    when person_disposes_of_spirits_making_substance_or_recoverable_articles(p);
    when secretary_requires_disposition_return_from(p);
    then duty Section5291aDispositionReturnDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition disposition_return_rendered(p);
            window [-infinity, infinity];
        }
    };
}
pub relation seller_of_spirits_or_agent(p: Person) kind empirical {
    label en official "the person sells or offers for sale distilled spirits, or is an agent or employee of such person (section 5301(c))";
}
pub enum LiquorBottleActivity { PlaceForeignSpiritsInBottle; PossessBottleWithForeignSpirits; AlterOrIncreaseContentsByAddition; PossessBottleWithAlteredContents; }
pub relation liquor_bottle_activity(p: Person, a: LiquorBottleActivity) kind empirical {
    label en official "the seller (or agent or employee) places other spirits in a liquor bottle than those contained at tax determination; possesses such a bottle; adds a substance to alter or increase the original contents; or possesses such an altered bottle (section 5301(c)(1)-(4))";
}
pub relation liquor_bottle_reuse_authorized_by_regulation(p: Person) kind empirical {
    label en official "the Secretary has by regulations authorized the reuse of liquor bottles, and the conditions are met (section 5301(c) proviso)";
}
@source(IRC_S5301_C, coverage = exact, quote = "No person who sells, or offers for sale, distilled spirits, or agent or employee of such person, shall—")
rule Section5301cBottleProhibitionRule(p: Person, a: LiquorBottleActivity) defeasible {
    label en official "section 5301(c)(1)-(4): a seller of spirits (or its agent or employee) may not refill a liquor bottle with other spirits, possess such a bottle, add to or alter its contents, or possess an altered bottle, except reuse authorized by regulations";
    when seller_of_spirits_or_agent(p);
    when liquor_bottle_activity(p, a);
    unless liquor_bottle_reuse_authorized_by_regulation(p) and seller_of_spirits_or_agent(p) and liquor_bottle_activity(p, a);
    then prohibition Section5301LiquorBottleProhibition {
        bearer p;
        action liquor_bottle_activity(p, a);
        window [-infinity, infinity];
    };
}
pub relation container_withdrawn_from_bonded_premises_or_customs_on_determination_of_tax(c: SpiritsContainer) kind empirical {
    label en official "the immediate container of distilled spirits is withdrawn from bonded premises, or from customs custody, on determination of tax (section 5301(d))";
}
pub relation container_is_bulk_container(c: SpiritsContainer) kind empirical {
    label en official "the container holds bulk distilled spirits (section 5301(d) exclusion)";
}
pub relation immediate_container_required_to_bear_breakable_closure(c: SpiritsContainer) kind institutional {
    label en official "the immediate container must bear a closure or other device requiring breaking in order to gain access to the contents (section 5301(d)); the addressee is not named — the consequences lie in sections 5604(a)(1) and 5613(b)";
}
@source(IRC_S5301_D, coverage = exact, quote = "The immediate container of distilled spirits withdrawn from bonded premises, or from customs custody, on determination of tax shall bear a closure or other device which is designed so as to require breaking in order to gain access to the contents of such container.")
rule Section5301dClosureRequirementRule(c: SpiritsContainer) defeasible {
    label en official "section 5301(d): a non-bulk immediate container withdrawn on determination of tax must bear a breakable closure";
    when container_withdrawn_from_bonded_premises_or_customs_on_determination_of_tax(c);
    unless container_is_bulk_container(c) and container_withdrawn_from_bonded_premises_or_customs_on_determination_of_tax(c);
    then immediate_container_required_to_bear_breakable_closure(c);
}

// =============================================================================
// Sections 5311, 5312, 5313, 5314
// =============================================================================

pub relation officer_detains_container_with_reason_to_believe_tax_unpaid_or_removal_unlawful(o: Person, c: SpiritsContainer) kind empirical {
    label en official "the officer detains a container containing or supposed to contain spirits, wines, or beer, having reason to believe the tax has not been paid or determined as required by law or that the container is being removed in violation of law (section 5311)";
}
@source(IRC_S5311, coverage = partial, quote = "It shall be lawful for any internal revenue officer to detain any container, containing or supposed to contain, distilled spirits, wines, or beer")
rule Section5311DetentionLibertyRule(o: Person, c: SpiritsContainer) strict {
    label en official "section 5311: it is lawful for an internal revenue officer to detain a container of spirits, wines, or beer on reason to believe the tax is unpaid or removal unlawful, and to hold it at a safe place until the question of liability to seizure is determined (the reason-to-believe test is the officer's own belief — EVALUATIVE)";
    when is_internal_revenue_officer(o);
    when officer_detains_container_with_reason_to_believe_tax_unpaid_or_removal_unlawful(o, c);
    then liberty Section5311DetainContainer {
        holder o;
        action officer_detains_container_with_reason_to_believe_tax_unpaid_or_removal_unlawful(o, c);
        window [-infinity, infinity];
    };
}
pub relation spirits_are_puerto_rico_products_for_5214a2_3_denatured_or_articles(l: AlcoholicLot) kind empirical {
    label en official "spirits for the purposes authorized in section 5214(a)(2) and (3), denatured spirits, or articles manufactured from denatured spirits, produced or manufactured in Puerto Rico (section 5314(a)(2)(A)-(E))";
}
pub relation puerto_rico_legislative_assembly_consented(dummy: Person) kind empirical {
    label en official "the Legislative Assembly of the Commonwealth of Puerto Rico has expressly consented to section 5314(a) in the manner prescribed by its constitution (section 5314(a)(1))";
}
pub relation puerto_rico_product_may_enter_free_of_5001a9_and_7652a1_tax(l: AlcoholicLot) kind institutional {
    label en official "the product may be brought into the United States free of any tax imposed by section 5001(a)(9) or 7652(a)(1), for disposal under the same conditions as like United States products (section 5314(a)(2))";
}
@source(IRC_S5314_A, coverage = partial, quote = "may be brought into the United States free of any tax imposed by section 5001(a)(9) or 7652(a)(1) for disposal under the same conditions as like spirits, denatured spirits, and articles, produced or manufactured in the United States")
rule Section5314a2PuertoRicoFreeEntryRule(l: AlcoholicLot, dummy: Person) strict {
    label en official "section 5314(a)(2): Puerto Rican spirits for the section 5214(a)(2)/(3) purposes, denatured spirits, and articles from them may enter free of tax, but paragraph (a) does not apply to Puerto Rico unless its Legislative Assembly expressly consents (paragraph (1))";
    when spirits_are_puerto_rico_products_for_5214a2_3_denatured_or_articles(l);
    when puerto_rico_legislative_assembly_consented(dummy);
    then puerto_rico_product_may_enter_free_of_5001a9_and_7652a1_tax(l);
}
pub relation puerto_rico_spirits_withdrawn_under_puerto_rico_law(l: AlcoholicLot) kind empirical {
    label en official "spirits (including denatured spirits) are withdrawn from the bonded premises of a plant in Puerto Rico pursuant to authorization issued under Puerto Rico law (section 5314(a)(3))";
}
pub relation puerto_rico_withdrawn_product_may_not_enter_free_of_tax(l: AlcoholicLot) kind institutional {
    label en official "such spirits, and products containing them, may not be brought into the United States free of tax (section 5314(a)(3))";
}
@source(IRC_S5314_A, coverage = exact, quote = "such spirits so withdrawn, and products containing such spirits so withdrawn, may not be brought into the United States free of tax.")
rule Section5314a3NoFreeEntryRule(l: AlcoholicLot) strict {
    label en official "section 5314(a)(3): spirits withdrawn under Puerto Rico law, and products containing them, may not enter free of tax";
    when puerto_rico_spirits_withdrawn_under_puerto_rico_law(l);
    then puerto_rico_withdrawn_product_may_not_enter_free_of_tax(l);
}
pub relation spirits_are_virgin_islands_products_for_5214a2_3_denatured_or_articles(l: AlcoholicLot) kind empirical {
    label en official "spirits for the purposes authorized in section 5214(a)(2) and (3), denatured spirits, or articles manufactured from denatured spirits, produced or manufactured in the Virgin Islands (section 5314(b)(1)(A)-(E))";
}
pub relation virgin_islands_product_may_enter_free_of_7652b1_tax(l: AlcoholicLot) kind institutional {
    label en official "the product may be brought into the United States free of any tax imposed by section 7652(b)(1), for disposal under the same conditions as like United States products (section 5314(b)(1))";
}
@source(IRC_S5314_B, coverage = partial, quote = "may be brought into the United States free of any tax imposed by section 7652(b)(1) for disposal under the same conditions as like spirits, denatured spirits, and articles, produced or manufactured in the United States")
rule Section5314b1VirginIslandsFreeEntryRule(l: AlcoholicLot) strict {
    label en official "section 5314(b)(1): Virgin Islands spirits for the section 5214(a)(2)/(3) purposes, denatured spirits, and articles from them may enter free of tax";
    when spirits_are_virgin_islands_products_for_5214a2_3_denatured_or_articles(l);
    then virgin_islands_product_may_enter_free_of_7652b1_tax(l);
}
