// Alcohol -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): section 5011(c)(1) (G6899), the average
// tax-financing cost per case: the interest at the deemed financing rate for a 60-day period on the deemed Federal excise tax
// per case ($25.68).
//
// TECHNIQUE. The power (1 + r/365)^60 is built by binary exponentiation unrolled to the six squarings that 60 = 32 + 16 + 8 + 4
// needs (the language has `pow` only for Integer pow Integer); EVERY product is rounded to 12 decimal places HALF_UP, so the
// factor never grows past the value range the evaluators share (the reason the earlier attempt was refused) and the error is below
// 1e-12 per step, far below a cent. The interest is the deemed excise tax times (factor - 1), cents HALF_UP.
// JUDGMENT CALLS (the statute names neither): (1) the interest is compounded DAILY with a 365-day year (the day-count convention
// of section 6622 for the interest of section 6621 rates); (2) the 12-place rounding of the factor. The asserted
// `average_tax_financing_cost_per_case` (module 11) stays as the channel used when the computation has no rates
// (`average_tax_financing_cost_for_credit` below); the section 5011(a) credit rule reads the merged relation.

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

use self::{
    IRC_S5011_C,
    average_tax_financing_cost_per_case,
    deemed_federal_excise_tax_per_case_is,
    deemed_financing_rate_for_year,
};

relation financing_factor_1(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^1: one daily period at the deemed financing rate, the daily rate rounded to 12 places HALF_UP";
}
@source(IRC_S5011_C, relation = formalizes, coverage = partial, quote = "the amount of interest which would accrue at the deemed financing rate during a 60-day period on an amount equal to the deemed Federal excise tax per case")
rule FinancingFactor1(y: Integer, r: Decimal) strict {
    label en official "the daily factor 1 + r/365";
    when deemed_financing_rate_for_year(y, r);
    then financing_factor_1(y, 1.0 + div_round(r, 365.0, 12, "HALF_UP"));
}
relation financing_factor_2(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^2: the square of the previous level, rounded to 12 places HALF_UP";
}
rule FinancingFactor2(y: Integer, f: Decimal) strict {
    label en official "the square of (1 + rate/365)^1";
    when financing_factor_1(y, f);
    then financing_factor_2(y, round(f * f, 12, "HALF_UP"));
}
relation financing_factor_4(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^4: the square of the previous level, rounded to 12 places HALF_UP";
}
rule FinancingFactor4(y: Integer, f: Decimal) strict {
    label en official "the square of (1 + rate/365)^2";
    when financing_factor_2(y, f);
    then financing_factor_4(y, round(f * f, 12, "HALF_UP"));
}
relation financing_factor_8(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^8: the square of the previous level, rounded to 12 places HALF_UP";
}
rule FinancingFactor8(y: Integer, f: Decimal) strict {
    label en official "the square of (1 + rate/365)^4";
    when financing_factor_4(y, f);
    then financing_factor_8(y, round(f * f, 12, "HALF_UP"));
}
relation financing_factor_16(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^16: the square of the previous level, rounded to 12 places HALF_UP";
}
rule FinancingFactor16(y: Integer, f: Decimal) strict {
    label en official "the square of (1 + rate/365)^8";
    when financing_factor_8(y, f);
    then financing_factor_16(y, round(f * f, 12, "HALF_UP"));
}
relation financing_factor_32(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^32: the square of the previous level, rounded to 12 places HALF_UP";
}
rule FinancingFactor32(y: Integer, f: Decimal) strict {
    label en official "the square of (1 + rate/365)^16";
    when financing_factor_16(y, f);
    then financing_factor_32(y, round(f * f, 12, "HALF_UP"));
}
relation financing_factor_48(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^48 = ^32 x ^16, rounded to 12 places HALF_UP";
}
rule FinancingFactor48(y: Integer, f32: Decimal, f16: Decimal) strict {
    label en official "the product of the 32nd and 16th powers";
    when financing_factor_32(y, f32);
    when financing_factor_16(y, f16);
    then financing_factor_48(y, round(f32 * f16, 12, "HALF_UP"));
}
relation financing_factor_56(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^56 = ^48 x ^8, rounded to 12 places HALF_UP";
}
rule FinancingFactor56(y: Integer, f48: Decimal, f8: Decimal) strict {
    label en official "the product of the 48th and 8th powers";
    when financing_factor_48(y, f48);
    when financing_factor_8(y, f8);
    then financing_factor_56(y, round(f48 * f8, 12, "HALF_UP"));
}
pub relation financing_factor_60(year: Integer, factor: Decimal) kind institutional {
    label en official "(1 + rate/365)^60 = ^56 x ^4: the growth of one unit over a 60-day period at the deemed financing rate, daily compounding, 12 places HALF_UP (JUDGMENT CALL)";
}
rule FinancingFactor60(y: Integer, f56: Decimal, f4: Decimal) strict {
    label en official "the product of the 56th and 4th powers";
    when financing_factor_56(y, f56);
    when financing_factor_4(y, f4);
    then financing_factor_60(y, round(f56 * f4, 12, "HALF_UP"));
}
pub relation average_tax_financing_cost_per_case_computed(year: Integer, cost: Money) kind institutional {
    label en official "section 5011(c)(1): the interest that would accrue at the deemed financing rate during a 60-day period on the deemed Federal excise tax per case; cents HALF_UP";
}
@source(IRC_S5011_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the average tax-financing cost per case for any calendar year is the amount of interest which would accrue at the deemed financing rate during a 60-day period on an amount equal to the deemed Federal excise tax per case.")
rule AverageTaxFinancingCostPerCaseComputed(y: Integer, f60: Decimal, tax: Money) strict {
    label en official "deemed excise tax x ((1 + rate/365)^60 - 1)";
    when financing_factor_60(y, f60);
    when deemed_federal_excise_tax_per_case_is(tax);
    then average_tax_financing_cost_per_case_computed(y, round(tax * (f60 - 1.0), 2, "HALF_UP"));
}
relation has_computed_financing_cost_per_case(year: Integer) kind institutional {
    label en official "bridge for the absence test";
}
rule HasComputedFinancingCostPerCase(y: Integer, c: Money) strict {
    label en official "bridge for the absence test";
    when average_tax_financing_cost_per_case_computed(y, c);
    then has_computed_financing_cost_per_case(y);
}
pub relation average_tax_financing_cost_for_credit(year: Integer, cost: Money) kind institutional {
    label en official "the average tax-financing cost per case the section 5011(a) credit reads: the computed cost where the deemed financing rate of the year is derived, else the asserted cost";
}
rule AverageTaxFinancingCostForCreditComputed(y: Integer, c: Money) strict {
    label en official "the computed cost";
    when average_tax_financing_cost_per_case_computed(y, c);
    then average_tax_financing_cost_for_credit(y, c);
}
rule AverageTaxFinancingCostForCreditAsserted(y: Integer, c: Money) strict {
    label en official "the asserted cost (the earlier channel)";
    when average_tax_financing_cost_per_case(y, c);
    when not_known(has_computed_financing_cost_per_case(y));
    then average_tax_financing_cost_for_credit(y, c);
}
