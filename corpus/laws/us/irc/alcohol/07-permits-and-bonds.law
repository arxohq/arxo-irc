// Sections 5171 (establishment), 5172 (application), 5173 (bonds).

use self::{
    IRC_S5171_A,
    IRC_S5171_C,
    IRC_S5173_A,
    Person,
    SpiritsRemoval,
};

pub entity DistilledSpiritsPlant {
    label en unofficial "bonded premises qualified under subchapter B for distiller, warehouseman, or processor operations (section 5171)";
}

// --- Section 5171(a): prohibition on operating without registration ---------

pub relation operates_as_distiller_warehouseman_or_processor(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "p conducts operations as a distiller, warehouseman, or processor at the plant (section 5171(a))";
}
@source(IRC_S5171_A, coverage = exact, quote = "Except as otherwise provided by law, operations as a distiller, warehouseman, or processor may be conducted only on the bonded premises of a distilled spirits plant by a person who is qualified under this subchapter.")
rule Section5171aPermitRequiredProhibitionRule(p: Person, plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5171(a): operating as a distiller, warehouseman, or processor is prohibited unless the person is qualified (registered) under this subchapter — the prohibition is VIOLATED on itself when an unqualified person conducts the operation (E-0179)";
    when operates_as_distiller_warehouseman_or_processor(p, plant);
    unless plant_registered(plant, p) and operates_as_distiller_warehouseman_or_processor(p, plant);
    then prohibition Section5171UnregisteredOperationProhibition {
        bearer p;
        action operates_as_distiller_warehouseman_or_processor(p, plant);
        window [-infinity, infinity];
    };
}

// --- Section 5171(c): registration (the Secretary's power to issue) --------

pub relation registration_application_filed(p: Person, plant: DistilledSpiritsPlant, filed_on: Date) kind empirical {
    label en official "the person makes application to the Secretary for registration of the plant, before commencing operations (section 5171(c)(1))";
}
pub relation applicant_complied_with_qualification_requirements(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the applicant has complied with the requirements of law and regulations relating to qualification of the plant (section 5171(c)(4))";
}
pub relation plant_registered(plant: DistilledSpiritsPlant, p: Person) kind institutional {
    label en official "the Secretary has given notice of registration of the plant to this person (section 5171(c)(1)); the operations covered by the registration";
}
@source(IRC_S5171_C, coverage = partial, quote = "Each person shall, before commencing operations at a distilled spirits plant (and at such other times as the Secretary may by regulations prescribe), make application to the Secretary for, and receive notice of, the registration of such plant.")
rule Section5171cRegistrationPowerRule(p: Person, plant: DistilledSpiritsPlant, filed_on: Date) defeasible {
    label en official "section 5171(c): the Secretary's power to register the plant is validly exercised only once the applicant has complied with the qualification requirements of (c)(4); an application filed before compliance yields no registration (E-0239, POWER_INVALID_EXERCISE)";
    when registration_application_filed(p, plant, filed_on);
    then power Section5171RegistrationGrant {
        holder us.irc.core::Secretary;
        over plant;
        exercise registration_application_filed(p, plant, filed_on);
        valid_when applicant_complied_with_qualification_requirements(p, plant);
        effect create(plant_registered(plant, p));
        window [-infinity, infinity];
    };
}

// --- Section 5172: application (institutional, non-computational) ----------
//
// The content of the application (identifying the applicant, showing the
// premises, the operations to be conducted, and "any other information
// which the Secretary may by regulations require") is a filing-content
// requirement, not an independent norm with its own consequence beyond
// enabling section 5171(c)'s registration — folded into
// `registration_application_filed` above (NON_NORMATIVE: describes the
// application's contents, does not itself impose a duty/power/prohibition).

// --- Section 5173: bonds (prohibition + bond-sufficiency condition) --------

pub relation commences_operations_at_plant(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the person commences operations at the distilled spirits plant (section 5173(a)(1))";
}
pub relation excepted_under_5551d(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en unofficial "the person is within the section 5551(d) exception (a small-taxpayer bond exemption cross-referenced by section 5173(a)) — case-asserted; section 5551 itself is outside this stage's priority scope (EXTERNAL_DEPENDENCY)";
}
pub relation operations_bond_furnished(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the person has furnished a bond covering operations at the plant meeting section 5173(b) (single plant, plant-and-adjacent-wine-cellar, or same-person/same-area multi-plant), or the section 5173(d) unit bond (section 5173(a)(1))";
}
pub relation operations_bond_or_exception_satisfied(p: Person, plant: DistilledSpiritsPlant) kind institutional {
    label en unofficial "either the section 5173(a)(1) operations bond has been furnished, or the section 5551(d) exception applies (single-atom helper for the unless clause)";
}
rule OperationsBondSatisfiedByBondRule(p: Person, plant: DistilledSpiritsPlant) strict {
    label en unofficial "the operations-bond condition is satisfied by an actual bond";
    when operations_bond_furnished(p, plant);
    then operations_bond_or_exception_satisfied(p, plant);
}
rule OperationsBondSatisfiedByExceptionRule(p: Person, plant: DistilledSpiritsPlant) strict {
    label en unofficial "the operations-bond condition is satisfied by the section 5551(d) exception";
    when excepted_under_5551d(p, plant);
    then operations_bond_or_exception_satisfied(p, plant);
}
@source(IRC_S5173_A, coverage = exact, quote = "no person intending to establish a distilled spirits plant may commence operations at such plant unless such person has furnished bond covering operations at such plant")
rule Section5173aOperationsBondProhibitionRule(p: Person, plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5173(a)(1): commencing operations without the required operations bond is prohibited, except for a taxpayer within the section 5551(d) exception";
    when commences_operations_at_plant(p, plant);
    unless operations_bond_or_exception_satisfied(p, plant) and commences_operations_at_plant(p, plant);
    then prohibition Section5173NoOperationsBondProhibition {
        bearer p;
        action commences_operations_at_plant(p, plant);
        window [-infinity, infinity];
    };
}
pub relation withdraws_spirits_without_payment(p: Person, r: SpiritsRemoval, plant: DistilledSpiritsPlant) kind empirical {
    label en official "distilled spirits (other than spirits withdrawn under section 5214 or 7510) are withdrawn from bonded premises without payment of tax (section 5173(a)(2))";
}
pub relation withdrawal_bond_furnished(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the proprietor of the bonded premises has furnished bond covering withdrawal (section 5173(a)(2)/(c)/(d))";
}
pub relation withdrawal_bond_or_exception_satisfied(p: Person, plant: DistilledSpiritsPlant) kind institutional {
    label en unofficial "either the section 5173(a)(2) withdrawal bond has been furnished, or the section 5551(d) exception applies (single-atom helper for the unless clause)";
}
rule WithdrawalBondSatisfiedByBondRule(p: Person, plant: DistilledSpiritsPlant) strict {
    label en unofficial "the withdrawal-bond condition is satisfied by an actual bond";
    when withdrawal_bond_furnished(p, plant);
    then withdrawal_bond_or_exception_satisfied(p, plant);
}
rule WithdrawalBondSatisfiedByExceptionRule(p: Person, plant: DistilledSpiritsPlant) strict {
    label en unofficial "the withdrawal-bond condition is satisfied by the section 5551(d) exception";
    when excepted_under_5551d(p, plant);
    then withdrawal_bond_or_exception_satisfied(p, plant);
}
@source(IRC_S5173_A, coverage = exact, quote = "no distilled spirits (other than distilled spirits withdrawn under section 5214 or 7510) may be withdrawn from bonded premises except on payment of tax unless the proprietor of the bonded premises has furnished bond covering such withdrawal")
rule Section5173aWithdrawalBondProhibitionRule(p: Person, r: SpiritsRemoval, plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5173(a)(2): withdrawing spirits without payment of tax and without the required withdrawal bond is prohibited, except for a taxpayer within the section 5551(d) exception";
    when withdraws_spirits_without_payment(p, r, plant);
    unless withdrawal_bond_or_exception_satisfied(p, plant) and withdraws_spirits_without_payment(p, r, plant);
    then prohibition Section5173NoWithdrawalBondProhibition {
        bearer p;
        action withdraws_spirits_without_payment(p, r, plant);
        window [-infinity, infinity];
    };
}
// (b)-(d) (bond coverage combinations: single plant / plant-plus-adjacent-
// wine-cellar / same-person multi-plant in one geographic area / the unit
// bond covering both operations and withdrawals): these are alternative
// SHAPES a sufficient bond may take, folded into `operations_bond_furnished`/
// `withdrawal_bond_furnished` as case-asserted facts (INTERPRETATION: the
// case supplies which of (b)(1)-(3)/(d) shape the bond meets, since each
// shape has no separate legal consequence beyond bond sufficiency itself).
// (e): bond conditions (faithful compliance, payment of taxes/penalties)
// describe what the SURETY undertakes, not a further norm on the taxpayer —
// NON_NORMATIVE (contractual content of an already-modelled prohibition's
// escape condition). (f)-(h): penal-sum amount-setting delegated entirely to
// Secretary regulations (EXTERNAL_DEPENDENCY — no self-contained minimum/
// maximum figure is stated in the text itself).
