// Sections 5008 (abatement, remission, refund, allowance for loss or
// destruction) and 5010 (credit for wine content and for flavors content).

// --- Section 5008(a): loss/destruction while in bond -------------------------
//
// (a)(1): "no tax shall be collected ... except" three named cases —
// modelled as a `power` (the claim for relief the proprietor files,
// section (a)(2)) whose `valid_when` excludes the three named
// non-relief cases; a valid claim's effect is relief from/refund of tax
// (a)(3), an invalid claim (one of the three exceptions applies) leaves
// the tax collectible (E-0239: POWER_INVALID_EXERCISE, no effect).

use self::{
    IRC_S5008_A,
    IRC_S5008_C,
    IRC_S5010_A,
    Person,
    SpiritsRemoval,
    WineLossCause,
    loss_barred_by_5008a4_timing,
};

pub enum SpiritsLossCause { Theft; VoluntaryDestruction; UnexplainedBottledShortage; OtherLoss; }
pub relation spirits_loss(r: SpiritsRemoval, cause: SpiritsLossCause) kind empirical {
    label en official "distilled spirits were lost or destroyed while in bond, and the cause of the loss (section 5008(a)(1))";
}
pub relation theft_without_connivance_collusion_fraud_or_negligence(r: SpiritsRemoval) kind empirical {
    label en official "the Secretary finds the theft occurred without connivance, collusion, fraud, or negligence on the part of the proprietor, owner, consignor, consignee, bailee, carrier, or their employees/agents (section 5008(a)(1)(A)) — DECISION-0194 evaluative channel: Secretary's own finding, burden on the claimant (section 5008(a)(2))";
}
pub relation destruction_carried_out_under_5008b(r: SpiritsRemoval) kind empirical {
    label en official "the voluntary destruction was carried out under Secretary-approved supervision and regulations, as section 5008(b) requires";
}
pub relation loss_claim_filed(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "the proprietor of the distilled spirits plant (or other person liable for the tax) files a claim for relief from the tax on this loss (section 5008(a)(2))";
}
pub relation loss_relieved_from_tax(r: SpiritsRemoval) kind institutional {
    label en official "the tax on the lost/destroyed distilled spirits is not collected (or, if paid, is refunded) — section 5008(a)(1)/(a)(3)";
}
pub relation loss_indemnified(r: SpiritsRemoval) kind empirical {
    label en official "the claimant is indemnified against, or recompensed in respect of, the tax for the theft loss (section 5008(a)(4), second sentence): bars relief for a theft loss to the extent of the indemnification";
}
@source(IRC_S5008_A, coverage = exact, quote = "No tax shall be collected in respect of distilled spirits lost or destroyed while in bond, except that such tax shall be collected")
rule Section5008aLossClaimPowerRule(r: SpiritsRemoval, p: Person, cause: SpiritsLossCause) defeasible {
    label en official "section 5008(a): the proprietor's claim for relief from tax on a bonded loss is valid unless the loss is (A) an unexcused theft, (B) an unapproved voluntary destruction, or (C) an unexplained bottled-spirits shortage";
    when loss_claim_filed(r, p);
    when spirits_loss(r, cause);
    then power Section5008LossReliefClaim {
        holder p;
        over r;
        exercise loss_claim_filed(r, p);
        valid_when loss_claim_eligible(r, cause);
        effect create(loss_relieved_from_tax(r));
        window [-infinity, infinity];
    };
}
pub relation loss_claim_eligible(r: SpiritsRemoval, cause: SpiritsLossCause) kind institutional {
    label en official "the loss does not fall within one of the three section 5008(a)(1) exceptions to relief (single-atom valid_when helper, per the compact-syntax constraint on power slots)";
}
@source(IRC_S5008_A, relation = formalizes, coverage = exact, quote = "In the case of loss by theft, unless the Secretary finds that the theft occurred without connivance, collusion, fraud, or negligence")
rule Section5008aTheftEligibleRule(r: SpiritsRemoval, cause: SpiritsLossCause) defeasible {
    label en official "a theft loss is eligible for relief only when the Secretary finds it occurred without connivance/collusion/fraud/negligence, and the claimant is not indemnified for it";
    when spirits_loss(r, cause);
    when cause == Theft;
    when theft_without_connivance_collusion_fraud_or_negligence(r);
    when not_known(loss_barred_by_5008a4_timing(r));
    unless loss_indemnified(r) and spirits_loss(r, cause) and cause == Theft;
    then loss_claim_eligible(r, cause);
}
@source(IRC_S5008_A, relation = formalizes, coverage = exact, quote = "In the case of voluntary destruction, unless such destruction is carried out as provided in subsection (b)")
rule Section5008aVoluntaryDestructionEligibleRule(r: SpiritsRemoval, cause: SpiritsLossCause) strict {
    label en official "a voluntary-destruction loss is eligible for relief only when the destruction was carried out under section 5008(b)'s supervision and regulations";
    when spirits_loss(r, cause);
    when cause == VoluntaryDestruction;
    when destruction_carried_out_under_5008b(r);
    when not_known(loss_barred_by_5008a4_timing(r));
    then loss_claim_eligible(r, cause);
}
@source(IRC_S5008_A, relation = formalizes, coverage = contextual, quote = "In the case of an unexplained shortage of bottled distilled spirits.")
rule Section5008aOtherLossEligibleRule(r: SpiritsRemoval, cause: SpiritsLossCause) strict {
    label en official "any loss other than the three named exceptions (an ordinary bulk-storage loss, section 5008(a)(1) opening clause) is eligible for relief";
    when spirits_loss(r, cause);
    when cause == OtherLoss;
    when not_known(loss_barred_by_5008a4_timing(r));
    then loss_claim_eligible(r, cause);
}
// An unexplained BOTTLED shortage (cause = UnexplainedBottledShortage) has
// NO eligibility rule: section 5008(a)(1)(C) collects the tax on it without
// exception (the statute states no Secretary-finding escape valve for this
// third case, unlike (A) and (B)) — absence of a rule is the correct
// negative result (§190), not an omission.

// --- Section 5008(c): return of spirits to bonded premises -------------------

pub relation returned_to_bonded_premises(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "distilled spirits on which tax has been determined or paid are returned to bonded premises under section 5215(a)";
}
pub relation return_claim_filed(r: SpiritsRemoval, p: Person, filed_on: Date) kind empirical {
    label en official "the proprietor of the receiving distilled spirits plant files a claim for abatement/credit/refund of the tax on the returned spirits (section 5008(c)(2))";
}
pub relation return_tax_relieved(r: SpiritsRemoval) kind institutional {
    label en official "the tax on the returned spirits is abated, or credited/refunded without interest (section 5008(c)(1))";
}
@source(IRC_S5008_C, coverage = exact, quote = "No allowance under paragraph (1) may be made unless claim therefor is filed within 6 months of the date of the return of the spirits.")
rule Section5008cReturnedSpiritsClaimPowerRule(r: SpiritsRemoval, p: Person, on: Date, filed_on: Date) defeasible {
    label en official "section 5008(c): the proprietor's claim for relief on returned spirits is valid only if filed within 6 months of the return date";
    when returned_to_bonded_premises(r, on);
    when return_claim_filed(r, p, filed_on);
    then power Section5008ReturnedSpiritsClaim {
        holder p;
        over r;
        exercise return_claim_filed(r, p, filed_on);
        valid_when return_claim_timely(r, on, filed_on);
        effect create(return_tax_relieved(r));
        window [-infinity, infinity];
    };
}
pub relation return_claim_timely(r: SpiritsRemoval, returned_on: Date, filed_on: Date) kind institutional {
    label en official "the claim was filed within 6 months of the date the spirits were returned to bonded premises (section 5008(c)(2))";
}
@source(IRC_S5008_C, relation = formalizes, coverage = exact, quote = "within 6 months of the date of the return of the spirits")
rule Section5008cReturnClaimTimelyRule(r: SpiritsRemoval, p: Person, returned_on: Date, filed_on: Date) strict {
    label en official "the 6-month claim window runs from the return date";
    when returned_to_bonded_premises(r, returned_on);
    when return_claim_filed(r, p, filed_on);
    when filed_on <= add_calendar_period(returned_on, 6 calendar_month);
    then return_claim_timely(r, returned_on, filed_on);
}

// --- Section 5010: credit for wine content and for flavors content ----------

pub entity BlendedSpirit {
    label en unofficial "a distilled-spirits product with wine content and/or flavors content added, for purposes of the section 5010 credit";
}
pub relation blended_spirit_of(b: BlendedSpirit, r: SpiritsRemoval) kind empirical {
    label en official "the removal event on which this blended product's tax is determined under section 5006 (section 5010(b)(1)(A))";
}
pub relation wine_content_proof_gallons(b: BlendedSpirit, gallons: Decimal) kind empirical {
    label en official "the proof gallons of wine content (alcohol derived from wine, section 5010(c)(1)(A)) in this blended distilled spirit";
}
pub relation flavors_content_proof_gallons(b: BlendedSpirit, gallons: Decimal) kind empirical {
    label en official "the proof gallons of flavors content (section 5010(c)(2)(A)) in this blended distilled spirit";
}
pub relation wine_content_source_rate(b: BlendedSpirit, rate: Money) kind empirical {
    label en official "the section 5041(b) rate that would apply to the wine content but for its removal to bonded premises (section 5010(a)(1)(B)) — case-asserted per the wine's own class, since this package's wine-rate rules (module 04) key on a wine removal, not a blended-spirit's wine INPUT";
}
pub relation wine_content_credit(b: BlendedSpirit, amount: Money) kind institutional {
    label en official "the section 5010(a)(1) credit for the wine content of this blended distilled spirit";
}
pub relation flavors_content_credit(b: BlendedSpirit, amount: Money) kind institutional {
    label en official "the section 5010(a)(2) credit for the flavors content of this blended distilled spirit (flat $13.50 per proof gallon)";
}
@source(IRC_S5010_A, coverage = exact, quote = "On each proof gallon of the wine content of distilled spirits, there shall be allowed a credit against the tax imposed by section 5001 (or 7652) equal to the excess of—")
rule Section5010aWineContentCreditRule(b: BlendedSpirit, gallons: Decimal, wine_rate: Money) strict {
    label en official "section 5010(a)(1): credit per proof gallon of wine content equal to the excess of $13.50 over the section 5041(b) rate the wine would otherwise bear";
    when wine_content_proof_gallons(b, gallons);
    when wine_content_source_rate(b, wine_rate);
    then wine_content_credit(b, gallons * (DistilledSpiritsStandardRate - wine_rate));
}
@source(IRC_S5010_A, coverage = exact, quote = "On each proof gallon of the flavors content of distilled spirits, there shall be allowed a credit against the tax imposed by section 5001 (or 7652) equal to $13.50.")
rule Section5010aFlavorsContentCreditRule(b: BlendedSpirit, gallons: Decimal) strict {
    label en official "section 5010(a)(2): flat $13.50-per-proof-gallon credit for flavors content";
    when flavors_content_proof_gallons(b, gallons);
    then flavors_content_credit(b, gallons * FlavorsContentCreditRate);
}
