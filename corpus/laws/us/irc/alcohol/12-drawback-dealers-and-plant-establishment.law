// Stage 2. Subchapter A part III (sections 5111-5114 drawback on distilled
// spirits used in non-beverage products), part IV (5121-5124 dealer
// records), part V (5131-5132 packaging and purchases), and subchapter B
// part I (5175-5177 bonds for exportation, 5178 premises, 5179 still
// registration, 5180 sign, 5181 fuel plants).
// The Secretary's own regulatory delegations ("under such regulations as the
// Secretary may prescribe") are not executable and are classified in the
// coverage rows; only the self-contained conditions are rules here.

use self::{
    DistilledSpiritsPlant,
    IRC_S5111,
    IRC_S5112,
    IRC_S5114_A,
    IRC_S5114_B,
    IRC_S5114_C,
    IRC_S5121_A,
    IRC_S5121_B,
    IRC_S5122_A,
    IRC_S5123_A,
    IRC_S5123_B,
    IRC_S5124,
    IRC_S5131_A,
    IRC_S5132_A,
    IRC_S5175_A,
    IRC_S5175_C,
    IRC_S5176_A,
    IRC_S5176_B,
    IRC_S5178_A,
    IRC_S5178_B,
    IRC_S5179_A,
    IRC_S5180_A,
    IRC_S5181_C,
    IRC_S5181_D,
    IRC_S5181_E,
    Organ,
    Person,
    fuel_plant_application_not_first_in_quarter,
    fuel_plant_application_superseded_by_correction,
    is_dealer,
    is_limited_retail_dealer,
    is_retail_dealer_in_beer,
    is_retail_dealer_in_liquors,
    is_wholesale_dealer_in_beer,
    is_wholesale_dealer_in_liquors,
};

pub const NonBeverageDrawbackRateReduction: Money = 1.00 USD {
    label en official "a drawback at a rate of $1 less than the rate at which the distilled spirits tax has been paid or determined, per proof gallon (section 5114(a))";
};
pub const DrawbackComplianceFailurePenalty: Money = 1000.00 USD {
    label en official "a penalty of $1,000 for each failure to comply (section 5114(c)(2)(A))";
};
pub const FuelAlcoholPlantAnnualProofGallonCeiling: Decimal = 10000.0 {
    label en official "production from an eligible distilled spirits plant does not exceed 10,000 proof gallons per year (section 5181(c)(4))";
};
pub const FuelPlantReceiptNoticeDays: Integer = 15 {
    label en official "within 15 days of receipt of an application the Secretary shall send a written notice of receipt (section 5181(c)(1)(B))";
};
pub const FuelPlantDeterminationDays: Integer = 45 {
    label en official "the Secretary shall determine and notify within 45 days of the date on which notice was sent (section 5181(c)(2)(A))";
};

// =============================================================================
// Sections 5111-5114: drawback on spirits used in non-beverage products
// =============================================================================

pub entity NonBeverageDrawbackClaim {
    label en unofficial "a claim for drawback under subpart of sections 5111-5114 on distilled spirits used in the manufacture of unfit-for-beverage products";
}
pub relation drawback_claimant(c: NonBeverageDrawbackClaim, p: Person) kind empirical {
    label en official "the person claiming drawback (section 5111)";
}
pub relation spirits_used_in_non_beverage_products(c: NonBeverageDrawbackClaim) kind empirical {
    label en official "the person uses distilled spirits on which the tax has been determined in the manufacture or production of medicines, medicinal preparations, food products, flavors, flavoring extracts, or perfume that are unfit for beverage purposes (section 5111)";
}
pub relation spirits_tax_determined_for_claim(c: NonBeverageDrawbackClaim) kind empirical {
    label en official "the tax has been determined (or paid) on the distilled spirits used (sections 5111, 5114(a))";
}
pub relation claimant_eligible_for_drawback(c: NonBeverageDrawbackClaim, p: Person) kind institutional {
    label en official "the person is eligible for drawback at the time the spirits are used in manufacture (section 5111)";
}
@source(IRC_S5111, coverage = exact, quote = "shall be eligible for drawback at the time when such distilled spirits are used in the manufacture of such products as provided for in this subpart.")
rule Section5111EligibilityRule(c: NonBeverageDrawbackClaim, p: Person) strict {
    label en official "section 5111: a person using tax-determined spirits in manufacturing unfit-for-beverage medicines, food products, flavors, extracts, or perfume is eligible for drawback";
    when drawback_claimant(c, p);
    when spirits_used_in_non_beverage_products(c);
    when spirits_tax_determined_for_claim(c);
    then claimant_eligible_for_drawback(c, p);
}
pub relation drawback_registered_annually(p: Person) kind empirical {
    label en official "the person has registered with the Secretary for the current year (section 5112)";
}
pub relation drawback_books_and_records_kept(p: Person) kind empirical {
    label en official "the person keeps such books and records as are necessary to establish that spirits received on which the tax has been determined were used in the manufacture of unfit-for-beverage products (section 5112)";
}
@source(IRC_S5112, coverage = exact, quote = "Every person claiming drawback under this subpart shall register annually with the Secretary; keep such books and records as may be necessary")
rule Section5112RegisterAndRecordsDutyRule(c: NonBeverageDrawbackClaim, p: Person) strict {
    label en official "section 5112: every person claiming drawback registers annually and keeps the books and records necessary to establish use; the annual recurrence is modelled as maintenance (recurring goals are reserved, not parsed) and this is flagged in the coverage note";
    when drawback_claimant(c, p);
    then duty Section5112DrawbackRegistrationAndRecordsDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition drawback_registered_annually(p);
            window [-infinity, infinity];
        }
    };
}
pub relation drawback_proof_gallons_used(c: NonBeverageDrawbackClaim, pg: Decimal) kind empirical {
    label en official "the number of proof gallons of distilled spirits used (section 5114(a))";
}
pub relation spirits_tax_rate_per_proof_gallon_paid(c: NonBeverageDrawbackClaim, rate: Money) kind empirical {
    label en official "the rate per proof gallon at which the distilled spirits tax was paid or determined (section 5114(a)) — the rate may be the section 5001(a)(1) rate or a section 5001(c) reduced rate";
}
pub relation non_beverage_drawback_amount(c: NonBeverageDrawbackClaim, amount: Money) kind institutional {
    label en official "the drawback allowed: proof gallons times a rate of $1 less than the rate at which the tax was paid or determined (section 5114(a))";
}
@source(IRC_S5114_A, coverage = exact, quote = "a drawback shall be allowed on each proof gallon at a rate of $1 less than the rate at which the distilled spirits tax has been paid or determined.")
rule Section5114aDrawbackAmountRule(c: NonBeverageDrawbackClaim, p: Person, pg: Decimal, rate: Money) strict {
    label en official "section 5114(a): drawback = proof gallons x (rate paid or determined - $1); exact Decimal arithmetic, no rounding named by the statute";
    when claimant_eligible_for_drawback(c, p);
    when drawback_proof_gallons_used(c, pg);
    when spirits_tax_rate_per_proof_gallon_paid(c, rate);
    then non_beverage_drawback_amount(c, pg * (rate - NonBeverageDrawbackRateReduction));
}
pub enum DrawbackFilingFrequency { Quarterly; Monthly; }
pub relation drawback_monthly_filing_elected_in_writing(c: NonBeverageDrawbackClaim, p: Person) kind empirical {
    label en official "the person entitled to drawback elects in writing to file monthly claims (section 5114(b))";
}
pub relation drawback_filing_frequency(p: Person, f: DrawbackFilingFrequency) kind institutional {
    label en official "drawback is due and payable quarterly upon filing a proper claim, or monthly if the person has elected monthly claims in writing (section 5114(b))";
}
pub relation drawback_claimant_person_is_entitled(p: Person) kind empirical {
    label en official "the person is entitled to drawback under section 5114";
}
@source(IRC_S5114_B, coverage = exact, quote = "where any person entitled to such drawback shall elect in writing to file monthly claims therefor, such drawback shall be due and payable monthly upon filing of a proper claim with the Secretary")
rule Section5114bMonthlyElectionPowerRule(c: NonBeverageDrawbackClaim, p: Person) strict {
    label en official "section 5114(b): the written election of monthly claims is a power of the person entitled to drawback that changes the filing period from quarterly to monthly; the Secretary's authority to require a bond from monthly filers is EXTERNAL_DEPENDENCY";
    when drawback_monthly_filing_elected_in_writing(c, p);
    then power Section5114MonthlyClaimElection {
        holder p;
        over c;
        exercise drawback_monthly_filing_elected_in_writing(c, p);
        valid_when drawback_claimant_person_is_entitled(p);
        effect create(drawback_filing_frequency(p, Monthly));
        window [-infinity, infinity];
    };
}
pub relation drawback_quarter_end_of_use(c: NonBeverageDrawbackClaim, quarter_end: Date) kind empirical {
    label en official "the last day of the quarter in which the distilled spirits covered by the claim were used (section 5114(b) last sentence)";
}
pub relation drawback_claim_filed_with_secretary_on(c: NonBeverageDrawbackClaim, on: Date) kind empirical {
    label en official "the date the proper claim is filed with the Secretary";
}
pub relation drawback_claim_filed_in_time(c: NonBeverageDrawbackClaim) kind institutional {
    label en official "the claim is filed within the 6 months next succeeding the quarter in which the spirits were used (section 5114(b) last sentence)";
}
@source(IRC_S5114_B, coverage = exact, quote = "No claim under this subpart shall be allowed unless filed with the Secretary within the 6 months next succeeding the quarter in which the distilled spirits covered by the claim were used as provided in this subpart.")
rule Section5114bClaimWindowRule(c: NonBeverageDrawbackClaim, quarter_end: Date, filed: Date) strict {
    label en official "section 5114(b): a drawback claim is allowed only if filed within 6 months after the end of the quarter of use";
    when drawback_quarter_end_of_use(c, quarter_end);
    when drawback_claim_filed_with_secretary_on(c, filed);
    when filed <= add_calendar_period(quarter_end, 6 calendar_month);
    then drawback_claim_filed_in_time(c);
}
pub relation drawback_monthly_election_revoked_on_notice(c: NonBeverageDrawbackClaim, p: Person) kind empirical {
    label en official "the person files notice with the Secretary revoking the monthly-claims election (section 5114(b) third sentence)";
}
pub relation drawback_election_revoked(p: Person) kind institutional {
    label en official "the monthly-claims election is revoked on filing of notice (section 5114(b))";
}
@source(IRC_S5114_B, coverage = exact, quote = "Any such election may be revoked on filing of notice thereof with the Secretary.")
rule Section5114bRevocationRule(c: NonBeverageDrawbackClaim, p: Person) strict {
    label en official "section 5114(b): the monthly election may be revoked by filing notice with the Secretary";
    when drawback_monthly_election_revoked_on_notice(c, p);
    then drawback_election_revoked(p);
}
external judgment relation secretary_satisfied_spirits_used_in_non_beverage_products(c: NonBeverageDrawbackClaim) {
    authority Secretary;
    label en official "the claimant establishes to the satisfaction of the Secretary that spirits on which the tax was paid or determined were in fact used in the manufacture of unfit-for-beverage products (section 5114(c)(1)) — DECISION-0194 external judgment";
}
pub relation drawback_compliance_failure_count(c: NonBeverageDrawbackClaim, failures: Integer) kind empirical {
    label en official "the number of failures to comply with a requirement of the drawback subpart or its rules or regulations in respect of the claim (section 5114(c)(2)(A))";
}
pub relation failure_due_to_reasonable_cause(c: NonBeverageDrawbackClaim) kind empirical {
    label en official "it is shown that the failure to comply was due to reasonable cause (section 5114(c)(2)(A)) — DECISION-0194: asserted with origin adjudicated where disputed";
}
pub relation drawback_claim_amount(c: NonBeverageDrawbackClaim, amount: Money) kind empirical {
    label en official "the amount of the claim, determined without regard to the penalty (section 5114(c)(2)(B))";
}
pub relation drawback_claim_not_denied_for_noncompliance(c: NonBeverageDrawbackClaim) kind institutional {
    label en official "no claim for drawback shall be denied for a failure to comply upon the claimant establishing to the satisfaction of the Secretary that the spirits were in fact used in the manufacture of unfit-for-beverage products (section 5114(c)(1))";
}
@source(IRC_S5114_C, relation = formalizes, coverage = exact, quote = "No claim for drawback under this section shall be denied in the case of a failure to comply with any requirement imposed under this subpart or any rule or regulation issued thereunder upon the claimant's establishing to the satisfaction of the Secretary")
rule Section5114c1NoDenialRule(c: NonBeverageDrawbackClaim) strict {
    label en official "section 5114(c)(1): a compliance failure does not defeat the claim once the Secretary is satisfied as to actual non-beverage use";
    when secretary_satisfied_spirits_used_in_non_beverage_products(c);
    then drawback_claim_not_denied_for_noncompliance(c);
}
pub relation drawback_noncompliance_penalty(c: NonBeverageDrawbackClaim, amount: Money) kind institutional {
    label en official "the penalty for failures to comply: $1,000 for each failure, unless due to reasonable cause, in aggregate not more than the amount of the claim (section 5114(c)(2))";
}
@source(IRC_S5114_C, relation = formalizes, coverage = exact, quote = "the claimant shall be liable for a penalty of $1,000 for each failure to comply unless it is shown that the failure to comply was due to reasonable cause.")
rule Section5114c2PenaltyRule(c: NonBeverageDrawbackClaim, failures: Integer, claim_amt: Money) defeasible {
    label en official "section 5114(c)(2)(A)-(B): $1,000 per failure, capped at the claim amount (for failures described in (c)(1)), unless reasonable cause is shown";
    when drawback_claim_not_denied_for_noncompliance(c);
    when drawback_compliance_failure_count(c, failures);
    when drawback_claim_amount(c, claim_amt);
    unless failure_due_to_reasonable_cause(c) and drawback_compliance_failure_count(c, failures) and drawback_claim_amount(c, claim_amt);
    then drawback_noncompliance_penalty(c, min(failures * DrawbackComplianceFailurePenalty, claim_amt));
}

// =============================================================================
// Sections 5121-5124: dealer records, inspection, registration
// =============================================================================

pub relation keeps_daily_spirits_record_and_summaries(p: Person) kind empirical {
    label en official "the wholesale dealer in liquors keeps daily a record of distilled spirits received and disposed of and submits the correct summaries the Secretary prescribes (section 5121(a)(1))";
}
pub relation keeps_wine_and_beer_receipt_record_or_invoices(p: Person) kind empirical {
    label en official "the dealer keeps a record in book form of all wines and beer received (quantities, from whom, dates) or keeps all invoices and bills for them (section 5121(a)(2))";
}
pub relation is_state_subdivision_district_or_liquor_store_of_them(p: Person) kind empirical {
    label en official "the person is a State, a political subdivision, the District of Columbia, or a liquor store operated by any of them (section 5121(b))";
}
pub relation maintains_records_enabling_trace_and_available_for_inspection(p: Person) kind empirical {
    label en official "the person maintains and makes available for inspection by internal revenue officers records enabling them to trace all spirits, wines, and beer received and all spirits disposed of (section 5121(b))";
}
pub relation dealer_record_exempt_under_5121b(p: Person) kind institutional {
    label en official "the section 5121(a) requirements do not apply to this person (section 5121(b))";
}
@source(IRC_S5121_B, coverage = exact, quote = "The provision of subsection (a) shall not apply to a State, to a political subdivision of a State, to the District of Columbia, or to liquor stores operated by any of them, if they maintain and make available for inspection by internal revenue officers such records as will enable such officers to trace all distilled spirits, wines, and beer received, and all distilled spirits disposed of by them.")
rule Section5121bExemptionRule(p: Person) strict {
    label en official "section 5121(b): a State, subdivision, the District of Columbia, or its liquor store is exempt from subsection (a) if it keeps traceable records available for inspection";
    when is_state_subdivision_district_or_liquor_store_of_them(p);
    when maintains_records_enabling_trace_and_available_for_inspection(p);
    then dealer_record_exempt_under_5121b(p);
}
@source(IRC_S5121_A, relation = formalizes, coverage = partial, quote = "Every wholesale dealer in liquors who sells distilled spirits to other dealers shall keep daily a record of distilled spirits received and disposed of by him")
rule Section5121a1WholesaleLiquorRecordsDutyRule(p: Person) defeasible {
    label en official "section 5121(a)(1): a wholesale dealer in liquors who sells spirits to other dealers keeps a daily record of spirits received and disposed of (form, place, and summaries follow the Secretary's regulations — EXTERNAL_DEPENDENCY); exempt under section 5121(b)";
    when is_wholesale_dealer_in_liquors(p);
    unless dealer_record_exempt_under_5121b(p) and is_wholesale_dealer_in_liquors(p);
    then duty Section5121aWholesaleSpiritsRecordDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition keeps_daily_spirits_record_and_summaries(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S5121_A, relation = formalizes, coverage = exact, quote = "Every wholesale dealer in liquors and every wholesale dealer in beer shall provide and keep, at such place as the Secretary shall by regulations prescribe, a record in book form of all wines and beer received")
rule Section5121a2WholesaleWineBeerRecordsLiquorRule(p: Person) defeasible {
    label en official "section 5121(a)(2): a wholesale dealer in liquors keeps a book record (or all invoices) of wines and beer received; exempt under section 5121(b)";
    when is_wholesale_dealer_in_liquors(p);
    unless dealer_record_exempt_under_5121b(p) and is_wholesale_dealer_in_liquors(p);
    then duty Section5121aWholesaleLiquorWineBeerRecordDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition keeps_wine_and_beer_receipt_record_or_invoices(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S5121_A, relation = formalizes, coverage = exact, quote = "Every wholesale dealer in liquors and every wholesale dealer in beer shall provide and keep, at such place as the Secretary shall by regulations prescribe, a record in book form of all wines and beer received")
rule Section5121a2WholesaleBeerDealerRecordsRule(p: Person) defeasible {
    label en official "section 5121(a)(2): a wholesale dealer in beer keeps a book record (or all invoices) of wines and beer received; exempt under section 5121(b)";
    when is_wholesale_dealer_in_beer(p);
    unless dealer_record_exempt_under_5121b(p) and is_wholesale_dealer_in_beer(p);
    then duty Section5121aWholesaleBeerRecordDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition keeps_wine_and_beer_receipt_record_or_invoices(p);
            window [-infinity, infinity];
        }
    };
}
pub relation retail_dealer_keeps_receipt_record_or_invoices_at_place_of_business(p: Person) kind empirical {
    label en official "the retail dealer keeps in the place of business a book record (quantity, from whom, dates) of all spirits, wines, and beer received, or all invoices and bills (section 5122(a))";
}
@source(IRC_S5122_A, coverage = exact, quote = "Every retail dealer in liquors and every retail dealer in beer shall provide and keep in his place of business a record in book form of all distilled spirits, wines, and beer received")
rule Section5122aRetailLiquorRecordsDutyRule(p: Person) strict {
    label en official "section 5122(a): a retail dealer in liquors keeps a receipt record at the place of business";
    when is_retail_dealer_in_liquors(p);
    then duty Section5122aRetailLiquorRecordDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition retail_dealer_keeps_receipt_record_or_invoices_at_place_of_business(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S5122_A, coverage = exact, quote = "Every retail dealer in liquors and every retail dealer in beer shall provide and keep in his place of business a record in book form of all distilled spirits, wines, and beer received")
rule Section5122aRetailBeerRecordsDutyRule(p: Person) strict {
    label en official "section 5122(a): a retail dealer in beer keeps a receipt record at the place of business";
    when is_retail_dealer_in_beer(p);
    then duty Section5122aRetailBeerRecordDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition retail_dealer_keeps_receipt_record_or_invoices_at_place_of_business(p);
            window [-infinity, infinity];
        }
    };
}
pub relation dealer_records_preserved_and_available_for_inspection_in_business_hours(p: Person) kind empirical {
    label en official "records required under part IV are preserved as the Secretary prescribes and kept available for inspection by any internal revenue officer during business hours (section 5123(a))";
}
pub relation dealer_must_keep_records_under_part_iv(p: Person) kind institutional {
    label en official "the dealer is required to keep records under sections 5121 or 5122";
}
rule DealerRecordsRequiredWholesaleLiquorRule(p: Person) defeasible {
    label en unofficial "a wholesale dealer in liquors is required to keep part IV records";
    when is_wholesale_dealer_in_liquors(p);
    then dealer_must_keep_records_under_part_iv(p);
}
rule DealerRecordsRequiredWholesaleBeerRule(p: Person) defeasible {
    label en unofficial "a wholesale dealer in beer is required to keep part IV records";
    when is_wholesale_dealer_in_beer(p);
    then dealer_must_keep_records_under_part_iv(p);
}
rule DealerRecordsRequiredRetailLiquorRule(p: Person) defeasible {
    label en unofficial "a retail dealer in liquors is required to keep part IV records";
    when is_retail_dealer_in_liquors(p);
    then dealer_must_keep_records_under_part_iv(p);
}
rule DealerRecordsRequiredRetailBeerRule(p: Person) defeasible {
    label en unofficial "a retail dealer in beer is required to keep part IV records";
    when is_retail_dealer_in_beer(p);
    then dealer_must_keep_records_under_part_iv(p);
}
@source(IRC_S5123_A, coverage = exact, quote = "shall be preserved by the person required to keep such records or documents, as the Secretary may by regulations prescribe, and shall be kept available for inspection by any internal revenue officer during business hours.")
rule Section5123aPreservationDutyRule(p: Person) defeasible {
    label en official "section 5123(a): records required under part IV are preserved and kept available for inspection during business hours";
    when dealer_must_keep_records_under_part_iv(p);
    then duty Section5123aRecordPreservationDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition dealer_records_preserved_and_available_for_inspection_in_business_hours(p);
            window [-infinity, infinity];
        }
    };
}
pub relation secretary_enters_dealer_premises_in_business_hours(s: Organ, dealer: Person) kind empirical {
    label en official "the Secretary enters, during business hours, the premises (including places of storage) of a dealer to inspect records and the spirits, wines, or beer stored (section 5123(b))";
}
@source(IRC_S5123_B, coverage = exact, quote = "The Secretary may enter during business hours the premises (including places of storage) of any dealer")
rule Section5123bEntryLibertyRule(dealer: Person) defeasible {
    label en official "section 5123(b): the Secretary may enter a dealer's premises during business hours to inspect required records and the stored spirits, wines, or beer";
    when is_dealer(dealer);
    then liberty Section5123bEnterDealerPremises {
        holder us.irc.core::Secretary;
        action secretary_enters_dealer_premises_in_business_hours(us.irc.core::Secretary, dealer);
        window [-infinity, infinity];
    };
}
pub relation dealer_registered_with_secretary(p: Person) kind empirical {
    label en official "the dealer has registered with the Secretary its name or style, place of residence, trade or business, and the place of business (in a firm or company, each member's name and residence) (section 5124)";
}
@source(IRC_S5124, coverage = exact, quote = "Every dealer who is subject to the recordkeeping requirements under section 5121 or 5122 shall register with the Secretary such dealer's name or style, place of residence, trade or business, and the place where such trade or business is to be carried on.")
rule Section5124DealerRegistrationDutyRule(p: Person) defeasible {
    label en official "section 5124: every dealer subject to the section 5121 or 5122 recordkeeping requirements registers its identifying particulars";
    when dealer_must_keep_records_under_part_iv(p);
    unless dealer_record_exempt_under_5121b(p) and dealer_must_keep_records_under_part_iv(p);
    then duty Section5124DealerRegistrationDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition dealer_registered_with_secretary(p);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// Section 5131 packaging for industrial use; 5132 prohibited purchases
// =============================================================================

pub relation dealer_supplies_distilled_spirits_for_industrial_uses(p: Person) kind empirical {
    label en official "the dealer engages in the business of supplying distilled spirits for industrial uses (section 5131(a))";
}
pub relation secretary_authorizes_dealer_to_package_industrial_spirits(p: Person) kind empirical {
    label en official "the Secretary, at his discretion and under regulations, authorizes the dealer to package taxpaid or tax-determined spirits for industrial uses in containers of more than 1 and not more than 5 wine gallons (section 5131(a))";
}
pub relation dealer_authorized_to_package_industrial_spirits(p: Person) kind institutional {
    label en official "the dealer is authorized to package spirits for industrial use in containers over 1 and up to 5 wine gallons";
}
@source(IRC_S5131_A, coverage = exact, quote = "The Secretary may, at his discretion and under such regulations as he may prescribe, authorize a dealer (as defined in section 5121(c)) engaging in the business of supplying distilled spirits for industrial uses to package distilled spirits, on which the tax has been paid or determined, for such uses in containers of a capacity in excess of 1 wine gallon and not more than 5 wine gallons.")
rule Section5131aPackagingAuthorizationPowerRule(p: Person) strict {
    label en official "section 5131(a): the Secretary's discretionary power to authorize an industrial-spirits dealer to package tax-paid spirits in containers of more than 1 and up to 5 wine gallons is valid only for a dealer supplying spirits for industrial uses";
    when secretary_authorizes_dealer_to_package_industrial_spirits(p);
    then power Section5131PackagingAuthorization {
        holder us.irc.core::Secretary;
        over p;
        exercise secretary_authorizes_dealer_to_package_industrial_spirits(p);
        valid_when dealer_supplies_distilled_spirits_for_industrial_uses(p);
        effect create(dealer_authorized_to_package_industrial_spirits(p));
        window [-infinity, infinity];
    };
}
pub relation dealer_purchases_spirits_for_resale_from(p: Person, seller: Person) kind empirical {
    label en official "the dealer purchases distilled spirits for resale from this seller (section 5132(a))";
}
pub relation seller_is_recordkeeping_wholesale_dealer_in_liquors(seller: Person) kind institutional {
    label en official "the seller is a wholesale dealer in liquors required to keep the records prescribed by section 5121";
}
rule Section5132aQualifiedSellerRule(seller: Person) defeasible {
    label en unofficial "a wholesale dealer in liquors is a qualified seller (records required under section 5121)";
    when is_wholesale_dealer_in_liquors(seller);
    then seller_is_recordkeeping_wholesale_dealer_in_liquors(seller);
}
pub relation purchase_permitted_by_regulations(p: Person, seller: Person) kind empirical {
    label en official "the purchase is permitted as provided in regulations prescribed by the Secretary (section 5132(a) lead-in)";
}
pub relation buyer_is_limited_retail_dealer_buying_from_retail_dealer_in_liquors(p: Person, seller: Person) kind institutional {
    label en official "a limited retail dealer purchases distilled spirits for resale from a retail dealer in liquors (section 5132(b))";
}
rule Section5132bLimitedRetailPurchaseRule(p: Person, seller: Person) defeasible {
    label en official "section 5132(b): a limited retail dealer may lawfully purchase spirits for resale from a retail dealer in liquors";
    when dealer_purchases_spirits_for_resale_from(p, seller);
    when is_limited_retail_dealer(p);
    when is_retail_dealer_in_liquors(seller);
    then buyer_is_limited_retail_dealer_buying_from_retail_dealer_in_liquors(p, seller);
}
@source(IRC_S5132_A, coverage = exact, quote = "it shall be unlawful for a dealer to purchase distilled spirits for resale from any person other than a wholesale dealer in liquors who is required to keep the records prescribed by section 5121.")
rule Section5132aPurchaseProhibitionRule(p: Person, seller: Person) defeasible {
    label en official "section 5132(a): a dealer's purchase of spirits for resale from anyone other than a record-keeping wholesale dealer in liquors is prohibited, except as regulations provide and except a limited retail dealer's purchase from a retail dealer in liquors (section 5132(b))";
    when is_dealer(p);
    when dealer_purchases_spirits_for_resale_from(p, seller);
    unless seller_is_recordkeeping_wholesale_dealer_in_liquors(seller) and dealer_purchases_spirits_for_resale_from(p, seller);
    unless purchase_permitted_by_regulations(p, seller) and dealer_purchases_spirits_for_resale_from(p, seller);
    unless buyer_is_limited_retail_dealer_buying_from_retail_dealer_in_liquors(p, seller) and dealer_purchases_spirits_for_resale_from(p, seller);
    then prohibition Section5132UnlawfulPurchaseForResaleProhibition {
        bearer p;
        action dealer_purchases_spirits_for_resale_from(p, seller);
        window [-infinity, infinity];
    };
}

// =============================================================================
// Sections 5175-5177: bonds for exportation and their maintenance
// =============================================================================

pub entity ExportWithdrawal {
    label en unofficial "a withdrawal of distilled spirits from bonded premises for exportation or transfer to a customs bonded warehouse without payment of tax";
}
pub relation export_withdrawal_by_exporter(x: ExportWithdrawal, exporter: Person) kind empirical {
    label en official "the person withdrawing the spirits for exportation or for transfer to a customs bonded warehouse without payment of tax (section 5175(a))";
}
pub relation export_bond_furnished_by_exporter(x: ExportWithdrawal, exporter: Person) kind empirical {
    label en official "the exporter has furnished bond covering the withdrawal under the Secretary's regulations (section 5175(a))";
}
pub relation withdrawn_by_proprietor_for_export(x: ExportWithdrawal, proprietor: Person) kind empirical {
    label en official "the spirits are withdrawn from bonded premises by the proprietor for exportation without payment of tax (section 5175(b))";
}
pub relation proprietor_bond_under_5173a1_covers_export(x: ExportWithdrawal, proprietor: Person) kind empirical {
    label en official "the proprietor's section 5173(a)(1) bond covering the premises covers this exportation (section 5175(b))";
}
pub relation export_bond_requirement_satisfied(x: ExportWithdrawal, exporter: Person) kind institutional {
    label en unofficial "either the exporter's bond, or the proprietor's own section 5173(a)(1) bond, covers the withdrawal (single-atom helper for the unless clause)";
}
rule Section5175aBondSatisfiedByExporterBondRule(x: ExportWithdrawal, exporter: Person) strict {
    label en unofficial "the export bond requirement is met by the exporter's bond";
    when export_bond_furnished_by_exporter(x, exporter);
    then export_bond_requirement_satisfied(x, exporter);
}
rule Section5175bBondSatisfiedByProprietorBondRule(x: ExportWithdrawal, exporter: Person) strict {
    label en unofficial "section 5175(b): where the proprietor withdraws for export, the proprietor's section 5173(a)(1) bond covers the exportation and subsection (a) does not apply";
    when withdrawn_by_proprietor_for_export(x, exporter);
    when proprietor_bond_under_5173a1_covers_export(x, exporter);
    then export_bond_requirement_satisfied(x, exporter);
}
@source(IRC_S5175_A, coverage = exact, quote = "No distilled spirits shall be withdrawn from bonded premises for exportation, or for transfer to a customs bonded warehouse, without payment of tax unless the exporter has furnished bond to cover such withdrawal")
rule Section5175aExportBondProhibitionRule(x: ExportWithdrawal, exporter: Person) defeasible {
    label en official "section 5175(a)-(b): withdrawing spirits for export without payment of tax and without the covering bond (the exporter's, or the proprietor's own section 5173(a)(1) bond) is prohibited";
    when export_withdrawal_by_exporter(x, exporter);
    unless export_bond_requirement_satisfied(x, exporter) and export_withdrawal_by_exporter(x, exporter);
    then prohibition Section5175NoExportBondProhibition {
        bearer exporter;
        action export_withdrawal_by_exporter(x, exporter);
        window [-infinity, infinity];
    };
}
pub relation proof_of_exportation_given(x: ExportWithdrawal) kind empirical {
    label en official "there is such proof of exportation as the Secretary may by regulations require (section 5175(c))";
}
pub relation export_bond_cancelled_or_credited(x: ExportWithdrawal) kind empirical {
    label en official "the bonds given under section 5175(a) are cancelled or credited, and the section 5175(b) bonds credited";
}
@source(IRC_S5175_C, coverage = exact, quote = "The bonds given under subsection (a) shall be cancelled or credited and the bonds liable under subsection (b) credited if there is such proof of exportation as the Secretary may by regulations require.")
rule Section5175cBondReleaseDutyRule(x: ExportWithdrawal) strict {
    label en official "section 5175(c): the Secretary cancels or credits the export bonds when proof of exportation is given";
    when proof_of_exportation_given(x);
    then duty Section5175cBondReleaseDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition export_bond_cancelled_or_credited(x);
            window [-infinity, infinity];
        }
    };
}
pub entity PlantBond {
    label en unofficial "a bond required under section 5173 or 5175";
}
pub relation bond_of(b: PlantBond, proprietor: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the bond and its principal (proprietor) and plant";
}
pub relation bond_surety_insolvent_or_removed(b: PlantBond) kind empirical {
    label en official "insolvency or removal of any surety on the bond (section 5176(a))";
}
pub relation new_bond_furnished(b: PlantBond) kind empirical {
    label en official "a new bond is furnished in replacement";
}
@source(IRC_S5176_A, coverage = partial, quote = "New bonds shall be required under sections 5173 and 5175 in case of insolvency or removal of any surety")
rule Section5176aNewBondDutyRule(b: PlantBond, proprietor: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5176(a): a new bond is required on insolvency or removal of any surety (other contingencies are at the Secretary's discretion — EXTERNAL_DEPENDENCY)";
    when bond_of(b, proprietor, plant);
    when bond_surety_insolvent_or_removed(b);
    then duty Section5176aNewBondDuty {
        bearer proprietor;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition new_bond_furnished(b);
            window [-infinity, infinity];
        }
    };
}
pub relation proprietor_failed_or_refused_to_furnish_or_renew_5173a1_bond(plant: DistilledSpiritsPlant, proprietor: Person) kind empirical {
    label en official "the proprietor of a distilled spirits plant fails or refuses to furnish a section 5173(a)(1) bond or to renew it (section 5176(b))";
}
pub relation proprietor_neglected_immediately_to_withdraw_spirits_and_pay_tax(plant: DistilledSpiritsPlant, proprietor: Person) kind empirical {
    label en official "the proprietor neglects to immediately withdraw the spirits and pay the tax thereon (section 5176(b))";
}
pub relation secretary_proceeded_to_collect_tax_on_plant_spirits(plant: DistilledSpiritsPlant) kind empirical {
    label en official "the Secretary proceeds to collect the tax";
}
@source(IRC_S5176_B, coverage = exact, quote = "the Secretary shall proceed to collect the tax.")
rule Section5176bSecretaryCollectsDutyRule(plant: DistilledSpiritsPlant, proprietor: Person) strict {
    label en official "section 5176(b): if the proprietor fails or refuses to furnish or renew the section 5173(a)(1) bond and neglects to withdraw the spirits and pay the tax immediately, the Secretary shall proceed to collect the tax";
    when proprietor_failed_or_refused_to_furnish_or_renew_5173a1_bond(plant, proprietor);
    when proprietor_neglected_immediately_to_withdraw_spirits_and_pay_tax(plant, proprietor);
    then duty Section5176bCollectTaxDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_proceeded_to_collect_tax_on_plant_spirits(plant);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// Section 5178: premises; 5179: still registration; 5180: sign
// =============================================================================

pub enum ProhibitedPlantSite {
    DwellingHouse;
    ShedYardOrInclosureConnectedWithDwellingHouse;
    VesselOrBoat;
    PremisesWhereBeerOrWineIsMadeOrProduced;
    PremisesWhereLiquorsOfAnyDescriptionAreRetailed;
    PremisesWhereAnyOtherBusinessIsCarriedOn;
}
pub relation production_plant_located_at_site_kind(plant: DistilledSpiritsPlant, p: Person, site: ProhibitedPlantSite) kind empirical {
    label en official "the distilled spirits plant for the production of distilled spirits is located at a site of a section 5178(a)(1)(B) kind";
}
pub relation other_business_on_plant_premises_authorized_under_5178b(plant: DistilledSpiritsPlant) kind empirical {
    label en official "the other business carried on on the premises is authorized under section 5178(b)";
}
@source(IRC_S5178_A, coverage = exact, quote = "No distilled spirits plant for the production of distilled spirits shall be located in any dwelling house, in any shed, yard, or inclosure connected with any dwelling house, or on board any vessel or boat, or on premises where beer or wine is made or produced, or liquors of any description are retailed, or on premises where any other business is carried on (except when authorized under subsection (b)).")
rule Section5178a1BProhibitedLocationRule(plant: DistilledSpiritsPlant, p: Person, site: ProhibitedPlantSite) defeasible {
    label en official "section 5178(a)(1)(B): a production plant may not be located in a dwelling house or connected shed/yard, on a vessel, on beer/wine/retail-liquor premises, or where another business is carried on, unless the other business is authorized under section 5178(b)";
    when production_plant_located_at_site_kind(plant, p, site);
    unless other_business_on_plant_premises_authorized_under_5178b(plant) and production_plant_located_at_site_kind(plant, p, site) and site == PremisesWhereAnyOtherBusinessIsCarriedOn;
    then prohibition Section5178LocationProhibition {
        bearer p;
        action production_plant_located_at_site_kind(plant, p, site);
        window [-infinity, infinity];
    };
}
pub relation distilling_system_is_continuous_and_prevents_removal_before_production_gauge(plant: DistilledSpiritsPlant) kind empirical {
    label en official "the distilling system is continuous and designed, constructed, and connected so as to prevent the unauthorized removal of distilled spirits before their production gauge (section 5178(a)(2)(B))";
}
pub relation is_proprietor_of_producing_plant(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the person is the proprietor of a plant for the production of distilled spirits";
}
@source(IRC_S5178_A, coverage = exact, quote = "The distilling system shall be continuous and shall be so designed and constructed and so connected as to prevent the unauthorized removal of distilled spirits before their production gauge.")
rule Section5178a2BContinuousSystemDutyRule(plant: DistilledSpiritsPlant, p: Person) strict {
    label en official "section 5178(a)(2)(B): the distilling system of a production plant is to be continuous and secured against unauthorized removal before the production gauge (a maintenance duty of the proprietor; the design standard itself is a fact)";
    when is_proprietor_of_producing_plant(p, plant);
    then duty Section5178a2BContinuousDistillingSystemDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition distilling_system_is_continuous_and_prevents_removal_before_production_gauge(plant);
            window [-infinity, infinity];
        }
    };
}
pub relation person_establishing_production_plant_described_in_application(plant: DistilledSpiritsPlant, p: Person) kind empirical {
    label en official "the person establishes a distilled spirits plant and the operation is as described in the application for registration (section 5178(a)(2)(A), (3)(A), (4))";
}
pub relation produces_spirits_from_any_source_at_plant(plant: DistilledSpiritsPlant, p: Person) kind empirical {
    label en official "the person produces distilled spirits from any source or substance at the plant";
}
@source(IRC_S5178_A, coverage = exact, quote = "Any person establishing a distilled spirits plant may, as described in his application for registration, produce distilled spirits from any source or substance.")
rule Section5178a2ALibertyRule(plant: DistilledSpiritsPlant, p: Person) strict {
    label en official "section 5178(a)(2)(A): a person establishing a plant may, as described in the registration application, produce distilled spirits from any source or substance (liberty)";
    when person_establishing_production_plant_described_in_application(plant, p);
    then liberty Section5178ProduceSpiritsFromAnySource {
        holder p;
        action produces_spirits_from_any_source_at_plant(plant, p);
        window [-infinity, infinity];
    };
}
pub relation warehouses_bulk_spirits_at_plant(plant: DistilledSpiritsPlant, p: Person) kind empirical {
    label en official "the person warehouses bulk distilled spirits on the bonded premises of the production plant (section 5178(a)(3)(A))";
}
@source(IRC_S5178_A, coverage = exact, quote = "may, as described in the application for registration, warehouse bulk distilled spirits on the bonded premises of such plant.")
rule Section5178a3ALibertyRule(plant: DistilledSpiritsPlant, p: Person) strict {
    label en official "section 5178(a)(3)(A): a person establishing a production plant may warehouse bulk spirits on its bonded premises as described in the application (liberty)";
    when person_establishing_production_plant_described_in_application(plant, p);
    then liberty Section5178WarehouseBulkSpirits {
        holder p;
        action warehouses_bulk_spirits_at_plant(plant, p);
        window [-infinity, infinity];
    };
}
pub relation processes_spirits_on_bonded_premises_at_plant(plant: DistilledSpiritsPlant, p: Person) kind empirical {
    label en official "the person processes distilled spirits on the bonded premises of the plant (section 5178(a)(4))";
}
@source(IRC_S5178_A, coverage = exact, quote = "Any person establishing a distilled spirits plant may, as described in the application for registration, process distilled spirits on the bonded premises of such plant.")
rule Section5178a4LibertyRule(plant: DistilledSpiritsPlant, p: Person) strict {
    label en official "section 5178(a)(4): a person establishing a plant may process distilled spirits on its bonded premises as described in the application (liberty)";
    when person_establishing_production_plant_described_in_application(plant, p);
    then liberty Section5178ProcessSpirits {
        holder p;
        action processes_spirits_on_bonded_premises_at_plant(plant, p);
        window [-infinity, infinity];
    };
}
pub relation carries_on_other_business_on_plant_premises(plant: DistilledSpiritsPlant, p: Person) kind empirical {
    label en official "the person carries on another business (not prohibited by section 5601(a)(6)) on the premises of the plant (section 5178(b))";
}
pub relation other_business_application_approved_by_secretary(plant: DistilledSpiritsPlant, p: Person) kind empirical {
    label en official "an application to carry on the other business has been made to and approved by the Secretary (section 5178(b))";
}
@source(IRC_S5178_B, coverage = exact, quote = "Such other businesses shall not be carried on until an application to carry on such business has been made to and approved by the Secretary.")
rule Section5178bOtherBusinessProhibitionRule(plant: DistilledSpiritsPlant, p: Person) defeasible {
    label en official "section 5178(b): another business on plant premises may not be carried on until the application has been made to and approved by the Secretary";
    when carries_on_other_business_on_plant_premises(plant, p);
    unless other_business_application_approved_by_secretary(plant, p) and carries_on_other_business_on_plant_premises(plant, p);
    then prohibition Section5178bOtherBusinessBeforeApprovalProhibition {
        bearer p;
        action carries_on_other_business_on_plant_premises(plant, p);
        window [-infinity, infinity];
    };
}

pub entity StillApparatus {
    label en unofficial "a still or distilling apparatus set up (section 5179)";
}
pub relation still_in_possession_custody_or_control_of(s: StillApparatus, p: Person) kind empirical {
    label en official "the person has the still or distilling apparatus, set up, in his possession or custody, or under his control (section 5179(a))";
}
pub relation still_is_set_up(s: StillApparatus) kind empirical {
    label en official "the still or distilling apparatus is set up";
}
pub relation still_registered_by_written_statement(s: StillApparatus, p: Person) kind empirical {
    label en official "the person has registered the still by filing a written statement of the place, kind and capacity, owner, residence, and purpose (section 5179(a))";
}
@source(IRC_S5179_A, coverage = partial, quote = "Every person having in his possession or custody, or under his control, any still or distilling apparatus set up, shall register such still or apparatus with the Secretary immediately on its being set up")
rule Section5179aStillRegistrationDutyRule(s: StillApparatus, p: Person) strict {
    label en official "section 5179(a): every person having a set-up still under his possession, custody, or control registers it with the Secretary immediately; the word immediately is not translated to a bounded window (INTERPRETATION) and is modelled as maintenance";
    when still_in_possession_custody_or_control_of(s, p);
    when still_is_set_up(s);
    then duty Section5179aStillRegistrationDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition still_registered_by_written_statement(s, p);
            window [-infinity, infinity];
        }
    };
}
pub relation person_engaged_in_distilled_spirits_operations(p: Person) kind empirical {
    label en official "the person is engaged in distilled spirits operations (section 5180(a))";
}
pub relation sign_placed_and_kept_conspicuously_on_outside_of_place_of_business(p: Person) kind empirical {
    label en official "a sign showing the person's name and the business or businesses in which engaged is placed and kept conspicuously outside the place of business, in the form the Secretary prescribes (section 5180(a))";
}
@source(IRC_S5180_A, coverage = exact, quote = "Every person engaged in distilled spirits operations shall place and keep conspicuously on the outside of his place of business a sign")
rule Section5180aSignDutyRule(p: Person) strict {
    label en official "section 5180(a): a person engaged in distilled spirits operations places and keeps a conspicuous sign outside the place of business";
    when person_engaged_in_distilled_spirits_operations(p);
    then duty Section5180aSignDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition sign_placed_and_kept_conspicuously_on_outside_of_place_of_business(p);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// Section 5181: distilled spirits plants for fuel use
// =============================================================================

pub entity FuelPlantApplication {
    label en unofficial "an application for an operating permit for a distilled spirits plant used exclusively for fuel (section 5181(c))";
}
pub relation fuel_plant_application_for(a: FuelPlantApplication, plant: DistilledSpiritsPlant) kind empirical {
    label en official "the application concerns this plant";
}
pub relation fuel_plant_production_proof_gallons_per_year(plant: DistilledSpiritsPlant, pg: Decimal) kind empirical {
    label en official "the plant's production of distilled spirits, proof gallons per year (section 5181(c)(4))";
}
pub relation plant_produces_exclusively_for_fuel_use(plant: DistilledSpiritsPlant) kind empirical {
    label en official "the plant is used to produce distilled spirits exclusively for fuel use (section 5181(c)(4))";
}
pub relation plant_spirits_derived_from_petroleum_natural_gas_or_coal(plant: DistilledSpiritsPlant) kind empirical {
    label en official "the spirits are produced from petroleum, natural gas, or coal (section 5181(f))";
}
pub relation is_eligible_fuel_distilled_spirits_plant(plant: DistilledSpiritsPlant) kind institutional {
    label en official "eligible distilled spirits plant: a plant used to produce distilled spirits exclusively for fuel use whose production does not exceed 10,000 proof gallons per year (section 5181(c)(4))";
}
@source(IRC_S5181_C, coverage = exact, quote = "means a plant which is used to produce distilled spirits exclusively for fuel use and the production from which does not exceed 10,000 proof gallons per year.")
rule Section5181c4EligiblePlantRule(plant: DistilledSpiritsPlant, pg: Decimal) defeasible {
    label en official "section 5181(c)(4): a fuel-only plant producing at most 10,000 proof gallons a year is an eligible plant; spirits from petroleum, natural gas, or coal are not distilled spirits for section 5181 (subsection (f))";
    when plant_produces_exclusively_for_fuel_use(plant);
    when fuel_plant_production_proof_gallons_per_year(plant, pg);
    when pg <= FuelAlcoholPlantAnnualProofGallonCeiling;
    unless plant_spirits_derived_from_petroleum_natural_gas_or_coal(plant) and plant_produces_exclusively_for_fuel_use(plant) and fuel_plant_production_proof_gallons_per_year(plant, pg);
    then is_eligible_fuel_distilled_spirits_plant(plant);
}
pub relation fuel_plant_application_received_on(a: FuelPlantApplication, on: Date) kind empirical {
    label en official "the date the Secretary receives the application (section 5181(c)(1)(B))";
}
pub relation fuel_plant_application_meets_requirements_of_c1a(a: FuelPlantApplication) kind empirical {
    label en official "the application meets the requirements of section 5181(c)(1)(A) (form, manner, and information prescribed by regulations)";
}
pub relation fuel_plant_notice_of_receipt_sent_on(a: FuelPlantApplication, on: Date) kind empirical {
    label en official "the date the Secretary sent written notice of receipt with a statement whether the application meets the requirements (section 5181(c)(1)(B))";
}
pub relation fuel_plant_notice_of_receipt_sent(a: FuelPlantApplication) kind empirical {
    label en official "the Secretary has sent the written notice of receipt";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "Within 15 days of receipt of an application under subparagraph (A), the Secretary shall send a written notice of receipt to the applicant")
rule Section5181c1BNoticeOfReceiptDutyRule(a: FuelPlantApplication, received: Date) strict {
    label en official "section 5181(c)(1)(B): within 15 days of receipt of an application the Secretary sends written notice of receipt with a statement whether it meets the requirements";
    when fuel_plant_application_received_on(a, received);
    when not_known(fuel_plant_application_not_first_in_quarter(a));
    when not_known(fuel_plant_application_superseded_by_correction(a));
    then duty Section5181c1BNoticeOfReceiptDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition fuel_plant_notice_of_receipt_sent(a);
            window [received, add_calendar_period(received, 15 calendar_day)];
        }
    };
}
pub relation fuel_plant_determination_notified_on(a: FuelPlantApplication, on: Date) kind empirical {
    label en official "the date the Secretary notified the applicant whether the operating permit is to be issued (section 5181(c)(2)(A))";
}
pub relation fuel_plant_determination_notified(a: FuelPlantApplication) kind empirical {
    label en official "the Secretary has notified the applicant of the determination";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "the Secretary shall make a determination as to whether such operating permit is to be issued, and shall notify the applicant of such determination, within 45 days of the date on which notice was sent under paragraph (1)(B).")
rule Section5181c2ADeterminationDutyRule(a: FuelPlantApplication, sent: Date) strict {
    label en official "section 5181(c)(2)(A): within 45 days of the notice of receipt the Secretary determines and notifies the applicant whether the permit is issued";
    when fuel_plant_notice_of_receipt_sent_on(a, sent);
    when fuel_plant_application_meets_requirements_of_c1a(a);
    when not_known(fuel_plant_application_not_first_in_quarter(a));
    then duty Section5181c2ADeterminationDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition fuel_plant_determination_notified(a);
            window [sent, add_calendar_period(sent, 45 calendar_day)];
        }
    };
}
pub relation fuel_plant_determination_notified_in_time(a: FuelPlantApplication) kind institutional {
    label en unofficial "the Secretary notified the applicant within 45 days of the date the notice of receipt was sent (helper for the deemed-approval rule)";
}
rule Section5181c2ADeterminationInTimeRule(a: FuelPlantApplication, sent: Date, notified: Date) strict {
    label en unofficial "the determination notice is within the 45-day period";
    when fuel_plant_notice_of_receipt_sent_on(a, sent);
    when fuel_plant_determination_notified_on(a, notified);
    when notified <= add_calendar_period(sent, 45 calendar_day);
    then fuel_plant_determination_notified_in_time(a);
}
pub relation fuel_plant_application_treated_as_approved(a: FuelPlantApplication) kind institutional {
    label en official "the application is treated as approved (section 5181(c)(2)(B))";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "If the Secretary has not notified an applicant within the time prescribed under subparagraph (A), the application shall be treated as approved.")
rule Section5181c2BDeemedApprovalRule(a: FuelPlantApplication, sent: Date) defeasible {
    label en official "section 5181(c)(2)(B): an application on which the Secretary did not notify within the 45 days is treated as approved";
    when fuel_plant_notice_of_receipt_sent_on(a, sent);
    when fuel_plant_application_meets_requirements_of_c1a(a);
    when not_known(fuel_plant_application_not_first_in_quarter(a));
    unless fuel_plant_determination_notified_in_time(a) and fuel_plant_notice_of_receipt_sent_on(a, sent);
    then fuel_plant_application_treated_as_approved(a);
}
pub relation fuel_plant_permit_denied_on_reasons(a: FuelPlantApplication) kind empirical {
    label en official "the Secretary determines that a permit should not be issued (section 5181(c)(2)(C))";
}
pub relation fuel_plant_denial_notice_states_detailed_reasons(a: FuelPlantApplication) kind empirical {
    label en official "the notice of the determination includes detailed reasons for the determination (section 5181(c)(2)(C)(i))";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "the Secretary shall include in the notice to the applicant of such determination under subparagraph (A) detailed reasons for such determination")
rule Section5181c2CReasonsDutyRule(a: FuelPlantApplication) strict {
    label en official "section 5181(c)(2)(C)(i): a denial notice states detailed reasons";
    when fuel_plant_permit_denied_on_reasons(a);
    then duty Section5181c2CReasonsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition fuel_plant_denial_notice_states_detailed_reasons(a);
            window [-infinity, infinity];
        }
    };
}
pub relation fuel_plant_bond_not_required(plant: DistilledSpiritsPlant) kind institutional {
    label en official "no bond is required for an eligible distilled spirits plant; its premises are treated as bonded premises for section 5212 and section 5181(e)(2) (section 5181(c)(3))";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "No bond shall be required for an eligible distilled spirits plant.")
rule Section5181c3NoBondRule(plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5181(c)(3): an eligible plant needs no bond";
    when is_eligible_fuel_distilled_spirits_plant(plant);
    then fuel_plant_bond_not_required(plant);
}
pub relation fuel_spirits_withdrawn_free_of_tax_permitted(plant: DistilledSpiritsPlant) kind institutional {
    label en official "distilled spirits produced under section 5181 may be withdrawn free of tax exclusively for fuel use as provided in section 5214(a)(12) (section 5181(d))";
}
@source(IRC_S5181_D, coverage = exact, quote = "may be withdrawn free of tax from the bonded premises (and any premises which are not bonded by reason of subsection (c)(3)) of a distilled spirits plant exclusively for fuel use as provided in section 5214(a)(12).")
rule Section5181dFreeWithdrawalRule(plant: DistilledSpiritsPlant) defeasible {
    label en official "section 5181(d): fuel-plant spirits may be withdrawn free of tax exclusively for fuel use";
    when is_eligible_fuel_distilled_spirits_plant(plant);
    then fuel_spirits_withdrawn_free_of_tax_permitted(plant);
}
pub relation section_5181_spirits_used_sold_or_disposed_for_other_than_fuel(plant: DistilledSpiritsPlant, p: Person) kind empirical {
    label en official "the person withdraws, uses, sells, or disposes of distilled spirits produced under section 5181 for other than fuel use (section 5181(e)(1))";
}
@source(IRC_S5181_E, coverage = exact, quote = "Distilled spirits produced under this section shall not be withdrawn, used, sold, or disposed of for other than fuel use.")
rule Section5181e1NonFuelProhibitionRule(plant: DistilledSpiritsPlant, p: Person) strict {
    label en official "section 5181(e)(1): spirits produced under section 5181 shall not be withdrawn, used, sold, or disposed of for other than fuel use (prohibition VIOLATED when the action is established, E-0179)";
    when section_5181_spirits_used_sold_or_disposed_for_other_than_fuel(plant, p);
    then prohibition Section5181NonFuelUseProhibition {
        bearer p;
        action section_5181_spirits_used_sold_or_disposed_for_other_than_fuel(plant, p);
        window [-infinity, infinity];
    };
}
pub relation fuel_spirits_withdrawn_on(plant: DistilledSpiritsPlant, p: Person, on: Date) kind empirical {
    label en official "the date fuel spirits are withdrawn from the bonded premises";
}
pub relation fuel_spirits_rendered_unfit_for_beverage_use(plant: DistilledSpiritsPlant, p: Person) kind empirical {
    label en official "the spirits are rendered unfit for beverage use by the addition of substances that do not impair their quality for fuel use (section 5181(e)(2))";
}
@source(IRC_S5181_E, coverage = partial, quote = "shall, before withdrawal from the bonded premises of a distilled spirits plant, be rendered unfit for beverage use by the addition of substances which will not impair the quality of the spirits for fuel use.")
rule Section5181e2DenaturationDutyRule(plant: DistilledSpiritsPlant, p: Person, withdrawn: Date) strict {
    label en official "section 5181(e)(2): before withdrawal from bonded premises, fuel spirits are rendered unfit for beverage use (the denaturants follow the Secretary's regulations — EXTERNAL_DEPENDENCY)";
    when fuel_spirits_withdrawn_on(plant, p, withdrawn);
    then duty Section5181e2RenderUnfitDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition fuel_spirits_rendered_unfit_for_beverage_use(plant, p);
            window [-infinity, withdrawn];
        }
    };
}
