        assert "f1": unauthorized_product_kind(entity_ref("urn:test:s5067:t3#u"), DistilledSpirits) { origin case_input; }
    }
    evaluate truth(reduced_spirits_rates_disallowed(entity_ref("urn:test:s5067:t3#u")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5067-04-AUTHORIZED-WINE-KEEPS-THE-CREDIT" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": unauthorized_product_kind(entity_ref("urn:test:s5067:t4#u"), Wine) { origin case_input; }
    }
    evaluate truth(wine_credit_disallowed(entity_ref("urn:test:s5067:t4#u")));
    expect truth_status == NEITHER;
}
