test "S5005-03-MINORITY-10-PCT-SHAREHOLDER-NOT-DEEMED-LIABLE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": minority_shareholder_of_corporate_proprietor(entity_ref("urn:test:s5005:t3#p"), entity_ref("urn:test:s5005:t3#corp"), 0.10) { origin case_input; }
    }
    evaluate truth(not_deemed_liable_under_b1(entity_ref("urn:test:s5005:t3#p"), entity_ref("urn:test:s5005:t3#corp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5005-04-OFFICER-SHAREHOLDER-EXCEPTION-TO-EXCEPTION" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": minority_shareholder_of_corporate_proprietor(entity_ref("urn:test:s5005:t4#p"), entity_ref("urn:test:s5005:t4#corp"), 0.05) { origin case_input; }
        assert "f1": officer_or_director_of(entity_ref("urn:test:s5005:t4#p"), entity_ref("urn:test:s5005:t4#corp")) { origin case_input; }
    }
    // an officer/director is NOT within the carve-out even at 5%
    evaluate truth(not_deemed_liable_under_b1(entity_ref("urn:test:s5005:t4#p"), entity_ref("urn:test:s5005:t4#corp")));
    expect truth_status == NEITHER;
}

