// Sections 5005, 5006 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5005-01-DISTILLER-LIABLE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": is_distiller_or_importer(entity_ref("urn:test:s5005:t1#p"), entity_ref("urn:test:s5005:t1#r")) { origin case_input; }
    }
    evaluate truth(liable_for_spirits_tax(entity_ref("urn:test:s5005:t1#p"), entity_ref("urn:test:s5005:t1#r")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

