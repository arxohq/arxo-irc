    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": unaccounted_production_determined(entity_ref("urn:test:s5006:t2#op"), 900, 1000) { origin case_input; }
    }
    // (1000-900) * 13.50 = 1350
    evaluate truth(assessed_for_unaccounted_production(entity_ref("urn:test:s5006:t2#op"), 1350.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

