// Final TECH_GAP pass (26.09.2026): section 5011(c)(1) (G6899). NOT EXECUTED (implemented_unverified).
// The factor is computed by hand with 12-place HALF_UP rounding at every product (see module 21).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5011C1-01-DAILY-FACTOR-FOR-60-DAYS" {
    // rate 0.075: 0.075/365 = 0.000205479452; the 60th power by 12-place binary chain: 1.012403797474.
    given {
        context { legal_time @2025-06-30; decision_time @2025-06-30T09:00:00-05:00; knowledge_time @2025-06-30T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": corporate_overpayment_rate_for_quarter(2024, 1, 0.075) { origin case_input; }
        assert "f1": corporate_overpayment_rate_for_quarter(2024, 2, 0.075) { origin case_input; }
        assert "f2": corporate_overpayment_rate_for_quarter(2024, 3, 0.075) { origin case_input; }
        assert "f3": corporate_overpayment_rate_for_quarter(2024, 4, 0.075) { origin case_input; }
    }
    evaluate truth(financing_factor_60(2024, 1.012403797474));
    expect truth_status == TRUE_ONLY;
}

test "S5011C1-02-AVERAGE-TAX-FINANCING-COST-PER-CASE" {
    // 25.68 x (1.012403797474 - 1) = 0.3185... -> 0.32.
    given {
        context { legal_time @2025-06-30; decision_time @2025-06-30T09:00:00-05:00; knowledge_time @2025-06-30T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": corporate_overpayment_rate_for_quarter(2024, 1, 0.075) { origin case_input; }
        assert "f1": corporate_overpayment_rate_for_quarter(2024, 2, 0.075) { origin case_input; }
        assert "f2": corporate_overpayment_rate_for_quarter(2024, 3, 0.075) { origin case_input; }
        assert "f3": corporate_overpayment_rate_for_quarter(2024, 4, 0.075) { origin case_input; }
        assert "f4": is_alcohol_taxpayer(entity_ref("urn:test:s5011:c#x")) { origin case_input; }
    }
    evaluate truth(average_tax_financing_cost_per_case_computed(2024, 0.32 USD));
    expect truth_status == TRUE_ONLY;
}

test "S5011C1-03-COMPUTED-COST-DISPLACES-THE-ASSERTED-ONE" {
    // both a computed and an asserted cost: the credit reads the computed one.
    given {
        context { legal_time @2025-06-30; decision_time @2025-06-30T09:00:00-05:00; knowledge_time @2025-06-30T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": corporate_overpayment_rate_for_quarter(2024, 1, 0.075) { origin case_input; }
        assert "f1": corporate_overpayment_rate_for_quarter(2024, 2, 0.075) { origin case_input; }
        assert "f2": corporate_overpayment_rate_for_quarter(2024, 3, 0.075) { origin case_input; }
        assert "f3": corporate_overpayment_rate_for_quarter(2024, 4, 0.075) { origin case_input; }
        assert "f4": is_alcohol_taxpayer(entity_ref("urn:test:s5011:d#x")) { origin case_input; }
        assert "f5": average_tax_financing_cost_per_case(2024, 0.40 USD) { origin case_input; }
    }
    evaluate truth(average_tax_financing_cost_for_credit(2024, 0.32 USD));
    expect truth_status == TRUE_ONLY;
}

test "S5011C1-04-ASSERTED-COST-WHEN-NO-RATES" {
    // no corporate overpayment rates: the asserted cost stands.
    given {
        context { legal_time @2025-06-30; decision_time @2025-06-30T09:00:00-05:00; knowledge_time @2025-06-30T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": average_tax_financing_cost_per_case(2024, 0.40 USD) { origin case_input; }
    }
    evaluate truth(average_tax_financing_cost_for_credit(2024, 0.40 USD));
    expect truth_status == TRUE_ONLY;
}
