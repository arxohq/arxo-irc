// Section 5041(a)-(c) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5041-01-STILL-LOW-CLASS-RATE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": wine_removal_class(entity_ref("urn:test:s5041:t1#w"), StillLow) { origin case_input; }
        assert "f1": removed_wine_gallons(entity_ref("urn:test:s5041:t1#w"), 100) { origin case_input; }
    }
    // 100 * 1.07 = 107.00
    evaluate truth(wine_tax(entity_ref("urn:test:s5041:t1#w"), 107.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

