test "S5041-05-CREDIT-TIER1-ONLY" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": wine_removed_by(entity_ref("urn:test:s5041:t5#w"), entity_ref("urn:test:s5041:t5#p")) { origin case_input; }
        assert "f1": is_wine_producer(entity_ref("urn:test:s5041:t5#p")) { origin case_input; }
        assert "f2": removed_wine_gallons(entity_ref("urn:test:s5041:t5#w"), 10000) { origin case_input; }
        assert "f3": prior_ytd_wine_gallons(entity_ref("urn:test:s5041:t5#w"), 0) { origin case_input; }
    }
    // wholly within the first 30,000-gallon tier: 10000 * 1.00 = 10000
    evaluate truth(wine_credit_amount(entity_ref("urn:test:s5041:t5#w"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5041-06-CREDIT-STRADDLES-TIER1-TIER2-BOUNDARY" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": wine_removed_by(entity_ref("urn:test:s5041:t6#w"), entity_ref("urn:test:s5041:t6#p")) { origin case_input; }
        assert "f1": is_wine_producer(entity_ref("urn:test:s5041:t6#p")) { origin case_input; }
        assert "f2": removed_wine_gallons(entity_ref("urn:test:s5041:t6#w"), 10000) { origin case_input; }
        assert "f3": prior_ytd_wine_gallons(entity_ref("urn:test:s5041:t6#w"), 25000) { origin case_input; }
    }
    // prior 25000 + this 10000 = 35000: tier1 takes 5000 (25000->30000) at 1.00 = 5000;
    // tier2 takes 5000 (30000->35000) at 0.90 = 4500; total = 9500.00
    evaluate truth(wine_credit_amount(entity_ref("urn:test:s5041:t6#w"), 9500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5041-07-NOT-A-PRODUCER-NO-CREDIT" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": wine_removed_by(entity_ref("urn:test:s5041:t7#w"), entity_ref("urn:test:s5041:t7#p")) { origin case_input; }
        assert "f1": removed_wine_gallons(entity_ref("urn:test:s5041:t7#w"), 10000) { origin case_input; }
    }
    // p is not asserted a producer -> wine_credit_applies never fires -> NEITHER
    evaluate truth(wine_credit_amount(entity_ref("urn:test:s5041:t7#w"), 0.00 USD));
    expect truth_status == NEITHER;
}
