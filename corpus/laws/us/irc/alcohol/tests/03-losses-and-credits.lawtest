test "S5010-01-WINE-CONTENT-CREDIT" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": wine_content_proof_gallons(entity_ref("urn:test:s5010:t1#b"), 10) { origin case_input; }
        assert "f1": wine_content_source_rate(entity_ref("urn:test:s5010:t1#b"), 1.07 USD) { origin case_input; }
    }
    // 10 * (13.50 - 1.07) = 124.30
    evaluate truth(wine_content_credit(entity_ref("urn:test:s5010:t1#b"), 124.30 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5010-02-FLAVORS-CONTENT-CREDIT-FLAT-RATE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
