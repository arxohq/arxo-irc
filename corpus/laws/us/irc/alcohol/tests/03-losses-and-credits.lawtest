        }
        assert "f0": returned_to_bonded_premises(entity_ref("urn:test:s5008:t4#r"), @2024-01-01) { origin case_input; }
        assert "f1": return_claim_filed(entity_ref("urn:test:s5008:t4#r"), entity_ref("urn:test:s5008:t4#p"), @2024-06-30) { origin case_input; }
    }
    evaluate truth(return_claim_timely(entity_ref("urn:test:s5008:t4#r"), @2024-01-01, @2024-06-30));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

