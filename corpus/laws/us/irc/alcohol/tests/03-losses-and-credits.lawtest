        }
        assert "f0": flavors_content_proof_gallons(entity_ref("urn:test:s5010:t2#b"), 5) { origin case_input; }
    }
    // 5 * 13.50 = 67.50
    evaluate truth(flavors_content_credit(entity_ref("urn:test:s5010:t2#b"), 67.50 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
