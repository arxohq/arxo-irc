// Sections 5008, 5010 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5008-01-THEFT-LOSS-CLAIM-VALID-NO-CONNIVANCE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": spirits_loss(entity_ref("urn:test:s5008:t1#r"), Theft) { origin case_input; }
        assert "f1": theft_without_connivance_collusion_fraud_or_negligence(entity_ref("urn:test:s5008:t1#r")) { origin case_input; }
        assert "f2": loss_claim_filed(entity_ref("urn:test:s5008:t1#r"), entity_ref("urn:test:s5008:t1#p")) { origin case_input; }
    }
    evaluate truth(loss_relieved_from_tax(entity_ref("urn:test:s5008:t1#r")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5008-02-THEFT-LOSS-CLAIM-INVALID-CONNIVANCE-NOT-FOUND" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": spirits_loss(entity_ref("urn:test:s5008:t2#r"), Theft) { origin case_input; }
        assert "f1": loss_claim_filed(entity_ref("urn:test:s5008:t2#r"), entity_ref("urn:test:s5008:t2#p")) { origin case_input; }
    }
    // no `theft_without_connivance...` finding -> not eligible -> POWER_INVALID_EXERCISE
    evaluate truth(loss_relieved_from_tax(entity_ref("urn:test:s5008:t2#r")));
    expect truth_status == NEITHER;
}

test "S5008-03-UNEXPLAINED-BOTTLED-SHORTAGE-NEVER-ELIGIBLE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": spirits_loss(entity_ref("urn:test:s5008:t3#r"), UnexplainedBottledShortage) { origin case_input; }
        assert "f1": loss_claim_filed(entity_ref("urn:test:s5008:t3#r"), entity_ref("urn:test:s5008:t3#p")) { origin case_input; }
    }
    // section 5008(a)(1)(C) has no Secretary-finding escape for this cause
    evaluate truth(loss_relieved_from_tax(entity_ref("urn:test:s5008:t3#r")));
    expect truth_status == NEITHER;
}

