        assert "f0": person_disposes_of_containers_of_the_character_used_for_packaging_spirits(entity_ref("urn:test:s5301:t2#p")) { origin case_input; }
        assert "f1": secretary_requires_container_disposition_return_from(entity_ref("urn:test:s5301:t2#p")) { origin case_input; }
        assert "f2": container_disposition_return_rendered_and_records_kept(entity_ref("urn:test:s5301:t2#p")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5301bContainerReturnDuty, ACTIVE);
