// Sections 5061(a),(d),(e), 5062, 5064 scenarios. NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5061-01-RETURN-DUTY-VIOLATED-WITHOUT-A-TIMELY-RETURN" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_alcohol_taxpayer(entity_ref("urn:test:s5061:t1#p")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5061aReturnDuty, VIOLATED);
}

test "S5061-02-ANNUAL-PERIOD-AT-1000-THRESHOLD" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": expected_annual_alcohol_tax_liability(entity_ref("urn:test:s5061:t2#p"), 2024, 1000.00 USD) { origin case_input; }
        assert "f1": prior_year_alcohol_tax_liability(entity_ref("urn:test:s5061:t2#p"), 2024, 1000.00 USD) { origin case_input; }
    }
    evaluate truth(alcohol_return_period(entity_ref("urn:test:s5061:t2#p"), 2024, Annual));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

