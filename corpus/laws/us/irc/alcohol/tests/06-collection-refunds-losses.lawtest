test "S5062-01-SPIRITS-DRAWBACK-VALID-WHEN-MARKED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_distilled_spirits_export(entity_ref("urn:test:s5062:t1#e")) { origin case_input; }
        assert "f1": spirits_marked_for_export(entity_ref("urn:test:s5062:t1#e")) { origin case_input; }
        assert "f2": drawback_claim_filed(entity_ref("urn:test:s5062:t1#e"), entity_ref("urn:test:s5062:t1#p")) { origin case_input; }
        assert "f3": tax_paid_or_determined_amount(entity_ref("urn:test:s5062:t1#e"), 1000.00 USD) { origin case_input; }
    }
    evaluate truth(drawback_allowed(entity_ref("urn:test:s5062:t1#e"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

