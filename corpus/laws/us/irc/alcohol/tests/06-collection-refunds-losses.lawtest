test "S5064-01-DISASTER-LOSS-CLAIM-VALID-WITHIN-6-MONTHS-ABOVE-250" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": occurred_in_united_states(entity_ref("urn:test:s5064:t1#h")) { origin case_input; }
        assert "f1": held_for_sale_at_time_of_damage(entity_ref("urn:test:s5064:t1#h")) { origin case_input; }
        assert "f2": not_indemnified_by_insurance(entity_ref("urn:test:s5064:t1#h")) { origin case_input; }
        assert "f3": claim_amount(entity_ref("urn:test:s5064:t1#h"), 300.00 USD) { origin case_input; }
        assert "f4": damaged_by(entity_ref("urn:test:s5064:t1#h"), FireFloodCasualtyOrOtherDisaster, @2024-01-01) { origin case_input; }
        assert "f5": disaster_loss_claim_filed(entity_ref("urn:test:s5064:t1#h"), entity_ref("urn:test:s5064:t1#p"), @2024-06-01) { origin case_input; }
    }
    evaluate truth(disaster_loss_payment_allowed(entity_ref("urn:test:s5064:t1#h"), 300.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

