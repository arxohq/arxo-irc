// Section 5001 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF): expectations are computed by hand from the pinned rates
// ($13.50 standard, $2.70/$13.34 reduced tiers, 100,000/22,130,000 proof
// gallon caps) and the statutory text, not from any engine run.

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5001-01-STANDARD-RATE-NOT-A-DS-OPERATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": removal_by(entity_ref("urn:test:s5001:t1#r"), entity_ref("urn:test:s5001:t1#op")) { origin case_input; }
        assert "f1": removed_proof_gallons(entity_ref("urn:test:s5001:t1#r"), 1000) { origin case_input; }
    }
    // op is not asserted as `is_distilled_spirits_operation` -> reduced_rate_applies is false -> standard rate: 1000 * 13.50 = 13500
    evaluate truth(distilled_spirits_tax(entity_ref("urn:test:s5001:t1#r"), 13500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5001-02-REDUCED-RATE-TIER1-ONLY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": removal_by(entity_ref("urn:test:s5001:t2#r"), entity_ref("urn:test:s5001:t2#op")) { origin case_input; }
        assert "f1": is_distilled_spirits_operation(entity_ref("urn:test:s5001:t2#op")) { origin case_input; }
        assert "f2": removed_proof_gallons(entity_ref("urn:test:s5001:t2#r"), 5000) { origin case_input; }
        assert "f3": prior_ytd_proof_gallons(entity_ref("urn:test:s5001:t2#r"), 0) { origin case_input; }
    }
    // wholly within tier 1: 5000 * 2.70 = 13500
    evaluate truth(distilled_spirits_tax(entity_ref("urn:test:s5001:t2#r"), 13500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5001-03-REDUCED-RATE-STRADDLES-TIER1-TIER2-BOUNDARY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": removal_by(entity_ref("urn:test:s5001:t3#r"), entity_ref("urn:test:s5001:t3#op")) { origin case_input; }
        assert "f1": is_distilled_spirits_operation(entity_ref("urn:test:s5001:t3#op")) { origin case_input; }
        assert "f2": removed_proof_gallons(entity_ref("urn:test:s5001:t3#r"), 10000) { origin case_input; }
        assert "f3": prior_ytd_proof_gallons(entity_ref("urn:test:s5001:t3#r"), 95000) { origin case_input; }
    }
    // prior 95000 + this 10000 = 105000: tier1 takes 5000 (95000->100000) at 2.70 = 13500;
    // tier2 takes 5000 (100000->105000) at 13.34 = 66700; total = 80200.00
    evaluate truth(distilled_spirits_tax(entity_ref("urn:test:s5001:t3#r"), 80200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5001-04-REDUCED-RATE-ABOVE-BOTH-TIERS-FALLS-TO-STANDARD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": removal_by(entity_ref("urn:test:s5001:t4#r"), entity_ref("urn:test:s5001:t4#op")) { origin case_input; }
        assert "f1": is_distilled_spirits_operation(entity_ref("urn:test:s5001:t4#op")) { origin case_input; }
        assert "f2": removed_proof_gallons(entity_ref("urn:test:s5001:t4#r"), 1000) { origin case_input; }
        assert "f3": prior_ytd_proof_gallons(entity_ref("urn:test:s5001:t4#r"), 22230000) { origin case_input; }
    }
    // prior already exceeds both tier caps (100000 + 22130000 = 22230000): whole removal at standard rate: 1000 * 13.50 = 13500
    evaluate truth(distilled_spirits_tax(entity_ref("urn:test:s5001:t4#r"), 13500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5001-05-UNKNOWN-QUANTITY-GIVES-NEITHER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": removal_by(entity_ref("urn:test:s5001:t5#r"), entity_ref("urn:test:s5001:t5#op")) { origin case_input; }
    }
    // no removed_proof_gallons fact at all -> the tax cannot be computed
    evaluate truth(distilled_spirits_tax(entity_ref("urn:test:s5001:t5#r"), 0.00 USD));
    expect truth_status == NEITHER;
}

test "S5001-06-ATTACHMENT-AS-SOON-AS-SPIRITS-EXIST" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": spirits_in_existence(entity_ref("urn:test:s5001:t6#r"), @2024-03-01) { origin case_input; }
    }
    evaluate truth(tax_attached(entity_ref("urn:test:s5001:t6#r"), @2024-03-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5001-07-UNLAWFUL-USE-OF-TAX-FREE-SPIRITS-REATTACHES-LIABILITY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": unlawful_use_of_tax_free_spirits(entity_ref("urn:test:s5001:t7#user"), 100, @2024-03-01) { origin case_input; }
    }
    // 100 proof gallons * 13.50 = 1350
    evaluate truth(liable_for_reattached_spirits_tax(entity_ref("urn:test:s5001:t7#user"), 100, @2024-03-01, 1350.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5001-08-CONTROLLED-GROUP-PARENT-SUBSIDIARY-AT-50-PERCENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.corporations::parent_subsidiary_ownership_share(entity_ref("urn:test:s5001:t8#group"), entity_ref("urn:test:s5001:t8#parent"), entity_ref("urn:test:s5001:t8#member"), 0.50, 0.50) { origin case_input; }
    }
    // section 5001(c)(2)(B) substitutes 50% for 80%: exactly at the substituted threshold qualifies
    evaluate truth(alcohol_controlled_group_member(entity_ref("urn:test:s5001:t8#group"), entity_ref("urn:test:s5001:t8#member")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5001-09-CONTROLLED-GROUP-PARENT-SUBSIDIARY-BELOW-50-PERCENT-NOT-A-MEMBER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.corporations::parent_subsidiary_ownership_share(entity_ref("urn:test:s5001:t9#group"), entity_ref("urn:test:s5001:t9#parent"), entity_ref("urn:test:s5001:t9#member"), 0.49, 0.49) { origin case_input; }
    }
    evaluate truth(alcohol_controlled_group_member(entity_ref("urn:test:s5001:t9#group"), entity_ref("urn:test:s5001:t9#member")));
    expect truth_status == NEITHER;
}
