test "S5044C-01-A-PROVISION-FOR-WINE-IN-BOND-APPLIES-TO-RETURNED-WINE" {
    given {
        context {
            legal_time @2026-06-15;
            decision_time @2026-06-15T09:00:00-05:00;
            knowledge_time @2026-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": wine_returned_to_bond_on(entity_ref("urn:us:irc:alcohol:clir#WR1"), @2026-05-01) { origin case_input; }
        assert "f1": provision_applicable_to_wine_in_bond_5044c("5041") { origin case_input; }
    }
    evaluate truth(provision_applies_to_wine_returned_to_bond_5044c(entity_ref("urn:us:irc:alcohol:clir#WR1"), "5041"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

