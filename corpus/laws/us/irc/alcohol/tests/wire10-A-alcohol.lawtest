        assert "f0": alcohol_september_dates(entity_ref("urn:test:w10a:d6d#p"), 2024, @2024-09-16) { origin case_input; }
        assert "f1": must_pay_by_electronic_funds_transfer(entity_ref("urn:test:w10a:d6d#p"), 2024) { origin case_input; }
        assert "f2": september_sunday_forward_candidate(@2024-09-29, @2024-09-30) { origin case_input; }
    }
    evaluate truth(section_5061d6_rolled_due_date(@2024-09-29, @2024-09-30));
    expect truth_status == TRUE_ONLY;
}

test "W10A-D6-05-HOLIDAY-FRIDAY-DUE-ROLLS-TO-THURSDAY" {
    given {
        context {
            legal_time @2025-07-10;
            decision_time @2025-07-10T09:00:00-05:00;
            knowledge_time @2025-07-10T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": unpaid_tax_due_after_quarterly_limit_exceeded(entity_ref("urn:test:w10a:d6e#p"), entity_ref("urn:test:w10a:d6e#i"), @2025-07-04) { origin case_input; }
        assert "f1": alcohol_legal_holiday_7503(@2025-07-04) { origin case_input; }
        assert "f2": preceding_business_day_candidate(@2025-07-04, @2025-07-03) { origin case_input; }
        assert "f3": alcohol_day_in_question(@2025-07-03) { origin case_input; }
    }
    evaluate truth(section_5061d6_rolled_due_date(@2025-07-04, @2025-07-03));
    expect truth_status == TRUE_ONLY;
}

test "W10A-D6-06-SATURDAY-DUE-WITHOUT-A-CANDIDATE-IS-NEITHER" {
    given {
        context {
            legal_time @2025-02-01;
            decision_time @2025-02-01T09:00:00-05:00;
            knowledge_time @2025-02-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": unpaid_tax_due_after_quarterly_limit_exceeded(entity_ref("urn:test:w10a:d6f#p"), entity_ref("urn:test:w10a:d6f#i"), @2025-01-18) { origin case_input; }
    }
    evaluate truth(section_5061d6_rolled_due_date(@2025-01-18, @2025-01-17));
    expect truth_status == NEITHER;
}
