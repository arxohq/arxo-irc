test "S5053-04-HOMEBREW-SINGLE-ADULT-ABOVE-100-GALLONS-NOT-EXEMPT" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": homebrew_produced_by_household(entity_ref("urn:test:s5053:t4#h"), 150, 2024) { origin case_input; }
        assert "f1": adult_count_in_household(entity_ref("urn:test:s5053:t4#h"), 1) { origin case_input; }
    }
    // 150 exceeds the single-adult 100-gallon limit, and is not tested against the 2-adult rule (count == 1)
    evaluate truth(homebrew_exempt_from_tax(entity_ref("urn:test:s5053:t4#h"), 2024));
    expect truth_status == NEITHER;
}
