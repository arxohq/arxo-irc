test "S5053-03-HOMEBREW-SINGLE-ADULT-100-GALLON-LIMIT" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": homebrew_produced_by_household(entity_ref("urn:test:s5053:t3#h"), 100, 2024) { origin case_input; }
        assert "f1": adult_count_in_household(entity_ref("urn:test:s5053:t3#h"), 1) { origin case_input; }
    }
    evaluate truth(homebrew_exempt_from_tax(entity_ref("urn:test:s5053:t3#h"), 2024));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
