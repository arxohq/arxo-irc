// Sections 5051(a), 5053(e) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5051-01-GENERAL-TIER1-ONLY" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": removed_barrels(entity_ref("urn:test:s5051:t1#r"), 100) { origin case_input; }
        assert "f1": prior_ytd_barrels(entity_ref("urn:test:s5051:t1#r"), 0) { origin case_input; }
    }
    // no small_brewer_rate_applies (brewer not asserted qualifying) -> general schedule; wholly tier 1: 100 * 16 = 1600
    evaluate truth(beer_tax(entity_ref("urn:test:s5051:t1#r"), 1600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5051-02-GENERAL-STRADDLES-TIER-BOUNDARY-AT-6-MILLION" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": removed_barrels(entity_ref("urn:test:s5051:t2#r"), 1000) { origin case_input; }
        assert "f1": prior_ytd_barrels(entity_ref("urn:test:s5051:t2#r"), 5999500) { origin case_input; }
    }
    // prior 5999500 + this 1000 = 6000500: 500 barrels at 16 = 8000; 500 at 18 = 9000; total = 17000.00
    evaluate truth(beer_tax(entity_ref("urn:test:s5051:t2#r"), 17000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5051-03-SMALL-BREWER-OWN-TIER" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": brewer_annual_production_barrels(entity_ref("urn:test:s5051:t3#brewer"), 2024, 500000) { origin case_input; }
        assert "f1": beer_removed_by(entity_ref("urn:test:s5051:t3#r"), entity_ref("urn:test:s5051:t3#brewer")) { origin case_input; }
        assert "f2": beer_removal_in_calendar_year(entity_ref("urn:test:s5051:t3#r"), 2024) { origin case_input; }
        assert "f3": removed_barrels(entity_ref("urn:test:s5051:t3#r"), 1000) { origin case_input; }
        assert "f4": prior_ytd_barrels(entity_ref("urn:test:s5051:t3#r"), 0) { origin case_input; }
    }
    // qualifying small brewer (500000 <= 2000000): 1000 * 3.50 = 3500
    evaluate truth(beer_tax(entity_ref("urn:test:s5051:t3#r"), 3500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5051-04-PRODUCER-OVER-2-MILLION-NOT-A-SMALL-BREWER" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": brewer_annual_production_barrels(entity_ref("urn:test:s5051:t4#brewer"), 2024, 2000001) { origin case_input; }
    }
    evaluate truth(small_brewer_eligible(entity_ref("urn:test:s5051:t4#brewer"), 2024));
    expect truth_status == NEITHER;
}

test "S5051-05-SMALL-BREWER-REMAINDER-FALLS-BACK-TO-GENERAL-SCHEDULE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": brewer_annual_production_barrels(entity_ref("urn:test:s5051:t5#brewer"), 2024, 500000) { origin case_input; }
        assert "f1": beer_removed_by(entity_ref("urn:test:s5051:t5#r"), entity_ref("urn:test:s5051:t5#brewer")) { origin case_input; }
        assert "f2": beer_removal_in_calendar_year(entity_ref("urn:test:s5051:t5#r"), 2024) { origin case_input; }
        assert "f3": removed_barrels(entity_ref("urn:test:s5051:t5#r"), 1000) { origin case_input; }
        assert "f4": prior_ytd_barrels(entity_ref("urn:test:s5051:t5#r"), 59500) { origin case_input; }
    }
    // prior 59500 + this 1000 = 60500: 500 at own 3.50 tier = 1750; 500 remainder at the general 16 rate = 8000; total = 9750.00
    evaluate truth(beer_tax(entity_ref("urn:test:s5051:t5#r"), 9750.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5053-01-HOMEBREW-MULTI-ADULT-AT-200-GALLON-LIMIT" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": homebrew_produced_by_household(entity_ref("urn:test:s5053:t1#h"), 200, 2024) { origin case_input; }
        assert "f1": adult_count_in_household(entity_ref("urn:test:s5053:t1#h"), 2) { origin case_input; }
    }
    evaluate truth(homebrew_exempt_from_tax(entity_ref("urn:test:s5053:t1#h"), 2024));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

