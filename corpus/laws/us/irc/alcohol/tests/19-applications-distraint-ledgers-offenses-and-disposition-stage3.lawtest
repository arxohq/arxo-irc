// Stage 3: fuel plant applications, distraint, wine spirits ledger, fruit wine amelioration, waiver, offense elements, forfeited alcohol, vinegar plants and burden of proof (module 19) scenarios. NOT EXECUTED (implemented_unverified): written from the pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5181C1C-01-SECOND-APPLICATION-IN-QUARTER-NOT-COVERED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fuel_plant_application_for(entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#a1"), entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#plant")) { origin case_input; }
        assert "f1": fuel_plant_application_received_on(entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#a1"), @2024-01-10) { origin case_input; }
        assert "f2": fuel_plant_application_quarter_starts(entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#a1"), @2024-01-01) { origin case_input; }
        assert "f3": fuel_plant_application_for(entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#a2"), entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#plant")) { origin case_input; }
        assert "f4": fuel_plant_application_received_on(entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#a2"), @2024-02-05) { origin case_input; }
        assert "f5": fuel_plant_application_quarter_starts(entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#a2"), @2024-01-01) { origin case_input; }
    }
    // only the first application per plant per calendar quarter counts
    evaluate truth(fuel_plant_application_not_first_in_quarter(entity_ref("urn:test:s5181c1c01secondapplicationinquarternotc#a2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
