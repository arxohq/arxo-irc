test "S5236-05-PROCEEDS-COVER-TAX-COSTS-AND-LEAVE-BALANCE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": storage_transfer_required(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant")) { origin case_input; }
        assert "f1": owner_or_warehouseman_failed_to_transfer_or_to_pay_transfer_expense(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant")) { origin case_input; }
        assert "f2": secretary_seizes_and_sells_spirits_on_distraint(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant")) { origin case_input; }
        assert "f3": secretary_finds_storage_facilities_unsafe_or_spirits_subject_to_great_loss(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant")) { origin case_input; }
        assert "f4": secretary_requires_discontinuance_and_transfer(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant")) { origin case_input; }
        assert "f5": taxes_due_on_distrained_spirits(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant"), 800.00 USD) { origin case_input; }
        assert "f6": cost_and_expenses_of_sale_and_removal(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant"), 150.00 USD) { origin case_input; }
        assert "f7": distraint_sale_proceeds(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant"), 1200.00 USD) { origin case_input; }
    }
    // 1,200 - 800 tax - 150 costs
    evaluate truth(balance_paid_over_to_owner(entity_ref("urn:test:s523605proceedscovertaxcostsandleavebala#plant"), 250.00 USD));
    expect truth_status == TRUE_ONLY;
