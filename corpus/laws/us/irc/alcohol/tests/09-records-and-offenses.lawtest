// Sections 5555, 5601(a), 5611, 5612 scenarios. NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5555-01-RECORDS-DUTY-VIOLATED-WITHOUT-RECORDS" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": is_liable_under_chapter51(entity_ref("urn:test:s5555:t1#p")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5555RecordsDuty, VIOLATED);
}

test "S5555-02-RECORDS-DUTY-PERFORMED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": is_liable_under_chapter51(entity_ref("urn:test:s5555:t2#p")) { origin case_input; }
        assert "f1": keeps_required_records_and_returns(entity_ref("urn:test:s5555:t2#p")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5555RecordsDuty, ACTIVE);
}

test "S5601-01-UNREGISTERED-DISTILLER-IS-A-SECTION-5601A2-OFFENSE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": operates_as_distiller_warehouseman_or_processor(entity_ref("urn:test:s5601:t1#p"), entity_ref("urn:test:s5601:t1#plant")) { origin case_input; }
    }
    evaluate truth(section_5601a_offense(entity_ref("urn:test:s5601:t1#p"), "5601(a)(2)"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5601-02-REGISTERED-DISTILLER-IS-NOT-AN-OFFENSE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": operates_as_distiller_warehouseman_or_processor(entity_ref("urn:test:s5601:t2#p"), entity_ref("urn:test:s5601:t2#plant")) { origin case_input; }
        assert "f1": plant_registered(entity_ref("urn:test:s5601:t2#plant"), entity_ref("urn:test:s5601:t2#p")) { origin case_input; }
    }
    evaluate truth(section_5601a_offense(entity_ref("urn:test:s5601:t2#p"), "5601(a)(2)"));
    expect truth_status == NEITHER;
}

