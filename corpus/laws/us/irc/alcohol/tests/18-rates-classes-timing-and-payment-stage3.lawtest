            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": finished_distilled_spirits_product_proof_gallons(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#b"), 100.0) { origin case_input; }
        assert "f1": flavors_alcohol_item(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#b"), entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i1"), 1.0) { origin case_input; }
        assert "f2": flavor_item_of_type_for_which_drawback_is_allowable_5114(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i1")) { origin case_input; }
        assert "f3": flavors_alcohol_item(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#b"), entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i2"), 2.0) { origin case_input; }
        assert "f4": flavor_item_of_type_for_which_drawback_is_allowable_5114(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i2")) { origin case_input; }
        assert "f5": flavor_item_made_at_a_distilled_spirits_plant(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i2")) { origin case_input; }
        assert "f6": flavors_alcohol_item(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#b"), entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i3"), 3.0) { origin case_input; }
        assert "f7": flavor_item_of_type_for_which_drawback_is_allowable_5114(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i3")) { origin case_input; }
        assert "f8": flavor_item_distilled_at_a_distilled_spirits_plant(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i3")) { origin case_input; }
        assert "f9": flavors_alcohol_item(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#b"), entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#i4"), 0.5) { origin case_input; }
    }
    // only the first item counts: (i) made at a plant, (ii) distilled at a plant, and a flavor not of an allowable type are excluded
    evaluate truth(flavors_content_proof_gallons_derived(entity_ref("urn:test:s5010c2b01flavorsmadeordistilledatplante#b"), 1.0));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
