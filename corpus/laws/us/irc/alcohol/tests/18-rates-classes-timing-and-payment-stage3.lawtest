    // 10 proof gallons x $13.50
    evaluate truth(liable_for_reattached_spirits_tax(entity_ref("urn:test:s5001a501unlawfuluseofdenaturedspiritspa#u"), 10.0, @2024-06-15, 135.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
