test "S5401-01-BREWER-NOTICE-DUTY-VIOLATED-WITHOUT-NOTICE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": commences_or_continues_brewer_business(entity_ref("urn:test:s5401:t1#p"), entity_ref("urn:test:s5401:t1#brewery")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5401NoticeDuty, VIOLATED);
}

test "S5401-02-BREWER-NOTICE-DUTY-PERFORMED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": commences_or_continues_brewer_business(entity_ref("urn:test:s5401:t2#p"), entity_ref("urn:test:s5401:t2#brewery")) { origin case_input; }
        assert "f1": brewer_notice_filed(entity_ref("urn:test:s5401:t2#p"), entity_ref("urn:test:s5401:t2#brewery")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5401NoticeDuty, ACTIVE);
}

