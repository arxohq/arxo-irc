// Sections 5361, 5401 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5361-01-RECEIVE-TAXPAID-WINE-FOR-RETURN-IS-AUTHORIZED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": conducts_wine_cellar_auxiliary_operation(entity_ref("urn:test:s5361:t1#cellar"), ReceiveTaxpaidWineForReturnReconditioningOrDestruction) { origin case_input; }
    }
    evaluate truth(authorized_wine_cellar_operation(entity_ref("urn:test:s5361:t1#cellar"), ReceiveTaxpaidWineForReturnReconditioningOrDestruction));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

