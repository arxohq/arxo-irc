// Sections 5171, 5172, 5173 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

test "S5171-01-UNREGISTERED-OPERATION-VIOLATED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": operates_as_distiller_warehouseman_or_processor(entity_ref("urn:test:s5171:t1#p"), entity_ref("urn:test:s5171:t1#plant")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5171UnregisteredOperationProhibition, VIOLATED);
}

test "S5171-02-REGISTERED-OPERATION-NOT-VIOLATED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": operates_as_distiller_warehouseman_or_processor(entity_ref("urn:test:s5171:t2#p"), entity_ref("urn:test:s5171:t2#plant")) { origin case_input; }
        assert "f1": plant_registered(entity_ref("urn:test:s5171:t2#plant"), entity_ref("urn:test:s5171:t2#p")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5171UnregisteredOperationProhibition, ACTIVE);
}

test "S5171-03-REGISTRATION-POWER-VALID-WHEN-QUALIFIED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": registration_application_filed(entity_ref("urn:test:s5171:t3#p"), entity_ref("urn:test:s5171:t3#plant"), @2024-01-01) { origin case_input; }
        assert "f1": applicant_complied_with_qualification_requirements(entity_ref("urn:test:s5171:t3#p"), entity_ref("urn:test:s5171:t3#plant")) { origin case_input; }
    }
    evaluate truth(plant_registered(entity_ref("urn:test:s5171:t3#plant"), entity_ref("urn:test:s5171:t3#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5171-04-REGISTRATION-POWER-INVALID-WITHOUT-COMPLIANCE" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": registration_application_filed(entity_ref("urn:test:s5171:t4#p"), entity_ref("urn:test:s5171:t4#plant"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(plant_registered(entity_ref("urn:test:s5171:t4#plant"), entity_ref("urn:test:s5171:t4#p")));
    expect truth_status == NEITHER;
}

test "S5173-01-COMMENCING-OPERATIONS-WITHOUT-BOND-VIOLATED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": commences_operations_at_plant(entity_ref("urn:test:s5173:t1#p"), entity_ref("urn:test:s5173:t1#plant")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5173NoOperationsBondProhibition, VIOLATED);
}

test "S5173-02-COMMENCING-OPERATIONS-WITH-BOND-NOT-VIOLATED" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": commences_operations_at_plant(entity_ref("urn:test:s5173:t2#p"), entity_ref("urn:test:s5173:t2#plant")) { origin case_input; }
        assert "f1": operations_bond_furnished(entity_ref("urn:test:s5173:t2#p"), entity_ref("urn:test:s5173:t2#plant")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5173NoOperationsBondProhibition, ACTIVE);
}

test "S5173-03-WITHDRAWAL-WITHOUT-BOND-EXCEPTED-UNDER-5551D" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": withdraws_spirits_without_payment(entity_ref("urn:test:s5173:t3#p"), entity_ref("urn:test:s5173:t3#r"), entity_ref("urn:test:s5173:t3#plant")) { origin case_input; }
        assert "f1": excepted_under_5551d(entity_ref("urn:test:s5173:t3#p"), entity_ref("urn:test:s5173:t3#plant")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section5173NoWithdrawalBondProhibition, ACTIVE);
}
