// Stage 2. Subchapter J parts II-V: criminal penalties and forfeitures.
// 5602-5610 (spirits), 5613-5615, 5661-5663 (wine), 5671-5675 (beer),
// 5681-5690 (common). Stage 1 already classifies section 5601(a)(2) and
// 5611/5612; this module follows its convention (module 09): the conduct
// is an OFFENSE CLASSIFICATION carrying the statutory maxima
// (max fine, max imprisonment) as data of the norm. The sentence itself is
// the court's judgment (EXTERNAL_DEPENDENCY) and no criminal conclusion is
// drawn from a civil breach. Forfeiture is a consequence relation, not an
// order of a court.

use self::{
    AlcoholicLot,
    DistilledSpiritsPlant,
    IRC_S5602,
    IRC_S5603_A,
    IRC_S5603_B,
    IRC_S5604_A,
    IRC_S5605,
    IRC_S5606,
    IRC_S5607,
    IRC_S5608_A,
    IRC_S5608_B,
    IRC_S5609_A,
    IRC_S5609_B,
    IRC_S5613_A,
    IRC_S5613_B,
    IRC_S5615,
    IRC_S5661_A,
    IRC_S5661_B,
    IRC_S5662,
    IRC_S5671,
    IRC_S5672,
    IRC_S5674_A,
    IRC_S5674_B,
    IRC_S5675,
    IRC_S5681_A,
    IRC_S5681_B,
    IRC_S5681_C,
    IRC_S5682,
    IRC_S5683,
    IRC_S5684_A,
    IRC_S5685_A,
    IRC_S5685_B,
    IRC_S5686_A,
    IRC_S5687,
    IRC_S5688_B,
    IRC_S5690,
    Person,
};

pub const LatePaymentPenaltyRate: Decimal = 0.05 {
    label en official "a penalty of 5 percent of the tax due but unpaid (section 5684(a))";
};
pub const BeerMarkRemovalPenaltyPerContainer: Money = 50.00 USD {
    label en official "$50 for each barrel or other container from which the mark, brand, or label is removed or defaced (section 5675)";
};
pub const FraudulentDrawbackForfeitureMultiplier: Integer = 3 {
    label en official "triple the amount wrongfully and fraudulently sought to be obtained (section 5608(a))";
};
pub const DestructionReimbursementWindowYears: Integer = 1 {
    label en official "within 1 year after destruction the owner may apply for reimbursement (section 5609(b))";
};

pub relation chapter_51_offense(p: Person, provision: Text, max_fine: Money, max_years: Integer) kind institutional {
    label en official "the person's conduct falls within a chapter 51 offense element, with the statutory maximum fine and maximum imprisonment (years) the provision names — the sentence is the court's (EXTERNAL_DEPENDENCY: judicial)";
}
pub relation acts_with_intent_to_defraud_united_states(p: Person) kind empirical {
    label en official "the person acts with intent to defraud the United States — DECISION-0194 evaluative (mental element), asserted with origin adjudicated";
}
pub relation acts_willfully(p: Person) kind empirical {
    label en official "the person acts willfully — DECISION-0194 evaluative (mental element)";
}
pub relation acts_knowingly(p: Person) kind empirical {
    label en official "the person acts knowingly — DECISION-0194 evaluative (mental element)";
}
pub relation has_specific_criminal_penalty_elsewhere_in_chapter(p: Person) kind empirical {
    label en official "a specific criminal penalty is prescribed by another provision of this chapter for the conduct (section 5687)";
}

// =============================================================================
// 5602: distiller defrauds; 5603: records offenses
// =============================================================================

pub relation distiller_defrauds_or_attempts_to_defraud_united_states_of_tax(p: Person) kind empirical {
    label en official "a person engaged in or carrying on the business of a distiller defrauds, attempts to defraud, or engages in such business with intent to defraud the United States of the tax on the spirits distilled, or any part (section 5602)";
}
@source(IRC_S5602, coverage = exact, quote = "he shall be fined not more than $10,000, or imprisoned not more than 5 years, or both.")
rule Section5602DistillerFraudOffenseRule(p: Person) strict {
    label en official "section 5602: a distiller who defrauds the United States of the spirits tax is subject to a fine of not more than $10,000, or imprisonment of not more than 5 years, or both (classification; the nolle prosequi restriction is the Attorney General's procedure, EXTERNAL_DEPENDENCY)";
    when distiller_defrauds_or_attempts_to_defraud_united_states_of_tax(p);
    then chapter_51_offense(p, "5602", 10000.00 USD, 5);
}
pub enum RecordOrDocumentAct {
    FailToKeepOrToMakeRequiredEntries;
    MakeFalseEntry;
    CancelAlterObliterateOrDestroy;
    HinderInspectionOrAbstracts;
    FailOrRefuseToPreserveOrProduce;
}
pub relation required_to_keep_or_file_record_under_chapter_other_than_f_and_g(p: Person) kind empirical {
    label en official "the person is required by this chapter (other than subchapters F and G) or regulations to keep or file a record, return, report, summary, transcript, or other document (section 5603(a)-(b))";
}
pub relation record_act_committed(p: Person, act: RecordOrDocumentAct) kind empirical {
    label en official "the person commits (or causes or procures) this act as to the document (section 5603(a)(1)-(5), (b)(1)-(5))";
}
@source(IRC_S5603_A, coverage = exact, quote = "shall be fined not more than $10,000, or imprisoned not more than 5 years, or both, for each such offense.")
rule Section5603aWithIntentOffenseRule(p: Person, act: RecordOrDocumentAct) strict {
    label en official "section 5603(a): with intent to defraud the United States, failing to keep or make entries, making false entries, canceling/altering/destroying, hindering inspection, or failing to preserve or produce a required document (or causing it) carries not more than $10,000 fine, 5 years, or both, for each offense";
    when required_to_keep_or_file_record_under_chapter_other_than_f_and_g(p);
    when record_act_committed(p, act);
    when acts_with_intent_to_defraud_united_states(p);
    then chapter_51_offense(p, "5603(a)", 10000.00 USD, 5);
}
@source(IRC_S5603_B, coverage = exact, quote = "shall be fined not more than $1,000, or imprisoned not more than 1 year, or both, for each such offense.")
rule Section5603bWithoutIntentOffenseRule(p: Person, act: RecordOrDocumentAct) defeasible {
    label en official "section 5603(b): the same acts otherwise than with intent to defraud carry not more than $1,000 fine, 1 year, or both, for each offense";
    when required_to_keep_or_file_record_under_chapter_other_than_f_and_g(p);
    when record_act_committed(p, act);
    unless acts_with_intent_to_defraud_united_states(p) and record_act_committed(p, act) and required_to_keep_or_file_record_under_chapter_other_than_f_and_g(p);
    then chapter_51_offense(p, "5603(b)", 1000.00 USD, 1);
}

// =============================================================================
// 5604: containers; 5605, 5606: returns and containers; 5607: denatured spirits
// =============================================================================

pub enum ClosureMarkAct {
    TransportPossessBuySellWithoutRequiredClosure;
    EmptyContainerWithIntentWithoutBreakingClosure;
    EmptyWithoutEffacingRequiredMark;
    PlaceSpiritsInBottleWithoutDestroyingClosure;
    WillfullyAndUnlawfullyRemoveMarkLabelOrSeal;
    PurchaseSellOrTransportEmptyMarkedCaskWithIntent;
    AlterMarkOrOverfillOrFraudulentlyUseInspectedCask;
}
pub relation closure_mark_act_committed(p: Person, act: ClosureMarkAct) kind empirical {
    label en official "the person commits this section 5604(a) act with respect to containers of distilled spirits";
}
@source(IRC_S5604_A, coverage = exact, quote = "shall be fined not more than $10,000 or imprisoned not more than 5 years, or both, for each such offense.")
rule Section5604aPlainActsOffenseRule(p: Person, act: ClosureMarkAct) strict {
    label en official "section 5604(a)(1), (3), (4), (7): transporting or dealing in spirits in a container without the required closure; emptying without effacing the required mark; refilling a used bottle without destroying its closure; altering marks or overfilling or fraudulently using an inspected cask carry not more than $10,000, 5 years, or both, for each offense";
    when closure_mark_act_committed(p, act);
    when act == TransportPossessBuySellWithoutRequiredClosure or act == EmptyWithoutEffacingRequiredMark or act == PlaceSpiritsInBottleWithoutDestroyingClosure or act == AlterMarkOrOverfillOrFraudulentlyUseInspectedCask;
    then chapter_51_offense(p, "5604(a)", 10000.00 USD, 5);
}
@source(IRC_S5604_A, coverage = exact, quote = "(2) with intent to defraud the United States, empty a container bearing the closure or other device required by section 5301(d) without breaking such closure or other device,")
rule Section5604aIntentActsOffenseRule(p: Person, act: ClosureMarkAct) strict {
    label en official "section 5604(a)(2), (6): the acts that require intent to defraud the United States (emptying a closed container without breaking the closure; dealing in an empty marked cask) carry the same maxima";
    when closure_mark_act_committed(p, act);
    when act == EmptyContainerWithIntentWithoutBreakingClosure or act == PurchaseSellOrTransportEmptyMarkedCaskWithIntent;
    when acts_with_intent_to_defraud_united_states(p);
    then chapter_51_offense(p, "5604(a)", 10000.00 USD, 5);
}
@source(IRC_S5604_A, coverage = exact, quote = "(5) willfully and unlawfully remove, change, or deface any mark, brand, label, or seal affixed to any case of distilled spirits, or to any bottle contained therein,")
rule Section5604aWillfulActOffenseRule(p: Person, act: ClosureMarkAct) strict {
    label en official "section 5604(a)(5): willfully and unlawfully removing, changing, or defacing a mark, brand, label, or seal on a case or bottle carries the same maxima";
    when closure_mark_act_committed(p, act);
    when act == WillfullyAndUnlawfullyRemoveMarkLabelOrSeal;
    when acts_willfully(p);
    then chapter_51_offense(p, "5604(a)", 10000.00 USD, 5);
}
pub relation willfully_violates_5291a_or_regulation(p: Person) kind empirical {
    label en official "the person willfully violates section 5291(a) or a regulation under it, or is an officer, director, or agent of such a person who knowingly participates in the violation (section 5605)";
}
@source(IRC_S5605, coverage = exact, quote = "shall be fined not more than $1,000, or imprisoned not more than 2 years, or both.")
rule Section5605OffenseRule(p: Person) strict {
    label en official "section 5605: a willful violation of section 5291(a) (and a knowing participation by an officer, director, or agent) carries not more than $1,000, 2 years, or both";
    when willfully_violates_5291a_or_regulation(p);
    when acts_willfully(p);
    then chapter_51_offense(p, "5605", 1000.00 USD, 2);
}
pub relation violates_section_5301_regulation_or_permit_terms(p: Person) kind empirical {
    label en official "the person violates section 5301, a regulation under it, or the terms or conditions of a permit issued under its authorization, or is an officer, director, or agent of a corporation who knowingly participates (section 5606)";
}
@source(IRC_S5606, coverage = exact, quote = "shall, upon conviction, be fined not more than $1,000, or imprisoned not more than 1 year, or both, for each such offense.")
rule Section5606OffenseRule(p: Person) strict {
    label en official "section 5606: a violation of section 5301 or its regulations or permit conditions carries not more than $1,000, 1 year, or both, for each offense";
    when violates_section_5301_regulation_or_permit_terms(p);
    then chapter_51_offense(p, "5606", 1000.00 USD, 1);
}
pub enum DenaturedSpiritsAct {
    UseInMedicinalOrFlavoringInViolationOfSection5273b1;
    KnowinglySellMedicinalOrFlavoringInViolationOfSection5273b2;
    KnowinglyWithdrawForBeveragePurposes;
    KnowinglySellForBeveragePurposes;
    RecoverOrKnowinglyUseRecoveredSpirits;
}
pub relation denatured_spirits_act_committed(p: Person, act: DenaturedSpiritsAct) kind empirical {
    label en official "the person commits this section 5607 act concerning denatured spirits withdrawn free of tax under section 5214(a)(1)";
}
pub relation forfeited_under_5607_personal_property_and_premises(p: Person) kind institutional {
    label en official "all personal property used in the person's business, and the buildings and ground constituting the premises where the unlawful acts are performed or permitted, are forfeited to the United States (section 5607)";
}
@source(IRC_S5607, coverage = exact, quote = "shall be fined not more than $10,000, or imprisoned not more than 5 years, or both, for each such offense")
rule Section5607OffenseRule(p: Person, act: DenaturedSpiritsAct) strict {
    label en official "section 5607(1)-(4): misuse of denatured spirits (medicinal or flavoring use or sale, withdrawal or sale for beverage purposes, recovery by redistillation or use of recovered spirits) carries not more than $10,000, 5 years, or both, for each offense";
    when denatured_spirits_act_committed(p, act);
    then chapter_51_offense(p, "5607", 10000.00 USD, 5);
}
@source(IRC_S5607, coverage = exact, quote = "and all personal property used in connection with his business, together with the buildings and ground constituting the premises on which such unlawful acts are performed or permitted to be performed shall be forfeited to the United States.")
rule Section5607ForfeitureRule(p: Person, act: DenaturedSpiritsAct) strict {
    label en official "section 5607: the offender's business personal property and the premises where the unlawful acts are performed are forfeited";
    when denatured_spirits_act_committed(p, act);
    then forfeited_under_5607_personal_property_and_premises(p);
}

// =============================================================================
// 5608: drawback fraud and relanding
// =============================================================================

pub entity FraudulentDrawbackAttempt {
    label en unofficial "a fraudulent claim for drawback on distilled spirits (section 5608(a))";
}
pub relation fraudulent_drawback_claimant(f: FraudulentDrawbackAttempt, p: Person) kind empirical {
    label en official "the person fraudulently claims, seeks, or obtains drawback on distilled spirits, or fraudulently claims more than the tax paid or determined (section 5608(a))";
}
pub relation amount_wrongfully_and_fraudulently_sought(f: FraudulentDrawbackAttempt, amount: Money) kind empirical {
    label en official "the amount wrongfully and fraudulently sought to be obtained (section 5608(a))";
}
pub relation triple_amount_forfeited_and_paid(f: FraudulentDrawbackAttempt, p: Person, amount: Money) kind institutional {
    label en official "the person shall forfeit and pay to the Government triple the amount wrongfully and fraudulently sought to be obtained (section 5608(a))";
}
@source(IRC_S5608_A, coverage = exact, quote = "shall forfeit and pay to the Government of the United States triple the amount wrongfully and fraudulently sought to be obtained, and shall be imprisoned not more than 5 years")
rule Section5608aTripleForfeitureRule(f: FraudulentDrawbackAttempt, p: Person, sought: Money) strict {
    label en official "section 5608(a): the forfeiture is 3 times the amount fraudulently sought (exact arithmetic, no rounding)";
    when fraudulent_drawback_claimant(f, p);
    when amount_wrongfully_and_fraudulently_sought(f, sought);
    then triple_amount_forfeited_and_paid(f, p, sought * FraudulentDrawbackForfeitureMultiplier);
}
@source(IRC_S5608_A, coverage = exact, quote = "shall be imprisoned not more than 5 years")
rule Section5608aImprisonmentRule(f: FraudulentDrawbackAttempt, p: Person) strict {
    label en official "section 5608(a): the fraudulent drawback claimant is imprisoned for not more than 5 years (no fine amount is named: the maximum fine is recorded as 0.00, the forfeiture being the pecuniary consequence)";
    when fraudulent_drawback_claimant(f, p);
    then chapter_51_offense(p, "5608(a)", 0.00 USD, 5);
}
pub relation knowingly_aids_or_abets_fraudulent_drawback_collection_or_permits_change_of_spirits(p: Person) kind empirical {
    label en official "an owner, agent, or master of a vessel, or other person, knowingly aids or abets in the fraudulent collection of drawback, or knowingly aids or permits any fraudulent change in the spirits shipped (section 5608(a))";
}
@source(IRC_S5608_A, coverage = exact, quote = "shall be fined not more than $5,000, or imprisoned not more than 3 years, or both")
rule Section5608aAiderOffenseRule(p: Person) strict {
    label en official "section 5608(a): a knowing aider or permitter carries not more than $5,000, 3 years, or both, and the vessel used is forfeited";
    when knowingly_aids_or_abets_fraudulent_drawback_collection_or_permits_change_of_spirits(p);
    when acts_knowingly(p);
    then chapter_51_offense(p, "5608(a) aider", 5000.00 USD, 3);
}
pub relation relands_or_receives_relanded_exported_spirits_with_intent_to_defraud(p: Person) kind empirical {
    label en official "the person, with intent to defraud the United States, relands within US jurisdiction distilled spirits shipped for exportation under this chapter, or receives, aids or abets the relanding (section 5608(b))";
}
@source(IRC_S5608_B, coverage = exact, quote = "shall be fined not more than $5,000, or imprisoned not more than 3 years, or both; and all distilled spirits so relanded, together with the vessel from whi")
rule Section5608bRelandingOffenseRule(p: Person) strict {
    label en official "section 5608(b): relanding or receiving relanded exported spirits with intent to defraud carries not more than $5,000, 3 years, or both, and forfeiture of the spirits and vessel";
    when relands_or_receives_relanded_exported_spirits_with_intent_to_defraud(p);
    when acts_with_intent_to_defraud_united_states(p);
    then chapter_51_offense(p, "5608(b)", 5000.00 USD, 3);
}

// =============================================================================
// 5609: destruction of seized property; 5613: forfeiture for marks and closures
// =============================================================================

pub entity SeizedProperty {
    label en unofficial "an unregistered still, distilling or fermenting equipment or material, or untaxed distilled spirits seized elsewhere than on qualified premises (section 5609)";
}
pub relation seizure_off_qualified_premises_for_offense_involving_forfeiture(sp: SeizedProperty) kind empirical {
    label en official "the property is seized elsewhere than on premises qualified under this chapter (for spirits: and not in transit to or from them) for an offense involving forfeiture (section 5609(a))";
}
pub relation removal_to_safe_storage_impracticable(sp: SeizedProperty) kind empirical {
    label en official "it is impracticable to remove the still, equipment, or material to a place of safe storage (section 5609(a) first sentence)";
}
pub relation seizure_is_untaxed_distilled_spirits(sp: SeizedProperty) kind empirical {
    label en official "the seized property is distilled spirits on which the tax has not been paid or determined (section 5609(a) second sentence)";
}
pub relation seizing_officer_destroys_property(o: Person, sp: SeizedProperty) kind empirical {
    label en official "the seizing officer destroys the property";
}
pub relation destruction_in_presence_of_credible_witness(sp: SeizedProperty) kind empirical {
    label en official "the destruction is in the presence of at least one credible witness (section 5609(a) third sentence)";
}
pub relation seizing_officer(o: Person, sp: SeizedProperty) kind empirical {
    label en official "the person is the officer who made the seizure";
}
@source(IRC_S5609_A, coverage = partial, quote = "the seizing officer is authorized to destroy the same.")
rule Section5609aDestroyLibertyRule(o: Person, sp: SeizedProperty) strict {
    label en official "section 5609(a): the seizing officer may destroy an unregistered still, equipment, or fermenting material where removal is impracticable, and untaxed spirits forthwith, in the presence of at least one credible witness (the report and samples the Secretary requires are EXTERNAL_DEPENDENCY)";
    when seizing_officer(o, sp);
    when seizure_off_qualified_premises_for_offense_involving_forfeiture(sp);
    when seizing_officer_destroys_property(o, sp);
    when destruction_in_presence_of_credible_witness(sp);
    then liberty Section5609aDestroySeizedProperty {
        holder o;
        action seizing_officer_destroys_property(o, sp);
        window [-infinity, infinity];
    };
}
pub relation property_destroyed_on(sp: SeizedProperty, on: Date) kind empirical {
    label en official "the date of destruction under section 5609(a)";
}
pub relation reimbursement_application_filed_by(sp: SeizedProperty, p: Person, on: Date) kind empirical {
    label en official "the owner, including a person having an interest, applies to the Secretary for reimbursement of the value of the property destroyed (section 5609(b))";
}
pub relation property_had_not_been_used_in_violation_of_law(sp: SeizedProperty) kind empirical {
    label en official "the claimant establishes to the Secretary's satisfaction that the property had not been used in violation of law (section 5609(b)(1))";
}
pub relation unlawful_use_without_claimant_consent_or_knowledge(sp: SeizedProperty) kind empirical {
    label en official "any unlawful use of the property was without the claimant's consent or knowledge (section 5609(b)(2))";
}
pub relation destroyed_property_value(sp: SeizedProperty, value: Money) kind empirical {
    label en official "the value of the property destroyed";
}
pub relation reimbursement_application_timely(sp: SeizedProperty, filed_on: Date) kind institutional {
    label en official "the application is made within 1 year after the destruction (section 5609(b))";
}
rule Section5609bTimelyRule(sp: SeizedProperty, p: Person, filed_on: Date, destroyed: Date) strict {
    label en official "section 5609(b): timely if filed within 1 year after the destruction";
    when reimbursement_application_filed_by(sp, p, filed_on);
    when property_destroyed_on(sp, destroyed);
    when filed_on <= add_calendar_period(destroyed, 1 calendar_year);
    then reimbursement_application_timely(sp, filed_on);
}
pub relation reimbursement_claim_valid(sp: SeizedProperty, filed_on: Date) kind institutional {
    label en unofficial "the application is timely and the claimant meets (b)(1) or (b)(2) (single-atom valid_when helper)";
}
rule Section5609bValidUnusedRule(sp: SeizedProperty, filed_on: Date) strict {
    label en unofficial "timely and not used in violation of law";
    when reimbursement_application_timely(sp, filed_on);
    when property_had_not_been_used_in_violation_of_law(sp);
    then reimbursement_claim_valid(sp, filed_on);
}
rule Section5609bValidWithoutConsentRule(sp: SeizedProperty, filed_on: Date) strict {
    label en unofficial "timely and unlawful use without the claimant's consent or knowledge";
    when reimbursement_application_timely(sp, filed_on);
    when unlawful_use_without_claimant_consent_or_knowledge(sp);
    then reimbursement_claim_valid(sp, filed_on);
}
pub relation reimbursement_allowed_up_to_value(sp: SeizedProperty, value: Money) kind institutional {
    label en official "the Secretary shall make an allowance to the claimant not exceeding the value of the property destroyed (section 5609(b))";
}
@source(IRC_S5609_B, coverage = exact, quote = "the Secretary shall make an allowance to such claimant not exceeding the value of the property destroyed.")
rule Section5609bReimbursementPowerRule(sp: SeizedProperty, p: Person, filed_on: Date, value: Money) strict {
    label en official "section 5609(b): the owner's application within 1 year is valid when the property was not used in violation of law or the unlawful use was without consent or knowledge; the effect is an allowance up to the value (E-0239: an untimely or unqualified application yields none)";
    when reimbursement_application_filed_by(sp, p, filed_on);
    when destroyed_property_value(sp, value);
    then power Section5609DestructionReimbursementClaim {
        holder p;
        over sp;
        exercise reimbursement_application_filed_by(sp, p, filed_on);
        valid_when reimbursement_claim_valid(sp, filed_on);
        effect create(reimbursement_allowed_up_to_value(sp, value));
        window [-infinity, infinity];
    };
}
pub entity MarkedSpiritsContainer {
    label en unofficial "a cask, package, or container of distilled spirits required to bear a mark, brand, identification, closure, or device (section 5613)";
}
pub relation package_required_to_bear_mark_brand_or_identification(c: MarkedSpiritsContainer) kind empirical {
    label en official "the cask or package is required by this chapter or a regulation to bear a mark, brand, or identification (section 5613(a))";
}
pub relation package_not_marked_in_compliance(c: MarkedSpiritsContainer) kind empirical {
    label en official "the cask or package is not marked, branded, or identified in compliance with this chapter and regulations (section 5613(a))";
}
pub relation container_required_to_bear_closure_or_device(c: MarkedSpiritsContainer) kind empirical {
    label en official "the container is required by this chapter to bear a closure or other device (section 5613(b))";
}
pub relation container_lacks_closure_in_compliance(c: MarkedSpiritsContainer) kind empirical {
    label en official "the container does not bear a closure or other device in compliance with this chapter (section 5613(b))";
}
pub relation spirits_forfeited_under_5613(c: MarkedSpiritsContainer) kind institutional {
    label en official "all distilled spirits found in the cask, package, or container are forfeited to the United States (section 5613)";
}
@source(IRC_S5613_A, coverage = exact, quote = "shall be forfeited to the United States.")
rule Section5613aMarkForfeitureRule(c: MarkedSpiritsContainer) strict {
    label en official "section 5613(a): all distilled spirits in a cask or package that is required to be marked but is not marked in compliance are forfeited";
    when package_required_to_bear_mark_brand_or_identification(c);
    when package_not_marked_in_compliance(c);
    then spirits_forfeited_under_5613(c);
}
@source(IRC_S5613_B, coverage = exact, quote = "All distilled spirits found in any container which is required by this chapter to bear a closure or other device and which does not bear a closure or other device in compliance with this chapter shall be forfeited to the United States.")
rule Section5613bClosureForfeitureRule(c: MarkedSpiritsContainer) strict {
    label en official "section 5613(b): all distilled spirits in a container that is required to bear a closure or device but does not are forfeited";
    when container_required_to_bear_closure_or_device(c);
    when container_lacks_closure_in_compliance(c);
    then spirits_forfeited_under_5613(c);
}

// =============================================================================
// 5615: property subject to forfeiture
// =============================================================================

pub entity ForfeitablePropertyItem {
    label en unofficial "a piece of property (still, apparatus, spirits, wine, raw material, personal property, or an interest in land) that section 5615 may forfeit";
}
pub relation item_is_unregistered_still_or_apparatus_with_registrant_property(item: ForfeitablePropertyItem) kind empirical {
    label en official "the item is a still or distilling apparatus not registered as required by section 5179, or personal property in the possession, custody, or control of the person required to register it and found in the building or connected yard or inclosure where it is set up (section 5615(1))";
}
pub relation item_is_still_or_vessel_removed_or_set_up_without_required_notice(item: ForfeitablePropertyItem) kind empirical {
    label en official "the item is a still, boiler, or other vessel for distilling removed without notice required by section 5101(a)(1), or set up without notice required by section 5101(a)(2) (section 5615(2))";
}
pub relation item_is_spirits_over_15_percent_produced_on_vinegar_plant_or_fluid_over_2_percent_proof_removed(item: ForfeitablePropertyItem) kind empirical {
    label en official "the item is distilled spirits in excess of 15 percent alcohol by volume produced on the premises of a vinegar plant, or vinegar or other fluid with more than 2 percent proof spirits removed from a vinegar plant (section 5615(4))";
}
pub relation item_is_untaxed_spirits_removed_other_than_as_authorized(item: ForfeitablePropertyItem) kind empirical {
    label en official "the item is distilled spirits on which the tax has not been paid or determined that have been removed, other than as authorized by law, from the place of manufacture, storage, or instrument of transportation (section 5615(6))";
}
pub relation item_is_untaxed_spirits_with_fictitious_proof_ingredient(item: ForfeitablePropertyItem) kind empirical {
    label en official "the item is distilled spirits on which the tax has not been paid or determined to which any ingredient or substance has been added to create fictitious proof (section 5615(7))";
}
pub relation forfeited_under_5615(item: ForfeitablePropertyItem, paragraph: Text) kind institutional {
    label en official "the item is forfeited to the United States under this paragraph of section 5615";
}
@source(IRC_S5615, coverage = partial, quote = "Every still or distilling apparatus not registered as required by section 5179")
rule Section5615p1ForfeitureRule(item: ForfeitablePropertyItem) strict {
    label en official "section 5615(1): an unregistered still and the registrant's personal property found where it is set up are forfeited";
    when item_is_unregistered_still_or_apparatus_with_registrant_property(item);
    then forfeited_under_5615(item, "5615(1)");
}
@source(IRC_S5615, coverage = partial, quote = "Any still, boiler, or other vessel to be used for the purpose of distilling—")
rule Section5615p2ForfeitureRule(item: ForfeitablePropertyItem) strict {
    label en official "section 5615(2): a distilling vessel removed or set up without a notice required by section 5101(a) is forfeited";
    when item_is_still_or_vessel_removed_or_set_up_without_required_notice(item);
    then forfeited_under_5615(item, "5615(2)");
}
pub enum DistillerForfeitureTrigger {
    CarriesOnBusinessWithoutBondOrGivesFalseBond;
    CarriesOnBusinessWithIntentToDefraudTax;
    OperatesAfterSuspensionNoticeOrHasMashWithIntentToDistill;
}
pub relation distiller_forfeiture_trigger(p: Person, trigger: DistillerForfeitureTrigger) kind empirical {
    label en official "the person carries on the business of a distiller without bond as required by law or gives a false, forged, or fraudulent bond; or with intent to defraud the United States of the tax; or after the time fixed in a section 5221(a) suspension notice carries on the business on the premises or has mash, wort, or beer there with intent to distill (section 5615(3))";
}
pub enum ForfeitureItemKind5615p3 {
    OwnedSpiritsWinesOrApparatus;
    PropertyInDistilleryAndConnectedPremises;
    OffenderInterestInDistilleryLand;
    KnowingPermitterInterestInDistilleryLand;
    PersonalPropertyInIngressEgressPremises;
    KnowingPermitterInterestInIngressEgressPremises;
}
pub relation item_linked_to_distiller_forfeiture(item: ForfeitablePropertyItem, p: Person, kind: ForfeitureItemKind5615p3) kind empirical {
    label en official "the item is of this section 5615(3)(A)-(F) kind in relation to the person: (A) spirits, wines, and apparatus owned by the person wherever found; (B) spirits, wines, raw materials, and personal property in the distillery or connected premises; (C) the person's interest in the land of the distillery; (D) the interest in that land of every person who knowingly suffered or permitted the business or connived; (E) personal property of anyone who permitted ingress or egress premises, found there; (F) the interest of every person who knowingly permitted ingress or egress premises";
}
pub relation permitter_acted_knowingly_or_connived(item: ForfeitablePropertyItem) kind empirical {
    label en official "the person whose interest is at stake knowingly suffered or permitted the use (section 5615(3)(D), (F)) or connived at it";
}
@source(IRC_S5615, coverage = partial, quote = "(A) all distilled spirits or wines, and all stills or other apparatus fit or intended to be used for the distillation or rectification of spirits, or for the compounding of liquors, owned by such person, wherever found; and")
rule Section5615p3AbceForfeitureRule(item: ForfeitablePropertyItem, p: Person, trigger: DistillerForfeitureTrigger, kind: ForfeitureItemKind5615p3) strict {
    label en official "section 5615(3)(A), (B), (C), (E): once a distiller-forfeiture trigger holds for a person, the person's owned spirits/wines/apparatus, the property in the distillery and connected premises, the person's interest in the distillery land, and personal property in ingress or egress premises are forfeited";
    when distiller_forfeiture_trigger(p, trigger);
    when item_linked_to_distiller_forfeiture(item, p, kind);
    when kind == OwnedSpiritsWinesOrApparatus or kind == PropertyInDistilleryAndConnectedPremises or kind == OffenderInterestInDistilleryLand or kind == PersonalPropertyInIngressEgressPremises;
    then forfeited_under_5615(item, "5615(3)");
}
@source(IRC_S5615, coverage = partial, quote = "(D) all the right, title, and interest in the lot or tract of land on which the distillery is located of every person who knowingly has suffered or permitted the business of a distiller to be there carried on, or has connived at the same; and")
rule Section5615p3DfForfeitureRule(item: ForfeitablePropertyItem, p: Person, trigger: DistillerForfeitureTrigger, kind: ForfeitureItemKind5615p3) strict {
    label en official "section 5615(3)(D), (F): the land or premises interest of a person who knowingly suffered or permitted the business (or the ingress or egress use), or connived at it, is forfeited";
    when distiller_forfeiture_trigger(p, trigger);
    when item_linked_to_distiller_forfeiture(item, p, kind);
    when kind == KnowingPermitterInterestInDistilleryLand or kind == KnowingPermitterInterestInIngressEgressPremises;
    when permitter_acted_knowingly_or_connived(item);
    then forfeited_under_5615(item, "5615(3)");
}
@source(IRC_S5615, coverage = partial, quote = "(A) all distilled spirits in excess of 15 percent of alcohol by volume produced on the premises of a vinegar plant; and")
rule Section5615p4ForfeitureRule(item: ForfeitablePropertyItem) strict {
    label en official "section 5615(4): spirits over 15 percent produced on a vinegar plant, and vinegar or fluid over 2 percent proof spirits removed from it, are forfeited";
    when item_is_spirits_over_15_percent_produced_on_vinegar_plant_or_fluid_over_2_percent_proof_removed(item);
    then forfeited_under_5615(item, "5615(4)");
}
pub relation section_5207_record_person_acts_with_intent_to_defraud(p: Person, plant: DistilledSpiritsPlant) kind empirical {
    label en official "a person required by section 5207 to keep or file a document, with intent to defraud the United States, fails to keep it or make entries, makes a false entry, cancels/alters/destroys, hinders inspection, fails to preserve or produce, or permits any of these acts, at this plant (section 5615(5))";
}
pub relation person_interest_in_plant_forfeited_under_5615p5(p: Person, plant: DistilledSpiritsPlant) kind institutional {
    label en official "all interest of the person in the plant, its equipment, the land on which it stands, and personal property used in the business there is forfeited (section 5615(5))";
}
@source(IRC_S5615, coverage = partial, quote = "all interest of such person in the distilled spirits plant where such acts or omissions occur, and in the equipment thereon, and in the lot or tract of land on which such distilled spirits plant stands, and in all personal property on the premises of the distilled spirits plant where such acts or omissions occur, used in the business there carried on; and")
rule Section5615p5ForfeitureRule(p: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5615(5): the person's interest in the plant, equipment, land, and business personal property is forfeited where the person, with intent to defraud, commits a section 5207 record act at that plant";
    when section_5207_record_person_acts_with_intent_to_defraud(p, plant);
    when acts_with_intent_to_defraud_united_states(p);
    then person_interest_in_plant_forfeited_under_5615p5(p, plant);
}
@source(IRC_S5615, coverage = partial, quote = "All distilled spirits on which the tax has not been paid or determined which have been removed, other than as authorized by law, from the place of manufacture, storage, or instrument of transportation; and")
rule Section5615p6ForfeitureRule(item: ForfeitablePropertyItem) strict {
    label en official "section 5615(6): untaxed spirits removed other than as authorized are forfeited";
    when item_is_untaxed_spirits_removed_other_than_as_authorized(item);
    then forfeited_under_5615(item, "5615(6)");
}
@source(IRC_S5615, coverage = partial, quote = "All distilled spirits on which the tax has not been paid or determined as provided by law to which any ingredient or substance has been added for the purpose of creating fictitious proof.")
rule Section5615p7ForfeitureRule(item: ForfeitablePropertyItem) strict {
    label en official "section 5615(7): untaxed spirits with an ingredient added to create fictitious proof are forfeited";
    when item_is_untaxed_spirits_with_fictitious_proof_ingredient(item);
    then forfeited_under_5615(item, "5615(7)");
}

// =============================================================================
// 5661-5663 (wine), 5671-5675 (beer)
// =============================================================================

pub relation fails_to_pay_wine_tax_or_violates_subchapter_f_or_subpart_c(p: Person) kind empirical {
    label en official "the person fails to pay any tax imposed on wine, violates or fails to comply with a provision of subchapter F or subpart C of part I of subchapter A or regulations, or recovers or attempts to recover spirits from wine (section 5661(a))";
}
pub relation proprietor_employee_agent_or_other_violates_subchapter_f_or_subpart_c(p: Person) kind empirical {
    label en official "a proprietor of subchapter F premises, its employee or agent, or any other person violates or fails to comply with subchapter F or subpart C or regulations, or aids or abets (section 5661(b))";
}
@source(IRC_S5661_A, coverage = exact, quote = "shall be fined not more than $5,000, or imprisoned not more than 5 years, or both, for each such offense, and all products and materials used in any such violation shall be forfeited to the United States.")
rule Section5661aOffenseRule(p: Person) strict {
    label en official "section 5661(a): with intent to defraud, failing to pay wine tax or violating subchapter F carries not more than $5,000, 5 years, or both, and forfeiture of the products and materials used";
    when fails_to_pay_wine_tax_or_violates_subchapter_f_or_subpart_c(p);
    when acts_with_intent_to_defraud_united_states(p);
    then chapter_51_offense(p, "5661(a)", 5000.00 USD, 5);
}
@source(IRC_S5661_B, coverage = exact, quote = "shall be fined not more than $1,000, or imprisoned not more than 1 year, or both, for each such offense.")
rule Section5661bOffenseRule(p: Person) defeasible {
    label en official "section 5661(b): the same violations otherwise than with intent to defraud carry not more than $1,000, 1 year, or both, for each offense";
    when proprietor_employee_agent_or_other_violates_subchapter_f_or_subpart_c(p);
    unless acts_with_intent_to_defraud_united_states(p) and proprietor_employee_agent_or_other_violates_subchapter_f_or_subpart_c(p);
    then chapter_51_offense(p, "5661(b)", 1000.00 USD, 1);
}
pub relation alters_wine_label_or_misrepresents_wine_identity_or_effervescence(p: Person) kind empirical {
    label en official "without the Secretary's permission, the person so alters a required wine mark, brand, or label as to materially change its meaning; represents wine to be of another identity or origin; or represents a still wine to be effervescent or a substitute (section 5662)";
}
@source(IRC_S5662, coverage = exact, quote = "shall be fined not more than $1,000, or imprisoned not more than 1 year, or both, for each such offense.")
rule Section5662OffenseRule(p: Person) strict {
    label en official "section 5662: altering wine labels or misrepresenting wine carries not more than $1,000, 1 year, or both, for each offense";
    when alters_wine_label_or_misrepresents_wine_identity_or_effervescence(p);
    then chapter_51_offense(p, "5662", 1000.00 USD, 1);
}
pub relation evades_or_attempts_to_evade_beer_tax_or_fails_records_with_intent(p: Person) kind empirical {
    label en official "the person evades or attempts to evade the tax imposed by section 5051, or with intent to defraud fails or refuses to keep and file the records and returns required by section 5415 (section 5671)";
}
@source(IRC_S5671, coverage = exact, quote = "shall be fined not more than $5,000, or imprisoned not more than 5 years, or both, for each such offense, and shall forfeit all beer made by him or for him, and all the vessels, utensils, and apparatus used in making the same.")
rule Section5671OffenseRule(p: Person) strict {
    label en official "section 5671: evading beer tax, or with intent to defraud failing to keep and file section 5415 records and returns, carries not more than $5,000, 5 years, or both, and forfeiture of the beer and the vessels, utensils, and apparatus";
    when evades_or_attempts_to_evade_beer_tax_or_fails_records_with_intent(p);
    then chapter_51_offense(p, "5671", 5000.00 USD, 5);
}
pub relation brewer_fails_records_or_returns_refuses_inspection_or_violates_subchapter_g(p: Person) kind empirical {
    label en official "a brewer fails or refuses to keep records and file returns required by section 5415, refuses to permit inspection of his records, or violates subchapter G or regulations (section 5672)";
}
@source(IRC_S5672, coverage = exact, quote = "shall be fined not more than $1,000, or imprisoned not more than 1 year, or both, for each such offense.")
rule Section5672OffenseRule(p: Person) defeasible {
    label en official "section 5672: a brewer's non-fraudulent record, return, inspection, or subchapter G violation carries not more than $1,000, 1 year, or both, for each offense";
    when brewer_fails_records_or_returns_refuses_inspection_or_violates_subchapter_g(p);
    unless acts_with_intent_to_defraud_united_states(p) and brewer_fails_records_or_returns_refuses_inspection_or_violates_subchapter_g(p);
    then chapter_51_offense(p, "5672", 1000.00 USD, 1);
}
pub relation brews_or_produces_beer_outside_qualified_brewery_and_not_exempt(p: Person) kind empirical {
    label en official "the person brews or produces beer other than in a brewery qualified under subchapter G and other than exempt under section 5053(e) (section 5674(a))";
}
@source(IRC_S5674_A, coverage = exact, quote = "Any person who brews beer or produces beer shall be fined not more than $1,000, or imprisoned not more than 1 year, or both, unless such beer is brewed or produced in a brewery qualified under subchapter G or such production is exempt from tax under section 5053(e) (relating to beer for personal or family use).")
rule Section5674aOffenseRule(p: Person) strict {
    label en official "section 5674(a): brewing beer outside a qualified brewery and not exempt under section 5053(e) carries not more than $1,000, 1 year, or both";
    when brews_or_produces_beer_outside_qualified_brewery_and_not_exempt(p);
    then chapter_51_offense(p, "5674(a)", 1000.00 USD, 1);
}
pub relation removes_or_aids_removal_of_beer_without_complying_with_chapter(p: Person) kind empirical {
    label en official "a brewer or other person removes or aids in the removal of beer from a brewery without complying with this chapter or regulations (section 5674(b))";
}
@source(IRC_S5674_B, coverage = exact, quote = "shall be fined not more than $1,000, or imprisoned not more than 1 year, or both.")
rule Section5674bOffenseRule(p: Person) strict {
    label en official "section 5674(b): a non-compliant beer removal carries not more than $1,000, 1 year, or both";
    when removes_or_aids_removal_of_beer_without_complying_with_chapter(p);
    then chapter_51_offense(p, "5674(b)", 1000.00 USD, 1);
}
pub entity BeerMarkRemovalCase {
    label en unofficial "the intentional removal or defacing of marks, brands, or labels required by section 5412 (section 5675)";
}
pub relation intentionally_removes_or_defaces_required_beer_mark_by_non_owner(m: BeerMarkRemovalCase, p: Person) kind empirical {
    label en official "a person other than the owner or his authorized agent intentionally removes or defaces a mark, brand, or label required by section 5412 (section 5675)";
}
pub relation containers_defaced_count(m: BeerMarkRemovalCase, n: Integer) kind empirical {
    label en official "the number of barrels or other containers from which the mark, brand, or label is removed or defaced";
}
pub relation beer_mark_removal_penalty(m: BeerMarkRemovalCase, p: Person, amount: Money) kind institutional {
    label en official "the penalty: $50 for each barrel or other container (section 5675)";
}
@source(IRC_S5675, coverage = exact, quote = "shall be liable to a penalty of $50 for each barrel or other container from which such mark, brand, or label is so removed or defaced.")
rule Section5675PenaltyRule(m: BeerMarkRemovalCase, p: Person, n: Integer) strict {
    label en official "section 5675: a civil penalty of $50 for each container";
    when intentionally_removes_or_defaces_required_beer_mark_by_non_owner(m, p);
    when containers_defaced_count(m, n);
    then beer_mark_removal_penalty(m, p, n * BeerMarkRemovalPenaltyPerContainer);
}

// =============================================================================
// 5681-5690: common provisions
// =============================================================================

pub relation fails_to_post_required_sign(p: Person) kind empirical {
    label en official "a person engaged in distilled spirits operations fails to post the sign required by section 5180(a) (section 5681(a))";
}
@source(IRC_S5681_A, coverage = exact, quote = "Every person engaged in distilled spirits operations who fails to post the sign required by section 5180(a) shall be fined not more than $1,000, or imprisoned not more than 1 year, or both.")
rule Section5681aOffenseRule(p: Person) strict {
    label en official "section 5681(a): failing to post the section 5180(a) sign carries not more than $1,000, 1 year, or both";
    when fails_to_post_required_sign(p);
    then chapter_51_offense(p, "5681(a)", 1000.00 USD, 1);
}
pub relation displays_sign_indicating_lawful_distiller_warehouseman_processor_or_wholesale_dealer_status(p: Person) kind empirical {
    label en official "the person puts up or keeps up a sign indicating that he may lawfully carry on the business of a distiller, warehouseman, or processor of distilled spirits or wholesale dealer in liquors (section 5681(b))";
}
pub relation person_lawfully_entitled_to_display_sign(p: Person) kind empirical {
    label en official "the person is a distiller, warehouseman, or processor who has received notice of registration under section 5171(c), or a wholesale dealer in liquors who meets section 5121(a) and 5124 (or is exempt by section 5121(b)) (section 5681(b))";
}
@source(IRC_S5681_B, coverage = exact, quote = "shall be fined not more than $1,000, or imprisoned not more than 1 year, or both.")
rule Section5681bOffenseRule(p: Person) defeasible {
    label en official "section 5681(b): displaying a lawful-operator sign without being registered (or a qualifying wholesale dealer) carries not more than $1,000, 1 year, or both";
    when displays_sign_indicating_lawful_distiller_warehouseman_processor_or_wholesale_dealer_status(p);
    unless person_lawfully_entitled_to_display_sign(p) and displays_sign_indicating_lawful_distiller_warehouseman_processor_or_wholesale_dealer_status(p);
    then chapter_51_offense(p, "5681(b)", 1000.00 USD, 1);
}
pub relation works_at_or_knowingly_serves_plant_without_required_sign(p: Person) kind empirical {
    label en official "the person works in a distilled spirits plant on which no section 5180(a) sign is placed or kept, or knowingly receives at, carries to or from, or delivers raw material to such a plant (section 5681(c))";
}
pub relation vehicles_aircraft_or_vessels_used_forfeited_under_5681c(p: Person) kind institutional {
    label en official "all vehicles, aircraft, or vessels used in carrying or conveying the property are forfeited (section 5681(c))";
}
@source(IRC_S5681_C, coverage = exact, quote = "shall forfeit all vehicles, aircraft, or vessels used in carrying or conveying such property and shall be fined not more than $1,000, or imprisoned not more than 1 year, or both.")
rule Section5681cOffenseRule(p: Person) strict {
    label en official "section 5681(c): working at, or knowingly serving, a plant without the required sign carries not more than $1,000, 1 year, or both, and forfeiture of the conveyances used";
    when works_at_or_knowingly_serves_plant_without_required_sign(p);
    then chapter_51_offense(p, "5681(c)", 1000.00 USD, 1);
}
pub relation tampers_with_lock_or_seal_or_gains_access_in_absence_of_proper_officer(p: Person) kind empirical {
    label en official "the person destroys, breaks, injures, or tampers with a lock or seal placed by an authorized officer or an approved lock or seal placed by a proprietor, or opens it or gains access to the contents in the absence of the proper officer or otherwise than as authorized (section 5682)";
}
@source(IRC_S5682, coverage = exact, quote = "shall be fined not more than $5,000, or imprisoned not more than 3 years, or both.")
rule Section5682OffenseRule(p: Person) strict {
    label en official "section 5682: breaking or tampering with a lock or seal, or gaining access in the officer's absence, carries not more than $5,000, 3 years, or both";
    when tampers_with_lock_or_seal_or_gains_access_in_absence_of_proper_officer(p);
    then chapter_51_offense(p, "5682", 5000.00 USD, 3);
}
pub relation ships_transports_or_removes_alcohol_under_improper_name_or_brand(p: Person) kind empirical {
    label en official "the person ships, transports, or removes distilled spirits, wines, or beer under other than the proper name or brand known to the trade as designating the kind and quality of the contents, or causes it (section 5683)";
}
@source(IRC_S5683, coverage = exact, quote = "he shall be fined not more than $1,000, or imprisoned not more than 1 year, or both, and shall forfeit such distilled spirits, wines, or beer, and casks or packages.")
rule Section5683OffenseRule(p: Person) strict {
    label en official "section 5683: shipping under an improper name or brand carries not more than $1,000, 1 year, or both, and forfeiture of the goods and packages";
    when ships_transports_or_removes_alcohol_under_improper_name_or_brand(p);
    then chapter_51_offense(p, "5683", 1000.00 USD, 1);
}
pub entity LateAlcoholTaxPayment {
    label en unofficial "a failure to pay a tax imposed by part I of subchapter A at the time prescribed (section 5684(a))";
}
pub relation late_payment_taxpayer(l: LateAlcoholTaxPayment, p: Person) kind empirical {
    label en official "the person who fails to pay the tax at the time prescribed";
}
pub relation tax_due_but_unpaid_amount(l: LateAlcoholTaxPayment, amount: Money) kind empirical {
    label en official "the tax due but unpaid at the time prescribed (section 5684(a))";
}
pub relation late_alcohol_tax_penalty(l: LateAlcoholTaxPayment, p: Person, amount: Money) kind institutional {
    label en official "the penalty for failure to pay: 5 percent of the tax due but unpaid, in addition to any other penalty (section 5684(a)); assessed, collected, and paid in the same manner as taxes (section 5684(b), cross-reference to section 6665(a))";
}
@source(IRC_S5684_A, coverage = exact, quote = "shall, in addition to any other penalty provided in this title, be liable to a penalty of 5 percent of the tax due but unpaid.")
rule Section5684aPenaltyRule(l: LateAlcoholTaxPayment, p: Person, tax: Money) strict {
    label en official "section 5684(a): 5 percent of the tax due but unpaid; JUDGMENT CALL: the statute names no rounding of the result, so exact Decimal multiplication (a 5 percent literal is exact) and no rounding is applied";
    when late_payment_taxpayer(l, p);
    when tax_due_but_unpaid_amount(l, tax);
    then late_alcohol_tax_penalty(l, p, tax * LatePaymentPenaltyRate);
}
pub enum ViolationWeapon { GasSmokeOrFumeDevice; Explosive; FirearmOtherThanMachineGunOrShortBarrel; MachineGun; ShortBarrelShotgunOrRifle; }
pub relation possesses_weapon_when_violating_liquor_law(p: Person, w: ViolationWeapon) kind empirical {
    label en official "when violating, or aiding a violation of, a law relating to the manufacture, taxation, or transportation of or traffic in distilled spirits, wines, or beer, the person has in his possession or control this device or weapon (section 5685(a)-(b)); all persons engaged in the violation are held in possession (section 5685(a), (b))";
}
@source(IRC_S5685_A, coverage = exact, quote = "shall be fined not more than $5,000, or imprisoned not more than 10 years, or both, and all persons engaged in any such violation or in aiding in any such violation shall be held to be in possession or control of such device, firearm, or explosive.")
rule Section5685aOffenseRule(p: Person, w: ViolationWeapon) strict {
    label en official "section 5685(a): possessing a gas/smoke device, an explosive, or a firearm (other than a machine gun or a short-barrel shotgun or rifle) when violating a liquor law carries not more than $5,000, 10 years, or both";
    when possesses_weapon_when_violating_liquor_law(p, w);
    when w == GasSmokeOrFumeDevice or w == Explosive or w == FirearmOtherThanMachineGunOrShortBarrel;
    then chapter_51_offense(p, "5685(a)", 5000.00 USD, 10);
}
@source(IRC_S5685_B, coverage = exact, quote = "shall be imprisoned not more than 20 years; and all persons engaged in any such violation or in aiding in any such violation shall be held to be in possession and control of such machine gun, shotgun, or rifle.")
rule Section5685bOffenseRule(p: Person, w: ViolationWeapon) strict {
    label en official "section 5685(b): possessing a machine gun, or a shotgun under 18 inches or a rifle under 16 inches in barrel length, when violating a liquor law carries imprisonment of not more than 20 years (no fine amount named: recorded as 0.00)";
    when possesses_weapon_when_violating_liquor_law(p, w);
    when w == MachineGun or w == ShortBarrelShotgunOrRifle;
    then chapter_51_offense(p, "5685(b)", 0.00 USD, 20);
}
pub relation possesses_liquor_or_property_intended_for_or_used_in_violation(p: Person) kind empirical {
    label en official "the person has, possesses, or uses liquor or property intended for use in violating this chapter or regulations, or which has been so used (section 5686(a))";
}
@source(IRC_S5686_A, coverage = exact, quote = "and every person so having or possessing or using such liquor or property, shall be fined not more than $5,000, or imprisoned not more than 1 year, or both.")
rule Section5686aOffenseRule(p: Person) strict {
    label en official "section 5686(a): possessing or using liquor or property intended for, or used in, a violation of this chapter carries not more than $5,000, 1 year, or both";
    when possesses_liquor_or_property_intended_for_or_used_in_violation(p);
    then chapter_51_offense(p, "5686(a)", 5000.00 USD, 1);
}
pub relation violates_chapter_51_provision_or_regulation(p: Person) kind empirical {
    label en official "the person violates a provision of this chapter or regulations issued pursuant thereto (section 5687)";
}
@source(IRC_S5687, coverage = exact, quote = "Whoever violates any provision of this chapter or regulations issued pursuant thereto, for which a specific criminal penalty is not prescribed by this chapter, shall be fined not more than $1,000, or imprisoned not more than 1 year, or both, for each such offense.")
rule Section5687GeneralOffenseRule(p: Person) defeasible {
    label en official "section 5687: a violation of this chapter or its regulations for which no specific criminal penalty is prescribed carries not more than $1,000, 1 year, or both, for each offense";
    when violates_chapter_51_provision_or_regulation(p);
    unless has_specific_criminal_penalty_elsewhere_in_chapter(p) and violates_chapter_51_provision_or_regulation(p);
    then chapter_51_offense(p, "5687", 1000.00 USD, 1);
}
pub relation forfeited_spirits_sold_by_court_order_or_distraint(l: AlcoholicLot) kind empirical {
    label en official "distilled spirits are sold by order of court, or under process of distraint (section 5688(b))";
}
pub relation purchaser_of_forfeited_spirits(p: Person, l: AlcoholicLot) kind empirical {
    label en official "the purchaser at a court or distraint sale of the spirits";
}
pub relation sale_exempt_under_5243(l: AlcoholicLot) kind empirical {
    label en official "the sale is a section 5243 sale of abandoned spirits to a plant proprietor for denaturation or redistillation";
}
pub relation purchaser_paid_tax_before_taking_possession(p: Person, l: AlcoholicLot) kind empirical {
    label en official "the purchaser pays the tax on the spirits immediately, before taking possession (section 5688(b))";
}
@source(IRC_S5688_B, coverage = exact, quote = "all distilled spirits sold by order of court, or under process of distraint, shall be sold subject to tax; and the purchaser shall immediately, and before he takes possession of said spirits, pay the tax thereon")
rule Section5688bPurchaserPaysTaxRule(p: Person, l: AlcoholicLot) defeasible {
    label en official "section 5688(b): spirits sold by order of court or distraint are sold subject to tax, and the purchaser pays the tax before taking possession, except a section 5243 sale";
    when forfeited_spirits_sold_by_court_order_or_distraint(l);
    when purchaser_of_forfeited_spirits(p, l);
    unless sale_exempt_under_5243(l) and forfeited_spirits_sold_by_court_order_or_distraint(l) and purchaser_of_forfeited_spirits(p, l);
    then duty Section5688bPurchaserTaxDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition purchaser_paid_tax_before_taking_possession(p, l);
            window [-infinity, infinity];
        }
    };
}
pub relation person_is_corporate_officer_or_employee_with_duty_to_perform_act(p: Person) kind empirical {
    label en official "the individual is an officer or employee of a corporation, or a member or employee of a partnership, who as such is under a duty to perform the act in respect of which the violation occurs (section 5690)";
}
pub relation person_for_subchapter_j_part_v_includes(p: Person) kind institutional {
    label en official "the term person, as used in subchapter J part V, includes the officer, employee, or member under a duty to perform the act (section 5690)";
}
@source(IRC_S5690, coverage = exact, quote = "includes an officer or employee of a corporation or a member or employee of a partnership, who as such officer, employee, or member is under a duty to perform the act in respect of which the violation occurs.")
rule Section5690PersonDefinitionRule(p: Person) strict {
    label en official "section 5690: for the subchapter, person includes an officer, employee, or member under a duty to perform the act violated";
    when person_is_corporate_officer_or_employee_with_duty_to_perform_act(p);
    then person_for_subchapter_j_part_v_includes(p);
}
