// Stage 3 (TECH_GAP reduction), second module: section 5181(c)(1)(C), (2)(C)(ii); 5236 (seizure and sale); 5373(b)(3)
// (wine spirits credit); 5384(b) (ameliorated fruit wines); 5555(b) (waiver); 5601(a) offense elements; 5688
// (forfeited spirits, wines and beer); 5505(c)-(j) (applicability to vinegar plants); 5011(c)(2)-(3); burden of
// proof (sections 5044(a), 5370(b), 5614).

// =====================================================================
// Section 5181(c)(1)(C): only the first application per plant per calendar quarter; (c)(2)(C)(ii): a denial does not prejudice
// =====================================================================

use self::{
    AlcoholicLot,
    DeemedFederalExciseTaxPerCase,
    DistilledSpiritsPlant,
    FuelPlantApplication,
    IRC_S5011_C,
    IRC_S5044_A,
    IRC_S5181_C,
    IRC_S5236,
    IRC_S5370_B,
    IRC_S5373_B,
    IRC_S5384_B,
    IRC_S5505_C,
    IRC_S5505_D,
    IRC_S5505_E,
    IRC_S5505_F,
    IRC_S5505_G,
    IRC_S5505_H,
    IRC_S5505_I,
    IRC_S5505_J,
    IRC_S5555_B,
    IRC_S5601_A,
    IRC_S5614,
    IRC_S5688_A,
    Organ,
    Person,
    SpiritsLienTerminatingEvent,
    SpiritsLossCause,
    WineLoss,
    WineLossCause,
    fuel_plant_application_for,
    fuel_plant_application_received_on,
    is_alcohol_taxpayer,
    lot_is_natural_wine_from_fruit_other_than_grapes,
    section_5181_spirits_used_sold_or_disposed_for_other_than_fuel,
    section_5601a_offense,
    storage_transfer_required,
    wine_loss_cause,
    wine_loss_claim_filed_by,
};

pub relation fuel_plant_application_quarter_starts(a: FuelPlantApplication, quarter_starts: Date) kind empirical {
    label en official "the first day of the calendar quarter in which the application is submitted";
}
pub relation fuel_plant_application_corrects_or_amends(corrected: FuelPlantApplication, first: FuelPlantApplication) kind empirical {
    label en official "section 5181(c)(1)(C): the application is a corrected or amended first application, not a separate application";
}
pub relation fuel_plant_application_not_first_in_quarter(a: FuelPlantApplication) kind institutional {
    label en official "section 5181(c)(1)(C): an earlier application for the same plant was submitted in the same calendar quarter, so this section does not apply to this application";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "If more than one application is submitted with respect to any eligible distilled spirits plant in any calendar quarter, the provisions of this section shall apply only to the first application submitted with respect to such plant during such quarter.")
rule FuelPlantApplicationNotFirstInQuarter(a: FuelPlantApplication, a2: FuelPlantApplication, plant: DistilledSpiritsPlant, q: Date, d: Date, d2: Date) strict {
    when fuel_plant_application_for(a, plant)
        and fuel_plant_application_for(a2, plant)
        and fuel_plant_application_quarter_starts(a, q)
        and fuel_plant_application_quarter_starts(a2, q)
        and fuel_plant_application_received_on(a, d)
        and fuel_plant_application_received_on(a2, d2)
        and d2 < d
        and not_known(fuel_plant_application_corrects_or_amends(a, a2));
    then fuel_plant_application_not_first_in_quarter(a);
}
pub relation fuel_plant_application_superseded_by_correction(first: FuelPlantApplication) kind institutional {
    label en official "section 5181(c)(1)(C): a corrected or amended first application has been filed, and the 15-day period commences with its receipt";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, if a corrected or amended first application is filed, such application shall not be considered as a separate application, and the 15-day period referred to in subparagraph (A) shall commence with receipt of the corrected or amended application.")
rule FuelPlantFirstApplicationSupersededByCorrection(first: FuelPlantApplication, corrected: FuelPlantApplication) strict {
    when fuel_plant_application_corrects_or_amends(corrected, first);
    then fuel_plant_application_superseded_by_correction(first);
}
pub relation fuel_plant_application_by(a: FuelPlantApplication, applicant: Person) kind empirical {
    label en official "the person who submitted the application";
}
pub relation fuel_plant_permit_denied_on(a: FuelPlantApplication, on: Date) kind empirical {
    label en official "the date the Secretary determined that a permit should not be issued";
}
pub relation fuel_plant_application_follows_earlier_denial(a: FuelPlantApplication) kind institutional {
    label en official "an earlier application for the same plant was denied before this application";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "(ii) such determination shall not prejudice any further application for such operating permit.")
rule FuelPlantApplicationFollowsEarlierDenial(a: FuelPlantApplication, a0: FuelPlantApplication, plant: DistilledSpiritsPlant, d0: Date, d: Date) strict {
    when fuel_plant_application_for(a, plant)
        and fuel_plant_application_for(a0, plant)
        and fuel_plant_permit_denied_on(a0, d0)
        and fuel_plant_application_received_on(a, d)
        and d > d0;
    then fuel_plant_application_follows_earlier_denial(a);
}
pub relation fuel_plant_application_prejudiced_by_earlier_denial(a: FuelPlantApplication) kind institutional {
    label en official "the earlier denial prejudices the further application (protected against by the immunity of section 5181(c)(2)(C)(ii))";
}
@source(IRC_S5181_C, relation = formalizes, coverage = exact, quote = "(ii) such determination shall not prejudice any further application for such operating permit.")
rule Section5181c2CiiNoPrejudiceImmunityRule(a: FuelPlantApplication, p: Person) strict {
    when fuel_plant_application_follows_earlier_denial(a) and fuel_plant_application_by(a, p);
    then immunity FuelPlantDenialDoesNotPrejudiceFurtherApplication {
        holder p;
        protected_effect fuel_plant_application_prejudiced_by_earlier_denial(a);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 5236: seizure and sale on distraint; application of the proceeds
// =====================================================================

pub relation owner_or_warehouseman_failed_to_transfer_or_to_pay_transfer_expense(plant: DistilledSpiritsPlant) kind empirical {
    label en official "section 5236: the owner or the warehouseman fails to make the required transfer within the time prescribed, or to pay the just and proper expense of the transfer as determined by the Secretary";
}
pub relation secretary_seizes_and_sells_spirits_on_distraint(plant: DistilledSpiritsPlant) kind empirical {
    label en official "section 5236: the Secretary seizes and sells the distilled spirits in the same manner as goods are sold on distraint for taxes";
}
pub relation seizure_and_sale_conditions_met_5236(plant: DistilledSpiritsPlant) kind institutional {
    label en official "section 5236: a transfer was required and the owner or warehouseman failed to make it or to pay its expense";
}
pub relation distraint_sale_authorized(plant: DistilledSpiritsPlant) kind institutional {
    label en official "section 5236: the spirits may be seized and sold by the Secretary in the same manner as goods sold on distraint for taxes";
}
@source(IRC_S5236, relation = formalizes, coverage = exact, quote = "Whenever the owner of such distilled spirits or the warehouseman fails to make such transfer within the time prescribed, or to pay the just and proper expense of such transfer, as ascertained and determined by the Secretary")
rule SeizureAndSaleConditionsMet5236(plant: DistilledSpiritsPlant) strict {
    when storage_transfer_required(plant) and owner_or_warehouseman_failed_to_transfer_or_to_pay_transfer_expense(plant);
    then seizure_and_sale_conditions_met_5236(plant);
}
@source(IRC_S5236, relation = formalizes, coverage = exact, quote = "such distilled spirits may be seized and sold by the Secretary in the same manner as goods are sold on distraint for taxes")
rule Section5236SeizureAndSalePowerRule(plant: DistilledSpiritsPlant) strict {
    when secretary_seizes_and_sells_spirits_on_distraint(plant);
    then power Section5236SeizureAndSale {
        holder us.irc.core::Secretary;
        over plant;
        exercise secretary_seizes_and_sells_spirits_on_distraint(plant);
        valid_when seizure_and_sale_conditions_met_5236(plant);
        effect create(distraint_sale_authorized(plant));
        window [-infinity, infinity];
    };
}
pub relation distraint_sale_proceeds(plant: DistilledSpiritsPlant, proceeds: Money) kind empirical {
    label en official "the proceeds of the sale on distraint";
}
pub relation taxes_due_on_distrained_spirits(plant: DistilledSpiritsPlant, tax: Money) kind empirical {
    label en official "the taxes due on the distilled spirits sold";
}
pub relation cost_and_expenses_of_sale_and_removal(plant: DistilledSpiritsPlant, costs: Money) kind empirical {
    label en official "the cost and expenses of the sale and removal";
}
pub relation proceeds_applied_to_taxes(plant: DistilledSpiritsPlant, amount: Money) kind institutional {
    label en official "section 5236: the proceeds are applied first to the payment of the taxes due on the spirits";
}
pub relation proceeds_applied_to_cost_and_expenses(plant: DistilledSpiritsPlant, amount: Money) kind institutional {
    label en official "section 5236: then to the cost and expenses of the sale and removal";
}
pub relation balance_paid_over_to_owner(plant: DistilledSpiritsPlant, amount: Money) kind institutional {
    label en official "section 5236: the balance is paid over to the owner of the distilled spirits";
}
@source(IRC_S5236, relation = formalizes, coverage = exact, quote = "the proceeds of such sale shall be applied to the payment of the taxes due thereon and the cost and expenses of such sale and removal, and the balance paid over to the owner of such distilled spirits.")
rule ProceedsAppliedToTaxesFirst(plant: DistilledSpiritsPlant, proceeds: Money, tax: Money) strict {
    when distraint_sale_authorized(plant) and distraint_sale_proceeds(plant, proceeds) and taxes_due_on_distrained_spirits(plant, tax);
    then proceeds_applied_to_taxes(plant, min(proceeds, tax));
}
@source(IRC_S5236, relation = formalizes, coverage = exact, quote = "the proceeds of such sale shall be applied to the payment of the taxes due thereon and the cost and expenses of such sale and removal, and the balance paid over to the owner of such distilled spirits.")
rule ProceedsAppliedToCostAndExpensesSecond(plant: DistilledSpiritsPlant, proceeds: Money, tax: Money, costs: Money) strict {
    when distraint_sale_authorized(plant) and distraint_sale_proceeds(plant, proceeds) and taxes_due_on_distrained_spirits(plant, tax) and cost_and_expenses_of_sale_and_removal(plant, costs);
    then proceeds_applied_to_cost_and_expenses(plant, min(costs, max(0.00 USD, proceeds - tax)));
}
@source(IRC_S5236, relation = formalizes, coverage = exact, quote = "and the balance paid over to the owner of such distilled spirits.")
rule BalancePaidOverToOwner(plant: DistilledSpiritsPlant, proceeds: Money, tax: Money, costs: Money) strict {
    when distraint_sale_authorized(plant) and distraint_sale_proceeds(plant, proceeds) and taxes_due_on_distrained_spirits(plant, tax) and cost_and_expenses_of_sale_and_removal(plant, costs);
    then balance_paid_over_to_owner(plant, max(0.00 USD, proceeds - tax - costs));
}

// =====================================================================
// Section 5373(b)(3): credit of the proprietor with wine spirits used, transferred, taxpaid or lost
// =====================================================================

pub enum WineSpiritsDisposition {
    UsedInWineProduction;
    TransferredToBondedPremises;
    Taxpaid;
    LostInTransitOrOnCellarPremises;
    UsedInProductionInViolationOfRequirements;
}
pub entity WineSpiritsWithdrawalItem;
pub relation wine_spirits_disposition_item(proprietor: Person, item: WineSpiritsWithdrawalItem, kind: WineSpiritsDisposition, proof_gallons: Decimal) kind empirical {
    label en official "section 5373(b): wine spirits withdrawn without payment of tax, and what became of the given quantity";
}
pub relation loss_allowable_under_5008a(item: WineSpiritsWithdrawalItem) kind empirical {
    label en official "section 5373(b)(3): the loss in transit or on the bonded wine cellar premises is allowable under section 5008(a)";
}
external judgment relation secretary_satisfied_wine_spirits_not_knowingly_used_in_violation(item: WineSpiritsWithdrawalItem) {
    authority Secretary;
    label en official "section 5373(b)(3): the proprietor satisfactorily shows that such wine spirits were not knowingly used in violation of law (DECISION-0194)";
}
pub relation wine_spirits_creditable_item(item: WineSpiritsWithdrawalItem) kind institutional {
    label en official "section 5373(b)(3): the quantity is one the Secretary credits to the proprietor";
}
rule WineSpiritsUsedItemCreditable(p: Person, i: WineSpiritsWithdrawalItem, g: Decimal) strict {
    when wine_spirits_disposition_item(p, i, UsedInWineProduction, g);
    then wine_spirits_creditable_item(i);
}
rule WineSpiritsTransferredItemCreditable(p: Person, i: WineSpiritsWithdrawalItem, g: Decimal) strict {
    when wine_spirits_disposition_item(p, i, TransferredToBondedPremises, g);
    then wine_spirits_creditable_item(i);
}
rule WineSpiritsTaxpaidItemCreditable(p: Person, i: WineSpiritsWithdrawalItem, g: Decimal) strict {
    when wine_spirits_disposition_item(p, i, Taxpaid, g);
    then wine_spirits_creditable_item(i);
}
rule WineSpiritsLostItemCreditable(p: Person, i: WineSpiritsWithdrawalItem, g: Decimal) strict {
    when wine_spirits_disposition_item(p, i, LostInTransitOrOnCellarPremises, g) and loss_allowable_under_5008a(i);
    then wine_spirits_creditable_item(i);
}
rule WineSpiritsViolationItemCreditableWhenNotKnowing(p: Person, i: WineSpiritsWithdrawalItem, g: Decimal) strict {
    when wine_spirits_disposition_item(p, i, UsedInProductionInViolationOfRequirements, g) and secretary_satisfied_wine_spirits_not_knowingly_used_in_violation(i);
    then wine_spirits_creditable_item(i);
}
pub relation wine_spirits_credit_proof_gallons(proprietor: Person, credit: Decimal) kind institutional {
    label en official "section 5373(b)(3): the quantity of wine spirits the Secretary credits to the proprietor: used, transferred, taxpaid, lost as allowed, and used in violation but not knowingly";
}
@source(IRC_S5373_B, relation = formalizes, coverage = exact, quote = "(3) On such use, transfer, or taxpayment, the Secretary shall credit the proprietor with the amount of wine spirits so used or transferred or taxpaid")
rule WineSpiritsCreditProofGallons(p: Person, i: WineSpiritsWithdrawalItem, k: WineSpiritsDisposition, g: Decimal) strict {
    when wine_spirits_disposition_item(p, i, k, g);
    then wine_spirits_credit_proof_gallons(p,
        sum(collect all q: Decimal, j: WineSpiritsWithdrawalItem, kj: WineSpiritsDisposition where wine_spirits_disposition_item(p, j, kj, q) and wine_spirits_creditable_item(j), empty: 0.0));
}
pub relation secretary_credited_proprietor_with_wine_spirits(p: Person) kind empirical {
    label en official "the Secretary has credited the proprietor with the quantity of wine spirits";
}
@source(IRC_S5373_B, relation = formalizes, coverage = exact, quote = "the Secretary shall credit the proprietor with the amount of wine spirits so used or transferred or taxpaid")
rule Section5373b3CreditDutyRule(p: Person, credit: Decimal) strict {
    when wine_spirits_credit_proof_gallons(p, credit) and credit > 0.0;
    then duty Section5373b3CreditDuty {
        bearer us.irc.core::Secretary;
        beneficiary p;
        goal achievement {
            condition secretary_credited_proprietor_with_wine_spirits(p);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 5384(b): ameliorated fruit and berry wines
// =====================================================================

pub enum FruitWineKind { AppleWine; OtherFruitOrBerryWine; }
pub relation lot_fruit_wine_kind(l: AlcoholicLot, kind: FruitWineKind, fruit: Text) kind empirical {
    label en official "section 5384(b): whether the wine is apple wine and the kind of fruit or berry it is made from (ameliorating material accounts are separate for each different kind of fruit)";
}
pub relation lot_is_winemakers_own_production_and_not_made_under_5384a(l: AlcoholicLot) kind empirical {
    label en official "section 5384(b)(1): the wine is of the winemaker's own production and is not made under subsection (a)";
}
pub relation lot_is_natural_fruit_or_berry_wine_other_than_grape(l: AlcoholicLot) kind institutional {
    label en official "section 5384(b)(1): a natural fruit or berry wine (other than grape wine)";
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "(1) Any natural fruit or berry wine (other than grape wine) of a winemaker's own production may, if not made under subsection (a) of this section, be ameliorated to correct high acid content.")
rule FruitWineMayBeAmeliorated5384b1(l: AlcoholicLot) strict {
    when lot_is_natural_wine_from_fruit_other_than_grapes(l) and lot_is_winemakers_own_production_and_not_made_under_5384a(l);
    then lot_is_natural_fruit_or_berry_wine_other_than_grape(l);
}
pub relation ameliorating_material_accounted_separately_per_fruit_kind(l: AlcoholicLot) kind empirical {
    label en official "section 5384(b)(1): ameliorating material calculations and accounting are kept separate for wines made from each different kind of fruit";
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "Ameliorating material calculations and accounting shall be separate for wines made from each different kind of fruit.")
rule SeparateAmelioratingAccountsDutyRule(l: AlcoholicLot) strict {
    when lot_is_natural_fruit_or_berry_wine_other_than_grape(l);
    then duty SeparateAmelioratingMaterialAccountsPerFruitKind {
        bearer us.irc.core::Secretary;
        goal maintenance {
            condition ameliorating_material_accounted_separately_per_fruit_kind(l);
            window [-infinity, infinity];
        }
    };
}
pub relation natural_fixed_acid_after_correction_parts_per_thousand(l: AlcoholicLot, ppt: Decimal) kind empirical {
    label en official "section 5384(b)(2): the natural fixed acid in the corrected juice or wine, in parts per thousand";
}
pub relation sugar_used_quantity(l: AlcoholicLot, quantity: Decimal) kind empirical {
    label en official "the quantity of pure dry sugar or liquid sugar used";
}
pub relation sugar_quantity_to_adjust_juice_to_25_brix(l: AlcoholicLot, quantity: Decimal) kind empirical {
    label en official "section 5384(b)(2): the quantity of sugar which would have been required to adjust the juice, prior to fermentation, to a total solids content of 25 degrees (Brix) (a laboratory computation supplied by the case)";
}
pub relation sugar_added_on(l: AlcoholicLot, on: Date) kind empirical {
    label en official "the date the sugar was added";
}
pub relation fermentation_completed_on(l: AlcoholicLot, on: Date) kind empirical {
    label en official "the date the fermentation of the wine was completed";
}
pub relation lot_total_solids_percent_by_weight_5384b(l: AlcoholicLot, percent: Decimal) kind empirical {
    label en official "section 5384(b)(2)(C): the total solids content of the wine by weight, whether or not wine spirits have been added";
}
pub relation liquid_sugar_water_volume(l: AlcoholicLot, volume: Decimal) kind empirical {
    label en official "section 5384(b)(2)(B): the volume of water contained in the liquid sugar used";
}
pub relation authorized_ameliorating_material_volume(l: AlcoholicLot, volume: Decimal) kind empirical {
    label en official "section 5383(b), 5384(b)(2)(D): the volume of ameliorating material authorized (35 or 60 percent of the volume)";
}
pub relation sugar_amelioration_within_acid_limit(l: AlcoholicLot) kind institutional {
    label en official "section 5384(b)(2): the sugar does not reduce the natural fixed acid in the corrected juice or wine to five parts per thousand";
}
pub relation sugar_amelioration_within_quantity_limit(l: AlcoholicLot) kind institutional {
    label en official "section 5384(b)(2): the quantity of sugar does not exceed the quantity required to adjust the juice, prior to fermentation, to 25 degrees Brix";
}
pub relation sugar_added_before_completion_of_fermentation(l: AlcoholicLot) kind institutional {
    label en official "section 5384(b)(2): the sugar was added prior to the completion of fermentation";
}
pub relation fruit_wine_solids_within_21_percent(l: AlcoholicLot) kind institutional {
    label en official "section 5384(b)(2)(C): the wine has a total solids content of not more than 21 percent by weight";
}
pub relation fruit_wine_amelioration_lawful_5384b(l: AlcoholicLot) kind institutional {
    label en official "section 5384(b): the amelioration of the natural fruit or berry wine is within the acid, quantity, timing and solids limits";
}
pub relation authorized_ameliorating_volume_after_water_deduction(l: AlcoholicLot, volume: Decimal) kind institutional {
    label en official "section 5384(b)(2)(B): the volume of ameliorating material authorized, less the water contained in liquid sugar";
}
pub relation natural_fixed_acid_calculated_as(l: AlcoholicLot, acid: Text) kind institutional {
    label en official "section 5384(b)(2)(A): natural fixed acid is calculated as malic acid for apple wine and as citric acid for other fruit and berry wines, instead of tartaric acid";
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "(A) Natural fixed acid shall be calculated as malic acid for apple wine and as citric acid for other fruit and berry wines, instead of tartaric acid;")
rule AcidCalculatedAsMalicForAppleWine(l: AlcoholicLot, f: Text) strict {
    when lot_fruit_wine_kind(l, AppleWine, f);
    then natural_fixed_acid_calculated_as(l, "malic");
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "(A) Natural fixed acid shall be calculated as malic acid for apple wine and as citric acid for other fruit and berry wines, instead of tartaric acid;")
rule AcidCalculatedAsCitricForOtherFruitWine(l: AlcoholicLot, f: Text) strict {
    when lot_fruit_wine_kind(l, OtherFruitOrBerryWine, f);
    then natural_fixed_acid_calculated_as(l, "citric");
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "but not to such an extent as would reduce the natural fixed acid in the corrected juice or wine to five parts per thousand.")
rule SugarAmeliorationWithinAcidLimit(l: AlcoholicLot, ppt: Decimal) strict {
    when natural_fixed_acid_after_correction_parts_per_thousand(l, ppt) and ppt > 5.0;
    then sugar_amelioration_within_acid_limit(l);
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "The quantity of sugar so used shall not exceed the quantity which would have been required to adjust the juice, prior to fermentation, to a total solids content of 25 degrees (Brix).")
rule SugarAmeliorationWithinQuantityLimit(l: AlcoholicLot, used: Decimal, allowed: Decimal) strict {
    when sugar_used_quantity(l, used) and sugar_quantity_to_adjust_juice_to_25_brix(l, allowed) and used <= allowed;
    then sugar_amelioration_within_quantity_limit(l);
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "Such sugar shall be added prior to the completion of fermentation of the wine.")
rule SugarAddedBeforeFermentationCompleted(l: AlcoholicLot, added: Date, done: Date) strict {
    when sugar_added_on(l, added) and fermentation_completed_on(l, done) and added < done;
    then sugar_added_before_completion_of_fermentation(l);
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "(C) Wines made under this subsection shall have a total solids content of not more than 21 percent by weight, whether or not wine spirits have been added; and")
rule FruitWineSolidsWithin21Percent(l: AlcoholicLot, pct: Decimal) strict {
    when lot_total_solids_percent_by_weight_5384b(l, pct) and pct <= 21.0;
    then fruit_wine_solids_within_21_percent(l);
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "(B) Juice adjusted with pure dry sugar or liquid sugar as provided in this paragraph shall be treated in the same manner as original natural juice under the provisions of section 5383(b); except that if liquid sugar is used, the volume of water contained therein must be deducted from the volume of ameliorating material authorized;")
rule AuthorizedAmelioratingVolumeAfterWaterDeduction(l: AlcoholicLot, authorized: Decimal, water: Decimal) strict {
    when authorized_ameliorating_material_volume(l, authorized) and liquid_sugar_water_volume(l, water) and authorized >= water;
    then authorized_ameliorating_volume_after_water_deduction(l, authorized - water);
}
@source(IRC_S5384_B, relation = formalizes, coverage = exact, quote = "(2) Pure dry sugar or liquid sugar may be used in the production of wines under this subsection for the purpose of correcting natural deficiencies, but not to such an extent as would reduce the natural fixed acid in the corrected juice or wine to five parts per thousand.")
rule FruitWineAmeliorationLawful(l: AlcoholicLot) strict {
    when lot_is_natural_fruit_or_berry_wine_other_than_grape(l)
        and sugar_amelioration_within_acid_limit(l)
        and sugar_amelioration_within_quantity_limit(l)
        and sugar_added_before_completion_of_fermentation(l)
        and fruit_wine_solids_within_21_percent(l);
    then fruit_wine_amelioration_lawful_5384b(l);
}

// =====================================================================
// Section 5555(b): the Secretary's authority to waive record, statement and return requirements
// =====================================================================

external judgment relation secretary_deems_requirement_no_longer_serves_necessary_purpose(p: Person) {
    authority Secretary;
    label en official "section 5555(b): the Secretary deems the record, statement, or return requirement to no longer serve a necessary purpose (DECISION-0194)";
}
pub relation secretary_waives_records_requirement_by_regulation(p: Person) kind empirical {
    label en official "section 5555(b): the Secretary by regulation waives, in whole or in part, the requirement to keep records, render statements or make returns for the person";
}
pub relation waiver_purports_to_waive_payment_of_tax(p: Person) kind empirical {
    label en official "section 5555(b) last sentence: the waiver would waive the payment of a tax";
}
pub relation records_waiver_conditions_met(p: Person) kind institutional {
    label en official "section 5555(b): the Secretary deems the requirement no longer necessary and the waiver does not waive payment of any tax";
}
pub relation records_requirement_waived(p: Person) kind institutional {
    label en official "section 5555(b): the requirement to keep records, render statements or make returns is waived for the person";
}
@source(IRC_S5555_B, relation = formalizes, coverage = exact, quote = "This subsection shall not be construed as authorizing the waiver of the payment of any tax.")
rule RecordsWaiverConditionsMet(p: Person) strict {
    when secretary_deems_requirement_no_longer_serves_necessary_purpose(p) and not_known(waiver_purports_to_waive_payment_of_tax(p));
    then records_waiver_conditions_met(p);
}
@source(IRC_S5555_B, relation = formalizes, coverage = exact, quote = "the Secretary may by regulation waive, in whole or in part, such requirement when he deems such requirement to no longer serve a necessary purpose.")
rule Section5555bWaiverPowerRule(p: Person) strict {
    when secretary_waives_records_requirement_by_regulation(p);
    then power Section5555bWaiverOfRecordsRequirement {
        holder us.irc.core::Secretary;
        over p;
        exercise secretary_waives_records_requirement_by_regulation(p);
        valid_when records_waiver_conditions_met(p);
        effect create(records_requirement_waived(p));
        window [-infinity, infinity];
    };
}
// The duty of section 5555(a) (Section5555aRecordsDutyRule, module 09) now reads `records_requirement_waived` (stage 3 edit).

// =====================================================================
// Section 5601(a): offense elements (1), (3)-(15) and the maximum punishment
// =====================================================================

pub entity DistillingApparatus;
pub enum ProhibitedDistillingPremises { DwellingHouse; ShedOrYardConnectedToDwelling; VesselOrBoat; BeerOrWineProductionPremises; LiquorRetailPremises; PremisesOfAnotherBusiness; }

pub relation has_still_set_up_in_possession_or_control(p: Person, still: DistillingApparatus) kind empirical {
    label en official "section 5601(a)(1): the person has in his possession or custody, or under his control, a still or distilling apparatus set up";
}
pub relation still_registered_under_5179a(still: DistillingApparatus) kind empirical {
    label en official "the still is registered as section 5179(a) requires";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "has in his possession or custody, or under his control, any still or distilling apparatus set up which is not registered, as required by section 5179(a); or")
rule Section5601a1UnregisteredStillOffenseRule(p: Person, still: DistillingApparatus) defeasible {
    when has_still_set_up_in_possession_or_control(p, still);
    unless still_registered_under_5179a(still) and has_still_set_up_in_possession_or_control(p, still);
    then section_5601a_offense(p, "5601(a)(1)");
}
pub relation engages_or_intends_to_engage_in_distiller_warehouseman_or_processor_business(p: Person) kind empirical {
    label en official "the person engages, or intends to engage, in the business of distiller, warehouseman, or processor of distilled spirits";
}
pub relation application_under_5171_known_false_or_fraudulent(p: Person) kind empirical {
    label en official "section 5601(a)(3): the application filed under section 5171 is false or fraudulent (a finding of the court; asserted with origin adjudicated, DECISION-0194)";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "engages, or intends to engage, in the business of distiller, warehouseman, or processor of distilled spirits, and files a false or fraudulent application under section 5171; or")
rule Section5601a3FalseApplicationOffenseRule(p: Person) strict {
    when engages_or_intends_to_engage_in_distiller_warehouseman_or_processor_business(p) and application_under_5171_known_false_or_fraudulent(p);
    then section_5601a_offense(p, "5601(a)(3)");
}
pub relation carries_on_business_of_distiller_warehouseman_or_processor(p: Person) kind empirical {
    label en official "section 5601(a)(4): the person carries on the business of a distiller, warehouseman, or processor";
}
pub relation bond_given_as_required_by_law(p: Person) kind empirical {
    label en official "the person has given the bond required by law";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "carries on the business of a distiller, warehouseman, or processor without having given bond as required by law; or")
rule Section5601a4NoBondOffenseRule(p: Person) defeasible {
    when carries_on_business_of_distiller_warehouseman_or_processor(p);
    unless bond_given_as_required_by_law(p) and carries_on_business_of_distiller_warehouseman_or_processor(p);
    then section_5601a_offense(p, "5601(a)(4)");
}
pub relation bond_given_under_subchapter_b_false_forged_or_fraudulent(p: Person) kind empirical {
    label en official "section 5601(a)(5): the person gives a false, forged, or fraudulent bond under subchapter B (a finding of the court, origin adjudicated)";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "engages, or intends to engage, in the business of distiller, warehouseman, or processor of distilled spirits, and gives any false, forged, or fraudulent bond, under subchapter B; or")
rule Section5601a5FalseBondOffenseRule(p: Person) strict {
    when engages_or_intends_to_engage_in_distiller_warehouseman_or_processor_business(p) and bond_given_under_subchapter_b_false_forged_or_fraudulent(p);
    then section_5601a_offense(p, "5601(a)(5)");
}
pub relation uses_or_possesses_utensil_to_produce_spirits_on_premises(p: Person, premises: ProhibitedDistillingPremises) kind empirical {
    label en official "section 5601(a)(6): the person uses, or possesses with intent to use, any still, boiler, or other utensil to produce distilled spirits (or aids, assists, causes or procures it) on the kind of premises";
}
pub relation distilling_authorized_under_5178_on_premises(p: Person, premises: ProhibitedDistillingPremises) kind empirical {
    label en official "the distilling is authorized under section 5178(a)(1)(C) (shed, yard or enclosure) or section 5178(b) (premises of another business)";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "uses, or possesses with intent to use, any still, boiler, or other utensil for the purpose of producing distilled spirits, or aids or assists therein, or causes or procures the same to be done, in any dwelling house")
rule Section5601a6DistillingOnProhibitedPremisesOffenseRule(p: Person, pr: ProhibitedDistillingPremises) defeasible {
    when uses_or_possesses_utensil_to_produce_spirits_on_premises(p, pr);
    unless distilling_authorized_under_5178_on_premises(p, pr) and uses_or_possesses_utensil_to_produce_spirits_on_premises(p, pr);
    then section_5601a_offense(p, "5601(a)(6)");
}
pub relation makes_or_ferments_mash_wort_or_wash_fit_for_distillation_outside_qualified_plant(p: Person) kind empirical {
    label en official "section 5601(a)(7): the person makes or ferments mash, wort, or wash fit for distillation in a building or on premises other than the designated premises of a qualified distilled spirits plant";
}
pub relation removes_mash_wort_or_wash_without_authorization_before_distillation(p: Person) kind empirical {
    label en official "section 5601(a)(7): the person removes, without authorization by the Secretary, mash, wort, or wash from the designated premises of a qualified plant before it is distilled";
}
pub relation mash_activity_otherwise_provided_in_chapter_51(p: Person) kind empirical {
    label en official "section 5601(a)(7), (9): the chapter otherwise provides for the activity";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "except as otherwise provided in this chapter, makes or ferments mash, wort, or wash, fit for distillation or for the production of distilled spirits, in any building or on any premises other than the designated premises of a distilled spirits plant lawfully qualified to produce distilled spirits")
rule Section5601a7MakesMashOffenseRule(p: Person) defeasible {
    when makes_or_ferments_mash_wort_or_wash_fit_for_distillation_outside_qualified_plant(p);
    unless mash_activity_otherwise_provided_in_chapter_51(p) and makes_or_ferments_mash_wort_or_wash_fit_for_distillation_outside_qualified_plant(p);
    then section_5601a_offense(p, "5601(a)(7)");
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "or removes, without authorization by the Secretary, any mash, wort, or wash, so made or fermented, from the designated premises of such lawfully qualified plant before being distilled; or")
rule Section5601a7RemovesMashOffenseRule(p: Person) strict {
    when removes_mash_wort_or_wash_without_authorization_before_distillation(p);
    then section_5601a_offense(p, "5601(a)(7)");
}
pub relation produces_distilled_spirits_by_distillation_or_other_process(p: Person) kind empirical {
    label en official "section 5601(a)(8): the person produces distilled spirits by distillation or any other process from any mash, wort, wash, or other material";
}
pub relation authorized_by_law_to_produce_distilled_spirits(p: Person) kind empirical {
    label en official "the person is a distiller authorized by law to produce distilled spirits";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "not being a distiller authorized by law to produce distilled spirits, produces distilled spirits by distillation or any other process from any mash, wort, wash, or other material; or")
rule Section5601a8UnauthorizedProductionOffenseRule(p: Person) defeasible {
    when produces_distilled_spirits_by_distillation_or_other_process(p);
    unless authorized_by_law_to_produce_distilled_spirits(p) and produces_distilled_spirits_by_distillation_or_other_process(p);
    then section_5601a_offense(p, "5601(a)(8)");
}
pub relation uses_distilled_spirits_in_manufacturing_process(p: Person) kind empirical {
    label en official "section 5601(a)(9): the person uses distilled spirits in any process of manufacture";
}
pub relation spirits_produced_in_united_states_by_authorized_distiller_and_withdrawn_in_compliance(p: Person) kind empirical {
    label en official "section 5601(a)(9)(A): the spirits were produced in the United States by a distiller authorized by law and withdrawn in compliance with law";
}
pub relation spirits_imported_and_withdrawn_in_compliance_with_law(p: Person) kind empirical {
    label en official "section 5601(a)(9)(B): the spirits were imported (or otherwise brought into the United States) and withdrawn in compliance with law";
}
pub relation spirits_used_in_manufacture_lawfully_sourced(p: Person) kind institutional {
    label en official "section 5601(a)(9)(A) or (B): the spirits used in manufacture were lawfully produced and withdrawn, or lawfully imported and withdrawn";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "(A) have been produced in the United States by a distiller authorized by law to produce distilled spirits and withdrawn in compliance with law; or")
rule SpiritsLawfullySourcedDomestic(p: Person) strict {
    when spirits_produced_in_united_states_by_authorized_distiller_and_withdrawn_in_compliance(p);
    then spirits_used_in_manufacture_lawfully_sourced(p);
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "(B) have been imported (or otherwise brought into the United States) and withdrawn in compliance with law; or")
rule SpiritsLawfullySourcedImported(p: Person) strict {
    when spirits_imported_and_withdrawn_in_compliance_with_law(p);
    then spirits_used_in_manufacture_lawfully_sourced(p);
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "except as otherwise provided in this chapter, uses distilled spirits in any process of manufacture unless such spirits—")
rule Section5601a9UnauthorizedUseInManufactureOffenseRule(p: Person) defeasible {
    when uses_distilled_spirits_in_manufacturing_process(p);
    unless spirits_used_in_manufacture_lawfully_sourced(p) and uses_distilled_spirits_in_manufacturing_process(p);
    unless mash_activity_otherwise_provided_in_chapter_51(p) and uses_distilled_spirits_in_manufacturing_process(p);
    then section_5601a_offense(p, "5601(a)(9)");
}
pub relation carries_on_business_of_a_processor(p: Person) kind empirical {
    label en official "section 5601(a)(10): the person engages in or carries on the business of a processor";
}
pub relation processor_intends_to_defraud_united_states_of_tax(p: Person) kind empirical {
    label en official "section 5601(a)(10)(A): the processor acts with intent to defraud the United States of any tax on the distilled spirits processed (intent: a finding of the court, origin adjudicated)";
}
pub relation processor_intends_to_aid_others_in_defrauding_united_states_of_tax(p: Person) kind empirical {
    label en official "section 5601(a)(10)(B): the processor acts with intent to aid, abet, or assist any person in defrauding the United States of the tax on any distilled spirits (origin adjudicated)";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "(A) with intent to defraud the United States of any tax on the distilled spirits processed by him; or")
rule Section5601a10AProcessorDefraudOffenseRule(p: Person) strict {
    when carries_on_business_of_a_processor(p) and processor_intends_to_defraud_united_states_of_tax(p);
    then section_5601a_offense(p, "5601(a)(10)");
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "(B) with intent to aid, abet, or assist any person or persons in defrauding the United States of the tax on any distilled spirits; or")
rule Section5601a10BProcessorAidDefraudOffenseRule(p: Person) strict {
    when carries_on_business_of_a_processor(p) and processor_intends_to_aid_others_in_defrauding_united_states_of_tax(p);
    then section_5601a_offense(p, "5601(a)(10)");
}
pub relation purchases_receives_or_processes_distilled_spirits(p: Person) kind empirical {
    label en official "section 5601(a)(11): the person purchases, receives, or processes distilled spirits";
}
pub relation knew_or_had_reasonable_grounds_to_believe_tax_unpaid(p: Person) kind empirical {
    label en official "section 5601(a)(11): the person knew or had reasonable grounds to believe that the tax due on the spirits had not been paid or determined as required by law (knowledge: a finding of the court, origin adjudicated)";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "purchases, receives, or processes any distilled spirits, knowing or having reasonable grounds to believe that any tax due on such spirits has not been paid or determined as required by law; or")
rule Section5601a11KnowingPurchaseOffenseRule(p: Person) strict {
    when purchases_receives_or_processes_distilled_spirits(p) and knew_or_had_reasonable_grounds_to_believe_tax_unpaid(p);
    then section_5601a_offense(p, "5601(a)(11)");
}
pub relation removes_untaxed_spirits_from_place_of_manufacture_or_storage_or_transport(p: Person) kind empirical {
    label en official "section 5601(a)(12): the person removes distilled spirits on which the tax has not been paid or determined from the place of manufacture or storage, or from any instrument of transportation";
}
pub relation conceals_spirits_so_removed(p: Person) kind empirical {
    label en official "section 5601(a)(12): the person conceals spirits so removed";
}
pub relation removal_authorized_by_law(p: Person) kind empirical {
    label en official "the removal is authorized by law";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "removes, other than as authorized by law, any distilled spirits on which the tax has not been paid or determined, from the place of manufacture or storage, or from any instrument of transportation, or conceals spirits so removed; or")
rule Section5601a12RemovalOffenseRule(p: Person) defeasible {
    when removes_untaxed_spirits_from_place_of_manufacture_or_storage_or_transport(p);
    unless removal_authorized_by_law(p) and removes_untaxed_spirits_from_place_of_manufacture_or_storage_or_transport(p);
    then section_5601a_offense(p, "5601(a)(12)");
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "or conceals spirits so removed; or")
rule Section5601a12ConcealmentOffenseRule(p: Person) strict {
    when conceals_spirits_so_removed(p);
    then section_5601a_offense(p, "5601(a)(12)");
}
pub relation adds_unauthorized_ingredient_to_spirits_before_tax_determined(p: Person) kind empirical {
    label en official "section 5601(a)(13): the person adds, or causes to be added, an ingredient or substance not authorized by law to distilled spirits before the tax is paid or determined";
}
pub relation purpose_of_creating_fictitious_proof(p: Person) kind empirical {
    label en official "section 5601(a)(13): the addition is for the purpose of creating fictitious proof (purpose: a finding of the court, origin adjudicated)";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "adds, or causes to be added, any ingredient or substance (other than ingredients or substances authorized by law to be added) to any distilled spirits before the tax is paid thereon, or determined as provided by law, for the purpose of creating fictitious proof; or")
rule Section5601a13FictitiousProofOffenseRule(p: Person) strict {
    when adds_unauthorized_ingredient_to_spirits_before_tax_determined(p) and purpose_of_creating_fictitious_proof(p);
    then section_5601a_offense(p, "5601(a)(13)");
}
pub relation carries_on_distiller_business_on_premises_after_time_fixed_in_suspension_notice(p: Person) kind empirical {
    label en official "section 5601(a)(14): after the time fixed in the notice given under section 5221(a) to suspend operations, the person carries on the business of a distiller on the premises covered by the notice";
}
pub relation has_mash_wort_or_beer_on_premises_covered_by_suspension_notice(p: Person) kind empirical {
    label en official "section 5601(a)(14): after that time the person has mash, wort, or beer on the premises, or on any premises connected therewith";
}
pub relation possesses_mash_wort_or_beer_with_intent_to_distill_on_premises(p: Person) kind empirical {
    label en official "section 5601(a)(14): after that time the person has in his possession or control any mash, wort, or beer with intent to distill it on the premises";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "after the time fixed in the notice given under section 5221(a) to suspend operations as a distiller, carries on the business of a distiller on the premises covered by the notice of suspension")
rule Section5601a14CarriesOnBusinessAfterSuspensionOffenseRule(p: Person) strict {
    when carries_on_distiller_business_on_premises_after_time_fixed_in_suspension_notice(p);
    then section_5601a_offense(p, "5601(a)(14)");
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "or has mash, wort, or beer on such premises, or on any premises connected therewith")
rule Section5601a14HasMashAfterSuspensionOffenseRule(p: Person) strict {
    when has_mash_wort_or_beer_on_premises_covered_by_suspension_notice(p);
    then section_5601a_offense(p, "5601(a)(14)");
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "or has in his possession or under his control any mash, wort, or beer, with intent to distill the same on such premises; or")
rule Section5601a14PossessesMashWithIntentOffenseRule(p: Person) strict {
    when possesses_mash_wort_or_beer_with_intent_to_distill_on_premises(p);
    then section_5601a_offense(p, "5601(a)(14)");
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "withdraws, uses, sells, or otherwise disposes of distilled spirits produced under section 5181 for other than fuel use;")
rule Section5601a15NonFuelUseOffenseRule(p: Person, plant: DistilledSpiritsPlant) strict {
    when section_5181_spirits_used_sold_or_disposed_for_other_than_fuel(plant, p);
    then section_5601a_offense(p, "5601(a)(15)");
}
pub relation section_5601a_maximum_punishment(p: Person, paragraph: Text, maximum_fine: Money, maximum_years: Integer) kind institutional {
    label en official "section 5601(a): the offense is punishable by a fine of not more than $10,000, or imprisonment of not more than 5 years, or both, for each offense (the sentence itself is the court's judgment; only the statutory maxima are stated here)";
}
@source(IRC_S5601_A, relation = formalizes, coverage = exact, quote = "shall be fined not more than $10,000, or imprisoned not more than 5 years, or both, for each such offense.")
rule Section5601aMaximumPunishment(p: Person, para: Text) defeasible {
    when section_5601a_offense(p, para);
    then section_5601a_maximum_punishment(p, para, 10000.00 USD, 5);
}

// =====================================================================
// Section 5688: forfeited or seized spirits, wines, and beer
// =====================================================================

const GeneralServicesAdministrator: Organ = entity_ref("urn:us:irc:alcohol:clir#GeneralServicesAdministrator") {
    label en official "the Administrator of General Services";
}
pub entity ForfeitedAlcoholLot;
pub relation alcohol_lot_forfeited(lot: ForfeitedAlcoholLot) kind empirical {
    label en official "section 5688(a): the distilled spirits, wines, and beer are forfeited, summarily or by order of court, under any law of the United States";
}
pub relation alcohol_lot_seized_under_us_law(lot: ForfeitedAlcoholLot) kind empirical {
    label en official "section 5688(a)(3): the distilled spirits, wines, and beer have been seized under any law of the United States";
}
pub relation custodian_of_forfeited_alcohol(p: Person, lot: ForfeitedAlcoholLot) kind empirical {
    label en official "section 5688(a)(1): the person who holds the forfeited spirits, wines, and beer (the text does not name who delivers; INTERPRETATION: the custodian)";
}
pub relation alcohol_lot_delivered_to_administrator_of_general_services(lot: ForfeitedAlcoholLot) kind empirical {
    label en official "the forfeited spirits, wines, and beer were delivered to the Administrator of General Services";
}
@source(IRC_S5688_A, relation = formalizes, coverage = exact, quote = "All distilled spirits, wines, and beer forfeited, summarily or by order of court, under any law of the United States, shall be delivered to the Administrator of General Services")
rule Section5688a1DeliveryDutyRule(p: Person, lot: ForfeitedAlcoholLot) strict {
    when alcohol_lot_forfeited(lot) and custodian_of_forfeited_alcohol(p, lot);
    then duty ForfeitedAlcoholDeliveryToGeneralServicesDuty {
        bearer p;
        beneficiary GeneralServicesAdministrator;
        goal achievement {
            condition alcohol_lot_delivered_to_administrator_of_general_services(lot);
            window [-infinity, infinity];
        }
    };
}
external judgment relation administrator_opines_government_agency_needs_lot(lot: ForfeitedAlcoholLot) {
    authority GeneralServicesAdministrator;
    label en official "section 5688(a)(2)(A): in the opinion of the Administrator, a Government agency has a need for the spirits, wines, or beer for medicinal, scientific, or mechanical purposes (DECISION-0194)";
}
external judgment relation administrator_opines_eleemosynary_institution_needs_lot(lot: ForfeitedAlcoholLot) {
    authority GeneralServicesAdministrator;
    label en official "section 5688(a)(2)(B): in the opinion of the Administrator, an eleemosynary institution has a need for the spirits, wines, or beer for medicinal purposes (DECISION-0194)";
}
pub relation lot_delivered_to_government_agency(lot: ForfeitedAlcoholLot) kind empirical {
    label en official "section 5688(a)(2)(A): the lot was delivered to a Government agency";
}
pub relation lot_given_to_eleemosynary_institution(lot: ForfeitedAlcoholLot) kind empirical {
    label en official "section 5688(a)(2)(B): the lot was given to an eleemosynary institution";
}
pub relation lot_destroyed(lot: ForfeitedAlcoholLot) kind empirical {
    label en official "section 5688(a)(2)(C): the lot was destroyed";
}
pub relation lot_disposed_by_administrator_by_authorized_means(lot: ForfeitedAlcoholLot) kind institutional {
    label en official "section 5688(a)(2): the lot was disposed of by delivery to an agency in need, by gift to an institution in need, or by destruction";
}
@source(IRC_S5688_A, relation = formalizes, coverage = exact, quote = "(A) by delivery to such Government agencies as, in his opinion, have a need for such distilled spirits, wines, or beer for medicinal, scientific, or mechanical purposes, or for any other official purpose for which appropriated funds may be expended by a Government agency; or")
rule LotDisposedByDeliveryToAgencyInNeed(lot: ForfeitedAlcoholLot) strict {
    when lot_delivered_to_government_agency(lot) and administrator_opines_government_agency_needs_lot(lot);
    then lot_disposed_by_administrator_by_authorized_means(lot);
}
@source(IRC_S5688_A, relation = formalizes, coverage = exact, quote = "(B) by gifts to such eleemosynary institutions as, in his opinion, have a need for such distilled spirits, wines, or beer for medicinal purposes; or")
rule LotDisposedByGiftToInstitutionInNeed(lot: ForfeitedAlcoholLot) strict {
    when lot_given_to_eleemosynary_institution(lot) and administrator_opines_eleemosynary_institution_needs_lot(lot);
    then lot_disposed_by_administrator_by_authorized_means(lot);
}
@source(IRC_S5688_A, relation = formalizes, coverage = exact, quote = "(C) by destruction.")
rule LotDisposedByDestruction(lot: ForfeitedAlcoholLot) strict {
    when lot_destroyed(lot);
    then lot_disposed_by_administrator_by_authorized_means(lot);
}
@source(IRC_S5688_A, relation = formalizes, coverage = exact, quote = "The Administrator of General Services shall dispose of all distilled spirits, wines, and beer which have been delivered to him pursuant to paragraph (1)")
rule Section5688a2DisposalDutyRule(lot: ForfeitedAlcoholLot) strict {
    when alcohol_lot_delivered_to_administrator_of_general_services(lot);
    then duty AdministratorDisposesOfForfeitedAlcoholDuty {
        bearer GeneralServicesAdministrator;
        goal achievement {
            condition lot_disposed_by_administrator_by_authorized_means(lot);
            window [-infinity, infinity];
        }
    };
}
pub relation disposes_of_seized_alcohol(p: Person, lot: ForfeitedAlcoholLot) kind empirical {
    label en official "section 5688(a)(3): the person disposes of distilled spirits, wines, or beer seized under a law of the United States";
}
pub relation disposal_of_seized_alcohol_otherwise_provided_by_law(lot: ForfeitedAlcoholLot) kind empirical {
    label en official "section 5688(a)(3): the disposal is otherwise provided by law";
}
@source(IRC_S5688_A, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by law, no distilled spirits, wines, or beer which have been seized under any law of the United States may be disposed of")
rule Section5688a3NoDisposalBeforeForfeitureRule(p: Person, lot: ForfeitedAlcoholLot) defeasible {
    when alcohol_lot_seized_under_us_law(lot) and disposes_of_seized_alcohol(p, lot);
    unless alcohol_lot_forfeited(lot) and alcohol_lot_seized_under_us_law(lot) and disposes_of_seized_alcohol(p, lot);
    unless disposal_of_seized_alcohol_otherwise_provided_by_law(lot) and alcohol_lot_seized_under_us_law(lot) and disposes_of_seized_alcohol(p, lot);
    then prohibition SeizedAlcoholNotDisposedOfBeforeForfeiture {
        bearer p;
        action disposes_of_seized_alcohol(p, lot);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 5505(c)-(j): the provisions applicable to plants established under the vinegar part
// =====================================================================

pub relation provision_applicable_to_vinegar_plants(provision: Text) kind institutional {
    label en official "section 5505(c)-(i): the named provision of chapter 51 is applicable to plants established under the vinegar part (part I of subchapter G)";
}
pub relation chapter_51_provision_not_applicable_to_vinegar_plants(provision: Text) kind institutional {
    label en official "section 5505(j): chapter 51 other than the vinegar part and the provisions named in subsections (a)-(i) is not applicable to vinegar plants";
}
pub relation vinegar_plant_operator(p: Person) kind empirical {
    label en official "the person operates a plant established under the vinegar part";
}
@source(IRC_S5505_C, relation = formalizes, coverage = exact, quote = "The provisions of section 5203(b), (c), and (d), relating to right of entry and examination, furnishing facilities and assistance, and authority to break up grounds or walls, shall be applicable to all premises established under this part")
rule VinegarPlants5203Applicable(p: Person) strict {
    when vinegar_plant_operator(p);
    then provision_applicable_to_vinegar_plants("5203(b)-(d)");
}
@source(IRC_S5505_D, relation = formalizes, coverage = exact, quote = "Stills on the premises of plants established under this part shall be registered as provided in section 5179.")
rule VinegarPlants5179Applicable(p: Person) strict {
    when vinegar_plant_operator(p);
    then provision_applicable_to_vinegar_plants("5179");
}
@source(IRC_S5505_E, relation = formalizes, coverage = exact, quote = "The provisions of section 5552 relating to the installation of meters, tanks, and other apparatus shall be applicable to plants established under this part.")
rule VinegarPlants5552Applicable(p: Person) strict {
    when vinegar_plant_operator(p);
    then provision_applicable_to_vinegar_plants("5552");
}
@source(IRC_S5505_F, relation = formalizes, coverage = exact, quote = "The provisions of section 5553(a) relating to the assignment of internal revenue officers shall be applicable to plants established under this part.")
rule VinegarPlants5553aApplicable(p: Person) strict {
    when vinegar_plant_operator(p);
    then provision_applicable_to_vinegar_plants("5553(a)");
}
@source(IRC_S5505_G, relation = formalizes, coverage = exact, quote = "The provisions of section 5555(b) relating to the authority of the Secretary to waive records, statements, and returns shall be applicable to records, statements, or returns required by this part.")
rule VinegarPlants5555bApplicable(p: Person) strict {
    when vinegar_plant_operator(p);
    then provision_applicable_to_vinegar_plants("5555(b)");
}
@source(IRC_S5505_H, relation = formalizes, coverage = exact, quote = "The provisions of section 5556 relating to the prescribing of regulations shall be applicable to this part.")
rule VinegarPlants5556Applicable(p: Person) strict {
    when vinegar_plant_operator(p);
    then provision_applicable_to_vinegar_plants("5556");
}
@source(IRC_S5505_I, relation = formalizes, coverage = exact, quote = "The penalties and forfeitures provided in sections 5601(a)(1), (6), and (12), 5603, 5615(1) and (4), 5686, and 5687 shall be applicable to this part.")
rule VinegarPlantsPenaltiesApplicable(p: Person) strict {
    when vinegar_plant_operator(p);
    then provision_applicable_to_vinegar_plants("5601(a)(1), (6), (12), 5603, 5615(1), (4), 5686, 5687");
}
pub relation provision_of_chapter_51_asserted(provision: Text) kind empirical {
    label en official "a provision of chapter 51 asked about for a vinegar plant";
}
@source(IRC_S5505_J, relation = formalizes, coverage = exact, quote = "This chapter (other than this part and the provisions referred to in subsection (a), (b), (c), (d), (e), (f), (g), (h), (i)")
rule OtherChapter51ProvisionsNotApplicableToVinegarPlants(p: Person, s: Text) strict {
    when vinegar_plant_operator(p) and provision_of_chapter_51_asserted(s) and not_known(provision_applicable_to_vinegar_plants(s));
    then chapter_51_provision_not_applicable_to_vinegar_plants(s);
}

// =====================================================================
// Section 5011(c)(2)-(3): the deemed financing rate and the deemed Federal excise tax per case
// =====================================================================

pub relation corporate_overpayment_rate_for_quarter(year: Integer, quarter: Integer, rate: Decimal) kind empirical {
    label en official "section 5011(c)(2): the corporate overpayment rate under section 6621(a)(1) (determined without regard to the last sentence of that paragraph) for the calendar quarter of the year (an EXTERNAL_DEPENDENCY on section 6621; the rate as a fraction, 0.05 for 5 percent)";
}
pub relation deemed_financing_rate_for_year(year: Integer, rate: Decimal) kind institutional {
    label en official "section 5011(c)(2): the average of the corporate overpayment rates for the calendar quarters of the year (JUDGMENT CALL: rounded to 8 decimal places HALF_UP; the text names no rounding)";
}
@source(IRC_S5011_C, relation = formalizes, coverage = exact, quote = "the deemed financing rate for any calendar year is the average of the corporate overpayment rates under paragraph (1) of section 6621(a) (determined without regard to the last sentence of such paragraph) for calendar quarters of such year.")
rule DeemedFinancingRateForYear(y: Integer, q: Integer, r: Decimal) strict {
    when corporate_overpayment_rate_for_quarter(y, q, r);
    then deemed_financing_rate_for_year(y, div_round(sum(collect all rr: Decimal, qq: Integer where corporate_overpayment_rate_for_quarter(y, qq, rr), empty: 0.0), count(collect all q3: Integer, r3: Decimal where corporate_overpayment_rate_for_quarter(y, q3, r3)) * 1.0, 8, "HALF_UP"));
}
pub relation deemed_federal_excise_tax_per_case_is(amount: Money) kind institutional {
    label en official "section 5011(c)(3): the deemed Federal excise tax per case is $25.68";
}
@source(IRC_S5011_C, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the deemed Federal excise tax per case is $25.68.")
rule DeemedFederalExciseTaxPerCaseStatement(x: Person) strict {
    when is_alcohol_taxpayer(x);
    then deemed_federal_excise_tax_per_case_is(DeemedFederalExciseTaxPerCase);
}

// =====================================================================
// Burden of proof (sections 5044(a), 5370(b), 5614): who bears it, as an institutional effect
// =====================================================================

pub relation bears_burden_of_proof_on_claim(party: Person, ground: Text) kind institutional {
    label en official "the party bears the burden of proof on the stated question (an institutional effect of the claim; the outcome on a failure of proof is the decision-maker's, section 136)";
}
pub relation wine_returned_to_bond_claim_by(applicant: Person, assertion: Text) kind empirical {
    label en official "section 5044(a): the applicant claims refund, credit or relief of liability for tax on wine removed from a bonded wine cellar and returned to bond under section 5361";
}
@source(IRC_S5044_A, relation = formalizes, coverage = exact, quote = "The burden of proof in all such cases shall be on the applicant.")
rule Section5044aBurdenOnApplicant(a: Person, c: Text) strict {
    when wine_returned_to_bond_claim_by(a, c);
    then bears_burden_of_proof_on_claim(a, "section 5044(a): the claim for refund, credit or relief on wine returned to bond");
}
pub relation wine_return_claim_quantity(assertion: Text, quantity: Decimal) kind empirical {
    label en official "the quantity of wine covered by the claim";
}
pub relation regulation_minimum_quantity_for_wine_return_claim(assertion: Text, minimum: Decimal) kind empirical {
    label en official "section 5044(a): the minimum quantity the regulations specify for a claim for refund, credit or relief (EXTERNAL_DEPENDENCY on the regulations)";
}
pub relation wine_return_claim_meets_regulation_minimum_quantity(assertion: Text) kind institutional {
    label en official "section 5044(a): the claim covers at least the minimum quantity specified by the regulations";
}
@source(IRC_S5044_A, relation = formalizes, coverage = exact, quote = "Such regulations may provide that claim for refund or credit under paragraph (1), or relief from liability under paragraph (2), may be made only with respect to minimum quantities specified in such regulations.")
rule WineReturnClaimMeetsMinimumQuantity(c: Text, q: Decimal, m: Decimal) strict {
    when wine_return_claim_quantity(c, q) and regulation_minimum_quantity_for_wine_return_claim(c, m) and q >= m;
    then wine_return_claim_meets_regulation_minimum_quantity(c);
}
@source(IRC_S5370_B, relation = formalizes, coverage = exact, quote = "In every case where it appears that the loss was by theft, the burden shall be on the proprietor or other person liable for the tax to establish to the satisfaction of the Secretary, that such loss did not occur as the result of connivance, collusion, fraud, or negligence")
rule Section5370bTheftBurdenOnProprietor(l: WineLoss, p: Person) strict {
    when wine_loss_cause(l, Theft) and wine_loss_claim_filed_by(l, p);
    then bears_burden_of_proof_on_claim(p, "section 5370(b): that the wine theft loss did not result from connivance, collusion, fraud or negligence");
}
pub relation spirits_seized_outside_authorized_places_or_not_in_conformity_with_law(claimant: Person, seizure: Text) kind empirical {
    label en official "section 5614: distilled spirits are seized elsewhere than on a plant, warehouse or dealer's premises or in transit, or in such a place but not received or sent out in conformity to law, or without the required entries, or the owner or person in charge omitted or committed an act required or prohibited (the claimant of the spirits and the seizure)";
}
@source(IRC_S5614, relation = formalizes, coverage = exact, quote = "the burden of proof shall be upon the claimant of said spirits to show that no fraud has been committed, and that all the requirements of the law in relation to the payment of the tax have been complied with.")
rule Section5614BurdenOnClaimantOfSeizedSpirits(c: Person, s: Text) strict {
    when spirits_seized_outside_authorized_places_or_not_in_conformity_with_law(c, s);
    then bears_burden_of_proof_on_claim(c, "section 5614: that no fraud has been committed and the requirements of law on payment of the tax were complied with");
}
