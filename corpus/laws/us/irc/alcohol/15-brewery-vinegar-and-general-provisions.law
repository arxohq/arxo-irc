// Stage 2. Subchapter G (breweries): 5402, 5411-5418. Subchapter H (vinegar
// by vaporizing process, volatile fruit-flavor concentrate): 5501-5512.
// Subchapter J part I (general provisions): 5551 (bonds), 5553-5562.
// Sections whose whole content is a delegation to Secretary regulations
// (5552, 5554, 5556, 5558, 5559, 5560 cross-reference) are classified in the
// coverage rows and carry no rule.

use self::{
    AlcoholReturnPeriod,
    AlcoholicLot,
    BeerMovement,
    Brewery,
    DrawbackFilingFrequency,
    IRC_S5402_A,
    IRC_S5411,
    IRC_S5412,
    IRC_S5413,
    IRC_S5414_A,
    IRC_S5414_B,
    IRC_S5415_A,
    IRC_S5415_B,
    IRC_S5418,
    IRC_S5501,
    IRC_S5502_A,
    IRC_S5504_B,
    IRC_S5504_C,
    IRC_S5505_A,
    IRC_S5505_B,
    IRC_S5511,
    IRC_S5551_A,
    IRC_S5551_B,
    IRC_S5551_C,
    IRC_S5551_D,
    IRC_S5557_A,
    IRC_S5561,
    IRC_S5562,
    Person,
    SpiritsReturnPurpose,
    alcohol_return_period,
    is_brewer,
};

pub const VinegarPlantMaximumSpiritsAbvPercent: Decimal = 15.0 {
    label en official "distilled spirits of not more than 15 percent of alcohol by volume produced exclusively for vinegar manufacture (section 5501)";
};
pub const VinegarRemovalMaximumProofSpiritsPercent: Decimal = 2.0 {
    label en official "no vinegar or other fluid or material containing a greater proportion than 2 percent of proof spirits shall be removed (section 5504(b))";
};
pub const FruitFlavorConcentrateBeverageAbvCeilingPercent: Decimal = 24.0 {
    label en official "a concentrate which does not exceed 24 percent alcohol by volume may be transferred to a bonded wine cellar for use in natural wine (section 5511(2))";
};

// =============================================================================
// Section 5402(a), 5411, 5412, 5413: the brewery
// =============================================================================

pub relation brewery_land_and_buildings_as_described_in_notice(b: Brewery) kind empirical {
    label en official "the brewery consists of the land and buildings described in the brewer's notice (section 5402(a))";
}
pub relation brewery_parts_separated_only_by_permitted_media(b: Brewery) kind empirical {
    label en official "any separation of the parts of the brewery is only by public passageways, streets, highways, waterways, carrier rights-of-way, or partitions (section 5402(a))";
}
pub relation brewery_parts_abut_dividing_medium_and_are_adjacent(b: Brewery) kind empirical {
    label en official "if parts are separated they abut on the dividing medium and are adjacent to each other (section 5402(a))";
}
pub relation brewery_is_continuous_unbroken(b: Brewery) kind empirical {
    label en official "the brewery is continuous and unbroken";
}
pub relation brewer_facility_approved_by_secretary_as_part_of_brewery(b: Brewery) kind empirical {
    label en official "facilities under the brewer's control for case packing, loading, or storing within reasonable proximity to the packaging facilities are approved by the Secretary as part of the brewery because the revenue will not be jeopardized (section 5402(a) second sentence)";
}
pub relation brewery_premises_qualify(b: Brewery) kind institutional {
    label en official "the brewery premises meet the continuity requirement of section 5402(a)";
}
@source(IRC_S5402_A, coverage = exact, quote = "The continuity of the brewery must be unbroken except where separated by public passageways, streets, highways, waterways, or carrier rights-of-way, or partitions; and if parts of the brewery are so separated they must abut on the dividing medium and be adjacent to each other.")
rule Section5402aUnbrokenRule(b: Brewery) strict {
    label en official "section 5402(a): an unbroken brewery meets the continuity requirement";
    when brewery_land_and_buildings_as_described_in_notice(b);
    when brewery_is_continuous_unbroken(b);
    then brewery_premises_qualify(b);
}
@source(IRC_S5402_A, coverage = exact, quote = "and if parts of the brewery are so separated they must abut on the dividing medium and be adjacent to each other.")
rule Section5402aSeparatedRule(b: Brewery) strict {
    label en official "section 5402(a): a brewery whose parts are separated only by permitted media and abut and are adjacent to one another meets the requirement";
    when brewery_land_and_buildings_as_described_in_notice(b);
    when brewery_parts_separated_only_by_permitted_media(b);
    when brewery_parts_abut_dividing_medium_and_are_adjacent(b);
    then brewery_premises_qualify(b);
}
@source(IRC_S5402_A, coverage = exact, quote = "may be approved by the Secretary as a part of the brewery if the revenue will not be jeopardized thereby.")
rule Section5402aApprovedFacilityRule(b: Brewery) strict {
    label en official "section 5402(a): case-packing, loading, or storing facilities approved by the Secretary are part of the brewery notwithstanding the continuity rule";
    when brewery_land_and_buildings_as_described_in_notice(b);
    when brewer_facility_approved_by_secretary_as_part_of_brewery(b);
    then brewery_premises_qualify(b);
}
pub enum BreweryUse {
    ProducingPackagingStoringBeer;
    CerealBeveragesUnderHalfPercentVitaminsIceMaltMaltSirupByproductsSoftDrinks;
    ProcessingSpentGrainCarbonDioxideYeast;
    OtherPurposeFoundNotToJeopardizeRevenue;
    OtherPurpose;
}
pub relation brewery_used_for(b: Brewery, p: Person, use_kind: BreweryUse) kind empirical {
    label en official "the brewery is used for this purpose (section 5411)";
}
pub relation secretary_regulation_finds_use_will_not_jeopardize_revenue(use_kind: BreweryUse) kind empirical {
    label en official "the Secretary by regulation has found the use will not jeopardize the revenue (section 5411)";
}
@source(IRC_S5411, coverage = exact, quote = "The brewery shall be used under regulations prescribed by the Secretary only for the purpose of producing, packaging, and storing beer")
rule Section5411UseProhibitionRule(b: Brewery, p: Person, use_kind: BreweryUse) defeasible {
    label en official "section 5411: a brewery may be used only for producing, packaging, and storing beer, listed non-beer products and byproducts, processing spent grain, carbon dioxide, and yeast, and other purposes the Secretary by regulation finds will not jeopardize the revenue";
    when brewery_used_for(b, p, use_kind);
    when use_kind == OtherPurpose;
    unless secretary_regulation_finds_use_will_not_jeopardize_revenue(use_kind) and brewery_used_for(b, p, use_kind);
    then prohibition Section5411UnauthorizedBreweryUseProhibition {
        bearer p;
        action brewery_used_for(b, p, use_kind);
        window [-infinity, infinity];
    };
}
pub entity BeerContainerRemoval {
    label en unofficial "the removal of beer from a brewery for consumption or sale in a container (section 5412)";
}
pub relation beer_removed_in_container_of_kind_hogshead_package_or_similar(r: BeerContainerRemoval) kind empirical {
    label en official "beer is removed from the brewery in hogsheads, packages, or similar containers (section 5412)";
}
pub relation beer_removal_container_marked_as_secretary_requires(r: BeerContainerRemoval) kind empirical {
    label en official "the containers are marked, branded, or labeled as the Secretary requires by regulation (section 5412)";
}
pub relation beer_removed_under_5414_or_by_pipeline_to_contiguous_plant_under_5222(r: BeerContainerRemoval) kind empirical {
    label en official "the beer is removed pursuant to section 5414 or by pipeline to contiguous distilled spirits plants under section 5222 (section 5412 exception)";
}
pub relation beer_remover(r: BeerContainerRemoval, p: Person) kind empirical {
    label en official "the person removing the beer from the brewery";
}
pub relation beer_removal_container_conforms(r: BeerContainerRemoval) kind institutional {
    label en unofficial "the container is a hogshead/package/similar container and marked as required (helper)";
}
rule Section5412ContainerConformsRule(r: BeerContainerRemoval) strict {
    label en unofficial "container and marking requirement satisfied";
    when beer_removed_in_container_of_kind_hogshead_package_or_similar(r);
    when beer_removal_container_marked_as_secretary_requires(r);
    then beer_removal_container_conforms(r);
}
@source(IRC_S5412, coverage = exact, quote = "Beer may be removed from the brewery for consumption or sale only in hogsheads, packages, and similar containers, marked, branded, or labeled in such manner as the Secretary may by regulation require")
rule Section5412ContainerProhibitionRule(r: BeerContainerRemoval, p: Person) defeasible {
    label en official "section 5412: beer may be removed for consumption or sale only in hogsheads, packages, and similar containers marked as required, except removal under section 5414 or by pipeline to a contiguous distilled spirits plant";
    when beer_remover(r, p);
    unless beer_removal_container_conforms(r) and beer_remover(r, p);
    unless beer_removed_under_5414_or_by_pipeline_to_contiguous_plant_under_5222(r) and beer_remover(r, p);
    then prohibition Section5412NonConformingContainerProhibition {
        bearer p;
        action beer_remover(r, p);
        window [-infinity, infinity];
    };
}
pub relation brewer_obtains_beer_in_own_marked_containers_from_another_brewer(p: Person, other: Person) kind empirical {
    label en official "a brewer obtains beer in his own hogsheads, barrels, and kegs, marked with his name and address, from another brewer, with taxpayment by the producer under section 5054 (section 5413)";
}
@source(IRC_S5413, coverage = partial, quote = "A brewer, under such regulations as the Secretary shall prescribe, may obtain beer in his own hogsheads, barrels, and kegs, marked with his name and address, from another brewer, with taxpayment thereof to be by the producer in the manner prescribed by section 5054.")
rule Section5413OwnContainersLibertyRule(p: Person, other: Person) strict {
    label en official "section 5413: a brewer may obtain beer in his own marked containers from another brewer, the producer paying the tax under section 5054 (liberty)";
    when is_brewer(p);
    when brewer_obtains_beer_in_own_marked_containers_from_another_brewer(p, other);
    then liberty Section5413ObtainBeerInOwnContainers {
        holder p;
        action brewer_obtains_beer_in_own_marked_containers_from_another_brewer(p, other);
        window [-infinity, infinity];
    };
}

// =============================================================================
// Section 5414: removals between breweries
// =============================================================================

pub entity BreweryTransfer {
    label en unofficial "a removal of beer from one brewery to another without payment of tax (section 5414)";
}
pub relation transfer_between_breweries_of_same_brewer(t: BreweryTransfer) kind empirical {
    label en official "removal from one brewery to another brewery belonging to the same brewer (section 5414(a)(1))";
}
pub relation transferor_corporation_owns_controlling_interest_in_transferee_or_vice_versa(t: BreweryTransfer) kind empirical {
    label en official "one corporation owns the controlling interest in the other (section 5414(a)(2)(A))";
}
pub relation same_persons_own_controlling_interest_in_each_corporation(t: BreweryTransfer) kind empirical {
    label en official "the controlling interest in each corporation is owned by the same person or persons (section 5414(a)(2)(B))";
}
pub relation brewery_proprietors_independent_no_proprietary_interest(t: BreweryTransfer) kind empirical {
    label en official "the proprietors of the transferring and receiving premises are independent of each other and neither has a proprietary interest, directly or indirectly, in the business of the other (section 5414(a)(3)(A))";
}
pub relation transferor_divested_all_interest_and_transferee_accepted_responsibility(t: BreweryTransfer) kind empirical {
    label en official "the transferor has divested itself of all interest in the beer and the transferee has accepted responsibility for payment of the tax (section 5414(a)(3)(B))";
}
pub relation brewery_transfer_without_payment_of_tax_permitted(t: BreweryTransfer) kind institutional {
    label en official "beer may be removed from one brewery to another, without payment of tax, and mingled with beer at the receiving brewery, subject to the Secretary's conditions (section 5414(a))";
}
@source(IRC_S5414_A, coverage = exact, quote = "(1) any removal from one brewery to another brewery belonging to the same brewer,")
rule Section5414a1SameBrewerRule(t: BreweryTransfer) strict {
    label en official "section 5414(a)(1): removal between breweries of the same brewer";
    when transfer_between_breweries_of_same_brewer(t);
    then brewery_transfer_without_payment_of_tax_permitted(t);
}
@source(IRC_S5414_A, coverage = exact, quote = "(A) one such corporation owns the controlling interest in the other such corporation, or")
rule Section5414a2AParentRule(t: BreweryTransfer) strict {
    label en official "section 5414(a)(2)(A): removal between breweries owned by corporations one of which owns the controlling interest in the other";
    when transferor_corporation_owns_controlling_interest_in_transferee_or_vice_versa(t);
    then brewery_transfer_without_payment_of_tax_permitted(t);
}
@source(IRC_S5414_A, coverage = exact, quote = "(B) the controlling interest in each such corporation is owned by the same person or persons, and")
rule Section5414a2BCommonOwnerRule(t: BreweryTransfer) strict {
    label en official "section 5414(a)(2)(B): removal between breweries of corporations under common control";
    when same_persons_own_controlling_interest_in_each_corporation(t);
    then brewery_transfer_without_payment_of_tax_permitted(t);
}
@source(IRC_S5414_A, coverage = exact, quote = "(B) the transferor has divested itself of all interest in the beer so transferred and the transferee has accepted responsibility for payment of the tax.")
rule Section5414a3IndependentRule(t: BreweryTransfer) strict {
    label en official "section 5414(a)(3): removal between independent proprietors when the transferor divested all interest and the transferee accepted responsibility for the tax";
    when brewery_proprietors_independent_no_proprietary_interest(t);
    when transferor_divested_all_interest_and_transferee_accepted_responsibility(t);
    then brewery_transfer_without_payment_of_tax_permitted(t);
}
pub relation transfer_removed_from_transferor_premises_on(t: BreweryTransfer, on: Date) kind empirical {
    label en official "the date of removal from the transferor's premises";
}
pub relation transfer_divestment_of_interest_on(t: BreweryTransfer, on: Date) kind empirical {
    label en official "the date the transferor divested itself of its interest in the beer";
}
pub relation transferor_relief_from_liability_effective_on(t: BreweryTransfer, on: Date) kind institutional {
    label en official "the relief from liability under section 5414(a)(3) is effective from the time of removal from the transferor's premises, or from the time of divestment, whichever is later (section 5414(b))";
}
@source(IRC_S5414_B, coverage = exact, quote = "such relief from liability shall be effective from the time of removal from the transferor's premises, or from the time of divestment of interest, whichever is later.")
rule Section5414bReliefDateRule(t: BreweryTransfer, removed: Date, divested: Date) strict {
    label en official "section 5414(b): the transferor's relief takes effect on the later of removal and divestment";
    when transfer_removed_from_transferor_premises_on(t, removed);
    when transfer_divestment_of_interest_on(t, divested);
    then transferor_relief_from_liability_effective_on(t, max(removed, divested));
}

// =============================================================================
// Section 5415: brewers' records and returns; 5418: bulk imported beer
// =============================================================================

pub relation brewer_keeps_records_as_prescribed_and_preserved_and_available_for_inspection(p: Person) kind empirical {
    label en official "the brewer keeps records as the Secretary prescribes, preserves them for the prescribed period, and keeps them available during business hours for examination and abstracts by internal revenue officers (section 5415(a))";
}
pub relation brewer_makes_true_and_accurate_returns(p: Person) kind empirical {
    label en official "the brewer makes true and accurate returns of operations and transactions in the form, at the times, and for the periods the Secretary prescribes (section 5415(b))";
}
@source(IRC_S5415_A, coverage = exact, quote = "Every brewer shall keep records, in such form and containing such information as the Secretary shall prescribe by regulations as necessary for protection of the revenue.")
rule Section5415aRecordsDutyRule(p: Person) strict {
    label en official "section 5415(a): every brewer keeps, preserves, and makes available the prescribed records";
    when is_brewer(p);
    then duty Section5415aBrewerRecordsDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition brewer_keeps_records_as_prescribed_and_preserved_and_available_for_inspection(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S5415_B, coverage = exact, quote = "Every brewer shall make true and accurate returns of his operations and transactions in the form, at the times, and for such periods as the Secretary shall by regulation prescribe.")
rule Section5415bReturnsDutyRule(p: Person) strict {
    label en official "section 5415(b): every brewer makes true and accurate returns of operations and transactions";
    when is_brewer(p);
    then duty Section5415bBrewerReturnsDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition brewer_makes_true_and_accurate_returns(p);
            window [-infinity, infinity];
        }
    };
}
pub relation bulk_beer_transferred_from_customs_custody_to_brewery(m: BeerMovement, brewery_proprietor: Person, importer: Person) kind empirical {
    label en official "beer imported in bulk containers is withdrawn from customs custody and transferred in such containers to the premises of a brewery without payment of the tax (section 5418)";
}
pub relation beer_released_from_customs_custody_on(m: BeerMovement, on: Date) kind empirical {
    label en official "the date of release of the beer from customs custody";
}
pub relation brewery_proprietor_liable_from_customs_release(p: Person, m: BeerMovement, on: Date) kind institutional {
    label en official "the proprietor of the receiving brewery becomes liable for the tax upon release from customs custody (section 5418)";
}
pub relation beer_importer_relieved_on_customs_transfer(p: Person, m: BeerMovement) kind institutional {
    label en official "the importer, or the person bringing the beer in, is thereupon relieved of liability (section 5418)";
}
@source(IRC_S5418, coverage = exact, quote = "The proprietor of a brewery to which such beer is transferred shall become liable for the tax on the beer withdrawn from customs custody under this section upon release of the beer from customs custody")
rule Section5418ProprietorLiableRule(m: BeerMovement, proprietor: Person, importer: Person, on: Date) strict {
    label en official "section 5418: the receiving brewery proprietor becomes liable on release from customs custody";
    when bulk_beer_transferred_from_customs_custody_to_brewery(m, proprietor, importer);
    when beer_released_from_customs_custody_on(m, on);
    then brewery_proprietor_liable_from_customs_release(proprietor, m, on);
}
@source(IRC_S5418, coverage = exact, quote = "and the importer, or the person bringing such beer into the United States, shall thereupon be relieved of the liability for such tax.")
rule Section5418ImporterRelievedRule(m: BeerMovement, proprietor: Person, importer: Person) strict {
    label en official "section 5418: the importer is relieved of liability";
    when bulk_beer_transferred_from_customs_custody_to_brewery(m, proprietor, importer);
    then beer_importer_relieved_on_customs_transfer(importer, m);
}

// =============================================================================
// Sections 5501-5512: vinegar plants; volatile fruit-flavor concentrate
// =============================================================================

pub entity VinegarPlant {
    label en unofficial "a plant for the production of vinegar by the vaporizing process (section 5501)";
}
pub relation vinegar_plant_spirits_abv_percent(v: VinegarPlant, pct: Decimal) kind empirical {
    label en official "the alcohol by volume of the distilled spirits produced at the plant (section 5501)";
}
pub relation vinegar_plant_spirits_used_exclusively_in_vinegar_manufacture_on_premises(v: VinegarPlant) kind empirical {
    label en official "the spirits are produced exclusively for use in the manufacture of vinegar on the premises (section 5501)";
}
pub relation vinegar_plant_may_be_established(v: VinegarPlant) kind institutional {
    label en official "a plant for the production of vinegar by the vaporizing process may be established under part I of subchapter H (section 5501)";
}
@source(IRC_S5501, coverage = exact, quote = "where distilled spirits of not more than 15 percent of alcohol by volume are to be produced exclusively for use in the manufacture of vinegar on the premises, may be established under this part.")
rule Section5501EstablishmentRule(v: VinegarPlant, pct: Decimal) strict {
    label en official "section 5501: a vaporizing-process vinegar plant producing spirits of at most 15 percent alcohol by volume exclusively for vinegar on the premises may be established";
    when vinegar_plant_spirits_abv_percent(v, pct);
    when pct <= VinegarPlantMaximumSpiritsAbvPercent;
    when vinegar_plant_spirits_used_exclusively_in_vinegar_manufacture_on_premises(v);
    then vinegar_plant_may_be_established(v);
}
pub relation person_commences_vinegar_vaporizing_business(p: Person, v: VinegarPlant) kind empirical {
    label en official "the person commences the business of manufacturing vinegar by the vaporizing process (section 5502(a))";
}
pub relation vinegar_plant_registration_application_made_and_permission_received(p: Person, v: VinegarPlant) kind empirical {
    label en official "the person has made application to the Secretary for registration of the plant and received permission to operate (section 5502(a))";
}
@source(IRC_S5502_A, coverage = exact, quote = "Every person, before commencing the business of manufacturing vinegar by the vaporizing process, and at such other times as the Secretary may by regulations prescribe, shall make application to the Secretary for the registration of his plant and receive permission to operate.")
rule Section5502aRegistrationProhibitionRule(p: Person, v: VinegarPlant) defeasible {
    label en official "section 5502(a): the vinegar-vaporizing business may not commence until application is made and permission to operate is received";
    when person_commences_vinegar_vaporizing_business(p, v);
    unless vinegar_plant_registration_application_made_and_permission_received(p, v) and person_commences_vinegar_vaporizing_business(p, v);
    then prohibition Section5502CommenceWithoutRegistrationProhibition {
        bearer p;
        action person_commences_vinegar_vaporizing_business(p, v);
        window [-infinity, infinity];
    };
}
pub relation vinegar_fluid_proof_spirits_percent(v: VinegarPlant, pct: Decimal) kind empirical {
    label en official "the proportion of proof spirits in the vinegar or other fluid or material removed from the plant (section 5504(b))";
}
pub relation vinegar_removed_from_plant_by(v: VinegarPlant, p: Person) kind empirical {
    label en official "the person removes, or causes to be removed, the vinegar or other fluid from the plant";
}
@source(IRC_S5504_B, coverage = exact, quote = "No person shall remove, or cause to be removed, from any plant established under this part any vinegar or other fluid or material containing a greater proportion than 2 percent of proof spirits.")
rule Section5504bRemovalProhibitionRule(v: VinegarPlant, p: Person, pct: Decimal) strict {
    label en official "section 5504(b): no removal from a vinegar plant of fluid containing more than 2 percent proof spirits";
    when vinegar_removed_from_plant_by(v, p);
    when vinegar_fluid_proof_spirits_percent(v, pct);
    when pct > VinegarRemovalMaximumProofSpiritsPercent;
    then prohibition Section5504HighProofRemovalProhibition {
        bearer p;
        action vinegar_removed_from_plant_by(v, p);
        window [-infinity, infinity];
    };
}
pub relation vinegar_manufacturer_keeps_records_and_files_reports(p: Person) kind empirical {
    label en official "the manufacturer keeps the records and files the reports of the kind and quantity of materials received, fermented or mashed, low wines produced and used, vinegar produced and removed, and other information regulations require (section 5504(c))";
}
pub relation person_manufactures_vinegar_by_vaporizing_process(p: Person) kind empirical {
    label en official "the person manufactures vinegar by the vaporizing process";
}
@source(IRC_S5504_C, coverage = partial, quote = "Every person manufacturing vinegar by the vaporizing process shall keep such records and file such reports as the Secretary shall by regulations prescribe")
rule Section5504cRecordsDutyRule(p: Person) strict {
    label en official "section 5504(c): every vaporizing-process vinegar manufacturer keeps records and files reports (content per regulations — EXTERNAL_DEPENDENCY)";
    when person_manufactures_vinegar_by_vaporizing_process(p);
    then duty Section5504cVinegarRecordsDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition vinegar_manufacturer_keeps_records_and_files_reports(p);
            window [-infinity, infinity];
        }
    };
}
pub relation distilled_spirits_produced_in_violation_of_5501(l: AlcoholicLot) kind empirical {
    label en official "the spirits are produced in violation of section 5501 (section 5505(a))";
}
pub relation distilled_spirits_removed_in_violation_of_5504b(l: AlcoholicLot) kind empirical {
    label en official "the spirits are removed in violation of section 5504(b) (section 5505(a))";
}
pub relation subchapter_a_taxes_apply_to_vinegar_plant_spirits(l: AlcoholicLot) kind institutional {
    label en official "the taxes imposed by subchapter A apply to the spirits (section 5505(a))";
}
@source(IRC_S5505_A, coverage = exact, quote = "The taxes imposed by subchapter A shall be applicable to any distilled spirits produced in violation of section 5501 or removed in violation of section 5504(b).")
rule Section5505aProducedInViolationRule(l: AlcoholicLot) strict {
    label en official "section 5505(a): the subchapter A taxes apply to spirits produced in violation of section 5501";
    when distilled_spirits_produced_in_violation_of_5501(l);
    then subchapter_a_taxes_apply_to_vinegar_plant_spirits(l);
}
@source(IRC_S5505_A, coverage = exact, quote = "The taxes imposed by subchapter A shall be applicable to any distilled spirits produced in violation of section 5501 or removed in violation of section 5504(b).")
rule Section5505aRemovedInViolationRule(l: AlcoholicLot) strict {
    label en official "section 5505(a): the subchapter A taxes apply to spirits removed in violation of section 5504(b)";
    when distilled_spirits_removed_in_violation_of_5504b(l);
    then subchapter_a_taxes_apply_to_vinegar_plant_spirits(l);
}
pub relation vinegar_plant_located_on_premises_where_distilling_is_prohibited(v: VinegarPlant, p: Person) kind empirical {
    label en official "the plant is located on premises where distilling is prohibited under section 5601(a)(6) (section 5505(b))";
}
@source(IRC_S5505_B, coverage = exact, quote = "Plants established under this part shall not be located on any premises where distilling is prohibited under section 5601(a)(6).")
rule Section5505bLocationProhibitionRule(v: VinegarPlant, p: Person) strict {
    label en official "section 5505(b): a vinegar plant may not be located on premises where distilling is prohibited under section 5601(a)(6)";
    when vinegar_plant_located_on_premises_where_distilling_is_prohibited(v, p);
    then prohibition Section5505VinegarPlantLocationProhibition {
        bearer p;
        action vinegar_plant_located_on_premises_where_distilling_is_prohibited(v, p);
        window [-infinity, infinity];
    };
}
pub entity FruitFlavorConcentrateOperation {
    label en unofficial "the manufacture of a volatile fruit-flavor concentrate by a process which includes evaporations from the mash or juice of any fruit (section 5511)";
}
pub relation concentrate_and_source_contain_no_more_alcohol_than_reasonably_unavoidable(o: FruitFlavorConcentrateOperation) kind empirical {
    label en official "the concentrate, and the mash or juice from which it is produced, contains no more alcohol than is reasonably unavoidable in the manufacture (section 5511(1)) — DECISION-0194 evaluative, asserted with origin adjudicated where disputed";
}
pub relation concentrate_rendered_unfit_for_beverage_before_removal(o: FruitFlavorConcentrateOperation) kind empirical {
    label en official "the concentrate is rendered unfit for use as a beverage before removal from the place of manufacture (section 5511(2))";
}
pub relation concentrate_abv_percent(o: FruitFlavorConcentrateOperation, pct: Decimal) kind empirical {
    label en official "the concentrate's alcohol by volume";
}
pub relation concentrate_transferred_to_bonded_wine_cellar_for_natural_wine(o: FruitFlavorConcentrateOperation) kind empirical {
    label en official "the concentrate is transferred to a bonded wine cellar for use in the production of natural wine as provided in section 5382 (section 5511(2))";
}
pub relation manufacturer_complied_with_application_records_reports_bond_requirements(o: FruitFlavorConcentrateOperation) kind empirical {
    label en official "the manufacturer makes the application, keeps the records, renders the reports, files the bonds, and complies with the other requirements the Secretary prescribes by regulations (section 5511(3))";
}
pub relation concentrate_has_unfit_or_wine_cellar_disposition(o: FruitFlavorConcentrateOperation) kind institutional {
    label en unofficial "the concentrate is rendered unfit for beverage before removal, or (if at most 24 percent alcohol) transferred to a bonded wine cellar for natural wine (helper)";
}
rule Section5511UnfitRule(o: FruitFlavorConcentrateOperation) strict {
    label en unofficial "rendered unfit before removal";
    when concentrate_rendered_unfit_for_beverage_before_removal(o);
    then concentrate_has_unfit_or_wine_cellar_disposition(o);
}
rule Section5511WineCellarRule(o: FruitFlavorConcentrateOperation, pct: Decimal) strict {
    label en unofficial "transferred to a bonded wine cellar when the concentrate does not exceed 24 percent alcohol by volume";
    when concentrate_transferred_to_bonded_wine_cellar_for_natural_wine(o);
    when concentrate_abv_percent(o, pct);
    when pct <= FruitFlavorConcentrateBeverageAbvCeilingPercent;
    then concentrate_has_unfit_or_wine_cellar_disposition(o);
}
pub relation chapter_51_not_applicable_to_flavor_concentrate_manufacture(o: FruitFlavorConcentrateOperation) kind institutional {
    label en official "chapter 51 (other than sections 5178(a)(2)(C), 5179, 5203(b), (c), and (d), and 5552) does not apply to the manufacture of the volatile fruit-flavor concentrate (section 5511)";
}
@source(IRC_S5511, coverage = exact, quote = "shall not be applicable with respect to the manufacture, by any process which includes evaporations from the mash or juice of any fruit, of any volatile fruit-flavor concentrate if—")
rule Section5511ChapterNotApplicableRule(o: FruitFlavorConcentrateOperation) defeasible {
    label en official "section 5511: chapter 51 does not apply (except the listed sections) to the manufacture of a volatile fruit-flavor concentrate if the alcohol is no more than reasonably unavoidable, the concentrate is rendered unfit or moved to a bonded wine cellar, and the manufacturer complies with the regulations (the scope limit — 'other than sections 5178(a)(2)(C), 5179, 5203(b)-(d), 5552' — is not enforced package-wide, TECH_GAP)";
    when concentrate_and_source_contain_no_more_alcohol_than_reasonably_unavoidable(o);
    when concentrate_has_unfit_or_wine_cellar_disposition(o);
    when manufacturer_complied_with_application_records_reports_bond_requirements(o);
    then chapter_51_not_applicable_to_flavor_concentrate_manufacture(o);
}

// =============================================================================
// Section 5551: bonds — prohibition, disapproval, appeal, small-taxpayer waiver
// =============================================================================

pub enum ChapterFiftyOneBusiness { DistillerBusiness; WarehousemanBusiness; ProcessorBusiness; BrewerBusiness; WinemakerBusiness; }
pub relation commences_or_continues_business(p: Person, b: ChapterFiftyOneBusiness) kind empirical {
    label en official "the individual, firm, partnership, corporation, or association intends to commence or continue the business of a distiller, warehouseman, processor, brewer, or winemaker (section 5551(a))";
}
pub relation all_required_bonds_approved(p: Person, b: ChapterFiftyOneBusiness) kind empirical {
    label en official "all bonds in respect of the business required by any provision of law have been approved by the Secretary of the Treasury or the officer designated by him (section 5551(a))";
}
pub relation bond_not_required_under_5551d(p: Person, year: Integer) kind institutional {
    label en official "the taxpayer is within a period to which section 5061(d)(4)(A) applies (quarterly or annual payment), so no bond covering operations or withdrawals of distilled spirits or wines for nonindustrial use or of beer is required (section 5551(d)(1)-(2))";
}
@source(IRC_S5551_D, coverage = partial, quote = "such taxpayer shall not be required to furnish any bond covering operations or withdrawals of distilled spirits or wines for nonindustrial use or of beer.")
rule Section5551dQuarterlyRule(p: Person, year: Integer) defeasible {
    label en official "section 5551(d)(1): a taxpayer on the section 5061(d)(4)(A) quarterly period is not required to furnish the bond (the (d)(4)(B) mid-year loss of eligibility is TECH_GAP G141)";
    when alcohol_return_period(p, year, Quarterly);
    then bond_not_required_under_5551d(p, year);
}
@source(IRC_S5551_D, coverage = partial, quote = "such taxpayer shall not be required to furnish any bond covering operations or withdrawals of distilled spirits or wines for nonindustrial use or of beer.")
rule Section5551dAnnualRule(p: Person, year: Integer) defeasible {
    label en official "section 5551(d)(1): a taxpayer on the section 5061(d)(4)(A) annual period is likewise not required to furnish the bond";
    when alcohol_return_period(p, year, Annual);
    then bond_not_required_under_5551d(p, year);
}
pub relation business_bonds_condition_met_or_bond_excepted(p: Person, b: ChapterFiftyOneBusiness) kind institutional {
    label en unofficial "all required bonds are approved, or the taxpayer is excepted under section 5551(d) (helper)";
}
rule Section5551aApprovedRule(p: Person, b: ChapterFiftyOneBusiness) strict {
    label en unofficial "bonds approved";
    when all_required_bonds_approved(p, b);
    then business_bonds_condition_met_or_bond_excepted(p, b);
}
pub relation business_year(p: Person, year: Integer) kind empirical {
    label en official "the calendar year in which the business is conducted";
}
rule Section5551aExceptedRule(p: Person, b: ChapterFiftyOneBusiness, year: Integer) defeasible {
    label en unofficial "bond excepted under section 5551(d) for the year";
    when commences_or_continues_business(p, b);
    when business_year(p, year);
    when bond_not_required_under_5551d(p, year);
    then business_bonds_condition_met_or_bond_excepted(p, b);
}
@source(IRC_S5551_A, coverage = exact, quote = "no individual, firm, partnership, corporation, or association, intending to commence or to continue the business of a distiller, warehouseman, processor, brewer, or winemaker, shall commence or continue the business of a distiller, warehouseman, processor, brewer, or winemaker until all bonds in respect of such a business, required by any provision of law, have been approved")
rule Section5551aBondApprovalProhibitionRule(p: Person, b: ChapterFiftyOneBusiness) defeasible {
    label en official "section 5551(a): no distiller, warehouseman, processor, brewer, or winemaker business is commenced or continued until all required bonds are approved, except the section 5551(d) taxpayers";
    when commences_or_continues_business(p, b);
    unless business_bonds_condition_met_or_bond_excepted(p, b) and commences_or_continues_business(p, b);
    then prohibition Section5551BusinessWithoutApprovedBondProhibition {
        bearer p;
        action commences_or_continues_business(p, b);
        window [-infinity, infinity];
    };
}
pub entity ChapterFiftyOneBond {
    label en unofficial "a bond in respect of a distiller, warehouseman, processor, brewer, or winemaker business";
}
pub relation bond_giver_previously_convicted_of_fraudulent_noncompliance_or_compromised(bd: ChapterFiftyOneBond) kind empirical {
    label en official "the giver of the bond, or an owner, controller, or active manager of the giver, has been previously convicted in a court of competent jurisdiction of fraudulent noncompliance with a US law relating to internal revenue or customs taxation of spirits, wines, or beer, or the offense was compromised on payment of penalties or otherwise (section 5551(b)(1))";
}
pub relation bond_giver_previously_convicted_of_liquor_felony(bd: ChapterFiftyOneBond) kind empirical {
    label en official "the giver, or an owner, controller, or active manager of the giver, has been convicted of a felony under a law of any State, the District of Columbia, or the United States prohibiting the manufacture, sale, importation, or transportation of spirits, wine, beer, or other intoxicating liquor (section 5551(b)(2))";
}
pub relation bond_disapproval_ground_exists(bd: ChapterFiftyOneBond) kind institutional {
    label en unofficial "a section 5551(b)(1) or (b)(2) conviction ground exists (single-atom helper)";
}
rule Section5551bGround1Rule(bd: ChapterFiftyOneBond) strict {
    label en unofficial "ground (b)(1)";
    when bond_giver_previously_convicted_of_fraudulent_noncompliance_or_compromised(bd);
    then bond_disapproval_ground_exists(bd);
}
rule Section5551bGround2Rule(bd: ChapterFiftyOneBond) strict {
    label en unofficial "ground (b)(2)";
    when bond_giver_previously_convicted_of_liquor_felony(bd);
    then bond_disapproval_ground_exists(bd);
}
pub relation secretary_or_designated_officer_disapproves_bond(bd: ChapterFiftyOneBond) kind empirical {
    label en official "the Secretary of the Treasury or an officer designated by him disapproves the bond (section 5551(b))";
}
pub relation bond_disapproved(bd: ChapterFiftyOneBond) kind institutional {
    label en official "the bond is disapproved";
}
@source(IRC_S5551_B, coverage = exact, quote = "may disapprove any such bond or bonds if the individual")
rule Section5551bDisapprovalPowerRule(bd: ChapterFiftyOneBond) strict {
    label en official "section 5551(b): the Secretary's power to disapprove a bond is validly exercised only where the bond giver (or an owner, controller, or active manager) has a listed conviction (E-0239)";
    when secretary_or_designated_officer_disapproves_bond(bd);
    then power Section5551BondDisapproval {
        holder us.irc.core::Secretary;
        over bd;
        exercise secretary_or_designated_officer_disapproves_bond(bd);
        valid_when bond_disapproval_ground_exists(bd);
        effect create(bond_disapproved(bd));
        window [-infinity, infinity];
    };
}
pub relation disapproval_by_designated_officer(bd: ChapterFiftyOneBond) kind empirical {
    label en official "the disapproval is by an officer designated by the Secretary to approve or disapprove such bonds (section 5551(c))";
}
pub relation bond_giver_appeals_disapproval(bd: ChapterFiftyOneBond, p: Person) kind empirical {
    label en official "the giver of the bond appeals the disapproval to the Secretary of the Treasury or an officer designated to hear appeals (section 5551(c))";
}
pub relation disapproval_appeal_pending(bd: ChapterFiftyOneBond) kind institutional {
    label en official "the disapproval is under appeal to the Secretary (section 5551(c)); a disapproval by the Secretary or by the officer designated to hear appeals is final";
}
@source(IRC_S5551_C, coverage = exact, quote = "In case the disapproval is by an officer designated by the Secretary of the Treasury to approve or disapprove such bonds, the individual, firm, partnership, corporation, or association giving the bond may appeal from such disapproval to the Secretary of the Treasury or an officer designated by him to hear such appeals")
rule Section5551cAppealPowerRule(bd: ChapterFiftyOneBond, p: Person) strict {
    label en official "section 5551(c): the bond giver's appeal is a power that exists only against a disapproval by an officer designated to approve or disapprove bonds (E-0239: an appeal against the Secretary's own disapproval yields no effect, that disapproval being final)";
    when bond_giver_appeals_disapproval(bd, p);
    then power Section5551DisapprovalAppeal {
        holder p;
        over bd;
        exercise bond_giver_appeals_disapproval(bd, p);
        valid_when disapproval_by_designated_officer(bd);
        effect create(disapproval_appeal_pending(bd));
        window [-infinity, infinity];
    };
}

// =============================================================================
// Sections 5553, 5557, 5561, 5562
// =============================================================================

pub entity ChapterFiftyOneViolationCase {
    label en unofficial "a violation of subtitle E investigated by the Secretary (section 5557(a))";
}
pub relation violation_investigated_and_prosecution_warranted(c: ChapterFiftyOneViolationCase) kind empirical {
    label en official "the Secretary has investigated the violation and prosecution appears warranted (section 5557(a))";
}
pub relation violation_reported_to_united_states_attorney(c: ChapterFiftyOneViolationCase) kind empirical {
    label en official "the Secretary has reported the violation to the United States Attorney for the district in which it was committed (section 5557(a))";
}
@source(IRC_S5557_A, coverage = partial, quote = "in any case in which prosecution appears warranted the Secretary shall report the violation to the United States Attorney for the district in which such violation was committed")
rule Section5557aReportDutyRule(c: ChapterFiftyOneViolationCase) strict {
    label en official "section 5557(a): where prosecution appears warranted the Secretary reports the violation to the United States Attorney (the duty to investigate and the U.S. Attorney's prosecutorial duty are addressed in the coverage rows)";
    when violation_investigated_and_prosecution_warranted(c);
    then duty Section5557aReportViolationDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition violation_reported_to_united_states_attorney(c);
            window [-infinity, infinity];
        }
    };
}
pub entity DistilledSpiritsPlantExemption {
    label en unofficial "a temporary exemption of proprietors of distilled spirits plants from a provision of the internal revenue laws relating to distilled spirits (sections 5561, 5562)";
}
pub relation exemption_target_is_provision_requiring_payment_of_tax(x: DistilledSpiritsPlantExemption) kind empirical {
    label en official "the provision from which exemption is sought requires payment of the tax on distilled spirits (excluded from both sections)";
}
external judgment relation secretary_judges_national_defense_requires_exemption(x: DistilledSpiritsPlantExemption) {
    authority Secretary;
    label en official "in the Secretary's judgment it seems expedient to exempt to meet the requirements of the national defense (section 5561) — DECISION-0194 external judgment";
}
external judgment relation secretary_finds_disaster_waiver_necessary_or_desirable(x: DistilledSpiritsPlantExemption) {
    authority Secretary;
    label en official "the Secretary finds it necessary or desirable, by reason of disaster, to waive provisions of internal revenue law regarding distilled spirits (section 5562) — DECISION-0194 external judgment";
}
pub relation secretary_exempts_for_national_defense(x: DistilledSpiritsPlantExemption) kind empirical {
    label en official "the Secretary temporarily exempts proprietors under section 5561";
}
pub relation secretary_exempts_by_reason_of_disaster(x: DistilledSpiritsPlantExemption) kind empirical {
    label en official "the Secretary temporarily exempts proprietors under section 5562";
}
pub relation exemption_target_not_a_payment_of_tax_provision(x: DistilledSpiritsPlantExemption) kind institutional {
    label en unofficial "the provision exempted is not one requiring payment of the tax on distilled spirits (helper for valid_when)";
}
pub relation defense_exemption_valid_basis(x: DistilledSpiritsPlantExemption) kind institutional {
    label en unofficial "the national-defense judgment is made and the exempted provision is not a payment-of-tax provision (helper)";
}
rule Section5561ValidBasisRule(x: DistilledSpiritsPlantExemption) defeasible {
    label en unofficial "a national-defense exemption is valid when the Secretary's judgment is made and the target is not a payment-of-tax provision";
    when secretary_judges_national_defense_requires_exemption(x);
    unless exemption_target_is_provision_requiring_payment_of_tax(x) and secretary_judges_national_defense_requires_exemption(x);
    then defense_exemption_valid_basis(x);
}
pub relation disaster_exemption_valid_basis(x: DistilledSpiritsPlantExemption) kind institutional {
    label en unofficial "the disaster finding is made and the exempted provision is not a payment-of-tax provision (helper)";
}
rule Section5562ValidBasisRule(x: DistilledSpiritsPlantExemption) defeasible {
    label en unofficial "a disaster exemption is valid when the Secretary's finding is made and the target is not a payment-of-tax provision";
    when secretary_finds_disaster_waiver_necessary_or_desirable(x);
    unless exemption_target_is_provision_requiring_payment_of_tax(x) and secretary_finds_disaster_waiver_necessary_or_desirable(x);
    then disaster_exemption_valid_basis(x);
}
pub relation temporary_exemption_granted(x: DistilledSpiritsPlantExemption) kind institutional {
    label en official "proprietors of distilled spirits plants are temporarily exempt from the provision";
}
@source(IRC_S5561, coverage = partial, quote = "The Secretary may temporarily exempt proprietors of distilled spirits plants from any provision of the internal revenue laws relating to distilled spirits, except those requiring payment of the tax thereon")
rule Section5561NationalDefenseExemptionRule(x: DistilledSpiritsPlantExemption) strict {
    label en official "section 5561: the Secretary's temporary exemption power for national defense (E-0239: invalid where the provision requires payment of the tax, or absent the Secretary's judgment)";
    when secretary_exempts_for_national_defense(x);
    then power Section5561NationalDefenseExemption {
        holder us.irc.core::Secretary;
        over x;
        exercise secretary_exempts_for_national_defense(x);
        valid_when defense_exemption_valid_basis(x);
        effect create(temporary_exemption_granted(x));
        window [-infinity, infinity];
    };
}
@source(IRC_S5562, coverage = partial, quote = "he may temporarily exempt proprietors of distilled spirits plants from any provision of the internal revenue laws relating to distilled spirits, except those requiring payment of the tax thereon, to the extent he may deem necessary or desirable.")
rule Section5562DisasterExemptionRule(x: DistilledSpiritsPlantExemption) strict {
    label en official "section 5562: the Secretary's temporary exemption power by reason of disaster (E-0239: invalid where the provision requires payment of the tax, or absent the Secretary's finding)";
    when secretary_exempts_by_reason_of_disaster(x);
    then power Section5562DisasterExemption {
        holder us.irc.core::Secretary;
        over x;
        exercise secretary_exempts_by_reason_of_disaster(x);
        valid_when disaster_exemption_valid_basis(x);
        effect create(temporary_exemption_granted(x));
        window [-infinity, infinity];
    };
}
