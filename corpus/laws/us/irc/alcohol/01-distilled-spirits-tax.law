// Section 5001 — Imposition, rate, and attachment of tax (distilled spirits).
// Priority scope: (a)(1)-(3), (b), (c) fully; (a)(4)-(9) and (d) as
// classification (cross-references / consequence extensions, not a second
// computation chain).

use self::{
    ControlledGroup,
    Corporation,
    IRC_S5001_A,
    IRC_S5001_B,
    IRC_S5001_C,
    Person,
};

pub entity DistilledSpiritsOperation {
    label en unofficial "a distiller or processor of distilled spirits, or the controlled group/single-taxpayer treated as one operation under section 5001(c)(2), for purposes of the reduced-rate tiers";
}
pub entity SpiritsRemoval {
    label en unofficial "one removal (for consumption or sale) or import event of distilled spirits, the taxable event of section 5001(b)/(c)";
}
pub relation removal_by(r: SpiritsRemoval, op: DistilledSpiritsOperation) kind empirical {
    label en official "the distilled spirits operation that distilled, processed, or (as an electing importer) imported the spirits removed in this event";
}
pub relation removed_proof_gallons(r: SpiritsRemoval, gallons: Decimal) kind empirical {
    label en official "the quantity of distilled spirits in this removal, in proof gallons (section 5001(a)(1))";
}
pub relation removed_in_calendar_year(r: SpiritsRemoval, year: Integer) kind empirical {
    label en official "the calendar year of the removal for consumption or sale (section 5001(c)(1))";
}
pub relation prior_ytd_proof_gallons(r: SpiritsRemoval, gallons: Decimal) kind empirical {
    label en unofficial "the operation's cumulative proof gallons already removed for consumption or sale in the SAME calendar year, before this removal — case-asserted running total (see judgment call in the package report: a self-accumulating ledger across removals is the G1/G10/G38-class self-referential-ledger gap, not modelled here)";
}
pub relation is_distilled_spirits_operation(op: DistilledSpiritsOperation) kind empirical {
    label en unofficial "positive anchor (section 190): op is a distilled spirits operation asserted by the case";
}

// --- (a)(1)/(c): the rate of tax ---------------------------------------------

pub relation distilled_spirits_tax(r: SpiritsRemoval, amount: Money) kind institutional {
    label en official "the tax imposed by section 5001 on this removal of distilled spirits";
}

@source(IRC_S5001_A, coverage = exact, quote = "There is hereby imposed on all distilled spirits produced in or imported into the United States a tax at the rate of $13.50 on each proof gallon and a proportionate tax at the like rate on all fractional parts of a proof gallon.")
rule Section5001aStandardRateRule(r: SpiritsRemoval, op: DistilledSpiritsOperation, gallons: Decimal) defeasible {
    label en official "section 5001(a)(1): tax at the standard rate ($13.50/proof gallon) unless the reduced rate of subsection (c) applies to this removal";
    when removal_by(r, op);
    when removed_proof_gallons(r, gallons);
    unless reduced_rate_applies(r) and removal_by(r, op) and removed_proof_gallons(r, gallons);
    then distilled_spirits_tax(r, gallons * DistilledSpiritsStandardRate);
}

// --- (c)(1): reduced rate, cumulative-quantity tiers per calendar year -------
//
// Method (AGENT-BRIEF): the cumulative total BEFORE this removal is a
// case-asserted fact (`prior_ytd_proof_gallons`), not derived by summing
// every removal event inside this package (that summation is the
// self-referential-ledger class of gap TECH-GAPS.md already tracks under
// G1/G10/G38; recorded again here as a judgment call, not reproduced).
// Given that running total, the reduced-rate computation itself is ordinary
// Decimal arithmetic: each tier's portion of THIS removal is the length of
// the overlap between [prior, prior+gallons) and the tier's own bound.

pub relation reduced_rate_applies(r: SpiritsRemoval) kind institutional {
    label en official "the removal is eligible for the section 5001(c) reduced rate (a removal by a distilled spirits operation, or (c)(1) an electing importer under paragraph (3) — the (c)(3)/(c)(4) foreign-manufacturer assignment and refund mechanism itself is not separately modelled this stage, see the package report)";
}
@source(IRC_S5001_C, coverage = partial, quote = "In the case of a distilled spirits operation, the otherwise applicable tax rate under subsection (a)(1) shall be")
rule Section5001cReducedRateEligibilityRule(r: SpiritsRemoval, op: DistilledSpiritsOperation) strict {
    label en official "section 5001(c)(1): the reduced rate is available to a distilled spirits operation's own removals (the electing-importer branch of the same paragraph is INTERPRETATION-folded into `removal_by` naming the importer as the operation, per the coverage note)";
    when removal_by(r, op);
    when is_distilled_spirits_operation(op);
    then reduced_rate_applies(r);
}

pub relation tier1_portion(r: SpiritsRemoval, gallons: Decimal) kind institutional {
    label en official "the portion of this removal's proof gallons within the first (c)(1)(A) tier";
}
pub relation tier2_portion(r: SpiritsRemoval, gallons: Decimal) kind institutional {
    label en official "the portion of this removal's proof gallons within the second (c)(1)(B) tier";
}
pub relation tier3_portion(r: SpiritsRemoval, gallons: Decimal) kind institutional {
    label en official "the portion of this removal's proof gallons taxed at the standard (a)(1) rate because it lies above both reduced-rate tiers";
}
@source(IRC_S5001_C, relation = formalizes, coverage = exact, quote = "$2.70 per proof gallon on the first 100,000 proof gallons of distilled spirits")
rule Section5001cTier1PortionRule(r: SpiritsRemoval, prior: Decimal, gallons: Decimal) strict {
    label en official "the slice of this removal inside [0, 100000) proof gallons of the operation's calendar-year cumulative total";
    when reduced_rate_applies(r);
    when prior_ytd_proof_gallons(r, prior);
    when removed_proof_gallons(r, gallons);
    then tier1_portion(r, max(0.0, min(prior + gallons, DistilledSpiritsReducedTier1Cap) - prior));
}
@source(IRC_S5001_C, relation = formalizes, coverage = exact, quote = "$13.34 per proof gallon on the first 22,130,000 of [1] proof gallons of distilled spirits to which subparagraph (A) does not apply")
rule Section5001cTier2PortionRule(r: SpiritsRemoval, prior: Decimal, gallons: Decimal) strict {
    label en official "the slice of this removal inside [100000, 100000+22130000) proof gallons of the operation's calendar-year cumulative total";
    when reduced_rate_applies(r);
    when prior_ytd_proof_gallons(r, prior);
    when removed_proof_gallons(r, gallons);
    then tier2_portion(r, max(0.0, min(prior + gallons, DistilledSpiritsReducedTier1Cap + DistilledSpiritsReducedTier2Cap) - max(prior, DistilledSpiritsReducedTier1Cap)));
}
@source(IRC_S5001_C, relation = derives_from, coverage = contextual, quote = "the otherwise applicable tax rate under subsection (a)(1) shall be")
rule Section5001cTier3PortionRule(r: SpiritsRemoval, gallons: Decimal, t1: Decimal, t2: Decimal) strict {
    label en official "any remainder of this removal above both reduced-rate tiers stays at the (a)(1) standard rate";
    when reduced_rate_applies(r);
    when removed_proof_gallons(r, gallons);
    when tier1_portion(r, t1);
    when tier2_portion(r, t2);
    then tier3_portion(r, gallons - t1 - t2);
}
@source(IRC_S5001_C, coverage = exact, quote = "$2.70 per proof gallon on the first 100,000 proof gallons of distilled spirits, and")
rule Section5001cReducedRateTaxRule(r: SpiritsRemoval, t1: Decimal, t2: Decimal, t3: Decimal) strict {
    label en official "section 5001(c)(1): the reduced-rate tax on this removal is the sum of each tier's portion times its own rate";
    when tier1_portion(r, t1);
    when tier2_portion(r, t2);
    when tier3_portion(r, t3);
    then distilled_spirits_tax(r, t1 * DistilledSpiritsReducedTier1Rate + t2 * DistilledSpiritsReducedTier2Rate + t3 * DistilledSpiritsStandardRate);
}

// --- (c)(2): controlled group / single taxpayer, single application --------
//
// (c)(2)(B): "controlled group" is section 1563(a) with "more than 50
// percent" substituted for "at least 80 percent" each place it appears —
// the brother-sister test in `us.irc.corporations` is ALREADY stated at
// ">50 percent" in the current (post-1986) text of section 1563(a)(2), so
// it is reused as-is; the parent-subsidiary test needs the substituted 50%
// threshold, which `us.irc.corporations` does not expose (it keeps the
// unmodified 80% test) — a new rule here reads the imported ownership-share
// FACT relation and applies the alcohol-specific 50% threshold, rather than
// forking the `ControlledGroup`/`parent_subsidiary_controlled_group` shapes.

pub relation alcohol_controlled_group_member(group: ControlledGroup, member: Corporation) kind institutional {
    label en official "member of the controlled group for purposes of section 5001(c)(2)/5051(a)(5): section 1563(a) with 'more than 50 percent' substituted for 'at least 80 percent' each place it appears";
}
@source(IRC_S5001_C, coverage = exact, quote = "the term \"controlled group\" shall have the meaning given such term by subsection (a) of section 1563, except that \"more than 50 percent\" shall be substituted for \"at least 80 percent\" each place it appears in such subsection")
rule Section5001c2ParentSubsidiary50PctRule(group: ControlledGroup, parent: Corporation, member: Corporation, voting: Decimal, value: Decimal) defeasible {
    label en official "section 5001(c)(2)(B): the parent-subsidiary branch of section 1563(a)(1), applied at the substituted 50 percent threshold";
    when us.irc.corporations::parent_subsidiary_ownership_share(group, parent, member, voting, value);
    unless voting < 0.50 and value < 0.50 and us.irc.corporations::parent_subsidiary_ownership_share(group, parent, member, voting, value);
    then alcohol_controlled_group_member(group, member);
}
@source(IRC_S5001_C, relation = derives_from, coverage = contextual, quote = "the term \"controlled group\" shall have the meaning given such term by subsection (a) of section 1563")
rule Section5001c2BrotherSisterRule(group: ControlledGroup, member: Corporation) strict {
    label en official "section 5001(c)(2)(B): the brother-sister branch of section 1563(a)(2) is already stated at the same 'more than 50 percent' threshold in the current text, and is reused as-is (no substitution needed)";
    when us.irc.corporations::brother_sister_controlled_group(group, member);
    then alcohol_controlled_group_member(group, member);
}
// (c)(2)(A): apportionment of the group-wide tier quantities "in such
// manner as the Secretary ... shall by regulations prescribe" — the actual
// APPORTIONED SHARE is a case-asserted fact (the same idiom
// `us.irc.corporations::controlled_group_apportionment_agreement` uses for
// section 1561(a)); no default equal-share rule is derived here (TECH_GAP,
// same class as the section 1561(a) note in `us.irc.corporations`).
pub relation alcohol_tier_apportionment(group: ControlledGroup, member: Corporation, year: Integer, share_of_tier1: Decimal, share_of_tier2: Decimal) kind empirical {
    label en unofficial "case-asserted apportionment of the group-wide 100,000/22,130,000 proof-gallon tier quantities to this member for the calendar year (section 5001(c)(2)(A)); no default equal-apportionment rule is derived (TECH_GAP)";
}
// (c)(2)(C)-(D): non-corporate common-control groups and license/franchise
// single-taxpayer treatment both delegate the test to Secretary regulations
// ("principles similar to ... shall be applied") without a self-contained
// statutory test text can execute — EXTERNAL_DEPENDENCY, not modelled.

// --- (b): time of attachment (institutional effect) --------------------------

pub relation spirits_in_existence(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "distilled spirits come into existence as such (section 5001(b)), whether or not subsequently separated, transferred, or further processed";
}
pub relation tax_attached(r: SpiritsRemoval, on: Date) kind institutional {
    label en official "the tax on distilled spirits has attached as of this date (section 5001(b)) — attachment precedes and is independent of the later determination-of-tax event of section 5006";
}
@source(IRC_S5001_B, coverage = exact, quote = "The tax shall attach to distilled spirits as soon as this substance is in existence as such, whether it be subsequently separated as pure or impure spirits, or be immediately, or at any subsequent time, transferred into any other substance, either in the process of original production or by any subsequent process.")
rule Section5001bAttachmentRule(r: SpiritsRemoval, on: Date) strict {
    label en official "section 5001(b): the tax attaches to distilled spirits as soon as the substance is in existence as such";
    when spirits_in_existence(r, on);
    then tax_attached(r, on);
}

// --- (a)(4)-(9): classification, not a second computation chain -------------
//
// (a)(2) products of distillation containing spirits, (a)(3)/(a)(7) wines
// over 24% ABV and imported liqueurs/cordials taxed AS distilled spirits,
// (a)(9) Puerto Rico bay rum at the domestic rate: each is a CLASSIFICATION
// extending which removal events are "distilled spirits" for section
// 5001(a)(1)/(c) purposes, not an independent tax base; folded into
// `is_distilled_spirits_operation`/`removed_proof_gallons` by the case
// asserting the already-classified item (INTERPRETATION, coverage row).
// (a)(4)/(a)(5)/(a)(6): unlawful use of tax-free/denatured spirits or
// fruit-flavor concentrate makes the USER liable as if for a fresh removal
// — a distinct institutional-effect rule (liability reattaches on
// misuse), modelled as its own relation rather than folded into (c)'s
// removal-based tiers (those quantities are never eligible for the reduced
// rate: no "distilled spirits operation" removal occurred).

pub relation unlawful_use_of_tax_free_spirits(user: Person, gallons: Decimal, on: Date) kind empirical {
    label en official "a person removes, sells, transports, or uses distilled spirits withdrawn free of tax under section 5214(a) or 7510, in violation of law or regulation (section 5001(a)(4))";
}
pub relation liable_for_reattached_spirits_tax(user: Person, gallons: Decimal, on: Date, amount: Money) kind institutional {
    label en official "the person liable, at the standard rate, for the tax on distilled spirits whose tax-free/denatured status was forfeited by the unlawful act (section 5001(a)(4)-(6))";
}
@source(IRC_S5001_A, coverage = exact, quote = "the person so removing, selling, transporting, or using the distilled spirits shall be required to pay such tax")
rule Section5001a4UnlawfulUseRule(user: Person, gallons: Decimal, on: Date) strict {
    label en official "section 5001(a)(4): unlawful removal/sale/transport/use of tax-free-withdrawn spirits makes the actor liable for the tax at the standard rate";
    when unlawful_use_of_tax_free_spirits(user, gallons, on);
    then liable_for_reattached_spirits_tax(user, gallons, on, gallons * DistilledSpiritsStandardRate);
}
