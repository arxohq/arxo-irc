// Stage 2 (IRC-14 stage 2, DECISION-0379). Chapter 51 definitions and status
// classifications: section 5002 (spirits definitions, proof gallon, bulk
// container), section 5052 (beer, gallon, removal, brewer), section 5121(c)
// and 5122(c) (dealer classes and the 20-gallon presumption), section 5392
// (wine subchapter definitions), section 5416 (package), section 5381
// (natural wine). Every definition is LOCAL to chapter 51 ("for purposes of
// this chapter/subchapter"), not a general section 7701 definition.
// Amounts/percentages that the statute itself states are `pub const`
// (exact Decimal, no fraction approximation).

use self::{
    IRC_S5002_A,
    IRC_S5052_A,
    IRC_S5052_C,
    IRC_S5052_D,
    IRC_S5121_C,
    IRC_S5122_C,
    IRC_S5381,
    IRC_S5392_A,
    IRC_S5392_B,
    IRC_S5392_C,
    IRC_S5392_G,
    IRC_S5416,
    Person,
};

pub const SpiritsBulkContainerMinimumWineGallonsExclusive: Decimal = 1.0 {
    label en official "a container capacity in EXCESS of 1 wine gallon makes distilled spirits bulk (section 5002(a)(9))";
};
pub const BeerMinimumAlcoholByVolumePercent: Decimal = 0.5 {
    label en official "one-half of 1 percent or more of alcohol by volume (section 5052(a))";
};
pub const WholesalePresumptionWineGallons: Decimal = 20.0 {
    label en official "sales of 20 wine gallons or more to the same person at the same time (section 5121(c)(4))";
};
pub const ProofGallonFactorPerAbvPercent: Decimal = 0.02 {
    label en unofficial "proof gallon = wine gallons x (alcohol by volume percent / 50); 1/50 = 0.02 exactly. Derived from section 5002(a)(10)-(11): proof spirits is one-half alcohol by volume (100 proof = 50 percent)";
};
pub const NaturalWineMaximumTotalSolidsPercent: Decimal = 21.0 {
    label en official "not more than 21 percent by weight of total solids (section 5381)";
};
pub const LiquidSugarMinimumPurityPercent: Decimal = 60.0 {
    label en official "not less than 60 percent pure sugar by weight (60 degrees Brix) (section 5392(g))";
};
pub const PureSugarMinimumDextroseEquivalentPercent: Decimal = 95.0 {
    label en official "dextrose equivalent of not less than 95 percent on a dry basis (section 5392(c))";
};

pub entity AlcoholicLot {
    label en unofficial "a quantity of liquid or container of liquid the chapter 51 definitions classify (spirits, beer, wine, container)";
}

// --- Section 5002(a)(8): distilled spirits; (a)(10)-(11): proof gallon -------

pub relation lot_is_ethyl_alcohol_in_any_form(l: AlcoholicLot) kind empirical {
    label en official "the substance is ethyl alcohol, ethanol, or spirits of wine in any form, including all dilutions and mixtures from whatever source or process (section 5002(a)(8))";
}
pub relation lot_wine_gallons(l: AlcoholicLot, gallons: Decimal) kind empirical {
    label en official "the lot's volume in United States (wine) gallons";
}
pub relation lot_alcohol_by_volume_percent(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "the lot's ethyl alcohol content, percent by volume at 60 degrees Fahrenheit";
}
pub relation lot_container_capacity_wine_gallons(l: AlcoholicLot, gallons: Decimal) kind empirical {
    label en official "the capacity of the container holding the lot, in wine gallons (section 5002(a)(9))";
}
pub relation is_distilled_spirits_lot(l: AlcoholicLot) kind institutional {
    label en official "the lot is distilled spirits (also called alcoholic spirits or spirits) (section 5002(a)(8))";
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "mean that substance known as ethyl alcohol, ethanol, or spirits of wine in any form")
rule Section5002a8DistilledSpiritsDefinitionRule(l: AlcoholicLot) strict {
    label en official "section 5002(a)(8): ethyl alcohol in any form (any dilution or mixture) is distilled spirits";
    when lot_is_ethyl_alcohol_in_any_form(l);
    then is_distilled_spirits_lot(l);
}
pub relation lot_proof_gallons(l: AlcoholicLot, proof_gallons: Decimal) kind institutional {
    label en official "the lot's quantity in proof gallons: a United States gallon of proof spirits, or the alcoholic equivalent thereof (section 5002(a)(11))";
}
@source(IRC_S5002_A, relation = formalizes, coverage = partial, quote = "The term \"proof gallon\" means a United States gallon of proof spirits, or the alcoholic equivalent thereof.")
rule Section5002a11ProofGallonRule(l: AlcoholicLot, gallons: Decimal, abv: Decimal) strict {
    label en official "section 5002(a)(10)-(11): proof spirits is one-half alcohol by volume, so a wine gallon at abv percent alcohol is abv/50 proof gallons (judgment call: the alcoholic-equivalent conversion is arithmetic over the statutory definition, not a stated formula)";
    when lot_wine_gallons(l, gallons);
    when lot_alcohol_by_volume_percent(l, abv);
    then lot_proof_gallons(l, gallons * abv * ProofGallonFactorPerAbvPercent);
}
pub relation is_bulk_distilled_spirits(l: AlcoholicLot) kind institutional {
    label en official "bulk distilled spirits: distilled spirits in a container with a capacity in excess of 1 wine gallon (section 5002(a)(9))";
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "means distilled spirits in a container having a capacity in excess of 1 wine gallon")
rule Section5002a9BulkDistilledSpiritsRule(l: AlcoholicLot, cap: Decimal) strict {
    label en official "section 5002(a)(9): distilled spirits in a container of more than 1 wine gallon are bulk";
    when is_distilled_spirits_lot(l);
    when lot_container_capacity_wine_gallons(l, cap);
    when cap > SpiritsBulkContainerMinimumWineGallonsExclusive;
    then is_bulk_distilled_spirits(l);
}

// --- Section 5002(a)(4)-(7): distiller, processor, warehouseman ------------

pub relation produces_distilled_spirits_from_any_source(p: Person) kind empirical {
    label en official "the person produces distilled spirits from any source or substance (section 5002(a)(4)(A))";
}
pub relation brews_mash_wort_or_wash_fit_for_distillation(p: Person) kind empirical {
    label en official "the person brews or makes mash, wort, or wash fit for distillation or for the production of distilled spirits (section 5002(a)(4)(B))";
}
pub relation mash_made_in_authorized_wine_beer_or_vinegar_production(p: Person) kind empirical {
    label en official "the mash, wort, or wash is made or used in the authorized production of wine or beer, or in the production of vinegar by fermentation (section 5002(a)(4)(B) parenthetical)";
}
pub relation separates_spirits_from_fermented_substance(p: Person) kind empirical {
    label en official "the person by any process separates alcoholic spirits from any fermented substance (section 5002(a)(4)(C))";
}
pub relation keeps_still_while_making_or_keeping_mash(p: Person) kind empirical {
    label en official "making or keeping mash, wort, or wash, the person has a still in his possession or use (section 5002(a)(4)(D))";
}
pub relation is_distiller(p: Person) kind institutional {
    label en official "the term distiller includes any person described in section 5002(a)(4)(A)-(D)";
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "(A) produces distilled spirits from any source or substance,")
rule Section5002a4ADistillerProducesRule(p: Person) strict {
    label en official "section 5002(a)(4)(A): a person who produces distilled spirits from any source is a distiller";
    when produces_distilled_spirits_from_any_source(p);
    then is_distiller(p);
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "(B) brews or makes mash, wort, or wash fit for distillation or for the production of distilled spirits")
rule Section5002a4BDistillerBrewsMashRule(p: Person) defeasible {
    label en official "section 5002(a)(4)(B): a person who makes mash, wort, or wash fit for distillation is a distiller, except for the authorized production of wine or beer or vinegar by fermentation";
    when brews_mash_wort_or_wash_fit_for_distillation(p);
    unless mash_made_in_authorized_wine_beer_or_vinegar_production(p) and brews_mash_wort_or_wash_fit_for_distillation(p);
    then is_distiller(p);
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "(C) by any process separates alcoholic spirits from any fermented substance, or")
rule Section5002a4CDistillerSeparatesRule(p: Person) strict {
    label en official "section 5002(a)(4)(C): a person who separates alcoholic spirits from a fermented substance is a distiller";
    when separates_spirits_from_fermented_substance(p);
    then is_distiller(p);
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "(D) making or keeping mash, wort, or wash, has a still in his possession or use.")
rule Section5002a4DDistillerStillRule(p: Person) strict {
    label en official "section 5002(a)(4)(D): a person who, making or keeping mash, wort, or wash, has a still in possession or use is a distiller";
    when keeps_still_while_making_or_keeping_mash(p);
    then is_distiller(p);
}

pub relation manufactures_mixes_or_processes_spirits(p: Person) kind empirical {
    label en official "the person manufactures, mixes, or otherwise processes distilled spirits (section 5002(a)(5)(A)(i))";
}
pub relation manufactures_any_article(p: Person) kind empirical {
    label en official "the person manufactures any article, i.e. any substance in the manufacture of which denatured distilled spirits are used (section 5002(a)(5)(A)(ii), (a)(14))";
}
pub relation process_is_distiller_operation(p: Person) kind empirical {
    label en official "the process is the operation of a distiller (section 5002(a)(6)(A))";
}
pub relation process_is_mixing_for_immediate_consumption_after_determination(p: Person) kind empirical {
    label en official "the mixing, after determination of tax, of distilled spirits for immediate consumption (section 5002(a)(6)(B))";
}
pub relation process_is_apothecary_unfit_for_beverage(p: Person) kind empirical {
    label en official "a process performed by an apothecary on spirits used exclusively in preparing medicines unfit for beverage purposes (section 5002(a)(6)(C))";
}
pub relation is_processor_process_disregarded(p: Person) kind institutional {
    label en official "the section 5002(a)(6) processes that are not taken into account in applying paragraph (5) (single-atom helper for the unless clause)";
}
rule Section5002a6DisregardDistillerOperationRule(p: Person) strict {
    label en unofficial "the operation of a distiller is disregarded in the processor test";
    when process_is_distiller_operation(p);
    then is_processor_process_disregarded(p);
}
rule Section5002a6DisregardImmediateConsumptionRule(p: Person) strict {
    label en unofficial "post-determination mixing for immediate consumption is disregarded in the processor test";
    when process_is_mixing_for_immediate_consumption_after_determination(p);
    then is_processor_process_disregarded(p);
}
rule Section5002a6DisregardApothecaryRule(p: Person) strict {
    label en unofficial "an apothecary's medicine-preparation process is disregarded in the processor test";
    when process_is_apothecary_unfit_for_beverage(p);
    then is_processor_process_disregarded(p);
}
pub relation is_processor_of_spirits(p: Person) kind institutional {
    label en official "the term processor, with respect to distilled spirits, means any person who manufactures, mixes, or otherwise processes distilled spirits, or manufactures any article (section 5002(a)(5)(A)); includes a rectifier, bottler, and denaturer (section 5002(a)(5)(B))";
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "(i) manufactures, mixes, or otherwise processes distilled spirits, or")
rule Section5002a5AiProcessorProcessesRule(p: Person) defeasible {
    label en official "section 5002(a)(5)(A)(i) and (a)(6): a person who processes spirits is a processor, unless the process is one section 5002(a)(6) tells the reader to disregard";
    when manufactures_mixes_or_processes_spirits(p);
    unless is_processor_process_disregarded(p) and manufactures_mixes_or_processes_spirits(p);
    then is_processor_of_spirits(p);
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "(ii) manufactures any article.")
rule Section5002a5AiiProcessorArticleRule(p: Person) strict {
    label en official "section 5002(a)(5)(A)(ii): a person who manufactures any article is a processor";
    when manufactures_any_article(p);
    then is_processor_of_spirits(p);
}
pub relation stores_bulk_distilled_spirits(p: Person) kind empirical {
    label en official "the person stores bulk distilled spirits (section 5002(a)(7))";
}
pub relation is_warehouseman_of_spirits(p: Person) kind institutional {
    label en official "the term warehouseman, with respect to distilled spirits, means any person who stores bulk distilled spirits (section 5002(a)(7))";
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "means any person who stores bulk distilled spirits.")
rule Section5002a7WarehousemanRule(p: Person) strict {
    label en official "section 5002(a)(7): a person who stores bulk distilled spirits is a warehouseman";
    when stores_bulk_distilled_spirits(p);
    then is_warehouseman_of_spirits(p);
}

// --- Section 5002(a)(15): export includes shipments to a possession ---------

pub relation shipped_to_united_states_possession(l: AlcoholicLot) kind empirical {
    label en official "the lot is shipped to a possession of the United States (section 5002(a)(15))";
}
pub relation lot_is_exported_within_chapter51(l: AlcoholicLot) kind institutional {
    label en official "the lot is exported for chapter 51: export, exported, and exportation include shipments to a possession of the United States (section 5002(a)(15))";
}
@source(IRC_S5002_A, relation = formalizes, coverage = exact, quote = "include shipments to a possession of the United States.")
rule Section5002a15ExportIncludesPossessionRule(l: AlcoholicLot) strict {
    label en official "section 5002(a)(15): a shipment to a possession of the United States is an exportation";
    when shipped_to_united_states_possession(l);
    then lot_is_exported_within_chapter51(l);
}

// --- Section 5052(a): beer; (d): brewer ------------------------------------

pub relation lot_brewed_from_malt_or_substitute(l: AlcoholicLot) kind empirical {
    label en official "the fermented beverage is brewed or produced from malt, wholly or in part, or from any substitute therefor (section 5052(a))";
}
pub relation lot_is_similar_fermented_beverage(l: AlcoholicLot) kind empirical {
    label en official "the beverage is beer, ale, porter, stout, or another similar fermented beverage of any name or description, including sake or similar products (section 5052(a))";
}
pub relation lot_used_with_reference_to_distilling(l: AlcoholicLot) kind empirical {
    label en official "the term is used with reference to distilling or distilling material (section 5052(a) exclusion)";
}
pub relation is_beer_lot(l: AlcoholicLot) kind institutional {
    label en official "the lot is beer for purposes of chapter 51 (section 5052(a))";
}
@source(IRC_S5052_A, coverage = exact, quote = "containing one-half of 1 percent or more of alcohol by volume")
rule Section5052aBeerRule(l: AlcoholicLot, abv: Decimal) defeasible {
    label en official "section 5052(a): a fermented malt beverage of at least one-half of 1 percent alcohol by volume is beer, except when the term is used with reference to distilling or distilling material";
    when lot_is_similar_fermented_beverage(l);
    when lot_brewed_from_malt_or_substitute(l);
    when lot_alcohol_by_volume_percent(l, abv);
    when abv >= BeerMinimumAlcoholByVolumePercent;
    unless lot_used_with_reference_to_distilling(l) and lot_is_similar_fermented_beverage(l) and lot_brewed_from_malt_or_substitute(l) and lot_alcohol_by_volume_percent(l, abv);
    then is_beer_lot(l);
}
pub relation brews_or_produces_beer_for_sale(p: Person) kind empirical {
    label en official "the person brews beer or produces beer for sale (section 5052(d))";
}
pub relation produces_only_beer_exempt_under_5053e(p: Person) kind empirical {
    label en official "the person produces only beer exempt from tax under section 5053(e) (personal or family use)";
}
pub relation is_brewer(p: Person) kind institutional {
    label en official "the term brewer means any person who brews beer or produces beer for sale, but not a person who produces only section 5053(e) exempt beer (section 5052(d))";
}
@source(IRC_S5052_D, coverage = exact, quote = "the term \"brewer\" means any person who brews beer or produces beer for sale.")
rule Section5052dBrewerRule(p: Person) defeasible {
    label en official "section 5052(d): a person who brews beer or produces beer for sale is a brewer, unless the person produces only section 5053(e) exempt beer";
    when brews_or_produces_beer_for_sale(p);
    unless produces_only_beer_exempt_under_5053e(p) and brews_or_produces_beer_for_sale(p);
    then is_brewer(p);
}
pub entity BeerMovement {
    label en unofficial "a sale, transfer, or removal of beer at or from a brewery";
}
pub relation beer_sold_and_possession_transferred_for_consumption_at_brewery(m: BeerMovement) kind empirical {
    label en official "the sale and transfer of possession of beer for consumption at the brewery (section 5052(c)(1))";
}
pub relation beer_removed_from_brewery(m: BeerMovement) kind empirical {
    label en official "any removal of beer from the brewery (section 5052(c)(2))";
}
pub relation beer_removal_without_payment_of_tax_provided(m: BeerMovement) kind empirical {
    label en official "the removal is one for which the chapter provides removal of beer without payment of tax (section 5052(c) exception)";
}
pub relation removed_for_consumption_or_sale(m: BeerMovement) kind institutional {
    label en official "the term removed for consumption or sale, for purposes of subpart C of part I of subchapter A, means (1) sale and transfer of possession for consumption at the brewery or (2) any removal from the brewery, except as provided for removal without payment of tax (section 5052(c))";
}
@source(IRC_S5052_C, relation = formalizes, coverage = exact, quote = "The sale and transfer of possession of beer for consumption at the brewery; or")
rule Section5052c1RemovedForConsumptionOnSiteRule(m: BeerMovement) defeasible {
    label en official "section 5052(c)(1): a sale and transfer of possession of beer for consumption at the brewery is a removal for consumption or sale";
    when beer_sold_and_possession_transferred_for_consumption_at_brewery(m);
    unless beer_removal_without_payment_of_tax_provided(m) and beer_sold_and_possession_transferred_for_consumption_at_brewery(m);
    then removed_for_consumption_or_sale(m);
}
@source(IRC_S5052_C, relation = formalizes, coverage = exact, quote = "Any removal of beer from the brewery.")
rule Section5052c2RemovedFromBreweryRule(m: BeerMovement) defeasible {
    label en official "section 5052(c)(2): any removal of beer from the brewery is a removal for consumption or sale, except a removal without payment of tax";
    when beer_removed_from_brewery(m);
    unless beer_removal_without_payment_of_tax_provided(m) and beer_removed_from_brewery(m);
    then removed_for_consumption_or_sale(m);
}

// --- Sections 5121(c), 5122(c): dealer classes -----------------------------

pub relation sells_or_offers_spirits_wine_or_beer_to_another_dealer(p: Person) kind empirical {
    label en official "the person sells, or offers for sale, distilled spirits, wines, or beer to another dealer (section 5121(c)(1))";
}
pub relation sells_or_offers_only_beer_to_another_dealer(p: Person) kind empirical {
    label en official "the person sells, or offers for sale, beer, but not distilled spirits or wines, to another dealer (section 5121(c)(2))";
}
pub relation sells_or_offers_any_spirits_wine_or_beer(p: Person) kind empirical {
    label en official "the person sells, or offers for sale, any distilled spirits, wines, or beer (section 5121(c)(3))";
}
pub relation is_dealer(p: Person) kind institutional {
    label en official "the term dealer means any person who sells, or offers for sale, any distilled spirits, wines, or beer (sections 5121(c)(3), 5122(c)(4))";
}
@source(IRC_S5121_C, relation = formalizes, coverage = exact, quote = "The term \"dealer\" means any person who sells, or offers for sale, any distilled spirits, wines, or beer.")
rule Section5121c3DealerRule(p: Person) strict {
    label en official "section 5121(c)(3): a person who sells or offers for sale distilled spirits, wines, or beer is a dealer";
    when sells_or_offers_any_spirits_wine_or_beer(p);
    then is_dealer(p);
}
pub relation is_wholesale_dealer_in_beer(p: Person) kind institutional {
    label en official "wholesale dealer in beer: a dealer who sells beer, but not spirits or wines, to another dealer (section 5121(c)(2))";
}
@source(IRC_S5121_C, relation = formalizes, coverage = exact, quote = "The term \"wholesale dealer in beer\" means any dealer who sells, or offers for sale, beer, but not distilled spirits or wines, to another dealer.")
rule Section5121c2WholesaleBeerDealerRule(p: Person) strict {
    label en official "section 5121(c)(2): a dealer who sells only beer to another dealer is a wholesale dealer in beer";
    when is_dealer(p);
    when sells_or_offers_only_beer_to_another_dealer(p);
    then is_wholesale_dealer_in_beer(p);
}
pub relation is_wholesale_dealer_in_liquors(p: Person) kind institutional {
    label en official "wholesale dealer in liquors: a dealer, other than a wholesale dealer in beer, who sells spirits, wines, or beer to another dealer (section 5121(c)(1))";
}
@source(IRC_S5121_C, relation = formalizes, coverage = exact, quote = "The term \"wholesale dealer in liquors\" means any dealer (other than a wholesale dealer in beer) who sells, or offers for sale, distilled spirits, wines, or beer, to another dealer.")
rule Section5121c1WholesaleLiquorDealerRule(p: Person) defeasible {
    label en official "section 5121(c)(1): a dealer selling spirits, wines, or beer to another dealer is a wholesale dealer in liquors unless it is a wholesale dealer in beer";
    when is_dealer(p);
    when sells_or_offers_spirits_wine_or_beer_to_another_dealer(p);
    unless is_wholesale_dealer_in_beer(p) and is_dealer(p) and sells_or_offers_spirits_wine_or_beer_to_another_dealer(p);
    then is_wholesale_dealer_in_liquors(p);
}
pub relation sells_to_non_dealer(p: Person) kind empirical {
    label en official "the person sells, or offers for sale, to any person other than a dealer (section 5122(c)(1)-(2))";
}
pub relation sells_only_beer_to_non_dealer(p: Person) kind empirical {
    label en official "the person sells, or offers for sale, beer, but not distilled spirits or wines, to a person other than a dealer (section 5122(c)(2))";
}
pub relation is_limited_retail_dealer(p: Person) kind empirical {
    label en official "a fraternal, civic, church, labor, charitable, benevolent, or ex-servicemen's organization selling at an entertainment, dance, picnic, bazaar, or festival, or a person selling to members, guests, or patrons of bona fide fairs, reunions, picnics, carnivals, or similar outings, not otherwise engaged in the business (section 5122(c)(3)) — the organization and occasion tests are case-asserted";
}
pub relation is_retail_dealer_in_beer(p: Person) kind institutional {
    label en official "retail dealer in beer: a dealer (other than a limited retail dealer) who sells beer, but not spirits or wines, to a non-dealer (section 5122(c)(2))";
}
@source(IRC_S5122_C, relation = formalizes, coverage = exact, quote = "The term \"retail dealer in beer\" means any dealer (other than a limited retail dealer) who sells, or offers for sale, beer, but not distilled spirits or wines, to any person other than a dealer.")
rule Section5122c2RetailBeerDealerRule(p: Person) defeasible {
    label en official "section 5122(c)(2): a dealer selling only beer to non-dealers is a retail dealer in beer, other than a limited retail dealer";
    when is_dealer(p);
    when sells_only_beer_to_non_dealer(p);
    unless is_limited_retail_dealer(p) and is_dealer(p) and sells_only_beer_to_non_dealer(p);
    then is_retail_dealer_in_beer(p);
}
pub relation is_retail_dealer_in_liquors(p: Person) kind institutional {
    label en official "retail dealer in liquors: a dealer (other than a retail dealer in beer or a limited retail dealer) who sells spirits, wines, or beer to a non-dealer (section 5122(c)(1))";
}
@source(IRC_S5122_C, relation = formalizes, coverage = exact, quote = "The term \"retail dealer in liquors\" means any dealer (other than a retail dealer in beer or a limited retail dealer) who sells, or offers for sale, distilled spirits, wines, or beer, to any person other than a dealer.")
rule Section5122c1RetailLiquorDealerRule(p: Person) defeasible {
    label en official "section 5122(c)(1): a dealer selling spirits, wines, or beer to non-dealers is a retail dealer in liquors, other than a retail dealer in beer or a limited retail dealer";
    when is_dealer(p);
    when sells_to_non_dealer(p);
    unless is_retail_dealer_in_beer(p) and is_dealer(p) and sells_to_non_dealer(p);
    unless is_limited_retail_dealer(p) and is_dealer(p) and sells_to_non_dealer(p);
    then is_retail_dealer_in_liquors(p);
}

// --- Section 5121(c)(4): the 20-gallon presumption --------------------------

pub relation single_sale_wine_gallons_to_same_person(p: Person, gallons: Decimal) kind empirical {
    label en official "quantity, in wine gallons, of spirits, wines, or beer sold or offered for sale to the same person at the same time (section 5121(c)(4))";
}
pub relation sale_was_to_a_person_other_than_a_dealer_shown(p: Person) kind empirical {
    label en official "evidence satisfactorily shows the sale or offer was made to a person other than a dealer (section 5121(c)(4), second sentence)";
}
pub relation presumed_wholesale_dealer(p: Person) kind institutional {
    label en official "the sale is presumptive evidence that the seller is engaged in the business of a wholesale dealer in liquors or in beer (section 5121(c)(4))";
}
@source(IRC_S5121_C, relation = formalizes, coverage = exact, quote = "in quantities of 20 wine gallons or more to the same person at the same time, shall be presumptive evidence")
rule Section5121c4WholesalePresumptionRule(p: Person, gallons: Decimal) defeasible {
    label en official "section 5121(c)(4): a sale or offer of 20 wine gallons or more to the same person at the same time presumes wholesale dealing; the presumption is overcome by satisfactory evidence that the buyer was not a dealer";
    when single_sale_wine_gallons_to_same_person(p, gallons);
    when gallons >= WholesalePresumptionWineGallons;
    unless sale_was_to_a_person_other_than_a_dealer_shown(p) and single_sale_wine_gallons_to_same_person(p, gallons);
    then presumed_wholesale_dealer(p);
}

// --- Section 5392: wine subchapter definitions and 5381 natural wine -------

pub relation lot_is_sugar_of_pure_refined_type(l: AlcoholicLot) kind empirical {
    label en official "refined sugar suitable for human consumption produced from cane, beets, fruit, grain, or other starch sources (section 5392(c))";
}
pub relation lot_dextrose_equivalent_percent(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "dextrose equivalent, percent on a dry basis (section 5392(c))";
}
pub relation is_pure_sugar(l: AlcoholicLot) kind institutional {
    label en official "pure sugar for subchapter F: pure refined sugar with a dextrose equivalent of not less than 95 percent on a dry basis (section 5392(c))";
}
@source(IRC_S5392_C, coverage = exact, quote = "having a dextrose equivalent of not less than 95 percent on a dry basis")
rule Section5392cPureSugarRule(l: AlcoholicLot, de: Decimal) strict {
    label en official "section 5392(c): pure refined sugar with dextrose equivalent of at least 95 percent on a dry basis is pure sugar";
    when lot_is_sugar_of_pure_refined_type(l);
    when lot_dextrose_equivalent_percent(l, de);
    when de >= PureSugarMinimumDextroseEquivalentPercent;
    then is_pure_sugar(l);
}
pub relation lot_sugar_percent_by_weight(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "pure sugar content of a sugar-and-water solution, percent by weight (60 degrees Brix = 60 percent) (section 5392(g))";
}
pub relation is_liquid_sugar(l: AlcoholicLot) kind institutional {
    label en official "liquid sugar: a substantially colorless pure sugar and water solution containing not less than 60 percent pure sugar by weight (section 5392(g))";
}
@source(IRC_S5392_G, coverage = exact, quote = "means a substantially colorless pure sugar and water solution containing not less than 60 percent pure sugar by weight")
rule Section5392gLiquidSugarRule(l: AlcoholicLot, pct: Decimal) strict {
    label en official "section 5392(g): a substantially colorless solution of pure sugar and water with at least 60 percent pure sugar by weight is liquid sugar";
    when lot_sugar_percent_by_weight(l, pct);
    when pct >= LiquidSugarMinimumPurityPercent;
    then is_liquid_sugar(l);
}
pub relation lot_juice_of_sound_ripe_fruit_with_authorized_cellar_treatment(l: AlcoholicLot) kind empirical {
    label en official "the product of the juice or must of sound, ripe grapes or other sound, ripe fruit, made with cellar treatment authorized under section 5382 (section 5381)";
}
pub relation lot_total_solids_percent_by_weight(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "total solids, percent by weight; for wine the degrees Brix of the dealcoholized wine (section 5392(d))";
}
pub relation lot_substandard_by_reason_of_condition(l: AlcoholicLot) kind empirical {
    label en official "the wine has become substandard by reason of its condition and the condition is not corrected (section 5381, second sentence)";
}
pub relation is_natural_wine(l: AlcoholicLot) kind institutional {
    label en official "natural wine: the product of the juice or must of sound, ripe fruit, with authorized cellar treatment, containing not more than 21 percent by weight of total solids (section 5381)";
}
@source(IRC_S5381, coverage = exact, quote = "containing not more than 21 percent by weight of total solids")
rule Section5381NaturalWineRule(l: AlcoholicLot, solids: Decimal) defeasible {
    label en official "section 5381: wine made from the juice or must of sound, ripe fruit with authorized cellar treatment and total solids of at most 21 percent by weight is natural wine, unless it has become substandard by condition and the condition is uncorrected";
    when lot_juice_of_sound_ripe_fruit_with_authorized_cellar_treatment(l);
    when lot_total_solids_percent_by_weight(l, solids);
    when solids <= NaturalWineMaximumTotalSolidsPercent;
    unless lot_substandard_by_reason_of_condition(l) and lot_juice_of_sound_ripe_fruit_with_authorized_cellar_treatment(l) and lot_total_solids_percent_by_weight(l, solids);
    then is_natural_wine(l);
}
pub relation lot_is_heavy_bodied_blending_wine_candidate(l: AlcoholicLot) kind empirical {
    label en official "wine made from fruit without added sugar, with or without added wine spirits, conforming to the natural wine definition in all respects except the maximum total solids (section 5392(b))";
}
pub relation is_heavy_bodied_blending_wine(l: AlcoholicLot) kind institutional {
    label en official "heavy bodied blending wine (section 5392(b))";
}
@source(IRC_S5392_B, coverage = exact, quote = "means wine made from fruit without added sugar, and with or without added wine spirits, and conforming to the definition of natural wine in all respects except as to maximum total solids content.")
rule Section5392bHeavyBodiedBlendingWineRule(l: AlcoholicLot) strict {
    label en official "section 5392(b): heavy bodied blending wine is a natural-wine-like fruit wine without added sugar whose only departure from natural wine is the total solids ceiling";
    when lot_is_heavy_bodied_blending_wine_candidate(l);
    then is_heavy_bodied_blending_wine(l);
}
pub relation is_specially_sweetened_natural_wine(l: AlcoholicLot) kind institutional {
    label en official "specially sweetened natural wine produced under section 5385(a) (case-asserted classification)";
}
pub relation is_special_natural_wine(l: AlcoholicLot) kind empirical {
    label en official "special natural wine produced under a formula approved under section 5386(a) (case-asserted classification)";
}
pub relation is_standard_agricultural_wine(l: AlcoholicLot) kind institutional {
    label en official "standard agricultural wine made under section 5387(a) in accordance with the Secretary's regulations (case-asserted classification)";
}
pub relation is_standard_wine(l: AlcoholicLot) kind institutional {
    label en official "standard wine: natural wine, specially sweetened natural wine, special natural wine, or standard agricultural wine (section 5392(a))";
}
@source(IRC_S5392_A, coverage = exact, quote = "means natural wine, specially sweetened natural wine, special natural wine, and standard agricultural wine")
rule Section5392aStandardWineNaturalRule(l: AlcoholicLot) defeasible {
    label en official "section 5392(a): natural wine is standard wine";
    when is_natural_wine(l);
    then is_standard_wine(l);
}
@source(IRC_S5392_A, coverage = exact, quote = "means natural wine, specially sweetened natural wine, special natural wine, and standard agricultural wine")
rule Section5392aStandardWineSweetenedRule(l: AlcoholicLot) strict {
    label en official "section 5392(a): specially sweetened natural wine is standard wine";
    when is_specially_sweetened_natural_wine(l);
    then is_standard_wine(l);
}
@source(IRC_S5392_A, coverage = exact, quote = "means natural wine, specially sweetened natural wine, special natural wine, and standard agricultural wine")
rule Section5392aStandardWineSpecialRule(l: AlcoholicLot) strict {
    label en official "section 5392(a): special natural wine is standard wine";
    when is_special_natural_wine(l);
    then is_standard_wine(l);
}
@source(IRC_S5392_A, coverage = exact, quote = "means natural wine, specially sweetened natural wine, special natural wine, and standard agricultural wine")
rule Section5392aStandardWineAgriculturalRule(l: AlcoholicLot) defeasible {
    label en official "section 5392(a): standard agricultural wine is standard wine";
    when is_standard_agricultural_wine(l);
    then is_standard_wine(l);
}

// --- Section 5416: package -------------------------------------------------

pub relation lot_is_bottle_can_keg_barrel_or_original_consumer_container(l: AlcoholicLot) kind empirical {
    label en official "a bottle, can, keg, barrel, or other original consumer container (section 5416)";
}
pub relation is_beer_package(l: AlcoholicLot) kind institutional {
    label en official "package, for subchapter G: a bottle, can, keg, barrel, or other original consumer container (section 5416)";
}
@source(IRC_S5416, coverage = exact, quote = "the term \"package\" means a bottle, can, keg, barrel, or other original consumer container")
rule Section5416PackageRule(l: AlcoholicLot) strict {
    label en official "section 5416: a bottle, can, keg, barrel, or other original consumer container is a package";
    when lot_is_bottle_can_keg_barrel_or_original_consumer_container(l);
    then is_beer_package(l);
}
