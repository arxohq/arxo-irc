// Section 5051(a) — Imposition and rate of tax (beer); section 5053 —
// Exemptions (including the section 5053(e) personal/family-use homebrew
// exemption).

use self::{
    IRC_S5051_A,
    IRC_S5053_E,
    Person,
};

pub entity BeerRemoval {
    label en unofficial "a removal (for consumption or sale) of beer brewed or produced within the United States, or an import event, the taxable event of section 5051(a)";
}
pub relation removed_barrels(r: BeerRemoval, barrels: Decimal) kind empirical {
    label en official "the quantity of beer in this removal, in barrels of not more than 31 gallons (section 5051(a)(1)(B))";
}
pub relation beer_removed_by(r: BeerRemoval, brewer: Person) kind empirical {
    label en official "the brewer (or electing importer under (a)(4)) who removed the beer for consumption or sale";
}
pub relation prior_ytd_barrels(r: BeerRemoval, barrels: Decimal) kind empirical {
    label en unofficial "the brewer's cumulative barrels already removed for consumption or sale in the SAME calendar year, before this removal — case-asserted running total (same judgment call as sections 5001(c)/5041(c): no self-accumulating ledger derived, TECH_GAP)";
}
pub relation brewer_annual_production_barrels(brewer: Person, year: Integer, barrels: Decimal) kind empirical {
    label en official "the brewer's total barrels of beer produced during the calendar year (section 5051(a)(2)(A) small-brewer eligibility test)";
}

// --- (a)(1): the general two-tier rate (all brewers) --------------------------

pub relation beer_tax(r: BeerRemoval, amount: Money) kind institutional {
    label en official "the tax imposed by section 5051(a) on this removal of beer";
}
pub relation beer_tier1_portion(r: BeerRemoval, barrels: Decimal) kind institutional {
    label en official "the portion of this removal's barrels within the first (a)(1)(A)(i) tier (6,000,000-barrel reduced rate)";
}
pub relation beer_tier2_portion(r: BeerRemoval, barrels: Decimal) kind institutional {
    label en official "the portion of this removal's barrels above the first tier, taxed at the (a)(1)(A)(ii) standard rate";
}
@source(IRC_S5051_A, relation = formalizes, coverage = exact, quote = "$16 on the first 6,000,000 barrels of beer")
rule Section5051aTier1PortionRule(r: BeerRemoval, prior: Decimal, barrels: Decimal) strict {
    label en official "the slice of this removal inside [0, 6000000) barrels of the brewer's calendar-year cumulative total";
    when prior_ytd_barrels(r, prior);
    when removed_barrels(r, barrels);
    then beer_tier1_portion(r, max(0.0, min(prior + barrels, BeerReducedTier1Cap) - prior));
}
@source(IRC_S5051_A, relation = derives_from, coverage = contextual, quote = "$18 on any barrels of beer to which clause (i) does not apply.")
rule Section5051aTier2PortionRule(r: BeerRemoval, barrels: Decimal, t1: Decimal) strict {
    label en official "any remainder of this removal above the first tier is taxed at the standard rate";
    when removed_barrels(r, barrels);
    when beer_tier1_portion(r, t1);
    then beer_tier2_portion(r, barrels - t1);
}
@source(IRC_S5051_A, coverage = exact, quote = "A tax is hereby imposed on all beer brewed or produced, and removed for consumption or sale, within the United States, or imported into the United States.")
rule Section5051aGeneralRateTaxRule(r: BeerRemoval, t1: Decimal, t2: Decimal) defeasible {
    label en official "section 5051(a)(1): tax is the sum of each tier's barrels times its own rate, unless the small-brewer rate of (a)(2) applies instead to the whole removal";
    unless small_brewer_rate_applies(r) and beer_tier1_portion(r, t1) and beer_tier2_portion(r, t2);
    when beer_tier1_portion(r, t1);
    when beer_tier2_portion(r, t2);
    then beer_tax(r, t1 * BeerReducedTier1Rate + t2 * BeerStandardRate);
}

// --- (a)(2): small brewer's own reduced rate on its first 60,000 barrels ----

pub relation small_brewer_rate_applies(r: BeerRemoval) kind institutional {
    label en official "the brewer qualifies for the section 5051(a)(2) small-brewer rate: it produced not more than 2,000,000 barrels of beer during the calendar year";
}
@source(IRC_S5051_A, coverage = exact, quote = "In the case of a brewer who produces not more than 2,000,000 barrels of beer during the calendar year, the per barrel rate of the tax imposed by this section shall be $3.50 on the first 60,000 barrels of beer which are removed in such year for consumption or sale and which have been brewed or produced by such brewer at qualified breweries in the United States.")
rule Section5051a2SmallBrewerEligibilityRule(brewer: Person, year: Integer, produced: Decimal) strict {
    label en official "section 5051(a)(2)(A): a brewer producing at most 2,000,000 barrels in the calendar year qualifies for the small-brewer rate";
    when brewer_annual_production_barrels(brewer, year, produced);
    when produced <= BeerSmallBrewerProductionCeiling;
    then small_brewer_eligible(brewer, year);
}
pub relation small_brewer_eligible(brewer: Person, year: Integer) kind institutional {
    label en official "the brewer is a qualifying small brewer for the calendar year (section 5051(a)(2)(A))";
}
pub relation beer_removal_in_calendar_year(r: BeerRemoval, year: Integer) kind empirical {
    label en official "the calendar year in which this beer removal occurs (section 5051(a)(2)(A))";
}
@source(IRC_S5051_A, relation = derives_from, coverage = contextual, quote = "the per barrel rate of the tax imposed by this section shall be $3.50 on the first 60,000 barrels of beer")
rule Section5051a2SmallBrewerRateAppliesRule(r: BeerRemoval, brewer: Person, year: Integer) strict {
    label en official "the small-brewer rate applies to a qualifying small brewer's own removal";
    when beer_removed_by(r, brewer);
    when beer_removal_in_calendar_year(r, year);
    when small_brewer_eligible(brewer, year);
    then small_brewer_rate_applies(r);
}
pub relation small_brewer_tier_portion(r: BeerRemoval, barrels: Decimal) kind institutional {
    label en official "the portion of this removal's barrels within the 60,000-barrel small-brewer tier";
}
pub relation small_brewer_remainder_portion(r: BeerRemoval, barrels: Decimal) kind institutional {
    label en official "the portion of this removal's barrels above the small-brewer's own 60,000-barrel tier, falling back to the general (a)(1) schedule";
}
@source(IRC_S5051_A, relation = formalizes, coverage = exact, quote = "$3.50 on the first 60,000 barrels of beer which are removed in such year")
rule Section5051a2TierPortionRule(r: BeerRemoval, prior: Decimal, barrels: Decimal) strict {
    label en official "the slice of this removal inside [0, 60000) barrels of the small brewer's calendar-year cumulative total";
    when small_brewer_rate_applies(r);
    when prior_ytd_barrels(r, prior);
    when removed_barrels(r, barrels);
    then small_brewer_tier_portion(r, max(0.0, min(prior + barrels, BeerSmallBrewerCap) - prior));
}
rule Section5051a2RemainderPortionRule(r: BeerRemoval, barrels: Decimal, tier: Decimal) strict {
    label en official "any remainder of a small brewer's removal above its own 60,000-barrel tier falls back to the general (a)(1) two-tier schedule";
    when small_brewer_rate_applies(r);
    when removed_barrels(r, barrels);
    when small_brewer_tier_portion(r, tier);
    then small_brewer_remainder_portion(r, barrels - tier);
}
@source(IRC_S5051_A, coverage = exact, quote = "the per barrel rate of the tax imposed by this section shall be $3.50 on the first 60,000 barrels")
rule Section5051a2SmallBrewerTaxRule(r: BeerRemoval, tier: Decimal, remainder: Decimal) strict {
    label en official "section 5051(a)(2): the small brewer's tax is $3.50 per barrel on its own first 60,000 barrels, plus the general (a)(1) rate on any remainder";
    when small_brewer_tier_portion(r, tier);
    when small_brewer_remainder_portion(r, remainder);
    then beer_tax(r, tier * BeerSmallBrewerRate + remainder * BeerReducedTier1Rate);
}
// (a)(2)(B) (anti-benefiting-large-producers regulations), (a)(3) (barrel
// tolerances), (a)(4) (foreign-brewer reduced-rate assignment to importers,
// mirrors section 5001(c)(3)), (a)(5) (controlled-group apportionment,
// mirrors section 5001(c)(2) — see `alcohol_controlled_group_member` in
// module 01, reused for beer via the same import), (a)(6) (post-2022
// foreign-production refund-in-lieu, mirrors section 5001(c)(4)): not
// independently re-derived this stage — each is the SAME structural gap
// already named for its section 5001(c) counterpart (EXTERNAL_DEPENDENCY/
// TECH_GAP, see the package report), cross-referenced rather than modelled
// twice.

// --- Section 5053(e): personal/family-use homebrew exemption ---------------

pub entity Household {
    label en unofficial "a household producing beer for personal or family use under section 5053(e)";
}
pub relation homebrew_produced_by_household(h: Household, gallons: Decimal, year: Integer) kind empirical {
    label en official "the aggregate gallons of beer a household produces for personal or family use (not for sale) during the calendar year (section 5053(e))";
}
pub relation adult_count_in_household(h: Household, count: Integer) kind empirical {
    label en official "the number of adults (age 18, or the applicable local minimum legal purchase age if greater) in the household (section 5053(e), last sentence)";
}
pub relation homebrew_exempt_from_tax(h: Household, year: Integer) kind institutional {
    label en official "the household's homebrew production for the year is within the section 5053(e) exemption limit and so is produced without payment of tax";
}
@source(IRC_S5053_E, coverage = exact, quote = "The aggregate amount of beer exempt from tax under this subsection with respect to any household shall not exceed—")
rule Section5053eMultiAdultExemptionRule(h: Household, gallons: Decimal, year: Integer, count: Integer) strict {
    label en official "section 5053(e)(1): up to 200 gallons per calendar year exempt when there are 2 or more adults in the household";
    when homebrew_produced_by_household(h, gallons, year);
    when adult_count_in_household(h, count);
    when count >= 2;
    when gallons <= HomebrewExemptionMultiAdultGallons;
    then homebrew_exempt_from_tax(h, year);
}
@source(IRC_S5053_E, coverage = exact, quote = "100 gallons per calendar year if there is only 1 adult in such household.")
rule Section5053eSingleAdultExemptionRule(h: Household, gallons: Decimal, year: Integer) strict {
    label en official "section 5053(e)(2): up to 100 gallons per calendar year exempt when there is only 1 adult in the household";
    when homebrew_produced_by_household(h, gallons, year);
    when adult_count_in_household(h, 1);
    when gallons <= HomebrewExemptionSingleAdultGallons;
    then homebrew_exempt_from_tax(h, year);
}
// (a)-(d), (f)-(h): export, souring/damage, laboratory-analysis, research,
// distilling-material, and customs-bonded-warehouse removals without
// payment of tax are each a LIBERTY-shaped exemption of the brewer's own
// conduct, conditioned on Secretary regulations the text does not itself
// state (EXTERNAL_DEPENDENCY: "under such regulations as the Secretary may
// prescribe" supplies no self-contained condition to execute) — not
// modelled as executable rules this stage; recorded in the coverage rows
// as EXTERNAL_DEPENDENCY, not silently folded into the homebrew exemption.
