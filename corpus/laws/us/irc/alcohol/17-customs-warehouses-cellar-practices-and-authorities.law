// Stage 2, last module. Small self-contained norms that the other modules
// refer to but do not declare: 5066 (customs bonded warehouses), 5101-5102
// (stills), 5113 (claims investigation), 5235 and 5241 (bottling and
// denaturing permissions), 5312-5313 (research and government withdrawals),
// 5382 (specifically authorized cellar treatments and imported-wine
// acceptance).

// =============================================================================
// Section 5066: entry into customs bonded warehouses
// =============================================================================

use self::{
    AlcoholicLot,
    DistilledSpiritsPlant,
    IRC_S5066_A,
    IRC_S5066_C,
    IRC_S5066_D,
    IRC_S5101_A,
    IRC_S5102,
    IRC_S5113,
    IRC_S5235,
    IRC_S5241,
    IRC_S5301_B,
    IRC_S5312_A,
    IRC_S5313,
    IRC_S5382_A,
    IRC_S5382_B,
    IRC_S5382_D,
    NonBeverageDrawbackClaim,
    Organ,
    Person,
    SpiritsRemoval,
    effervescent_refermentation_and_dosage_permitted,
    fruit_wine_sugar_addition_permitted_5384a,
    grape_wine_sweetening_permitted_5383a,
    high_acid_amelioration_permitted,
    is_proprietor_of_plant,
    wine_spirits_addition_is_proper_cellar_treatment,
};

pub relation spirits_entered_into_customs_bonded_warehouse_under_5066a(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "distilled spirits are entered into a customs bonded warehouse as provided in section 5066(a) on this date";
}
pub relation spirits_deemed_exported_on_entry_into_customs_warehouse(r: SpiritsRemoval, on: Date) kind institutional {
    label en official "spirits entered into a customs bonded warehouse under section 5066(a) are deemed exported at the time so entered, for this chapter (section 5066(a)(3))";
}
@source(IRC_S5066_A, coverage = exact, quote = "For the purposes of this chapter, distilled spirits entered into a customs bonded warehouse as provided in this subsection shall be deemed exported at the time so entered.")
rule Section5066a3DeemedExportedRule(r: SpiritsRemoval, on: Date) strict {
    label en official "section 5066(a)(3): entry into a customs bonded warehouse is exportation at the time of entry";
    when spirits_entered_into_customs_bonded_warehouse_under_5066a(r, on);
    then spirits_deemed_exported_on_entry_into_customs_warehouse(r, on);
}
pub relation spirits_withdrawn_from_bonded_premises_for_customs_warehouse_under_5066a1(r: SpiritsRemoval) kind empirical {
    label en official "bottled spirits are withdrawn from bonded premises as provided in section 5214(a)(4) for transfer to a customs bonded warehouse (section 5066(a)(1))";
}
pub relation treated_as_withdrawal_for_exportation_under_5214a4(r: SpiritsRemoval) kind institutional {
    label en official "the withdrawal is treated as a withdrawal for exportation, and all provisions applicable to section 5214(a)(4) withdrawals apply (section 5066(a)(1))";
}
@source(IRC_S5066_A, coverage = exact, quote = "the withdrawal of distilled spirits from bonded premises under the provisions of this paragraph shall be treated as a withdrawal for exportation")
rule Section5066a1TreatedAsExportationRule(r: SpiritsRemoval) strict {
    label en official "section 5066(a)(1): a bonded-premises withdrawal for transfer to a customs bonded warehouse is treated as a withdrawal for exportation";
    when spirits_withdrawn_from_bonded_premises_for_customs_warehouse_under_5066a1(r);
    then treated_as_withdrawal_for_exportation_under_5214a4(r);
}
pub relation spirits_marked_for_export_shipped_to_customs_warehouse_under_5066a2(r: SpiritsRemoval) kind empirical {
    label en official "distilled spirits marked especially for export under section 5062(b) are shipped to a customs bonded warehouse and entered pending withdrawal (section 5066(a)(2))";
}
pub relation chapter_applies_as_if_spirits_were_for_exportation(r: SpiritsRemoval) kind institutional {
    label en official "this chapter applies in respect of the spirits as if they were for exportation (section 5066(a)(2))";
}
@source(IRC_S5066_A, coverage = exact, quote = "and the provisions of this chapter shall apply in respect of such distilled spirits as if such spirits were for exportation.")
rule Section5066a2AsIfExportedRule(r: SpiritsRemoval) strict {
    label en official "section 5066(a)(2): export-marked spirits shipped to a customs bonded warehouse are treated as spirits for exportation";
    when spirits_marked_for_export_shipped_to_customs_warehouse_under_5066a2(r);
    then chapter_applies_as_if_spirits_were_for_exportation(r);
}
pub relation spirits_withdrawn_from_customs_warehouse_for_domestic_use(r: SpiritsRemoval) kind empirical {
    label en official "spirits entered into a customs bonded warehouse under section 5066 are withdrawn for domestic use (section 5066(c))";
}
pub relation spirits_treated_as_american_goods_exported_and_returned(r: SpiritsRemoval) kind institutional {
    label en official "the spirits are treated as American goods exported and returned (section 5066(c))";
}
@source(IRC_S5066_C, coverage = exact, quote = "in which event they shall be treated as American goods exported and returned.")
rule Section5066cAmericanGoodsReturnedRule(r: SpiritsRemoval) strict {
    label en official "section 5066(c): spirits withdrawn from the customs bonded warehouse for domestic use are treated as American goods exported and returned";
    when spirits_withdrawn_from_customs_warehouse_for_domestic_use(r);
    then spirits_treated_as_american_goods_exported_and_returned(r);
}
pub relation official_use_spirits_sold_disposed_or_possessed_for_unauthorized_use(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "spirits withdrawn from a customs bonded warehouse or brought in free of tax for the official or family use of foreign governments, organizations, or individuals are sold, or disposed of or possessed for a use other than an authorized use (section 5066(d))";
}
@source(IRC_S5066_D, coverage = partial, quote = "shall be sold, or shall be disposed of or possessed for any use other than an authorized use.")
rule Section5066dNoUnauthorizedUseRule(r: SpiritsRemoval, p: Person) strict {
    label en official "section 5066(d) first sentence: official-use free-of-tax spirits may not be sold or disposed of or possessed for an unauthorized use (the second sentence extends section 5001(a)(4) to the violator and the spirits: modelled in module 01 as classification, cross-reference only here)";
    when official_use_spirits_sold_disposed_or_possessed_for_unauthorized_use(r, p);
    then prohibition Section5066OfficialUseSpiritsDiversionProhibition {
        bearer p;
        action official_use_spirits_sold_disposed_or_possessed_for_unauthorized_use(r, p);
        window [-infinity, infinity];
    };
}

// =============================================================================
// Sections 5101, 5102: stills
// =============================================================================

pub relation person_manufactures_still_boiler_or_vessel_for_distilling(p: Person) kind empirical {
    label en official "the person manufactures any still, boiler, or other vessel to be used for the purpose of distilling (section 5101(a)(1))";
}
pub relation secretary_requires_written_notice_before_removal_of_still(p: Person) kind empirical {
    label en official "the Secretary, pursuant to regulations, requires written notice before the still is removed from the place of manufacture, setting forth by whom it is to be used, its capacity, and the time of removal (section 5101(a)(1))";
}
pub relation written_notice_of_still_removal_given(p: Person) kind empirical {
    label en official "the manufacturer has given the required written notice before removal";
}
@source(IRC_S5101_A, coverage = exact, quote = "The Secretary may, pursuant to regulations, require any person who manufactures any still, boiler, or other vessel to be used for the purpose of distilling, to give written notice, before the still, boiler, or other vessel is removed from the place of manufacture")
rule Section5101a1RemovalNoticeDutyRule(p: Person) strict {
    label en official "section 5101(a)(1): when the Secretary requires it, a still manufacturer gives written notice before the still is removed from the place of manufacture";
    when person_manufactures_still_boiler_or_vessel_for_distilling(p);
    when secretary_requires_written_notice_before_removal_of_still(p);
    then duty Section5101a1StillRemovalNoticeDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition written_notice_of_still_removal_given(p);
            window [-infinity, infinity];
        }
    };
}
pub relation secretary_requires_notice_before_setting_up_still(p: Person) kind empirical {
    label en official "the Secretary, pursuant to regulations, requires that no still, boiler, or other vessel be set up without the manufacturer first giving written notice to the Secretary (section 5101(a)(2))";
}
pub relation written_notice_of_still_setup_given(p: Person) kind empirical {
    label en official "the manufacturer has first given written notice to the Secretary of the purpose to set up the still";
}
@source(IRC_S5101_A, coverage = exact, quote = "The Secretary may, pursuant to regulations, require that no still, boiler, or other vessel be set up without the manufacturer of the still, boiler, or other vessel first giving written notice to the Secretary of that purpose.")
rule Section5101a2SetupNoticeDutyRule(p: Person) strict {
    label en official "section 5101(a)(2): when the Secretary requires it, no still is set up without the manufacturer's prior written notice";
    when person_manufactures_still_boiler_or_vessel_for_distilling(p);
    when secretary_requires_notice_before_setting_up_still(p);
    then duty Section5101a2StillSetupNoticeDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition written_notice_of_still_setup_given(p);
            window [-infinity, infinity];
        }
    };
}
pub relation person_manufactures_still_or_condenser_to_be_used_in_distilling(p: Person) kind empirical {
    label en official "the person manufactures any still or condenser to be used in distilling (section 5102)";
}
pub relation is_manufacturer_of_stills(p: Person) kind institutional {
    label en official "the person is deemed a manufacturer of stills (section 5102)";
}
@source(IRC_S5102, coverage = exact, quote = "Any person who manufactures any still or condenser to be used in distilling shall be deemed a manufacturer of stills.")
rule Section5102ManufacturerOfStillsRule(p: Person) strict {
    label en official "section 5102: a person who manufactures a still or condenser for distilling is a manufacturer of stills";
    when person_manufactures_still_or_condenser_to_be_used_in_distilling(p);
    then is_manufacturer_of_stills(p);
}

// =============================================================================
// Sections 5113, 5235, 5241, 5312(a), 5313: authorities and permissions
// =============================================================================

pub relation secretary_examines_drawback_claim_books_and_takes_testimony(s: Organ, c: NonBeverageDrawbackClaim) kind empirical {
    label en official "the Secretary examines books, papers, records, or memoranda bearing on a drawback claim, requires the attendance of the claimant or another person with knowledge, takes testimony, and administers oaths (section 5113)";
}
@source(IRC_S5113, coverage = exact, quote = "the Secretary is authorized to examine any books, papers, records, or memoranda bearing upon the matters required to be alleged in the claim")
rule Section5113InvestigationLibertyRule(c: NonBeverageDrawbackClaim) strict {
    label en official "section 5113: to ascertain the correctness of a drawback claim the Secretary may examine records, require attendance, take testimony, and administer oaths";
    when secretary_examines_drawback_claim_books_and_takes_testimony(us.irc.core::Secretary, c);
    then liberty Section5113ExamineDrawbackClaim {
        holder us.irc.core::Secretary;
        action secretary_examines_drawback_claim_books_and_takes_testimony(us.irc.core::Secretary, c);
        window [-infinity, infinity];
    };
}
pub relation industrial_alcohol_bottled_labeled_and_cased_on_bonded_premises_before_tax(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "alcohol for industrial purposes is bottled, labeled, and cased on the bonded premises of a plant prior to payment or determination of tax (section 5235)";
}
@source(IRC_S5235, coverage = exact, quote = "Alcohol for industrial purposes may be bottled, labeled, and cased on bonded premises of a distilled spirits plant prior to payment or determination of tax")
rule Section5235BottlingLibertyRule(r: SpiritsRemoval, p: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5235: a plant proprietor may bottle, label, and case industrial alcohol on bonded premises before payment or determination of tax, under the Secretary's regulations (liberty)";
    when is_proprietor_of_plant(p, plant);
    when industrial_alcohol_bottled_labeled_and_cased_on_bonded_premises_before_tax(r, p);
    then liberty Section5235BottleIndustrialAlcohol {
        holder p;
        action industrial_alcohol_bottled_labeled_and_cased_on_bonded_premises_before_tax(r, p);
        window [-infinity, infinity];
    };
}
pub relation spirits_denatured_on_bonded_premises_of_processing_plant(r: SpiritsRemoval, p: Person) kind empirical {
    label en official "spirits are denatured on the bonded premises of a distilled spirits plant qualified for the processing of distilled spirits (section 5241)";
}
@source(IRC_S5241, coverage = partial, quote = "distilled spirits may be denatured on the bonded premises of a distilled spirits plant qualified for the processing of distilled spirits.")
rule Section5241DenaturingLibertyRule(r: SpiritsRemoval, p: Person, plant: DistilledSpiritsPlant) strict {
    label en official "section 5241: a processing plant proprietor may denature spirits on its bonded premises, of the kind and proof the Secretary prescribes by regulation (EXTERNAL_DEPENDENCY) (liberty)";
    when is_proprietor_of_plant(p, plant);
    when spirits_denatured_on_bonded_premises_of_processing_plant(r, p);
    then liberty Section5241DenatureOnBondedPremises {
        holder p;
        action spirits_denatured_on_bonded_premises_of_processing_plant(r, p);
        window [-infinity, infinity];
    };
}
pub relation institution_handles_spirits_for_experimental_or_research_use_only(p: Person) kind empirical {
    label en official "a scientific university, college of learning, or institution of scientific research produces, receives, blends, treats, tests, or stores distilled spirits without payment of tax for experimental or research use, not for consumption (other than organoleptic tests) or sale, in reasonably necessary quantities (section 5312(a))";
}
pub relation research_institution_filed_bonds_and_applications(p: Person) kind empirical {
    label en official "the institution has filed the bonds and applications the Secretary requires (section 5312(a))";
}
pub relation research_spirits_exempt_from_tax(p: Person) kind institutional {
    label en official "the research spirits are handled without payment of tax (section 5312(a))";
}
@source(IRC_S5312_A, coverage = partial, quote = "any scientific university, college of learning, or institution of scientific research may produce, receive, blend, treat, test, and store distilled spirits, without payment of tax, for experimental or research use but not for consumption (other than organoleptic tests) or sale, in such quantities as may be reasonably necessary for such purposes.")
rule Section5312aResearchSpiritsExemptRule(p: Person) strict {
    label en official "section 5312(a): a scientific institution that has filed the required bonds and applications may handle research spirits without payment of tax";
    when institution_handles_spirits_for_experimental_or_research_use_only(p);
    when research_institution_filed_bonds_and_applications(p);
    then research_spirits_exempt_from_tax(p);
}
pub relation government_withdraws_spirits_free_of_tax_from_customs_custody_for_own_nonbeverage_use(r: SpiritsRemoval, g: Person) kind empirical {
    label en official "the United States or a governmental agency withdraws distilled spirits free of tax from customs custody for its own use for nonbeverage purposes (section 5313)";
}
pub relation government_is_united_states_or_agency(g: Person) kind empirical {
    label en official "the person is the United States or a governmental agency thereof";
}
@source(IRC_S5313, coverage = exact, quote = "Distilled spirits may be withdrawn free of tax from customs custody by the United States or any governmental agency thereof for its own use for nonbeverage purposes")
rule Section5313GovernmentWithdrawalLibertyRule(r: SpiritsRemoval, g: Person) strict {
    label en official "section 5313: the United States or a governmental agency may withdraw distilled spirits free of tax from customs custody for its own nonbeverage use, under the Secretary's regulations (liberty)";
    when government_is_united_states_or_agency(g);
    when government_withdraws_spirits_free_of_tax_from_customs_custody_for_own_nonbeverage_use(r, g);
    then liberty Section5313GovernmentCustomsWithdrawal {
        holder g;
        action government_withdraws_spirits_free_of_tax_from_customs_custody_for_own_nonbeverage_use(r, g);
        window [-infinity, infinity];
    };
}

// =============================================================================
// Section 5382: specifically authorized cellar treatments; imported wine
// =============================================================================

pub enum EnumeratedCellarTreatment {
    JuiceOrMustPreparation;
    WineSpiritsAddition;
    GrapeAmeliorationAndSweetening;
    FruitAmeliorationAndSweetening;
    EffervescentRefermentationAndDosage;
    NaturalDarkeningOfSugars;
    BlendingOfSameKindOfFruit;
    AcidUseForCorrection;
    VolatileFruitFlavorConcentrateAddition;
}
pub const JuiceOrMustMinimumBrix: Decimal = 22.0 {
    label en official "concentrated or unconcentrated juice or must reduced with water to not less than 22 degrees Brix is deemed juice or must (section 5382(b)(1))";
};
pub relation cellar_treatment_practice_applied(l: AlcoholicLot, practice: EnumeratedCellarTreatment) kind empirical {
    label en official "the winemaker applies this practice to the natural wine, juice, or must";
}
pub relation reconstituted_juice_or_must_brix(l: AlcoholicLot, brix: Decimal) kind empirical {
    label en official "the degrees Brix of concentrated or unconcentrated juice or must reduced with water (section 5382(b)(1))";
}
pub relation blend_components_all_from_same_kind_of_fruit(l: AlcoholicLot) kind empirical {
    label en official "the wines, juice, or wine spirits blended are all from the same kind of fruit (section 5382(b)(7))";
}
pub relation acid_use_acceptable_in_good_commercial_practice(l: AlcoholicLot) kind empirical {
    label en official "the use of acids to correct natural deficiencies and stabilize the wine is acceptable in good commercial practice (section 5382(b)(8)) — DECISION-0194 evaluative";
}
pub relation flavor_concentrate_proportion_to_wine_percent(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "the proportion of volatile fruit-flavor concentrate to the wine, percent (section 5382(b)(9))";
}
pub relation flavor_concentrate_proportion_to_original_juice_percent(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "the proportion of the volatile fruit-flavor concentrate to the original juice or must from which it was produced, percent (section 5382(b)(9))";
}
pub relation flavor_concentrate_from_same_kind_at_qualified_5511_plant_for_own_wine(l: AlcoholicLot) kind empirical {
    label en official "the concentrate was produced from the same kind (and, for grape or berry wine, variety) of fruit at a plant qualified under section 5511, for wine of the winemaker's own production (section 5382(b)(9)(A)-(B))";
}
pub relation specifically_authorized_cellar_treatment(l: AlcoholicLot, practice: EnumeratedCellarTreatment) kind institutional {
    label en official "the practice is specifically enumerated in section 5382(b) and so deemed proper cellar treatment for natural wine";
}
@source(IRC_S5382_B, coverage = exact, quote = "Concentrated juice or must reduced with water to its original density or to not less than 22 degrees Brix or unconcentrated juice or must reduced with water to not less than 22 degrees Brix shall be deemed to be juice or must")
rule Section5382b1JuiceOrMustRule(l: AlcoholicLot, brix: Decimal) strict {
    label en official "section 5382(b)(1): the preparation and use of juice or must (reduced with water to at least 22 degrees Brix) is proper cellar treatment";
    when cellar_treatment_practice_applied(l, JuiceOrMustPreparation);
    when reconstituted_juice_or_must_brix(l, brix);
    when brix >= JuiceOrMustMinimumBrix;
    then specifically_authorized_cellar_treatment(l, JuiceOrMustPreparation);
}
@source(IRC_S5382_B, coverage = exact, quote = "(2) The addition to natural wine, or to concentrated or unconcentrated juice or must, from one kind of fruit, of wine spirits")
rule Section5382b2WineSpiritsPracticeRule(l: AlcoholicLot) defeasible {
    label en official "section 5382(b)(2): a wine-spirits addition satisfying the same-fruit, 24-percent, and same-State conditions is specifically authorized";
    when cellar_treatment_practice_applied(l, WineSpiritsAddition);
    when wine_spirits_addition_is_proper_cellar_treatment(l);
    then specifically_authorized_cellar_treatment(l, WineSpiritsAddition);
}
@source(IRC_S5382_B, coverage = exact, quote = "(3) Amelioration and sweetening of natural grape wines in accordance with section 5383.")
rule Section5382b3aGrapeSweeteningPracticeRule(l: AlcoholicLot) defeasible {
    label en official "section 5382(b)(3): grape wine sweetening within section 5383(a) is specifically authorized";
    when cellar_treatment_practice_applied(l, GrapeAmeliorationAndSweetening);
    when grape_wine_sweetening_permitted_5383a(l);
    then specifically_authorized_cellar_treatment(l, GrapeAmeliorationAndSweetening);
}
@source(IRC_S5382_B, coverage = exact, quote = "(3) Amelioration and sweetening of natural grape wines in accordance with section 5383.")
rule Section5382b3bGrapeAmeliorationPracticeRule(l: AlcoholicLot) defeasible {
    label en official "section 5382(b)(3): high-acid grape wine amelioration within section 5383(b) is specifically authorized";
    when cellar_treatment_practice_applied(l, GrapeAmeliorationAndSweetening);
    when high_acid_amelioration_permitted(l);
    then specifically_authorized_cellar_treatment(l, GrapeAmeliorationAndSweetening);
}
@source(IRC_S5382_B, coverage = exact, quote = "(4) Amelioration and sweetening of natural wines from fruits other than grapes in accordance with section 5384.")
rule Section5382b4FruitPracticeRule(l: AlcoholicLot) defeasible {
    label en official "section 5382(b)(4): fruit wine sugar addition within section 5384(a) is specifically authorized";
    when cellar_treatment_practice_applied(l, FruitAmeliorationAndSweetening);
    when fruit_wine_sugar_addition_permitted_5384a(l);
    then specifically_authorized_cellar_treatment(l, FruitAmeliorationAndSweetening);
}
@source(IRC_S5382_B, coverage = exact, quote = "(5) In the case of effervescent wines, such preparations for refermentation and for dosage as may be acceptable in good commercial practice")
rule Section5382b5DosagePracticeRule(l: AlcoholicLot) strict {
    label en official "section 5382(b)(5): refermentation and dosage preparations within the 14 percent finished-product limit are specifically authorized (the good-commercial-practice standard is evaluative and asserted by the case)";
    when cellar_treatment_practice_applied(l, EffervescentRefermentationAndDosage);
    when effervescent_refermentation_and_dosage_permitted(l);
    then specifically_authorized_cellar_treatment(l, EffervescentRefermentationAndDosage);
}
@source(IRC_S5382_B, coverage = exact, quote = "(6) The natural darkening of the sugars or other elements in juice, must, or wine due to storage, concentration, heating processes, or natural oxidation.")
rule Section5382b6DarkeningPracticeRule(l: AlcoholicLot) strict {
    label en official "section 5382(b)(6): natural darkening of sugars is specifically authorized";
    when cellar_treatment_practice_applied(l, NaturalDarkeningOfSugars);
    then specifically_authorized_cellar_treatment(l, NaturalDarkeningOfSugars);
}
@source(IRC_S5382_B, coverage = exact, quote = "(7) The blending of natural wines with each other or with heavy-bodied blending wine or with concentrated or unconcentrated juice")
rule Section5382b7BlendingPracticeRule(l: AlcoholicLot) strict {
    label en official "section 5382(b)(7): blending of natural wines, heavy-bodied blending wine, or juice is specifically authorized when all components are of the same kind of fruit";
    when cellar_treatment_practice_applied(l, BlendingOfSameKindOfFruit);
    when blend_components_all_from_same_kind_of_fruit(l);
    then specifically_authorized_cellar_treatment(l, BlendingOfSameKindOfFruit);
}
@source(IRC_S5382_B, coverage = exact, quote = "(8) Such use of acids to correct natural deficiencies and stabilize the wine as may be acceptable in good commercial practice.")
rule Section5382b8AcidPracticeRule(l: AlcoholicLot) strict {
    label en official "section 5382(b)(8): acid use acceptable in good commercial practice is specifically authorized (evaluative standard, DECISION-0194)";
    when cellar_treatment_practice_applied(l, AcidUseForCorrection);
    when acid_use_acceptable_in_good_commercial_practice(l);
    then specifically_authorized_cellar_treatment(l, AcidUseForCorrection);
}
@source(IRC_S5382_B, coverage = exact, quote = "so long as the proportion of the volatile fruit-flavor concentrate to the wine does not exceed the proportion of the volatile fruit-flavor concentrate to the original juice or must from which it was produced.")
rule Section5382b9ConcentratePracticeRule(l: AlcoholicLot, share: Decimal, original: Decimal) strict {
    label en official "section 5382(b)(9): adding same-kind concentrate produced at a section 5511 plant to the winemaker's own wine is specifically authorized while its proportion to the wine does not exceed its proportion to the original juice or must";
    when cellar_treatment_practice_applied(l, VolatileFruitFlavorConcentrateAddition);
    when flavor_concentrate_from_same_kind_at_qualified_5511_plant_for_own_wine(l);
    when flavor_concentrate_proportion_to_wine_percent(l, share);
    when flavor_concentrate_proportion_to_original_juice_percent(l, original);
    when share <= original;
    then specifically_authorized_cellar_treatment(l, VolatileFruitFlavorConcentrateAddition);
}
pub relation imported_wine_produced_after_december_31_2004_on(l: AlcoholicLot, produced_on: Date) kind empirical {
    label en official "the date of production of the imported wine (section 5382(a)(3)(A))";
}
pub relation producing_country_certification_with_affirmed_lab_analysis_on_file(l: AlcoholicLot) kind empirical {
    label en official "at the time of importation the Secretary has on file or is provided a certification from the government of the producing country, accompanied by an affirmed laboratory analysis, that the practices constitute proper cellar treatment (section 5382(a)(3)(A)(i))";
}
pub relation treaty_certification_on_file(l: AlcoholicLot) kind empirical {
    label en official "the Secretary has on file or is provided the certification, if any, required by an international agreement or treaty (section 5382(a)(3)(A)(ii))";
}
pub relation importer_with_winery_affiliate_certifies_proper_cellar_treatment(l: AlcoholicLot) kind empirical {
    label en official "an importer that owns or controls, or has an affiliate that owns or controls, a winery operating under a basic permit issued by the Secretary certifies that the practices constitute proper cellar treatment (section 5382(a)(3)(A)(iii))";
}
pub relation imported_wine_acceptance_basis_present(l: AlcoholicLot) kind institutional {
    label en unofficial "at least one of the section 5382(a)(3)(A)(i)-(iii) certifications is present (single-atom helper)";
}
rule Section5382a3AiRule(l: AlcoholicLot) strict {
    label en unofficial "clause (i) certification";
    when producing_country_certification_with_affirmed_lab_analysis_on_file(l);
    then imported_wine_acceptance_basis_present(l);
}
rule Section5382a3AiiRule(l: AlcoholicLot) strict {
    label en unofficial "clause (ii) treaty certification";
    when treaty_certification_on_file(l);
    then imported_wine_acceptance_basis_present(l);
}
rule Section5382a3AiiiRule(l: AlcoholicLot) strict {
    label en unofficial "clause (iii) importer certification";
    when importer_with_winery_affiliate_certifies_proper_cellar_treatment(l);
    then imported_wine_acceptance_basis_present(l);
}
pub relation secretary_accepts_practices_used_to_produce_imported_wine(l: AlcoholicLot) kind empirical {
    label en official "the Secretary accepts the practices and procedures used to produce the imported wine (section 5382(a)(3)(A))";
}
@source(IRC_S5382_A, coverage = partial, quote = "In the case of imported wine produced after December 31, 2004, the Secretary shall accept the practices and procedures used to produce such wine, if, at the time of importation—")
rule Section5382a3ASecretaryAcceptsDutyRule(l: AlcoholicLot, produced_on: Date) defeasible {
    label en official "section 5382(a)(3)(A): for imported wine produced after December 31, 2004 the Secretary shall accept the production practices when a certification of clause (i), (ii), or (iii) is present at importation";
    when imported_wine_produced_after_december_31_2004_on(l, produced_on);
    when produced_on > @2004-12-31;
    when imported_wine_acceptance_basis_present(l);
    then duty Section5382a3AcceptPracticesDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_accepts_practices_used_to_produce_imported_wine(l);
            window [-infinity, infinity];
        }
    };
}
pub relation juice_processed_at_5511_plant_with_flavor_removed(l: AlcoholicLot) kind empirical {
    label en official "juice, concentrated juice, or must processed at a plant qualified under section 5511 from which volatile fruit flavor has been removed (section 5382(d))";
}
pub relation identical_flavor_or_equivalent_same_kind_concentrate_added(l: AlcoholicLot) kind empirical {
    label en official "at a section 5511 plant or the bonded wine cellar the identical volatile flavor removed, or an equivalent quantity of section 5511 concentrate of the same kind (and variety for grape or berry wine) for the winemaker's own wine, is added (section 5382(d)(1)-(2))";
}
pub relation juice_deemed_pure_despite_flavor_removal(l: AlcoholicLot) kind institutional {
    label en official "the juice, concentrated juice, or must may be deemed pure juice, concentrated juice, or must even though volatile fruit flavor has been removed (section 5382(d))";
}
@source(IRC_S5382_D, coverage = exact, quote = "may be deemed to be pure juice, concentrated juice, or must even though volatile fruit flavor has been removed if")
rule Section5382dDeemedPureJuiceRule(l: AlcoholicLot) strict {
    label en official "section 5382(d): juice from which flavor was removed at a section 5511 plant is deemed pure juice when the flavor, or an equivalent same-kind concentrate, is added back";
    when juice_processed_at_5511_plant_with_flavor_removed(l);
    when identical_flavor_or_equivalent_same_kind_concentrate_added(l);
    then juice_deemed_pure_despite_flavor_removal(l);
}

// =============================================================================
// Section 5301(b): returns of dispositions of spirits containers
// =============================================================================

pub relation person_disposes_of_containers_of_the_character_used_for_packaging_spirits(p: Person) kind empirical {
    label en official "the person disposes of containers of the character used for the packaging of distilled spirits (section 5301(b))";
}
pub relation secretary_requires_container_disposition_return_from(p: Person) kind empirical {
    label en official "the Secretary requires the person, for protection of the revenue, to render a return (section 5301(b): 'when required by the Secretary')";
}
pub relation container_disposition_return_rendered_and_records_kept(p: Person) kind empirical {
    label en official "the person renders a correct return showing the name and address of each transferee and the quantities, and keeps, preserves, and keeps available for inspection the records that enable a correct return (section 5301(b))";
}
@source(IRC_S5301_B, coverage = exact, quote = "Every person disposing of containers of the character used for the packaging of distilled spirits shall, when required by the Secretary for protection of the revenue, render a correct return")
rule Section5301bContainerReturnDutyRule(p: Person) strict {
    label en official "section 5301(b): a person disposing of spirits-packaging containers renders a return of each disposition, and keeps the enabling records, when the Secretary requires it (form, manner, and retention period per regulations — EXTERNAL_DEPENDENCY)";
    when person_disposes_of_containers_of_the_character_used_for_packaging_spirits(p);
    when secretary_requires_container_disposition_return_from(p);
    then duty Section5301bContainerReturnDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition container_disposition_return_rendered_and_records_kept(p);
            window [-infinity, infinity];
        }
    };
}
