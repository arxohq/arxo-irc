// 26 U.S.C. Chapter 51 (Subtitle E) — Distilled Spirits, Wines, and Beer.
// Stage 1 (IRC-14 stage 1): the alcohol excise regime's PLAN family 11
// liability -> permits -> records -> returns/payment -> consequences path,
// over the priority sections named by the task (see module map below).
// Shared type aliases, declared once (LDC-E1201/E1338: a name may be
// declared only once per package even across files).

type Person = us.irc.core::Person;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;
type Corporation = us.irc.core::Corporation;
type ControlledGroup = us.irc.corporations::ControlledGroup;

