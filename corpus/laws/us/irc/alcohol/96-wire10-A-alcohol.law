// Alcohol -- WIRE-10, group A (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 5685: the weapon class of the offense and the forfeiture of the firearm read chapter 53 (`us.irc.tobacco_firearms`).
//  (d) "machine gun" means a machine gun as defined in section 5845(b): the class is derived from `firearm_category(f, Machinegun)`.
//  (a), (b) the classes "firearm other than a machine gun or a short-barrel shotgun or rifle" and "short-barrel shotgun or rifle" are derived from the section
//      5845(a) categories of the firearm. The case-asserted `possesses_weapon_when_violating_liquor_law(p, w)` stays a valid channel.
//  (c) every such firearm is seized and forfeited and disposed of "in the manner provided by section 5872": the forfeited firearm is fed to the owner's
//      section 5872(b) disposal (`us.irc.tobacco_firearms::firearm_forfeited_under_reference_to_5872`, derived here with a qualified head).
//
// JUDGMENT CALLS
//  - Section 5685(b) names "any shotgun having a barrel or barrels less than 18 inches in length, or a rifle having a barrel or barrels less than 16 inches":
//    these are exactly the section 5845(a)(1) and (a)(3) categories; the "made from a shotgun/rifle" weapons of (a)(2), (a)(4) are not named by section 5685
//    and are therefore classed as a firearm other than the machine gun / short-barrel class unless they are also a machine gun.
//  - The forfeiture of section 5685(c) covers "every such firearm ... machine gun, shotgun, or rifle": every firearm (section 5845(a)) possessed or controlled by a
//    person when violating a liquor law. The device for emitting gas, smoke or fumes and the explosive of (c) are not chapter 53 firearms and stay outside this
//    derivation (they have no disposal owner: their forfeiture is the class-level `weapon_forfeited_under_5685c`, and "disposed of in the manner provided by section 5872" reaches
//    only what section 5872(b) itself calls a firearm).
//  - "shall be seized" is the act of the enforcing officers on the property, not a norm addressed to a person the package can name: NON_NORMATIVE
//    beside the forfeiture, which is the institutional effect derived below.

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

use self::{
    AlcoholTaxItem,
    IRC_S5001_C,
    IRC_S5041_C,
    IRC_S5051_A,
    IRC_S5061_D,
    IRC_S5685_A,
    IRC_S5685_B,
    IRC_S5685_C,
    IRC_S5685_D,
    Person,
    ViolationWeapon,
    alcohol_september_dates,
    must_pay_by_electronic_funds_transfer,
    possesses_weapon_when_violating_liquor_law,
    unpaid_tax_due_after_annual_limit_exceeded,
    unpaid_tax_due_after_quarterly_limit_exceeded,
};

pub relation firearm_possessed_when_violating_liquor_law(p: Person, f: us.irc.tobacco_firearms::Firearm) kind empirical {
    label en official "when violating, or aiding a violation of, a law relating to the manufacture, taxation, or transportation of or traffic in distilled spirits, wines, or beer, the person has this firearm (as defined in section 5845) in his possession or control (section 5685(a)-(c))";
}

@source(IRC_S5685_D, relation = formalizes, coverage = exact, quote = "As used in this section the term \"machine gun\" means a machine gun as defined in section 5845(b).")
rule W10AMachineGunClassFromSection5845b strict {
    label en official "section 5685(d): a firearm that is a machine gun as defined in section 5845(b) is a machine gun for section 5685";
    for p: Person;
    for f: us.irc.tobacco_firearms::Firearm;
    when firearm_possessed_when_violating_liquor_law(p, f)
        and us.irc.tobacco_firearms::firearm_category(f, us.irc.tobacco_firearms::Machinegun);
    then possesses_weapon_when_violating_liquor_law(p, MachineGun);
}
@source(IRC_S5685_B, relation = formalizes, coverage = partial, quote = "any shotgun having a barrel or barrels less than 18 inches in length, or a rifle having a barrel or barrels less than 16 inches in length")
rule W10AShortBarreledShotgunClass strict {
    label en official "section 5685(b): a shotgun having a barrel or barrels less than 18 inches in length (section 5845(a)(1)) is in the short-barrel class";
    for p: Person;
    for f: us.irc.tobacco_firearms::Firearm;
    when firearm_possessed_when_violating_liquor_law(p, f)
        and us.irc.tobacco_firearms::firearm_category(f, us.irc.tobacco_firearms::ShortBarreledShotgun);
    then possesses_weapon_when_violating_liquor_law(p, ShortBarrelShotgunOrRifle);
}
@source(IRC_S5685_B, relation = formalizes, coverage = partial, quote = "any shotgun having a barrel or barrels less than 18 inches in length, or a rifle having a barrel or barrels less than 16 inches in length")
rule W10AShortBarreledRifleClass strict {
    label en official "section 5685(b): a rifle having a barrel or barrels less than 16 inches in length (section 5845(a)(3)) is in the short-barrel class";
    for p: Person;
    for f: us.irc.tobacco_firearms::Firearm;
    when firearm_possessed_when_violating_liquor_law(p, f)
        and us.irc.tobacco_firearms::firearm_category(f, us.irc.tobacco_firearms::ShortBarreledRifle);
    then possesses_weapon_when_violating_liquor_law(p, ShortBarrelShotgunOrRifle);
}
@source(IRC_S5685_A, relation = formalizes, coverage = partial, quote = "or any firearm (as defined in section 5845), except a machine gun, or a shotgun having a barrel or barrels less than 18 inches in length, or a rifle having a barrel or barrels less than 16 inches in length")
rule W10AOtherFirearmClass strict {
    label en official "section 5685(a): a firearm as defined in section 5845, other than a machine gun, a shotgun under 18 inches or a rifle under 16 inches in barrel length";
    for p: Person;
    for f: us.irc.tobacco_firearms::Firearm;
    when firearm_possessed_when_violating_liquor_law(p, f)
        and us.irc.tobacco_firearms::is_chapter53_firearm(f)
        and not_known(us.irc.tobacco_firearms::firearm_category(f, us.irc.tobacco_firearms::Machinegun))
        and not_known(us.irc.tobacco_firearms::firearm_category(f, us.irc.tobacco_firearms::ShortBarreledShotgun))
        and not_known(us.irc.tobacco_firearms::firearm_category(f, us.irc.tobacco_firearms::ShortBarreledRifle));
    then possesses_weapon_when_violating_liquor_law(p, FirearmOtherThanMachineGunOrShortBarrel);
}

pub relation weapon_forfeited_under_5685c(p: Person, w: ViolationWeapon) kind institutional {
    label en official "the device, explosive, firearm, machine gun, shotgun or rifle of the given class in the possession or control of the person when violating a liquor law is seized and forfeited (section 5685(c))";
}
@source(IRC_S5685_C, relation = formalizes, coverage = partial, quote = "Every such firearm or device for emitting gas, smoke, or fumes, and every such explosive, machine gun, shotgun, or rifle, in the possession or control of any person when violating any such law, shall be seized and shall be forfeited")
rule W10AWeaponClassForfeitedOnLiquorLawViolation strict {
    label en official "section 5685(c): every device for emitting gas, smoke or fumes, explosive, firearm, machine gun, shotgun or rifle in the possession or control of a person violating a liquor law is forfeited";
    for p: Person;
    for w: ViolationWeapon;
    when possesses_weapon_when_violating_liquor_law(p, w);
    then weapon_forfeited_under_5685c(p, w);
}
pub relation firearm_forfeited_under_5685c(f: us.irc.tobacco_firearms::Firearm) kind institutional {
    label en official "the firearm in the possession or control of a person violating a liquor law is seized and forfeited (section 5685(c))";
}
@source(IRC_S5685_C, relation = formalizes, coverage = partial, quote = "shall be seized and shall be forfeited and disposed of in the manner provided by section 5872")
rule W10AFirearmForfeitedOnLiquorLawViolation strict {
    label en official "section 5685(c): every firearm (section 5845) in the possession or control of a person when violating a liquor law is forfeited";
    for p: Person;
    for f: us.irc.tobacco_firearms::Firearm;
    when firearm_possessed_when_violating_liquor_law(p, f)
        and us.irc.tobacco_firearms::is_chapter53_firearm(f);
    then firearm_forfeited_under_5685c(f);
}
@source(IRC_S5685_C, relation = formalizes, coverage = partial, quote = "disposed of in the manner provided by section 5872")
rule W10AFirearmForfeitedUnder5685cDisposedAs5872 strict {
    label en official "section 5685(c): the forfeited firearm is disposed of in the manner provided by section 5872 (the owner's section 5872(b) disposal applies)";
    for f: us.irc.tobacco_firearms::Firearm;
    when firearm_forfeited_under_5685c(f);
    then us.irc.tobacco_firearms::firearm_forfeited_under_reference_to_5872(f);
}

// =====================================================================================================================
// Sections 5001(c)(4), 5041(c)(7), 5051(a)(6): refunds in lieu of reduced rates for foreign production removed after December 31, 2022
// =====================================================================================================================
//
// The three paragraphs are the same norm for three commodities; one entity and one rule set serve all three (the @source lines name each text).
// (A) foreign production imported and removed after 2022: the reduced rate (credit for wine) does not apply and the amount of (B) is allowed to the
//     importer as a refund "in the same manner as if such amount were an overpayment of tax", only if the importer is an electing importer to whom the
//     production was assigned ((C));
// (B) the amount is the excess of the tax imposed (the reduced rate not applied) over the tax that would have been imposed had the paragraph not been
//     applied, plus interest at the section 6621(a)(1) overpayment rate (without regard to the second sentence) on the excess for the days of the
//     filing period;
// (D) for these refunds section 6611(e) applies with 90 days instead of 45.
//
// JUDGMENT CALLS AND GAPS
//  - The two tax amounts of (B)(i) are case-asserted per refund period: this package computes one tax per removal, at the rate the case establishes, so the tax
//    "as if this section were applied without regard to this paragraph" needs a second computation over the same removal, and the cumulative reduced-rate
//    tiers of sections 5001(c), 5041(c), 5051(a) (TECH_GAP, running total over the year) stay case-side.
//  - The interest is derived by the owner (`us.irc.payment_refunds_interest`, section 6621(a)(1) rate and section 6622 daily compounding), which fills the
//    stub `foreign_production_refund_interest_before_6611e` (qualified head there): the filing period must lie in ONE calendar quarter and last 1 to 92 days
//    (the owner's unrolled compounding); a longer period, or one that spans a rate change, is not derived (case-asserted stub).
//  - Section 6611(e)(1) is read here as the 90-day window after the later of the last date prescribed for filing the return and the date it is filed: a
//    refund made inside the window carries no interest. The rest of section 6611(e) (withholding tax, IRS adjustments) does not touch these excise refunds.
//  - "determined for periods not less frequently than quarterly" fixes the length of the filing period, not a norm on a person: NON_NORMATIVE.

pub enum ForeignProductionCommodity {
    DistilledSpirits5001;
    Wine5041;
    Beer5051;
    label en unofficial "the commodity of the refund in lieu of a reduced rate for foreign production: distilled spirits (section 5001(c)(4)), wine (section 5041(c)(7)), beer (section 5051(a)(6))";
}
pub entity ForeignProductionRefundPeriod {
    label en unofficial "the refund of one importer for one filing period of removals of foreign-produced spirits, wine or beer after December 31, 2022 (sections 5001(c)(4), 5041(c)(7), 5051(a)(6))";
}
pub relation refund_period_importer(rp: ForeignProductionRefundPeriod, importer: Person) kind empirical {
    label en official "the importer to whom the refund is allowed";
}
pub relation refund_period_commodity(rp: ForeignProductionRefundPeriod, c: ForeignProductionCommodity) kind empirical {
    label en unofficial "the commodity of the refund period";
}
pub relation refund_period_produced_outside_and_imported(rp: ForeignProductionRefundPeriod) kind empirical {
    label en official "the proof gallons of distilled spirits, wine gallons of wine or barrels of beer have been produced outside the United States and imported into the United States";
}
pub relation refund_period_removal_date(rp: ForeignProductionRefundPeriod, removed_on: Date) kind empirical {
    label en unofficial "the day on which the goods of the refund period are removed";
}
pub relation removed_after_december_31_2022(rp: ForeignProductionRefundPeriod) kind institutional {
    label en official "the goods are removed after December 31, 2022";
}
@source(IRC_S5001_C, relation = formalizes, coverage = partial, quote = "if such proof gallons of distilled spirits are removed after December 31, 2022")
@source(IRC_S5041_C, relation = formalizes, coverage = partial, quote = "if such wine gallons are removed after December 31, 2022")
@source(IRC_S5051_A, relation = formalizes, coverage = partial, quote = "if such barrels of beer are removed after December 31, 2022")
rule W10ARemovedAfterDecember312022 strict {
    label en official "the goods are removed after December 31, 2022";
    for rp: ForeignProductionRefundPeriod;
    for removedOn: Date;
    when refund_period_removal_date(rp, removedOn) and removedOn > @2022-12-31;
    then removed_after_december_31_2022(rp);
}
pub relation foreign_production_refund_in_scope(rp: ForeignProductionRefundPeriod) kind institutional {
    label en official "foreign production imported into the United States and removed after December 31, 2022: the paragraph applies";
}
@source(IRC_S5001_C, relation = formalizes, coverage = partial, quote = "In the case of any proof gallons of distilled spirits which have been produced outside the United States and imported into the United States")
@source(IRC_S5041_C, relation = formalizes, coverage = partial, quote = "In the case of any wine gallons of wine which have been produced outside the United States and imported into the United States")
@source(IRC_S5051_A, relation = formalizes, coverage = partial, quote = "In the case of any barrels of beer which have been produced outside the United States and imported into the United States")
rule W10AForeignProductionRefundScope strict {
    label en official "sections 5001(c)(4)(A), 5041(c)(7)(A), 5051(a)(6)(A): produced outside the United States, imported and removed after December 31, 2022";
    for rp: ForeignProductionRefundPeriod;
    when refund_period_produced_outside_and_imported(rp) and removed_after_december_31_2022(rp);
    then foreign_production_refund_in_scope(rp);
}
pub relation reduced_rate_paragraph_inapplicable(rp: ForeignProductionRefundPeriod) kind institutional {
    label en official "paragraph (1) of section 5001(c) (the credit under paragraph (1) of section 5041(c); paragraph (1)(A)(i) of section 5051(a)) does not apply to the goods";
}
@source(IRC_S5001_C, relation = formalizes, coverage = partial, quote = "paragraph (1) shall not apply")
@source(IRC_S5041_C, relation = formalizes, coverage = partial, quote = "paragraph (1) shall not apply")
@source(IRC_S5051_A, relation = formalizes, coverage = partial, quote = "paragraph (1)(A)(i) shall not apply")
rule W10AReducedRateInapplicableToForeignProduction strict {
    label en official "the reduced rate (credit) of paragraph (1) does not apply to foreign production removed after December 31, 2022";
    for rp: ForeignProductionRefundPeriod;
    when foreign_production_refund_in_scope(rp);
    then reduced_rate_paragraph_inapplicable(rp);
}

pub relation foreign_production_tax_imposed(rp: ForeignProductionRefundPeriod, amount: Money) kind empirical {
    label en official "the amount of tax imposed on the goods removed during the period, the reduced rate not being applied (sections 5001(c)(4)(B)(i)(I), 5041(c)(7)(B)(i)(I), 5051(a)(6)(B)(i)(I))";
}
pub relation foreign_production_tax_if_paragraph_not_applied(rp: ForeignProductionRefundPeriod, amount: Money) kind empirical {
    label en official "the amount of tax which would have been imposed on the goods if the section were applied without regard to the paragraph, including any allowable credits for wine (sections 5001(c)(4)(B)(i)(II), 5041(c)(7)(B)(i)(II), 5051(a)(6)(B)(i)(II))";
}
pub relation foreign_production_refund_excess(rp: ForeignProductionRefundPeriod, amount: Money) kind institutional {
    label en official "the excess (if any) of the tax imposed over the tax which would have been imposed without regard to the paragraph";
}
@source(IRC_S5001_C, relation = formalizes, coverage = partial, quote = "the excess (if any) of—")
@source(IRC_S5041_C, relation = formalizes, coverage = partial, quote = "excess (if any) of—")
@source(IRC_S5051_A, relation = formalizes, coverage = partial, quote = "excess (if any) of—")
rule W10AForeignProductionRefundExcess strict {
    label en official "section 5001(c)(4)(B)(i) (5041(c)(7)(B)(i), 5051(a)(6)(B)(i)): the excess, if any, of the tax imposed over the tax that would have been imposed without regard to the paragraph; no excess is a zero amount";
    for rp: ForeignProductionRefundPeriod;
    for imposed: Money;
    for ifNotApplied: Money;
    when foreign_production_refund_in_scope(rp)
        and foreign_production_tax_imposed(rp, imposed)
        and foreign_production_tax_if_paragraph_not_applied(rp, ifNotApplied);
    then foreign_production_refund_excess(rp, max(0 USD, imposed - ifNotApplied));
}

pub relation refund_filing_period_days(rp: ForeignProductionRefundPeriod, days: Integer) kind empirical {
    label en official "the number of days in the filing period for which the refund is being determined";
}
pub relation refund_rate_quarter_start(rp: ForeignProductionRefundPeriod, quarter_start: Date) kind empirical {
    label en unofficial "the first day of the calendar quarter whose section 6621(a)(1) overpayment rate applies to the whole filing period (the owner's compounding covers one constant-rate segment of 1 to 92 days)";
}
pub relation refund_days_in_year(rp: ForeignProductionRefundPeriod, days_in_year: Integer) kind empirical {
    label en unofficial "the days in the year (365 or 366) used as the divisor of the daily section 6622 step";
}
pub relation foreign_production_refund_interest_before_6611e(rp: ForeignProductionRefundPeriod, amount: Money) kind institutional {
    label en official "the amount of interest which would be allowed and paid on an overpayment of tax at the overpayment rate established under section 6621(a)(1) (without regard to the second sentence thereof) were such rate applied to the excess for the number of days in the filing period (derived by us.irc.payment_refunds_interest)";
}
pub relation refund_return_due_date(rp: ForeignProductionRefundPeriod, due: Date) kind empirical {
    label en unofficial "the last date prescribed for filing the return of the tax (section 6611(e)(1), applied by sections 5001(c)(4)(D), 5041(c)(7)(D), 5051(a)(6)(D))";
}
pub relation refund_return_filed_on(rp: ForeignProductionRefundPeriod, filed_on: Date) kind empirical {
    label en unofficial "the day on which the return is filed";
}
pub relation refund_made_on(rp: ForeignProductionRefundPeriod, refunded_on: Date) kind empirical {
    label en unofficial "the day on which the refund is made";
}
relation refund_return_reference_date(rp: ForeignProductionRefundPeriod, anchor: Date) kind institutional {
    label en unofficial "the later of the last date prescribed for filing the return and the day it is filed";
}
rule W10ARefundReferenceDateFiledLate strict {
    label en official "section 6611(e)(1): if the return is filed after the last date prescribed for filing, the period runs from the day it is filed";
    for rp: ForeignProductionRefundPeriod;
    for due: Date;
    for filedOn: Date;
    when refund_return_due_date(rp, due) and refund_return_filed_on(rp, filedOn) and filedOn > due;
    then refund_return_reference_date(rp, filedOn);
}
rule W10ARefundReferenceDateFiledInTime strict {
    label en official "section 6611(e)(1): a return filed on or before the last date prescribed for filing leaves the period running from that date";
    for rp: ForeignProductionRefundPeriod;
    for due: Date;
    for filedOn: Date;
    when refund_return_due_date(rp, due) and refund_return_filed_on(rp, filedOn) and filedOn <= due;
    then refund_return_reference_date(rp, due);
}
pub relation refund_made_within_90_days_6611e(rp: ForeignProductionRefundPeriod) kind institutional {
    label en official "the refund is made within 90 days (the substitute for 45) after the reference date: no interest is allowed on it";
}
@source(IRC_S5001_C, relation = formalizes, coverage = exact, quote = "section 6611(e) shall be applied by substituting \"90 days\" for \"45 days\" each place it appears")
@source(IRC_S5041_C, relation = formalizes, coverage = exact, quote = "section 6611(e) shall be applied by substituting \"90 days\" for \"45 days\" each place it appears")
@source(IRC_S5051_A, relation = formalizes, coverage = exact, quote = "section 6611(e) shall be applied by substituting \"90 days\" for \"45 days\" each place it appears")
rule W10ARefundWithin90DaysCarriesNoInterest strict {
    label en official "section 6611(e)(1) with 90 days for 45: an overpayment refunded within 90 days after the last date prescribed for filing the return (after the day it is filed, if filed later) bears no interest";
    for rp: ForeignProductionRefundPeriod;
    for anchor: Date;
    for refundedOn: Date;
    when refund_return_reference_date(rp, anchor)
        and refund_made_on(rp, refundedOn)
        and refundedOn <= add_calendar_period(anchor, 90 calendar_day);
    then refund_made_within_90_days_6611e(rp);
}
pub relation foreign_production_refund_interest(rp: ForeignProductionRefundPeriod, amount: Money) kind institutional {
    label en official "the interest component of the refund: none inside the 90-day window of section 6611(e), else the section 6621(a)(1) interest on the excess";
}
@source(IRC_S5001_C, relation = formalizes, coverage = partial, quote = "the amount of interest which would be allowed and paid on an overpayment of tax at the overpayment rate established under section 6621(a)(1) (without regard to the second sentence thereof)")
@source(IRC_S5041_C, relation = formalizes, coverage = partial, quote = "the amount of interest which would be allowed and paid on an overpayment of tax at the overpayment rate established under section 6621(a)(1) (without regard to the second sentence thereof)")
@source(IRC_S5051_A, relation = formalizes, coverage = partial, quote = "the amount of interest which would be allowed and paid on an overpayment of tax at the overpayment rate established under section 6621(a)(1) (without regard to the second sentence thereof)")
rule W10AForeignProductionRefundInterestWhenOutsideWindow strict {
    label en official "clause (ii) of subparagraph (B): the interest on the excess at the overpayment rate for the days of the filing period, unless the refund is inside the 90-day window";
    for rp: ForeignProductionRefundPeriod;
    for interest: Money;
    when foreign_production_refund_interest_before_6611e(rp, interest) and not_known(refund_made_within_90_days_6611e(rp));
    then foreign_production_refund_interest(rp, interest);
}
rule W10AForeignProductionRefundInterestInsideWindow strict {
    label en official "a refund made inside the 90-day window of section 6611(e) bears no interest";
    for rp: ForeignProductionRefundPeriod;
    when refund_made_within_90_days_6611e(rp);
    then foreign_production_refund_interest(rp, 0 USD);
}

pub relation importer_elected_and_assigned(rp: ForeignProductionRefundPeriod) kind empirical {
    label en official "the importer is an electing importer under the assignment paragraph (paragraph (3) of section 5001(c), (6) of section 5041(c), (4) of section 5051(a)) and the goods have been assigned to the importer";
}
pub relation foreign_production_refund_allowed(rp: ForeignProductionRefundPeriod, importer: Person, amount: Money) kind institutional {
    label en official "the amount determined under subparagraph (B) is allowed as a refund to the importer in the same manner as if it were an overpayment of tax";
}
@source(IRC_S5001_C, relation = formalizes, coverage = partial, quote = "the amount determined under subparagraph (B) shall be allowed as a refund, determined for periods not less frequently than quarterly, to the importer in the same manner as if such amount were an overpayment of tax imposed by this section")
@source(IRC_S5041_C, relation = formalizes, coverage = partial, quote = "the amount determined under subparagraph (B) shall be allowed as a refund, determined for periods not less frequently than quarterly, to the importer in the same manner as if such amount were an overpayment of tax imposed by this section")
@source(IRC_S5051_A, relation = formalizes, coverage = partial, quote = "the amount determined under subparagraph (B) shall be allowed as a refund, determined for periods not less frequently than quarterly, to the importer in the same manner as if such amount were an overpayment of tax imposed by this section")
rule W10AForeignProductionRefundAllowed strict {
    label en official "sections 5001(c)(4)(A)(ii), (B), (C) (5041(c)(7), 5051(a)(6)): the excess plus the interest is allowed as a refund to the electing importer to whom the goods were assigned";
    for rp: ForeignProductionRefundPeriod;
    for importer: Person;
    for excess: Money;
    for interest: Money;
    when foreign_production_refund_in_scope(rp)
        and importer_elected_and_assigned(rp)
        and refund_period_importer(rp, importer)
        and foreign_production_refund_excess(rp, excess)
        and foreign_production_refund_interest(rp, interest);
    then foreign_production_refund_allowed(rp, importer, excess + interest);
}

// =====================================================================================================================
// Section 5061(d)(6): the due date rolls to the immediately preceding business day (forward only for a Sunday (d)(5) date)
// =====================================================================================================================
//
// (d)(6) displaces section 7503 for this subsection: where the otherwise-prescribed due date would fall on a Saturday,
// Sunday, or a legal holiday within the meaning of section 7503, the due date is the immediately preceding day which
// is not one of those days -- except that a due date described in paragraph (5) (the September accelerated payment)
// that falls on a Sunday moves to the immediately following day.
//
// What this section reads. The Date-valued due dates this package already produces: the (d)(4)(B) limit-exceeded dues
// (`unpaid_tax_due_after_quarterly_limit_exceeded`, `unpaid_tax_due_after_annual_limit_exceeded`, module 18, strict
// producers) and the (d)(5) September dues derived below from `alcohol_september_dates` and the (e)(1) EFT flag.
// The regular (d)(1)/(d)(4)(A) regime dues have no Date relation in this package (only the `AlcoholReturnPeriod`
// regime), and linking a withdrawal date to its calendar year needs a date-part function the language does not give
// (same language limit as penalties 6654(a)/6655(g)(2)(A)); those dues stay outside this rollover (coverage partial).
// (d)(2)/(d)(3) (imports, Puerto Rico) stay EXTERNAL_DEPENDENCY.
//
// Calendar machinery (mirrors `us.irc.administration` module 02, which cannot be read: only `last_day_rolled` is pub
// there, and it rolls FORWARD while (d)(6) rolls BACKWARD, so there is no owner counterpart to read). `weekday_of`
// is builtin (ISO 1=Monday..7=Sunday); the rolled dates are VALIDATED, not computed -- the case supplies a candidate
// and the rules confirm it (the same validated-candidate class as the administration forward roll, with the same
// documented limitation: that no business day lies between the candidate and the base is not checked, there is no
// bounded date quantifier). The September-Sunday forward step needs no business-day walk at all: the text names
// "the immediately following day", validated by `days_between(base, candidate) == 1` (a measurement, no snapshot).
//
// JUDGMENT CALLS
//  - "Legal holiday (within the meaning of section 7503)" is a case-asserted fact (DC default plus any Statewide
//    extension; no 50-State calendar is pinned in this corpus, same as administration).
//  - The September-Sunday forward date is the immediately following day even if that day were itself a holiday: the
//    text is unqualified ("the immediately following day"), unlike the preceding-day branch.

// --- Weekend and business-day detection (computed over case-marked dates) --------------------------------------------

relation alcohol_day_in_question(d: Date) kind empirical {
    label en unofficial "the date whose calendar status (weekend/business day) is at issue in the case; needed because `weekday_of` cannot bind a rule head variable on its own (§190)";
}

relation alcohol_falls_on_weekend(d: Date) kind derived {
    label en unofficial "the date is a Saturday or a Sunday";
}

@source(IRC_S5061_D, relation = formalizes, coverage = partial, quote = "would fall on a Saturday, Sunday, or a legal holiday (within the meaning of section 7503)")
rule W10AD6WeekendSaturday(d: Date) defeasible {
    when alcohol_day_in_question(d);
    when weekday_of(d) == 6;
    then alcohol_falls_on_weekend(d);
}

@source(IRC_S5061_D, relation = formalizes, coverage = partial, quote = "would fall on a Saturday, Sunday, or a legal holiday (within the meaning of section 7503)")
rule W10AD6WeekendSunday(d: Date) defeasible {
    when alcohol_day_in_question(d);
    when weekday_of(d) == 7;
    then alcohol_falls_on_weekend(d);
}

relation alcohol_legal_holiday_7503(d: Date) kind empirical {
    label en official "the date is a legal holiday within the meaning of section 7503 (case-asserted: the District of Columbia default and any applicable Statewide extension; no holiday calendar for other years is pinned in this corpus)";
}

relation alcohol_is_business_day(d: Date) kind derived {
    label en unofficial "the date is neither a Saturday/Sunday nor a legal holiday within the meaning of section 7503";
}

@source(IRC_S5061_D, relation = formalizes, coverage = partial, quote = "would fall on a Saturday, Sunday, or a legal holiday (within the meaning of section 7503)")
rule W10AD6BusinessDay(d: Date) defeasible {
    when alcohol_day_in_question(d)
        and not_known(alcohol_falls_on_weekend(d))
        and not_known(alcohol_legal_holiday_7503(d));
    then alcohol_is_business_day(d);
}

// --- The (d)(5) September unrolled due dates --------------------------------------------------------------------------

pub relation september_unrolled_due_date(p: Person, y: Integer, due: Date) kind institutional {
    label en official "section 5061(d)(5): the unrolled September due date -- September 29 for payers using electronic funds transfer, September 28 otherwise";
}

@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "the taxes on distilled spirits, wines, and beer for the period beginning on September 16 and ending on September 26 shall be paid not later than September 29.")
rule W10AD6SeptemberUnrolledEft(p: Person, y: Integer, sep16: Date) strict {
    when must_pay_by_electronic_funds_transfer(p, y) and alcohol_september_dates(p, y, sep16);
    then september_unrolled_due_date(p, y, add_calendar_period(sep16, 13 calendar_day));
}

@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "\"September 28\" for \"September 29\"")
rule W10AD6SeptemberUnrolledNonEft(p: Person, y: Integer, sep16: Date) strict {
    when not_known(must_pay_by_electronic_funds_transfer(p, y)) and alcohol_september_dates(p, y, sep16);
    then september_unrolled_due_date(p, y, add_calendar_period(sep16, 12 calendar_day));
}

// --- The unified unrolled due date under this subsection ---------------------------------------------------------------

pub relation section_5061d_unrolled_due_date(base: Date) kind institutional {
    label en official "section 5061(d): the due date for payment of tax but for paragraph (6) -- from the (d)(4)(B) limit-exceeded dues and the (d)(5) September dues";
}

@source(IRC_S5061_D, relation = formalizes, coverage = contextual, quote = "(6) Special rule where due date falls on Saturday, Sunday, or holiday")
rule W10AD6UnrolledFromQuarterlyLimit(due: Date) strict {
    when unpaid_tax_due_after_quarterly_limit_exceeded(_, _, due);
    then section_5061d_unrolled_due_date(due);
}

@source(IRC_S5061_D, relation = formalizes, coverage = contextual, quote = "(6) Special rule where due date falls on Saturday, Sunday, or holiday")
rule W10AD6UnrolledFromAnnualLimit(due: Date) strict {
    when unpaid_tax_due_after_annual_limit_exceeded(_, _, due);
    then section_5061d_unrolled_due_date(due);
}

@source(IRC_S5061_D, relation = formalizes, coverage = contextual, quote = "(6) Special rule where due date falls on Saturday, Sunday, or holiday")
rule W10AD6UnrolledFromSeptember(p: Person, y: Integer, due: Date) strict {
    when september_unrolled_due_date(p, y, due);
    then section_5061d_unrolled_due_date(due);
}

// --- The (d)(6) rollover -------------------------------------------------------------------------------

relation preceding_business_day_candidate(base: Date, candidate: Date) kind empirical {
    label en unofficial "a candidate for the immediately preceding day which is not a Saturday, Sunday, or legal holiday, supplied by the caller (this package validates but does not compute the walk-back)";
}

relation september_sunday_forward_candidate(base: Date, candidate: Date) kind empirical {
    label en unofficial "a candidate for the immediately following day of a (d)(5) September due date that falls on a Sunday, supplied by the caller (validated as exactly one day later)";
}

pub relation section_5061d6_rolled_due_date(base: Date, rolled: Date) kind institutional {
    label en official "section 5061(d)(6): the due date for payment of tax after the weekend/holiday rollover";
}

@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "Notwithstanding section 7503, if, but for this paragraph, the due date under this subsection for payment of tax would fall on a Saturday, Sunday, or a legal holiday (within the meaning of section 7503), such due date shall be the immediately preceding day which is not a Saturday, Sunday, or such a holiday")
rule W10AD6RolledWhenBusinessDay(base: Date) defeasible {
    when section_5061d_unrolled_due_date(base)
        and alcohol_day_in_question(base)
        and alcohol_is_business_day(base);
    then section_5061d6_rolled_due_date(base, base);
}

@source(IRC_S5061_D, relation = formalizes, coverage = partial, quote = "such due date shall be the immediately preceding day which is not a Saturday, Sunday, or such a holiday")
rule W10AD6PrecedingBusinessDay(base: Date, candidate: Date) defeasible {
    when section_5061d_unrolled_due_date(base)
        and preceding_business_day_candidate(base, candidate)
        and candidate < base
        and alcohol_day_in_question(candidate)
        and alcohol_is_business_day(candidate);
    then section_5061d6_rolled_due_date(base, candidate);
}

@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "or the immediately following day where the due date described in paragraph (5) falls on a Sunday")
rule W10AD6SeptemberSundayForward(base: Date, candidate: Date) defeasible {
    when september_unrolled_due_date(_, _, base)
        and weekday_of(base) == 7
        and september_sunday_forward_candidate(base, candidate)
        and days_between(base, candidate) == 1;
    then section_5061d6_rolled_due_date(base, candidate);
}
