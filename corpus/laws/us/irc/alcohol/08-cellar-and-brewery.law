// Sections 5361 (bonded wine cellar operations) and 5401 (qualifying
// documents — brewer's notice and bond).

// --- Section 5361: bonded wine cellar operations (institutional list) ------
//
// The section enumerates WHICH additional operations a bonded wine cellar
// proprietor may conduct (receipt of taxpaid wine for return/reconditioning/
// destruction; preparing/storing non-wine commercial fruit products;
// producing/receiving distilling material or vinegar stock; producing/
// receiving certain non-beverage blending wines/wine products; other
// revenue-safe operations) — an INSTITUTIONAL-EFFECT authorization list,
// not a computation or a deontic position: it classifies which conduct on
// bonded premises is lawful wine-cellar operation. Modelled as a
// classification relation per named operation kind, since the AGENT-BRIEF
// method calls for an executable rule/position/definition wherever the text
// supports one; "such other operations as may be conducted in a manner that
// will not jeopardize the revenue" is EVALUATIVE (Secretary's own judgment
// of what does not jeopardize the revenue, DECISION-0194) and is not folded
// into the enumerated list.

use self::{
    IRC_S5361,
    IRC_S5401_A,
    IRC_S5401_B,
    Person,
};

pub entity BondedWineCellar {
    label en unofficial "bonded premises qualified for bonded wine cellar operations under section 5351 et seq.";
}
pub enum WineCellarAuxiliaryOperation {
    ReceiveTaxpaidWineForReturnReconditioningOrDestruction;
    PrepareAndStoreNonWineFruitProducts;
    ProduceOrReceiveDistillingMaterialOrVinegarStock;
    ProduceOrReceiveHeavyBodiedBlendingWinesOrSpanishSherries;
    ProduceOrReceiveOtherNonBeverageWineProducts;
}
pub relation conducts_wine_cellar_auxiliary_operation(cellar: BondedWineCellar, op: WineCellarAuxiliaryOperation) kind empirical {
    label en official "the proprietor conducts this auxiliary operation on the bonded wine cellar premises (section 5361)";
}
pub relation authorized_wine_cellar_operation(cellar: BondedWineCellar, op: WineCellarAuxiliaryOperation) kind institutional {
    label en official "the operation is one of the auxiliary operations section 5361 authorizes a bonded wine cellar proprietor to conduct, in addition to section 5351's own operations";
}
@source(IRC_S5361, coverage = exact, quote = "the proprietor of a bonded wine cellar may, subject to regulations prescribed by the Secretary, on such premises receive taxpaid wine for return to bond, reconditioning, or destruction; prepare for market and store commercial fruit products and by-products not taxable as wines; produce or receive distilling material or vinegar stock; produce (with or without added wine spirits, and without added sugar) or receive on wine premises, subject to tax as wine but not for sale or consumption as beverage wine, (1) heavy bodied blending wines and Spanish-type blending sherries, and (2) other wine products made from natural wine for nonbeverage purposes")
rule Section5361AuthorizedOperationRule(cellar: BondedWineCellar, op: WineCellarAuxiliaryOperation) strict {
    label en official "section 5361: each named auxiliary operation is authorized when conducted on the bonded wine cellar's premises (subject to Secretary regulations, EXTERNAL_DEPENDENCY for their specific content)";
    when conducts_wine_cellar_auxiliary_operation(cellar, op);
    then authorized_wine_cellar_operation(cellar, op);
}
// "such other operations as may be conducted in a manner that will not
// jeopardize the revenue or conflict with wine operations" (the closing
// clause): EVALUATIVE (DECISION-0194, Secretary's own judgment channel),
// not folded into the enum above — a sixth, open-ended category the text
// itself does not close.

// --- Section 5401: brewer's qualifying notice and bond (duty) --------------

pub entity Brewery {
    label en unofficial "the premises at which the brewer conducts business (section 5401)";
}
pub relation commences_or_continues_brewer_business(p: Person, brewery: Brewery) kind empirical {
    label en official "the brewer commences or continues business at the brewery (section 5401(a))";
}
pub relation brewer_notice_filed(p: Person, brewery: Brewery) kind empirical {
    label en official "the brewer files the section 5401(a) notice with the officer the Secretary designates";
}
@source(IRC_S5401_A, coverage = exact, quote = "Every brewer shall, before commencing or continuing business, file with the officer designated for that purpose by the Secretary a notice in writing, in such form and containing such information as the Secretary shall by regulations prescribe as necessary to protect and insure collection of the revenue.")
rule Section5401aNoticeDutyRule(p: Person, brewery: Brewery) strict {
    label en official "section 5401(a): the brewer's duty to file the qualifying notice before commencing or continuing business";
    when commences_or_continues_brewer_business(p, brewery);
    then duty Section5401NoticeDuty {
        bearer p;
        goal maintenance {
            condition brewer_notice_filed(p, brewery);
            window [-infinity, infinity];
        }
    };
}
pub relation brewer_bond_executed(p: Person, brewery: Brewery) kind empirical {
    label en official "the brewer executes the section 5401(b) bond (or a continuation certificate) to the United States, in the Secretary-prescribed penal sum";
}
@source(IRC_S5401_B, coverage = partial, quote = "Every brewer, on filing notice as provided by subsection (a) of his intention to commence business, shall execute a bond to the United States in such reasonable penal sum as the Secretary shall by regulation prescribe as necessary to protect and insure collection of the revenue.")
rule Section5401bBondDutyRule(p: Person, brewery: Brewery) defeasible {
    label en official "section 5401(b): the brewer's duty to execute the qualifying bond on filing its notice of intention to commence business; the section 5401(c)/5551(d) small-taxpayer exception is not modelled this stage (EXTERNAL_DEPENDENCY, section 5551 is outside the priority scope)";
    when brewer_notice_filed(p, brewery);
    unless brewer_bond_executed(p, brewery) and brewer_notice_filed(p, brewery);
    then duty Section5401BondDuty {
        bearer p;
        goal maintenance {
            condition brewer_bond_executed(p, brewery);
            window [-infinity, infinity];
        }
    };
}
// (b), remaining sentences (the bond's own three conditions; the 4-year
// renewal cycle; the continuation-certificate alternative): describe the
// CONTENT and lifecycle of the bond obligation already captured by the duty
// above — NON_NORMATIVE relative to a second independent rule (folded in as
// documentation, not a separate computation). (c): the section 5551(d)
// exception itself is EXTERNAL_DEPENDENCY (section 5551 outside this
// stage's priority scope), referenced by the `unless` above via a
// case-asserted fact rather than reimplemented.
