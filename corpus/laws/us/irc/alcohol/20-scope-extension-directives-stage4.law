// Alcohol -- stage 4 (26.09.2026, DECISION-0379, implemented_unverified): the three scope-extension directives that stage 3
// left as TECH_GAP G6001: section 5044(c) (wine returned to bond), section 5215(b) (spirits returned to bonded premises)
// and section 5560 (subtitle F extended to subtitle E).
//
// METHOD AND JUDGMENT CALLS. As for the vinegar plants of section 5505 (module 19): the directive is a legal state keyed
// by the provision (Text) asked about, not a rewrite of every rule of the package. The rules of this package are keyed on
// the entities of the case (removals, plants), so the extension is a derived applicability relation that a consumer
// consults; no existing rule is re-guarded. Which provisions "apply to wine in bond" is a case fact (the provision named);
// the package does not enumerate them.

language "law.core" version "0.2";
package us.irc.alcohol version "0.1.1";
namespace "urn:us:irc:alcohol:clir";

use self::{
    IRC_S5044_C,
    IRC_S5215_B,
    IRC_S5560,
    SpiritsRemoval,
    SpiritsReturnPurpose,
    WineReturnToBond,
    return_to_bonded_premises_permitted,
    taxpaid_spirits_returned_to_bonded_premises,
    wine_returned_to_bond_on,
};

// ============================================================================
// section 5044(c): the provisions applicable to wine in bond apply to wine returned to bond
// ============================================================================

pub relation provision_applicable_to_wine_in_bond_5044c(provision: Text) kind empirical {
    label en official "section 5044(c): the provision of the chapter is applicable to wine in bond on the premises of a bonded wine cellar and to removals thereof";
}
pub relation provision_applies_to_wine_returned_to_bond_5044c(r: WineReturnToBond, provision: Text) kind institutional {
    label en official "section 5044(c): the provision applies to the wine returned to bond under this section";
}
@source(IRC_S5044_C, quote = "All provisions of this chapter applicable to wine in bond on the premises of a bonded wine cellar and to removals thereof shall be applicable to wine returned to bond under the provisions of this section.")
rule ProvisionAppliesToReturnedWine5044c(r: WineReturnToBond, provision: Text) defeasible {
    label en official "section 5044(c)";
    when wine_returned_to_bond_on(r, _);
    when provision_applicable_to_wine_in_bond_5044c(provision);
    then provision_applies_to_wine_returned_to_bond_5044c(r, provision);
}

// ============================================================================
// section 5215(b): the provisions applicable to distilled spirits in bond apply to spirits returned to bonded premises
// ============================================================================

pub relation provision_applicable_to_spirits_in_bond_5215b(provision: Text) kind empirical {
    label en official "section 5215(b): the provision of the chapter is applicable to distilled spirits in bond";
}
pub relation provision_applies_to_spirits_returned_to_bonded_premises_5215b(r: SpiritsRemoval, provision: Text) kind institutional {
    label en official "section 5215(b): the provision applies to the distilled spirits returned to bonded premises under this section, on such return";
}
@source(IRC_S5215_B, quote = "All provisions of this chapter applicable to distilled spirits in bond shall be applicable to distilled spirits returned to bonded premises under the provisions of this section on such return.")
rule ProvisionAppliesToReturnedSpirits5215b(r: SpiritsRemoval, provision: Text, purpose: SpiritsReturnPurpose) defeasible {
    label en official "section 5215(b): the return is a permitted return under section 5215(a)";
    when taxpaid_spirits_returned_to_bonded_premises(r, purpose);
    when return_to_bonded_premises_permitted(r);
    when provision_applicable_to_spirits_in_bond_5215b(provision);
    then provision_applies_to_spirits_returned_to_bonded_premises_5215b(r, provision);
}

// ============================================================================
// section 5560: the provisions of subtitle F, insofar as applicable and not inconsistent, are part of subtitle E
// ============================================================================

pub relation provision_of_subtitle_f_5560(provision: Text) kind empirical {
    label en official "section 5560: a provision of subtitle F (procedure and administration)";
}
pub relation subtitle_f_provision_applicable_to_subtitle_e_matter_5560(provision: Text) kind empirical {
    label en official "section 5560: the provision is applicable to the subtitle E matter in question";
}
pub relation subtitle_f_provision_inconsistent_with_subtitle_e_5560(provision: Text) kind empirical {
    label en official "section 5560: the provision is inconsistent with the provisions of subtitle E";
}
pub relation subtitle_f_provision_part_of_subtitle_e_5560(provision: Text) kind institutional {
    label en official "section 5560: the provision is extended to and made a part of subtitle E";
}
@source(IRC_S5560, quote = "All provision of subtitle F, insofar as applicable and not inconsistent with the provisions of this subtitle, are hereby extended to and made a part of this subtitle.")
rule SubtitleFProvisionPartOfSubtitleE5560(provision: Text) defeasible {
    label en official "section 5560: applicable and not inconsistent";
    when provision_of_subtitle_f_5560(provision);
    when subtitle_f_provision_applicable_to_subtitle_e_matter_5560(provision);
    unless subtitle_f_provision_inconsistent_with_subtitle_e_5560(provision) and provision_of_subtitle_f_5560(provision) and subtitle_f_provision_applicable_to_subtitle_e_matter_5560(provision);
    then subtitle_f_provision_part_of_subtitle_e_5560(provision);
}
