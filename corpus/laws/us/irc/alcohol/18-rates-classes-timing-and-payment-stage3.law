// Stage 3 (TECH_GAP reduction): section 5001(a)(5)-(6), 5008(a)(4)-(5), 5010(c)(2)(B), 5041(c)(1)(B), (c)(5), (g),
// (h), 5061(d)(4)(B), (d)(5) and the G3208 bridge from `excepted_under_5551d` to the derived relation.

// =====================================================================
// Section 5001(a)(5), (6): denatured spirits and fruit-flavor concentrates used unlawfully
// =====================================================================

use self::{
    BlendedSpirit,
    DistilledSpiritsPlant,
    FruitFlavorConcentrateOperation,
    IRC_S5001_A,
    IRC_S5008_A,
    IRC_S5010_A,
    IRC_S5010_C,
    IRC_S5041_B,
    IRC_S5041_C,
    IRC_S5041_G,
    IRC_S5041_H,
    IRC_S5061_D,
    IRC_S5551_D,
    Person,
    SpiritsLossCause,
    SpiritsRemoval,
    WineCellarPremises,
    WineClass,
    WineRemoval,
    bond_not_required_under_5551d,
    concentrate_abv_percent,
    flavors_content_credit,
    is_wine_producer,
    liable_for_reattached_spirits_tax,
    must_pay_by_electronic_funds_transfer,
    operations_bond_or_exception_satisfied,
    removed_wine_gallons,
    spirits_loss,
    wine_credit_applies,
    wine_credit_tier1_portion,
    wine_credit_tier2_portion,
    wine_credit_tier3_portion,
    wine_premises_bond_satisfied,
    wine_removal_class,
    wine_tax,
    withdrawal_bond_or_exception_satisfied,
};

pub relation unlawful_use_of_denatured_spirits_or_articles(user: Person, gallons: Decimal, on: Date) kind empirical {
    label en official "a person produces, withdraws, sells, transports, or uses denatured distilled spirits or articles in violation of laws or regulations pertaining to them (section 5001(a)(5))";
}
@source(IRC_S5001_A, relation = formalizes, coverage = exact, quote = "and the person so producing, withdrawing, selling, transporting, or using the denatured distilled spirits or articles shall be required to pay such tax.")
rule Section5001a5UnlawfulUseOfDenaturedSpiritsRule(user: Person, gallons: Decimal, on: Date) strict {
    label en official "section 5001(a)(5): the actor is required to pay the tax at the rate for distilled spirits that are not denatured";
    when unlawful_use_of_denatured_spirits_or_articles(user, gallons, on);
    then liable_for_reattached_spirits_tax(user, gallons, on, gallons * DistilledSpiritsStandardRate);
}
pub relation unlawful_use_of_tax_free_flavor_concentrate(user: Person, o: FruitFlavorConcentrateOperation, on: Date) kind empirical {
    label en official "a volatile fruit-flavor concentrate (or the fruit mash or juice from which it is produced), manufactured free from tax under section 5511, is sold, transported, or used by the person in violation of this chapter or its regulations (section 5001(a)(6))";
}
pub relation flavor_concentrate_manufactured_free_from_tax_under_5511(o: FruitFlavorConcentrateOperation) kind empirical {
    label en official "the concentrate, mash, or juice was manufactured free from tax under section 5511";
}
pub relation flavor_concentrate_subject_to_spirits_and_wine_tax_provisions(user: Person, o: FruitFlavorConcentrateOperation) kind institutional {
    label en official "section 5001(a)(6): the person and the concentrate, mash, or juice are subject to all provisions of chapter 51 pertaining to distilled spirits and wines, including payment of tax; the person must pay that tax (the class and rate of the tax follow the article; no amount is computed here)";
}
@source(IRC_S5001_A, relation = formalizes, coverage = exact, quote = "containing one-half of 1 percent or more of alcohol by volume, which is manufactured free from tax under section 5511, is sold, transported, or used by any person in violation of the provisions of this chapter or regulations promulgated thereunder")
rule Section5001a6UnlawfulUseOfFlavorConcentrateRule(user: Person, o: FruitFlavorConcentrateOperation, on: Date, pct: Decimal) strict {
    label en official "section 5001(a)(6): a concentrate of at least one-half of 1 percent alcohol by volume, made free of tax under section 5511 and unlawfully sold, transported, or used, brings the actor under the distilled spirits and wine tax provisions";
    when unlawful_use_of_tax_free_flavor_concentrate(user, o, on);
    when flavor_concentrate_manufactured_free_from_tax_under_5511(o);
    when concentrate_abv_percent(o, pct);
    when pct >= 0.5;
    then flavor_concentrate_subject_to_spirits_and_wine_tax_provisions(user, o);
}

// =====================================================================
// Section 5008(a)(4), (5): timing of the loss and the indemnification offset
// =====================================================================

pub relation spirits_tax_determined_on(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "the date the tax on the distilled spirits was determined (section 5006(a))";
}
pub relation spirits_loss_occurred_on(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "the date the distilled spirits were lost or destroyed";
}
pub relation physical_removal_from_bonded_premises_completed_on(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "the date the physical removal of the distilled spirits from the bonded premises was completed (section 5008(a)(5))";
}
pub relation physical_removal_completion_stated(r: SpiritsRemoval) kind institutional {
    label en official "marker: a completion date of the physical removal is stated for this removal";
}
rule PhysicalRemovalCompletionStatedMarker(r: SpiritsRemoval, d: Date) strict {
    when physical_removal_from_bonded_premises_completed_on(r, d);
    then physical_removal_completion_stated(r);
}
pub relation loss_after_tax_determined(r: SpiritsRemoval) kind institutional {
    label en official "section 5008(a)(4): the loss occurred after the tax was determined as provided in section 5006(a)";
}
pub relation loss_within_5008a5_extension(r: SpiritsRemoval) kind institutional {
    label en official "section 5008(a)(5): the loss occurred after the tax was determined and before completion of the physical removal from the bonded premises, so subsection (a) still applies";
}
pub relation loss_barred_by_5008a4_timing(r: SpiritsRemoval) kind institutional {
    label en official "section 5008(a)(4): no tax is abated, remitted, credited, or refunded because the loss occurred after the tax was determined, and paragraph (5) does not extend the subsection to it";
}
@source(IRC_S5008_A, relation = formalizes, coverage = exact, quote = "where the loss occurred after the tax was determined (as provided in section 5006(a))")
rule LossAfterTaxDetermined(r: SpiritsRemoval, determined: Date, lost: Date) strict {
    when spirits_tax_determined_on(r, determined) and spirits_loss_occurred_on(r, lost) and lost > determined;
    then loss_after_tax_determined(r);
}
@source(IRC_S5008_A, relation = formalizes, coverage = exact, quote = "The provisions of this subsection shall extend to and apply in respect of distilled spirits lost after the tax was determined and before completion of the physical removal of the distilled spirits from the bonded premises.")
rule LossWithin5008a5ExtensionRemovalOngoing(r: SpiritsRemoval, completed: Date, lost: Date) strict {
    when loss_after_tax_determined(r)
        and spirits_loss_occurred_on(r, lost)
        and physical_removal_from_bonded_premises_completed_on(r, completed)
        and lost < completed;
    then loss_within_5008a5_extension(r);
}
@source(IRC_S5008_A, relation = formalizes, coverage = exact, quote = "The provisions of this subsection shall extend to and apply in respect of distilled spirits lost after the tax was determined and before completion of the physical removal of the distilled spirits from the bonded premises.")
rule LossWithin5008a5ExtensionRemovalNotYetCompleted(r: SpiritsRemoval) strict {
    when loss_after_tax_determined(r) and not_known(physical_removal_completion_stated(r));
    then loss_within_5008a5_extension(r);
}
@source(IRC_S5008_A, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (5), no tax shall be abated, remitted, credited, or refunded under this subsection where the loss occurred after the tax was determined (as provided in section 5006(a)).")
rule LossBarredBy5008a4Timing(r: SpiritsRemoval) strict {
    when loss_after_tax_determined(r) and not_known(loss_within_5008a5_extension(r));
    then loss_barred_by_5008a4_timing(r);
}
pub relation theft_loss_tax_amount(r: SpiritsRemoval, tax: Money) kind empirical {
    label en official "the tax on the distilled spirits lost by theft";
}
pub relation theft_loss_indemnified_amount(r: SpiritsRemoval, amount: Money) kind empirical {
    label en official "the amount for which the claimant is indemnified against or recompensed in respect of the tax for the theft loss";
}
pub relation theft_loss_relief_amount(r: SpiritsRemoval, relief: Money) kind institutional {
    label en official "section 5008(a)(4), second sentence: relief for a theft loss is allowed only to the extent that the claimant is not indemnified against or recompensed in respect of the tax";
}
@source(IRC_S5008_A, relation = formalizes, coverage = exact, quote = "The abatement, remission, credit, or refund of taxes provided for by paragraphs (1) and (3) in the case of loss of distilled spirits by theft shall only be allowed to the extent that the claimant is not indemnified against or recompensed in respect of the tax for such loss.")
rule TheftLossReliefToTheExtentNotIndemnified(r: SpiritsRemoval, tax: Money, indemnified: Money) strict {
    when theft_loss_tax_amount(r, tax) and theft_loss_indemnified_amount(r, indemnified) and not_known(loss_barred_by_5008a4_timing(r));
    then theft_loss_relief_amount(r, max(0.00 USD, tax - indemnified));
}
// The three eligibility rules of module 03 do not read the timing bar; this rule withdraws the relief marker when it applies.
pub relation loss_claim_timing_permits_relief(r: SpiritsRemoval) kind institutional {
    label en official "section 5008(a)(4): the timing of the loss does not bar relief";
}
@source(IRC_S5008_A, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (5), no tax shall be abated, remitted, credited, or refunded under this subsection where the loss occurred after the tax was determined (as provided in section 5006(a)).")
rule LossClaimTimingPermitsRelief(r: SpiritsRemoval) strict {
    when spirits_loss(r, _) and not_known(loss_barred_by_5008a4_timing(r));
    then loss_claim_timing_permits_relief(r);
}

// =====================================================================
// Section 5010(c)(2)(B): exclusions from flavors content
// =====================================================================

pub entity FlavorsAlcoholItem;
pub relation flavors_alcohol_item(b: BlendedSpirit, item: FlavorsAlcoholItem, proof_gallons: Decimal) kind empirical {
    label en official "alcohol derived from one flavor added to the blended distilled spirit, in proof gallons";
}
pub relation flavor_item_of_type_for_which_drawback_is_allowable_5114(item: FlavorsAlcoholItem) kind empirical {
    label en official "section 5010(c)(2)(A): the flavor is of a type for which drawback is allowable under section 5114";
}
pub relation flavor_item_made_at_a_distilled_spirits_plant(item: FlavorsAlcoholItem) kind empirical {
    label en official "section 5010(c)(2)(B)(i): the flavor was made at a distilled spirits plant";
}
pub relation flavor_item_distilled_at_a_distilled_spirits_plant(item: FlavorsAlcoholItem) kind empirical {
    label en official "section 5010(c)(2)(B)(ii): the flavor was distilled at a distilled spirits plant";
}
pub relation finished_distilled_spirits_product_proof_gallons(b: BlendedSpirit, proof_gallons: Decimal) kind empirical {
    label en official "section 5010(c)(2)(B)(iii): the proof gallons of the finished distilled spirits product";
}
pub relation flavors_alcohol_qualifying_before_cap(b: BlendedSpirit, proof_gallons: Decimal) kind institutional {
    label en official "section 5010(c)(2)(A), (B)(i)-(ii): the alcohol derived from flavors of an allowable type, excluding flavors made or distilled at a distilled spirits plant";
}
pub relation flavors_content_proof_gallons_derived(b: BlendedSpirit, proof_gallons: Decimal) kind institutional {
    label en official "section 5010(c)(2): the flavors content: the qualifying alcohol, but not more than 2 1/2 percent of the finished product on a proof gallon basis";
}
@source(IRC_S5010_C, relation = formalizes, coverage = exact, quote = "(i) alcohol derived from flavors made at a distilled spirits plant,")
rule FlavorsAlcoholQualifyingBeforeCap(b: BlendedSpirit) strict {
    when finished_distilled_spirits_product_proof_gallons(b, _);
    then flavors_alcohol_qualifying_before_cap(b,
        sum(collect all g: Decimal, it: FlavorsAlcoholItem where flavors_alcohol_item(b, it, g)
            and flavor_item_of_type_for_which_drawback_is_allowable_5114(it)
            and not_known(flavor_item_made_at_a_distilled_spirits_plant(it))
            and not_known(flavor_item_distilled_at_a_distilled_spirits_plant(it)), empty: 0.0));
}
@source(IRC_S5010_C, relation = formalizes, coverage = exact, quote = "(iii) in the case of any distilled spirits product, alcohol derived from flavors to the extent such alcohol exceeds (on a proof gallon basis) 2½ percent of the finished product.")
rule FlavorsContentCappedAtTwoAndAHalfPercent(b: BlendedSpirit, q: Decimal, finished: Decimal) strict {
    when flavors_alcohol_qualifying_before_cap(b, q) and finished_distilled_spirits_product_proof_gallons(b, finished);
    then flavors_content_proof_gallons_derived(b, min(q, finished * 0.025));
}
@source(IRC_S5010_A, relation = formalizes, coverage = exact, quote = "On each proof gallon of the flavors content of distilled spirits, there shall be allowed a credit against the tax imposed by section 5001 (or 7652) equal to $13.50.")
rule Section5010aFlavorsContentCreditFromDerived(b: BlendedSpirit, gallons: Decimal) strict {
    when flavors_content_proof_gallons_derived(b, gallons);
    then flavors_content_credit(b, gallons * FlavorsContentCreditRate);
}

// =====================================================================
// Section 5041(g), (h): hard cider, mead and low alcohol by volume wine
// =====================================================================

pub relation wine_carbon_dioxide_grams_per_100_ml(w: WineRemoval, grams: Decimal) kind empirical {
    label en official "the grams of carbon dioxide per hundred milliliters of wine";
}
external judgment relation secretary_prescribed_carbon_dioxide_tolerance(w: WineRemoval, max_grams: Decimal) {
    authority Secretary;
    label en official "section 5041(g)(1), (h)(2): the tolerance to the 0.64 gram limit the Secretary prescribes by regulations as reasonably necessary in good commercial practice (DECISION-0194)";
}
pub relation wine_alcohol_by_volume_percent_points(w: WineRemoval, percent_points: Decimal) kind empirical {
    label en official "the alcohol by volume of the wine in percentage points (5.5 means 5.5 percent)";
}
pub relation wine_derived_primarily_from_apples_or_pears(w: WineRemoval) kind empirical {
    label en official "section 5041(g)(2)(A): the wine is derived primarily from apples or pears";
}
pub relation wine_derived_from_apple_or_pear_juice_concentrate_and_water(w: WineRemoval) kind empirical {
    label en official "section 5041(g)(2)(B): the wine is derived from apple juice concentrate or pear juice concentrate and water";
}
pub relation wine_contains_fruit_product_or_flavoring_other_than_apple_or_pear(w: WineRemoval) kind empirical {
    label en official "section 5041(g)(3): the wine contains a fruit product or fruit flavoring other than apple or pear";
}
pub relation wine_carbon_dioxide_within_limit(w: WineRemoval) kind institutional {
    label en official "section 5041(g)(1), (h)(2): not more than 0.64 gram of carbon dioxide per hundred milliliters of wine, or within the tolerance the Secretary prescribes";
}
@source(IRC_S5041_G, relation = formalizes, coverage = exact, quote = "(1) containing not more than 0.64 gram of carbon dioxide per hundred milliliters of wine, except that the Secretary may by regulations prescribe such tolerances to this limitation as may be reasonably necessary in good commercial practice,")
rule WineCarbonDioxideWithinBaseLimit(w: WineRemoval, g: Decimal) strict {
    when wine_carbon_dioxide_grams_per_100_ml(w, g) and g <= 0.64;
    then wine_carbon_dioxide_within_limit(w);
}
@source(IRC_S5041_G, relation = formalizes, coverage = exact, quote = "except that the Secretary may by regulations prescribe such tolerances to this limitation as may be reasonably necessary in good commercial practice,")
rule WineCarbonDioxideWithinSecretaryTolerance(w: WineRemoval, g: Decimal, tol: Decimal) strict {
    when wine_carbon_dioxide_grams_per_100_ml(w, g) and secretary_prescribed_carbon_dioxide_tolerance(w, tol) and g <= tol;
    then wine_carbon_dioxide_within_limit(w);
}
pub relation wine_meets_hard_cider_definition(w: WineRemoval) kind institutional {
    label en official "section 5041(g): hard cider: carbon dioxide within the limit; derived primarily from apples or pears (or from apple or pear juice concentrate and water); no fruit product or flavoring other than apple or pear; at least one-half of 1 percent and less than 8.5 percent alcohol by volume";
}
@source(IRC_S5041_G, relation = formalizes, coverage = exact, quote = "(4) which contains at least one-half of 1 percent and less than 8.5 percent alcohol by volume.")
rule HardCiderDefinitionFromApplesOrPears(w: WineRemoval, abv: Decimal) strict {
    when wine_carbon_dioxide_within_limit(w)
        and wine_derived_primarily_from_apples_or_pears(w)
        and not_known(wine_contains_fruit_product_or_flavoring_other_than_apple_or_pear(w))
        and wine_alcohol_by_volume_percent_points(w, abv)
        and abv >= 0.5 and abv < 8.5;
    then wine_meets_hard_cider_definition(w);
}
@source(IRC_S5041_G, relation = formalizes, coverage = exact, quote = "(B) from—")
rule HardCiderDefinitionFromConcentrateAndWater(w: WineRemoval, abv: Decimal) strict {
    when wine_carbon_dioxide_within_limit(w)
        and wine_derived_from_apple_or_pear_juice_concentrate_and_water(w)
        and not_known(wine_contains_fruit_product_or_flavoring_other_than_apple_or_pear(w))
        and wine_alcohol_by_volume_percent_points(w, abv)
        and abv >= 0.5 and abv < 8.5;
    then wine_meets_hard_cider_definition(w);
}
pub relation wine_taxed_as_hard_cider(w: WineRemoval) kind institutional {
    label en official "the wine is hard cider for section 5041(b)(6) and (c)(1)(B): by the case's asserted class or by the definition of subsection (g)";
}
@source(IRC_S5041_B, relation = formalizes, coverage = exact, quote = "(6) On hard cider, 22.6 cents per wine gallon.")
rule WineTaxedAsHardCiderByAssertedClass(w: WineRemoval) strict {
    when wine_removal_class(w, HardCider);
    then wine_taxed_as_hard_cider(w);
}
@source(IRC_S5041_G, relation = formalizes, coverage = exact, quote = "For purposes of subsection (b)(6), the term \"hard cider\" means a wine—")
rule WineTaxedAsHardCiderByDefinition(w: WineRemoval) strict {
    when wine_meets_hard_cider_definition(w);
    then wine_taxed_as_hard_cider(w);
}
@source(IRC_S5041_G, relation = formalizes, coverage = exact, quote = "For purposes of subsection (b)(6), the term \"hard cider\" means a wine—")
rule Section5041bHardCiderRateFromDefinition(w: WineRemoval, gallons: Decimal) strict {
    when wine_meets_hard_cider_definition(w) and removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateHardCider);
}
pub relation wine_is_mead(w: WineRemoval) kind institutional {
    label en official "section 5041(h)(2)(A): mead: carbon dioxide within the limit, derived solely from honey and water, no fruit product or flavoring, less than 8.5 percent alcohol by volume";
}
pub relation wine_derived_solely_from_honey_and_water(w: WineRemoval) kind empirical {
    label en official "section 5041(h)(2)(A)(ii): the wine is derived solely from honey and water";
}
pub relation wine_contains_fruit_product_or_fruit_flavoring(w: WineRemoval) kind empirical {
    label en official "section 5041(h)(2)(A)(iii): the wine contains a fruit product or fruit flavoring";
}
@source(IRC_S5041_H, relation = formalizes, coverage = exact, quote = "(iv) which contains less than 8.5 percent alcohol by volume.")
rule MeadDefinition(w: WineRemoval, abv: Decimal) strict {
    when wine_carbon_dioxide_within_limit(w)
        and wine_derived_solely_from_honey_and_water(w)
        and not_known(wine_contains_fruit_product_or_fruit_flavoring(w))
        and wine_alcohol_by_volume_percent_points(w, abv)
        and abv < 8.5;
    then wine_is_mead(w);
}
pub relation wine_derived_primarily_from_grapes(w: WineRemoval) kind empirical {
    label en official "section 5041(h)(2)(B)(ii)(I): the wine is derived primarily from grapes";
}
pub relation wine_derived_from_grape_juice_concentrate_and_water(w: WineRemoval) kind empirical {
    label en official "section 5041(h)(2)(B)(ii)(II): the wine is derived from grape juice concentrate and water";
}
pub relation wine_contains_fruit_product_or_flavoring_other_than_grape(w: WineRemoval) kind empirical {
    label en official "section 5041(h)(2)(B)(iii): the wine contains a fruit product or fruit flavoring other than grape";
}
pub relation wine_is_low_alcohol_by_volume_wine(w: WineRemoval) kind institutional {
    label en official "section 5041(h)(2)(B): low alcohol by volume wine: carbon dioxide within the limit, derived primarily from grapes (or from grape juice concentrate and water), no fruit product or flavoring other than grape, less than 8.5 percent alcohol by volume";
}
@source(IRC_S5041_H, relation = formalizes, coverage = exact, quote = "(I) primarily from grapes, or")
rule LowAbvWineFromGrapes(w: WineRemoval, abv: Decimal) strict {
    when wine_carbon_dioxide_within_limit(w)
        and wine_derived_primarily_from_grapes(w)
        and not_known(wine_contains_fruit_product_or_flavoring_other_than_grape(w))
        and wine_alcohol_by_volume_percent_points(w, abv)
        and abv < 8.5;
    then wine_is_low_alcohol_by_volume_wine(w);
}
@source(IRC_S5041_H, relation = formalizes, coverage = exact, quote = "(II) from grape juice concentrate and water,")
rule LowAbvWineFromConcentrate(w: WineRemoval, abv: Decimal) strict {
    when wine_carbon_dioxide_within_limit(w)
        and wine_derived_from_grape_juice_concentrate_and_water(w)
        and not_known(wine_contains_fruit_product_or_flavoring_other_than_grape(w))
        and wine_alcohol_by_volume_percent_points(w, abv)
        and abv < 8.5;
    then wine_is_low_alcohol_by_volume_wine(w);
}
@source(IRC_S5041_H, relation = formalizes, coverage = exact, quote = "For purposes of subsections (a) and (b)(1), mead and low alcohol by volume wine shall be deemed to be still wines containing not more than 16 percent of alcohol by volume.")
rule MeadDeemedStillLowRate(w: WineRemoval, gallons: Decimal) strict {
    when wine_is_mead(w) and removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateStillLow);
}
@source(IRC_S5041_H, relation = formalizes, coverage = exact, quote = "For purposes of subsections (a) and (b)(1), mead and low alcohol by volume wine shall be deemed to be still wines containing not more than 16 percent of alcohol by volume.")
rule LowAbvWineDeemedStillLowRate(w: WineRemoval, gallons: Decimal) strict {
    when wine_is_low_alcohol_by_volume_wine(w) and removed_wine_gallons(w, gallons);
    then wine_tax(w, gallons * WineRateStillLow);
}

// =====================================================================
// Section 5041(c)(1)(B): the credit for hard cider
// =====================================================================

pub relation wine_credit_hard_cider_amount(w: WineRemoval, amount: Money) kind institutional {
    label en official "section 5041(c)(1)(B): the credit for hard cider, applying 6.2 cents, 5.6 cents and 3.3 cents in place of $1, 90 cents and 53.5 cents";
}
@source(IRC_S5041_C, relation = formalizes, coverage = exact, quote = "(i) in clause (i) of such subparagraph, by substituting \"6.2 cents\" for \"$1\",")
rule Section5041cHardCiderCreditAmountRule(w: WineRemoval, t1: Decimal, t2: Decimal, t3: Decimal) strict {
    when wine_taxed_as_hard_cider(w)
        and wine_credit_tier1_portion(w, t1)
        and wine_credit_tier2_portion(w, t2)
        and wine_credit_tier3_portion(w, t3);
    then wine_credit_hard_cider_amount(w, t1 * WineCreditHardCiderTier1Rate + t2 * WineCreditHardCiderTier2Rate + t3 * WineCreditHardCiderTier3Rate);
}

// =====================================================================
// Section 5041(c)(5): credit for a transferee in bond
// =====================================================================

pub relation wine_transferred_in_bond_and_removed_by_transferee(w: WineRemoval, producer: Person, transferee: Person) kind empirical {
    label en official "section 5041(c)(5)(B): wine produced by the producer is removed during the calendar year by another person (the transferee) to whom it was transferred in bond";
}
pub relation transferee_liable_for_tax_on_removed_wine(w: WineRemoval, transferee: Person) kind empirical {
    label en official "section 5041(c)(5)(B): the transferee is liable for the tax imposed by section 5041 with respect to the wine";
}
pub relation producer_holds_title_at_removal(w: WineRemoval, producer: Person) kind empirical {
    label en official "section 5041(c)(5)(C): the producer holds title to the wine at the time of its removal";
}
pub relation producer_provided_transferee_credit_information(w: WineRemoval, producer: Person) kind empirical {
    label en official "section 5041(c)(5)(C): the producer provides the transferee such information as is necessary to properly determine the transferee's credit";
}
pub relation wine_credit_allowed_to_transferee(w: WineRemoval, transferee: Person) kind institutional {
    label en official "section 5041(c)(5): the transferee (and not the producer) is allowed the credit the producer would be allowed had the producer removed the wine on that date";
}
@source(IRC_S5041_C, relation = formalizes, coverage = exact, quote = "then, the transferee (and not the producer) shall be allowed the credit under paragraph (1) which would be allowed to the producer if the wine removed by the transferee had been removed by the producer on that date.")
rule TransfereeInBondCreditAllowed(w: WineRemoval, prod: Person, tr: Person) strict {
    when wine_transferred_in_bond_and_removed_by_transferee(w, prod, tr)
        and is_wine_producer(prod)
        and transferee_liable_for_tax_on_removed_wine(w, tr)
        and producer_holds_title_at_removal(w, prod)
        and producer_provided_transferee_credit_information(w, prod);
    then wine_credit_allowed_to_transferee(w, tr);
}
@source(IRC_S5041_C, relation = formalizes, coverage = exact, quote = "then, the transferee (and not the producer) shall be allowed the credit under paragraph (1) which would be allowed to the producer if the wine removed by the transferee had been removed by the producer on that date.")
rule TransfereeCreditMakesWineRemovalCreditEligible(w: WineRemoval, tr: Person) strict {
    when wine_credit_allowed_to_transferee(w, tr);
    then wine_credit_applies(w);
}

// =====================================================================
// Section 5061(d)(4)(B): loss of the quarterly or annual period once the aggregate tax exceeds the limit
// =====================================================================

pub entity AlcoholTaxItem;
pub relation alcohol_tax_due_item(p: Person, item: AlcoholTaxItem, on: Date, amount: Money) kind empirical {
    label en official "tax due under subparts A, C and D and section 7652 from the taxpayer, arising on the given date (one withdrawal, removal or entry)";
}
pub relation alcohol_tax_calendar_year_of(p: Person, year_begins: Date, year_ends: Date) kind empirical {
    label en official "the calendar year (first and last day) for which the aggregate tax due is measured";
}
pub relation alcohol_item_period_starts(item: AlcoholTaxItem, month_starts: Date, quarter_starts: Date) kind empirical {
    label en official "the first day of the calendar month and of the calendar quarter in which the item arises (a case input; the language has no date decomposition)";
}
pub relation aggregate_alcohol_tax_due_through(p: Person, through: Date, total: Money) kind institutional {
    label en official "section 5061(d)(4)(B): the aggregate amount of tax due from the taxpayer during the calendar year through the given date";
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "the aggregate amount of tax due under subparts A, C, and D and section 7652 from such taxpayer during such calendar year")
rule AggregateAlcoholTaxDueThrough(p: Person, y0: Date, y1: Date, i: AlcoholTaxItem, d: Date) strict {
    when alcohol_tax_calendar_year_of(p, y0, y1) and alcohol_tax_due_item(p, i, d, _) and d >= y0 and d <= y1;
    then aggregate_alcohol_tax_due_through(p, d,
        sum(collect all a: Money, j: AlcoholTaxItem, dj: Date where alcohol_tax_due_item(p, j, dj, a) and dj >= y0 and dj <= d, empty: 0.00 USD));
}
pub relation aggregate_exceeds_limit_on(p: Person, limit: Money, on: Date) kind institutional {
    label en official "the aggregate tax due for the calendar year first exceeds the limit on or before this item date (a candidate date)";
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "the first date on which the aggregate amount of tax due under subparts A, C, and D and section 7652 from such taxpayer during such calendar year exceeds $50,000")
rule AggregateExceeds50000Candidate(p: Person, d: Date, total: Money) strict {
    when aggregate_alcohol_tax_due_through(p, d, total) and total > ReturnPeriodQuarterlyThreshold;
    then aggregate_exceeds_limit_on(p, ReturnPeriodQuarterlyThreshold + 0.00 USD, d);
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "the first date on which the aggregate amount of tax due under subparts A, C, and D and section 7652 from such taxpayer during such calendar year exceeds $1,000")
rule AggregateExceeds1000Candidate(p: Person, d: Date, total: Money) strict {
    when aggregate_alcohol_tax_due_through(p, d, total) and total > ReturnPeriodAnnualThreshold;
    then aggregate_exceeds_limit_on(p, ReturnPeriodAnnualThreshold + 0.00 USD, d);
}
pub relation earlier_exceeding_date_exists(p: Person, limit: Money, on: Date) kind institutional {
    label en official "an earlier candidate date exists on which the aggregate exceeded the limit";
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "the first date on which the aggregate amount")
rule EarlierExceedingDateExists(p: Person, l: Money, d: Date, d2: Date) strict {
    when aggregate_exceeds_limit_on(p, l, d) and aggregate_exceeds_limit_on(p, l, d2) and d2 < d;
    then earlier_exceeding_date_exists(p, l, d);
}
pub relation first_date_aggregate_exceeds_limit(p: Person, limit: Money, on: Date) kind institutional {
    label en official "section 5061(d)(4)(B): the first date on which the aggregate tax due for the calendar year exceeds the limit";
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "the first date on which the aggregate amount")
rule FirstDateAggregateExceedsLimit(p: Person, l: Money, d: Date) strict {
    when aggregate_exceeds_limit_on(p, l, d) and not_known(earlier_exceeding_date_exists(p, l, d));
    then first_date_aggregate_exceeds_limit(p, l, d);
}
pub relation quarterly_period_ceases_after(p: Person, on: Date) kind institutional {
    label en official "section 5061(d)(4)(B)(i): subparagraph (A)(i) does not apply for any portion of the calendar year following this first date";
}
pub relation annual_period_ceases_after(p: Person, on: Date) kind institutional {
    label en official "section 5061(d)(4)(B)(ii): subparagraph (A)(ii) does not apply for any portion of the calendar year following this first date";
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "Subparagraph (A)(i) shall not apply to any taxpayer for any portion of the calendar year following the first date on which the aggregate amount of tax due under subparts A, C, and D and section 7652 from such taxpayer during such calendar year exceeds $50,000")
rule QuarterlyPeriodCeasesAfterFirst50000Date(p: Person, d: Date, l: Money) strict {
    when first_date_aggregate_exceeds_limit(p, l, d) and l == ReturnPeriodQuarterlyThreshold;
    then quarterly_period_ceases_after(p, d);
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "Subparagraph (A)(ii) shall not apply to any taxpayer for any portion of the calendar year following the first date on which the aggregate amount of tax due under subparts A, C, and D and section 7652 from such taxpayer during such calendar year exceeds $1,000")
rule AnnualPeriodCeasesAfterFirst1000Date(p: Person, d: Date, l: Money) strict {
    when first_date_aggregate_exceeds_limit(p, l, d) and l == ReturnPeriodAnnualThreshold;
    then annual_period_ceases_after(p, d);
}
pub relation unpaid_tax_due_after_quarterly_limit_exceeded(p: Person, item: AlcoholTaxItem, due: Date) kind institutional {
    label en official "section 5061(d)(4)(B)(i): tax not yet paid on the first date the $50,000 limit is exceeded is due on the 14th day after the last day of the semimonthly period in which that date occurs";
}
pub relation unpaid_tax_due_after_annual_limit_exceeded(p: Person, item: AlcoholTaxItem, due: Date) kind institutional {
    label en official "section 5061(d)(4)(B)(ii): tax not yet paid on the first date the $1,000 limit is exceeded is due on the 14th day after the last day of the calendar quarter in which that date occurs";
}
pub relation alcohol_tax_item_unpaid_on(item: AlcoholTaxItem, on: Date) kind empirical {
    label en official "the tax of the item was still unpaid on the date";
}
// The last day of the semimonthly period containing date d: the 15th (month start + 14 days) when d is on or before it, else the last day of the month.
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "and any tax under such subparts which has not been paid on such date shall be due on the 14th day after the last day of the semimonthly period in which such date occurs.")
rule UnpaidTaxDueAfterQuarterlyLimitFirstHalfMonth(p: Person, d: Date, i: AlcoholTaxItem, m0: Date, q0: Date, l: Money) strict {
    when first_date_aggregate_exceeds_limit(p, l, d)
        and l == ReturnPeriodQuarterlyThreshold
        and alcohol_tax_due_item(p, i, _, _)
        and alcohol_tax_item_unpaid_on(i, d)
        and alcohol_item_period_starts(i, m0, q0)
        and d <= add_calendar_period(m0, 14 calendar_day);
    then unpaid_tax_due_after_quarterly_limit_exceeded(p, i, add_calendar_period(add_calendar_period(m0, 14 calendar_day), 14 calendar_day));
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "and any tax under such subparts which has not been paid on such date shall be due on the 14th day after the last day of the semimonthly period in which such date occurs.")
rule UnpaidTaxDueAfterQuarterlyLimitSecondHalfMonth(p: Person, d: Date, i: AlcoholTaxItem, m0: Date, q0: Date, l: Money, calendar_before_1: Date) strict {
    when first_date_aggregate_exceeds_limit(p, l, d)
        and l == ReturnPeriodQuarterlyThreshold
        and alcohol_tax_due_item(p, i, _, _)
        and alcohol_tax_item_unpaid_on(i, d)
        and alcohol_item_period_starts(i, m0, q0)
        and d > add_calendar_period(m0, 14 calendar_day)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(m0, 1 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then unpaid_tax_due_after_quarterly_limit_exceeded(p, i, add_calendar_period(calendar_before_1, 14 calendar_day));
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "and any tax under such subparts which has not been paid on such date shall be due on the 14th day after the last day of the calendar quarter in which such date occurs.")
rule UnpaidTaxDueAfterAnnualLimitExceeded(p: Person, d: Date, i: AlcoholTaxItem, m0: Date, q0: Date, l: Money, calendar_before_1: Date) strict {
    when first_date_aggregate_exceeds_limit(p, l, d)
        and l == ReturnPeriodAnnualThreshold
        and alcohol_tax_due_item(p, i, _, _)
        and alcohol_tax_item_unpaid_on(i, d)
        and alcohol_item_period_starts(i, m0, q0)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(q0, 3 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then unpaid_tax_due_after_annual_limit_exceeded(p, i, add_calendar_period(calendar_before_1, 14 calendar_day));
}

// =====================================================================
// Section 5061(d)(5): tax due in September
// =====================================================================

pub relation alcohol_september_dates(p: Person, year: Integer, sept_16: Date) kind empirical {
    label en official "the calendar year and its September 16";
}
pub relation alcohol_tax_for_september_1_to_15(p: Person, year: Integer, amount: Money) kind empirical {
    label en official "the taxes on distilled spirits, wines, and beer for the period beginning on September 1 and ending on September 15";
}
pub relation alcohol_tax_for_september_16_to_26(p: Person, year: Integer, amount: Money) kind empirical {
    label en official "the taxes for the period beginning on September 16 and ending on September 26";
}
pub relation alcohol_tax_for_september_16_to_25(p: Person, year: Integer, amount: Money) kind empirical {
    label en official "the taxes for the period beginning on September 16 and ending on September 25 (payers not required to use electronic funds transfer)";
}
pub relation alcohol_amount_paid_by_september_deadline(p: Person, year: Integer, paid: Money) kind empirical {
    label en official "the amount paid not later than September 29 (September 28 for payers not required to use electronic funds transfer)";
}
pub relation september_payment_requirement_met(p: Person, year: Integer) kind institutional {
    label en official "section 5061(d)(5)(A)-(C): the September payment requirement is met (the whole period tax was paid, or the safe harbor of at least 11/15 (2/3 for payers not using electronic funds transfer) of the September 1-15 taxes was paid)";
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "The requirement of subparagraph (A) shall be treated as met if the amount paid not later than September 29 is not less than 11/15 of the taxes on distilled spirits, wines, and beer for the period beginning on September 1 and ending on September 15.")
rule SeptemberSafeHarborEftPayers(p: Person, y: Integer, paid: Money, first_half: Money) strict {
    when must_pay_by_electronic_funds_transfer(p, y)
        and alcohol_amount_paid_by_september_deadline(p, y, paid)
        and alcohol_tax_for_september_1_to_15(p, y, first_half)
        and paid * 15 >= first_half * 11;
    then september_payment_requirement_met(p, y);
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "Notwithstanding the preceding provisions of this subsection, the taxes on distilled spirits, wines, and beer for the period beginning on September 16 and ending on September 26 shall be paid not later than September 29.")
rule SeptemberFullPaymentEftPayers(p: Person, y: Integer, paid: Money, second: Money) strict {
    when must_pay_by_electronic_funds_transfer(p, y)
        and alcohol_amount_paid_by_september_deadline(p, y, paid)
        and alcohol_tax_for_september_16_to_26(p, y, second)
        and paid >= second;
    then september_payment_requirement_met(p, y);
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "In the case of payments not required to be made by electronic funds transfer, subparagraphs (A) and (B) shall be applied by substituting \"September 25\" for \"September 26\", \"September 28\" for \"September 29\", and \"2/3\" for \"11/15\".")
rule SeptemberSafeHarborNonEftPayers(p: Person, y: Integer, paid: Money, first_half: Money) strict {
    when not_known(must_pay_by_electronic_funds_transfer(p, y))
        and alcohol_amount_paid_by_september_deadline(p, y, paid)
        and alcohol_tax_for_september_1_to_15(p, y, first_half)
        and paid * 3 >= first_half * 2;
    then september_payment_requirement_met(p, y);
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "In the case of payments not required to be made by electronic funds transfer, subparagraphs (A) and (B) shall be applied by substituting \"September 25\" for \"September 26\", \"September 28\" for \"September 29\", and \"2/3\" for \"11/15\".")
rule SeptemberFullPaymentNonEftPayers(p: Person, y: Integer, paid: Money, second: Money) strict {
    when not_known(must_pay_by_electronic_funds_transfer(p, y))
        and alcohol_amount_paid_by_september_deadline(p, y, paid)
        and alcohol_tax_for_september_16_to_25(p, y, second)
        and paid >= second;
    then september_payment_requirement_met(p, y);
}
pub relation september_payment_duty_applies(p: Person, year: Integer) kind institutional {
    label en official "the taxpayer owes taxes for the September 16 period this year";
}
rule SeptemberPaymentDutyApplies(p: Person, y: Integer, a: Money) strict {
    when alcohol_tax_for_september_16_to_26(p, y, a);
    then september_payment_duty_applies(p, y);
}
rule SeptemberPaymentDutyAppliesNonEft(p: Person, y: Integer, a: Money) strict {
    when alcohol_tax_for_september_16_to_25(p, y, a);
    then september_payment_duty_applies(p, y);
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "shall be paid not later than September 29.")
rule SeptemberPaymentDutyEftRule(p: Person, y: Integer, sep16: Date) defeasible {
    when must_pay_by_electronic_funds_transfer(p, y) and september_payment_duty_applies(p, y) and alcohol_september_dates(p, y, sep16);
    then duty PayAlcoholTaxesForSeptember16To26ByEft {
        bearer p;
        goal achievement {
            condition september_payment_requirement_met(p, y);
            window [sep16, add_calendar_period(sep16, 13 calendar_day)];
        }
    };
}
@source(IRC_S5061_D, relation = formalizes, coverage = exact, quote = "\"September 28\" for \"September 29\"")
rule SeptemberPaymentDutyNonEftRule(p: Person, y: Integer, sep16: Date) defeasible {
    when not_known(must_pay_by_electronic_funds_transfer(p, y)) and september_payment_duty_applies(p, y) and alcohol_september_dates(p, y, sep16);
    then duty PayAlcoholTaxesForSeptember16To25ByNonEft {
        bearer p;
        goal achievement {
            condition september_payment_requirement_met(p, y);
            window [sep16, add_calendar_period(sep16, 12 calendar_day)];
        }
    };
}

// =====================================================================
// G3208: the bridge from section 5551(d) (return period of the taxpayer) into section 5173 and section 5351
// =====================================================================

pub relation operations_year_at_plant(p: Person, plant: DistilledSpiritsPlant, year: Integer) kind empirical {
    label en official "the calendar year in which the person commences operations at the plant (section 5173(a)(1))";
}
pub relation withdrawal_year_at_plant(p: Person, plant: DistilledSpiritsPlant, year: Integer) kind empirical {
    label en official "the calendar year in which the withdrawal without payment of tax is made (section 5173(a)(2))";
}
pub relation wine_premises_operations_year(p: Person, prem: WineCellarPremises, year: Integer) kind empirical {
    label en official "the calendar year in which the person commences operations on the wine premises (section 5351(a))";
}
@source(IRC_S5551_D, relation = formalizes, coverage = exact, quote = "such taxpayer shall not be required to furnish any bond covering operations or withdrawals of distilled spirits or wines for nonindustrial use or of beer.")
rule OperationsBondSatisfiedBy5551dDerived(p: Person, plant: DistilledSpiritsPlant, y: Integer) defeasible {
    when operations_year_at_plant(p, plant, y) and bond_not_required_under_5551d(p, y);
    then operations_bond_or_exception_satisfied(p, plant);
}
@source(IRC_S5551_D, relation = formalizes, coverage = exact, quote = "such taxpayer shall not be required to furnish any bond covering operations or withdrawals of distilled spirits or wines for nonindustrial use or of beer.")
rule WithdrawalBondSatisfiedBy5551dDerived(p: Person, plant: DistilledSpiritsPlant, y: Integer) defeasible {
    when withdrawal_year_at_plant(p, plant, y) and bond_not_required_under_5551d(p, y);
    then withdrawal_bond_or_exception_satisfied(p, plant);
}
@source(IRC_S5551_D, relation = formalizes, coverage = exact, quote = "such taxpayer shall not be required to furnish any bond covering operations or withdrawals of distilled spirits or wines for nonindustrial use or of beer.")
rule WineBondSatisfiedBy5551dDerived(p: Person, prem: WineCellarPremises, y: Integer) defeasible {
    when wine_premises_operations_year(p, prem, y) and bond_not_required_under_5551d(p, y);
    then wine_premises_bond_satisfied(p, prem);
}
