// Stage 2. Subchapter F (bonded wine cellars and taxpaid wine bottling
// houses): 5351-5357 establishment and bond, 5362-5364 removals, 5367-5373
// operations/losses/wine spirits, 5381-5388 wine standards (cellar treatment,
// amelioration, sweetening, designations), 5391 exemption, 5392 definitions.
// The numeric ceilings of the standards (14/17/21 percent, 35/60 percent
// amelioration, 24 percent alcohol) are `pub const` values quoted from the
// pinned text.

use self::{
    AlcoholicLot,
    IRC_S5351_A,
    IRC_S5351_B,
    IRC_S5352,
    IRC_S5353,
    IRC_S5354,
    IRC_S5362_A,
    IRC_S5362_B,
    IRC_S5362_C,
    IRC_S5362_D,
    IRC_S5362_E,
    IRC_S5363,
    IRC_S5364,
    IRC_S5367,
    IRC_S5369,
    IRC_S5370_A,
    IRC_S5370_B,
    IRC_S5371,
    IRC_S5372,
    IRC_S5373_A,
    IRC_S5382_B,
    IRC_S5383_A,
    IRC_S5383_B,
    IRC_S5384_A,
    IRC_S5384_B,
    IRC_S5385_A,
    IRC_S5385_B,
    IRC_S5387_A,
    IRC_S5388_C,
    IRC_S5391,
    IRC_S5392_D,
    IRC_S5392_F,
    Person,
    SpiritsLossCause,
    WineRemoval,
    is_specially_sweetened_natural_wine,
    is_standard_agricultural_wine,
    lot_alcohol_by_volume_percent,
    lot_total_solids_percent_by_weight,
};

pub const WineBondMinimumPenalSum: Money = 1000.00 USD {
    label en official "a bonded wine cellar bond is in a penal sum of not less than $1,000 (section 5354)";
};
pub const WineBondMaximumPenalSum: Money = 50000.00 USD {
    label en official "a penal sum of not more than $50,000 (section 5354)";
};
pub const WineBondLargeLiabilityTaxThreshold: Money = 250000.00 USD {
    label en official "where the tax on the wine and distilled spirits exceeds $250,000 (section 5354)";
};
pub const WineBondLargeLiabilityMaximumPenalSum: Money = 100000.00 USD {
    label en official "the penal sum is then not more than $100,000 (section 5354)";
};
pub const WineSpiritsMinimumProof: Decimal = 140.0 {
    label en official "wine spirits shall not be distilled, unless regulations otherwise provide, at less than 140 degrees of proof (section 5373(a))";
};
pub const UnfitWineMaximumAlcoholByVolumePercent: Decimal = 21.0 {
    label en official "no wine or wine products withdrawn free of tax as unfit for beverage use shall contain more than 21 percent alcohol by volume (section 5362(d))";
};
pub const CellarTreatmentSpiritsAdditionMaximumAbvPercent: Decimal = 24.0 {
    label en official "wine, juice, or concentrate shall not exceed 24 percent alcohol by volume after the addition of wine spirits (section 5382(b)(2)(A))";
};
pub const EffervescentWineFinishedMaximumAbvPercent: Decimal = 14.0 {
    label en official "effervescent-wine refermentation and dosage preparations only if the finished product does not exceed 14 percent by volume (section 5382(b)(5))";
};
pub const WineAbvBoundaryPercent: Decimal = 14.0 {
    label en official "the 14 percent by volume boundary of sections 5383-5385";
};
pub const GrapeWineSweeteningMaximumSolidsPercent: Decimal = 12.0 {
    label en official "section 5383(a): total solids not exceeding 12 percent of the weight of the wine";
};
pub const HighAcidWineHighAbvSolidsPercent: Decimal = 17.0 {
    label en official "section 5383(b)(2)(A): 17 percent by weight if the alcoholic content is more than 14 percent by volume";
};
pub const WineLowerAbvSolidsPercent: Decimal = 21.0 {
    label en official "21 percent by weight if the alcoholic content is not more than 14 percent by volume (sections 5383(b)(2)(B), 5384(a), (b)(2)(C))";
};
pub const HighAcidMinimumFixedAcidPartsPerThousandExclusive: Decimal = 5.0 {
    label en official "natural fixed acid content of more than five parts per thousand (section 5383(b)(1))";
};
pub const AmeliorationMaximumShareOfVolumePercent: Decimal = 35.0 {
    label en official "ameliorating material shall not exceed 35 percent of the volume of juice and ameliorating material combined (section 5383(b)(1))";
};
pub const VeryHighAcidFruitFixedAcidPartsPerThousand: Decimal = 20.0 {
    label en official "fruit or berry with a natural fixed acid of 20 parts per thousand or more (section 5384(b)(2)(D))";
};
pub const VeryHighAcidAmeliorationMaximumShareOfVolumePercent: Decimal = 60.0 {
    label en official "60 percent in lieu of 35 percent (section 5384(b)(2)(D))";
};
pub const SpeciallySweetenedMinimumSolidsPercentExclusive: Decimal = 17.0 {
    label en official "a total solids content in excess of 17 percent by weight (section 5385(a))";
};
pub const SemiGenericAlcoholLowerBoundPercent: Decimal = 7.0 {
    label en official "wine containing less than 7 percent alcohol by volume is outside section 5388(c)(3) (clause (ii)(I))";
};
pub const SemiGenericAlcoholUpperBoundPercent: Decimal = 24.0 {
    label en official "wine containing more than 24 percent alcohol by volume is outside section 5388(c)(3) (clause (ii)(I))";
};
pub const SemiGenericBrandLabelCutoff: Date = @2006-03-10 {
    label en official "a Certificate of Label Approval held for a label bearing the brand name before March 10, 2006 (section 5388(c)(3)(B)(iii))";
};

// =============================================================================
// Sections 5351-5357: establishment, bond
// =============================================================================

pub entity WineCellarPremises {
    label en unofficial "premises for the production, blending, cellar treatment, storage, bottling, packaging, or repackaging of untaxpaid wine (section 5351(a)), or a taxpaid wine bottling house (section 5352)";
}
pub relation person_establishes_untaxpaid_wine_premises(p: Person, prem: WineCellarPremises) kind empirical {
    label en official "the person commences operations at premises for the production, blending, cellar treatment, storage, bottling, packaging, or repackaging of untaxpaid wine (other than exempt section 5042 wine), including the use of wine spirits in wine production (section 5351(a))";
}
pub relation wine_premises_application_made(p: Person, prem: WineCellarPremises) kind empirical {
    label en official "the person has made application to the Secretary (section 5351(a))";
}
pub relation wine_premises_bond_filed(p: Person, prem: WineCellarPremises) kind empirical {
    label en official "the person has filed bond (section 5351(a))";
}
pub relation wine_premises_permission_received(p: Person, prem: WineCellarPremises) kind empirical {
    label en official "the person has received permission to operate (section 5351(a))";
}
pub relation wine_premises_bond_excepted_under_5551d(p: Person, prem: WineCellarPremises) kind empirical {
    label en official "the person is within the section 5551(d) exception from filing bond (section 5351(a))";
}
pub relation wine_premises_bond_satisfied(p: Person, prem: WineCellarPremises) kind institutional {
    label en unofficial "bond filed, or the section 5551(d) exception applies (single-atom helper)";
}
rule WineBondSatisfiedByFilingRule(p: Person, prem: WineCellarPremises) strict {
    label en unofficial "the bond requirement is satisfied by filing the bond";
    when wine_premises_bond_filed(p, prem);
    then wine_premises_bond_satisfied(p, prem);
}
rule WineBondSatisfiedByExceptionRule(p: Person, prem: WineCellarPremises) strict {
    label en unofficial "the bond requirement is satisfied by the section 5551(d) exception";
    when wine_premises_bond_excepted_under_5551d(p, prem);
    then wine_premises_bond_satisfied(p, prem);
}
pub relation wine_premises_qualified(p: Person, prem: WineCellarPremises) kind institutional {
    label en unofficial "the person has applied, filed bond (or is excepted), and received permission (helper for the prohibition)";
}
rule WinePremisesQualifiedRule(p: Person, prem: WineCellarPremises) defeasible {
    label en unofficial "application made, bond satisfied, and permission received make the premises qualified";
    when wine_premises_application_made(p, prem);
    when wine_premises_bond_satisfied(p, prem);
    when wine_premises_permission_received(p, prem);
    then wine_premises_qualified(p, prem);
}
@source(IRC_S5351_A, coverage = exact, quote = "shall, before commencing operations, make application to the Secretary and, except as provided under section 5551(d), file bond and receive permission to operate.")
rule Section5351aQualificationProhibitionRule(p: Person, prem: WineCellarPremises) defeasible {
    label en official "section 5351(a): operations at untaxpaid-wine premises may not commence until application, bond (unless excepted), and permission";
    when person_establishes_untaxpaid_wine_premises(p, prem);
    unless wine_premises_qualified(p, prem) and person_establishes_untaxpaid_wine_premises(p, prem);
    then prohibition Section5351CommenceWithoutQualificationProhibition {
        bearer p;
        action person_establishes_untaxpaid_wine_premises(p, prem);
        window [-infinity, infinity];
    };
}
pub relation is_bonded_wine_cellar(prem: WineCellarPremises) kind institutional {
    label en official "the premises described in section 5351(a) are a bonded wine cellar for chapter 51 (section 5351(b)(1))";
}
rule Section5351b1BondedWineCellarRule(p: Person, prem: WineCellarPremises) defeasible {
    label en official "section 5351(b)(1): qualified untaxpaid-wine premises are a bonded wine cellar";
    when wine_premises_qualified(p, prem);
    then is_bonded_wine_cellar(prem);
}
pub relation secretary_designates_bonded_winery(prem: WineCellarPremises) kind empirical {
    label en official "the Secretary designates a bonded wine cellar that engages in production operations as a bonded winery (section 5351(b)(2))";
}
pub relation cellar_engages_in_production_operations(prem: WineCellarPremises) kind empirical {
    label en official "the bonded wine cellar engages in production operations";
}
pub relation is_bonded_winery(prem: WineCellarPremises) kind institutional {
    label en official "the bonded wine cellar is designated a bonded winery (section 5351(b)(2))";
}
@source(IRC_S5351_B, coverage = exact, quote = "any bonded wine cellar that engages in production operations may be designated as a")
rule Section5351b2BondedWineryDesignationRule(prem: WineCellarPremises) strict {
    label en official "section 5351(b)(2): the Secretary's discretionary designation power applies only to a bonded wine cellar that engages in production operations (E-0239 otherwise)";
    when secretary_designates_bonded_winery(prem);
    then power Section5351BondedWineryDesignation {
        holder us.irc.core::Secretary;
        over prem;
        exercise secretary_designates_bonded_winery(prem);
        valid_when cellar_engages_in_production_operations(prem);
        effect create(is_bonded_winery(prem));
        window [-infinity, infinity];
    };
}
pub relation person_bottles_or_repackages_taxpaid_wine(p: Person, prem: WineCellarPremises) kind empirical {
    label en official "the person bottles, packages, or repackages taxpaid wines (section 5352)";
}
pub relation taxpaid_bottling_permission_received(p: Person, prem: WineCellarPremises) kind empirical {
    label en official "the person has made application and received permission to operate (section 5352)";
}
@source(IRC_S5352, coverage = exact, quote = "Any person bottling, packaging, or repackaging taxpaid wines shall, before commencing such operations, make application to the Secretary and receive permission to operate.")
rule Section5352TaxpaidBottlingProhibitionRule(p: Person, prem: WineCellarPremises) defeasible {
    label en official "section 5352: taxpaid wine bottling, packaging, or repackaging may not commence until application is made and permission received";
    when person_bottles_or_repackages_taxpaid_wine(p, prem);
    unless taxpaid_bottling_permission_received(p, prem) and person_bottles_or_repackages_taxpaid_wine(p, prem);
    then prohibition Section5352TaxpaidBottlingWithoutPermissionProhibition {
        bearer p;
        action person_bottles_or_repackages_taxpaid_wine(p, prem);
        window [-infinity, infinity];
    };
}
pub relation warehouse_company_applied_with_consent_of_proprietor_and_surety(p: Person, cellar: WineCellarPremises) kind empirical {
    label en official "a responsible warehouse company or other responsible person files application with the Secretary with the consent of the proprietor and of the surety on the bond of the bonded wine cellar (section 5353)";
}
pub relation may_establish_bonded_wine_warehouse(p: Person, cellar: WineCellarPremises) kind institutional {
    label en official "the person may establish, on the cellar premises, facilities for the storage of wines and allied products for credit purposes, known as a bonded wine warehouse; the proprietor of the cellar remains responsible in all respects for operations in the warehouse (section 5353)";
}
@source(IRC_S5353, coverage = partial, quote = "Any responsible warehouse company or other responsible person may, upon filing application with the Secretary and consent of the proprietor and the surety on the bond of any bonded wine cellar, under regulations prescribed by the Secretary, establish on such premises facilities for the storage of wines and allied products for credit purposes, to be known as a \"bonded wine warehouse\".")
rule Section5353BondedWineWarehouseRule(p: Person, cellar: WineCellarPremises) strict {
    label en official "section 5353: a responsible warehouse company or person that files an application, with the consent of the proprietor and surety, may establish a bonded wine warehouse on the cellar premises";
    when warehouse_company_applied_with_consent_of_proprietor_and_surety(p, cellar);
    then may_establish_bonded_wine_warehouse(p, cellar);
}
pub relation wine_cellar_tax_on_wine_and_spirits_possessed_or_in_transit(cellar: WineCellarPremises, amount: Money) kind empirical {
    label en official "the tax on any wine or distilled spirits possessed or in transit at any one time, taking into account the appropriate amount of credit under section 5041(c) (section 5354)";
}
pub relation wine_cellar_bond_penal_sum_minimum(cellar: WineCellarPremises, amount: Money) kind institutional {
    label en official "the least penal sum of the bond for a bonded wine cellar (section 5354)";
}
@source(IRC_S5354, relation = formalizes, coverage = exact, quote = "shall be in a penal sum not less than the tax on any wine or distilled spirits possessed or in transit at any one time (taking into account the appropriate amount of credit with respect to such wine under section 5041(c)), but not less than $1,000 nor more than $50,000")
rule Section5354PenalSumMinimumRule(cellar: WineCellarPremises, tax: Money) strict {
    label en official "section 5354: the least penal sum is the tax on the wine and spirits possessed or in transit, floored at $1,000 and capped at $50,000 (and at $100,000 where the tax exceeds $250,000): the minimum is min(max(tax, 1,000), cap)";
    when wine_cellar_tax_on_wine_and_spirits_possessed_or_in_transit(cellar, tax);
    when tax <= WineBondLargeLiabilityTaxThreshold;
    then wine_cellar_bond_penal_sum_minimum(cellar, min(max(tax, WineBondMinimumPenalSum), WineBondMaximumPenalSum));
}
@source(IRC_S5354, relation = formalizes, coverage = exact, quote = "except that where the tax on such wine and on such distilled spirits exceeds $250,000, the penal sum of the bond shall be not more than $100,000.")
rule Section5354LargeLiabilityPenalSumRule(cellar: WineCellarPremises, tax: Money) strict {
    label en official "section 5354: where the tax exceeds $250,000 the least penal sum is the tax capped at $100,000 (INTERPRETATION: the exception replaces the $50,000 cap by $100,000)";
    when wine_cellar_tax_on_wine_and_spirits_possessed_or_in_transit(cellar, tax);
    when tax > WineBondLargeLiabilityTaxThreshold;
    then wine_cellar_bond_penal_sum_minimum(cellar, min(tax, WineBondLargeLiabilityMaximumPenalSum));
}

// =============================================================================
// Section 5362: removals of wine from bonded wine cellars
// =============================================================================

pub relation wine_withdrawn_on_payment_or_determination(w: WineRemoval, p: Person) kind empirical {
    label en official "the wine is withdrawn from a bonded wine cellar on payment or determination of the tax (section 5362(a))";
}
pub relation is_proprietor_of_wine_cellar(p: Person, cellar: WineCellarPremises) kind empirical {
    label en official "the person is the proprietor of the bonded wine cellar";
}
@source(IRC_S5362_A, coverage = exact, quote = "Wine may be withdrawn from bonded wine cellars on payment or determination of the tax thereon, under such regulations as the Secretary shall prescribe.")
rule Section5362aWithdrawalLibertyRule(w: WineRemoval, p: Person, cellar: WineCellarPremises) strict {
    label en official "section 5362(a): wine may be withdrawn from a bonded wine cellar on payment or determination of tax (liberty of the proprietor, per regulations)";
    when is_proprietor_of_wine_cellar(p, cellar);
    when wine_withdrawn_on_payment_or_determination(w, p);
    then liberty Section5362aWithdrawOnPayment {
        holder p;
        action wine_withdrawn_on_payment_or_determination(w, p);
        window [-infinity, infinity];
    };
}
pub relation wine_transferred_in_bond_between_bonded_premises(w: WineRemoval) kind empirical {
    label en official "untaxed wine is transferred in bond between bonded premises (section 5362(b)(1))";
}
pub relation transfer_in_bond_of_wine_is_not_removal_for_consumption_or_sale(w: WineRemoval) kind institutional {
    label en official "the removal of wine for transfer in bond between bonded premises is not a removal for consumption or sale (section 5362(b)(4))";
}
@source(IRC_S5362_B, coverage = exact, quote = "For purposes of this chapter, the removal of wine for transfer in bond between bonded premises shall not be treated as a removal for consumption or sale.")
rule Section5362b4TransferNotRemovalRule(w: WineRemoval) strict {
    label en official "section 5362(b)(4): a transfer in bond of wine is not a removal for consumption or sale";
    when wine_transferred_in_bond_between_bonded_premises(w);
    then transfer_in_bond_of_wine_is_not_removal_for_consumption_or_sale(w);
}
pub relation wine_transferred_to_distilled_spirits_plant_bonded_premises(w: WineRemoval) kind empirical {
    label en official "the wine is transferred to the bonded premises of a distilled spirits plant (section 5362(b)(2))";
}
pub relation wine_removed_from_dsp_bonded_premises_for_consumption_or_sale_as_wine(w: WineRemoval, p: Person) kind empirical {
    label en official "the wine is removed from the plant's bonded premises for consumption or sale as wine (section 5362(b)(2)(B))";
}
@source(IRC_S5362_B, coverage = exact, quote = "(B) may not be removed from such bonded premises for consumption or sale as wine.")
rule Section5362b2BNoRemovalAsWineProhibitionRule(w: WineRemoval, p: Person) strict {
    label en official "section 5362(b)(2)(B): wine transferred to a distilled spirits plant may not be removed for consumption or sale as wine";
    when wine_transferred_to_distilled_spirits_plant_bonded_premises(w);
    when wine_removed_from_dsp_bonded_premises_for_consumption_or_sale_as_wine(w, p);
    then prohibition Section5362NoRemovalAsWineFromPlantProhibition {
        bearer p;
        action wine_removed_from_dsp_bonded_premises_for_consumption_or_sale_as_wine(w, p);
        window [-infinity, infinity];
    };
}
pub relation wine_used_in_distilled_spirits_product(w: WineRemoval) kind empirical {
    label en official "the wine transferred to the plant has been used in a distilled spirits product (section 5362(b)(3))";
}
pub relation wine_tax_liability_continues_after_transfer_to_plant(w: WineRemoval) kind institutional {
    label en official "the liability for tax on wine transferred to the bonded premises of a distilled spirits plant continues until the wine is used in a distilled spirits product (section 5362(b)(3))";
}
@source(IRC_S5362_B, coverage = exact, quote = "shall (except as otherwise provided by law) continue until the wine is used in a distilled spirits product.")
rule Section5362b3LiabilityContinuesRule(w: WineRemoval) defeasible {
    label en official "section 5362(b)(3): tax liability on wine transferred to a plant continues until used in a distilled spirits product";
    when wine_transferred_to_distilled_spirits_plant_bonded_premises(w);
    unless wine_used_in_distilled_spirits_product(w) and wine_transferred_to_distilled_spirits_plant_bonded_premises(w);
    then wine_tax_liability_continues_after_transfer_to_plant(w);
}
pub enum WineWithdrawalWithoutTaxPurpose {
    ExportByProprietorOrAuthorizedExporter;
    ForeignTradeZone;
    VesselsAndAircraftSupplies;
    CustomsBondedWarehouse;
    VinegarProduction;
    DistillationInAuthorizedPlant;
    ExperimentalOrResearchByScientificInstitution;
    ProprietorAnalysisOrTesting;
    GovernmentUse;
}
pub relation wine_withdrawal_purpose(w: WineRemoval, purpose: WineWithdrawalWithoutTaxPurpose) kind empirical {
    label en official "the purpose for which untaxed wine is withdrawn from a bonded wine cellar (section 5362(c)(1)-(9))";
}
pub relation wine_untaxed_when_withdrawn(w: WineRemoval) kind empirical {
    label en official "the tax on the wine has not been paid or determined when it is withdrawn";
}
pub relation wine_withdrawal_regulations_and_bonds_satisfied(w: WineRemoval) kind empirical {
    label en official "the withdrawal is under the regulations and bonds the Secretary deems necessary to protect the revenue (section 5362(c) lead-in; no bond of a government agency under (c)(9))";
}
pub relation wine_withdrawal_authorized_without_payment_of_tax(w: WineRemoval, purpose: WineWithdrawalWithoutTaxPurpose) kind institutional {
    label en official "the withdrawal of untaxed wine for this purpose is authorized without payment (or free) of tax (section 5362(c))";
}
@source(IRC_S5362_C, coverage = exact, quote = "Wine on which the tax has not been paid or determined may, under such regulations and bonds as the Secretary may deem necessary to protect the revenue, be withdrawn from bonded wine cellars—")
rule Section5362cWithdrawalPurposesRule(w: WineRemoval, purpose: WineWithdrawalWithoutTaxPurpose) strict {
    label en official "section 5362(c)(1)-(9): untaxed wine may be withdrawn from a bonded wine cellar for export, a foreign-trade zone, vessel/aircraft supplies, a customs bonded warehouse, vinegar production, distillation at an authorized plant, scientific research, the proprietor's analysis/testing, or government use, under the Secretary's regulations and bonds";
    when wine_untaxed_when_withdrawn(w);
    when wine_withdrawal_purpose(w, purpose);
    when wine_withdrawal_regulations_and_bonds_satisfied(w);
    then wine_withdrawal_authorized_without_payment_of_tax(w, purpose);
}
pub relation wine_rendered_unfit_for_beverage_use(w: WineRemoval) kind empirical {
    label en official "the wine or wine product made from wine is rendered unfit for beverage use (section 5362(d))";
}
pub relation wine_product_alcohol_by_volume_percent(w: WineRemoval, pct: Decimal) kind empirical {
    label en official "the alcohol by volume of the wine or wine product withdrawn under section 5362(d)";
}
pub relation unfit_wine_used_in_compounding_spirits_or_wine_for_beverage_use(w: WineRemoval) kind empirical {
    label en official "the wine or wine product is used in the compounding of distilled spirits or wine for beverage use, or in the manufacture of a product intended for such compounding (section 5362(d))";
}
pub relation unfit_wine_free_withdrawal_authorized(w: WineRemoval) kind institutional {
    label en official "wine or wine products rendered unfit for beverage use may be withdrawn from bonded wine cellars free of tax, if not over 21 percent alcohol by volume and not used in beverage compounding (section 5362(d))";
}
@source(IRC_S5362_D, coverage = exact, quote = "may be withdrawn from bonded wine cellars free of tax.")
rule Section5362dUnfitWineFreeWithdrawalRule(w: WineRemoval, abv: Decimal) defeasible {
    label en official "section 5362(d): untaxed wine rendered unfit for beverage use may be withdrawn free of tax if it contains at most 21 percent alcohol by volume and is not used in beverage compounding";
    when wine_untaxed_when_withdrawn(w);
    when wine_rendered_unfit_for_beverage_use(w);
    when wine_product_alcohol_by_volume_percent(w, abv);
    when abv <= UnfitWineMaximumAlcoholByVolumePercent;
    unless unfit_wine_used_in_compounding_spirits_or_wine_for_beverage_use(w) and wine_rendered_unfit_for_beverage_use(w) and wine_product_alcohol_by_volume_percent(w, abv);
    then unfit_wine_free_withdrawal_authorized(w);
}
pub relation wine_from_customs_bonded_warehouse_withdrawn_for_official_or_family_use(w: WineRemoval, p: Person) kind empirical {
    label en official "wine withdrawn from a customs bonded warehouse or brought in free of tax for the official or family use of foreign governments, organizations, or individuals (section 5362(e)(3))";
}
pub relation official_use_wine_sold_disposed_or_possessed_for_other_than_authorized_use(w: WineRemoval, p: Person) kind empirical {
    label en official "the person sells, disposes of, or possesses the wine for a use other than an authorized use (section 5362(e)(3))";
}
@source(IRC_S5362_E, coverage = exact, quote = "shall not be sold and shall not be disposed of or possessed for any use other than an authorized use.")
rule Section5362e3NoSaleOfficialUseWineRule(w: WineRemoval, p: Person) strict {
    label en official "section 5362(e)(3): free-of-tax official-use wine may not be sold or disposed of or possessed for other than an authorized use";
    when wine_from_customs_bonded_warehouse_withdrawn_for_official_or_family_use(w, p);
    when official_use_wine_sold_disposed_or_possessed_for_other_than_authorized_use(w, p);
    then prohibition Section5362OfficialUseWineDiversionProhibition {
        bearer p;
        action official_use_wine_sold_disposed_or_possessed_for_other_than_authorized_use(w, p);
        window [-infinity, infinity];
    };
}
pub relation official_use_wine_withdrawn_for_domestic_use(w: WineRemoval) kind empirical {
    label en official "wine entered into customs bonded warehouses under (c)(4) for purposes of removal under paragraph (1) is withdrawn for domestic use (section 5362(e)(2))";
}
pub relation treated_as_american_goods_exported_and_returned(w: WineRemoval) kind institutional {
    label en official "the wine so withdrawn is treated as American goods exported and returned (section 5362(e)(2))";
}
@source(IRC_S5362_E, coverage = exact, quote = "Wines so withdrawn shall be treated as American goods exported and returned.")
rule Section5362e2AmericanGoodsReturnedRule(w: WineRemoval) strict {
    label en official "section 5362(e)(2): wine withdrawn from a customs bonded warehouse for domestic use is treated as American goods exported and returned";
    when official_use_wine_withdrawn_for_domestic_use(w);
    then treated_as_american_goods_exported_and_returned(w);
}
pub relation taxpaid_bottling_house_conducts_operation(prem: WineCellarPremises, p: Person) kind empirical {
    label en official "the proprietor of a taxpaid wine bottling house mixes wine of the same kind and taxable grade, preserves, filters, or clarifies wine, or conducts non-wine operations that will not jeopardize the revenue (section 5363)";
}
@source(IRC_S5363, coverage = partial, quote = "the proprietor of a taxpaid wine bottling house may, subject to regulations issued by the Secretary, on such premises mix wine of the same kind and taxable grade to facilitate handling; preserve, filter, or clarify wine; and conduct operations not involving wine where such operations will not jeopardize the revenue or conflict with wine operations.")
rule Section5363BottlingHouseLibertyRule(prem: WineCellarPremises, p: Person) strict {
    label en official "section 5363: in addition to bottling, a taxpaid wine bottling house proprietor may mix wine of the same kind and grade, preserve, filter, or clarify wine, and conduct non-wine operations that do not jeopardize the revenue";
    when person_bottles_or_repackages_taxpaid_wine(p, prem);
    when taxpaid_bottling_house_conducts_operation(prem, p);
    then liberty Section5363BottlingHouseOperations {
        holder p;
        action taxpaid_bottling_house_conducts_operation(prem, p);
        window [-infinity, infinity];
    };
}
pub relation bulk_natural_wine_transferred_from_customs_custody_to_cellar(w: WineRemoval, operator: Person, importer: Person) kind empirical {
    label en official "natural wine (section 5381) imported in bulk containers is withdrawn from customs custody and transferred in such containers to a bonded wine cellar without payment of tax (section 5364)";
}
pub relation wine_released_from_customs_custody_on(w: WineRemoval, on: Date) kind empirical {
    label en official "the date of release of the wine from customs custody";
}
pub relation cellar_proprietor_liable_from_customs_release(p: Person, w: WineRemoval, on: Date) kind institutional {
    label en official "the proprietor of the receiving bonded wine cellar becomes liable for the tax upon release from customs custody (section 5364)";
}
pub relation wine_importer_relieved_on_customs_transfer(p: Person, w: WineRemoval) kind institutional {
    label en official "the importer, or person bringing the wine in, is thereupon relieved of liability (section 5364)";
}
@source(IRC_S5364, coverage = exact, quote = "The proprietor of a bonded wine cellar to which such wine is transferred shall become liable for the tax on the wine withdrawn from customs custody under this section upon release of the wine from customs custody")
rule Section5364ProprietorLiableRule(w: WineRemoval, operator: Person, importer: Person, on: Date) strict {
    label en official "section 5364: the receiving cellar proprietor becomes liable on release from customs custody";
    when bulk_natural_wine_transferred_from_customs_custody_to_cellar(w, operator, importer);
    when wine_released_from_customs_custody_on(w, on);
    then cellar_proprietor_liable_from_customs_release(operator, w, on);
}
@source(IRC_S5364, coverage = exact, quote = "and the importer, or the person bringing such wine into the United States, shall thereupon be relieved of the liability for such tax.")
rule Section5364ImporterRelievedRule(w: WineRemoval, operator: Person, importer: Person) strict {
    label en official "section 5364: the importer is relieved of liability";
    when bulk_natural_wine_transferred_from_customs_custody_to_cellar(w, operator, importer);
    then wine_importer_relieved_on_customs_transfer(importer, w);
}

// =============================================================================
// Sections 5367, 5369-5373: records, inventories, losses, indemnity, wine spirits
// =============================================================================

pub relation cellar_proprietor_keeps_records_and_files_returns(p: Person) kind empirical {
    label en official "the proprietor keeps the records and files the returns the Secretary provides by regulations (section 5367)";
}
pub relation is_proprietor_of_cellar_or_taxpaid_bottling_house(p: Person) kind empirical {
    label en official "the person is the proprietor of a bonded wine cellar or a taxpaid wine bottling house";
}
@source(IRC_S5367, coverage = partial, quote = "The proprietor of a bonded wine cellar or a tax-paid wine bottling house shall keep such records and file such returns, in such form and containing such information, as the Secretary may by regulations provide.")
rule Section5367RecordsDutyRule(p: Person) strict {
    label en official "section 5367: the proprietor of a bonded wine cellar or taxpaid wine bottling house keeps records and files returns (form and content per regulations — EXTERNAL_DEPENDENCY)";
    when is_proprietor_of_cellar_or_taxpaid_bottling_house(p);
    then duty Section5367RecordsAndReturnsDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition cellar_proprietor_keeps_records_and_files_returns(p);
            window [-infinity, infinity];
        }
    };
}
pub relation cellar_inventories_taken_and_reported(p: Person) kind empirical {
    label en official "the proprietor takes and reports such inventories as the Secretary prescribes by regulations (section 5369)";
}
@source(IRC_S5369, coverage = exact, quote = "Each proprietor of premises subject to the provisions of this subchapter shall take and report such inventories as the Secretary may by regulations prescribe.")
rule Section5369InventoryDutyRule(p: Person) strict {
    label en official "section 5369: each proprietor of premises subject to subchapter F takes and reports the prescribed inventories";
    when is_proprietor_of_cellar_or_taxpaid_bottling_house(p);
    then duty Section5369InventoryDuty {
        bearer p;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition cellar_inventories_taken_and_reported(p);
            window [-infinity, infinity];
        }
    };
}
pub enum WineLossCause { Theft; VoluntaryDestruction; OtherLossOrDestruction; }
pub entity WineLoss {
    label en unofficial "a loss or destruction of wine while in bond (section 5370)";
}
pub relation wine_loss_cause(l: WineLoss, cause: WineLossCause) kind empirical {
    label en official "the wine was lost or destroyed while in bond, by this cause (section 5370(a))";
}
pub relation wine_theft_without_connivance_collusion_fraud_or_negligence(l: WineLoss) kind empirical {
    label en official "the Secretary finds the theft occurred without connivance, collusion, fraud, or negligence on the part of the proprietor, owner, consignor, consignee, bailee, or carrier, or their agents or employees (section 5370(a)(1)) — DECISION-0194 external judgment asserted as a fact";
}
pub relation wine_destroyed_under_government_supervision_or_on_approved_notice(l: WineLoss) kind empirical {
    label en official "the voluntary destruction was under Government supervision, or on such adequate notice to, and approval by, the Secretary as regulations provide (section 5370(a)(2))";
}
pub relation wine_loss_claim_filed_by(l: WineLoss, p: Person) kind empirical {
    label en official "the proprietor or other person liable for the tax files a claim for relief from the tax (section 5370(b))";
}
pub relation wine_loss_relieved_from_tax(l: WineLoss) kind institutional {
    label en official "no tax is collected in respect of the wine lost or destroyed (section 5370(a))";
}
pub relation wine_loss_claim_eligible(l: WineLoss) kind institutional {
    label en official "the loss does not fall within a section 5370(a)(1)-(2) exception to relief (single-atom valid_when helper)";
}
@source(IRC_S5370_A, coverage = exact, quote = "In the case of loss by theft, unless the Secretary shall find that the theft occurred without connivance, collusion, fraud, or negligence")
rule Section5370a1TheftEligibleRule(l: WineLoss) strict {
    label en official "section 5370(a)(1): a theft loss is relieved only where the Secretary finds it occurred without connivance, collusion, fraud, or negligence";
    when wine_loss_cause(l, Theft);
    when wine_theft_without_connivance_collusion_fraud_or_negligence(l);
    then wine_loss_claim_eligible(l);
}
@source(IRC_S5370_A, coverage = exact, quote = "In the case of voluntary destruction, unless the wine was destroyed under Government supervision, or on such adequate notice to, and approval by, the Secretary as regulations shall provide.")
rule Section5370a2DestructionEligibleRule(l: WineLoss) strict {
    label en official "section 5370(a)(2): voluntary destruction is relieved only where under Government supervision or on approved notice";
    when wine_loss_cause(l, VoluntaryDestruction);
    when wine_destroyed_under_government_supervision_or_on_approved_notice(l);
    then wine_loss_claim_eligible(l);
}
@source(IRC_S5370_A, coverage = exact, quote = "No tax shall be collected in respect of any wines lost or destroyed while in bond, except that tax shall be collected")
rule Section5370OtherLossEligibleRule(l: WineLoss) strict {
    label en official "section 5370(a): other losses or destructions while in bond (neither theft nor voluntary destruction) carry no tax";
    when wine_loss_cause(l, OtherLossOrDestruction);
    then wine_loss_claim_eligible(l);
}
@source(IRC_S5370_B, coverage = partial, quote = "the Secretary may require by regulations the proprietor of the bonded wine cellar or other person liable for the tax to file a claim for relief from the tax and submit proof as to the cause of such loss.")
rule Section5370LossReliefClaimRule(l: WineLoss, p: Person) strict {
    label en official "section 5370: the claim for relief from tax on wine lost or destroyed in bond is a power of the proprietor or other person liable; valid only when the loss is not an unexcused theft or unsupervised voluntary destruction (E-0239). The theft burden of proof on the claimant (section 5370(b) second sentence) is TECH_GAP";
    when wine_loss_claim_filed_by(l, p);
    then power Section5370LossReliefClaim {
        holder p;
        over l;
        exercise wine_loss_claim_filed_by(l, p);
        valid_when wine_loss_claim_eligible(l);
        effect create(wine_loss_relieved_from_tax(l));
        window [-infinity, infinity];
    };
}
pub relation wine_tax_relief_requested(l: WineLoss, amount: Money) kind empirical {
    label en official "the amount of tax relief, remission, abatement, refund, or credit sought on wine or wine spirits (section 5371)";
}
pub relation wine_claimant_indemnified_or_recompensed_amount(l: WineLoss, amount: Money) kind empirical {
    label en official "the amount by which the claimant is indemnified or recompensed for the tax (section 5371)";
}
pub relation wine_relief_allowed_amount(l: WineLoss, amount: Money) kind institutional {
    label en official "relief from wine tax is allowed only to the extent that the claimant is not indemnified or recompensed for the tax (section 5371)";
}
@source(IRC_S5371, coverage = exact, quote = "shall be allowed only to the extent that the claimant is not indemnified or recompensed for the tax.")
rule Section5371IndemnityLimitRule(l: WineLoss, requested: Money, indemnified: Money) strict {
    label en official "section 5371: the allowed relief is the amount requested less the amount indemnified or recompensed, and not below zero";
    when wine_tax_relief_requested(l, requested);
    when wine_claimant_indemnified_or_recompensed_amount(l, indemnified);
    then wine_relief_allowed_amount(l, max(requested - indemnified, 0.00 USD));
}
pub relation wine_used_in_bonded_cellar_for_testing_tasting_or_sampling(w: WineRemoval, p: Person) kind empirical {
    label en official "wine is utilized in a bonded wine cellar for testing, tasting, or sampling (section 5372)";
}
pub relation wine_sample_use_free_of_tax(w: WineRemoval) kind institutional {
    label en official "the wine so utilized is free of tax (section 5372)";
}
@source(IRC_S5372, coverage = exact, quote = "wine may be utilized in any bonded wine cellar for testing, tasting, or sampling, free of tax.")
rule Section5372SamplesFreeRule(w: WineRemoval, p: Person) strict {
    label en official "section 5372: wine used in a bonded wine cellar for testing, tasting, or sampling is free of tax";
    when wine_used_in_bonded_cellar_for_testing_tasting_or_sampling(w, p);
    then wine_sample_use_free_of_tax(w);
}
pub relation spirits_lot_is_brandy_or_wine_spirits_from_fruit_wine_or_residues(l: AlcoholicLot) kind empirical {
    label en official "the brandy or wine spirits are produced in a distilled spirits plant exclusively from fresh or dried fruit or their residues, the wine or wine residues, or special natural wine (section 5373(a)(1)-(3))";
}
pub relation wine_spirits_distillation_proof(l: AlcoholicLot, proof: Decimal) kind empirical {
    label en official "the proof at which the wine spirits were distilled (section 5373(a))";
}
pub relation wine_spirits_reduced_with_water_from_distillation_proof(l: AlcoholicLot) kind empirical {
    label en official "the wine spirits were reduced with water from distillation proof (section 5373(a))";
}
pub relation wine_spirits_sugar_wine_refermented_residuum(l: AlcoholicLot) kind empirical {
    label en official "in the production of natural wine or special natural wine sugar was used and the unfermented sugars in the wine or residuum were refermented (section 5373(a) proviso)";
}
pub relation regulations_provide_otherwise_for_wine_spirits(l: AlcoholicLot) kind empirical {
    label en official "regulations otherwise provide (section 5373(a)); the aged-commercial-brandy 2-year barreled-at-100-proof exception is a regulation-bound fact";
}
pub relation is_authorized_wine_spirits(l: AlcoholicLot) kind institutional {
    label en official "the spirits are wine spirits authorized to be used in wine production (section 5373(a))";
}
@source(IRC_S5373_A, coverage = partial, quote = "The wine spirits authorized to be used in wine production shall be brandy or wine spirits produced in a distilled spirits plant (with or without the use of water to facilitate extraction and distillation) exclusively from—")
rule Section5373aAuthorizedWineSpiritsRule(l: AlcoholicLot, proof: Decimal) defeasible {
    label en official "section 5373(a): authorized wine spirits are brandy or wine spirits made exclusively from fruit, wine or its residues, or special natural wine, not reduced with water from distillation proof and distilled at 140 proof or more, unless regulations otherwise provide; residuum of refermented sugar wine is excluded";
    when spirits_lot_is_brandy_or_wine_spirits_from_fruit_wine_or_residues(l);
    when wine_spirits_distillation_proof(l, proof);
    when proof >= WineSpiritsMinimumProof;
    unless wine_spirits_reduced_with_water_from_distillation_proof(l) and spirits_lot_is_brandy_or_wine_spirits_from_fruit_wine_or_residues(l) and wine_spirits_distillation_proof(l, proof) and not regulations_provide_otherwise_for_wine_spirits(l);
    unless wine_spirits_sugar_wine_refermented_residuum(l) and spirits_lot_is_brandy_or_wine_spirits_from_fruit_wine_or_residues(l) and wine_spirits_distillation_proof(l, proof);
    then is_authorized_wine_spirits(l);
}

// =============================================================================
// Sections 5381-5388: wine standards
// =============================================================================

pub relation lot_unfermented_liquid_sugar_used_in_volume_beyond_dry_sugar_equivalent(l: AlcoholicLot) kind empirical {
    label en official "liquid sugar is used so that the resultant volume exceeds the volume that could result from the maximum authorized use of pure dry sugar only (sections 5383(a), (b)(2), 5384(a))";
}
pub relation lot_is_natural_grape_wine(l: AlcoholicLot) kind empirical {
    label en official "the lot is natural grape wine";
}
pub relation lot_sweetened_after_fermentation_and_before_taxpayment(l: AlcoholicLot) kind empirical {
    label en official "the lot is sweetened with pure dry sugar or liquid sugar after fermentation and before taxpayment (section 5383(a))";
}
pub relation grape_wine_sweetening_permitted_5383a(l: AlcoholicLot) kind institutional {
    label en official "sweetening of natural grape wine under section 5383(a) is permitted: total solids not over 12 percent of the weight, alcohol not over 14 percent by volume after sweetening, and liquid sugar not beyond the dry-sugar volume";
}
@source(IRC_S5383_A, coverage = exact, quote = "if the total solids content of the finished wine does not exceed 12 percent of the weight of the wine and the alcoholic content of the finished wine after sweetening is not more than 14 percent by volume")
rule Section5383aSweeteningRule(l: AlcoholicLot, solids: Decimal, abv: Decimal) defeasible {
    label en official "section 5383(a): a natural grape wine may be sweetened after fermentation and before taxpayment if finished total solids are at most 12 percent by weight and alcohol at most 14 percent by volume (liquid sugar limited to the dry-sugar volume)";
    when lot_is_natural_grape_wine(l);
    when lot_sweetened_after_fermentation_and_before_taxpayment(l);
    when lot_total_solids_percent_by_weight(l, solids);
    when solids <= GrapeWineSweeteningMaximumSolidsPercent;
    when lot_alcohol_by_volume_percent(l, abv);
    when abv <= WineAbvBoundaryPercent;
    unless lot_unfermented_liquid_sugar_used_in_volume_beyond_dry_sugar_equivalent(l) and lot_is_natural_grape_wine(l) and lot_sweetened_after_fermentation_and_before_taxpayment(l) and lot_total_solids_percent_by_weight(l, solids) and lot_alcohol_by_volume_percent(l, abv);
    then grape_wine_sweetening_permitted_5383a(l);
}
pub relation lot_juice_natural_fixed_acid_parts_per_thousand(l: AlcoholicLot, ppt: Decimal) kind empirical {
    label en official "natural fixed acid content of the juice, calculated before fermentation and as tartaric acid (malic for apple wine, citric for other fruit and berry wines under section 5384(b)(2)(A)), parts per thousand";
}
pub relation lot_ameliorating_material_share_of_volume_percent(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "the ameliorating material as a percent of the combined volume of juice (exclusive of pulp) and ameliorating material (section 5383(b)(1))";
}
pub relation lot_fixed_acid_after_amelioration_parts_per_thousand(l: AlcoholicLot, ppt: Decimal) kind empirical {
    label en official "the natural fixed acid content of the juice after amelioration";
}
pub relation lot_of_winemaker_own_production(l: AlcoholicLot) kind empirical {
    label en official "the wine is of the winemaker's own production (section 5392(f))";
}
pub relation high_acid_amelioration_permitted(l: AlcoholicLot) kind institutional {
    label en official "amelioration of a natural grape wine of the winemaker's own production made from high-acid juice is permitted within section 5383(b)(1) (fixed acid above 5 per thousand, not reduced below 5, ameliorating material not over 35 percent)";
}
@source(IRC_S5383_B, coverage = exact, quote = "may be added to natural grape wines of a winemaker's own production when such wines are made from juice having a natural fixed acid content of more than five parts per thousand")
rule Section5383b1AmeliorationRule(l: AlcoholicLot, acid: Decimal, after: Decimal, share: Decimal) strict {
    label en official "section 5383(b)(1): high-acid grape wine of own production may be ameliorated if the juice fixed acid exceeds 5 per thousand, the acid is not reduced below 5, and the material is at most 35 percent of the volume";
    when lot_is_natural_grape_wine(l);
    when lot_of_winemaker_own_production(l);
    when lot_juice_natural_fixed_acid_parts_per_thousand(l, acid);
    when acid > HighAcidMinimumFixedAcidPartsPerThousandExclusive;
    when lot_fixed_acid_after_amelioration_parts_per_thousand(l, after);
    when after >= HighAcidMinimumFixedAcidPartsPerThousandExclusive;
    when lot_ameliorating_material_share_of_volume_percent(l, share);
    when share <= AmeliorationMaximumShareOfVolumePercent;
    then high_acid_amelioration_permitted(l);
}
pub relation high_acid_wine_sweetening_permitted_5383b2(l: AlcoholicLot) kind institutional {
    label en official "sweetening of a high-acid wine after amelioration and fermentation is permitted: total solids up to 17 percent by weight if alcohol is above 14 percent by volume, or 21 percent if not above 14 percent (section 5383(b)(2))";
}
@source(IRC_S5383_B, coverage = exact, quote = "(A) 17 percent by weight if the alcoholic content is more than 14 percent by volume")
rule Section5383b2HighAlcoholRule(l: AlcoholicLot, solids: Decimal, abv: Decimal) defeasible {
    label en official "section 5383(b)(2)(A): high-acid wine above 14 percent alcohol may be sweetened up to 17 percent total solids";
    when high_acid_amelioration_permitted(l);
    when lot_alcohol_by_volume_percent(l, abv);
    when abv > WineAbvBoundaryPercent;
    when lot_total_solids_percent_by_weight(l, solids);
    when solids <= HighAcidWineHighAbvSolidsPercent;
    unless lot_unfermented_liquid_sugar_used_in_volume_beyond_dry_sugar_equivalent(l) and high_acid_amelioration_permitted(l) and lot_alcohol_by_volume_percent(l, abv) and lot_total_solids_percent_by_weight(l, solids);
    then high_acid_wine_sweetening_permitted_5383b2(l);
}
@source(IRC_S5383_B, coverage = exact, quote = "or (B) 21 percent by weight if the alcoholic content is not more than 14 percent by volume.")
rule Section5383b2LowAlcoholRule(l: AlcoholicLot, solids: Decimal, abv: Decimal) defeasible {
    label en official "section 5383(b)(2)(B): high-acid wine at most 14 percent alcohol may be sweetened up to 21 percent total solids";
    when high_acid_amelioration_permitted(l);
    when lot_alcohol_by_volume_percent(l, abv);
    when abv <= WineAbvBoundaryPercent;
    when lot_total_solids_percent_by_weight(l, solids);
    when solids <= WineLowerAbvSolidsPercent;
    unless lot_unfermented_liquid_sugar_used_in_volume_beyond_dry_sugar_equivalent(l) and high_acid_amelioration_permitted(l) and lot_alcohol_by_volume_percent(l, abv) and lot_total_solids_percent_by_weight(l, solids);
    then high_acid_wine_sweetening_permitted_5383b2(l);
}
pub relation lot_alcohol_derived_from_fermentation_percent(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "the alcohol by volume derived from fermentation (section 5383(b)(3))";
}
pub relation wine_spirits_addition_permitted_5383b3(l: AlcoholicLot) kind institutional {
    label en official "wine spirits may be added (whether or not previously added) to wine produced under section 5383(b) only if it contains not more than 14 percent alcohol by volume derived from fermentation (section 5383(b)(3))";
}
@source(IRC_S5383_B, coverage = exact, quote = "only if the wine contains not more than 14 percent of alcohol by volume derived from fermentation.")
rule Section5383b3WineSpiritsRule(l: AlcoholicLot, pct: Decimal) strict {
    label en official "section 5383(b)(3): wine spirits are added to high-acid wine only if fermentation alcohol is at most 14 percent by volume";
    when high_acid_amelioration_permitted(l);
    when lot_alcohol_derived_from_fermentation_percent(l, pct);
    when pct <= WineAbvBoundaryPercent;
    then wine_spirits_addition_permitted_5383b3(l);
}
pub relation lot_is_natural_wine_from_fruit_other_than_grapes(l: AlcoholicLot) kind empirical {
    label en official "the lot is natural wine made from berries or fruit other than grapes (section 5384(a))";
}
pub relation fruit_wine_sugar_addition_permitted_5384a(l: AlcoholicLot) kind institutional {
    label en official "pure dry sugar or liquid sugar may be added to the juice in the fermenter or to the wine after fermentation only if the wine has at most 14 percent alcohol by volume after complete fermentation (and sweetening) and total solids at most 21 percent by weight (section 5384(a))";
}
@source(IRC_S5384_A, coverage = exact, quote = "but only if such wine has not more than 14 percent alcohol by volume after complete fermentation, or after complete fermentation and sweetening, and a total solids content not in excess of 21 percent by weight")
rule Section5384aSugarAdditionRule(l: AlcoholicLot, abv: Decimal, solids: Decimal) defeasible {
    label en official "section 5384(a): sugar may be added to fruit or berry wine other than grape wine if the wine ends at most 14 percent alcohol and 21 percent total solids (liquid sugar limited to the dry-sugar volume)";
    when lot_is_natural_wine_from_fruit_other_than_grapes(l);
    when lot_alcohol_by_volume_percent(l, abv);
    when abv <= WineAbvBoundaryPercent;
    when lot_total_solids_percent_by_weight(l, solids);
    when solids <= WineLowerAbvSolidsPercent;
    unless lot_unfermented_liquid_sugar_used_in_volume_beyond_dry_sugar_equivalent(l) and lot_is_natural_wine_from_fruit_other_than_grapes(l) and lot_alcohol_by_volume_percent(l, abv) and lot_total_solids_percent_by_weight(l, solids);
    then fruit_wine_sugar_addition_permitted_5384a(l);
}
pub relation fruit_wine_amelioration_share_cap_percent(l: AlcoholicLot, cap: Decimal) kind institutional {
    label en official "the maximum ameliorating material as a share of the volume for a fruit or berry wine under section 5384(b): 35 percent, or 60 percent for wine made exclusively from a fruit or berry whose natural fixed acid is 20 per thousand or more before correction (section 5384(b)(2)(D))";
}
pub relation lot_made_exclusively_from_fruit_with_natural_fixed_acid(l: AlcoholicLot, ppt: Decimal) kind empirical {
    label en official "the wine is made exclusively from a fruit or berry with this natural fixed acid, before any correction (section 5384(b)(2)(D))";
}
@source(IRC_S5384_B, coverage = exact, quote = "(D) Wines made exclusively from any fruit or berry with a natural fixed acid of 20 parts per thousand or more (before any correction of such fruit or berry) shall be entitled to a volume of ameliorating material not in excess of 60 percent (in lieu of 35 percent).")
rule Section5384b2DVeryHighAcidCapRule(l: AlcoholicLot, ppt: Decimal) strict {
    label en official "section 5384(b)(2)(D): very-high-acid fruit wines may use ameliorating material up to 60 percent of the volume";
    when lot_made_exclusively_from_fruit_with_natural_fixed_acid(l, ppt);
    when ppt >= VeryHighAcidFruitFixedAcidPartsPerThousand;
    then fruit_wine_amelioration_share_cap_percent(l, VeryHighAcidAmeliorationMaximumShareOfVolumePercent);
}
@source(IRC_S5384_B, coverage = exact, quote = "(in lieu of 35 percent)")
rule Section5384b2CStandardCapRule(l: AlcoholicLot, ppt: Decimal) defeasible {
    label en official "section 5384(b)(2)(D) 'in lieu of 35 percent' with section 5383(b)(1): the ordinary share cap of 35 percent applies unless the (D) 60 percent entitlement does";
    when lot_made_exclusively_from_fruit_with_natural_fixed_acid(l, ppt);
    unless ppt >= VeryHighAcidFruitFixedAcidPartsPerThousand and lot_made_exclusively_from_fruit_with_natural_fixed_acid(l, ppt);
    then fruit_wine_amelioration_share_cap_percent(l, AmeliorationMaximumShareOfVolumePercent);
}
pub relation lot_made_by_adding_sugar_juice_to_own_natural_wine(l: AlcoholicLot) kind empirical {
    label en official "the product is made by adding to natural wine of the winemaker's own production a sufficient quantity of pure dry sugar, or juice or concentrated juice from the same kind of fruit, separately or in combination (section 5385(a))";
}
@source(IRC_S5385_A, coverage = exact, quote = "to produce a finished product having a total solids content in excess of 17 percent by weight and an alcoholic content of not more than 14 percent by volume")
rule Section5385aSpeciallySweetenedRule(l: AlcoholicLot, solids: Decimal, abv: Decimal) strict {
    label en official "section 5385(a): natural wine of own production sweetened to over 17 percent total solids and at most 14 percent alcohol by volume is specially sweetened natural wine (the explicit inclusion of extra sweet kosher wine is a fact of classification)";
    when lot_made_by_adding_sugar_juice_to_own_natural_wine(l);
    when lot_total_solids_percent_by_weight(l, solids);
    when solids > SpeciallySweetenedMinimumSolidsPercentExclusive;
    when lot_alcohol_by_volume_percent(l, abv);
    when abv <= WineAbvBoundaryPercent;
    then is_specially_sweetened_natural_wine(l);
}
pub relation lot_wine_spirits_added(l: AlcoholicLot) kind empirical {
    label en official "wine spirits have been added to the wine";
}
pub relation specially_sweetened_wine_wine_spirits_addition_prohibited(l: AlcoholicLot) kind institutional {
    label en official "wine spirits may not be added to specially sweetened natural wine (section 5385(b))";
}
@source(IRC_S5385_B, coverage = exact, quote = "Wine spirits may not be added to specially sweetened natural wine.")
rule Section5385bNoWineSpiritsRule(l: AlcoholicLot) strict {
    label en official "section 5385(b): wine spirits may not be added to specially sweetened natural wine";
    when is_specially_sweetened_natural_wine(l);
    then specially_sweetened_wine_wine_spirits_addition_prohibited(l);
}
pub relation lot_agricultural_wines_from_different_commodities_blended(l: AlcoholicLot) kind empirical {
    label en official "wines from different agricultural commodities are blended together (section 5387(c))";
}
pub relation lot_wine_spirits_coloring_or_flavoring_used(l: AlcoholicLot) kind empirical {
    label en official "wine spirits were added, or coloring material or herbs or other flavoring material (except hops in honey wine) were used, in the production (section 5387(b))";
}
pub relation lot_made_from_agricultural_products_other_than_fruit_juice(l: AlcoholicLot) kind empirical {
    label en official "the wine is made from agricultural products other than the juice of fruit and in accordance with good commercial practice as prescribed by regulations (section 5387(a))";
}
@source(IRC_S5387_A, coverage = partial, quote = "Wines made in accordance with such regulations shall be classed as \"standard agricultural wines\".")
rule Section5387aStandardAgriculturalWineRule(l: AlcoholicLot) defeasible {
    label en official "section 5387(a)-(c): wine made from non-juice agricultural products in accordance with the Secretary's regulations is standard agricultural wine, provided no wine spirits, coloring, herbs, or flavoring (except hops in honey wine) are used and wines of different commodities are not blended";
    when lot_made_from_agricultural_products_other_than_fruit_juice(l);
    unless lot_wine_spirits_coloring_or_flavoring_used(l) and lot_made_from_agricultural_products_other_than_fruit_juice(l);
    unless lot_agricultural_wines_from_different_commodities_blended(l) and lot_made_from_agricultural_products_other_than_fruit_juice(l);
    then is_standard_agricultural_wine(l);
}
pub relation wine_effervescent_finished_product_abv(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "the alcohol by volume of the finished effervescent wine (section 5382(b)(5))";
}
pub relation effervescent_refermentation_and_dosage_permitted(l: AlcoholicLot) kind institutional {
    label en official "preparations for refermentation and for dosage acceptable in good commercial practice are proper cellar treatment of effervescent wine only if the finished product does not exceed 14 percent by volume (section 5382(b)(5))";
}
@source(IRC_S5382_B, coverage = exact, quote = "but only if the alcoholic content of the finished product does not exceed 14 percent by volume.")
rule Section5382b5EffervescentRule(l: AlcoholicLot, abv: Decimal) strict {
    label en official "section 5382(b)(5): effervescent wine refermentation and dosage preparations are proper cellar treatment only where the finished product is at most 14 percent by volume";
    when wine_effervescent_finished_product_abv(l, abv);
    when abv <= EffervescentWineFinishedMaximumAbvPercent;
    then effervescent_refermentation_and_dosage_permitted(l);
}
pub relation abv_after_wine_spirits_addition(l: AlcoholicLot, pct: Decimal) kind empirical {
    label en official "the alcoholic content, percent by volume, of the wine, juice, or concentrate after the addition of wine spirits (section 5382(b)(2)(A))";
}
pub relation wine_spirits_added_from_same_kind_of_fruit_distilled_in_us(l: AlcoholicLot) kind empirical {
    label en official "wine spirits (whether or not tax-paid) distilled in the United States from the same kind of fruit are added to natural wine or juice or must from one kind of fruit (section 5382(b)(2))";
}
pub relation still_wine_spirits_added_in_state_to_wine_fermented_in_same_state_cellar(l: AlcoholicLot) kind empirical {
    label en official "in the case of still wines, the wine spirits are added in a State only to natural wines produced by fermentation in bonded wine cellars located in the same State (section 5382(b)(2)(B))";
}
pub relation lot_is_still_wine(l: AlcoholicLot) kind empirical {
    label en official "the wine is still wine";
}
pub relation wine_spirits_addition_is_proper_cellar_treatment(l: AlcoholicLot) kind institutional {
    label en official "the addition of wine spirits is proper cellar treatment (section 5382(b)(2))";
}
@source(IRC_S5382_B, coverage = exact, quote = "(A) the wine, juice, or concentrate shall not have an alcoholic content in excess of 24 percent by volume after the addition of wine spirits")
rule Section5382b2WineSpiritsAdditionRule(l: AlcoholicLot, abv: Decimal) defeasible {
    label en official "section 5382(b)(2): adding same-fruit US wine spirits to natural wine, juice, or must is proper cellar treatment if the alcohol stays at most 24 percent by volume and (for still wine) the wine was fermented in a bonded cellar in the same State";
    when wine_spirits_added_from_same_kind_of_fruit_distilled_in_us(l);
    when abv_after_wine_spirits_addition(l, abv);
    when abv <= CellarTreatmentSpiritsAdditionMaximumAbvPercent;
    unless lot_is_still_wine(l) and not still_wine_spirits_added_in_state_to_wine_fermented_in_same_state_cellar(l) and wine_spirits_added_from_same_kind_of_fruit_distilled_in_us(l) and abv_after_wine_spirits_addition(l, abv);
    then wine_spirits_addition_is_proper_cellar_treatment(l);
}

// --- 5388: designations -----------------------------------------------------

pub enum SemiGenericWineName {
    Angelica; Burgundy; Claret; Chablis; Champagne; Chianti; Malaga; Marsala; Madeira;
    Moselle; Port; RhineWineOrHock; Sauterne; HautSauterne; Sherry; Tokay; Retsina;
}
pub relation wine_designated_by_name(l: AlcoholicLot, name: SemiGenericWineName) kind empirical {
    label en official "the wine bears this name of geographic significance which is also the designation of a class or type";
}
pub relation wine_name_is_statutory_semi_generic(l: AlcoholicLot) kind institutional {
    label en official "the name the wine bears is treated as semi-generic under section 5388(c)(2)(B)";
}
@source(IRC_S5388_C, coverage = exact, quote = "The following names shall be treated as semi-generic: Angelica, Burgundy, Claret, Chablis, Champagne, Chianti, Malaga, Marsala, Madeira, Moselle, Port, Rhine Wine or Hock, Sauterne, Haut Sauterne, Sherry, Tokay.")
rule Section5388c2BSemiGenericAngelicaRule(l: AlcoholicLot, name: SemiGenericWineName) strict {
    label en official "section 5388(c)(2)(B): Angelica is semi-generic";
    when wine_designated_by_name(l, name);
    when name == Angelica;
    then wine_name_is_statutory_semi_generic(l);
}
@source(IRC_S5388_C, coverage = exact, quote = "The following names shall be treated as semi-generic: Angelica, Burgundy, Claret, Chablis, Champagne, Chianti, Malaga, Marsala, Madeira, Moselle, Port, Rhine Wine or Hock, Sauterne, Haut Sauterne, Sherry, Tokay.")
rule Section5388c2BSemiGenericRestRule(l: AlcoholicLot, name: SemiGenericWineName) strict {
    label en official "section 5388(c)(2)(B): the other fifteen listed names are semi-generic (Retsina is NOT in this list; it only falls within paragraph (3)(C)(i))";
    when wine_designated_by_name(l, name);
    when name != Angelica;
    when name != Retsina;
    then wine_name_is_statutory_semi_generic(l);
}
pub relation semi_generic_designation_has_appellation_of_true_origin_in_direct_conjunction(l: AlcoholicLot) kind empirical {
    label en official "an appropriate appellation of origin disclosing the true place of origin appears in direct conjunction with the semi-generic designation (section 5388(c)(1)(A))";
}
pub relation wine_conforms_to_standard_of_identity_or_trade_understanding(l: AlcoholicLot) kind empirical {
    label en official "the wine conforms to the standard of identity for it in the regulations or, if none, to the trade understanding of the class or type (section 5388(c)(1)(B))";
}
pub relation wine_origin_differs_from_the_name_used(l: AlcoholicLot) kind empirical {
    label en official "the wine is of an origin other than that indicated by the semi-generic name";
}
pub relation wine_is_grape_wine_within_5388c3c(l: AlcoholicLot) kind empirical {
    label en official "the wine is grape wine designated Burgundy, Claret, Chablis, Champagne, Chianti, Malaga, Marsala, Madeira, Moselle, Port, Retsina, Rhine Wine or Hock, Sauterne, Haut Sauterne, Sherry, or Tokay (section 5388(c)(3)(C)(i))";
}
pub relation wine_is_intended_for_sale_outside_the_united_states(l: AlcoholicLot) kind empirical {
    label en official "the wine is intended for sale outside the United States (section 5388(c)(3)(C)(ii)(II))";
}
pub relation wine_bears_a_brand_name(l: AlcoholicLot) kind empirical {
    label en official "the wine bears a brand name (section 5388(c)(3)(C)(ii)(III))";
}
pub relation wine_of_european_community(l: AlcoholicLot) kind empirical {
    label en official "the wine is wine of the European Community (section 5388(c)(3)(A)(ii))";
}
pub relation holder_held_certificate_of_label_approval_before_2006_with_designation(l: AlcoholicLot, on: Date) kind empirical {
    label en official "the person using the designation (or its successor in interest) held a Certificate of Label Approval or Certificate of Exemption for a wine label bearing the brand name (and fanciful name) with the semi-generic designation before March 10, 2006 — the date of the certificate";
}
pub relation section_5388c3_applies_to_wine(l: AlcoholicLot) kind institutional {
    label en official "the special paragraph (3) regime applies to the grape wine: designated with a listed name, bearing a brand name, alcohol not below 7 nor above 24 percent by volume, not intended for sale outside the United States (section 5388(c)(3)(C))";
}
@source(IRC_S5388_C, coverage = exact, quote = "Except as provided in clause (ii), this paragraph shall apply to any grape wine which is designated as Burgundy, Claret, Chablis, Champagne, Chianti, Malaga, Marsala, Madeira, Moselle, Port, Retsina, Rhine Wine or Hock, Sauterne, Haut Sauterne, Sherry, or Tokay.")
rule Section5388c3CScopeRule(l: AlcoholicLot, abv: Decimal) defeasible {
    label en official "section 5388(c)(3)(C): paragraph (3) governs listed-name grape wine, except wine below 7 or above 24 percent alcohol by volume, intended for sale outside the United States, or without a brand name";
    when wine_is_grape_wine_within_5388c3c(l);
    when wine_bears_a_brand_name(l);
    when lot_alcohol_by_volume_percent(l, abv);
    when abv >= SemiGenericAlcoholLowerBoundPercent;
    when abv <= SemiGenericAlcoholUpperBoundPercent;
    unless wine_is_intended_for_sale_outside_the_united_states(l) and wine_is_grape_wine_within_5388c3c(l) and wine_bears_a_brand_name(l) and lot_alcohol_by_volume_percent(l, abv);
    then section_5388c3_applies_to_wine(l);
}
pub relation semi_generic_designation_use_permitted(l: AlcoholicLot) kind institutional {
    label en official "a semi-generic designation may be used for wine of an origin other than that indicated by the name (section 5388(c)(1) and, for wines within paragraph (3), (c)(3)(A)-(B))";
}
@source(IRC_S5388_C, coverage = exact, quote = "Semi-generic designations may be used to designate wines of an origin other than that indicated by such name only if—")
rule Section5388c1GeneralUseRule(l: AlcoholicLot) defeasible {
    label en official "section 5388(c)(1): a semi-generic designation may be used for wine of a different origin only with an appellation of true origin in direct conjunction and if the wine conforms to the standard of identity or trade understanding; paragraph (1) does not apply to wines within paragraph (3)";
    when wine_origin_differs_from_the_name_used(l);
    when semi_generic_designation_has_appellation_of_true_origin_in_direct_conjunction(l);
    when wine_conforms_to_standard_of_identity_or_trade_understanding(l);
    unless section_5388c3_applies_to_wine(l) and wine_origin_differs_from_the_name_used(l);
    then semi_generic_designation_use_permitted(l);
}
@source(IRC_S5388_C, coverage = exact, quote = "(iii) The requirement of this clause is met if the person, or its successor in interest, using the semi-generic designation held a Certificate of Label Approval or Certificate of Exemption from Label Approval issued by the Secretary for a wine label bearing such brand name, or brand name and fanciful name, before March 10, 2006, on which such semi-generic designation appeared.")
rule Section5388c3AOtherWineWithBrandRule(l: AlcoholicLot, certified_on: Date) defeasible {
    label en official "section 5388(c)(3)(A)(iii), (B)(i)-(iii): for wine within paragraph (3) bearing a brand name, the designation may be used only if all of: appellation of origin in conjunction, conformity to the standard of identity or trade understanding, and a certificate of label approval held before March 10, 2006 for the branded label (the European Community sub-rule (A)(ii) requires the (B)(ii) test alone; encoded as the general form for non-EC wine)";
    when section_5388c3_applies_to_wine(l);
    when wine_origin_differs_from_the_name_used(l);
    when semi_generic_designation_has_appellation_of_true_origin_in_direct_conjunction(l);
    when wine_conforms_to_standard_of_identity_or_trade_understanding(l);
    when holder_held_certificate_of_label_approval_before_2006_with_designation(l, certified_on);
    when certified_on < SemiGenericBrandLabelCutoff;
    unless wine_of_european_community(l) and section_5388c3_applies_to_wine(l);
    then semi_generic_designation_use_permitted(l);
}
@source(IRC_S5388_C, coverage = exact, quote = "(ii) in the case of wine of the European Community, designations referred to in subparagraph (C)(i) may be used for such wine only if the requirement of subparagraph (B)(ii) is met, and")
rule Section5388c3AiiEuropeanCommunityRule(l: AlcoholicLot) defeasible {
    label en official "section 5388(c)(3)(A)(ii): for wine of the European Community the designation may be used only if the wine conforms to the standard of identity or trade understanding";
    when section_5388c3_applies_to_wine(l);
    when wine_of_european_community(l);
    when wine_conforms_to_standard_of_identity_or_trade_understanding(l);
    then semi_generic_designation_use_permitted(l);
}

// =============================================================================
// Section 5391: exemption from distilled spirits taxes for wine spirits used in wine production
// =============================================================================

pub entity WineSpiritsUse {
    label en unofficial "the use of wine spirits in wine production in a bonded wine cellar";
}
pub relation wine_spirits_used_by_cellar_proprietor_in_wine_production(u: WineSpiritsUse, p: Person) kind empirical {
    label en official "the proprietor of a bonded wine cellar uses wine spirits in wine production on the premises (section 5391)";
}
pub relation wine_or_wine_spirits_used_in_violation_of_subchapter_f(u: WineSpiritsUse) kind empirical {
    label en official "the wine or wine spirits are used in violation of subchapter F (section 5391)";
}
pub relation proprietor_shows_not_knowingly_used_in_violation(u: WineSpiritsUse) kind empirical {
    label en official "the proprietor satisfactorily shows that the wine or wine spirits were not knowingly used in violation of law (section 5391)";
}
pub relation section_5001_tax_not_assessed_on_wine_spirits_use(u: WineSpiritsUse) kind institutional {
    label en official "the section 5001 tax is not assessed, levied, or collected from the proprietor with respect to the use of wine spirits in wine production (section 5391)";
}
pub relation section_5001_tax_collected_on_wine_spirits_use(u: WineSpiritsUse) kind institutional {
    label en official "the applicable section 5001 tax shall be collected (section 5391)";
}
@source(IRC_S5391, coverage = exact, quote = "shall not, except as provided in this subchapter, be assessed, levied, or collected from the proprietor of any bonded wine cellar with respect to his use of wine spirits in wine production, in such premises")
rule Section5391ExemptionRule(u: WineSpiritsUse, p: Person) defeasible {
    label en official "section 5391: the section 5001 tax is not collected from a bonded-wine-cellar proprietor for wine spirits used in wine production on the premises, unless used in violation of subchapter F";
    when wine_spirits_used_by_cellar_proprietor_in_wine_production(u, p);
    unless wine_or_wine_spirits_used_in_violation_of_subchapter_f(u) and wine_spirits_used_by_cellar_proprietor_in_wine_production(u, p);
    then section_5001_tax_not_assessed_on_wine_spirits_use(u);
}
@source(IRC_S5391, coverage = exact, quote = "whenever wine or wine spirits are used in violation of this subchapter, the applicable tax imposed by section 5001 shall be collected unless the proprietor satisfactorily shows that such wine or wine spirits were not knowingly used in violation of law.")
rule Section5391CollectionOnViolationRule(u: WineSpiritsUse, p: Person) defeasible {
    label en official "section 5391: wine or wine spirits used in violation of subchapter F attract the section 5001 tax unless the proprietor shows they were not knowingly used in violation of law";
    when wine_spirits_used_by_cellar_proprietor_in_wine_production(u, p);
    when wine_or_wine_spirits_used_in_violation_of_subchapter_f(u);
    unless proprietor_shows_not_knowingly_used_in_violation(u) and wine_or_wine_spirits_used_in_violation_of_subchapter_f(u) and wine_spirits_used_by_cellar_proprietor_in_wine_production(u, p);
    then section_5001_tax_collected_on_wine_spirits_use(u);
}

// =============================================================================
// Section 5392(d),(e),(f): total solids, same kind of fruit, own production
// =============================================================================

pub relation lot_dealcoholized_wine_degrees_brix(l: AlcoholicLot, brix: Decimal) kind empirical {
    label en official "the degrees Brix of the dealcoholized wine (section 5392(d))";
}
pub relation wine_total_solids_by_brix_percent(l: AlcoholicLot, pct: Decimal) kind institutional {
    label en official "for wine, total solids means the degrees Brix of the dealcoholized wine (section 5392(d)); a Brix degree is one percent by weight of sugar solids";
}
@source(IRC_S5392_D, coverage = exact, quote = "the term \"total solids\", in the case of wine, means the degrees Brix of the dealcoholized wine.")
rule Section5392dTotalSolidsRule(l: AlcoholicLot, brix: Decimal) strict {
    label en official "section 5392(d): the total solids of wine is the degrees Brix of the dealcoholized wine";
    when lot_dealcoholized_wine_degrees_brix(l, brix);
    then wine_total_solids_by_brix_percent(l, brix);
}
pub relation cellar_of_fermentation_of_wine(l: AlcoholicLot, cellar: WineCellarPremises) kind empirical {
    label en official "the bonded wine cellar in which the wine was produced by fermentation, whether or not produced by a predecessor in interest at that cellar (section 5392(f))";
}
pub relation wine_is_own_production_of_cellar(l: AlcoholicLot, cellar: WineCellarPremises) kind institutional {
    label en official "the wine is 'own production' with reference to the cellar: wine produced by fermentation in the same bonded wine cellar (section 5392(f))";
}
@source(IRC_S5392_F, coverage = partial, quote = "means wine produced by fermentation in the same bonded wine cellar, whether or not produced by a predecessor in interest at such bonded wine cellar.")
rule Section5392fOwnProductionRule(l: AlcoholicLot, cellar: WineCellarPremises) strict {
    label en official "section 5392(f): wine produced by fermentation in the same bonded wine cellar (even by a predecessor) is own production; the affiliated-cellar extension is regulation-bound (EXTERNAL_DEPENDENCY)";
    when cellar_of_fermentation_of_wine(l, cellar);
    then wine_is_own_production_of_cellar(l, cellar);
}
