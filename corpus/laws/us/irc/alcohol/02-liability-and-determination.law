// Sections 5005 (persons liable for tax) and 5006 (determination of tax).

// --- Section 5005: persons liable --------------------------------------------

use self::{
    Corporation,
    DistilledSpiritsOperation,
    IRC_S5005_A,
    IRC_S5005_B,
    IRC_S5005_C,
    IRC_S5006_A,
    IRC_S5006_C,
    Person,
    SpiritsRemoval,
};

pub relation is_distiller_or_importer(p: Person, r: SpiritsRemoval) kind empirical {
    label en official "p is the distiller or importer of the distilled spirits removed (section 5005(a))";
}
pub relation is_proprietor_of_bonded_premises(p: Person, r: SpiritsRemoval) kind empirical {
    label en official "p operates the bonded premises of the distilled spirits plant where the spirits are stored or in transit to (section 5005(c)(1))";
}
pub relation liable_for_spirits_tax(p: Person, r: SpiritsRemoval) kind institutional {
    label en official "the person is liable for the section 5001(a)(1) tax on this removal";
}
@source(IRC_S5005_A, coverage = exact, quote = "The distiller or importer of distilled spirits shall be liable for the taxes imposed thereon by section 5001(a)(1).")
rule Section5005aDistillerOrImporterLiableRule(p: Person, r: SpiritsRemoval) strict {
    label en official "section 5005(a): the distiller or importer is liable for the section 5001(a)(1) tax";
    when is_distiller_or_importer(p, r);
    then liable_for_spirits_tax(p, r);
}

// (b)(1): joint and several liability of every proprietor/possessor of, and
// person interested in the use of, a still/distillery — a SECOND,
// independent liable-person class over the same removal.
pub relation is_still_proprietor_or_interested_person(p: Person, r: SpiritsRemoval) kind empirical {
    label en official "p is a proprietor, possessor of, or person interested in the use of, the still/distilling apparatus/distillery that produced the spirits (section 5005(b)(1))";
}
@source(IRC_S5005_B, coverage = exact, quote = "Every proprietor or possessor of, and every person in any manner interested in the use of, any still, distilling apparatus, or distillery, shall be jointly and severally liable for the taxes imposed by law on the distilled spirits produced therefrom.")
rule Section5005b1JointAndSeveralLiabilityRule(p: Person, r: SpiritsRemoval) strict {
    label en official "section 5005(b)(1): every proprietor, possessor, or interested person is jointly and severally liable for the tax on spirits produced from the still";
    when is_still_proprietor_or_interested_person(p, r);
    then liable_for_spirits_tax(p, r);
}
// (b)(2): a de-minimis (<=10%) non-officer/director shareholder of a
// corporate proprietor is NOT deemed a liable person under (b)(1) — a
// classification carve-out, not a second liability rule.
pub relation minority_shareholder_of_corporate_proprietor(p: Person, corp: Corporation, share: Decimal) kind empirical {
    label en official "p owns or controls this percentage of a class of stock of a corporate proprietor of a distilled spirits plant (section 5005(b)(2))";
}
pub relation officer_or_director_of(p: Person, corp: Corporation) kind empirical {
    label en official "p is an officer or director of the corporate proprietor (section 5005(b)(2), second sentence: the exception to the exception)";
}
pub relation not_deemed_liable_under_b1(p: Person, corp: Corporation) kind institutional {
    label en official "p is not deemed a person liable under section 5005(b)(1) solely by reason of the minority shareholding (section 5005(b)(2))";
}
@source(IRC_S5005_B, coverage = exact, quote = "A person owning or having the right of control of not more than 10 percent of any class of stock of a corporate proprietor of a distilled spirits plant shall not be deemed to be a person liable for the tax for which such proprietor is liable under the provisions of paragraph (1). This exception shall not apply to an officer or director of such corporate proprietor.")
rule Section5005b2MinorityShareholderCarveOutRule(p: Person, corp: Corporation, share: Decimal) defeasible {
    label en official "section 5005(b)(2): a shareholder holding at most 10 percent, who is not an officer or director, is not a person liable under (b)(1) solely by reason of that shareholding";
    when minority_shareholder_of_corporate_proprietor(p, corp, share);
    when share <= 0.10;
    unless officer_or_director_of(p, corp) and minority_shareholder_of_corporate_proprietor(p, corp, share);
    then not_deemed_liable_under_b1(p, corp);
}

// (c)(1): the bonded-premises proprietor's liability while spirits are
// stored there or in transit to there, continuing until transfer/withdrawal
// or relief under section 5008(a).
@source(IRC_S5005_C, coverage = exact, quote = "Every person operating bonded premises of a distilled spirits plant shall be liable for the internal revenue tax on all distilled spirits while the distilled spirits are stored on such premises")
rule Section5005c1BondedPremisesProprietorLiableRule(p: Person, r: SpiritsRemoval) defeasible {
    label en official "section 5005(c)(1): the proprietor of bonded premises is liable for the tax on spirits stored (or in transit to) those premises";
    when is_proprietor_of_bonded_premises(p, r);
    unless relieved_under_5008a(p, r) and is_proprietor_of_bonded_premises(p, r);
    then liable_for_spirits_tax(p, r);
}
pub relation relieved_under_5008a(p: Person, r: SpiritsRemoval) kind institutional {
    label en unofficial "the person's section 5005(c)(1) liability has ended by reason of the loss relief of section 5008(a) (cross-package fact bridged from `loss_relieved_from_tax` in 03-losses-and-credits.law)";
}

// --- Section 5006: determination of tax --------------------------------------

pub relation tax_determined(r: SpiritsRemoval, on: Date) kind institutional {
    label en official "the tax on this removal of distilled spirits has been determined (section 5006(a)(1)) — the gauge-and-determination event, distinct from the earlier attachment (section 5001(b)) and the later payment (section 5061)";
}
@source(IRC_S5006_A, coverage = exact, quote = "the tax on distilled spirits shall be determined when the spirits are withdrawn from bond")
rule Section5006a1DeterminationOnWithdrawalRule(r: SpiritsRemoval, on: Date) strict {
    label en official "section 5006(a)(1): the tax is determined when the spirits are withdrawn from bond (upon completion of the gauge, before withdrawal from bonded premises)";
    when withdrawn_from_bond(r, on);
    then tax_determined(r, on);
}
pub relation withdrawn_from_bond(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "distilled spirits are withdrawn from the bonded premises of a distilled spirits plant on this date (section 5006(a)(1))";
}

// (a)(2): unaccounted-for production — an assessment on the shortfall
// between reported and actually-produced quantity, at the section 5001
// rate. Modelled as an institutional consequence keyed to the Secretary's
// finding, not a self-executing arithmetic rule over unasserted facts
// (EVALUATIVE per DECISION-0194: "finds ... from all the evidence he can
// obtain" is the Secretary's own judgment, asserted as the fact
// `unaccounted_production_determined`).
pub relation unaccounted_production_determined(op: DistilledSpiritsOperation, reported: Decimal, actual: Decimal) kind empirical {
    label en official "the Secretary has determined, from the evidence, that this operation actually produced more distilled spirits than it reported (section 5006(a)(2)) — DECISION-0194 evaluative channel: Secretary's own finding";
}
pub relation assessed_for_unaccounted_production(op: DistilledSpiritsOperation, amount: Money) kind institutional {
    label en official "an assessment for the difference between reported and actually-produced quantity, at the standard rate (section 5006(a)(2))";
}
@source(IRC_S5006_A, coverage = exact, quote = "an assessment shall be made for the difference between the quantity reported and the quantity shown to have been actually produced at the rate of tax imposed by law for every proof gallon")
rule Section5006a2UnaccountedProductionAssessmentRule(op: DistilledSpiritsOperation, reported: Decimal, actual: Decimal) strict {
    label en official "section 5006(a)(2): assessment for the shortfall at the standard per-proof-gallon rate";
    when unaccounted_production_determined(op, reported, actual);
    then assessed_for_unaccounted_production(op, (actual - reported) * DistilledSpiritsStandardRate);
}

// (c): tax on distilled spirits removed from the place of distillation
// without bonded-premises deposit — immediately assessed and demanded once
// the Secretary has knowledge, within the section 6501 limitation period.
pub relation removed_without_bonded_deposit(op: DistilledSpiritsOperation, r: SpiritsRemoval) kind empirical {
    label en official "distilled spirits were removed from the place of distillation and not deposited on bonded premises (section 5006(c)(1))";
}
pub relation secretary_has_knowledge_of_removal(r: SpiritsRemoval, on: Date) kind empirical {
    label en official "the Secretary obtains knowledge of the unbonded removal (section 5006(c)(1)) — triggers the assessment; the section 6501 limitation window itself is `assessment`(F02)'s own norm, referenced not reimplemented";
}
pub relation immediately_assessable(r: SpiritsRemoval) kind institutional {
    label en official "the tax on the unbonded removal may be immediately assessed and demanded (section 5006(c)(1))";
}
@source(IRC_S5006_C, coverage = exact, quote = "The tax on any distilled spirits, removed from the place where they were distilled and (except as otherwise provided by law) not deposited in storage on bonded premises of a distilled spirits plant, shall, at any time within the period of limitation provided in section 6501, when knowledge of such fact is obtained by the Secretary, be assessed on the distiller of such distilled spirits (or other person liable for the tax) and payment of such tax immediately demanded")
rule Section5006c1ImmediateAssessmentRule(op: DistilledSpiritsOperation, r: SpiritsRemoval, on: Date) strict {
    label en official "section 5006(c)(1): unbonded removal is immediately assessable once the Secretary has knowledge (within the section 6501 period)";
    when removed_without_bonded_deposit(op, r);
    when secretary_has_knowledge_of_removal(r, on);
    then immediately_assessable(r);
}
