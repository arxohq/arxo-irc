fragment IRC_S5601_TABLE_1 in IRC_2024_EDITION {
    kind table;
    locator "section/5601#table/T1";
    text en official """Present subd. of subsec. (a): / Prior sections | (2) / 5172, 5603. | (3) / 5603. | (4) / 5172, 5604, 5606. | (5) / 5604. | (6) / 5171, 5607. | (7) / 5216(a)(1), (4), 5608(a). | (8) / 5216(a)(1), 5608(a). | (9) / 5216(a)(1), 5608(a). | (10) / 5628, 5629. | (11) / 5629. | (12) / 5608(a), 5631, 5632, 5643, 5647. | (13) / 5634. | (14) / 5650.""";
    content_hash "sha256:6cd23b1dfd5399f96bbb7af60fde5aaf3f6dd1b2e66deb0481e553f234d628bc";
