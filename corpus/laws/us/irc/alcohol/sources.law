    locator "section/5273#table/T1";
    text en official """Present subsecs.: / Prior sections | (a) / 5331(a), (b). | (b) / 5303, 5305, 5310(a), 5331(a)(1), (2), (b), 5647. | (c) / 5332. | (d) / 5303, 5305, 5310(a), 5331(a), 5647. | (e)(1), (2) / 5334.""";
    content_hash "sha256:b2e25a57b400cc3e90d0992c09df94c6f3cf020ea812bb1ba05a9bf574cc63e4";
}

// 26 U.S.C. §5273 — statutory note 5 (effectivedate-amendment-note)
