// 26 U.S.C. 5177(a) — Other provisions relating to bonds
fragment IRC_S5177_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/5177/a";
    text en official """(a) General provisions relating to bonds
The provisions of section 5551 shall be applicable to the bonds required by or given under sections 5173 and 5175.""";
    content_hash "sha256:875dd00106ca985b6445263ec40d6d5880e7eb6f91515fad21cd962a1fc6cec7";
