    kind note;
    locator "section/5411/note/5";
    text en official """Effective Date of 1971 Amendment
Amendment by Pub. L. 91–673 effective on first day of first calendar month which begins more than 90 days after Jan. 12, 1971, see section 5 of Pub. L. 91–673, set out as a note under section 5056 of this title.""";
    content_hash "sha256:840ec1a83067f330e65de5d70a076d2f46635ac316f3bdafc373494124504f2d";
}

// 26 U.S.C. §5411 — statutory note 6 (effectivedate-note)
