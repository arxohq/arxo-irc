// 26 U.S.C. §5671 — Penalty and forfeiture for evasion of beer tax and fraudulent noncompliance with requirements
fragment IRC_S5671 in IRC_2024_EDITION {
    kind section;
    locator "section/5671";
    text en official """Penalty and forfeiture for evasion of beer tax and fraudulent noncompliance with requirements
Whoever evades or attempts to evade any tax imposed by section 5051, or with intent to defraud the United States fails or refuses to keep and file true and accurate records and returns as required by section 5415 and regulations issued pursuant thereto, shall be fined not more than $5,000, or imprisoned not more than 5 years, or both, for each such offense, and shall forfeit all beer made by him or for him, and all the vessels, utensils, and apparatus used in making the same.""";
    content_hash "sha256:74db98682a70d9f331cf64be412cb41b575efae810649d475f1f068a72934676";
}

// 26 U.S.C. §5671 — statutory note 5 (effectivedate-amendment-note)
fragment IRC_S5671_NOTE_5 in IRC_2024_EDITION {
    kind note;
    locator "section/5671/note/5";
    text en official """Effective Date of 2005 Amendment
Amendment by Pub. L. 109–59 effective July 1, 2008, but inapplicable to taxes imposed for periods before such date, see section 11125(c) of Pub. L. 109–59, set out as a note under section 5002 of this title.""";
    content_hash "sha256:fd87fad9e2b6f1a4ea699c99d350063ab3de916d506e772a5c2a0b1fcdaa9bbd";
}

// 26 U.S.C. §5671 — statutory note 6 (effectivedate-note)
fragment IRC_S5671_NOTE_6 in IRC_2024_EDITION {
