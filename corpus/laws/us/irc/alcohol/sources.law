// 26 U.S.C. 5215(a) — Return of tax determined distilled spirits to bonded premises
fragment IRC_S5215_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/5215/a";
    text en official """(a) General rule
Under such regulations as the Secretary may prescribe, distilled spirits on which tax has been determined or paid may be returned to the bonded premises of a distilled spirits plant but only for destruction, denaturation, redistillation, reconditioning, or rebottling.""";
    content_hash "sha256:2fe616e9e9dd8074591e47716989fe3b41a4afe70b0d8d55303fbead56003c8c";
}

// 26 U.S.C. 5215(b) — Return of tax determined distilled spirits to bonded premises
fragment IRC_S5215_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/5215/b";
    text en official """(b) Applicability of chapter to distilled spirits returned to a distilled spirits plant
All provisions of this chapter applicable to distilled spirits in bond shall be applicable to distilled spirits returned to bonded premises under the provisions of this section on such return.""";
    content_hash "sha256:c04d9136dc46617ce576016c45772ae2e2ce22eedf60527462d6ca79bf0b49a3";
}

// 26 U.S.C. 5215(c) — Return of tax determined distilled spirits to bonded premises
fragment IRC_S5215_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/5215/c";
    text en official """(c) Return of bottled distilled spirits for relabeling and reclosing
Under such regulations as the Secretary shall prescribe, bottled distilled spirits withdrawn from bonded premises may be returned to bonded premises for relabeling or reclosing, and the tax under section 5001 shall not again be collected on such spirits.""";
    content_hash "sha256:d98505206559e869067f46cb2c33f4a59080efae5475cd4fedc1a6a7e7609fd1";
}

// 26 U.S.C. 5215(d) — Return of tax determined distilled spirits to bonded premises
fragment IRC_S5215_D in IRC_2024_EDITION {
    kind subsection;
    locator "section/5215/d";
    text en official """(d) Cross reference
For provisions relating to the abatement, credit, or refund of tax on distilled spirits returned to a distilled spirits plant under this section, see section 5008(c).""";
    content_hash "sha256:a2444ec7f8f83acc9835fb0164c91b4d9deb548917cd7d0b8008b4ad9d99060a";
}

