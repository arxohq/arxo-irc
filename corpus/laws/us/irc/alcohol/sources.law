    locator "section/5401/c";
    text en official """(c) Exception from bond requirements for certain breweries
Subsection (b) shall not apply to any taxpayer for any period described in section 5551(d).""";
    content_hash "sha256:a31e6bc02d7e17b999b970dfb88fdeee59bad68aa5aee9ba781cda6a5790bb8d";
}

