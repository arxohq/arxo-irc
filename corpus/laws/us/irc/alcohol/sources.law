// 26 U.S.C. 5132(a) — Prohibited purchases by dealers
fragment IRC_S5132_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/5132/a";
    text en official """(a) In general
Except as provided in regulations prescribed by the Secretary, it shall be unlawful for a dealer to purchase distilled spirits for resale from any person other than a wholesale dealer in liquors who is required to keep the records prescribed by section 5121.""";
    content_hash "sha256:e630814d8922532e9c9828d1a590f827221d3e0edaca4dd67cb68f06d5bdac6a";
}

// 26 U.S.C. 5132(b) — Prohibited purchases by dealers
fragment IRC_S5132_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/5132/b";
    text en official """(b) Limited retail dealers
A limited retail dealer may lawfully purchase distilled spirits for resale from a retail dealer in liquors.""";
    content_hash "sha256:1fb5a41f3b382db6900b94d80f2ebe80420d62baecfc30c6e9495e949cdcb9e3";
}

// 26 U.S.C. 5132(c) — Prohibited purchases by dealers
fragment IRC_S5132_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/5132/c";
    text en official """(c) Penalty and forfeiture
For penalty and forfeiture provisions applicable to violations of subsection (a), see sections 5687 and 7302.""";
    content_hash "sha256:5335746b7bce9addd9af8a0bfa26eb84a03bc160928d9fdeaf6a054474698850";
}

// 26 U.S.C. §5132 — statutory note 4 (effectivedate-note)
