}

// 26 U.S.C. §5512 — Control of products after manufacture
fragment IRC_S5512 in IRC_2024_EDITION {
    kind section;
    locator "section/5512";
    text en official """Control of products after manufacture
For applicability of all provisions of this chapter pertaining to distilled spirits and wines, including those requiring payment of tax, to volatile fruit-flavor concentrates sold, transported, or used in violation of law or regulations, see section 5001(a)(6).""";
    content_hash "sha256:8a6fb6a1f2df3b260322184781291b0f1dd8e0dd3bef6de1cb3d5766cf1425e2";
}

