fragment IRC_HEAD_PART_E_51_G_II in IRC_2024_EDITION {
    kind heading;
    locator "part/E/51/G/II";
    text en official """Part E/51/G/II""";
    content_hash "sha256:04a6bc24b4d9508facd27d67885335f330fc144c61d1a7d34c17377f83bfd6fa";
