// 26 U.S.C. 5131(a) — Packaging distilled spirits for industrial uses
fragment IRC_S5131_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/5131/a";
    text en official """(a) General
The Secretary may, at his discretion and under such regulations as he may prescribe, authorize a dealer (as defined in section 5121(c)) engaging in the business of supplying distilled spirits for industrial uses to package distilled spirits, on which the tax has been paid or determined, for such uses in containers of a capacity in excess of 1 wine gallon and not more than 5 wine gallons.""";
    content_hash "sha256:451c00103bbdb4613a636396b9ce826cd97c974cdea5e28334bf99188ba6c402";
}

// 26 U.S.C. 5131(b) — Packaging distilled spirits for industrial uses
fragment IRC_S5131_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/5131/b";
    text en official """(b) Cross reference
For provisions relating to containers of distilled spirits, see section 5206.""";
    content_hash "sha256:20f98fe8926fb355c0c47c810316b773897518571910e41ef1e1bda11550e3bc";
}

