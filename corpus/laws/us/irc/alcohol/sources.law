// 26 U.S.C. §5235 — Bottling of alcohol for industrial purposes
fragment IRC_S5235 in IRC_2024_EDITION {
    kind section;
    locator "section/5235";
    text en official """Bottling of alcohol for industrial purposes
Alcohol for industrial purposes may be bottled, labeled, and cased on bonded premises of a distilled spirits plant prior to payment or determination of tax, under such regulations as the Secretary may prescribe.""";
    content_hash "sha256:b1ee03aa3a1660cfcdc779ef45c3b051ca5eea55c3916913a0ab96cc52cb3841";
}

// 26 U.S.C. §5235 — statutory note 5 (effectivedate-amendment-note)
