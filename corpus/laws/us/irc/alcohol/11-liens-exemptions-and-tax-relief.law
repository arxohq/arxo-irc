// Stage 2. Section 5004 (lien on distilled spirits), section 5007(b)
// (Secretary collects import tax), section 5011 (distilled spirits credit),
// section 5042 (wine exemptions), section 5043 (persons liable for wine
// tax), section 5044 (wine returned to bond), section 5054 (beer:
// determination and payment), section 5055 (beer drawback), section 5056
// (beer refunds and relief), section 5067 (no reduced rates for smuggled or
// unauthorized product).

use self::{
    AlcoholicLot,
    BeerMovement,
    Brewery,
    Household,
    IRC_S5004_A,
    IRC_S5007_B,
    IRC_S5011_A,
    IRC_S5011_B,
    IRC_S5042_A,
    IRC_S5043_A,
    IRC_S5044_A,
    IRC_S5044_B,
    IRC_S5054_A,
    IRC_S5054_B,
    IRC_S5055,
    IRC_S5056_A,
    IRC_S5056_D,
    IRC_S5067,
    Person,
    SpiritsRemoval,
    WineRemoval,
    adult_count_in_household,
    average_tax_financing_cost_for_credit,
    removed_for_consumption_or_sale,
};

pub const WineHouseholdExemptionMultiAdultGallons: Decimal = 200.0 {
    label en official "200 gallons per calendar year if there are 2 or more adults in the household (section 5042(a)(2)(B)(i))";
};
pub const WineHouseholdExemptionSingleAdultGallons: Decimal = 100.0 {
    label en official "100 gallons per calendar year if there is only 1 adult in the household (section 5042(a)(2)(B)(ii))";
};
pub const AdultStatutoryMinimumAgeYears: Integer = 18 {
    label en official "an individual who has attained 18 years of age (section 5042(a)(2)(C)); the greater of this and the local minimum wine-sale age governs";
};
pub const DeemedFederalExciseTaxPerCase: Money = 25.68 USD {
    label en official "the deemed Federal excise tax per case is $25.68 (section 5011(c)(3))";
};
pub const CaseLitersDivisor: Integer = 9 {
    label en official "the number of cases in a lot is the number of liters divided by 9 (section 5011(d)(2)); a case is 12 80-proof 750-milliliter bottles = 9 liters (section 5011(d)(1))";
};
pub const DrawbackClaimWindowMonths: Integer = 6 {
    label en official "claims under sections 5044(b) and 5056(d) must be filed within 6 months";
};

// =============================================================================
// Section 5004: lien on distilled spirits
// =============================================================================

pub enum SpiritsLienTerminatingEvent {
    WithdrawnOnDeterminationOfTax;
    WithdrawnFreeUnder5214a1;
    WithdrawnFreeUnder5214a2;
    WithdrawnFreeUnder5214a3;
    WithdrawnFreeUnder5214a11;
    WithdrawnFreeUnder5214a12;
    WithdrawnFreeUnderSection7510;
    Exported;
    DepositedInForeignTradeZone;
    UsedInWineProduction;
    LadenAsVesselOrAircraftSupplies;
    UsedInMaintenanceOrRepairOfVesselOrAircraft;
    DepositedInCustomsBondedWarehouse;
    UsedInResearchDevelopmentOrTesting;
}
pub relation spirits_exist_as_such(r: SpiritsRemoval) kind empirical {
    label en official "the distilled spirits are in existence as such (section 5004(a)(1))";
}
pub relation spirits_tax_paid(r: SpiritsRemoval) kind empirical {
    label en official "the tax imposed by section 5001(a)(1) on these spirits has been paid";
}
pub relation spirits_produced_on_qualified_premises(r: SpiritsRemoval) kind empirical {
    label en official "the spirits were produced on premises qualified under internal revenue law for the production of distilled spirits (section 5004(a)(2))";
}
pub relation spirits_lien_terminating_event(r: SpiritsRemoval, ev: SpiritsLienTerminatingEvent) kind empirical {
    label en official "one of the events in section 5004(a)(2)(A)-(C) has occurred for these spirits";
}
pub relation spirits_tax_lien_terminated(r: SpiritsRemoval) kind institutional {
    label en official "the section 5004(a)(1) lien (or any similar lien under prior provisions) has terminated under section 5004(a)(2)";
}
@source(IRC_S5004_A, relation = formalizes, coverage = exact, quote = "shall terminate in the case of distilled spirits produced on premises qualified under internal revenue law for the production of distilled spirits")
rule Section5004a2LienTerminatesRule(r: SpiritsRemoval, ev: SpiritsLienTerminatingEvent) strict {
    label en official "section 5004(a)(2): for spirits produced on qualified premises, the lien terminates when the spirits are withdrawn on determination of tax, withdrawn free of tax under the listed provisions, exported, deposited in a foreign-trade zone or customs bonded warehouse, used in wine production, laden as vessel/aircraft supplies, or used in research";
    when spirits_produced_on_qualified_premises(r);
    when spirits_lien_terminating_event(r, ev);
    then spirits_tax_lien_terminated(r);
}
pub relation spirits_tax_first_lien_attached(r: SpiritsRemoval) kind institutional {
    label en official "the tax imposed by section 5001(a)(1) is a first lien on the distilled spirits from the time the spirits are in existence as such until the tax is paid (section 5004(a)(1))";
}
@source(IRC_S5004_A, relation = formalizes, coverage = exact, quote = "shall be a first lien on the distilled spirits from the time the spirits are in existence as such until the tax is paid.")
rule Section5004a1FirstLienRule(r: SpiritsRemoval) defeasible {
    label en official "section 5004(a)(1): the section 5001(a)(1) tax is a first lien on the spirits from existence until payment; the lien ends earlier if section 5004(a)(2) terminates it";
    when spirits_exist_as_such(r);
    unless spirits_tax_paid(r) and spirits_exist_as_such(r);
    unless spirits_tax_lien_terminated(r) and spirits_exist_as_such(r);
    then spirits_tax_first_lien_attached(r);
}

// =============================================================================
// Section 5007(b): imported-spirits tax is collected by the Secretary
// =============================================================================

pub relation import_spirits_tax_collected_and_deposited(r: SpiritsRemoval) kind empirical {
    label en official "the internal revenue tax on imported spirits has been collected by the Secretary and deposited as internal revenue collections (section 5007(b))";
}
pub relation spirits_removal_is_import(r: SpiritsRemoval) kind empirical {
    label en official "the removal is an importation of distilled spirits subject to section 5001(a)(1) and (2) (section 5007(b))";
}
@source(IRC_S5007_B, coverage = partial, quote = "shall be collected by the Secretary and deposited as internal revenue collections")
rule Section5007bSecretaryCollectsImportTaxDutyRule(r: SpiritsRemoval) strict {
    label en official "section 5007(b): the tax on imported distilled spirits shall be collected by the Secretary and deposited as internal revenue collections (regulations govern the manner; the duty itself is executable)";
    when spirits_removal_is_import(r);
    then duty Section5007bImportTaxCollectionDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition import_spirits_tax_collected_and_deposited(r);
            window [-infinity, infinity];
        }
    };
}

// =============================================================================
// Section 5011: distilled spirits credit
// =============================================================================

pub entity BottledSpiritsPurchase {
    label en unofficial "a lot of bottled distilled spirits counted for the section 5011 credit (a purchase from a bottler, or State-warehouse-stored spirits)";
}
pub relation lot_liters(l: BottledSpiritsPurchase, liters: Decimal) kind empirical {
    label en official "the number of liters in the lot of bottled distilled spirits (section 5011(d)(2))";
}
pub relation lot_bottled_in_united_states(l: BottledSpiritsPurchase) kind empirical {
    label en official "the spirits were bottled in the United States (section 5011(a)(1)(A)(i))";
}
pub relation lot_purchased_directly_from_bottler_by(l: BottledSpiritsPurchase, wholesaler: Person, year: Integer) kind empirical {
    label en official "the lot was purchased during the taxable year (calendar year) by this wholesaler directly from the bottler (section 5011(a)(1)(A)(ii))";
}
pub relation holds_faa_wholesaler_of_spirits_permit(p: Person) kind empirical {
    label en official "the person holds a permit under the Federal Alcohol Administration Act as a wholesaler of distilled spirits (section 5011(b))";
}
pub relation is_state_or_agency(p: Person) kind empirical {
    label en official "the person is a State or political subdivision thereof, or an agency of either (section 5011(b))";
}
pub relation is_eligible_wholesaler(p: Person) kind institutional {
    label en official "eligible wholesaler: a person holding an FAA wholesaler-of-distilled-spirits permit that is not a State, political subdivision, or agency (section 5011(b))";
}
@source(IRC_S5011_B, coverage = exact, quote = "means any person which holds a permit under the Federal Alcohol Administration Act as a wholesaler of distilled spirits which is not a State or political subdivision thereof, or an agency of either.")
rule Section5011bEligibleWholesalerRule(p: Person) defeasible {
    label en official "section 5011(b): an FAA permit-holding spirits wholesaler is an eligible wholesaler unless it is a State, political subdivision, or agency";
    when holds_faa_wholesaler_of_spirits_permit(p);
    unless is_state_or_agency(p) and holds_faa_wholesaler_of_spirits_permit(p);
    then is_eligible_wholesaler(p);
}
pub relation subject_to_section_5005(p: Person) kind empirical {
    label en official "the person is subject to section 5005 (liable for the tax on distilled spirits) (section 5011(a)(1)(B))";
}
pub relation lot_stored_in_state_warehouse_title_not_passed(l: BottledSpiritsPurchase, p: Person) kind empirical {
    label en official "the lot is stored in a warehouse operated by, or on behalf of, a State, political subdivision, or agency, and title has not passed on an unconditional sale basis, and the person is subject to section 5005 (section 5011(a)(1)(B))";
}
pub relation credit_eligible_lot(l: BottledSpiritsPurchase, p: Person) kind institutional {
    label en official "the lot counts toward this person's section 5011(a)(1) case count";
}
@source(IRC_S5011_A, relation = formalizes, coverage = exact, quote = "(A) any eligible wholesaler, the number of cases of bottled distilled spirits—")
rule Section5011a1AEligibleWholesalerLotRule(l: BottledSpiritsPurchase, p: Person, year: Integer) defeasible {
    label en official "section 5011(a)(1)(A): an eligible wholesaler counts cases bottled in the United States and purchased in the year directly from the bottler";
    when is_eligible_wholesaler(p);
    when lot_bottled_in_united_states(l);
    when lot_purchased_directly_from_bottler_by(l, p, year);
    then credit_eligible_lot(l, p);
}
@source(IRC_S5011_A, relation = formalizes, coverage = exact, quote = "(B) any person which is subject to section 5005 and which is not an eligible wholesaler, the number of cases of bottled distilled spirits which are stored in a warehouse operated by, or on behalf of, a State or political subdivision thereof, or an agency of either, on which title has not passed on an unconditional sale basis")
rule Section5011a1BStateWarehouseLotRule(l: BottledSpiritsPurchase, p: Person) defeasible {
    label en official "section 5011(a)(1)(B): a person subject to section 5005 that is not an eligible wholesaler counts cases stored in a State warehouse with title not passed";
    when subject_to_section_5005(p);
    when lot_stored_in_state_warehouse_title_not_passed(l, p);
    unless is_eligible_wholesaler(p) and subject_to_section_5005(p) and lot_stored_in_state_warehouse_title_not_passed(l, p);
    then credit_eligible_lot(l, p);
}
pub relation average_tax_financing_cost_per_case(year: Integer, cost: Money) kind empirical {
    label en official "the average tax-financing cost per case for the calendar year: the interest that would accrue at the deemed financing rate during a 60-day period on the deemed Federal excise tax per case (section 5011(c)(1)) — case-asserted per year; the derivation (average of the section 6621(a)(1) corporate overpayment rates, accrued for 60 days with the section 6622 compounding) is TECH_GAP";
}
pub relation lot_credit_year(l: BottledSpiritsPurchase, taxable_year: Integer) kind empirical {
    label en official "the taxable year of the person for which the credit is computed (a calendar year); the cost used is that of the most recent calendar year ending BEFORE the beginning of this taxable year (section 5011(a)(2))";
}
pub relation distilled_spirits_credit_for_lot(l: BottledSpiritsPurchase, p: Person, amount: Money) kind institutional {
    label en official "the section 5011(a) product for this lot: cases in the lot times the average tax-financing cost per case of the preceding calendar year";
}
@source(IRC_S5011_A, relation = formalizes, coverage = exact, quote = "the average tax-financing cost per case for the most recent calendar year ending before the beginning of such taxable year.")
rule Section5011aCreditForLotRule(l: BottledSpiritsPurchase, p: Person, ty: Integer, liters: Decimal, cost: Money) defeasible {
    label en official "section 5011(a),(d)(2): credit = (liters / 9 cases) x the preceding calendar year's average tax-financing cost per case; JUDGMENT CALL: the statute names no rounding of the money result, so one division with cents HALF_UP (corpus convention)";
    when credit_eligible_lot(l, p);
    when lot_credit_year(l, ty);
    when lot_liters(l, liters);
    when average_tax_financing_cost_for_credit(ty - 1, cost);
    then distilled_spirits_credit_for_lot(l, p, div_round(cost * liters, CaseLitersDivisor, 2, "HALF_UP"));
}

// =============================================================================
// Section 5042: exemptions from wine tax
// =============================================================================

pub relation product_is_noneffervescent_apple_fermentation(l: AlcoholicLot) kind empirical {
    label en official "the noneffervescent product of the normal alcoholic fermentation of apple juice only (section 5042(a)(1))";
}
pub relation product_produced_at_bonded_wine_cellar(l: AlcoholicLot) kind empirical {
    label en official "the product is produced at a bonded wine cellar (section 5042(a)(1))";
}
pub relation product_produced_with_preservative_methods(l: AlcoholicLot) kind empirical {
    label en official "the product is produced using preservative methods or materials (section 5042(a)(1))";
}
pub relation product_sold_as_cider_not_as_wine(l: AlcoholicLot) kind empirical {
    label en official "the product is sold or offered for sale as cider and not as wine or as a substitute for wine (section 5042(a)(1))";
}
pub relation cider_exempt_from_wine_tax_and_subchapter_f(l: AlcoholicLot) kind institutional {
    label en official "the product is not subject to tax as wine nor to the provisions of subchapter F (section 5042(a)(1))";
}
@source(IRC_S5042_A, relation = formalizes, coverage = partial, quote = "shall not be subject to tax as wine nor to the provisions of subchapter F.")
rule Section5042a1CiderExemptionRule(l: AlcoholicLot) defeasible {
    label en official "section 5042(a)(1): plain cider (noneffervescent apple-juice fermentation, made outside a bonded wine cellar without preservatives, sold as cider) is not taxed as wine";
    when product_is_noneffervescent_apple_fermentation(l);
    when product_sold_as_cider_not_as_wine(l);
    unless product_produced_at_bonded_wine_cellar(l) and product_is_noneffervescent_apple_fermentation(l) and product_sold_as_cider_not_as_wine(l);
    unless product_produced_with_preservative_methods(l) and product_is_noneffervescent_apple_fermentation(l) and product_sold_as_cider_not_as_wine(l);
    then cider_exempt_from_wine_tax_and_subchapter_f(l);
}
pub relation person_age_years(p: Person, years: Integer) kind empirical {
    label en official "the person's age in completed years";
}
pub relation local_minimum_wine_sale_age(p: Person, years: Integer) kind empirical {
    label en official "the minimum age established by law applicable in the locality of the person's household at which wine may be sold to individuals (section 5042(a)(2)(C))";
}
pub relation no_local_minimum_wine_sale_age(p: Person) kind empirical {
    label en official "no minimum wine-sale age is established by law in the locality (section 5042(a)(2)(C), parenthetical if any)";
}
pub relation is_adult_for_wine_exemption(p: Person) kind institutional {
    label en official "adult, for section 5042(a)(2): an individual who has attained 18, or the minimum wine-sale age in the locality, whichever is greater (section 5042(a)(2)(C))";
}
@source(IRC_S5042_A, relation = formalizes, coverage = exact, quote = "the term \"adult\" means an individual who has attained 18 years of age, or the minimum age (if any) established by law applicable in the locality in which the household is situated at which wine may be sold to individuals, whichever is greater.")
rule Section5042a2CAdultWithLocalMinimumRule(p: Person, age: Integer, local: Integer) strict {
    label en official "section 5042(a)(2)(C): the adult threshold is the greater of 18 and the local minimum wine-sale age";
    when person_age_years(p, age);
    when local_minimum_wine_sale_age(p, local);
    when age >= max(AdultStatutoryMinimumAgeYears, local);
    then is_adult_for_wine_exemption(p);
}
@source(IRC_S5042_A, relation = formalizes, coverage = exact, quote = "the term \"adult\" means an individual who has attained 18 years of age")
rule Section5042a2CAdultNoLocalMinimumRule(p: Person, age: Integer) strict {
    label en official "section 5042(a)(2)(C): with no local minimum age, an individual who has attained 18 is an adult";
    when person_age_years(p, age);
    when no_local_minimum_wine_sale_age(p);
    when age >= AdultStatutoryMinimumAgeYears;
    then is_adult_for_wine_exemption(p);
}
pub relation wine_produced_by_household_for_personal_use_not_for_sale(h: Household, year: Integer, gallons: Decimal) kind empirical {
    label en official "the aggregate gallons of wine an adult in the household produces for personal or family use and not for sale during the calendar year (section 5042(a)(2)(A))";
}
pub relation household_exempt_wine_gallons(h: Household, year: Integer, gallons: Decimal) kind institutional {
    label en official "the aggregate quantity of wine exempt from tax with respect to the household for the year: the produced quantity up to the household cap (section 5042(a)(2)(B))";
}
@source(IRC_S5042_A, relation = formalizes, coverage = exact, quote = "(i) 200 gallons per calendar year if there are 2 or more adults in such household, or")
rule Section5042a2BMultiAdultExemptRule(h: Household, year: Integer, produced: Decimal, adults: Integer) strict {
    label en official "section 5042(a)(2)(B)(i): exempt wine of a household with 2 or more adults is capped at 200 gallons per calendar year";
    when wine_produced_by_household_for_personal_use_not_for_sale(h, year, produced);
    when adult_count_in_household(h, adults);
    when adults >= 2;
    then household_exempt_wine_gallons(h, year, min(produced, WineHouseholdExemptionMultiAdultGallons));
}
@source(IRC_S5042_A, relation = formalizes, coverage = exact, quote = "(ii) 100 gallons per calendar year if there is only 1 adult in such household.")
rule Section5042a2BSingleAdultExemptRule(h: Household, year: Integer, produced: Decimal) strict {
    label en official "section 5042(a)(2)(B)(ii): exempt wine of a one-adult household is capped at 100 gallons per calendar year";
    when wine_produced_by_household_for_personal_use_not_for_sale(h, year, produced);
    when adult_count_in_household(h, 1);
    then household_exempt_wine_gallons(h, year, min(produced, WineHouseholdExemptionSingleAdultGallons));
}
pub relation is_scientific_university_college_or_research_institution(p: Person) kind empirical {
    label en official "the person is a scientific university, college of learning, or institution of scientific research (section 5042(a)(3))";
}
pub relation wine_used_for_experimental_or_research_use_only(l: AlcoholicLot, p: Person) kind empirical {
    label en official "the wine is produced, received, blended, treated, or stored for experimental or research use, not for consumption (other than organoleptical tests) or sale (section 5042(a)(3))";
}
pub relation research_wine_exempt_from_tax(l: AlcoholicLot, p: Person) kind institutional {
    label en official "the wine is produced, received, blended, treated, and stored without payment of tax (section 5042(a)(3))";
}
@source(IRC_S5042_A, relation = formalizes, coverage = partial, quote = "may produce, receive, blend, treat, and store wine, without payment of tax, for experimental or research use but not for consumption (other than organoleptical tests) or sale")
rule Section5042a3ResearchWineExemptRule(l: AlcoholicLot, p: Person) strict {
    label en official "section 5042(a)(3): a scientific university, college, or research institution may handle wine for experimental or research use without payment of tax, subject to the Secretary's regulations (EXTERNAL_DEPENDENCY for their content)";
    when is_scientific_university_college_or_research_institution(p);
    when wine_used_for_experimental_or_research_use_only(l, p);
    then research_wine_exempt_from_tax(l, p);
}

// =============================================================================
// Section 5043(a): persons liable for wine tax
// =============================================================================

pub relation wine_removed_from_bonded_cellar_by_proprietor(w: WineRemoval, p: Person) kind empirical {
    label en official "the wine is removed from a bonded wine cellar by its proprietor (section 5043(a)(1))";
}
pub relation wine_transferred_in_bond_under_5362b_to(w: WineRemoval, transferee: Person) kind empirical {
    label en official "the wine is transferred in bond as authorized under section 5362(b) to this transferee (section 5043(a)(1)(A))";
}
pub relation wine_withdrawn_without_payment_under_5362c_by(w: WineRemoval, other: Person) kind empirical {
    label en official "the wine is withdrawn by a person other than the proprietor without payment of tax as authorized under section 5362(c) (section 5043(a)(1)(B))";
}
pub relation foreign_wine_importer(w: WineRemoval, importer: Person) kind empirical {
    label en official "the person is the importer of foreign wine (section 5043(a)(2))";
}
pub relation foreign_wine_transferred_free_of_tax_to_cellar_under_5364(w: WineRemoval) kind empirical {
    label en official "the foreign wine is transferred to a bonded wine cellar free of tax under section 5364 (section 5043(a)(2))";
}
pub relation wine_dealt_with_otherwise_than_as_authorized(w: WineRemoval, p: Person) kind empirical {
    label en official "the person produces, imports, receives, removes, or possesses the wine otherwise than as authorized by law (section 5043(a)(3))";
}
pub relation relieved_of_wine_tax_liability(p: Person, w: WineRemoval) kind institutional {
    label en official "the proprietor is relieved of liability by a section 5043(a)(1)(A) or (B) shift to a transferee or other person";
}
pub relation liable_for_wine_tax(p: Person, w: WineRemoval) kind institutional {
    label en official "the person is liable for payment of the tax imposed by subpart A of part I (wine) on this removal (section 5043(a))";
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "(A) in the case of any transfer of wine in bond as authorized under the provisions of section 5362(b), the liability for payment of the tax shall become the liability of the transferee from the time of removal of the wine from the transferor's premises, and the transferor shall thereupon be relieved of such liability;")
rule Section5043a1ATransfereeLiableRule(w: WineRemoval, p: Person, transferee: Person) strict {
    label en official "section 5043(a)(1)(A): on a section 5362(b) transfer in bond, liability passes to the transferee and the transferor (proprietor) is relieved";
    when wine_removed_from_bonded_cellar_by_proprietor(w, p);
    when wine_transferred_in_bond_under_5362b_to(w, transferee);
    then relieved_of_wine_tax_liability(p, w);
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "(B) in the case of any wine withdrawn by a person other than such proprietor without payment of tax as authorized under the provisions of section 5362(c), the liability for payment of the tax shall become the liability of such person from the time of the removal of the wine from the bonded wine cellar, and such proprietor shall thereupon be relieved of such liability.")
rule Section5043a1BOtherPersonRelievesProprietorRule(w: WineRemoval, p: Person, other: Person) strict {
    label en official "section 5043(a)(1)(B): a person other than the proprietor that withdraws wine without payment under section 5362(c) becomes liable and the proprietor is relieved";
    when wine_removed_from_bonded_cellar_by_proprietor(w, p);
    when wine_withdrawn_without_payment_under_5362c_by(w, other);
    then relieved_of_wine_tax_liability(p, w);
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "In the case of wines removed from any bonded wine cellar, by the proprietor of such bonded wine cellar")
rule Section5043a1ProprietorLiableRule(w: WineRemoval, p: Person) defeasible {
    label en official "section 5043(a)(1): the tax on wine removed from a bonded wine cellar is paid by its proprietor, except where a (A) transfer or (B) withdrawal shifts and relieves";
    when wine_removed_from_bonded_cellar_by_proprietor(w, p);
    unless relieved_of_wine_tax_liability(p, w) and wine_removed_from_bonded_cellar_by_proprietor(w, p);
    then liable_for_wine_tax(p, w);
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "the liability for payment of the tax shall become the liability of the transferee from the time of removal of the wine from the transferor's premises")
rule Section5043a1ATransfereeBecomesLiableRule(w: WineRemoval, p: Person, transferee: Person) strict {
    label en official "section 5043(a)(1)(A): the transferee becomes liable from the time of removal";
    when wine_removed_from_bonded_cellar_by_proprietor(w, p);
    when wine_transferred_in_bond_under_5362b_to(w, transferee);
    then liable_for_wine_tax(transferee, w);
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "the liability for payment of the tax shall become the liability of such person from the time of the removal of the wine from the bonded wine cellar")
rule Section5043a1BOtherPersonBecomesLiableRule(w: WineRemoval, p: Person, other: Person) strict {
    label en official "section 5043(a)(1)(B): the withdrawing person becomes liable from the time of removal";
    when wine_removed_from_bonded_cellar_by_proprietor(w, p);
    when wine_withdrawn_without_payment_under_5362c_by(w, other);
    then liable_for_wine_tax(other, w);
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "In the case of foreign wines which are not transferred to a bonded wine cellar free of tax under section 5364, by the importer thereof.")
rule Section5043a2ImporterLiableRule(w: WineRemoval, importer: Person) defeasible {
    label en official "section 5043(a)(2): the importer of foreign wine pays the tax unless the wine is transferred to a bonded wine cellar free of tax under section 5364";
    when foreign_wine_importer(w, importer);
    unless foreign_wine_transferred_free_of_tax_to_cellar_under_5364(w) and foreign_wine_importer(w, importer);
    then liable_for_wine_tax(importer, w);
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "Immediately, in the case of any wine produced, imported, received, removed, or possessed otherwise than as authorized by law")
rule Section5043a3UnauthorizedLiableRule(w: WineRemoval, p: Person) strict {
    label en official "section 5043(a)(3): each person who produces, imports, receives, removes, or possesses wine otherwise than as authorized is liable for the tax";
    when wine_dealt_with_otherwise_than_as_authorized(w, p);
    then liable_for_wine_tax(p, w);
}
pub relation wine_tax_due_immediately(w: WineRemoval) kind institutional {
    label en official "the tax on wine dealt with otherwise than as authorized is payable immediately (section 5043(a)(3))";
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "Immediately, in the case of any wine produced, imported, received, removed, or possessed otherwise than as authorized by law")
rule Section5043a3ImmediatePaymentRule(w: WineRemoval, p: Person) strict {
    label en official "section 5043(a)(3): the payment date for unauthorized wine is immediate";
    when wine_dealt_with_otherwise_than_as_authorized(w, p);
    then wine_tax_due_immediately(w);
}
pub relation jointly_and_severally_liable_for_wine_tax(p: Person, q: Person, w: WineRemoval) kind institutional {
    label en official "the persons are jointly and severally liable for the wine tax with each other (section 5043(a)(3))";
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "all such persons shall be jointly and severally liable for such tax with each other as well as with any proprietor, transferee, or importer who may be liable for the tax under this subsection.")
rule Section5043a3JointAndSeveralAmongUnauthorizedRule(w: WineRemoval, p: Person, q: Person) strict {
    label en official "section 5043(a)(3): two persons who each dealt with the wine otherwise than as authorized are jointly and severally liable with each other";
    when wine_dealt_with_otherwise_than_as_authorized(w, p);
    when wine_dealt_with_otherwise_than_as_authorized(w, q);
    when p != q;
    then jointly_and_severally_liable_for_wine_tax(p, q, w);
}
@source(IRC_S5043_A, relation = formalizes, coverage = exact, quote = "as well as with any proprietor, transferee, or importer who may be liable for the tax under this subsection.")
rule Section5043a3JointAndSeveralWithProprietorRule(w: WineRemoval, p: Person, q: Person) defeasible {
    label en official "section 5043(a)(3): an unauthorized person is jointly and severally liable with any other person who is liable under section 5043(a) for the same wine";
    when wine_dealt_with_otherwise_than_as_authorized(w, p);
    when liable_for_wine_tax(q, w);
    when p != q;
    then jointly_and_severally_liable_for_wine_tax(p, q, w);
}

// =============================================================================
// Section 5044: refund/credit of wine tax for wine returned to bond
// =============================================================================

pub entity WineReturnToBond {
    label en unofficial "wine removed from a bonded wine cellar and returned to bond under section 5361";
}
pub relation wine_returned_to_bond_on(r: WineReturnToBond, on: Date) kind empirical {
    label en official "the date of the return of the wine to bond (section 5044(b))";
}
pub relation wine_return_delivered_to_proprietor(r: WineReturnToBond, proprietor: Person) kind empirical {
    label en official "the proprietor of the bonded wine cellar to which the wine is delivered (section 5044(a)(1))";
}
pub relation return_tax_paid(r: WineReturnToBond) kind empirical {
    label en official "the section 5041 tax on the returned wine has been paid (section 5044(a)(1))";
}
pub relation return_claim_filed_on(r: WineReturnToBond, p: Person, on: Date) kind empirical {
    label en official "a claim for refund or credit (paragraph (1)) or relief from liability (paragraph (2)) is filed (section 5044(a)-(b))";
}
pub relation return_claim_within_minimum_quantity(r: WineReturnToBond) kind empirical {
    label en official "the claim meets the minimum quantity, if any, specified in the regulations (section 5044(a) last sentence)";
}
pub relation wine_return_claim_timely(r: WineReturnToBond, filed_on: Date) kind institutional {
    label en official "the claim is filed within 6 months after the date of the return of the wine to bond (section 5044(b))";
}
@source(IRC_S5044_B, coverage = exact, quote = "No claim under subsection (a) shall be allowed unless filed within 6 months after the date of the return of the wine to bond.")
rule Section5044bClaimWindowRule(r: WineReturnToBond, p: Person, filed_on: Date, returned_on: Date) strict {
    label en official "section 5044(b): the claim must be filed within 6 months after the return of the wine to bond";
    when return_claim_filed_on(r, p, filed_on);
    when wine_returned_to_bond_on(r, returned_on);
    when filed_on <= add_calendar_period(returned_on, 6 calendar_month);
    then wine_return_claim_timely(r, filed_on);
}
pub relation return_tax_relief_granted(r: WineReturnToBond) kind institutional {
    label en official "the tax paid is refunded or credited without interest to the receiving proprietor (paragraph (1)), or the person liable is relieved of unpaid tax (paragraph (2))";
}
pub relation return_claim_valid(r: WineReturnToBond, filed_on: Date) kind institutional {
    label en official "the section 5044 claim is timely and within any regulatory minimum quantity (single-atom valid_when helper)";
}
rule Section5044ClaimValidRule(r: WineReturnToBond, filed_on: Date) strict {
    label en unofficial "a timely claim within the minimum quantity, if any, is valid";
    when wine_return_claim_timely(r, filed_on);
    when return_claim_within_minimum_quantity(r);
    then return_claim_valid(r, filed_on);
}
@source(IRC_S5044_A, relation = formalizes, coverage = partial, quote = "any tax imposed by section 5041 shall, if paid, be refunded or credited, without interest, to the proprietor of the bonded wine cellar to which such wine is delivered")
rule Section5044aReturnClaimPowerRule(r: WineReturnToBond, p: Person, filed_on: Date) strict {
    label en official "section 5044(a): a claim for refund, credit (paid tax), or relief (unpaid tax) on wine returned to bond under section 5361 is a power exercised by the claimant; valid only if timely and within the regulatory minimum (E-0239: an untimely claim yields no relief). The burden of proof on the applicant is TECH_GAP";
    when return_claim_filed_on(r, p, filed_on);
    then power Section5044ReturnToBondClaim {
        holder p;
        over r;
        exercise return_claim_filed_on(r, p, filed_on);
        valid_when return_claim_valid(r, filed_on);
        effect create(return_tax_relief_granted(r));
        window [-infinity, infinity];
    };
}

// =============================================================================
// Section 5054(a): beer — determination, payment, and due date
// =============================================================================

pub relation beer_produced_in_us_or_imported_and_transferred_to_brewery_free(m: BeerMovement) kind empirical {
    label en official "beer produced in the United States, or imported and transferred to a brewery free of tax under section 5418 (section 5054(a)(1))";
}
pub relation beer_movement_time_of_removal(m: BeerMovement, on: Date) kind empirical {
    label en official "the date of removal for consumption or sale";
}
pub relation domestic_beer_tax_determination_date(m: BeerMovement, on: Date) kind institutional {
    label en official "the tax on this domestic beer is determined at the time it is removed for consumption or sale (section 5054(a)(1))";
}
@source(IRC_S5054_A, relation = formalizes, coverage = exact, quote = "shall be determined at the time it is removed for consumption or sale, and shall be paid by the brewer thereof in accordance with section 5061.")
rule Section5054a1DeterminationAtRemovalRule(m: BeerMovement, on: Date) defeasible {
    label en official "section 5054(a)(1): the tax on domestic beer (or beer transferred to a brewery free under section 5418) is determined when removed for consumption or sale";
    when beer_produced_in_us_or_imported_and_transferred_to_brewery_free(m);
    when removed_for_consumption_or_sale(m);
    when beer_movement_time_of_removal(m, on);
    then domestic_beer_tax_determination_date(m, on);
}
pub relation beer_imported_not_transferred_to_brewery_free(m: BeerMovement) kind empirical {
    label en official "beer imported into the United States and not transferred to a brewery free of tax under section 5418 (section 5054(a)(2))";
}
pub relation beer_time_of_importation(m: BeerMovement, on: Date) kind empirical {
    label en official "the date of importation, or if entered for warehousing, the date of removal from the first such warehouse (section 5054(a)(2))";
}
pub relation imported_beer_tax_determination_date(m: BeerMovement, on: Date) kind institutional {
    label en official "the tax on imported beer is determined at the time of importation (section 5054(a)(2))";
}
@source(IRC_S5054_A, relation = formalizes, coverage = partial, quote = "shall be determined at the time of the importation thereof, or, if entered for warehousing, at the time of removal from the 1st such warehouse.")
rule Section5054a2DeterminationAtImportationRule(m: BeerMovement, on: Date) strict {
    label en official "section 5054(a)(2): the tax on imported beer is determined at importation, or at removal from the first warehouse if entered for warehousing (the warehousing date is asserted in beer_time_of_importation)";
    when beer_imported_not_transferred_to_brewery_free(m);
    when beer_time_of_importation(m, on);
    then imported_beer_tax_determination_date(m, on);
}
pub relation beer_produced_in_qualified_brewery(m: BeerMovement) kind empirical {
    label en official "the beer is produced in a brewery qualified under subchapter G (section 5054(a)(3)(A))";
}
pub relation beer_production_exempt_under_5053e(m: BeerMovement) kind empirical {
    label en official "the production is exempt from tax under section 5053(e) (section 5054(a)(3)(B))";
}
pub relation beer_produced_in_united_states(m: BeerMovement) kind empirical {
    label en official "the beer is produced in the United States";
}
pub relation beer_tax_due_immediately_on_production(m: BeerMovement) kind institutional {
    label en official "the tax on beer produced in the United States is due and payable immediately upon production (section 5054(a)(3))";
}
@source(IRC_S5054_A, relation = formalizes, coverage = exact, quote = "The tax on any beer produced in the United States shall be due and payable immediately upon production unless—")
rule Section5054a3DueImmediatelyRule(m: BeerMovement) defeasible {
    label en official "section 5054(a)(3): beer produced in the United States is taxable immediately on production unless produced in a qualified brewery or exempt under section 5053(e)";
    when beer_produced_in_united_states(m);
    unless beer_produced_in_qualified_brewery(m) and beer_produced_in_united_states(m);
    unless beer_production_exempt_under_5053e(m) and beer_produced_in_united_states(m);
    then beer_tax_due_immediately_on_production(m);
}
pub relation beer_smuggled_or_unlawfully_brought_in(m: BeerMovement) kind empirical {
    label en official "the beer is smuggled or brought into the United States unlawfully (section 5054(a)(4))";
}
pub relation beer_held_imported_and_tax_due_at_importation(m: BeerMovement) kind institutional {
    label en official "smuggled beer is held to be imported and the tax is due and payable at the time of importation (section 5054(a)(4))";
}
@source(IRC_S5054_A, relation = formalizes, coverage = exact, quote = "shall, for purposes of this chapter, be held to be imported into the United States, and the internal revenue tax shall be due and payable at the time of such importation.")
rule Section5054a4SmuggledBeerImportedRule(m: BeerMovement) strict {
    label en official "section 5054(a)(4): smuggled beer is imported and the tax is due at importation";
    when beer_smuggled_or_unlawfully_brought_in(m);
    then beer_held_imported_and_tax_due_at_importation(m);
}
pub relation beer_returned_to_brewery_after_removal(m: BeerMovement) kind empirical {
    label en official "beer removed for consumption or sale is thereafter returned to the brewery (section 5054(b))";
}
pub relation returned_beer_subject_to_pre_removal_provisions(m: BeerMovement) kind institutional {
    label en official "the returned beer is subject to all provisions relating to beer prior to removal, including section 5051 tax; a further removal is taxed without regard to the earlier determination (section 5054(b))";
}
@source(IRC_S5054_B, coverage = exact, quote = "shall be subject to all provisions of this chapter relating to beer prior to removal for consumption or sale, including the tax imposed by section 5051.")
rule Section5054bReturnedBeerRule(m: BeerMovement) strict {
    label en official "section 5054(b): beer returned to the brewery after removal is treated as beer prior to removal, and a new removal is taxed independently of the prior determination";
    when beer_returned_to_brewery_after_removal(m);
    then returned_beer_subject_to_pre_removal_provisions(m);
}

// =============================================================================
// Section 5055: beer drawback on exportation
// =============================================================================

pub entity BeerExport {
    label en unofficial "an exportation of beer brewed or produced in the United States (section 5055)";
}
pub relation beer_export_tax_paid_amount(e: BeerExport, amount: Money) kind empirical {
    label en official "the amount of tax paid on the exported beer (section 5055)";
}
pub relation beer_export_brewer(e: BeerExport, brewer: Person) kind empirical {
    label en official "the brewer of the exported beer (section 5055)";
}
pub relation beer_export_drawback_claim_filed(e: BeerExport, brewer: Person) kind empirical {
    label en official "the brewer claims drawback on the exportation";
}
pub relation beer_export_proof_of_exportation_given(e: BeerExport) kind empirical {
    label en official "there is such proof of exportation as the Secretary may by regulations require (section 5055)";
}
pub relation beer_export_drawback_allowed(e: BeerExport, amount: Money) kind institutional {
    label en official "the brewer is allowed a drawback equal in amount to the tax paid on the exported beer (section 5055)";
}
@source(IRC_S5055, coverage = exact, quote = "the brewer thereof shall be allowed a drawback equal in amount to the tax paid on such beer if there is such proof of exportation as the Secretary may by regulations require.")
rule Section5055DrawbackPowerRule(e: BeerExport, brewer: Person, amount: Money) strict {
    label en official "section 5055: the brewer's drawback claim on exported beer is valid with the required proof of exportation and yields a drawback equal to the tax paid";
    when beer_export_drawback_claim_filed(e, brewer);
    when beer_export_tax_paid_amount(e, amount);
    then power Section5055BeerDrawbackClaim {
        holder brewer;
        over e;
        exercise beer_export_drawback_claim_filed(e, brewer);
        valid_when beer_export_proof_of_exportation_given(e);
        effect create(beer_export_drawback_allowed(e, amount));
        window [-infinity, infinity];
    };
}

// =============================================================================
// Section 5056: refund or relief of beer tax
// =============================================================================

pub enum BeerRefundGround {
    ReturnedToBreweryOrDestroyed;
    LostDestroyedOrRenderedUnmerchantableBeforeTitleTransfer;
    ReceivedOnBondedPremisesOfDistilledSpiritsPlant;
}
pub entity BeerRefundClaimCase {
    label en unofficial "a claim under section 5056 for refund, credit, or relief from beer tax already removed for consumption or sale";
}
pub relation beer_refund_ground(c: BeerRefundClaimCase, g: BeerRefundGround) kind empirical {
    label en official "the ground: (a) returned to a brewery of the brewer or destroyed under supervision, (b) lost, destroyed, or rendered unmerchantable before title passes, (c) received on the bonded premises of a distilled spirits plant under section 5222(b)(2) (section 5056(a)-(c))";
}
pub relation beer_refund_claimant(c: BeerRefundClaimCase, brewer: Person) kind empirical {
    label en official "the brewer claiming refund, credit, or relief";
}
pub relation beer_refund_event_on(c: BeerRefundClaimCase, on: Date) kind empirical {
    label en official "the date of the return, loss, destruction, rendering unmerchantable, or receipt on the bonded premises (section 5056(d))";
}
pub relation beer_refund_claim_filed_on(c: BeerRefundClaimCase, on: Date) kind empirical {
    label en official "the date the claim is filed";
}
pub relation beer_refund_claimant_indemnified(c: BeerRefundClaimCase) kind empirical {
    label en official "the claimant was indemnified by insurance or otherwise in respect of the tax (section 5056(d)(2))";
}
pub relation beer_tax_amount_in_claim(c: BeerRefundClaimCase, amount: Money) kind empirical {
    label en official "the tax paid (or unpaid but claimed relieved) on the beer";
}
pub relation beer_refund_relief_granted(c: BeerRefundClaimCase, amount: Money) kind institutional {
    label en official "the tax is refunded or credited without interest, or the brewer is relieved of unpaid liability (section 5056(a)-(c))";
}
pub relation beer_refund_claim_valid(c: BeerRefundClaimCase) kind institutional {
    label en official "the claim is filed within 6 months after the event and the claimant was not indemnified (section 5056(d)) — single-atom valid_when helper";
}
pub relation beer_loss_by_theft(c: BeerRefundClaimCase) kind empirical {
    label en official "the beer loss was by theft (section 5056(b) third sentence)";
}
pub relation beer_theft_established_before_removal_and_without_connivance(c: BeerRefundClaimCase) kind empirical {
    label en official "the brewer establishes to the Secretary's satisfaction that the theft occurred before removal from the brewery and without connivance, collusion, fraud, or negligence on the part of the brewer, consignor, consignee, bailee, or carrier, or their employees or agents (section 5056(b)) — DECISION-0194 external judgment asserted as a fact";
}
@source(IRC_S5056_D, coverage = exact, quote = "No claim under this section shall be allowed (1) unless filed within 6 months after the date of the return, loss, destruction, rendering unmerchantable, or receipt on the bonded premises of a distilled spirits plant or (2) if the claimant was indemnified by insurance or otherwise in respect of the tax.")
rule Section5056dClaimValidRule(c: BeerRefundClaimCase, event_date: Date, filed: Date) defeasible {
    label en official "section 5056(d) with (b): a claim is allowed only if filed within 6 months of the event, only if the claimant was not indemnified, and (for a theft loss) only if the theft is established as occurring before removal and without connivance";
    when beer_refund_event_on(c, event_date);
    when beer_refund_claim_filed_on(c, filed);
    when filed <= add_calendar_period(event_date, 6 calendar_month);
    unless beer_refund_claimant_indemnified(c) and beer_refund_event_on(c, event_date) and beer_refund_claim_filed_on(c, filed);
    unless beer_loss_by_theft(c) and not beer_theft_established_before_removal_and_without_connivance(c) and beer_refund_event_on(c, event_date) and beer_refund_claim_filed_on(c, filed);
    then beer_refund_claim_valid(c);
}
pub relation brewery_beer_removed_on_day(bw: Brewery, day: Date, barrels: Decimal) kind empirical {
    label en official "the total quantity of beer removed from the brewery for consumption or sale on the day (section 5056(a) second sentence)";
}
pub relation brewery_beer_returned_same_day(bw: Brewery, day: Date, barrels: Decimal) kind empirical {
    label en official "the quantity of beer removed from the brewery that is returned to the same brewery on the day of the return (section 5056(a) second sentence)";
}
pub relation brewery_net_beer_removed_for_tax_on_day(bw: Brewery, day: Date, barrels: Decimal) kind institutional {
    label en official "in determining the tax due on beer removed on any day, the quantity returned to the same brewery is allowed as an offset against the total removed that day, under the Secretary's regulations (section 5056(a) second sentence)";
}
@source(IRC_S5056_A, relation = formalizes, coverage = partial, quote = "the quantity of beer returned to the same brewery from which removed shall be allowed, under such regulations as the Secretary may prescribe, as an offset against or deduction from the total quantity of beer removed from that brewery on the day of such return.")
rule Section5056aSameDayOffsetRule(bw: Brewery, day: Date, removed: Decimal, returned: Decimal) strict {
    label en official "section 5056(a), second sentence: the net quantity for the day's tax is the quantity removed less the quantity returned the same day (regulations govern the manner: EXTERNAL_DEPENDENCY)";
    when brewery_beer_removed_on_day(bw, day, removed);
    when brewery_beer_returned_same_day(bw, day, returned);
    then brewery_net_beer_removed_for_tax_on_day(bw, day, removed - returned);
}
@source(IRC_S5056_A, relation = formalizes, coverage = partial, quote = "Any tax paid by any brewer on beer removed for consumption or sale may be refunded or credited to the brewer, without interest")
rule Section5056RefundPowerRule(c: BeerRefundClaimCase, brewer: Person, amount: Money) strict {
    label en official "section 5056(a)-(c): the brewer's claim for refund, credit, or relief on beer returned, destroyed, lost, or received at a distilled spirits plant is a power, valid only within 6 months and if not indemnified (E-0239); the regulations that govern the return/destruction supervision are EXTERNAL_DEPENDENCY";
    when beer_refund_claimant(c, brewer);
    when beer_tax_amount_in_claim(c, amount);
    then power Section5056BeerRefundClaim {
        holder brewer;
        over c;
        exercise beer_refund_claimant(c, brewer);
        valid_when beer_refund_claim_valid(c);
        effect create(beer_refund_relief_granted(c, amount));
        window [-infinity, infinity];
    };
}

// =============================================================================
// Section 5067: no reduced rates for smuggled or unauthorized product
// =============================================================================

pub enum SmuggledOrUnauthorizedProduct { Beer; Wine; DistilledSpirits; }
pub entity UnauthorizedAlcoholProduct {
    label en unofficial "beer, wine, or distilled spirits smuggled into the United States or produced other than as authorized by this chapter (section 5067)";
}
pub relation unauthorized_product_kind(u: UnauthorizedAlcoholProduct, k: SmuggledOrUnauthorizedProduct) kind empirical {
    label en official "the kind of product";
}
pub relation smuggled_or_produced_other_than_authorized(u: UnauthorizedAlcoholProduct) kind empirical {
    label en official "the product is smuggled into the United States or produced other than as authorized by this chapter (section 5067)";
}
pub relation reduced_beer_rates_disallowed(u: UnauthorizedAlcoholProduct) kind institutional {
    label en official "the rates of tax under section 5051(a)(1)(A)(i) and (2) do not apply to this beer (section 5067(1))";
}
pub relation wine_credit_disallowed(u: UnauthorizedAlcoholProduct) kind institutional {
    label en official "the credit under section 5041(c) does not apply to this wine (section 5067(2))";
}
pub relation reduced_spirits_rates_disallowed(u: UnauthorizedAlcoholProduct) kind institutional {
    label en official "the rates of tax under section 5001(c) do not apply to these distilled spirits (section 5067(3))";
}
@source(IRC_S5067, coverage = exact, quote = "(1) the rates of tax under paragraphs (1)(A)(i) and (2) of section 5051(a) shall not apply in the case of any such beer,")
rule Section5067BeerReducedRatesRule(u: UnauthorizedAlcoholProduct) strict {
    label en official "section 5067(1): smuggled or unauthorized beer gets no reduced rate";
    when smuggled_or_produced_other_than_authorized(u);
    when unauthorized_product_kind(u, Beer);
    then reduced_beer_rates_disallowed(u);
}
@source(IRC_S5067, coverage = exact, quote = "(2) the credit under section 5041(c) shall not apply in the case of any such wine, and")
rule Section5067WineCreditRule(u: UnauthorizedAlcoholProduct) strict {
    label en official "section 5067(2): smuggled or unauthorized wine gets no section 5041(c) credit";
    when smuggled_or_produced_other_than_authorized(u);
    when unauthorized_product_kind(u, Wine);
    then wine_credit_disallowed(u);
}
@source(IRC_S5067, coverage = exact, quote = "(3) the rates of tax under section 5001(c) shall not apply in the case of any such distilled spirits.")
rule Section5067SpiritsReducedRatesRule(u: UnauthorizedAlcoholProduct) strict {
    label en official "section 5067(3): smuggled or unauthorized spirits get no section 5001(c) reduced rate";
    when smuggled_or_produced_other_than_authorized(u);
    when unauthorized_product_kind(u, DistilledSpirits);
    then reduced_spirits_rates_disallowed(u);
}
