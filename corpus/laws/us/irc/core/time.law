use self::{
    Person,
};

// Time of `us.irc.core` — §441 (period for computation of taxable income) and
// the periods used by employment/excise chapters. The federal business-day
// calendar that §7503 rolls a deadline over (Saturday/Sunday/legal holiday in
// the District of Columbia) is DELIBERATELY NOT modelled here: it is a §85
// calendar RESOURCE an owner package supplies (`administration`, which owns
// §§7502-7503), not an identity of a taxpayer's year. Declaring it in core
// would force every owner that never reads a deadline to still carry a
// calendar dependency.
//
// `TimeSpan` is the common shape `begins`/`ends` attach to, so that a single
// pair of relations serves both a taxable year and a quarter/month period —
// the JP/US-constitution convention of typing distinct legal subjects as
// subtypes of one shared supertype (`corpus/laws/us/constitution/00-package.law`,
// `Body`), applied to periods instead of persons.
pub entity TimeSpan { label en unofficial "a bounded span of time the Code measures liability over"; }

// §441(b): "the term 'taxable year' means — (1) the taxpayer's annual
// accounting period, if it is a calendar year or a fiscal year; (2) the
// calendar year, if subsection (g) applies; (3) the period for which the
// return is made, if a return is made for a period of less than 12 months;
// or (4) [DISC rule, subsection (h)]." One `TaxableYear` instance always
// belongs to exactly one taxpayer's accounting history; which of the four
// §441(b) branches produced it is recorded by the predicates below, not by
// a variant type, because a later change of accounting period (§442) does
// not change WHICH instance a past year was.
pub entity TaxableYear : TimeSpan {
    label en official "taxable year";
}

// Quarters/months used by employment-tax deposits and excise-tax periods
// (e.g. FICA/FUTA quarterly returns, chapter 32-36 excise periods). Kept
// distinct from `TaxableYear`: an employer's deposit period and its own
// taxable year are different `TimeSpan`s that can end on different dates.
pub entity Period : TimeSpan {
    label en unofficial "a quarterly or monthly period used by an employment or excise tax";
}

pub enum PeriodKind {
    CalendarQuarter;
    CalendarMonth;
    SemimonthlyPeriod;
    OtherPeriod;
    label en unofficial "the recurring unit a Period is measured in";
}
pub relation period_kind(p: Period, k: PeriodKind) kind institutional {
    label en unofficial "the recurring unit this Period is measured in";
}

// Shared by `TaxableYear` and `Period` (both `TimeSpan`): the calendar date
// each begins/ends on. A `TaxableYear`'s own §441(d)/(e) kind (calendar,
// fiscal, short) is recorded by the predicates below rather than folded into
// `begins`/`ends`, because those two dates alone do not distinguish a fiscal
// year from a short year of the same length.
pub relation begins(t: TimeSpan, d: Date) kind institutional {
    label en unofficial "the first day of this period";
}
pub relation ends(t: TimeSpan, d: Date) kind institutional {
    label en unofficial "the last day of this period";
}

// §441(c): "the term 'annual accounting period' means the annual period on
// the basis of which the taxpayer regularly computes his income in keeping
// his books" — read together with (b)(1), this relation names WHICH
// `TaxableYear` belongs to WHICH person for a given year, i.e. the taxpayer's
// running accounting history.
pub relation year_of(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer's annual accounting period";
}

// §441(d): "the term 'calendar year' means a period of 12 months ending on
// December 31." `n` is the calendar-year number (e.g. 2026) for a
// `TaxableYear` that IS a calendar year; the relation is absent for a fiscal
// or short year, which owners read through `fiscal_year`/`short_year`
// instead of forcing a calendar-year number onto them.
pub relation calendar_year_of(y: TaxableYear, n: Integer) kind institutional {
    label en official "a period of 12 months ending on December 31";
}

// §441(e): "the term 'fiscal year' means a period of 12 months ending on the
// last day of any month other than December" (including a properly elected
// 52-53-week year under (f)).
pub relation fiscal_year(y: TaxableYear) kind institutional {
    label en official "a period of 12 months ending on the last day of any month other than December";
}

// §441(b)(3): "the period for which the return is made, if a return is made
// for a period of less than 12 months" — the short taxable year that a
// change of accounting period or a taxpayer's first/last year produces
// (detailed computation is §443, owned by the accounting package, not core).
pub relation short_year(y: TaxableYear) kind institutional {
    label en official "the period for which the return is made, if a return is made for a period of less than 12 months";
}

// Counting policy for every fixed calendar step in `us.irc.*`
// (`add_calendar_period`, §84.2/§86). Without a policy the step is
// MISSING_POLICY at evaluation (errata E-0029), so every rule computing a
// date — "75 days after the notice is mailed", "within 18 months of the
// date of enactment" — stayed silent in all owner packages. One policy per
// case (§168.2), hence one declaration here, where every IRC scenario world
// already includes `us.irc.core`; a scenario names it in its context as
// `deadline_policy us.irc.core::IRC_CALENDAR_STEP;`.
//
// `start_count same_day`: "N days after X" is X + N (§84.2: with `next_day`
// the step would land one day later). `include_end true` and `roll
// no_roll` are the only values the calendar step accepts; the Saturday/
// Sunday/legal-holiday extension is a separate statutory rule (§7503,
// `us.irc.administration`), not a counting convention. `month_end
// reject_nonexistent`: the Code does not say where "N months after" the
// 29th-31st lands in a shorter month, so such a step is refused rather
// than resolved by a convention the text does not choose.
pub deadline policy IRC_CALENDAR_STEP {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end reject_nonexistent;
}
