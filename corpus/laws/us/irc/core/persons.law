// Persons and organs of `us.irc.core` — §7701(a)(1)-(3), (6), (11)-(14), (16).
//
// SUBTYPE LIST IS DELIBERATELY NARROW. §7701(a)(1) enumerates exactly six
// categories the word "person" is construed to include: individual, trust,
// estate, partnership, association, company or corporation. This module
// types five of them as direct subtypes of `Person`; "company" is not given
// a sixth subtype because §7701(a)(3) itself absorbs it into "corporation"
// ("The term 'corporation' includes associations, joint-stock companies, and
// insurance companies") for the whole title, and a `Company` subtype
// alongside `Corporation` would let a case pick the wrong one. `Association`
// keeps its own subtype because (a)(1) lists it as a distinct category of
// "person" even though (a)(3) ALSO sweeps "associations" into "corporation"
// for tax-classification purposes — resolving that overlap (which of the
// two an actual unincorporated association becomes) is the §7701 entity-
// classification test itself, and stays in `us.irc.definitions`, not here.
// No `GovernmentalUnit` subtype: §7701(a) does not name one among "persons";
// where a governmental unit is a taxpayer (e.g. §115), the owning package
// asserts it through a local subtype or role, not through this shared list.
pub entity Person {
    label en official "individual, a trust, estate, partnership, association, company or corporation";
}
pub entity Individual : Person { label en unofficial "individual"; }
pub entity Corporation : Person {
    label en official "corporation";
}
pub entity Partnership : Person {
    label en official "partnership";
}
pub entity Trust : Person { label en unofficial "trust"; }
pub entity Estate : Person { label en unofficial "estate"; }
// Kept distinct from `Corporation` per the note above; an owner's
// classification rule decides which unincorporated association a case's
// entity actually is under §7701(a)(3), not this declaration.
pub entity Association : Person { label en unofficial "association"; }

// Organs: authorities and adjudicative bodies the Code and this formalization
// address by name. `Organ` is not a `Person` subtype: the Code's "person"
// enumeration in (a)(1) never includes an organ of government, and folding
// the two would let a case substitute the Secretary for a taxpayer.
pub entity Organ { label en unofficial "an authority named or addressed by the Code"; }

// §7701(a)(11)(B): "The term 'Secretary' means the Secretary of the Treasury
// or his delegate." `Secretary` is the single URN every owner cites for
// "the Secretary" without redeclaring the identity of the office; DELEGATION
// itself (who, within Treasury or IRS, currently holds it for a given
// function — (a)(12)) is a `us.irc.definitions` relation over this constant,
// not a second constant here.
pub const Secretary: Organ = entity_ref("urn:us:irc:core#secretary") {
    label en official "the Secretary of the Treasury or his delegate";
}
// The Internal Revenue Service as the administering agency referred to
// throughout Subtitle F without always naming "the Secretary" (e.g. filing
// addresses, examination). Distinct from `Secretary` because some provisions
// name the Service as an institution (organizational chapter 80) rather than
// as the office holding delegated authority.
pub const IRS: Organ = entity_ref("urn:us:irc:core#irs") {
    label en unofficial "Internal Revenue Service";
}
// §6213(a): the forum for a pre-payment petition contesting a notice of
// deficiency.
pub const TaxCourt: Organ = entity_ref("urn:us:irc:core#tax-court") {
    label en unofficial "the Tax Court of the United States";
}
// A post-payment refund forum under 28 U.S.C. 1346(a)(1); named here because
// §6512 and the refund-litigation chain address it, not because Title 26
// itself creates the court.
pub const DistrictCourt: Organ = entity_ref("urn:us:irc:core#district-court") {
    label en unofficial "a United States district court";
}
pub const CourtOfFederalClaims: Organ = entity_ref("urn:us:irc:core#court-of-federal-claims") {
    label en unofficial "the United States Court of Federal Claims";
}
// Named for provisions that address Congress itself (e.g. Joint Committee
// reporting under chapters 91-92) rather than the executive branch.
pub const Congress: Organ = entity_ref("urn:us:irc:core#congress") {
    label en unofficial "the Congress of the United States";
}

// --- Legal roles ------------------------------------------------------
//
// A `role` assigns nobody by declaring it (`core-surfaces.md`): membership is
// `has_role(Actor, LegalRole, LegalContext, Interval<Instant>)`, asserted by
// an owner's rule or a case. Core names the role because the Code uses the
// word across many chapters with one meaning; the CONDITIONS under which a
// given `Person` holds it are each owner's own norm.

// §7701(a)(14): "The term 'taxpayer' means any person subject to any
// internal revenue tax."
pub role Taxpayer for Person;

// §7701(a)(16): "The term 'withholding agent' means any person required to
// deduct and withhold any tax under the provisions of section 1441, 1442,
// 1443, or 1461." Kept as the Code's own noun rather than folded into a
// generic "payer" role: liability for a withholding agent's own failure
// (chapter 3 penalties) attaches to the ROLE, not merely to the act of paying.
pub role WithholdingAgent for Person;

// §7701(a)(6): "The term 'fiduciary' means a guardian, trustee, executor,
// administrator, receiver, conservator, or any person acting in any
// fiduciary capacity for any person." The role names WHO acts fiduciarily;
// `fiduciary_for` below names FOR WHOM, which the bare role membership fact
// cannot carry.
pub role Fiduciary for Person;
// The second party of §7701(a)(6) — the person a fiduciary acts for
// (a beneficiary, an estate, a trust, a principal). An owner's rule or a
// case asserts this alongside `has_role(f, Fiduciary, …)`.
pub relation fiduciary_for(fiduciary: Person, principal: Person) kind institutional {
    label en official "any person acting in any fiduciary capacity for any person";
}

// Employer/Employee: the Code uses both nouns across employment-tax and
// income-withholding chapters (21, 24) without a single title-wide
// definition in §7701(a) — the operative test (e.g. §3401(d) "employer" for
// wage withholding) is local to the chapter and stays with its owner
// (`employment`, `other-income-taxes`). Core names the two roles so that
// every owner's local test assigns membership in the SAME role rather than
// each declaring its own, incompatible `Employer`/`Employee`.
// employer/employee: no single title-wide `label official` exists for either
// noun (see comment above), so no `label` is attached here.
pub role Employer for Person;
pub role Employee for Person;

// Chapter 71 ("Transferees and Fiduciaries") and the collection chapters use
// "transferee" for a person who receives property from a taxpayer and may
// become liable for the transferor's tax (§6901); the local condition for
// that liability is the owner's rule, not this role.
pub role Transferee for Person;

// "Payee" appears in withholding and information-reporting contexts (e.g.
// backup withholding, Form 1099 recipients) without its own §7701(a) entry;
// named here for the same reason as Employer/Employee.
pub role Payee for Person;
