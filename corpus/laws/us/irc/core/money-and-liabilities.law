// Money, tax kinds, liabilities and payments of `us.irc.core`. NO amount, NO
// rate and NO threshold is declared here (DECISION-0379 §1.1): this module
// gives the SHAPE a computed liability and a payment take, never a number.
//
// `Money` is used bare (no `<USD>` type argument) per the convention recorded
// in `package.law`: every amount in `us.irc.*` is USD, and the title never
// mixes currencies within itself (a foreign-currency amount under subpart J
// of subchapter N is translated to USD before it reaches a `Money` slot —
// that translation is the owner's rule, not a second currency parameter here).

use self::{
    Person,
    TaxableYear,
};

// One value per chapter of Title 26 that itself IMPOSES a tax (a "taxing
// chapter"), taken from the chapter list of the pinned snapshot
// (`docs/foundations/us-irc/raw/USCODE-2024-title26/html/*-toc.htm`).
// Deliberately EXCLUDED: chapters that organize administration or reporting
// without imposing a tax of their own — 6 (consolidated returns, a filing
// mode), 14 (special valuation rules, a valuation methodology under chapters
// 11-13), 25 (general employment-tax provisions), 39 (registration-required
// obligations), 40 (general occupational-tax provisions), and all of
// Subtitle F (61-80, procedure) and Subtitle G (91-92, Joint Committee).
// Subtitles H (95-96), I (98) and J-K (99-100) do not impose a tax measured
// by this shape either (campaign-fund financing, trust-fund accounting,
// coverage requirements enforced through chapters already listed) and are
// left to their owners to name a value here if a provision of theirs turns
// out to compute a `liability` after all — see CONTRACT.md open question.
//
// The set is ADDITIVE: a value missing for a real taxing chapter is added to
// this enum by the coordinator in the same change that first needs it
// (`docs/PACKAGE-LAYOUT.ru.md`, "pub у соседа"), never invented by an owner
// as a local lookalike.
pub enum TaxKind {
    // Subtitle A — Income Taxes
    IncomeCh1;            // ch. 1  — Normal Taxes and Surtaxes
    SelfEmploymentCh2;     // ch. 2  — Tax on Self-Employment Income
    NiitCh2A;              // ch. 2A — Unearned Income Medicare Contribution
    WithholdingNraCh3;     // ch. 3  — Withholding of Tax on Nonresident Aliens and Foreign Corporations
    FatcaCh4;              // ch. 4  — Taxes to Enforce Reporting on Certain Foreign Accounts
    // Subtitle B — Estate and Gift Taxes
    EstateCh11;            // ch. 11 — Estate Tax
    GiftCh12;              // ch. 12 — Gift Tax
    GstCh13;               // ch. 13 — Tax on Generation-Skipping Transfers
    ExpatriateGiftsCh15;   // ch. 15 — Gifts and Bequests from Expatriates
    // Subtitle C — Employment Taxes
    FicaCh21;              // ch. 21 — Federal Insurance Contributions Act
    RrtaCh22;              // ch. 22 — Railroad Retirement Tax Act
    FutaCh23;              // ch. 23 — Federal Unemployment Tax Act
    RailroadUnemploymentRepaymentCh23A; // ch. 23A — Railroad Unemployment Repayment Tax
    WithholdingWagesCh24;  // ch. 24 — Collection of Income Tax at Source on Wages
    // Subtitle D — Miscellaneous Excise Taxes
    RetailExciseCh31;
    ManufacturersExciseCh32;
    FacilitiesServicesExciseCh33;
    InsurancePoliciesExciseCh34;
    WageringExciseCh35;
    OtherExciseCh36;
    StockRepurchaseExciseCh37;
    EnvironmentalExciseCh38;
    PublicCharitiesExciseCh41;
    PrivateFoundationsExciseCh42;
    QualifiedPlansExciseCh43;
    InvestmentEntitiesExciseCh44;
    ExpatriatedEntitiesExciseCh45;
    GoldenParachuteExciseCh46;
    GroupHealthPlansExciseCh47;
    MinimumEssentialCoverageCh48;
    CosmeticServicesExciseCh49;
    ForeignProcurementExciseCh50;
    DesignatedDrugsFeeCh50A;
    // Subtitle E — Alcohol, Tobacco, and Certain Other Excise Taxes
    AlcoholExciseCh51;
    TobaccoExciseCh52;
    FirearmsExciseCh53;
    GreenmailExciseCh54;
    StructuredSettlementExciseCh55;
    label en unofficial "the taxing chapter of Title 26 a liability, return, notice, assessment or claim belongs to";
}

// A tax liability of a person for a period under one taxing chapter, as
// COMPUTED by the applicable owner's rule under the applicable edition.
// `institutional`: a case does not assert its own liability, an owner's
// calculation derives it (§6.2 item 2 of the plan — "the amount is computed
// under the applicable edition").
pub relation liability(p: Person, y: TaxableYear, kind: TaxKind, amount: Money) kind institutional {
    label en unofficial "a computed tax liability of a person for a taxable year under one taxing chapter";
}

pub entity Payment { label en unofficial "a payment made toward a tax liability"; }

// A payment of an amount by a person on a date. `empirical`: a case
// typically asserts that a payment was made (a raw fact the record shows),
// while WHICH liability it discharges is a separate institutional question
// (`payment_applied`) an owner's ordering-of-application rule answers.
pub relation payment(pay: Payment, by: Person, amount: Money, on: Date) kind empirical {
    label en unofficial "a payment of an amount made by a person on a date";
}

// The institutional application of a payment against a specific person's
// liability for a specific year and tax kind (§6151 pays "such tax"; §6402's
// crediting order and any partial-payment allocation rule are the owner's).
pub relation payment_applied(pay: Payment, p: Person, y: TaxableYear, kind: TaxKind) kind institutional {
    label en unofficial "a payment applied against a person's liability for a taxable year under one taxing chapter";
}
