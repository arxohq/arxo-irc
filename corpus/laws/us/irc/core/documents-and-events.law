// Documents and procedural events of `us.irc.core` — §§6072, 6081, 6151,
// 6203, 6212, 6213, 6303, 6321, 6331, 6402, 6511. Each entity below is the
// shared IDENTITY of a procedural object; the DEONTIC consequence of filing,
// mailing, assessing or not doing so on time (a duty, a power, its validity)
// is the owning package's norm (`returns`/F01, `assessment`/F02,
// `payment-refunds-interest`/F03, `collection`/F04), not this shape.

use self::{
    Organ,
    Person,
    TaxKind,
    TaxableYear,
};

pub entity Return { label en unofficial "a return, claim, statement or other document required to be filed"; }

// A return is FOR a person, a taxable year and a taxing chapter (so that the
// same person's income-tax return and employment-tax return are different
// `Return` instances tied to different `TaxKind`s).
pub relation return_of(r: Return, p: Person, y: TaxableYear, kind: TaxKind) kind institutional {
    label en unofficial "a return filed by a person for a taxable year under one taxing chapter";
}
pub relation filed_on(r: Return, d: Date) kind empirical {
    label en unofficial "the date a return was filed";
}
pub relation filed_by(r: Return, p: Person) kind empirical {
    label en unofficial "the person who filed a return";
}
// §6072(a): the statutory due date for the return before any extension
// (the actual number of days is the owning package's rule over §6072's own
// text; core only names the slot every owner's due-date rule fills).
pub relation due_date(r: Return, d: Date) kind institutional {
    label en official "shall be filed on or before the 15th day of April following the close of the calendar year";
}
// §6081(a): "The Secretary may grant a reasonable extension of time for
// filing any return, declaration, statement, or other document required by
// this title or by regulations." The GRANT itself is a `power` of the
// Secretary in the owning package (`returns`); core names only the resulting
// fact, the new date the return is due until.
pub relation extension_granted(r: Return, until: Date) kind institutional {
    label en official "a reasonable extension of time for filing";
}

pub entity Notice { label en unofficial "a notice the Secretary is required or authorized to give a person"; }

// One value per notice this snapshot pins a section for. ADDITIVE, same
// discipline as `TaxKind`: an owner needing a notice kind this list does not
// name yet (e.g. §6330 final notice of intent to levy) adds it here in the
// change that first formalizes that section.
pub enum NoticeKind {
    Deficiency;         // §6212 — notice of deficiency
    NoticeAndDemand;     // §6303 — notice and demand for tax
    Other;
    label en unofficial "the statutory kind of a Notice";
}
pub relation notice_of(n: Notice, kind: NoticeKind, to: Person) kind institutional {
    label en unofficial "a notice of a given statutory kind addressed to a person";
}
pub relation mailed_on(n: Notice, d: Date) kind empirical {
    label en unofficial "the date a notice was mailed";
}
pub relation received_on(n: Notice, d: Date) kind empirical {
    label en unofficial "the date a notice was received";
}
// §6212(b)(1): mailing "to the taxpayer at his last known address" is
// sufficient regardless of actual receipt. A one-place predicate on purpose:
// it asserts that THIS notice's mailing address satisfies the last-known-
// address test, without core taking a position on what "last known address"
// resolves to for a given person (an evaluative/record question for the
// owning package).
pub relation address_last_known(n: Notice) kind empirical {
    label en official "mailed to the taxpayer at his last known address";
}

pub entity Assessment { label en unofficial "the recorded liability of a taxpayer under §6203"; }

pub relation assessment_of(a: Assessment, p: Person, y: TaxableYear, kind: TaxKind, amount: Money) kind institutional {
    label en official "the assessment shall be made by recording the liability of the taxpayer";
}
pub relation assessed_on(a: Assessment, d: Date) kind empirical {
    label en unofficial "the date an assessment was recorded";
}

pub entity Claim { label en unofficial "a claim for credit or refund of an overpayment"; }

pub relation claim_of(c: Claim, p: Person, y: TaxableYear, kind: TaxKind, amount: Money) kind institutional {
    label en official "claim for credit or refund of an overpayment";
}
pub relation claim_filed_on(c: Claim, d: Date) kind empirical {
    label en unofficial "the date a claim for credit or refund was filed";
}

pub entity Election { label en unofficial "an election a person is permitted to make under the title"; }

// Core gives identity, `made_on` and `revoked_on` only: WHICH election
// (which section, what it changes) is an owner's own subtype/relation over
// this entity — "an entity per election kind in the owner", per the brief.
pub relation election_by(e: Election, p: Person) kind empirical {
    label en unofficial "the person who made an election";
}
pub relation made_on(e: Election, d: Date) kind empirical {
    label en unofficial "the date an election was made";
}
pub relation revoked_on(e: Election, d: Date) kind empirical {
    label en unofficial "the date an election was revoked";
}

pub entity Proceeding { label en unofficial "a judicial or Tax Court proceeding under the title"; }

pub relation proceeding_court(pr: Proceeding, court: Organ) kind empirical {
    label en unofficial "the court or Tax Court a proceeding was filed with"; }
pub relation proceeding_filed_on(pr: Proceeding, d: Date) kind empirical {
    label en official "the taxpayer may file a petition with the Tax Court";
}
pub relation proceeding_decided_on(pr: Proceeding, d: Date) kind empirical {
    label en unofficial "the date a proceeding was decided";
}

// §6321 (lien) and §6331 (levy): identity only. Every relation that attaches
// a lien to a person's property, or executes a levy, is the `collection`
// (F04) package's own norm; a judgment of validity or priority is that
// package's `external judgment relation`/adjudicated fact per DECISION-0194,
// never a core relation.
pub entity Lien { label en official "a lien in favor of the United States upon all property and rights to property"; }
pub entity Levy { label en official "levy upon all property and rights to property"; }
