// Property, transactions and tax attributes of `us.irc.core`. Every relation
// below is a SHAPE: the actual basis computation, gain/loss recognition and
// carryover arithmetic are the owning package's rules (`property-
// transactions`/A05, `accounting`/A04 and others per `OWNERSHIP-RULES.json`).

use self::{
    Person,
    TaxableYear,
};

pub entity Asset { label en unofficial "property in which a person holds an interest for tax purposes"; }

// A specific acquisition of an `Asset` a taxpayer tracks basis for
// separately from other acquisitions of the same asset (the "tax lot" of
// brokerage and basis-tracking practice; the Code itself does not name "lot"
// as a defined term, but §1012/§1016 basis rules operate lot by lot wherever
// identical units are acquired at different times or prices).
pub entity Lot : Asset { label en unofficial "a separately basis-tracked acquisition of an asset"; }

// The shape of an adjusted-basis fact; the owner computes the amount and
// cites its own basis/adjustment sections. `on` names the date the basis is
// stated as of, since basis changes over the holding period.
pub relation adjusted_basis(p: Person, a: Asset, on: Date, amount: Money) kind institutional {
    label en unofficial "a person's adjusted basis in an asset as of a date";
}

pub entity Transaction { label en unofficial "an event between persons that the title attaches tax consequences to"; }

pub entity OwnershipInterest { label en unofficial "an interest one person holds in another (stock, a partnership interest, a beneficial interest)"; }

// `held_in` is itself a `Person` (the corporation, partnership, trust or
// estate the interest is held in), not the interest's own identity — this
// mirrors §7701(a)(8) "shareholder" and the partner/partnership relation of
// §7701(a)(2), generalized to the shape every ownership-interest owner needs.
// (`in` is a hard keyword, §15, and cannot be used as a parameter name.)
pub relation ownership_interest(o: OwnershipInterest, holder: Person, held_in: Person, share: Decimal) kind institutional {
    label en unofficial "a person's fractional ownership interest in another person";
}

pub entity TaxAttribute { label en unofficial "a computed attribute of a taxpayer that carries between taxable years"; }
pub entity Carryover : TaxAttribute { label en unofficial "a tax attribute carried from one taxable year to another"; }

// One value per carryover kind a `us.irc.*` owner currently computes.
// ADDITIVE (same discipline as `TaxKind`/`NoticeKind`): a real carryover this
// list does not name yet is added here, not invented as a local lookalike.
pub enum CarryoverKind {
    NetOperatingLoss;
    CapitalLoss;
    ForeignTaxCredit;
    GeneralBusinessCredit;
    PassiveActivityLoss;
    Other;
    label en unofficial "the kind of tax attribute a Carryover represents";
}
pub relation carryover_kind(c: Carryover, k: CarryoverKind) kind institutional {
    label en unofficial "the kind of tax attribute a carryover represents";
}
pub relation carryover_from_year(c: Carryover, y: TaxableYear) kind institutional {
    label en unofficial "the taxable year a carryover originated in";
}
pub relation carryover_to_year(c: Carryover, y: TaxableYear) kind institutional {
    label en unofficial "the taxable year a carryover is applied in";
}
pub relation carryover_amount(c: Carryover, amount: Money) kind institutional {
    label en unofficial "the amount of a carryover applied in a taxable year";
}
