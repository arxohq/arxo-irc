language "law.core" version "0.2";
package us.irc.core version "0.1.1";
namespace "urn:us:irc:core";

pub enum CalendarBoundaryUnit { CalendarDay CalendarWeek CalendarMonth CalendarYear }

// Delivery migration: a backward calendar date is an explicit, established
// civil-calendar input. No negative deadline step is evaluated or invented.
pub relation civil_calendar_boundary_before(anchor: Date, count: Integer,
    unit: CalendarBoundaryUnit, boundary: Date) kind empirical {
    label en unofficial "the explicitly supplied date count calendar units before anchor; not inferred by Arxo";
}
