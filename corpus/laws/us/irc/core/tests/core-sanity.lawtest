}

// --- time.law -------------------------------------------------------------

test "a taxable year belongs to a person, is a calendar year, and has bounds" {
    given {
        context {
            legal_time @2026-09-25;
            decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": year_of(entity_ref("urn:us:irc:core:test:time#taxpayer"), entity_ref("urn:us:irc:core:test:time#year2026")) { origin case_input; }
        assert "f1": calendar_year_of(entity_ref("urn:us:irc:core:test:time#year2026"), 2026) { origin case_input; }
        assert "f2": begins(entity_ref("urn:us:irc:core:test:time#year2026"), @2026-01-01) { origin case_input; }
        assert "f3": ends(entity_ref("urn:us:irc:core:test:time#year2026"), @2026-12-31) { origin case_input; }
    }
    evaluate truth(calendar_year_of(entity_ref("urn:us:irc:core:test:time#year2026"), 2026));
    expect truth_status == TRUE_ONLY;
}

test "a fiscal taxable year is distinguished from a calendar year" {
    given {
        context {
            legal_time @2026-09-25;
            decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fiscal_year(entity_ref("urn:us:irc:core:test:time#fy2026")) { origin case_input; }
    }
    evaluate truth(fiscal_year(entity_ref("urn:us:irc:core:test:time#fy2026")));
    expect truth_status == TRUE_ONLY;
}

