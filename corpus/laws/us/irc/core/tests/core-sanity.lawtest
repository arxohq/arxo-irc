test "a return is filed for a taxable year, by a date, with an extension" {
    given {
        context {
            legal_time @2026-09-25;
            decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": return_of(entity_ref("urn:us:irc:core:test:docs#return1"), entity_ref("urn:us:irc:core:test:docs#taxpayer"), entity_ref("urn:us:irc:core:test:docs#year2026"), IncomeCh1) { origin case_input; }
        assert "f1": filed_on(entity_ref("urn:us:irc:core:test:docs#return1"), @2026-04-15) { origin case_input; }
        assert "f2": filed_by(entity_ref("urn:us:irc:core:test:docs#return1"), entity_ref("urn:us:irc:core:test:docs#taxpayer")) { origin case_input; }
        assert "f3": due_date(entity_ref("urn:us:irc:core:test:docs#return1"), @2027-04-15) { origin case_input; }
        assert "f4": extension_granted(entity_ref("urn:us:irc:core:test:docs#return1"), @2027-10-15) { origin case_input; }
    }
    evaluate truth(filed_on(entity_ref("urn:us:irc:core:test:docs#return1"), @2026-04-15));
    expect truth_status == TRUE_ONLY;
}

