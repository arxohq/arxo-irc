// Static sanity scenarios for `us.irc.core`. Core has NO rules, so every
// scenario here asserts a case fact and evaluates `truth` of that SAME fact:
// the point is that every entity and relation shape compiles and is
// queryable, not that any norm fires. Per AGENT-BRIEF these scenarios are
// NOT executed by this task; their status is `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.core version "0.1.1";
namespace "urn:us:irc:core";

// --- persons.law --------------------------------------------------------

test "a corporation is a Person subtype and can hold the Taxpayer role" {
    given {
        context {
            legal_time @2026-09-25;
            decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": has_role(entity_ref("urn:us:irc:core:test:persons#acme"), Taxpayer, entity_ref("urn:us:irc:core:test:persons#acme"), [@2026-01-01, infinity)) { origin case_input; }
    }
    evaluate truth(has_role(entity_ref("urn:us:irc:core:test:persons#acme"), Taxpayer, entity_ref("urn:us:irc:core:test:persons#acme"), [@2026-01-01, infinity)));
    expect truth_status == TRUE_ONLY;
}

