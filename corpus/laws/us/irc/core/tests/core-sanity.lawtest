test "a net operating loss carryover between taxable years" {
    given {
        context {
            legal_time @2026-09-25;
            decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": carryover_kind(entity_ref("urn:us:irc:core:test:property#nol1"), NetOperatingLoss) { origin case_input; }
        assert "f1": carryover_from_year(entity_ref("urn:us:irc:core:test:property#nol1"), entity_ref("urn:us:irc:core:test:property#year2025")) { origin case_input; }
        assert "f2": carryover_to_year(entity_ref("urn:us:irc:core:test:property#nol1"), entity_ref("urn:us:irc:core:test:property#year2026")) { origin case_input; }
        assert "f3": carryover_amount(entity_ref("urn:us:irc:core:test:property#nol1"), 3000.00 USD) { origin case_input; }
    }
    evaluate truth(carryover_kind(entity_ref("urn:us:irc:core:test:property#nol1"), NetOperatingLoss));
    expect truth_status == TRUE_ONLY;
}
