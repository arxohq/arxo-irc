test "an employment-tax period has a kind and bounds" {
    given {
        context {
            legal_time @2026-09-25;
            decision_time @2026-09-25T09:00:00-05:00;
            knowledge_time @2026-09-25T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": period_kind(entity_ref("urn:us:irc:core:test:time#q3-2026"), CalendarQuarter) { origin case_input; }
        assert "f1": begins(entity_ref("urn:us:irc:core:test:time#q3-2026"), @2026-07-01) { origin case_input; }
        assert "f2": ends(entity_ref("urn:us:irc:core:test:time#q3-2026"), @2026-09-30) { origin case_input; }
    }
    evaluate truth(period_kind(entity_ref("urn:us:irc:core:test:time#q3-2026"), CalendarQuarter));
    expect truth_status == TRUE_ONLY;
}

