// Chapter 52, subchapter F (sections 5751-5754: prohibited post-removal
// conduct) and subchapter G (sections 5761-5763: civil penalties, criminal
// penalties, forfeitures). Priority sections 5751/5761, IRC-14 stage 1.

// =====================================================================
// Section 5751 — purchase, receipt, possession, or sale after removal
// =====================================================================

use self::{
    IRC_S5751_A,
    IRC_S5751_B,
    IRC_S5752,
    IRC_S5754_A,
    IRC_S5761_A,
    IRC_S5761_B,
    IRC_S5761_C,
    IRC_S5762_A,
    IRC_S5762_B,
    IRC_S5763_A,
    Person,
    Secretary,
    TobaccoRemovalEvent,
    tobacco_carved_out_by_5704b_or_d,
    tobacco_personal_use_exception_5761d2,
    tobacco_reland_5761c_applies,
    tobacco_removed_unpackaged,
};

// (a)(1)/(a)(2): WITH intent to defraud the United States -- DECISION-0194
// evaluative channel: "intent to defraud" is committed to a court's finding
// in a criminal/civil-penalty proceeding, not derivable from case facts.
external judgment relation established_intent_to_defraud_united_states(p: Person, e: TobaccoRemovalEvent) {
    authority DistrictCourt;
    label en official "the court finds this person acted with intent to defraud the United States with respect to this tobacco article (section 5751(a)(1)/(2))";
}
pub relation tobacco_tax_not_paid_or_determined(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5751(a)(1)(A): the tax has not been paid or determined in the manner and at the time this chapter or its regulations prescribe";
}
pub relation tobacco_diverted_from_tax_exempt_purpose(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5751(a)(1)(B): removed without payment of tax under section 5704, then diverted from the purpose/use section 5704 specifies";
}
pub relation tobacco_purchased_received_possessed_or_sold(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "the established act: this person purchased, received, possessed, offered for sale, or sold/disposed of the article after removal";
}
pub relation tobacco_sold_directly_to_consumers_from_proper_package(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5751(a)(3) last sentence: this person sold or delivered the article directly to consumers from a proper package -- exempts (a)(3) (non-fraud packaging violations) only, not (a)(1)/(a)(2)";
}

@source(IRC_S5751_A, relation = formalizes, coverage = exact, quote = "with intent to defraud the United States, purchase, receive, possess, offer for sale, or sell or otherwise dispose of, after removal, any tobacco products or cigarette papers or tubes")
rule TobaccoUntaxedPossessionFraudProhibited(p: Person, e: TobaccoRemovalEvent) defeasible {
    when tobacco_purchased_received_possessed_or_sold(p, e)
        and tobacco_tax_not_paid_or_determined(e)
        and established_intent_to_defraud_united_states(p, e);
    then prohibition NoFraudulentUntaxedPossession {
        bearer p;
        beneficiary Secretary;
        action tobacco_purchased_received_possessed_or_sold(p, e);
        window [-infinity, infinity];
    };
}
@source(IRC_S5751_A, relation = formalizes, coverage = exact, quote = "which, after removal without payment of tax pursuant to section 5704, have been diverted from the applicable purpose or use specified in that section")
rule TobaccoDivertedPossessionFraudProhibited(p: Person, e: TobaccoRemovalEvent) defeasible {
    when tobacco_purchased_received_possessed_or_sold(p, e)
        and tobacco_diverted_from_tax_exempt_purpose(e)
        and established_intent_to_defraud_united_states(p, e);
    then prohibition NoFraudulentDivertedPossession {
        bearer p;
        beneficiary Secretary;
        action tobacco_purchased_received_possessed_or_sold(p, e);
        window [-infinity, infinity];
    };
}
@source(IRC_S5751_A, relation = formalizes, coverage = exact, quote = "with intent to defraud the United States, purchase, receive, possess, offer for sale, or sell or otherwise dispose of, after removal, any tobacco products or cigarette papers or tubes, which are not put up in packages as required under section 5723 or which are put up in packages not bearing the marks, labels, and notices, as required under such section")
rule TobaccoImproperPackageFraudProhibited(p: Person, e: TobaccoRemovalEvent) defeasible {
    when tobacco_purchased_received_possessed_or_sold(p, e)
        and (tobacco_removed_unpackaged(e))
        and established_intent_to_defraud_united_states(p, e);
    then prohibition NoFraudulentImproperPackagePossession {
        bearer p;
        beneficiary Secretary;
        action tobacco_purchased_received_possessed_or_sold(p, e);
        window [-infinity, infinity];
    };
}
@source(IRC_S5751_A, relation = formalizes, coverage = exact, quote = "otherwise than with intent to defraud the United States, purchase, receive, possess, offer for sale, or sell or otherwise dispose of, after removal, any tobacco products or cigarette papers or tubes, which are not put up in packages as required under section 5723 or which are put up in packages not bearing the marks, labels, and notices, as required under such section")
rule TobaccoImproperPackageNonFraudProhibited(p: Person, e: TobaccoRemovalEvent) defeasible {
    when tobacco_purchased_received_possessed_or_sold(p, e) and tobacco_removed_unpackaged(e);
    then prohibition NoImproperPackagePossession {
        bearer p;
        beneficiary Secretary;
        action tobacco_purchased_received_possessed_or_sold(p, e);
        window [-infinity, infinity];
    };
    unless tobacco_sold_directly_to_consumers_from_proper_package(p, e);
}

pub relation tobacco_possessed_in_violation_5751a1_or_a2(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5751(b): the case asserts a violation of (a)(1) or (a)(2) has occurred (untaxed-article or improper-package possession WITH fraudulent intent) -- feeds the (b) tax-equal-liability rule independent of whether a prohibition position above was separately raised";
}
@source(IRC_S5751_B, relation = formalizes, coverage = exact, quote = "Any person who possesses tobacco products or cigarette papers or tubes in violation of subsection (a)(1) or (a)(2) shall be liable for a tax equal to the tax on such articles.")
rule TobaccoLiabilityForViolationPossession(p: Person, e: TobaccoRemovalEvent, amount: Money) defeasible {
    when tobacco_possessed_in_violation_5751a1_or_a2(p, e) and us.irc.excise_goods::excise_tax_due(e, amount);
    then us.irc.excise_goods::liable_for_excise(p, e, amount);
}

// =====================================================================
// Section 5752 — restrictions on marks, labels, notices, packages
// =====================================================================

pub relation tobacco_mark_destroyed_before_emptied(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "the established act: this person destroyed, obliterated, or detached a required mark/label/notice on a package before it was emptied";
}
@source(IRC_S5752, relation = formalizes, coverage = exact, quote = "No person shall, with intent to defraud the United States, destroy, obliterate, or detach any mark, label, or notice prescribed or authorized, by this chapter or regulations thereunder, to appear on, or be affixed to, any package of tobacco products or cigarette papers or tubes, before such package is emptied.")
rule TobaccoNoDestroyingMarksBeforeEmptied(p: Person, e: TobaccoRemovalEvent) defeasible {
    when tobacco_mark_destroyed_before_emptied(p, e) and established_intent_to_defraud_united_states(p, e);
    then prohibition NoDestroyingMarksBeforeEmptied {
        bearer p;
        beneficiary Secretary;
        action tobacco_mark_destroyed_before_emptied(p, e);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 5753 — disposal of forfeited/condemned/abandoned articles
// =====================================================================

// An administrative-disposal directive to the Secretary (sell for
// consumption only if the price would cover the tax due and sale expenses;
// otherwise dispose of by regulation), not a duty/prohibition/power ADDRESSED
// TO A PERSON before this package's tribunal -- classified NON_NORMATIVE in
// the coverage row (institutional housekeeping around already-forfeited
// property, parallel to core's own note that lien/levy MECHANICS belong to
// `collection`, not to this package).

// =====================================================================
// Section 5754 — restriction on importation of previously exported
// tobacco products
// =====================================================================

pub relation tobacco_labeled_for_export(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5754(b): the article bears the section 5704(b) export mark/label/notice";
}
pub relation tobacco_export_label_altered_by_third_party(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5754(a)(2): the export packaging/label was modified or altered (including by a sticker) by a person other than the original manufacturer, attempting to remove or conceal the export label";
}
@source(IRC_S5754_A, relation = formalizes, coverage = exact, quote = "may not be sold or held for sale for domestic consumption in the United States unless such articles are removed from their export packaging and repackaged by the original manufacturer into new packaging that does not contain an export label")
rule TobaccoExportLabeledNotSoldDomestically(e: TobaccoRemovalEvent) defeasible {
    when tobacco_labeled_for_export(e);
    then prohibition NoDomesticSaleOfExportLabeledProduct {
        bearer e;
        beneficiary Secretary;
        action tobacco_sold_domestically_still_export_labeled(e);
        window [-infinity, infinity];
    };
}
pub relation tobacco_sold_domestically_still_export_labeled(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "established breach: sold/held for sale for domestic consumption without first being repackaged by the original manufacturer into non-export packaging";
}
@source(IRC_S5754_A, relation = formalizes, coverage = exact, quote = "This section shall apply to articles labeled for export even if the packaging or the appearance of such packaging to the consumer of such articles has been modified or altered by a person other than the original manufacturer so as to remove or conceal or attempt to remove or conceal (including by the placement of a sticker over) any export label.")
rule TobaccoExportLabelAlterationDoesNotExempt(e: TobaccoRemovalEvent) strict {
    when tobacco_export_label_altered_by_third_party(e);
    then tobacco_labeled_for_export(e);
}
// section 5754(a)(1)(A)/(B) (bonded transfer/removal only under section
// 5704; re-importation only via section 5704(c)/(d)) and (c) (cross
// references to sections 5761(c)/(d), 5762(b)) are already the mechanisms
// modeled in 02-tobacco-administration.law and immediately below; this
// module does not duplicate them as separate positions.

// =====================================================================
// Section 5761 — civil penalties
// =====================================================================

// (a): willful omission/neglect/refusal to comply with a chapter-52 duty,
// or doing a chapter-52-prohibited thing -- DECISION-0194 evaluative
// "willfully", channel: adjudicated (the civil-penalty forum's own finding).
external judgment relation established_willful_chapter52_noncompliance(p: Person) {
    authority DistrictCourt;
    label en official "willfully omits, neglects, or refuses to comply with a chapter 52 duty, or does a chapter-52-prohibited thing (section 5761(a))";
}
pub relation tobacco_penalty_collectible_by_assessment_instead(p: Person) kind empirical {
    label en unofficial "section 5761(a) proviso: a penalty under subsection (b)/(c), or section 6651/6653, or chapter 68 subchapter A part II may instead be collected from this person by assessment -- excludes the (a) civil action penalty";
}
@source(IRC_S5761_A, relation = formalizes, coverage = exact, quote = "Whoever willfully omits, neglects, or refuses to comply with any duty imposed upon him by this chapter, or to do, or cause to be done, any of the things required by this chapter, or does anything prohibited by this chapter, shall in addition to any other penalty provided in this title, be liable to a penalty of $1,000, to be recovered, with costs of suit, in a civil action")
rule TobaccoGeneralCivilPenalty(p: Person) defeasible {
    when established_willful_chapter52_noncompliance(p) and not_known(tobacco_penalty_collectible_by_assessment_instead(p));
    then tobacco_general_civil_penalty_due(p, S5761FlatPenalty);
}
pub relation tobacco_general_civil_penalty_due(p: Person, amount: Money) kind institutional {
    label en official "section 5761(a): the flat $1,000 civil penalty, recoverable with costs of suit in a civil action";
}

pub relation tobacco_tax_unpaid_at_deadline(e: TobaccoRemovalEvent, amount_due: Money) kind empirical {
    label en unofficial "section 5761(b): the section 5701 tax on this event was not paid by the time this chapter or its regulations prescribe";
}
@source(IRC_S5761_B, relation = formalizes, coverage = exact, quote = "Whoever fails to pay any tax imposed by this chapter at the time prescribed by law or regulations, shall, in addition to any other penalty provided in this title, be liable to a penalty of 5 percent of the tax due but unpaid.")
rule TobaccoFailureToPayPenalty(e: TobaccoRemovalEvent, amount_due: Money) strict {
    when tobacco_tax_unpaid_at_deadline(e, amount_due);
    then tobacco_failure_to_pay_penalty_due(e, round(amount_due * 0.05, 2, "HALF_UP"));
}
pub relation tobacco_failure_to_pay_penalty_due(e: TobaccoRemovalEvent, amount: Money) kind institutional {
    label en official "section 5761(b): 5 percent of the tax due but unpaid";
}

// (c): sale/relanding/receiving of export-labeled products within the
// jurisdiction of the United States; personal-use-quantity exception ((d)).
pub relation tobacco_relanded_or_received_within_jurisdiction(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5761(c)(1)-(3): sold, relanded, received, or aided/abetted the relanding/receiving of, an article previously labeled or shipped for export under this chapter";
}
pub relation tobacco_relanded_personal_use_quantity(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5761(d)(2): the quantity relanded/received is within the personal-use quantity allowed entry free of tax and duty under chapter 98 of the Harmonized Tariff Schedule, and this is not a delivery sale ((d)(3))";
}
@source(IRC_S5761_C, relation = formalizes, coverage = exact, quote = "shall, in addition to the tax and any other penalty provided in this title, be liable for a penalty equal to the greater of $1,000 or 5 times the amount of the tax imposed by this chapter")
rule TobaccoRelandingPenalty(p: Person, e: TobaccoRemovalEvent, tax: Money) defeasible {
    when tobacco_reland_5761c_applies(p, e)
        and us.irc.excise_goods::excise_tax_due(e, tax)
        and not_known(tobacco_personal_use_exception_5761d2(p, e))
        and not_known(tobacco_carved_out_by_5704b_or_d(p, e));
    then tobacco_relanding_penalty_due(p, e, max(S5761RelandingPenaltyFloor, round(tax * 5.00, 2, "HALF_UP")));
}
pub relation tobacco_relanding_penalty_due(p: Person, e: TobaccoRemovalEvent, amount: Money) kind institutional {
    label en official "section 5761(c): the greater of $1,000 or 5 times the chapter 52 tax, plus forfeiture of the relanded articles and the conveyances used";
}
pub relation tobacco_relanded_goods_forfeited(e: TobaccoRemovalEvent) kind institutional {
    label en official "section 5761(c): all relanded tobacco products/papers/tubes are forfeited to the United States and destroyed";
}
rule TobaccoRelandedGoodsForfeited(p: Person, e: TobaccoRemovalEvent) defeasible {
    when tobacco_relanding_penalty_due(p, e, _);
    then tobacco_relanded_goods_forfeited(e);
}

// (e)/(f): assessment/collection mechanics for the (b)/(c) penalties
// (section 6665(a)) and a cross-reference to the section 6656 deposit
// penalty -- administrative machinery, not independent norms; classified
// NON_NORMATIVE in the coverage rows.

// =====================================================================
// Section 5762 — criminal penalties (offense classification; punishment
// itself is EXTERNAL/judicial, per AGENT-BRIEF method)
// =====================================================================

pub enum TobaccoFraudulentOffenseKind {
    EngagingInBusinessUnlawfully;
    FailingToKeepOrFalsifyingRecords;
    RefusingToPayOrEvadingTax;
    RemovingArticlesUnlawfully;
    UnlawfulPurchaseReceiptPossessionOrSale;
    DestroyingMarksBeforeEmptied;
}
pub relation tobacco_fraudulent_offense(p: Person, kind: TobaccoFraudulentOffenseKind) kind empirical {
    label en unofficial "section 5762(a)(1)-(6): the case asserts this person, with intent to defraud the United States, committed one of the six listed acts";
}
pub relation tobacco_fraudulent_offense_classified(p: Person, kind: TobaccoFraudulentOffenseKind) kind institutional {
    label en official "section 5762(a): a chapter 52 fraudulent criminal offense of this kind is established; punishment (fine not more than $10,000, or imprisonment not more than 5 years, or both, for each offense) is EXTERNAL to this package -- imposed by the convicting court, not computed here";
}
@source(IRC_S5762_A, relation = formalizes, coverage = exact, quote = "shall, for each such offense, be fined not more than $10,000, or imprisoned not more than 5 years, or both")
rule TobaccoFraudulentOffenseClassified(p: Person, kind: TobaccoFraudulentOffenseKind) defeasible {
    when tobacco_fraudulent_offense(p, kind) and established_intent_to_defraud_united_states(p, _);
    then tobacco_fraudulent_offense_classified(p, kind);
}

pub relation tobacco_other_chapter52_violation(p: Person) kind empirical {
    label en unofficial "section 5762(b): a chapter 52 violation (or violation of its regulations) other than the (a) fraudulent offenses";
}
pub relation tobacco_other_offense_classified(p: Person) kind institutional {
    label en official "section 5762(b): fined not more than $1,000, or imprisoned not more than 1 year, or both, for each offense -- punishment EXTERNAL/judicial";
}
@source(IRC_S5762_B, relation = formalizes, coverage = exact, quote = "Whoever, otherwise than as provided in subsection (a), violates any provision of this chapter, or of regulations prescribed thereunder, shall, for each such offense, be fined not more than $1,000, or imprisoned not more than 1 year, or both.")
rule TobaccoOtherOffenseClassified(p: Person) strict {
    when tobacco_other_chapter52_violation(p);
    then tobacco_other_offense_classified(p);
}

// =====================================================================
// Section 5763 — forfeitures
// =====================================================================

pub relation tobacco_possessed_with_intent_to_defraud(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5763(a)(1): after removal, possessed with intent to defraud the United States";
}
@source(IRC_S5763_A, relation = formalizes, coverage = exact, quote = "All tobacco products and cigarette papers and tubes which, after removal, are possessed with intent to defraud the United States shall be forfeited to the United States.")
rule TobaccoForfeitureFraudPossession(p: Person, e: TobaccoRemovalEvent) defeasible {
    when tobacco_possessed_with_intent_to_defraud(p, e) and established_intent_to_defraud_united_states(p, e);
    then tobacco_article_forfeited(e);
}
pub relation tobacco_article_forfeited(e: TobaccoRemovalEvent) kind institutional {
    label en official "section 5763(a)/(b)/(c): the tobacco article (and, for (b)/(c), associated packages/machinery/fixtures/premises) is forfeited to the United States";
}
@source(IRC_S5763_A, relation = formalizes, coverage = exact, quote = "All tobacco products and cigarette papers and tubes not in packages as required under section 5723 or which are in packages not bearing the marks, labels, and notices, as required under such section, which, after removal, are possessed otherwise than with intent to defraud the United States, shall be forfeited to the United States.")
rule TobaccoForfeitureImproperPackageNonFraud(p: Person, e: TobaccoRemovalEvent) defeasible {
    when tobacco_purchased_received_possessed_or_sold(p, e) and tobacco_removed_unpackaged(e);
    then tobacco_article_forfeited(e);
    unless tobacco_sold_directly_to_consumers_from_proper_package(p, e);
}
// (b) (personal/real property of a qualified operator acting with intent to
// defraud) and (c) (real/personal property of an ILLICIT operator without
// bond/permit) and (d) (general property-intended-for-violation forfeiture
// under section 7302) extend the SAME forfeiture effect to a wider set of
// property; not separately re-derived as distinct positions here (the
// qualifying facts -- unbonded/unpermitted operation, fraudulent
// recordkeeping -- are already classified in 03-tobacco-permits.law and
// 05-tobacco-prohibitions-and-penalties.law above), flagged in the coverage
// rows as EXECUTABLE-by-cross-reference rather than duplicated rules.
