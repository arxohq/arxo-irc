// Chapter 53, subchapter B part II: section 5851 (special occupational tax
// exemption), section 5852 (general transfer/making tax exemption),
// section 5853 (exemption for certain governmental entities), section 5854
// (exportation exemption from transfer tax).

// =====================================================================
// Section 5851 — special (occupational) tax exemption
// =====================================================================

use self::{
    ExciseEvent,
    FirearmMakingEvent,
    FirearmTradeRole,
    FirearmTransferEvent,
    IRC_S5851_A,
    IRC_S5852_A,
    IRC_S5852_B,
    IRC_S5852_C,
    IRC_S5852_D,
    IRC_S5852_E,
    IRC_S5853_A,
    IRC_S5853_B,
    IRC_S5854,
    Person,
    firearm_occupational_taxpayer,
};

pub relation firearm_business_conducted_exclusively_with_united_states(p: Person) kind empirical {
    label en unofficial "section 5851(a): the person establishes to the Secretary's satisfaction that the business is conducted exclusively with, or on behalf of, the United States or a department/establishment/agency of it";
}
pub relation firearm_occupational_exemption_application_filed(p: Person) kind empirical {
    label en unofficial "section 5851(b): the exemption application is filed (and, thereafter, renewed on or before July 1 of each year)";
}
@source(IRC_S5851_A, relation = formalizes, coverage = exact, quote = "Any person required to pay special (occupational) tax under section 5801 shall be relieved from payment of that tax if he establishes to the satisfaction of the Secretary that his business is conducted exclusively with, or on behalf of, the United States or any department, independent establishment, or agency thereof.")
rule FirearmOccupationalTaxExemptionPower(p: Person) defeasible {
    when firearm_occupational_taxpayer(p, _, _) and firearm_occupational_exemption_application_filed(p);
    then power ClaimFirearmOccupationalExemption {
        holder p;
        over p;
        exercise firearm_occupational_exemption_claimed(p);
        valid_when firearm_business_conducted_exclusively_with_united_states(p);
        effect firearm_occupational_tax_relieved(p);
        window [-infinity, infinity];
    };
}
pub relation firearm_occupational_exemption_claimed(p: Person) kind empirical;
pub relation firearm_occupational_tax_relieved(p: Person) kind institutional {
    label en official "section 5851(a)/(b): the person is relieved from the section 5801 occupational tax on the approved application";
}

// =====================================================================
// Section 5852 — general transfer and making tax exemption
// =====================================================================

pub relation firearm_transfer_to_united_states(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5852(a): the transfer is to the United States or a department/establishment/agency of it";
}
pub relation firearm_making_by_or_for_united_states(e: FirearmMakingEvent) kind empirical {
    label en unofficial "section 5852(b): the making is by, or on behalf of, the United States or a department/establishment/agency of it";
}
pub relation firearm_making_by_qualified_manufacturer_of_type(e: FirearmMakingEvent) kind empirical {
    label en unofficial "section 5852(c): the maker is a manufacturer qualified under this chapter to manufacture this type of firearm";
}
pub relation firearm_transfer_between_qualified_occupational_taxpayers(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5852(d): the firearm is registered to a section-5801-qualified importer/manufacturer/dealer and transferred to another person qualified to manufacture, import, or deal in that type of firearm";
}
pub relation firearm_unserviceable_curio_transfer(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5852(e): an unserviceable firearm transferred as a curio or ornament, under the Secretary's prescribed requirements";
}
pub relation firearm_exemption_application_filed(e: ExciseEvent) kind empirical {
    label en unofficial "section 5852(f)/5853(c): no transfer or making is exempt under sections 5852/5853 unless performed pursuant to an application in the Secretary-prescribed form and manner";
}

@source(IRC_S5852_A, relation = formalizes, coverage = exact, quote = "Any firearm may be transferred to the United States or any department, independent establishment, or agency thereof, without payment of the transfer tax imposed by section 5811.")
rule FirearmTransferToUnitedStatesExempt(e: FirearmTransferEvent) defeasible {
    when firearm_transfer_to_united_states(e) and firearm_exemption_application_filed(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5852_B, relation = formalizes, coverage = exact, quote = "Any firearm may be made by, or on behalf of, the United States, or any department, independent establishment, or agency thereof, without payment of the making tax imposed by section 5821.")
rule FirearmMakingByUnitedStatesExempt(e: FirearmMakingEvent) defeasible {
    when firearm_making_by_or_for_united_states(e) and firearm_exemption_application_filed(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5852_C, relation = formalizes, coverage = exact, quote = "A manufacturer qualified under this chapter to engage in such business may make the type of firearm which he is qualified to manufacture without payment of the making tax imposed by section 5821.")
rule FirearmMakingByQualifiedManufacturerExempt(e: FirearmMakingEvent) defeasible {
    when firearm_making_by_qualified_manufacturer_of_type(e) and firearm_exemption_application_filed(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5852_D, relation = formalizes, coverage = exact, quote = "A firearm registered to a person qualified under this chapter to engage in business as an importer, manufacturer, or dealer may be transferred by that person without payment of the transfer tax imposed by section 5811 to any other person qualified under this chapter to manufacture, import, or deal in that type of firearm.")
rule FirearmTransferBetweenQualifiedTaxpayersExempt(e: FirearmTransferEvent) defeasible {
    when firearm_transfer_between_qualified_occupational_taxpayers(e) and firearm_exemption_application_filed(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5852_E, relation = formalizes, coverage = exact, quote = "An unserviceable firearm may be transferred as a curio or ornament without payment of the transfer tax imposed by section 5811, under such requirements as the Secretary may by regulations prescribe.")
rule FirearmUnserviceableCurioTransferExempt(e: FirearmTransferEvent) defeasible {
    when firearm_unserviceable_curio_transfer(e) and firearm_exemption_application_filed(e);
    then us.irc.excise_goods::tax_free_sale(e);
}

// =====================================================================
// Section 5853 — exemption for certain governmental entities
// =====================================================================

pub enum GovernmentalTransfereeKind { State; PossessionOfUnitedStates; PoliticalSubdivision; PoliceOrganizationEngagedInCriminalInvestigations; }
pub relation firearm_transfer_to_governmental_entity(e: FirearmTransferEvent, kind: GovernmentalTransfereeKind) kind empirical {
    label en unofficial "section 5853(a): the transferee is a State, a possession of the United States, a political subdivision of either, or an official police organization of such an entity engaged in criminal investigations";
}
pub relation firearm_making_by_governmental_entity(e: FirearmMakingEvent, kind: GovernmentalTransfereeKind) kind empirical {
    label en unofficial "section 5853(b): the maker is (or is acting on behalf of) a State, possession, political subdivision, or qualifying police organization";
}
@source(IRC_S5853_A, relation = formalizes, coverage = exact, quote = "A firearm may be transferred without the payment of the transfer tax imposed by section 5811 to any State, possession of the United States, any political subdivision thereof, or any official police organization of such a government entity engaged in criminal investigations.")
rule FirearmTransferToGovernmentalEntityExempt(e: FirearmTransferEvent, kind: GovernmentalTransfereeKind) defeasible {
    when firearm_transfer_to_governmental_entity(e, kind) and firearm_exemption_application_filed(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5853_B, relation = formalizes, coverage = exact, quote = "A firearm may be made without payment of the making tax imposed by section 5821 by, or on behalf of, any State, or possession of the United States, any political subdivision thereof, or any official police organization of such a government entity engaged in criminal investigations.")
rule FirearmMakingByGovernmentalEntityExempt(e: FirearmMakingEvent, kind: GovernmentalTransfereeKind) defeasible {
    when firearm_making_by_governmental_entity(e, kind) and firearm_exemption_application_filed(e);
    then us.irc.excise_goods::tax_free_sale(e);
}

// =====================================================================
// Section 5854 — exportation of firearms exempt from transfer tax
// =====================================================================

pub relation firearm_exported(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5854: the firearm is exported, with proof of exportation furnished as the Secretary prescribes";
}
@source(IRC_S5854, relation = formalizes, coverage = exact, quote = "A firearm may be exported without payment of the transfer tax imposed under section 5811 provided that proof of the exportation is furnished in such form and manner as the Secretary may by regulations prescribe.")
rule FirearmExportationExempt(e: FirearmTransferEvent) strict {
    when firearm_exported(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
