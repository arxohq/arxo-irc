// Chapter 52, subchapter A continued: section 5703 (liability for tax and
// method/time of payment), section 5704 (exemption from tax), section 5705
// (credit, refund, or allowance), section 5706 (drawback), section 5708
// (losses caused by disaster). Priority sections 5703/5704/5705, IRC-14
// stage 1.

// =====================================================================
// Section 5703(a) — liability for tax
// =====================================================================

use self::{
    IRC_S5703_A,
    IRC_S5703_B,
    IRC_S5704_A,
    IRC_S5704_B,
    IRC_S5704_C,
    IRC_S5704_D,
    IRC_S5705_A,
    IRC_S5705_B,
    IRC_S5705_C,
    IRC_S5706,
    IRC_S5708_A,
    IRC_S5708_B,
    Person,
    Secretary,
    TobaccoRemovalEvent,
    tobacco_event_in_special_september_period,
    tobacco_removal,
};

@source(IRC_S5703_A, relation = formalizes, coverage = exact, quote = "The manufacturer or importer of tobacco products and cigarette papers and tubes shall be liable for the taxes imposed thereon by section 5701.")
rule OriginalLiability(e: TobaccoRemovalEvent, responsible: Person, amount: Money) defeasible {
    when tobacco_removal(e, _, responsible)
        and us.irc.excise_goods::excise_tax_due(e, amount)
        and not_known(us.irc.excise_goods::tax_free_sale(e))
        and not_known(tobacco_liability_transfer_occurred(e));
    then us.irc.excise_goods::liable_for_excise(responsible, e, amount);
}

// section 5703(a)(2): liability transfers when tobacco products move without
// payment of tax under section 5704 between bonded premises, or on release
// in bond from customs custody to a manufacturer's bonded premises. The
// transferee becomes liable on receipt/release; the transferor is relieved.
pub relation tobacco_liability_transferred_to(e: TobaccoRemovalEvent, transferee: Person) kind empirical {
    label en unofficial "section 5703(a)(2): tobacco products/papers/tubes were transferred without payment of tax under section 5704 between bonded premises (or released in bond from customs custody to a manufacturer's premises), and this person received them, becoming liable in the transferor's place";
}
@source(IRC_S5703_A, relation = formalizes, coverage = exact, quote = "the transferee shall become liable for the tax upon receipt by him of such articles, and the transferor shall thereupon be relieved of his liability for such tax")
rule TransferredLiability(e: TobaccoRemovalEvent, transferee: Person, amount: Money) defeasible {
    when tobacco_liability_transferred_to(e, transferee) and us.irc.excise_goods::excise_tax_due(e, amount);
    then us.irc.excise_goods::liable_for_excise(transferee, e, amount);
}
pub relation tobacco_liability_transfer_occurred(e: TobaccoRemovalEvent) kind institutional {
    label en unofficial "derived marker: at least one section 5703(a)(2) liability transfer has occurred for this event (existential closure over `tobacco_liability_transferred_to`, since a bare `_` cannot appear under `not_known`)";
}
rule TobaccoLiabilityTransferOccurred(e: TobaccoRemovalEvent, transferee: Person) strict {
    when tobacco_liability_transferred_to(e, transferee);
    then tobacco_liability_transfer_occurred(e);
}

// =====================================================================
// Section 5703(b) — time for payment of taxes
// =====================================================================

// section 5703(b)(2): which semimonthly period governs the 14-day deadline
// differs by context ((A) domestic removal; (B)(i) general import; (B)(ii)
// entry for warehousing; (B)(iii) foreign trade zone treated as a single
// customs warehouse, EXCEPT (B)(iv) an article destined for export, which
// falls back to the (B)(i) general-import period rather than the
// warehousing-withdrawal period; (C) brought in from Puerto Rico). All five
// contexts share the SAME "14th day after the last day of the governing
// semimonthly period" formula (section 5703(b)(2)(A) sentence); they differ
// only in WHICH date is the governing period's last day, which is the
// classification the case must supply consistently with the paragraph
// describing its own removal.
pub enum TobaccoPaymentContext {
    DomesticRemoval;
    ImportedGeneral;
    ImportedWarehousingEntry;
    ImportedForeignTradeZone;
    BroughtFromPuertoRico;
}
pub relation tobacco_payment_period(e: TobaccoRemovalEvent, ctx: TobaccoPaymentContext, governing_period_end: Date) kind empirical {
    label en unofficial "section 5703(b)(2): the context governing this removal/entry/warehouse-withdrawal/Puerto-Rico-arrival and the last day of the semimonthly period that controls its 14-day payment deadline. An article destined for export (clause (iv)) is asserted with context ImportedGeneral (not ImportedWarehousingEntry/ImportedForeignTradeZone) even if it passed through a warehouse or a foreign trade zone, per the (B)(iv) exception";
}
pub relation unlawfully_manufactured_tobacco(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5703(b)(2)(F): manufactured at a place other than the bonded/permitted premises of a manufacturer -- tax is due immediately upon manufacture, not on the semimonthly schedule";
}
pub relation tobacco_tax_deadline(e: TobaccoRemovalEvent, deadline: Date) kind institutional {
    label en official "section 5703(b)(2): the last day for payment of the section 5701 tax on this event, before the section 5703(b)(2)(E) Saturday/Sunday/holiday rollover (not modeled -- see TECH-GAPS G150; the federal business-day calendar is owned by the `administration` package's section 7503 machinery, not by this package)";
}
@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "the last day for payment of such taxes shall be the 14th day after the last day of such semimonthly period")
rule TobaccoTaxDeadlineFromPeriod(e: TobaccoRemovalEvent, ctx: TobaccoPaymentContext, periodEnd: Date) strict {
    when tobacco_payment_period(e, ctx, periodEnd)
        and not_known(unlawfully_manufactured_tobacco(e))
        and not_known(tobacco_event_in_special_september_period(e));
    then tobacco_tax_deadline(e, add_calendar_period(periodEnd, 14 calendar_day));
}
@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "tax shall be due and payable immediately upon manufacture")
rule TobaccoTaxDeadlineUnlawfulManufacture(e: TobaccoRemovalEvent, on: Date, responsible: Person) strict {
    when unlawfully_manufactured_tobacco(e) and tobacco_removal(e, on, responsible);
    then tobacco_tax_deadline(e, on);
}

@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "Such taxes shall be paid on the basis of return.")
rule TobaccoTaxPaymentDuty(e: TobaccoRemovalEvent, responsible: Person, amount: Money, deadline: Date) defeasible {
    when us.irc.excise_goods::liable_for_excise(responsible, e, amount)
        and tobacco_tax_deadline(e, deadline)
        and tobacco_removal(e, _, responsible)
        and not_known(tobacco_event_in_special_september_period(e));
    then duty PayTobaccoTax {
        bearer responsible;
        beneficiary Secretary;
        goal achievement {
            condition tobacco_tax_paid(e);
            window [@1900-01-01, deadline];
        }
    };
}
pub relation tobacco_tax_paid(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "the section 5701 tax on this event has in fact been paid (case-asserted performance fact for the PayTobaccoTax duty)";
}

// section 5703(b)(3): electronic-fund-transfer requirement -- a compliance
// CLASSIFICATION over the taxpayer's prior calendar year gross liability,
// not itself a separate deadline (the underlying deadline is still computed
// above; EFT is a METHOD-of-payment mandate for large filers).
pub relation prior_year_tobacco_tax_liability(p: Person, amount: Money) kind empirical {
    label en unofficial "section 5703(b)(3): the person's gross amount of section 5701 (or section 7652) tax liability for the 12-month period ending December 31 of the preceding calendar year";
}
pub relation must_pay_tobacco_tax_by_eft(p: Person) kind institutional {
    label en official "section 5703(b)(3): this person must pay tobacco-products taxes by electronic fund transfer during the succeeding calendar year";
}
@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "Any person who in any 12-month period, ending December 31, was liable for a gross amount equal to or exceeding $5,000,000 in taxes imposed on tobacco products and cigarette papers and tubes by section 5701 (or 7652) shall pay such taxes during the succeeding calendar year by electronic fund transfer")
rule TobaccoEftMandate(p: Person, amount: Money) strict {
    when prior_year_tobacco_tax_liability(p, amount) and amount >= TobaccoEftThreshold;
    then must_pay_tobacco_tax_by_eft(p);
}

// section 5703(c): use of government depositaries -- an administrative
// authorization to the Secretary (institutional effect on the collection
// mechanism), not a norm addressed to the taxpayer. Classified NON_NORMATIVE
// in the coverage row for lack of a taxpayer-facing rule to write.

// section 5703(d): assessment on underpayment -- a straightforward
// cross-reference to the general section 6501/6203 assessment machinery
// (`assessment` package, F02), not re-implemented here; see
// `tobacco-firearms.deps.json`.

// =====================================================================
// Section 5704 — exemption from tax
// =====================================================================

pub relation tobacco_for_employee_use_or_experimental(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5704(a): furnished by the manufacturer, without payment of tax, for employee use/consumption or experimental purposes, in the quantities and manner Treasury regulations prescribe";
}
pub relation tobacco_bonded_transfer_or_export_removal(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5704(b): transferred in bond to another manufacturer's or export warehouse proprietor's bonded premises, or removed for export/Puerto-Rico/Virgin-Islands/possession shipment or for United States government use, bearing the required export marks";
}
pub relation tobacco_released_from_customs_custody_for_export_warehouse(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5704(c): released from customs custody, without payment of tax, for delivery to an export warehouse proprietor or (if not put up in packages) to a manufacturer";
}
pub relation tobacco_exported_and_returned_under_tariff_item_804(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5704(d): classifiable under tariff item 804.00 (articles previously exported and returned), released from customs custody without the internal-revenue-tax portion of duty, for delivery to the original manufacturer or an authorized export warehouse proprietor";
}

@source(IRC_S5704_A, relation = formalizes, coverage = exact, quote = "Tobacco products may be furnished by a manufacturer of such products, without payment of tax, for use or consumption by employees or for experimental purposes")
rule TobaccoEmployeeUseExempt(e: TobaccoRemovalEvent) strict {
    when tobacco_for_employee_use_or_experimental(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5704_B, relation = formalizes, coverage = exact, quote = "A manufacturer or export warehouse proprietor may transfer tobacco products and cigarette papers and tubes, without payment of tax, to the bonded premises of another manufacturer or export warehouse proprietor, or remove such articles, without payment of tax, for shipment to a foreign country")
rule TobaccoBondedOrExportExempt(e: TobaccoRemovalEvent) strict {
    when tobacco_bonded_transfer_or_export_removal(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5704_C, relation = formalizes, coverage = exact, quote = "Tobacco products and cigarette papers and tubes, imported or brought into the United States, may be released from customs custody, without payment of tax, for delivery to the proprietor of an export warehouse")
rule TobaccoCustomsReleaseExempt(e: TobaccoRemovalEvent) strict {
    when tobacco_released_from_customs_custody_for_export_warehouse(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5704_D, relation = formalizes, coverage = exact, quote = "may be released from customs custody, without payment of that part of the duty attributable to the internal revenue tax for delivery to the original manufacturer")
rule TobaccoExportedAndReturnedExempt(e: TobaccoRemovalEvent) strict {
    when tobacco_exported_and_returned_under_tariff_item_804(e);
    then us.irc.excise_goods::tax_free_sale(e);
}

// =====================================================================
// Section 5705 — credit, refund, or allowance of tax
// =====================================================================

pub entity TobaccoTaxClaim;
pub enum TobaccoClaimGround { WithdrawnFromMarket; LostOtherThanTheft; DestroyedByFireCasualtyOrActOfGod; }
pub relation tobacco_claim(c: TobaccoTaxClaim, claimant: Person, ground: TobaccoClaimGround, event_date: Date, filed_on: Date) kind empirical {
    label en unofficial "section 5705(a)/(c): a manufacturer/importer/export-warehouse-proprietor's claim for credit or refund of tax already paid, on tobacco products withdrawn from the market, lost (other than by theft), or destroyed by fire/casualty/act of God, with the date of the withdrawal/loss/destruction and the date the claim was filed";
}
pub relation tobacco_claim_tax_paid_proof(c: TobaccoTaxClaim) kind empirical {
    label en unofficial "section 5705(a): the claimant has furnished proof satisfactory to the Secretary that the tax was in fact paid on the articles the claim covers";
}
@source(IRC_S5705_C, relation = formalizes, coverage = exact, quote = "Any claim for credit or refund of tax under this section shall be filed within 6 months after the date of the withdrawal from the market, loss, or destruction of the articles to which the claim relates")
rule TobaccoClaimTimely(c: TobaccoTaxClaim, event_date: Date, filed_on: Date) strict {
    when tobacco_claim(c, _, _, event_date, filed_on) and filed_on <= add_calendar_period(event_date, 6 calendar_month);
    then tobacco_claim_timely(c);
}
pub relation tobacco_claim_timely(c: TobaccoTaxClaim) kind institutional;

@source(IRC_S5705_A, relation = formalizes, coverage = exact, quote = "Credit or refund of any tax imposed by this chapter or section 7652 shall be allowed or made (without interest) to the manufacturer, importer, or export warehouse proprietor, on proof satisfactory to the Secretary that the claimant manufacturer, importer, or export warehouse proprietor has paid the tax on tobacco products and cigarette papers and tubes withdrawn by him from the market")
rule TobaccoRefundPower(c: TobaccoTaxClaim, claimant: Person) defeasible {
    when tobacco_claim(c, claimant, _, _, _) and tobacco_claim_tax_paid_proof(c);
    then power TobaccoRefundClaim {
        holder claimant;
        over c;
        exercise tobacco_claim_allowed(c);
        valid_when tobacco_claim_timely(c);
        effect tobacco_refund_credited(c, claimant);
        window [-infinity, infinity];
    };
}
pub relation tobacco_claim_allowed(c: TobaccoTaxClaim) kind empirical {
    label en unofficial "the case asserts the claimant has invoked/exercised this refund claim";
}
pub relation tobacco_refund_credited(c: TobaccoTaxClaim, claimant: Person) kind institutional {
    label en official "section 5705(a): the credit or refund (without interest) resulting from a validly exercised claim";
}

// section 5705(b): pre-payment ALLOWANCE (relief before the tax is even
// paid) -- same shape as the refund power above but reached before payment;
// modeled as a sibling power over the same claim entity rather than a
// duplicate rule set, since the statute cross-refers "as aforesaid" to the
// same withdrawal/loss/destruction grounds and the same section 5705(c)
// 6-month limitation.
@source(IRC_S5705_B, relation = formalizes, coverage = exact, quote = "If the tax has not yet been paid on tobacco products and cigarette papers and tubes provided to have been withdrawn from the market or lost or destroyed as aforesaid, relief from the tax on such articles may be extended upon the filing of a claim for allowance therefor")
rule TobaccoPrePaymentAllowancePower(c: TobaccoTaxClaim, claimant: Person) defeasible {
    when tobacco_claim(c, claimant, _, _, _) and not_known(tobacco_claim_tax_paid_proof(c));
    then power TobaccoPrePaymentAllowance {
        holder claimant;
        over c;
        exercise tobacco_claim_allowed(c);
        valid_when tobacco_claim_timely(c);
        effect tobacco_allowance_extended(c, claimant);
        window [-infinity, infinity];
    };
}
pub relation tobacco_allowance_extended(c: TobaccoTaxClaim, claimant: Person) kind institutional {
    label en official "section 5705(b): relief from a not-yet-paid tax, extended on a validly exercised pre-payment allowance claim";
}

// =====================================================================
// Section 5706 — drawback of tax
// =====================================================================

pub relation tobacco_shipped_from_united_states(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5706: tobacco products/papers/tubes on which tax was paid, shipped from the United States (exported)";
}
@source(IRC_S5706, relation = formalizes, coverage = exact, quote = "There shall be an allowance of drawback of tax paid on tobacco products and cigarette papers and tubes, when shipped from the United States")
rule TobaccoDrawback(e: TobaccoRemovalEvent, responsible: Person, amount: Money) defeasible {
    when tobacco_shipped_from_united_states(e) and us.irc.excise_goods::liable_for_excise(responsible, e, amount);
    then power TobaccoDrawbackClaim {
        holder responsible;
        over e;
        exercise tobacco_drawback_claimed(e);
        valid_when tobacco_shipped_from_united_states(e);
        effect tobacco_drawback_allowed(e, responsible, amount);
        window [-infinity, infinity];
    };
}
pub relation tobacco_drawback_claimed(e: TobaccoRemovalEvent) kind empirical;
pub relation tobacco_drawback_allowed(e: TobaccoRemovalEvent, responsible: Person, amount: Money) kind institutional;

// =====================================================================
// Section 5708 — losses caused by disaster
// =====================================================================

pub entity DisasterTobaccoClaim;
pub relation presidential_major_disaster_determination(clm: DisasterTobaccoClaim, determined_on: Date) kind empirical {
    label en unofficial "section 5708(a): the President has determined under the Stafford Act that a major disaster occurred, on this date";
}
pub relation disaster_tobacco_loss(clm: DisasterTobaccoClaim, holder: Person, amount: Money, filed_on: Date) kind empirical {
    label en unofficial "section 5708(a)/(b): tobacco products held and intended for sale at the time of the disaster, lost/rendered unmarketable/condemned by reason of the disaster, and the amount of internal revenue tax (and customs duty) paid or determined on them; the person holding them for sale at the time of the disaster, and the date this claim was filed";
}
pub relation disaster_tobacco_not_indemnified(clm: DisasterTobaccoClaim) kind empirical {
    label en unofficial "section 5708(b)(2)(A): the claimant was not indemnified by insurance or otherwise for the tax (or tax and duty) covered by the claim";
}
pub relation disaster_tobacco_destroyed_under_supervision(clm: DisasterTobaccoClaim) kind empirical {
    label en unofficial "section 5708(c): the condemned/unmarketable product was destroyed under Secretary-satisfactory supervision before payment";
}
@source(IRC_S5708_B, relation = formalizes, coverage = exact, quote = "filed within 6 months after the date on which the President makes the determination that the disaster referred to in subsection (a) has occurred")
rule DisasterClaimTimely(clm: DisasterTobaccoClaim, determined_on: Date, filed_on: Date) strict {
    when presidential_major_disaster_determination(clm, determined_on)
        and disaster_tobacco_loss(clm, _, _, filed_on)
        and filed_on <= add_calendar_period(determined_on, 6 calendar_month);
    then disaster_claim_timely(clm);
}
pub relation disaster_claim_timely(clm: DisasterTobaccoClaim) kind institutional;
pub relation disaster_claim_valid_ground(clm: DisasterTobaccoClaim) kind institutional {
    label en official "section 5708(b): timely, not indemnified, and (where condemned/unmarketable) properly destroyed under supervision";
}
@source(IRC_S5708_B, relation = formalizes, coverage = partial, quote = "he was not indemnified by any valid claim of insurance or otherwise in respect of the tax, or tax and duty, on the tobacco products or cigarette papers or tubes covered by the claim, and")
rule DisasterClaimValidGround(clm: DisasterTobaccoClaim) defeasible {
    when disaster_claim_timely(clm)
        and disaster_tobacco_not_indemnified(clm)
        and not_known(disaster_claim_pending_destruction(clm));
    then disaster_claim_valid_ground(clm);
}
pub relation disaster_claim_pending_destruction(clm: DisasterTobaccoClaim) kind empirical {
    label en unofficial "section 5708(c): the condemned/unmarketable product still needs to be destroyed under supervision before payment can be made (case-asserted gate; not previously satisfied)";
}
@source(IRC_S5708_A, relation = formalizes, coverage = exact, quote = "the Secretary shall pay (without interest) an amount equal to the amount of the internal revenue taxes paid or determined and customs duties paid on tobacco products and cigarette papers and tubes removed, which were lost, rendered unmarketable, or condemned")
rule DisasterTobaccoPaymentPower(clm: DisasterTobaccoClaim, holder: Person, amount: Money) defeasible {
    when disaster_tobacco_loss(clm, holder, amount, _) and disaster_claim_valid_ground(clm);
    then power DisasterTobaccoPayment {
        holder holder;
        over clm;
        exercise disaster_tobacco_claim_invoked(clm);
        valid_when disaster_claim_valid_ground(clm);
        effect disaster_tobacco_payment_made(clm, holder, amount);
        window [-infinity, infinity];
    };
}
pub relation disaster_tobacco_claim_invoked(clm: DisasterTobaccoClaim) kind empirical;
pub relation disaster_tobacco_payment_made(clm: DisasterTobaccoClaim, holder: Person, amount: Money) kind institutional {
    label en official "section 5708(a): the Secretary's payment (without interest) equal to the tax (and duty) on the disaster-lost tobacco products";
}
