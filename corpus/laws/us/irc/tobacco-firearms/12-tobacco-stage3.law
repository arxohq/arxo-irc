// Stage 3 (TECH_GAP reduction), part A: chapter 52 tobacco. Sections 5701(a)(2) (cigars removed but not intended for sale),
// 5702(l) (price for which sold), 5702(p) (manufacturer of processed tobacco), 5703(b)(2)(D) (September special payment
// date), 5712(3) (attribution of officers, directors, principal stockholders and partners), 5713(b)(1) (show cause order),
// 5731(b)(2)-(3) (aggregation and 448(c)(3)(B)-(C) rules for the small-proprietor test), 5733(b)-(d) (places, multiple
// pursuits, succession and relocation).
//
// JUDGMENT CALLS (also in the coverage rows):
// (1) There is no date-component builtin (no month/day of a Date), so the calendar dates "September 16 - 26" and
//     "September 29" of section 5703(b)(2)(D) are carried as case-asserted period-end dates (the period ending September 26,
//     or September 25 for payments not required to be made by electronic funds transfer); the statutory deadline is the
//     period end plus 3 calendar days, which is September 29 (or September 28) exactly.
// (2) Aggregates over derived results are a section 111 subset limit; every sum below runs over EMPIRICAL relations
//     (recorded gross receipts, returns and allowances), and the short-year annualization is applied to the aggregate.
// (3) Cents HALF_UP where the text names no rounding of a Money result.

// =====================================================================
// Section 5701(a)(2) / 5702(l): the price for which a large cigar is sold
// =====================================================================

use self::{
    CigarWeightClass,
    IRC_S5701_A,
    IRC_S5702,
    IRC_S5703_B,
    IRC_S5712,
    IRC_S5713_B,
    IRC_S5731_B,
    IRC_S5733_B,
    IRC_S5733_C,
    IRC_S5733_D,
    Person,
    Secretary,
    TobaccoBusinessKind,
    TobaccoPermitApplication,
    TobaccoRemovalEvent,
    cigar_not_intended_for_sale,
    cigar_removal,
    must_pay_tobacco_tax_by_eft,
    tobacco_occupational_rate,
    tobacco_occupational_taxpayer,
    tobacco_permit_application,
    tobacco_permit_denial_ground,
    tobacco_permit_granted,
    tobacco_permit_revocation_ground,
    tobacco_tax_deadline,
    unlawfully_manufactured_tobacco,
};

pub relation cigar_sale_price_charged(e: TobaccoRemovalEvent, amount: Money) kind empirical {
    label en unofficial "section 5702(l): the per-cigar price at which the cigar is invoiced, before the section 5702(l)(1) additions and (2) exclusions (when recorded, the price for which sold is DERIVED from it instead of being taken from `cigar_removal`'s asserted price)";
}
pub relation cigar_readying_charge(e: TobaccoRemovalEvent, amount: Money) kind empirical {
    label en unofficial "section 5702(l)(1): a per-cigar charge incident to placing the article in condition ready for use, not already in the invoiced price";
}
pub relation cigar_chapter_tax_included_in_price(e: TobaccoRemovalEvent, amount: Money) kind empirical {
    label en unofficial "section 5702(l)(2)(A): the per-cigar amount of the tax imposed by this chapter or section 7652 that is included in the invoiced price (asserted; deriving it from the price would be circular)";
}
pub relation cigar_state_retail_sales_tax_separately_stated(e: TobaccoRemovalEvent, amount: Money) kind empirical {
    label en unofficial "section 5702(l)(2)(B): the per-cigar amount of a State, local or District of Columbia retail sales tax stated as a separate charge";
}
relation cigar_sale_price_charged_recorded(e: TobaccoRemovalEvent) kind institutional {
    label en unofficial "helper: a sale price charged was recorded for this cigar removal (existential closure, since a bare `_` cannot appear under `not_known`)";
}
rule CigarSalePriceChargedRecorded(e: TobaccoRemovalEvent, a: Money) strict {
    when cigar_sale_price_charged(e, a);
    then cigar_sale_price_charged_recorded(e);
}
pub relation cigar_price_for_which_sold_5702l(e: TobaccoRemovalEvent, price: Money) kind institutional {
    label en official "section 5702(l): the price for which the cigar is sold: the invoiced price plus readying charges, less this chapter's tax and separately stated retail sales tax";
}
@source(IRC_S5702, relation = formalizes, coverage = partial, quote = "(1) there shall be included any charge incident to placing the article in condition ready for use,")
rule CigarPriceForWhichSold(e: TobaccoRemovalEvent, charged: Money) strict {
    when cigar_sale_price_charged(e, charged);
    then cigar_price_for_which_sold_5702l(e, charged
        + sum(collect all r: Money where cigar_readying_charge(e, r), empty: 0.00 USD)
        - sum(collect all t: Money where cigar_chapter_tax_included_in_price(e, t), empty: 0.00 USD)
        - sum(collect all s: Money where cigar_state_retail_sales_tax_separately_stated(e, s), empty: 0.00 USD));
}

pub external judgment relation cigar_constructive_price_by_analogy_4216b(e: TobaccoRemovalEvent, price: Money) {
    authority Secretary;
    label en official "section 5702(l)(3): the price determined by applying rules similar to the rules of section 4216(b) (constructive sale price); DECISION-0194: the text commits the analogy to the Secretary's rules, the price is asserted with origin adjudicated";
}
relation cigar_constructive_price_recorded(e: TobaccoRemovalEvent) kind institutional {
    label en unofficial "helper: a section 4216(b)-by-analogy price was determined for this cigar removal";
}
rule CigarConstructivePriceRecorded(e: TobaccoRemovalEvent, p: Money) strict {
    when cigar_constructive_price_by_analogy_4216b(e, p);
    then cigar_constructive_price_recorded(e);
}
pub relation similar_cigar_price_for_sale(e: TobaccoRemovalEvent, price: Money) kind empirical {
    label en unofficial "section 5701(a)(2) last sentence: the per-cigar price for which similar cigars removed for sale are sold (already determined under section 5702(l)), used for a cigar removed but not intended for sale";
}

pub relation large_cigar_price_basis(e: TobaccoRemovalEvent, price: Money) kind institutional {
    label en official "sections 5701(a)(2) and 5702(l): the per-cigar price on which the 52.75 percent is computed";
}
@source(IRC_S5702, relation = formalizes, coverage = partial, quote = "In determining price for purposes of section 5701(a)(2)—")
rule LargeCigarPriceBasisAsserted(e: TobaccoRemovalEvent, price: Money) strict {
    when cigar_removal(e, LargeCigar, _, price)
        and not_known(cigar_not_intended_for_sale(e))
        and not_known(cigar_sale_price_charged_recorded(e))
        and not_known(cigar_constructive_price_recorded(e));
    then large_cigar_price_basis(e, price);
}
@source(IRC_S5702, relation = formalizes, coverage = partial, quote = "(2) there shall be excluded—")
rule LargeCigarPriceBasisDerived(e: TobaccoRemovalEvent, price: Money) strict {
    when cigar_removal(e, LargeCigar, _, _)
        and cigar_price_for_which_sold_5702l(e, price)
        and not_known(cigar_not_intended_for_sale(e))
        and not_known(cigar_constructive_price_recorded(e));
    then large_cigar_price_basis(e, price);
}
@source(IRC_S5702, relation = formalizes, coverage = partial, quote = "(3) rules similar to the rules of section 4216(b) shall apply.")
rule LargeCigarPriceBasisConstructive(e: TobaccoRemovalEvent, price: Money) strict {
    when cigar_removal(e, LargeCigar, _, _)
        and cigar_constructive_price_by_analogy_4216b(e, price)
        and not_known(cigar_not_intended_for_sale(e));
    then large_cigar_price_basis(e, price);
}
@source(IRC_S5701_A, relation = formalizes, coverage = exact, quote = "Cigars not exempt from tax under this chapter which are removed but not intended for sale shall be taxed at the same rate as similar cigars removed for sale.")
rule LargeCigarPriceBasisNotIntendedForSale(e: TobaccoRemovalEvent, price: Money) strict {
    when cigar_removal(e, LargeCigar, _, _)
        and cigar_not_intended_for_sale(e)
        and similar_cigar_price_for_sale(e, price);
    then large_cigar_price_basis(e, price);
}

// =====================================================================
// Section 5702(p): manufacturer of processed tobacco
// =====================================================================

pub entity TobaccoActivity;
pub relation tobacco_activity_operator(a: TobaccoActivity, p: Person) kind empirical {
    label en unofficial "section 5702(p): the person carrying on this activity with tobacco";
}
pub relation tobacco_activity_processes_tobacco(a: TobaccoActivity) kind empirical {
    label en unofficial "section 5702(p)(1): the activity processes tobacco other than tobacco products";
}
pub relation tobacco_activity_is_farming_or_growing(a: TobaccoActivity) kind empirical {
    label en unofficial "section 5702(p)(2): the farming or growing of tobacco";
}
pub relation tobacco_activity_is_handling_solely_for_delivery_to_manufacturer(a: TobaccoActivity) kind empirical {
    label en unofficial "section 5702(p)(2): handling of tobacco solely for sale, shipment, or delivery to a manufacturer of tobacco products or processed tobacco";
}
pub relation tobacco_activity_excluded_from_processing(a: TobaccoActivity) kind institutional {
    label en official "section 5702(p)(2): the activity is farming or growing, or handling solely for delivery to a manufacturer, which is not processing";
}
@source(IRC_S5702, relation = formalizes, coverage = exact, quote = "The processing of tobacco shall not include the farming or growing of tobacco")
rule TobaccoActivityExcludedFarming(a: TobaccoActivity) strict {
    when tobacco_activity_is_farming_or_growing(a);
    then tobacco_activity_excluded_from_processing(a);
}
@source(IRC_S5702, relation = formalizes, coverage = exact, quote = "the handling of tobacco solely for sale, shipment, or delivery to a manufacturer of tobacco products or processed tobacco")
rule TobaccoActivityExcludedHandling(a: TobaccoActivity) strict {
    when tobacco_activity_is_handling_solely_for_delivery_to_manufacturer(a);
    then tobacco_activity_excluded_from_processing(a);
}
pub relation tobacco_processing_activity(a: TobaccoActivity) kind institutional {
    label en official "section 5702(p): the activity is processing of tobacco (not farming, growing or delivery handling)";
}
rule TobaccoProcessingActivityRule(a: TobaccoActivity) defeasible {
    when tobacco_activity_processes_tobacco(a);
    unless tobacco_activity_excluded_from_processing(a);
    then tobacco_processing_activity(a);
}
pub relation manufacturer_of_processed_tobacco(p: Person) kind institutional {
    label en official "section 5702(p)(1): a person who processes any tobacco other than tobacco products";
}
@source(IRC_S5702, relation = formalizes, coverage = exact, quote = "The term \"manufacturer of processed tobacco\" means any person who processes any tobacco other than tobacco products.")
rule ManufacturerOfProcessedTobacco(p: Person, a: TobaccoActivity) defeasible {
    when tobacco_activity_operator(a, p) and tobacco_processing_activity(a);
    then manufacturer_of_processed_tobacco(p);
}

// =====================================================================
// Section 5703(b)(2)(D): special rule for tax due in September
// =====================================================================

pub relation tobacco_special_september_period_end(e: TobaccoRemovalEvent, period_end: Date) kind empirical {
    label en unofficial "section 5703(b)(2)(D): the removal falls in the September 16 - 26 period (September 16 - 25 for payments not required to be made by electronic funds transfer); the value is the last day of that period (JUDGMENT CALL: asserted, no date-component builtin)";
}
relation tobacco_event_in_special_september_period(e: TobaccoRemovalEvent) kind institutional {
    label en unofficial "helper: the removal is in the special September period (existential closure of the asserted period end)";
}
rule TobaccoEventInSpecialSeptemberPeriod(e: TobaccoRemovalEvent, d: Date) strict {
    when tobacco_special_september_period_end(e, d);
    then tobacco_event_in_special_september_period(e);
}
@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "shall be paid not later than September 29")
rule TobaccoTaxDeadlineSeptemberSpecial(e: TobaccoRemovalEvent, d: Date) strict {
    when tobacco_special_september_period_end(e, d) and not_known(unlawfully_manufactured_tobacco(e));
    then tobacco_tax_deadline(e, add_calendar_period(d, 3 calendar_day));
}
pub relation tobacco_special_period_taxes(p: Person, period_end: Date, period_tax: Money, first_half_tax: Money, paid_by_deadline: Money) kind empirical {
    label en unofficial "section 5703(b)(2)(D): for the special September period ending on period_end: the person's taxes for that period, the taxes for the period September 1 - 15, and the amount paid not later than the special due date";
}
pub relation tobacco_special_period_deadline(p: Person, period_end: Date, deadline: Date) kind institutional {
    label en official "section 5703(b)(2)(D)(i), (iii): the special payment date: three days after the end of the special period (September 29, or September 28 for payments not required by electronic funds transfer)";
}
rule TobaccoSpecialPeriodDeadline(p: Person, d: Date) strict {
    when tobacco_special_period_taxes(p, d, _, _, _);
    then tobacco_special_period_deadline(p, d, add_calendar_period(d, 3 calendar_day));
}
pub relation tobacco_special_period_requirement_met(p: Person, period_end: Date) kind institutional {
    label en official "section 5703(b)(2)(D)(i)-(iii): the September special payment requirement is met: the whole period tax paid by the special date, or the safe harbor (11/15 of the September 1 - 15 taxes, or 2/3 when electronic funds transfer is not required)";
}
@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "the taxes on tobacco products and cigarette papers and tubes for the period beginning on September 16 and ending on September 26 shall be paid not later than September 29")
rule TobaccoSpecialPeriodFullyPaid(p: Person, d: Date, tax: Money, paid: Money) strict {
    when tobacco_special_period_taxes(p, d, tax, _, paid) and paid >= tax;
    then tobacco_special_period_requirement_met(p, d);
}
@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "The requirement of clause (i) shall be treated as met if the amount paid not later than September 29 is not less than 11/15 of the taxes on tobacco products and cigarette papers and tubes for the period beginning on September 1 and ending on September 15.")
rule TobaccoSpecialPeriodSafeHarborEft(p: Person, d: Date, first: Money, paid: Money) strict {
    when tobacco_special_period_taxes(p, d, _, first, paid) and must_pay_tobacco_tax_by_eft(p) and paid * 15 >= first * 11;
    then tobacco_special_period_requirement_met(p, d);
}
@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "In the case of payments not required to be made by electronic funds transfer, clauses (i) and (ii) shall be applied by substituting \"September 25\" for \"September 26\", \"September 28\" for \"September 29\", and \"2/3\" for \"11/15\".")
rule TobaccoSpecialPeriodSafeHarborNonEft(p: Person, d: Date, first: Money, paid: Money) strict {
    when tobacco_special_period_taxes(p, d, _, first, paid) and not_known(must_pay_tobacco_tax_by_eft(p)) and paid * 3 >= first * 2;
    then tobacco_special_period_requirement_met(p, d);
}
@source(IRC_S5703_B, relation = formalizes, coverage = exact, quote = "shall be paid not later than September 29")
rule TobaccoSpecialPeriodPaymentDuty(p: Person, d: Date, due: Date) defeasible {
    when tobacco_special_period_taxes(p, d, _, _, _) and tobacco_special_period_deadline(p, d, due);
    then duty PayTobaccoSeptemberSpecialPeriodTax {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition tobacco_special_period_requirement_met(p, d);
            window [@1900-01-01, due];
        }
    };
}

// =====================================================================
// Section 5712(3): conduct of officers, directors, principal stockholders and partners is the applicant's
// =====================================================================

pub enum TobaccoApplicantAssociation { Officer; Director; PrincipalStockholder; Partner; }
pub relation tobacco_associated_with_applicant(q: Person, applicant: Person, assoc: TobaccoApplicantAssociation) kind empirical {
    label en unofficial "section 5712(3): the person is an officer, director or principal stockholder of a corporate applicant, or a partner of a partnership applicant";
}
pub relation tobacco_person_felony_conviction(q: Person) kind empirical {
    label en unofficial "section 5712(3)(B): the person has been convicted of a felony violation of Federal or State criminal law relating to tobacco products, processed tobacco, cigarette paper, or cigarette tubes";
}
pub relation tobacco_person_unlikely_to_comply(q: Person) kind empirical {
    label en unofficial "section 5712(3)(A): the person is, by reason of business experience, financial standing, trade connections or legal proceedings, not likely to maintain operations in compliance with this chapter (asserted determination)";
}
pub relation tobacco_person_application_false_statement(q: Person, app: TobaccoPermitApplication) kind empirical {
    label en unofficial "section 5712(3)(C): the person failed to disclose material information required, or made a material false statement, in the application";
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "has been convicted of a felony violation of any provision of Federal or State criminal law relating to tobacco products")
rule TobaccoDenialGroundFelonyOfAssociate(app: TobaccoPermitApplication, applicant: Person, q: Person, assoc: TobaccoApplicantAssociation) strict {
    when tobacco_permit_application(app, applicant, _)
        and tobacco_associated_with_applicant(q, applicant, assoc)
        and tobacco_person_felony_conviction(q);
    then tobacco_permit_denial_ground(app);
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "not likely to maintain operations in compliance with this chapter")
rule TobaccoDenialGroundUnlikelyComplianceOfAssociate(app: TobaccoPermitApplication, applicant: Person, q: Person, assoc: TobaccoApplicantAssociation) strict {
    when tobacco_permit_application(app, applicant, _)
        and tobacco_associated_with_applicant(q, applicant, assoc)
        and tobacco_person_unlikely_to_comply(q);
    then tobacco_permit_denial_ground(app);
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "has failed to disclose any material information required or made any material false statement in the application therefor")
rule TobaccoDenialGroundFalseStatementOfAssociate(app: TobaccoPermitApplication, applicant: Person, q: Person, assoc: TobaccoApplicantAssociation) strict {
    when tobacco_permit_application(app, applicant, _)
        and tobacco_associated_with_applicant(q, applicant, assoc)
        and tobacco_person_application_false_statement(q, app);
    then tobacco_permit_denial_ground(app);
}

// =====================================================================
// Section 5713(b)(1): the show-cause order
// =====================================================================

pub external judgment relation secretary_has_reason_to_believe_5713b1(p: Person) {
    authority Secretary;
    label en official "section 5713(b)(1): the Secretary has reason to believe that the permit holder is within one of the grounds (A)-(F) (DECISION-0194: the belief is the Secretary's; the grounds themselves are facts)";
}
pub relation tobacco_show_cause_order_exercised(p: Person) kind empirical {
    label en unofficial "the Secretary in fact issued the order stating the facts charged and citing the holder to show cause";
}
pub relation tobacco_show_cause_order_issued(p: Person) kind institutional {
    label en official "section 5713(b)(1): the order stating the facts charged, citing the permit holder to show cause why the permit should not be suspended or revoked, has been issued";
}
@source(IRC_S5713_B, relation = formalizes, coverage = exact, quote = "the Secretary shall issue an order, stating the facts charged, citing such person to show cause why his permit should not be suspended or revoked.")
rule TobaccoShowCauseOrderPower(p: Person) defeasible {
    when tobacco_permit_granted(p) and secretary_has_reason_to_believe_5713b1(p);
    then power IssueTobaccoShowCauseOrder {
        holder Secretary;
        over p;
        exercise tobacco_show_cause_order_exercised(p);
        valid_when tobacco_permit_revocation_ground(p);
        effect tobacco_show_cause_order_issued(p);
        window [-infinity, infinity];
    };
}
@source(IRC_S5713_B, relation = formalizes, coverage = exact, quote = "the Secretary shall issue an order, stating the facts charged, citing such person to show cause why his permit should not be suspended or revoked.")
rule TobaccoShowCauseOrderDuty(p: Person) defeasible {
    when tobacco_permit_granted(p) and secretary_has_reason_to_believe_5713b1(p);
    then duty IssueTobaccoShowCauseOrderDuty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition tobacco_show_cause_order_issued(p);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 5731(b)(2)-(3): the small-proprietor gross receipts test
// =====================================================================

pub relation tobacco_controlled_group_member(p: Person, q: Person) kind empirical {
    label en unofficial "section 5731(b)(2): q is treated as one taxpayer with p under section 5061(e)(3) (EXTERNAL_DEPENDENCY on the section 5061(e)(3) controlled-group determination, carried as a fact)";
}
pub relation tobacco_receipts_returns_and_allowances(p: Person, amount: Money) kind empirical {
    label en unofficial "section 5731(b)(3) with section 448(c)(3)(C): returns and allowances made during the test year, which reduce the gross receipts (one item per return or allowance)";
}
pub relation tobacco_receipts_short_period_months(p: Person, months: Integer) kind empirical {
    label en unofficial "section 5731(b)(3) with section 448(c)(3)(B): the test year is a taxable year of less than 12 months, of this many months";
}
relation tobacco_short_period_recorded(p: Person) kind institutional {
    label en unofficial "helper: a short test year was recorded for this taxpayer";
}
rule TobaccoShortPeriodRecorded(p: Person, m: Integer) strict {
    when tobacco_receipts_short_period_months(p, m);
    then tobacco_short_period_recorded(p);
}
pub relation tobacco_net_group_receipts(p: Person, amount: Money) kind institutional {
    label en official "section 5731(b)(2)-(3): the gross receipts of the taxpayer and of all persons treated as one taxpayer, reduced by returns and allowances";
}
@source(IRC_S5731_B, relation = formalizes, coverage = exact, quote = "All persons treated as 1 taxpayer under section 5061(e)(3) shall be treated as 1 taxpayer for purposes of paragraph (1).")
rule TobaccoNetGroupReceipts(p: Person, own: Money) strict {
    when tobacco_occupational_taxpayer(p, _, own);
    then tobacco_net_group_receipts(p, own
        + sum(collect all g: Money, q: Person, k: TobaccoBusinessKind where tobacco_controlled_group_member(p, q) and tobacco_occupational_taxpayer(q, k, g), empty: 0.00 USD)
        - sum(collect all r: Money where tobacco_receipts_returns_and_allowances(p, r), empty: 0.00 USD)
        - sum(collect all r2: Money, q2: Person where tobacco_controlled_group_member(p, q2) and tobacco_receipts_returns_and_allowances(q2, r2), empty: 0.00 USD));
}
pub relation tobacco_receipts_test_amount(p: Person, amount: Money) kind institutional {
    label en official "section 5731(b): the gross receipts compared with the small-proprietor threshold, after aggregation, returns and allowances and annualization of a short year";
}
@source(IRC_S5731_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), rules similar to the rules of subparagraphs (B) and (C) of section 448(c)(3) shall apply.")
rule TobaccoReceiptsTestAmountFullYear(p: Person, net: Money) strict {
    when tobacco_net_group_receipts(p, net) and not_known(tobacco_short_period_recorded(p));
    then tobacco_receipts_test_amount(p, net);
}
@source(IRC_S5731_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), rules similar to the rules of subparagraphs (B) and (C) of section 448(c)(3) shall apply.")
rule TobaccoReceiptsTestAmountShortYear(p: Person, net: Money, m: Integer) strict {
    when tobacco_net_group_receipts(p, net) and tobacco_receipts_short_period_months(p, m) and m > 0 and m < 12;
    then tobacco_receipts_test_amount(p, div_round(net * 12, m * 1.0, 2, "HALF_UP"));
}
@source(IRC_S5731_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), rules similar to the rules of subparagraphs (B) and (C) of section 448(c)(3) shall apply.")
rule TobaccoReceiptsTestAmountTwelveMonths(p: Person, net: Money, m: Integer) strict {
    when tobacco_net_group_receipts(p, net) and tobacco_receipts_short_period_months(p, m) and m >= 12;
    then tobacco_receipts_test_amount(p, net);
}

// =====================================================================
// Section 5733(b)-(d): pursuits, places, succession and relocation
// =====================================================================

pub entity TobaccoLocation;
pub enum TobaccoSuccessorClass { SurvivingSpouseChildOrRepresentative; SpouseSucceedingToLivingSpouse; ReceiverTrusteeOrAssignee; RemainingPartner; }

pub relation tobacco_pursuit_at_location(p: Person, loc: TobaccoLocation, kind: TobaccoBusinessKind) kind empirical {
    label en unofficial "section 5733(b): the person carries on this pursuit or occupation of the subchapter in the same place at the same time as other pursuits";
}
pub relation tobacco_special_taxes_at_location(p: Person, loc: TobaccoLocation, taxes: Integer, total: Money) kind institutional {
    label en official "section 5733(b): the tax is paid for each pursuit at the place at the rate severally prescribed: the number of special taxes and their total";
}
@source(IRC_S5733_B, relation = formalizes, coverage = exact, quote = "the tax shall be paid for each according to the rates severally prescribed")
rule TobaccoSpecialTaxPerPursuitAtLocation(p: Person, loc: TobaccoLocation, rate: Money, first: TobaccoBusinessKind) strict {
    when tobacco_pursuit_at_location(p, loc, first) and tobacco_occupational_rate(p, rate);
    then tobacco_special_taxes_at_location(p, loc, count(collect k: TobaccoBusinessKind where tobacco_pursuit_at_location(p, loc, k)), rate * count(collect k2: TobaccoBusinessKind where tobacco_pursuit_at_location(p, loc, k2)));
}

pub relation tobacco_location_proprietor(loc: TobaccoLocation, p: Person) kind empirical {
    label en unofficial "section 5733(c)(3): the person under whose proprietorship the office, plant or area is conducted";
}
pub relation tobacco_locations_contiguous(a: TobaccoLocation, b: TobaccoLocation) kind empirical {
    label en unofficial "section 5733(c)(3): two divisions are otherwise contiguous although separated by passageways, streets, highways, rail crossings, waterways, or partitions";
}
pub relation tobacco_same_place(a: TobaccoLocation, b: TobaccoLocation) kind institutional {
    label en official "section 5733(c)(3): the two divisions are one place: contiguous and under the same proprietorship (separation by a passageway, street, highway, rail crossing, waterway or partition is not sufficient separation)";
}
@source(IRC_S5733_C, relation = formalizes, coverage = exact, quote = "The term \"place\" as used in this section means the entire office, plant or area of the business in any one location under the same proprietorship; and passageways, streets, highways, rail crossings, waterways, or partitions dividing the premises, shall not be deemed sufficient separation to require additional special tax, if the various divisions are otherwise contiguous.")
rule TobaccoSamePlaceForward(a: TobaccoLocation, b: TobaccoLocation, p: Person) strict {
    when tobacco_locations_contiguous(a, b) and tobacco_location_proprietor(a, p) and tobacco_location_proprietor(b, p);
    then tobacco_same_place(a, b);
}
@source(IRC_S5733_C, relation = formalizes, coverage = exact, quote = "The term \"place\" as used in this section means the entire office, plant or area of the business in any one location under the same proprietorship; and passageways, streets, highways, rail crossings, waterways, or partitions dividing the premises, shall not be deemed sufficient separation to require additional special tax, if the various divisions are otherwise contiguous.")
rule TobaccoSamePlaceBackward(a: TobaccoLocation, b: TobaccoLocation, p: Person) strict {
    when tobacco_locations_contiguous(a, b) and tobacco_location_proprietor(a, p) and tobacco_location_proprietor(b, p);
    then tobacco_same_place(b, a);
}
pub relation tobacco_registered_location(p: Person, loc: TobaccoLocation) kind empirical {
    label en unofficial "section 5733(c)(1): the place stated in the register kept in the office of the official in charge of the internal revenue district";
}
pub relation tobacco_business_carried_on_at(p: Person, loc: TobaccoLocation) kind empirical {
    label en unofficial "section 5733(c)(1): the person carries on a trade or business of the subchapter at this location";
}
pub relation tobacco_location_used_only_for_storage(loc: TobaccoLocation) kind empirical {
    label en unofficial "section 5733(c)(2): the location is used for the storage of tobacco products and cigarette papers and tubes and is not the place where they are sold or offered for sale";
}
pub relation tobacco_place_registered(p: Person, loc: TobaccoLocation) kind institutional {
    label en official "section 5733(c): the location is the registered place or part of the same place as a registered location";
}
rule TobaccoPlaceRegisteredDirect(p: Person, loc: TobaccoLocation) strict {
    when tobacco_registered_location(p, loc);
    then tobacco_place_registered(p, loc);
}
rule TobaccoPlaceRegisteredSamePlace(p: Person, loc: TobaccoLocation, r: TobaccoLocation) strict {
    when tobacco_registered_location(p, r) and tobacco_same_place(r, loc);
    then tobacco_place_registered(p, loc);
}
pub relation tobacco_additional_special_tax_required(p: Person, loc: TobaccoLocation, amount: Money) kind institutional {
    label en official "section 5733(c)(1): the payment of a special tax does not exempt the person from an additional special tax for a business carried on in another place than the registered one; storage-only locations excepted by (c)(2)";
}
@source(IRC_S5733_C, relation = formalizes, coverage = exact, quote = "The payment of a special tax imposed by this subchapter shall not exempt from an additional special tax the person carrying on a trade or business in any other place than that stated in the register kept in the office of the official in charge of the internal revenue district.")
rule TobaccoAdditionalSpecialTaxForOtherPlace(p: Person, loc: TobaccoLocation, rate: Money) strict {
    when tobacco_business_carried_on_at(p, loc)
        and tobacco_occupational_rate(p, rate)
        and not_known(tobacco_place_registered(p, loc))
        and not_known(tobacco_location_used_only_for_storage(loc));
    then tobacco_additional_special_tax_required(p, loc, rate);
}
@source(IRC_S5733_C, relation = formalizes, coverage = exact, quote = "Nothing contained in paragraph (1) shall require a special tax for the storage of tobacco products and cigarette papers and tubes at a location other than the place where tobacco products and cigarette papers and tubes are sold or offered for sale.")
rule TobaccoAdditionalSpecialTaxDuty(p: Person, loc: TobaccoLocation, rate: Money) defeasible {
    when tobacco_additional_special_tax_required(p, loc, rate);
    then duty PayAdditionalTobaccoSpecialTax {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition tobacco_additional_special_tax_paid(p, loc);
            window [-infinity, infinity];
        }
    };
}
pub relation tobacco_additional_special_tax_paid(p: Person, loc: TobaccoLocation) kind empirical {
    label en unofficial "the additional special tax for this location has in fact been paid";
}

pub relation tobacco_special_tax_paid_for_location(p: Person, loc: TobaccoLocation, period_end: Date) kind empirical {
    label en unofficial "section 5733(d): the person paid the special tax for the business at this place for the taxable period ending on period_end";
}
pub relation tobacco_successor_to_business(succ: Person, prior: Person, loc: TobaccoLocation, cls: TobaccoSuccessorClass) kind empirical {
    label en unofficial "section 5733(d)(1)-(4): the person is, in the stated class, the successor of the person who paid the special tax for the business at this place";
}
pub relation tobacco_relocation(p: Person, old_loc: TobaccoLocation, new_loc: TobaccoLocation) kind empirical {
    label en unofficial "section 5733(d): the person moved the business from the old place (for which the special tax was paid) to the new place";
}
pub relation tobacco_succession_registration_made(succ: Person, loc: TobaccoLocation) kind empirical {
    label en unofficial "section 5733(d): the successor registered the succession with the Secretary in accordance with regulations";
}
pub relation tobacco_relocation_registration_made(p: Person, new_loc: TobaccoLocation) kind empirical {
    label en unofficial "section 5733(d): the person registered the relocation with the Secretary in accordance with regulations";
}
pub relation tobacco_successor_class_eligible(succ: Person, prior: Person) kind institutional {
    label en official "section 5733(d)(1)-(4): the person is in one of the four classes that may secure the right to carry on the business without incurring additional special tax";
}
@source(IRC_S5733_D, relation = formalizes, coverage = exact, quote = "(1) the surviving spouse or child, or executor or administrator or other legal representative, of a deceased taxpayer;")
rule TobaccoSuccessorSurvivingSpouseOrRepresentative(succ: Person, prior: Person, loc: TobaccoLocation) strict {
    when tobacco_successor_to_business(succ, prior, loc, SurvivingSpouseChildOrRepresentative);
    then tobacco_successor_class_eligible(succ, prior);
}
@source(IRC_S5733_D, relation = formalizes, coverage = exact, quote = "(2) a husband or wife succeeding to the business of his or her living spouse;")
rule TobaccoSuccessorLivingSpouse(succ: Person, prior: Person, loc: TobaccoLocation) strict {
    when tobacco_successor_to_business(succ, prior, loc, SpouseSucceedingToLivingSpouse);
    then tobacco_successor_class_eligible(succ, prior);
}
@source(IRC_S5733_D, relation = formalizes, coverage = exact, quote = "(3) a receiver or trustee in bankruptcy, or an assignee for benefit of creditors; and")
rule TobaccoSuccessorReceiverTrusteeAssignee(succ: Person, prior: Person, loc: TobaccoLocation) strict {
    when tobacco_successor_to_business(succ, prior, loc, ReceiverTrusteeOrAssignee);
    then tobacco_successor_class_eligible(succ, prior);
}
@source(IRC_S5733_D, relation = formalizes, coverage = exact, quote = "(4) the partner or partners remaining after death or withdrawal of a member of a partnership.")
rule TobaccoSuccessorRemainingPartner(succ: Person, prior: Person, loc: TobaccoLocation) strict {
    when tobacco_successor_to_business(succ, prior, loc, RemainingPartner);
    then tobacco_successor_class_eligible(succ, prior);
}
pub relation tobacco_may_continue_without_additional_tax(p: Person, loc: TobaccoLocation, until: Date) kind institutional {
    label en official "section 5733(d): the person has the right to carry on the same business at the place without incurring additional special tax for the remainder of the taxable period for which the special tax was paid";
}
@source(IRC_S5733_D, relation = formalizes, coverage = exact, quote = "may secure the right to carry on, without incurring additional special tax, the same business at the same place for the remainder of the taxable period for which the special tax was paid.")
rule TobaccoSuccessionRightPower(succ: Person, prior: Person, loc: TobaccoLocation, cls: TobaccoSuccessorClass, end: Date) defeasible {
    when tobacco_successor_to_business(succ, prior, loc, cls) and tobacco_special_tax_paid_for_location(prior, loc, end);
    then power SecureTobaccoSuccessionRight {
        holder succ;
        over loc;
        exercise tobacco_succession_registration_made(succ, loc);
        valid_when tobacco_successor_class_eligible(succ, prior);
        effect tobacco_may_continue_without_additional_tax(succ, loc, end);
        window [-infinity, infinity];
    };
}
pub relation tobacco_relocated_business(p: Person, new_loc: TobaccoLocation) kind institutional {
    label en official "section 5733(d): the person moved the business from a place for which special tax was paid to this new place";
}
rule TobaccoRelocatedBusiness(p: Person, old_loc: TobaccoLocation, new_loc: TobaccoLocation) strict {
    when tobacco_relocation(p, old_loc, new_loc);
    then tobacco_relocated_business(p, new_loc);
}
@source(IRC_S5733_D, relation = formalizes, coverage = exact, quote = "When any person moves to any place other than the place for which special tax was paid for the carrying on of any business, he may secure the right to carry on, without incurring additional special tax, the same business at his new location for the remainder of the taxable period for which the special tax was paid.")
rule TobaccoRelocationRightPower(p: Person, old_loc: TobaccoLocation, new_loc: TobaccoLocation, end: Date) defeasible {
    when tobacco_relocation(p, old_loc, new_loc) and tobacco_special_tax_paid_for_location(p, old_loc, end);
    then power SecureTobaccoRelocationRight {
        holder p;
        over new_loc;
        exercise tobacco_relocation_registration_made(p, new_loc);
        valid_when tobacco_relocated_business(p, new_loc);
        effect tobacco_may_continue_without_additional_tax(p, new_loc, end);
        window [-infinity, infinity];
    };
}
