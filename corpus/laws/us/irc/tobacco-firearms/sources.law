// 26 U.S.C. 5851(a) — Special (occupational) tax exemption
fragment IRC_S5851_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/5851/a";
    text en official """(a) Business with United States
Any person required to pay special (occupational) tax under section 5801 shall be relieved from payment of that tax if he establishes to the satisfaction of the Secretary that his business is conducted exclusively with, or on behalf of, the United States or any department, independent establishment, or agency thereof. The Secretary may relieve any person manufacturing firearms for, or on behalf of, the United States from compliance with any provision of this chapter in the conduct of such business.""";
    content_hash "sha256:8a029882493796e84eaf2b4a7be620104265a340014b6289538602376c01e3bb";
}

// 26 U.S.C. 5851(b) — Special (occupational) tax exemption
fragment IRC_S5851_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/5851/b";
    text en official """(b) Application
The exemption provided for in subsection (a) of this section may be obtained by filing with the Secretary an application on such form and containing such information as may by regulations be prescribed. The exemptions must thereafter be renewed on or before July 1 of each year. Approval of the application by the Secretary shall entitle the applicant to the exemptions stated on the approved application.""";
    content_hash "sha256:997960850050eb9e9c9bd1b275df4f0998515b6f8ff7ed91f856ac80320cdf5c";
}

// 26 U.S.C. §5851 — statutory note 5 (effectivedate-note)
fragment IRC_S5851_NOTE_5 in IRC_2024_EDITION {
    kind note;
    locator "section/5851/note/5";
    text en official """Effective Date
Section effective on first day of first month following October 1968, see section 207 of Pub. L. 90–618, set out as a note under section 5801 of this title.""";
    content_hash "sha256:2a2f40c24bde99db4c155c442135272de05939e98a7b31dbf15740bb87e0cf2f";
}

// 26 U.S.C. 5852(a) — General transfer and making tax exemption
fragment IRC_S5852_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/5852/a";
    text en official """(a) Transfer
Any firearm may be transferred to the United States or any department, independent establishment, or agency thereof, without payment of the transfer tax imposed by section 5811.""";
    content_hash "sha256:528e4d5a1caabc2102700a0f2f2c3a8979ed050867438ee23e2a884d6ff52cde";
}

// 26 U.S.C. 5852(b) — General transfer and making tax exemption
fragment IRC_S5852_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/5852/b";
    text en official """(b) Making by a person other than a qualified manufacturer
Any firearm may be made by, or on behalf of, the United States, or any department, independent establishment, or agency thereof, without payment of the making tax imposed by section 5821.""";
    content_hash "sha256:205758982a30bc7aa10875351642d77f200d44bceeeaf0384c5454e210185e2b";
}

// 26 U.S.C. 5852(c) — General transfer and making tax exemption
fragment IRC_S5852_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/5852/c";
    text en official """(c) Making by a qualified manufacturer
A manufacturer qualified under this chapter to engage in such business may make the type of firearm which he is qualified to manufacture without payment of the making tax imposed by section 5821.""";
    content_hash "sha256:cabb5d11f47c439c583746004fe50d9f9c79a4654085040341e8fc2411b2d9cc";
}

// 26 U.S.C. 5852(d) — General transfer and making tax exemption
fragment IRC_S5852_D in IRC_2024_EDITION {
    kind subsection;
    locator "section/5852/d";
    text en official """(d) Transfers between special (occupational) taxpayers
A firearm registered to a person qualified under this chapter to engage in business as an importer, manufacturer, or dealer may be transferred by that person without payment of the transfer tax imposed by section 5811 to any other person qualified under this chapter to manufacture, import, or deal in that type of firearm.""";
    content_hash "sha256:6556cea6b447146b3d24e394daa7617c4125dfdd20bf69ed650a29d61a61d61c";
}

// 26 U.S.C. 5852(e) — General transfer and making tax exemption
fragment IRC_S5852_E in IRC_2024_EDITION {
    kind subsection;
    locator "section/5852/e";
    text en official """(e) Unserviceable firearm
An unserviceable firearm may be transferred as a curio or ornament without payment of the transfer tax imposed by section 5811, under such requirements as the Secretary may by regulations prescribe.""";
    content_hash "sha256:e94df9173ae0090e1b3f3ea7f78398dfc326a0c4afdf2de2773a450eb559e3d2";
}

// 26 U.S.C. 5852(f) — General transfer and making tax exemption
fragment IRC_S5852_F in IRC_2024_EDITION {
    kind subsection;
    locator "section/5852/f";
    text en official """(f) Right to exemption
No firearm may be transferred or made exempt from tax under the provisions of this section unless the transfer or making is performed pursuant to an application in such form and manner as the Secretary may by regulations prescribe.""";
    content_hash "sha256:62e6571095ce9e5e2fa259a5f78f7383a5544cf317fcedc603aaf2bf644e29a3";
}

// 26 U.S.C. 5853(a) — Transfer and making tax exemption available to certain governmental entities
fragment IRC_S5853_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/5853/a";
    text en official """(a) Transfer
A firearm may be transferred without the payment of the transfer tax imposed by section 5811 to any State, possession of the United States, any political subdivision thereof, or any official police organization of such a government entity engaged in criminal investigations.""";
    content_hash "sha256:39aba68483bd2d5c8a9bb63595942175fe152f358fffa8a7c7c15960d53b7fe5";
}

// 26 U.S.C. 5853(b) — Transfer and making tax exemption available to certain governmental entities
fragment IRC_S5853_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/5853/b";
    text en official """(b) Making
A firearm may be made without payment of the making tax imposed by section 5821 by, or on behalf of, any State, or possession of the United States, any political subdivision thereof, or any official police organization of such a government entity engaged in criminal investigations.""";
    content_hash "sha256:47ae84184889162cfa9eadb76b530b2e375337a93b77a23d0c1590f0b66cd365";
}

// 26 U.S.C. 5853(c) — Transfer and making tax exemption available to certain governmental entities
fragment IRC_S5853_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/5853/c";
    text en official """(c) Right to exemption
No firearm may be transferred or made exempt from tax under this section unless the transfer or making is performed pursuant to an application in such form and manner as the Secretary may by regulations prescribe.""";
    content_hash "sha256:79be2b4ae60bd098a194b5a491ffb1b262cbcdcc063221a6d73a4c1c09e2fedf";
}

// 26 U.S.C. §5854 — Exportation of firearms exempt from transfer tax
fragment IRC_S5854 in IRC_2024_EDITION {
    kind section;
    locator "section/5854";
    text en official """Exportation of firearms exempt from transfer tax
A firearm may be exported without payment of the transfer tax imposed under section 5811 provided that proof of the exportation is furnished in such form and manner as the Secretary may by regulations prescribe.""";
    content_hash "sha256:93c39d428d0ba277f5ef99a5f2fe9537bc92b4e68f7b568a98881bbdcf28d14f";
}

// structural heading: subchapter E/53/C
fragment IRC_HEAD_SUBCHAPTER_E_53_C in IRC_2024_EDITION {
