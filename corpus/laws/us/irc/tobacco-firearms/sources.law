    locator "section/5821/c";
    text en official """(c) Payment
The tax imposed by subsection (a) of this section shall be payable by the stamp prescribed for payment by the Secretary.""";
    content_hash "sha256:1cbecc554cbadab19a854afb1c7d5c16125a127ac9f4d2533f5562f6179af53a";
