// 26 U.S.C. §5752 — Restrictions relating to marks, labels, notices, and packages
fragment IRC_S5752 in IRC_2024_EDITION {
    kind section;
    locator "section/5752";
    text en official """Restrictions relating to marks, labels, notices, and packages
No person shall, with intent to defraud the United States, destroy, obliterate, or detach any mark, label, or notice prescribed or authorized, by this chapter or regulations thereunder, to appear on, or be affixed to, any package of tobacco products or cigarette papers or tubes, before such package is emptied.""";
    content_hash "sha256:98dcf14a0be1a5bb9527d5a00ec4379d8f1cd528eb472ccc1fb6e6a8b4ac5bfe";
}

// 26 U.S.C. §5752 — statutory note 4 (effectivedate-amendment-note)
