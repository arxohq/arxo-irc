// 26 U.S.C. 5821(a) — Making tax
fragment IRC_S5821_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/5821/a";
    text en official """(a) Rate
There shall be levied, collected, and paid upon the making of a firearm a tax at the rate of $200 for each firearm made.""";
    content_hash "sha256:44896499904066cda689c1c9daa0e011803b177c9af6883e1283e7b2aaaa9b27";
}

// 26 U.S.C. 5821(b) — Making tax
fragment IRC_S5821_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/5821/b";
    text en official """(b) By whom paid
The tax imposed by subsection (a) of this section shall be paid by the person making the firearm.""";
    content_hash "sha256:727905df206a5247ae5ccf55bbf590d41c2a21b78ffbe49e6c5f0ae6433452ea";
}

// 26 U.S.C. 5821(c) — Making tax
fragment IRC_S5821_C in IRC_2024_EDITION {
