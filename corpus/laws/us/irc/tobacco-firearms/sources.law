// 26 U.S.C. §5871 — Penalties
fragment IRC_S5871 in IRC_2024_EDITION {
    kind section;
    locator "section/5871";
    text en official """Penalties
Any person who violates or fails to comply with any provision of this chapter shall, upon conviction, be fined not more than $10,000, or be imprisoned not more than ten years, or both.""";
    content_hash "sha256:95e2041da4ae374220625857dba76fbd33c009158e006c316374adebdd6df528";
}

// 26 U.S.C. §5871 — statutory note 5 (effectivedate-amendment-note)
