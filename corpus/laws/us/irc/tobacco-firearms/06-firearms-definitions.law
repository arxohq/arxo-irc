// Chapter 53 (National Firearms Act), subchapter A part IV (definitions,
// section 5845) plus the chapter-scope provisions of sections 5846-5849.
// Priority section 5845, IRC-14 stage 1. Written first among the chapter 53
// modules because the tax-rate rules of section 5811/5821 (06-firearms-
// tax.law) read the barrel/overall-length classification declared here.

use self::{
    IRC_S5845,
    IRC_S5848_A,
    Person,
};

pub entity Firearm;

pub enum FirearmCategory {
    ShortBarreledShotgun;         // section 5845(a)(1)
    ShotgunMadeWeapon;            // section 5845(a)(2)
    ShortBarreledRifle;           // section 5845(a)(3)
    RifleMadeWeapon;              // section 5845(a)(4)
    AnyOtherWeapon;               // section 5845(a)(5), defined in (e)
    Machinegun;                   // section 5845(a)(6), defined in (b)
    Silencer;                     // section 5845(a)(7)
    DestructiveDevice;            // section 5845(a)(8), defined in (f)
}

// -- exact, length-based classifications (5845(a)(1)-(4)) ---------------

pub relation shotgun_barrel_length_inches(f: Firearm, inches: Decimal) kind empirical {
    label en unofficial "section 5845(a)(1): the barrel length, in inches, of a weapon that is a shotgun (section 5845(d))";
}
@source(IRC_S5845, relation = formalizes, coverage = exact, quote = "a shotgun having a barrel or barrels of less than 18 inches in length")
rule ShortBarreledShotgunClassification(f: Firearm, inches: Decimal) strict {
    when shotgun_barrel_length_inches(f, inches) and inches < 18.0;
    then firearm_category(f, ShortBarreledShotgun);
}

pub relation made_from_shotgun(f: Firearm) kind empirical {
    label en unofficial "section 5845(a)(2): this weapon was made from a shotgun";
}
pub relation shotgun_made_weapon_overall_length_inches(f: Firearm, inches: Decimal) kind empirical;
pub relation shotgun_made_weapon_barrel_length_inches(f: Firearm, inches: Decimal) kind empirical;
@source(IRC_S5845, relation = formalizes, coverage = exact, quote = "a weapon made from a shotgun if such weapon as modified has an overall length of less than 26 inches or a barrel or barrels of less than 18 inches in length")
rule ShotgunMadeWeaponByOverallLength(f: Firearm, inches: Decimal) strict {
    when made_from_shotgun(f) and shotgun_made_weapon_overall_length_inches(f, inches) and inches < 26.0;
    then firearm_category(f, ShotgunMadeWeapon);
}
@source(IRC_S5845, relation = formalizes, coverage = exact, quote = "a weapon made from a shotgun if such weapon as modified has an overall length of less than 26 inches or a barrel or barrels of less than 18 inches in length")
rule ShotgunMadeWeaponByBarrelLength(f: Firearm, inches: Decimal) strict {
    when made_from_shotgun(f) and shotgun_made_weapon_barrel_length_inches(f, inches) and inches < 18.0;
    then firearm_category(f, ShotgunMadeWeapon);
}

pub relation rifle_barrel_length_inches(f: Firearm, inches: Decimal) kind empirical {
    label en unofficial "section 5845(a)(3): the barrel length, in inches, of a weapon that is a rifle (section 5845(c))";
}
@source(IRC_S5845, relation = formalizes, coverage = exact, quote = "a rifle having a barrel or barrels of less than 16 inches in length")
rule ShortBarreledRifleClassification(f: Firearm, inches: Decimal) strict {
    when rifle_barrel_length_inches(f, inches) and inches < 16.0;
    then firearm_category(f, ShortBarreledRifle);
}

pub relation made_from_rifle(f: Firearm) kind empirical;
pub relation rifle_made_weapon_overall_length_inches(f: Firearm, inches: Decimal) kind empirical;
pub relation rifle_made_weapon_barrel_length_inches(f: Firearm, inches: Decimal) kind empirical;
@source(IRC_S5845, relation = formalizes, coverage = exact, quote = "a weapon made from a rifle if such weapon as modified has an overall length of less than 26 inches or a barrel or barrels of less than 16 inches in length")
rule RifleMadeWeaponByOverallLength(f: Firearm, inches: Decimal) strict {
    when made_from_rifle(f) and rifle_made_weapon_overall_length_inches(f, inches) and inches < 26.0;
    then firearm_category(f, RifleMadeWeapon);
}
@source(IRC_S5845, relation = formalizes, coverage = exact, quote = "a weapon made from a rifle if such weapon as modified has an overall length of less than 26 inches or a barrel or barrels of less than 16 inches in length")
rule RifleMadeWeaponByBarrelLength(f: Firearm, inches: Decimal) strict {
    when made_from_rifle(f) and rifle_made_weapon_barrel_length_inches(f, inches) and inches < 16.0;
    then firearm_category(f, RifleMadeWeapon);
}

// -- mechanism-based classifications (5845(a)(5)-(8), (b), (e), (f)) -----
// Not length-based; the statute's tests turn on function/design/capacity,
// which this package takes as case-asserted facts rather than derived
// (no mechanical/ballistic simulation in this language) -- an ordinary,
// bounded fact-finding scope, not a TECH_GAP.

pub relation any_other_weapon_qualifying_facts(f: Firearm) kind empirical {
    label en unofficial "section 5845(e): concealable weapon/device capable of discharging a shot through an explosive, or a smoothbore pistol/revolver for a fixed shotgun shell, or a 12-inch-to-under-18-inch combination shotgun/rifle barrel weapon firing a single discharge per barrel without reloading -- and NOT a rifled-bore pistol/revolver and NOT a shoulder-fired weapon incapable of firing fixed ammunition (both exclusions folded into this single asserted classification fact)";
}
rule AnyOtherWeaponClassification(f: Firearm) strict {
    when any_other_weapon_qualifying_facts(f);
    then firearm_category(f, AnyOtherWeapon);
}
pub relation machinegun_qualifying_facts(f: Firearm) kind empirical {
    label en unofficial "section 5845(b): shoots, is designed to shoot, or can be readily restored to shoot automatically more than one shot without manual reloading by a single trigger function -- includes a frame/receiver, conversion part(s), or a possessed/controlled combination of parts from which one can be assembled";
}
rule MachinegunClassification(f: Firearm) strict {
    when machinegun_qualifying_facts(f);
    then firearm_category(f, Machinegun);
}
pub relation silencer_under_18usc921(f: Firearm) kind empirical {
    label en unofficial "section 5845(a)(7): a silencer as defined in 18 U.S.C. 921 -- imported by reference to a Title 18 definition this package does not itself formalize";
}
rule SilencerClassification(f: Firearm) strict {
    when silencer_under_18usc921(f);
    then firearm_category(f, Silencer);
}
pub relation destructive_device_qualifying_facts(f: Firearm) kind empirical {
    label en unofficial "section 5845(f)(1)-(2): an explosive/incendiary/poison-gas bomb, grenade, rocket (>4 oz propellant), missile (>1/4 oz explosive/incendiary charge), mine, or similar device; or any weapon expelling a projectile by an explosive/propellant with a bore over one-half inch (except a sporting shotgun/shell); or convertible combinations of parts for either";
}
pub relation destructive_device_excluded(f: Firearm) kind empirical {
    label en unofficial "section 5845(f) last sentence: neither designed/redesigned as a weapon, or redesigned for signaling/pyrotechnic/line-throwing/safety use, or Secretary-designated surplus Army ordnance, or a device the Secretary finds not likely to be used as a weapon/is an antique/is a sporting rifle -- any one of which takes the device OUT of 'destructive device' even if the (f)(1)-(2) facts are present";
}
rule DestructiveDeviceClassification(f: Firearm) strict {
    when destructive_device_qualifying_facts(f) and not_known(destructive_device_excluded(f));
    then firearm_category(f, DestructiveDevice);
}

// -- the (a) closing exclusion: antique firearms and Secretary-found
// collector's items (other than machinegun/destructive device) are not
// "firearm" at all for chapter 53 purposes -----------------------------

pub relation antique_firearm(f: Firearm) kind empirical {
    label en unofficial "section 5845(g): not designed/redesigned for rimfire or conventional centerfire ignition with fixed ammunition, manufactured in or before 1898 (or using fixed ammunition manufactured in or before 1898 for which ammunition is no longer manufactured in the US and not readily available commercially)";
}
external judgment relation secretary_finds_primarily_collectors_item(f: Firearm) {
    authority Secretary;
    label en official "the Secretary finds, by reason of the date of manufacture, value, design, and other characteristics, that the device is primarily a collector's item and not likely to be used as a weapon (section 5845(a) last sentence)";
}
pub relation firearm_category(f: Firearm, category: FirearmCategory) kind institutional {
    label en official "section 5845(a): the firearm falls within this category (a weapon may fall within more than one)";
}
pub relation is_chapter53_firearm(f: Firearm) kind institutional {
    label en official "section 5845(a): the device is a 'firearm' for chapter 53 purposes -- at least one category applies, it is not an antique firearm, and (for a non-machinegun/non-destructive-device category) the Secretary has not found it primarily a collector's item not likely to be used as a weapon";
}
@source(IRC_S5845, relation = formalizes, coverage = exact, quote = "The term \"firearm\" shall not include an antique firearm or any device (other than a machinegun or destructive device) which, although designed as a weapon, the Secretary finds by reason of the date of its manufacture, value, design, and other characteristics is primarily a collector's item and is not likely to be used as a weapon.")
rule IsChapter53FirearmMachinegunOrDestructiveDevice(f: Firearm) strict {
    when firearm_category(f, Machinegun) and not antique_firearm(f);
    then is_chapter53_firearm(f);
}
rule IsChapter53FirearmMachinegunOrDestructiveDevice2(f: Firearm) strict {
    when firearm_category(f, DestructiveDevice) and not antique_firearm(f);
    then is_chapter53_firearm(f);
}
rule IsChapter53FirearmOtherCategory(f: Firearm, cat: FirearmCategory) defeasible {
    when firearm_category(f, cat)
        and cat != Machinegun and cat != DestructiveDevice
        and not antique_firearm(f);
    then is_chapter53_firearm(f);
    unless secretary_finds_primarily_collectors_item(f);
}

pub relation unserviceable_firearm(f: Firearm) kind empirical {
    label en official "section 5845(h): incapable of discharging a shot by means of an explosive and incapable of being readily restored to a firing condition";
}
pub relation firearm_make_event(f: Firearm, maker: Person) kind empirical {
    label en unofficial "section 5845(i): manufacturing (other than by a chapter-53-qualified manufacturer), putting together, altering, or otherwise producing a firearm";
}
pub relation firearm_transfer_conduct(f: Firearm, transferor: Person, transferee: Person) kind empirical {
    label en unofficial "section 5845(j): selling, assigning, pledging, leasing, loaning, giving away, or otherwise disposing of a firearm";
}
pub enum FirearmTradeRole { Dealer; Importer; Manufacturer; }
pub relation firearm_trade_person(p: Person, trole: FirearmTradeRole) kind empirical {
    label en unofficial "section 5845(k)-(m): a dealer (selling/renting/leasing/loaning firearms, including a pawnbroker taking firearms as loan collateral), an importer (business of importing/bringing firearms into the United States), or a manufacturer (business of manufacturing firearms)";
}

// =====================================================================
// Sections 5846-5849 — chapter-scope provisions
// =====================================================================

// section 5846: cross-reference extending chapter-51-style special-tax
// stamp administration to sections 5801/5811/5821 -- administrative
// machinery, not a separate norm; classified NON_NORMATIVE.
// section 5847: savings clause preserving Arms Export Control Act
// licensing requirements -- classified NON_NORMATIVE (rule of construction).

pub relation firearm_nfa_application_or_registration_filed(p: Person) kind empirical {
    label en unofficial "this natural person filed (or had compiled) an application, registration, or record required by chapter 53 or its regulations";
}
pub relation firearm_registration_used_as_evidence(p: Person) kind empirical {
    label en unofficial "the protected act: using the chapter-53 application/registration/record information as evidence against this person for a prior-or-concurrent violation";
}
pub relation firearm_furnished_false_information(p: Person) kind empirical {
    label en unofficial "section 5848(b): this person furnished false information in the application/registration/record";
}
@source(IRC_S5848_A, relation = formalizes, coverage = exact, quote = "No information or evidence obtained from an application, registration, or records required to be submitted or retained by a natural person in order to comply with any provision of this chapter or regulations issued thereunder, shall, except as provided in subsection (b) of this section, be used, directly or indirectly, as evidence against that person in a criminal proceeding with respect to a violation of law occurring prior to or concurrently with the filing of the application or registration, or the compiling of the records containing the information or evidence.")
rule FirearmInformationImmunity(p: Person) defeasible {
    when firearm_nfa_application_or_registration_filed(p);
    then immunity FirearmRegistrationUseImmunity {
        holder p;
        protected_effect firearm_registration_used_as_evidence(p);
        window [-infinity, infinity];
    };
    unless firearm_furnished_false_information(p);
}

// section 5849: citation clause ("National Firearms Act") -- NON_NORMATIVE.
