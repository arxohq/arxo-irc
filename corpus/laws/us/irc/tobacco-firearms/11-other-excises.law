// Chapter 54 (section 5881: greenmail) and chapter 55 (section 5891:
// structured settlement factoring transactions) -- the remainder of
// Subtitle E this package owns per its own header ("Subtitle E except
// chapter 51"), outside the tobacco/firearms core but sharing the same
// excise-on-an-event method.

// =====================================================================
// Section 5881 — greenmail
// =====================================================================

use self::{
    IRC_S5881_A,
    IRC_S5881_B,
    IRC_S5891_A,
    IRC_S5891_B,
    IRC_S5891_C,
    Person,
    greenmail_total_income,
    structured_settlement_excluded_from_factoring,
};

pub entity GreenmailReceiptEvent : ExciseEvent;
pub relation greenmail_receipt(e: GreenmailReceiptEvent, recipient: Person, gain_or_income: Money) kind empirical {
    label en unofficial "section 5881(a)/(d): the gain or other income a shareholder realizes (or would realize, whether or not actually recognized) by reason of receiving greenmail consideration";
}
pub relation greenmail_stock_held_under_two_years(e: GreenmailReceiptEvent) kind empirical {
    label en unofficial "section 5881(b)(1): the shareholder held the stock (section 1223) for less than 2 years before entering into the transfer agreement";
}
pub relation greenmail_tender_offer_threat_in_window(e: GreenmailReceiptEvent) kind empirical {
    label en unofficial "section 5881(b)(2): at some point during the 2-year period ending on the acquisition date, the shareholder (or a person acting in concert with, or related to, the shareholder) made or threatened to make a public tender offer for the corporation's stock";
}
pub relation greenmail_offer_not_uniform(e: GreenmailReceiptEvent) kind empirical {
    label en unofficial "section 5881(b)(3): the acquisition is pursuant to an offer not made on the same terms to all shareholders";
}
pub relation greenmail_qualifying_transaction(e: GreenmailReceiptEvent) kind institutional {
    label en official "section 5881(b): the consideration transferred qualifies as 'greenmail' -- all three (b)(1)-(3) conditions are met";
}
@source(IRC_S5881_B, relation = formalizes, coverage = partial, quote = "any consideration transferred by a corporation (or any person acting in concert with such corporation) to directly or indirectly acquire stock of such corporation from any shareholder if")
rule GreenmailQualifyingTransaction(e: GreenmailReceiptEvent) strict {
    when greenmail_stock_held_under_two_years(e)
        and greenmail_tender_offer_threat_in_window(e)
        and greenmail_offer_not_uniform(e);
    then greenmail_qualifying_transaction(e);
}
@source(IRC_S5881_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on any person who receives greenmail a tax equal to 50 percent of gain or other income of such person by reason of such receipt.")
rule GreenmailTax(e: GreenmailReceiptEvent, recipient: Person, amount: Money) strict {
    when greenmail_receipt(e, recipient, _) and greenmail_total_income(e, amount) and greenmail_qualifying_transaction(e);
    then us.irc.excise_goods::excise_tax_due(e, round(amount * 0.50, 2, "HALF_UP"));
}
@source(IRC_S5881_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on any person who receives greenmail a tax equal to 50 percent of gain or other income of such person by reason of such receipt.")
rule GreenmailLiability(e: GreenmailReceiptEvent, recipient: Person, tax: Money) strict {
    when greenmail_receipt(e, recipient, _) and us.irc.excise_goods::excise_tax_due(e, tax);
    then us.irc.excise_goods::liable_for_excise(recipient, e, tax);
}
// section 5881(d) ("whether or not amount recognized") is already reflected
// above: `greenmail_receipt`'s `gain_or_income` argument is asserted
// independent of a separate income-tax recognition event. Section 5881(e)
// (subtitle-A deficiency procedures apply) is administrative machinery;
// classified NON_NORMATIVE in the coverage row.

// =====================================================================
// Section 5891 — structured settlement factoring transactions
// =====================================================================

pub entity StructuredSettlementFactoringEvent : ExciseEvent;
pub relation structured_settlement_factoring_transaction(e: StructuredSettlementFactoringEvent, acquirer: Person, aggregate_payments_acquired: Money, amount_paid: Money) kind empirical {
    label en unofficial "section 5891(a)/(c)(3)-(4): a transfer of structured settlement payment rights made for consideration (sale, assignment, pledge, or other encumbrance/alienation), with the aggregate undiscounted amount of payments acquired and the total amount actually paid by the acquirer";
}
pub relation structured_settlement_qualified_order_approval(e: StructuredSettlementFactoringEvent) kind empirical {
    label en unofficial "section 5891(b)(1)-(2): the transfer is approved in advance by a qualified order (a final order/judgment/decree finding the transfer lawful and in the payee's best interest, issued by the applicable State court or responsible administrative authority)";
}
pub relation structured_settlement_factoring_discount(e: StructuredSettlementFactoringEvent, discount: Money) kind institutional {
    label en official "section 5891(c)(4): the aggregate undiscounted amount of payments acquired, less the total amount actually paid by the acquirer";
}
@source(IRC_S5891_C, relation = formalizes, coverage = partial, quote = "The term \"factoring discount\" means an amount equal to the excess of")
rule StructuredSettlementFactoringDiscount(e: StructuredSettlementFactoringEvent, acquired: Money, paid: Money) strict {
    when structured_settlement_factoring_transaction(e, _, acquired, paid) and not_known(structured_settlement_excluded_from_factoring(e));
    then structured_settlement_factoring_discount(e, acquired - paid);
}
@source(IRC_S5891_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on any person who acquires directly or indirectly structured settlement payment rights in a structured settlement factoring transaction a tax equal to 40 percent of the factoring discount as determined under subsection (c)(4) with respect to such factoring transaction.")
rule StructuredSettlementFactoringTax(e: StructuredSettlementFactoringEvent, discount: Money) strict {
    when structured_settlement_factoring_discount(e, discount) and not_known(structured_settlement_qualified_order_approval(e));
    then us.irc.excise_goods::excise_tax_due(e, round(discount * 0.40, 2, "HALF_UP"));
}
@source(IRC_S5891_B, relation = formalizes, coverage = exact, quote = "The tax under subsection (a) shall not apply in the case of a structured settlement factoring transaction in which the transfer of structured settlement payment rights is approved in advance in a qualified order.")
rule StructuredSettlementQualifiedOrderExempt(e: StructuredSettlementFactoringEvent) strict {
    when structured_settlement_qualified_order_approval(e);
    then us.irc.excise_goods::tax_free_sale(e);
}
@source(IRC_S5891_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on any person who acquires directly or indirectly structured settlement payment rights in a structured settlement factoring transaction a tax equal to 40 percent of the factoring discount")
rule StructuredSettlementFactoringLiability(e: StructuredSettlementFactoringEvent, acquirer: Person, tax: Money) strict {
    when structured_settlement_factoring_transaction(e, acquirer, _, _) and us.irc.excise_goods::excise_tax_due(e, tax);
    then us.irc.excise_goods::liable_for_excise(acquirer, e, tax);
}
// section 5891(c)(1)-(2),(5)-(6) (definitions: structured settlement,
// structured settlement payment rights, responsible administrative
// authority, State) and (d) (coordination with sections 72/104/130/461(h)
// and no section 3405 withholding) are cross-references/definitional
// scaffolding around the tax already computed above; classified
// NON_NORMATIVE/EXECUTABLE-by-cross-reference in the coverage rows rather
// than duplicated as separate positions.
