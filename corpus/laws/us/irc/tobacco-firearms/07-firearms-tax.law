// Chapter 53, subchapter A: section 5801 (special occupational tax),
// section 5802 (registration of importers/manufacturers/dealers), section
// 5811 (transfer tax), section 5812 (transfers), section 5821 (making tax),
// section 5822 (making). Priority sections 5801, 5811, 5812, 5821, IRC-14
// stage 1.
//
// PL 119-21 §70436 (enacted 2025-07-04) amends sections 5811(a) and 5821(a)
// to $0 for any firearm transferred/made that is NOT a machinegun or
// destructive device, "for calendar quarters beginning more than 90 days
// after the date of the enactment" -- 90 days after 2025-07-04 is
// 2025-10-02, and the next calendar quarter beginning after that date is
// 2026-01-01. JUDGMENT CALL (report this): modeled as a windowed
// `.lawparam.json` value transition on 2026-01-01 rather than a `revision`
// node, matching this stage's own G84 precedent (estate-gift package) for a
// flat-date rate change where the parameter dataset already gives the
// correct value on each side of the boundary and a `revision` would be
// redundant documentation. `@source(us.irc.temporal::PL119_21_S70436,
// relation = amends)` anchors both windowed parameters below.

// =====================================================================
// Section 5801 — special (occupational) tax
// =====================================================================

use self::{
    Firearm,
    FirearmCategory,
    FirearmTradeRole,
    IRC_S5801_A,
    IRC_S5801_B,
    IRC_S5802,
    IRC_S5811_A,
    IRC_S5811_B,
    IRC_S5812_A,
    IRC_S5812_B,
    IRC_S5821_A,
    IRC_S5821_B,
    IRC_S5822,
    Person,
    Secretary,
    firearm_category,
    firearm_receipts_test_amount,
    firearm_trade_person,
};

pub relation firearm_occupational_taxpayer(p: Person, trole: FirearmTradeRole, gross_receipts: Money) kind empirical {
    label en unofficial "section 5801(a): a person engaging in business (on first engaging, and thereafter on or before July 1 of each year) as an importer, manufacturer, or dealer in firearms, for each place of business, with the most-recent-prior-taxable-year gross receipts used for the (b) small-proprietor test";
}
pub relation firearm_occupational_rate(p: Person, rate: Money) kind institutional {
    label en official "section 5801(a)/(b): the annual per-place-of-business occupational tax rate";
}
@source(IRC_S5801_A, relation = formalizes, coverage = exact, quote = "Dealers: $500 a year or fraction thereof.")
rule FirearmOccupationalDealerRate(p: Person, gross: Money) strict {
    when firearm_occupational_taxpayer(p, Dealer, gross);
    then firearm_occupational_rate(p, S5801DealerRate);
}
@source(IRC_S5801_B, relation = formalizes, coverage = exact, quote = "Paragraph (1) of subsection (a) shall be applied by substituting \"$500\" for \"$1,000\" with respect to any taxpayer the gross receipts of which (for the most recent taxable year ending before the 1st day of the taxable period to which the tax imposed by subsection (a) relates) are less than $500,000.")
rule FirearmOccupationalReducedRate(p: Person, trole: FirearmTradeRole, gross: Money) strict {
    when firearm_occupational_taxpayer(p, trole, _)
        and firearm_receipts_test_amount(p, gross)
        and (trole == Importer or trole == Manufacturer)
        and gross < S5801SmallProprietorThreshold;
    then firearm_occupational_rate(p, S5801ReducedRate);
}
@source(IRC_S5801_A, relation = formalizes, coverage = exact, quote = "Importers and manufacturers: $1,000 a year or fraction thereof.")
rule FirearmOccupationalGeneralRate(p: Person, trole: FirearmTradeRole, gross: Money) strict {
    when firearm_occupational_taxpayer(p, trole, _)
        and firearm_receipts_test_amount(p, gross)
        and (trole == Importer or trole == Manufacturer)
        and gross >= S5801SmallProprietorThreshold;
    then firearm_occupational_rate(p, S5801ImporterManufacturerRate);
}

// =====================================================================
// Section 5802 — registration of importers, manufacturers, and dealers
// =====================================================================

@source(IRC_S5802, relation = formalizes, coverage = exact, quote = "On first engaging in business and thereafter on or before the first day of July of each year, each importer, manufacturer, and dealer in firearms shall register with the Secretary in each internal revenue district in which such business is to be carried on, his name, including any trade name, and the address of each location in the district where he will conduct such business.")
rule FirearmDealerRegistrationDuty(p: Person, trole: FirearmTradeRole) defeasible {
    when firearm_trade_person(p, trole);
    then duty RegisterFirearmBusiness {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition firearm_business_registration_current(p);
            window [-infinity, infinity];
        }
    };
}
pub relation firearm_business_registration_current(p: Person) kind empirical {
    label en unofficial "the case asserts this person's section 5802 registration (name, trade name, and each place-of-business address, plus the individual applicant's photograph/fingerprints) is current";
}
pub relation firearm_business_relocation_or_trade_name_change(p: Person) kind empirical {
    label en unofficial "section 5802: a change during the taxable year in the location of, or trade name used in, the business";
}
@source(IRC_S5802, relation = formalizes, coverage = exact, quote = "Firearms operations of an importer, manufacturer, or dealer may not be commenced at the new location or under a new trade name prior to approval by the Secretary of the application.")
rule FirearmNoOperatingAtNewLocationWithoutApproval(p: Person) defeasible {
    when firearm_business_relocation_or_trade_name_change(p);
    then prohibition NoOperatingAtNewLocationWithoutApproval {
        bearer p;
        beneficiary Secretary;
        action firearm_business_operated_at_unapproved_new_location(p);
        window [-infinity, infinity];
    };
    unless firearm_relocation_application_approved(p);
}
pub relation firearm_relocation_application_approved(p: Person) kind empirical;
pub relation firearm_business_operated_at_unapproved_new_location(p: Person) kind empirical;

// =====================================================================
// Section 5811 — transfer tax
// =====================================================================

pub entity FirearmTransferEvent : ExciseEvent;
pub relation firearm_transfer_event(e: FirearmTransferEvent, f: Firearm, transferor: Person, transferee: Person, on: Date) kind empirical {
    label en unofficial "section 5811/5812: the transfer of a chapter-53 firearm on the given date, by the transferor and to the transferee named in the transfer application";
}

@source(IRC_S5811_A, relation = formalizes, coverage = exact, quote = "There shall be levied, collected, and paid on firearms transferred a tax at the rate of $200 for each firearm transferred, except, the transfer tax on any firearm classified as any other weapon under section 5845(e) shall be at the rate of $5 for each such firearm transferred.")
rule FirearmTransferTaxAow(e: FirearmTransferEvent, f: Firearm, on: Date) strict {
    when firearm_transfer_event(e, f, _, _, on)
        and firearm_category(f, AnyOtherWeapon)
        and not_known(firearm_category(f, Machinegun)) and not_known(firearm_category(f, DestructiveDevice))
        and on < @2026-01-01;
    then us.irc.excise_goods::excise_tax_due(e, S5811AowRate);
}
@source(us.irc.temporal::PL119_21_S70436, relation = derives_from, coverage = exact, quote = "$0 for any firearm transferred which is not described in paragraph (1)")
rule FirearmTransferTaxZeroedNonMachinegunNonDestructiveDevice(e: FirearmTransferEvent, f: Firearm, on: Date) strict {
    when firearm_transfer_event(e, f, _, _, on)
        and not_known(firearm_category(f, Machinegun)) and not_known(firearm_category(f, DestructiveDevice))
        and on >= @2026-01-01;
    then us.irc.excise_goods::excise_tax_due(e, 0.00 USD);
}
@source(IRC_S5811_A, relation = formalizes, coverage = exact, quote = "There shall be levied, collected, and paid on firearms transferred a tax at the rate of $200 for each firearm transferred")
rule FirearmTransferTaxStandard(e: FirearmTransferEvent, f: Firearm, on: Date) strict {
    when firearm_transfer_event(e, f, _, _, on)
        and not_known(firearm_category(f, AnyOtherWeapon))
        and not_known(firearm_category(f, Machinegun)) and not_known(firearm_category(f, DestructiveDevice))
        and on < @2026-01-01;
    then us.irc.excise_goods::excise_tax_due(e, S5811StandardRate);
}
@source(us.irc.temporal::PL119_21_S70436, relation = derives_from, coverage = exact, quote = "$200 for each firearm transferred in the case of a machinegun or a destructive device")
rule FirearmTransferTaxMachinegunOrDestructiveDevice(e: FirearmTransferEvent, f: Firearm) strict {
    when firearm_transfer_event(e, f, _, _, _)
        and (firearm_category(f, Machinegun) or firearm_category(f, DestructiveDevice));
    then us.irc.excise_goods::excise_tax_due(e, S5811StandardRate);
}

@source(IRC_S5811_B, relation = formalizes, coverage = exact, quote = "The tax imposed by subsection (a) of this section shall be paid by the transferor.")
rule FirearmTransferTaxLiability(e: FirearmTransferEvent, transferor: Person, amount: Money) defeasible {
    when firearm_transfer_event(e, _, transferor, _, _) and us.irc.excise_goods::excise_tax_due(e, amount);
    then us.irc.excise_goods::liable_for_excise(transferor, e, amount);
}

// =====================================================================
// Section 5812 — transfers
// =====================================================================

pub relation firearm_transfer_application_filed(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5812(a)(1): the transferor filed a written application, in duplicate, for transfer and registration";
}
pub relation firearm_transfer_tax_stamp_affixed(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5812(a)(2): any tax payable on the transfer is paid, evidenced by the proper stamp affixed to the original application";
}
pub relation firearm_transferee_identified(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5812(a)(3): the transferee is identified as the Secretary's regulations prescribe (including fingerprints and photograph, if an individual)";
}
pub relation firearm_transferor_identified(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5812(a)(4): the transferor is identified as the Secretary's regulations prescribe";
}
pub relation firearm_identified_in_application(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5812(a)(5): the firearm is identified in the application as the Secretary's regulations prescribe";
}
pub relation firearm_transfer_would_violate_law(e: FirearmTransferEvent) kind empirical {
    label en unofficial "section 5812(a) last sentence: the transfer, receipt, or possession would place the transferee in violation of law -- an application meeting this ground must be denied";
}
pub relation firearm_transfer_application_complete(e: FirearmTransferEvent) kind institutional {
    label en official "section 5812(a)(1)-(5): the application is complete (filed, tax stamped, transferee/transferor/firearm all identified) and does not place the transferee in violation of law";
}
@source(IRC_S5812_A, relation = formalizes, coverage = exact, quote = "A firearm shall not be transferred unless (1) the transferor of the firearm has filed with the Secretary a written application, in duplicate, for the transfer and registration of the firearm to the transferee on the application form prescribed by the Secretary; (2) any tax payable on the transfer is paid as evidenced by the proper stamp affixed to the original application form; (3) the transferee is identified in the application form in such manner as the Secretary may by regulations prescribe, except that, if such person is an individual, the identification must include his fingerprints and his photograph; (4) the transferor of the firearm is identified in the application form in such manner as the Secretary may by regulations prescribe; (5) the firearm is identified in the application form in such manner as the Secretary may by regulations prescribe; and (6) the application form shows that the Secretary has approved the transfer and the registration of the firearm to the transferee.")
rule FirearmTransferApplicationComplete(e: FirearmTransferEvent) defeasible {
    when firearm_transfer_application_filed(e)
        and firearm_transfer_tax_stamp_affixed(e)
        and firearm_transferee_identified(e)
        and firearm_transferor_identified(e)
        and firearm_identified_in_application(e);
    then firearm_transfer_application_complete(e);
    unless firearm_transfer_would_violate_law(e);
}
@source(IRC_S5812_A, relation = formalizes, coverage = exact, quote = "the application form shows that the Secretary has approved the transfer and the registration of the firearm to the transferee")
rule FirearmTransferApprovalPower(e: FirearmTransferEvent, transferor: Person, transferee: Person) defeasible {
    when firearm_transfer_event(e, _, transferor, transferee, _);
    then power ApproveFirearmTransfer {
        holder Secretary;
        over e;
        exercise firearm_transfer_approval_exercised(e);
        valid_when firearm_transfer_application_complete(e);
        effect firearm_transfer_approved(e, transferee);
        window [-infinity, infinity];
    };
}
pub relation firearm_transfer_approval_exercised(e: FirearmTransferEvent) kind empirical;
pub relation firearm_transfer_approved(e: FirearmTransferEvent, transferee: Person) kind institutional {
    label en official "section 5812(a)(6): the Secretary has approved the transfer and registration of the firearm to the transferee";
}
@source(IRC_S5812_B, relation = formalizes, coverage = exact, quote = "The transferee of a firearm shall not take possession of the firearm unless the Secretary has approved the transfer and registration of the firearm to the transferee as required by subsection (a) of this section.")
rule FirearmNoPossessionWithoutApprovedTransfer(e: FirearmTransferEvent, transferee: Person) defeasible {
    when firearm_transfer_event(e, _, _, transferee, _);
    then prohibition NoPossessionWithoutApprovedTransfer {
        bearer transferee;
        beneficiary Secretary;
        action firearm_possession_taken(transferee, e);
        window [-infinity, infinity];
    };
    unless firearm_transfer_approved(e, transferee);
}
pub relation firearm_possession_taken(transferee: Person, e: FirearmTransferEvent) kind empirical {
    label en unofficial "established act: the transferee in fact took possession of the firearm";
}

// =====================================================================
// Section 5821 — making tax
// =====================================================================

pub entity FirearmMakingEvent : ExciseEvent;
pub relation firearm_making_event(e: FirearmMakingEvent, f: Firearm, maker: Person, on: Date) kind empirical {
    label en unofficial "section 5821/5822: the making of a chapter-53 firearm on the given date, by the person named in the making application";
}
@source(IRC_S5821_A, relation = formalizes, coverage = exact, quote = "There shall be levied, collected, and paid upon the making of a firearm a tax at the rate of $200 for each firearm made.")
rule FirearmMakingTaxStandard(e: FirearmMakingEvent, f: Firearm, on: Date) strict {
    when firearm_making_event(e, f, _, on)
        and not_known(firearm_category(f, Machinegun)) and not_known(firearm_category(f, DestructiveDevice))
        and on < @2026-01-01;
    then us.irc.excise_goods::excise_tax_due(e, S5821StandardRate);
}
@source(us.irc.temporal::PL119_21_S70436, relation = derives_from, coverage = exact, quote = "$0 for any firearm made which is not described in paragraph (1)")
rule FirearmMakingTaxZeroedNonMachinegunNonDestructiveDevice(e: FirearmMakingEvent, f: Firearm, on: Date) strict {
    when firearm_making_event(e, f, _, on)
        and not_known(firearm_category(f, Machinegun)) and not_known(firearm_category(f, DestructiveDevice))
        and on >= @2026-01-01;
    then us.irc.excise_goods::excise_tax_due(e, 0.00 USD);
}
@source(us.irc.temporal::PL119_21_S70436, relation = derives_from, coverage = exact, quote = "$200 for each firearm made in the case of a machinegun or a destructive device")
rule FirearmMakingTaxMachinegunOrDestructiveDevice(e: FirearmMakingEvent, f: Firearm) strict {
    when firearm_making_event(e, f, _, _)
        and (firearm_category(f, Machinegun) or firearm_category(f, DestructiveDevice));
    then us.irc.excise_goods::excise_tax_due(e, S5821StandardRate);
}
@source(IRC_S5821_B, relation = formalizes, coverage = exact, quote = "The tax imposed by subsection (a) of this section shall be paid by the person making the firearm.")
rule FirearmMakingTaxLiability(e: FirearmMakingEvent, maker: Person, amount: Money) defeasible {
    when firearm_making_event(e, _, maker, _) and us.irc.excise_goods::excise_tax_due(e, amount);
    then us.irc.excise_goods::liable_for_excise(maker, e, amount);
}

// =====================================================================
// Section 5822 — making
// =====================================================================

pub relation firearm_making_application_filed(e: FirearmMakingEvent) kind empirical;
pub relation firearm_making_tax_stamp_affixed(e: FirearmMakingEvent) kind empirical;
pub relation firearm_to_be_made_identified(e: FirearmMakingEvent) kind empirical;
pub relation firearm_maker_identified(e: FirearmMakingEvent) kind empirical;
pub relation firearm_making_would_violate_law(e: FirearmMakingEvent) kind empirical {
    label en unofficial "section 5822 last sentence: the making or possession of the firearm would place the maker in violation of law";
}
pub relation firearm_making_application_complete(e: FirearmMakingEvent) kind institutional;
@source(IRC_S5822, relation = formalizes, coverage = exact, quote = "No person shall make a firearm unless he has (a) filed with the Secretary a written application, in duplicate, to make and register the firearm on the form prescribed by the Secretary; (b) paid any tax payable on the making and such payment is evidenced by the proper stamp affixed to the original application form; (c) identified the firearm to be made in the application form in such manner as the Secretary may by regulations prescribe; (d) identified himself in the application form in such manner as the Secretary may by regulations prescribe, except that, if such person is an individual, the identification must include his fingerprints and his photograph; and (e) obtained the approval of the Secretary to make and register the firearm and the application form shows such approval.")
rule FirearmMakingApplicationComplete(e: FirearmMakingEvent) defeasible {
    when firearm_making_application_filed(e)
        and firearm_making_tax_stamp_affixed(e)
        and firearm_to_be_made_identified(e)
        and firearm_maker_identified(e);
    then firearm_making_application_complete(e);
    unless firearm_making_would_violate_law(e);
}
@source(IRC_S5822, relation = formalizes, coverage = exact, quote = "obtained the approval of the Secretary to make and register the firearm and the application form shows such approval")
rule FirearmMakingApprovalPower(e: FirearmMakingEvent, maker: Person) defeasible {
    when firearm_making_event(e, _, maker, _);
    then power ApproveFirearmMaking {
        holder Secretary;
        over e;
        exercise firearm_making_approval_exercised(e);
        valid_when firearm_making_application_complete(e);
        effect firearm_making_approved(e, maker);
        window [-infinity, infinity];
    };
}
pub relation firearm_making_approval_exercised(e: FirearmMakingEvent) kind empirical;
pub relation firearm_making_approved(e: FirearmMakingEvent, maker: Person) kind institutional {
    label en official "section 5822(e): the Secretary has approved the making and registration of the firearm";
}
@source(IRC_S5822, relation = formalizes, coverage = exact, quote = "obtained the approval of the Secretary to make and register the firearm and the application form shows such approval")
rule FirearmNoMakingWithoutApproval(e: FirearmMakingEvent, maker: Person) defeasible {
    when firearm_making_event(e, _, maker, _);
    then prohibition NoMakingWithoutApproval {
        bearer maker;
        beneficiary Secretary;
        action firearm_made_without_approval(e, maker);
        window [-infinity, infinity];
    };
    unless firearm_making_approved(e, maker);
}
pub relation firearm_made_without_approval(e: FirearmMakingEvent, maker: Person) kind empirical {
    label en unofficial "established act: the maker in fact made the firearm";
}
