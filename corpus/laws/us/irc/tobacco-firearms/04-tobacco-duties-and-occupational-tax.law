// Chapter 52, subchapter C (sections 5721-5723: inventories, reports,
// packages/marks/labels/notices), subchapter E (section 5741: records), and
// subchapter D (sections 5731-5734: occupational tax on manufacturers/
// export warehouse proprietors). Priority section 5741; the others complete
// the chapter's institutional scaffolding around the rate/liability/permit
// core already modeled.

// =====================================================================
// Section 5721 — inventories (recurring duty -> `maintenance`, per
// AGENT-BRIEF: "at time of commencing business, at time of concluding
// business, and at such other times...as the Secretary shall prescribe" is
// not a single achievement deadline)
// =====================================================================

use self::{
    IRC_S5721,
    IRC_S5722,
    IRC_S5723_A,
    IRC_S5723_C,
    IRC_S5723_D,
    IRC_S5731_A,
    IRC_S5731_B,
    IRC_S5731_C,
    IRC_S5732_A,
    IRC_S5733_A,
    IRC_S5733_E,
    IRC_S5741,
    Person,
    Secretary,
    TobaccoBusinessKind,
    TobaccoRemovalEvent,
    tobacco_package_requirement_met_or_exempt,
    tobacco_permit_granted,
    tobacco_receipts_test_amount,
    tobacco_removal,
};

@source(IRC_S5721, relation = formalizes, coverage = exact, quote = "Every manufacturer or importer of tobacco products, processed tobacco, or cigarette papers and tubes, and every export warehouse proprietor, shall make a true and accurate inventory at the time of commencing business, at the time of concluding business, and at such other times, in such manner and form, and to include such items, as the Secretary shall by regulation prescribe.")
rule TobaccoInventoryDuty(p: Person) defeasible {
    when tobacco_permit_granted(p);
    then duty MaintainTobaccoInventory {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition tobacco_inventory_current(p);
            window [-infinity, infinity];
        }
    };
}
pub relation tobacco_inventory_current(p: Person) kind empirical {
    label en unofficial "the case asserts this person's tobacco inventory is currently true, accurate and up to date as section 5721 and its regulations require";
}

// =====================================================================
// Section 5722 — reports (same recurring-duty shape)
// =====================================================================

@source(IRC_S5722, relation = formalizes, coverage = exact, quote = "Every manufacturer or importer of tobacco products, processed tobacco, or cigarette papers and tubes, and every export warehouse proprietor, shall make reports containing such information, in such form, at such times, and for such periods as the Secretary shall by regulation prescribe.")
rule TobaccoReportsDuty(p: Person) defeasible {
    when tobacco_permit_granted(p);
    then duty FileTobaccoReports {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition tobacco_reports_current(p);
            window [-infinity, infinity];
        }
    };
}
pub relation tobacco_reports_current(p: Person) kind empirical;

// =====================================================================
// Section 5723 — packages, marks, labels, and notices
// =====================================================================

pub relation tobacco_packaged_before_removal(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5723(a): the tobacco product/processed tobacco/cigarette papers or tubes were put up, before removal, in the Secretary-prescribed packages";
}
pub relation tobacco_package_marked_before_removal(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5723(b): the package bears, before removal, the Secretary-prescribed marks, labels, and notices";
}
pub relation tobacco_package_exempted_from_ab(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5723(e): furnished for employee/experimental use, or transferred in bond/released from customs custody as section 5704 describes, and exempted by regulation from (a) and (b)";
}
@source(IRC_S5723_A, relation = formalizes, coverage = exact, quote = "All tobacco products, processed tobacco, and cigarette papers and tubes shall, before removal, be put up in such packages as the Secretary shall by regulation prescribe.")
rule TobaccoMustBePackaged(e: TobaccoRemovalEvent) defeasible {
    when tobacco_removal(e, _, _);
    then prohibition RemovalWithoutProperPackage {
        bearer e;
        beneficiary Secretary;
        action tobacco_removed_unpackaged(e);
        window [-infinity, infinity];
    };
    unless tobacco_package_requirement_met_or_exempt(e);
}
pub relation tobacco_removed_unpackaged(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "established breach: the article was in fact removed without being put up in a proper package first";
}
@source(IRC_S5723_C, relation = formalizes, coverage = exact, quote = "No certificate, coupon, or other device purporting to be or to represent a ticket, chance, share, or an interest in, or dependent on, the event of a lottery shall be contained in, attached to, or stamped, marked, written, or printed on any package of tobacco products, processed tobacco, or cigarette papers or tubes.")
rule TobaccoNoLotteryFeatures(e: TobaccoRemovalEvent) strict {
    when tobacco_removal(e, _, _);
    then prohibition NoLotteryFeaturesOnPackage {
        bearer e;
        beneficiary Secretary;
        action tobacco_package_has_lottery_feature(e);
        window [-infinity, infinity];
    };
}
pub relation tobacco_package_has_lottery_feature(e: TobaccoRemovalEvent) kind empirical;
@source(IRC_S5723_D, relation = formalizes, coverage = exact, quote = "No indecent or immoral picture, print, or representation shall be contained in, attached to, or stamped, marked, written, or printed on any package of tobacco products, processed tobacco, or cigarette papers or tubes.")
rule TobaccoNoIndecentMaterial(e: TobaccoRemovalEvent) strict {
    when tobacco_removal(e, _, _);
    then prohibition NoIndecentMaterialOnPackage {
        bearer e;
        beneficiary Secretary;
        action tobacco_package_has_indecent_material(e);
        window [-infinity, infinity];
    };
}
pub relation tobacco_package_has_indecent_material(e: TobaccoRemovalEvent) kind empirical;

// =====================================================================
// Section 5741 — records to be maintained
// =====================================================================

@source(IRC_S5741, relation = formalizes, coverage = exact, quote = "Every manufacturer of tobacco products, processed tobacco, or cigarette papers and tubes, every importer, and every export warehouse proprietor shall keep such records in such manner as the Secretary shall by regulation prescribe. The records required under this section shall be available for inspection by any internal revenue officer during business hours.")
rule TobaccoRecordsDuty(p: Person) defeasible {
    when tobacco_permit_granted(p);
    then duty MaintainTobaccoRecords {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition tobacco_records_available_for_inspection(p);
            window [-infinity, infinity];
        }
    };
}
pub relation tobacco_records_available_for_inspection(p: Person) kind empirical {
    label en unofficial "the case asserts this person's section 5741 records are, in fact, kept and available for inspection by an internal revenue officer during business hours";
}

// =====================================================================
// Section 5731 — occupational tax (imposition and rate)
// =====================================================================

pub relation tobacco_occupational_taxpayer(p: Person, kind: TobaccoBusinessKind, gross_receipts: Money) kind empirical {
    label en unofficial "section 5731(a): a person engaged in business as a manufacturer of tobacco products, manufacturer of cigarette papers and tubes, or export warehouse proprietor, with the most-recent-prior-taxable-year gross receipts used for the section 5731(b) small-proprietor test";
}
pub relation tobacco_occupational_rate(p: Person, rate: Money) kind institutional {
    label en official "section 5731(a)/(b): the annual per-premises occupational tax rate applicable to this taxpayer";
}
@source(IRC_S5731_B, relation = formalizes, coverage = exact, quote = "Subsection (a) shall be applied by substituting \"$500\" for \"$1,000\" with respect to any taxpayer the gross receipts of which (for the most recent taxable year ending before the 1st day of the taxable period to which the tax imposed by subsection (a) relates) are less than $500,000.")
rule TobaccoOccupationalReducedRate(p: Person, kind: TobaccoBusinessKind, gross: Money) strict {
    when tobacco_occupational_taxpayer(p, kind, _) and tobacco_receipts_test_amount(p, gross) and gross < S5731SmallProprietorThreshold;
    then tobacco_occupational_rate(p, S5731ReducedRate);
}
@source(IRC_S5731_A, relation = formalizes, coverage = exact, quote = "shall pay a tax of $1,000 per year in respect of each premises at which such business is carried on")
rule TobaccoOccupationalGeneralRate(p: Person, kind: TobaccoBusinessKind, gross: Money) strict {
    when tobacco_occupational_taxpayer(p, kind, _) and tobacco_receipts_test_amount(p, gross) and gross >= S5731SmallProprietorThreshold;
    then tobacco_occupational_rate(p, S5731GeneralRate);
}
@source(IRC_S5732_A, relation = formalizes, coverage = exact, quote = "No person shall be engaged in or carry on any trade or business subject to tax under this subchapter until he has paid the special tax therefor.")
rule TobaccoOccupationalTaxCondition(p: Person) defeasible {
    when tobacco_occupational_taxpayer(p, _, _);
    then prohibition NoBusinessWithoutOccupationalTaxPaid {
        bearer p;
        beneficiary Secretary;
        action tobacco_occupational_business_carried_on(p);
        window [-infinity, infinity];
    };
    unless tobacco_occupational_tax_paid(p);
}
pub relation tobacco_occupational_tax_paid(p: Person) kind empirical;
pub relation tobacco_occupational_business_carried_on(p: Person) kind empirical;

@source(IRC_S5731_C, relation = formalizes, coverage = exact, quote = "Any person engaged in a business referred to in subsection (a) who willfully fails to pay the tax imposed by subsection (a) shall be fined not more than $5,000, or imprisoned not more than 2 years, or both, for each such offense.")
rule TobaccoOccupationalWillfulFailureOffense(p: Person) defeasible {
    when tobacco_occupational_taxpayer(p, _, _) and not_known(tobacco_occupational_tax_paid(p));
    then tobacco_occupational_willful_failure_classified(p);
}
pub relation tobacco_occupational_willful_failure_classified(p: Person) kind institutional {
    label en official "section 5731(c): willfulness itself (DECISION-0194 evaluative element, channel: adjudicated fact -- a court finding of willful failure to pay) is not derived by this rule; the classification records only that a criminal offense of this SHAPE exists, with punishment (fine up to $5,000 / imprisonment up to 2 years, EXTERNAL to this package's arithmetic) determined by the court";
}

// section 5732(b)/(c): computation of the special-tax year (July 1 to June
// 30, or prorated from commencement) and payment/stamp mechanics are
// administrative machinery around the same rate already computed above;
// classified NON_NORMATIVE/EXTERNAL_DEPENDENCY in the coverage rows rather
// than re-derived, since no additional taxpayer-facing norm follows from
// re-deriving the fiscal-year arithmetic here.

// section 5733: partners pay one tax (a); multiple pursuits at the same
// place pay for each (b); businesses in more than one location need a tax
// per location, with a storage exception and a definition of "place" (c);
// death/relocation succession without incurring an additional tax (d);
// federal instrumentalities are taxable absent a specific statutory
// exemption (e).
pub relation tobacco_occupational_partnership(p: Person) kind empirical {
    label en unofficial "section 5733(a): any number of persons doing business in partnership at one place";
}
@source(IRC_S5733_A, relation = formalizes, coverage = exact, quote = "Any number of persons doing business in partnership at any one place shall be required to pay but one special tax.")
rule TobaccoOccupationalOnePartnershipTax(p: Person) strict {
    when tobacco_occupational_partnership(p);
    then tobacco_occupational_single_tax_per_partnership(p);
}
pub relation tobacco_occupational_single_tax_per_partnership(p: Person) kind institutional;

pub relation tobacco_occupational_federal_instrumentality(p: Person) kind empirical {
    label en unofficial "section 5733(e): an agency or instrumentality of the United States engaged in a taxable business under this subchapter";
}
pub relation tobacco_occupational_specific_statutory_exemption(p: Person) kind empirical {
    label en unofficial "section 5733(e): a specific statutory exemption from this tax granted to this federal agency/instrumentality by another statute";
}
@source(IRC_S5733_E, relation = formalizes, coverage = exact, quote = "Any tax imposed by this subchapter shall apply to any agency or instrumentality of the United States unless such agency or instrumentality is granted by statute a specific exemption from such tax.")
rule TobaccoOccupationalFederalInstrumentalityTaxable(p: Person) defeasible {
    when tobacco_occupational_federal_instrumentality(p);
    then tobacco_occupational_taxable_notwithstanding_federal_status(p);
    unless tobacco_occupational_specific_statutory_exemption(p);
}
pub relation tobacco_occupational_taxable_notwithstanding_federal_status(p: Person) kind institutional;

// section 5734: application of State laws -- a NON-PREEMPTION savings
// clause (paying the federal occupational tax neither excuses State-law
// penalties/prohibitions on the same business nor bars a State from taxing
// it separately). No independent computable norm follows; classified
// NON_NORMATIVE in the coverage row (a savings/rule-of-construction clause,
// not itself a duty/prohibition/power addressed to a person before this
// package's tribunal).
