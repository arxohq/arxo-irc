// Section 5851-5854 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5852-01-TRANSFER-TO-UNITED-STATES-EXEMPT" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_transfer_to_united_states(entity_ref("urn:test:s5852:e1#e")) { origin case_input; }
        assert "f1": firearm_exemption_application_filed(entity_ref("urn:test:s5852:e1#e")) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::tax_free_sale(entity_ref("urn:test:s5852:e1#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5853-01-TRANSFER-TO-STATE-POLICE-EXEMPT" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_transfer_to_governmental_entity(entity_ref("urn:test:s5853:e1#e"), PoliceOrganizationEngagedInCriminalInvestigations) { origin case_input; }
        assert "f1": firearm_exemption_application_filed(entity_ref("urn:test:s5853:e1#e")) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::tax_free_sale(entity_ref("urn:test:s5853:e1#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5854-01-EXPORT-EXEMPT" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_exported(entity_ref("urn:test:s5854:e1#e")) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::tax_free_sale(entity_ref("urn:test:s5854:e1#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
