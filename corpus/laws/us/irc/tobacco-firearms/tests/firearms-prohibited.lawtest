// Section 5861, 5871, 5872 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5861D-01-POSSESSING-UNREGISTERED-FIREARM-VIOLATED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_possessor(entity_ref("urn:test:s5861:p1#p"), entity_ref("urn:test:s5861:p1#f")) { origin case_input; }
        assert "f1": firearm_possessed_unregistered(entity_ref("urn:test:s5861:p1#p"), entity_ref("urn:test:s5861:p1#f")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5861:p1#p"));
    expect position(S5861d_PossessingUnregisteredFirearm, VIOLATED);
}

test "S5861D-02-POSSESSING-REGISTERED-FIREARM-NOT-VIOLATED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_possessor(entity_ref("urn:test:s5861:p2#p"), entity_ref("urn:test:s5861:p2#f")) { origin case_input; }
        assert "f1": firearm_registered_to(entity_ref("urn:test:s5861:p2#f"), entity_ref("urn:test:s5861:p2#p")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5861:p2#p"));
    expect not position(S5861d_PossessingUnregisteredFirearm, VIOLATED);
}

test "S5871-01-CHAPTER53-OFFENSE-CLASSIFIED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_chapter53_violation(entity_ref("urn:test:s5871:p1#p")) { origin case_input; }
    }
    evaluate truth(firearm_chapter53_offense_classified(entity_ref("urn:test:s5871:p1#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5872-01-FIREARM-FORFEITED-ON-VIOLATION" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_possessor(entity_ref("urn:test:s5872:p1#p"), entity_ref("urn:test:s5872:p1#f")) { origin case_input; }
        assert "f1": firearm_chapter53_violation(entity_ref("urn:test:s5872:p1#p")) { origin case_input; }
    }
    evaluate truth(firearm_forfeited(entity_ref("urn:test:s5872:p1#f")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
