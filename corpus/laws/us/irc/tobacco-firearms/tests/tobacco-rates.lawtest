// Section 5701/5702 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5701-01-SMALL-CIGAR-RATE-1000-COUNT" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": cigar_removal(entity_ref("urn:test:s5701:c1#e"), SmallCigar, 1000.0, 0.00 USD) { origin case_input; }
    }
    // 50.33 * 1000 / 1000 = 50.33
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5701:c1#e"), 50.33 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5701-02-LARGE-CIGAR-PERCENTAGE-BELOW-CAP" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // price 0.50/cigar * 52.75% = 0.26375 < 0.4026 cap; 10 cigars => 2.64 rounded
        assert "f0": cigar_removal(entity_ref("urn:test:s5701:c2#e"), LargeCigar, 10.0, 0.50 USD) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5701:c2#e"), 2.64 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5701-03-LARGE-CIGAR-CAP-BINDS" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // price 5.00/cigar * 52.75% = 2.6375 > 0.4026 cap; 10 cigars => cap 4.026 rounded to 4.03
        assert "f0": cigar_removal(entity_ref("urn:test:s5701:c3#e"), LargeCigar, 10.0, 5.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5701:c3#e"), 4.03 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

