// Stage 3: sections 5801(b), 5881(b), 5891(c)(3)(B) scenarios. NOT EXECUTED (implemented_unverified): written from the pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5801B2-01-CONTROLLED-GROUP-RECEIPTS-AGGREGATED-GENERAL-RATE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": firearm_occupational_taxpayer(entity_ref("urn:test:s5801b201controlledgroupreceiptsaggregat#p"), Manufacturer, 300000.00 USD) { origin case_input; }
        assert "f1": firearm_occupational_taxpayer(entity_ref("urn:test:s5801b201controlledgroupreceiptsaggregat#q"), Manufacturer, 250000.00 USD) { origin case_input; }
        assert "f2": firearm_controlled_group_member(entity_ref("urn:test:s5801b201controlledgroupreceiptsaggregat#p"), entity_ref("urn:test:s5801b201controlledgroupreceiptsaggregat#q")) { origin case_input; }
    }
    // 550,000 is not below 500,000
    evaluate truth(firearm_occupational_rate(entity_ref("urn:test:s5801b201controlledgroupreceiptsaggregat#p"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
