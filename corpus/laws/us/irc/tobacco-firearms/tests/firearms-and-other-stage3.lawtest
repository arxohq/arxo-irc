test "S5881B-01-RELATED-PAYMENTS-TREATED-AS-PAID-IN-THE-ACQUISITION" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": greenmail_receipt(entity_ref("urn:test:s5881b01relatedpaymentstreatedaspaidinth#e"), entity_ref("urn:test:s5881b01relatedpaymentstreatedaspaidinth#r"), 1000000.00 USD) { origin case_input; }
        assert "f1": greenmail_stock_held_under_two_years(entity_ref("urn:test:s5881b01relatedpaymentstreatedaspaidinth#e")) { origin case_input; }
        assert "f2": greenmail_tender_offer_threat_in_window(entity_ref("urn:test:s5881b01relatedpaymentstreatedaspaidinth#e")) { origin case_input; }
        assert "f3": greenmail_offer_not_uniform(entity_ref("urn:test:s5881b01relatedpaymentstreatedaspaidinth#e")) { origin case_input; }
        assert "f4": greenmail_related_transaction_income(entity_ref("urn:test:s5881b01relatedpaymentstreatedaspaidinth#e"), 200000.00 USD) { origin case_input; }
        assert "f5": greenmail_related_transaction_income(entity_ref("urn:test:s5881b01relatedpaymentstreatedaspaidinth#e"), 100000.00 USD) { origin case_input; }
    }
    // 50 percent of 1,000,000 + 200,000 + 100,000
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5881b01relatedpaymentstreatedaspaidinth#e"), 650000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
