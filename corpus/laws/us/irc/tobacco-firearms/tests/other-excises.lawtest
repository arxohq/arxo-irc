// Section 5881 (greenmail), 5891 (structured settlement factoring) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5881-01-GREENMAIL-TAX-50-PERCENT" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": greenmail_receipt(entity_ref("urn:test:s5881:e1#e"), entity_ref("urn:test:s5881:e1#recipient"), 100000.00 USD) { origin case_input; }
        assert "f1": greenmail_stock_held_under_two_years(entity_ref("urn:test:s5881:e1#e")) { origin case_input; }
        assert "f2": greenmail_tender_offer_threat_in_window(entity_ref("urn:test:s5881:e1#e")) { origin case_input; }
        assert "f3": greenmail_offer_not_uniform(entity_ref("urn:test:s5881:e1#e")) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5881:e1#e"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5881-02-NOT-GREENMAIL-UNIFORM-OFFER-UNDETERMINED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": greenmail_receipt(entity_ref("urn:test:s5881:e2#e"), entity_ref("urn:test:s5881:e2#recipient"), 100000.00 USD) { origin case_input; }
        assert "f1": greenmail_stock_held_under_two_years(entity_ref("urn:test:s5881:e2#e")) { origin case_input; }
        assert "f2": greenmail_tender_offer_threat_in_window(entity_ref("urn:test:s5881:e2#e")) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5881:e2#e"), 50000.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S5891-01-FACTORING-TAX-40-PERCENT-OF-DISCOUNT" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // acquired 100,000; paid 60,000 -> discount 40,000; tax = 16,000
        assert "f0": structured_settlement_factoring_transaction(entity_ref("urn:test:s5891:e1#e"), entity_ref("urn:test:s5891:e1#acquirer"), 100000.00 USD, 60000.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5891:e1#e"), 16000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5891-02-QUALIFIED-ORDER-EXEMPT" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": structured_settlement_factoring_transaction(entity_ref("urn:test:s5891:e2#e"), entity_ref("urn:test:s5891:e2#acquirer"), 100000.00 USD, 60000.00 USD) { origin case_input; }
        assert "f1": structured_settlement_qualified_order_approval(entity_ref("urn:test:s5891:e2#e")) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::tax_free_sale(entity_ref("urn:test:s5891:e2#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
