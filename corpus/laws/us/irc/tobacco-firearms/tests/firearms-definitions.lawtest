// Section 5845 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5845-01-SHORT-BARRELED-SHOTGUN-AT-17-INCHES" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": shotgun_barrel_length_inches(entity_ref("urn:test:s5845:f1#f"), 17.0) { origin case_input; }
    }
    evaluate truth(firearm_category(entity_ref("urn:test:s5845:f1#f"), ShortBarreledShotgun));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

