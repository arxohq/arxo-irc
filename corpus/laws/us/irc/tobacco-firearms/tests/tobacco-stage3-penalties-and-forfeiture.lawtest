test "S5723E-01-EMPLOYEE-USE-EXEMPTED-BY-REGULATION-PROHIBITION-DEFEATED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tobacco_removal(entity_ref("urn:test:s5723e01employeeuseexemptedbyregulationp#e"), @2026-01-10, entity_ref("urn:test:s5723e01employeeuseexemptedbyregulationp#p")) { origin case_input; }
        assert "f1": tobacco_removed_unpackaged(entity_ref("urn:test:s5723e01employeeuseexemptedbyregulationp#e")) { origin case_input; }
        assert "f2": tobacco_package_exempted_from_ab(entity_ref("urn:test:s5723e01employeeuseexemptedbyregulationp#e")) { origin case_input; }
        assert "f3": tobacco_for_employee_use_or_experimental(entity_ref("urn:test:s5723e01employeeuseexemptedbyregulationp#e")) { origin case_input; }
    }
    // the packaging requirement is exempted by regulation for employee use
    evaluate positions();
    expect position(RemovalWithoutProperPackage, DEFEATED);
}
