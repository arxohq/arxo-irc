// Section 5711-5713 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5711-01-BOND-APPROVED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tobacco_bond_filed(entity_ref("urn:test:s5711:p1#p")) { origin case_input; }
        assert "f1": tobacco_bond_adequate(entity_ref("urn:test:s5711:p1#p")) { origin case_input; }
        assert "f2": tobacco_bond_approval_exercised(entity_ref("urn:test:s5711:p1#p")) { origin case_input; }
    }
    evaluate truth(tobacco_bond_approved(entity_ref("urn:test:s5711:p1#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

