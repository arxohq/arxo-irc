test "S5713-03-NO-OPERATING-WITHOUT-PERMIT-VIOLATED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tobacco_business_operator(entity_ref("urn:test:s5713:p3#p")) { origin case_input; }
        assert "f1": tobacco_business_operated(entity_ref("urn:test:s5713:p3#p")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5713:p3#p"));
    expect position(NoOperatingWithoutTobaccoPermit, VIOLATED);
