// Section 5801, 5802, 5811, 5812, 5821, 5822 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5801-01-DEALER-RATE-500" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_occupational_taxpayer(entity_ref("urn:test:s5801:d1#p"), Dealer, 900000.00 USD) { origin case_input; }
    }
    evaluate truth(firearm_occupational_rate(entity_ref("urn:test:s5801:d1#p"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

