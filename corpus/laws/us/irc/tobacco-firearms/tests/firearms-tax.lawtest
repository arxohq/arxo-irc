        assert "f1": firearm_possession_taken(entity_ref("urn:test:s5812:e2#transferee"), entity_ref("urn:test:s5812:e2#e")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5812:e2#transferee"));
    expect position(NoPossessionWithoutApprovedTransfer, VIOLATED);
}

