// WIRE-10 group A scenarios for module 96-wire10-A-tobacco-firearms.law (section 5872(b) disposal). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "W10A-TF-01-CHAPTER53-FORFEITURE-ACTIVATES-THE-DELIVERY-DUTY" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": firearm_possessor(entity_ref("urn:test:w10a:tf1#p"), entity_ref("urn:test:w10a:tf1#f")) { origin case_input; }
        assert "f1": firearm_chapter53_violation(entity_ref("urn:test:w10a:tf1#p")) { origin case_input; }
    }
    evaluate positions();
    expect position(W10AFirearmDeliveryToGsaDuty, ACTIVE);
    expect position(W10AFirearmNoPublicSaleBySecretaryProhibition, ACTIVE);
    expect position(W10AFirearmNoPublicSaleByAdministratorProhibition, ACTIVE);
}

