test "S5751-01-UNTAXED-POSSESSION-WITH-FRAUD-VIOLATED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tobacco_purchased_received_possessed_or_sold(entity_ref("urn:test:s5751:p1#p"), entity_ref("urn:test:s5751:p1#e")) { origin case_input; }
        assert "f1": tobacco_tax_not_paid_or_determined(entity_ref("urn:test:s5751:p1#e")) { origin case_input; }
        assert "f2": established_intent_to_defraud_united_states(entity_ref("urn:test:s5751:p1#p"), entity_ref("urn:test:s5751:p1#e")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5751:p1#p"));
    expect position(NoFraudulentUntaxedPossession, VIOLATED);
}

