test "S5761-03-RELANDING-PENALTY-GREATER-OF-5X-TAX" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tobacco_relanded_or_received_within_jurisdiction(entity_ref("urn:test:s5761:r1#p"), entity_ref("urn:test:s5761:r1#e")) { origin case_input; }
        assert "f1": us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5761:r1#e"), 500.00 USD) { origin case_input; }
    }
    // greater of $1000 or 5*500=2500 => 2500
    evaluate truth(tobacco_relanding_penalty_due(entity_ref("urn:test:s5761:r1#p"), entity_ref("urn:test:s5761:r1#e"), 2500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

