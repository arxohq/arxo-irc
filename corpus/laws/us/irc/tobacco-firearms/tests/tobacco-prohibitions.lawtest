// Section 5721-5734, 5751-5754, 5761-5763 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5741-01-RECORDS-AVAILABLE-SATISFIED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tobacco_permit_granted(entity_ref("urn:test:s5741:p1#p")) { origin case_input; }
        assert "f1": tobacco_records_available_for_inspection(entity_ref("urn:test:s5741:p1#p")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5741:p1#p"));
    expect position(MaintainTobaccoRecords, SATISFIED);
}

