        }
        assert "f0": cigar_removal(entity_ref("urn:test:s5701a202notintendedwithoutsimilarpricen#e"), LargeCigar, 10.0, 0.00 USD) { origin case_input; }
        assert "f1": cigar_not_intended_for_sale(entity_ref("urn:test:s5701a202notintendedwithoutsimilarpricen#e")) { origin case_input; }
    }
    // the similar cigar price is a required input: without it the answer is NEITHER, not zero
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5701a202notintendedwithoutsimilarpricen#e"), 0.00 USD));
    expect truth_status == NEITHER;
}
