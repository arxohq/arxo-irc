// Stage 3: sections 5701(a)(2), 5702(l), 5703(b)(2)(D) scenarios. NOT EXECUTED (implemented_unverified): written from the pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5701A2-01-NOT-INTENDED-FOR-SALE-TAXED-AT-SIMILAR-CIGAR-RATE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": cigar_removal(entity_ref("urn:test:s5701a201notintendedforsaletaxedatsimila#e"), LargeCigar, 10.0, 0.00 USD) { origin case_input; }
        assert "f1": cigar_not_intended_for_sale(entity_ref("urn:test:s5701a201notintendedforsaletaxedatsimila#e")) { origin case_input; }
        assert "f2": similar_cigar_price_for_sale(entity_ref("urn:test:s5701a201notintendedforsaletaxedatsimila#e"), 0.50 USD) { origin case_input; }
    }
    // 0.50 x 52.75 percent x 10 = 2.6375, rounded 2.64 (below the 4.03 cap)
    evaluate truth(us.irc.excise_goods::excise_tax_due(entity_ref("urn:test:s5701a201notintendedforsaletaxedatsimila#e"), 2.64 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
test "S5701A2-02-NOT-INTENDED-WITHOUT-SIMILAR-PRICE-NO-TAX-DERIVED" {
    given {
        context {
            legal_time @2024-06-15;
