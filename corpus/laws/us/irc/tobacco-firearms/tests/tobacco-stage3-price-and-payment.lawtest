        assert "f1": cigar_sale_price_charged(entity_ref("urn:test:s5702l02derivedpricefeedsthelargecigarta#e"), 1.00 USD) { origin case_input; }
        assert "f2": cigar_readying_charge(entity_ref("urn:test:s5702l02derivedpricefeedsthelargecigarta#e"), 0.10 USD) { origin case_input; }
