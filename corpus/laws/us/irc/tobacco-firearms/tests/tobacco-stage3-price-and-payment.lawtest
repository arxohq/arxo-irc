test "S5703B2D-09-EFT-SAFE-HARBOR-BELOW-THE-LINE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tobacco_special_period_taxes(entity_ref("urn:test:s5703b2d09eftsafeharborbelowtheline#p"), @2026-09-26, 2000.00 USD, 1500.00 USD, 1099.99 USD) { origin case_input; }
        assert "f1": prior_year_tobacco_tax_liability(entity_ref("urn:test:s5703b2d09eftsafeharborbelowtheline#p"), 6000000.00 USD) { origin case_input; }
    }
    // 1,099.99 x 15 = 16,499.85 < 1,500 x 11 = 16,500
    evaluate truth(tobacco_special_period_requirement_met(entity_ref("urn:test:s5703b2d09eftsafeharborbelowtheline#p"), @2026-09-26));
    expect truth_status == NEITHER;
}
