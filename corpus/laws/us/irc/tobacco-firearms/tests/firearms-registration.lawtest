// Section 5841-5844 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5841-01-NFRTR-MAINTENANCE-SATISFIED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": nfrtr_maintained() { origin case_input; }
    }
    evaluate positions();
    expect position(MaintainNfrtr, SATISFIED);
}

test "S5841-02-MANUFACTURE-NOTIFICATION-EFFECTS-REGISTRATION" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_manufacture_notified(entity_ref("urn:test:s5841:f1#f"), entity_ref("urn:test:s5841:f1#mfr")) { origin case_input; }
    }
    evaluate truth(firearm_registered(entity_ref("urn:test:s5841:f1#f")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5842-01-SERIAL-NUMBER-DUTY-SATISFIED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_manufactured_imported_or_made_by(entity_ref("urn:test:s5842:f1#f"), entity_ref("urn:test:s5842:f1#mfr")) { origin case_input; }
        assert "f1": firearm_serial_number_assigned(entity_ref("urn:test:s5842:f1#f")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5842:f1#mfr"));
    expect position(IdentifyFirearm, SATISFIED);
}

test "S5844-01-IMPORTATION-AUTHORIZED-US-USE" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_importation_event(entity_ref("urn:test:s5844:f1#f"), entity_ref("urn:test:s5844:f1#importer"), UnitedStatesOrStateUse) { origin case_input; }
    }
    evaluate truth(firearm_importation_authorized(entity_ref("urn:test:s5844:f1#f"), entity_ref("urn:test:s5844:f1#importer")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S5844-02-IMPORTATION-WITHOUT-AUTHORIZATION-VIOLATED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": firearm_possessor(entity_ref("urn:test:s5844:i2#importer"), entity_ref("urn:test:s5844:f2#f")) { origin case_input; }
        assert "f1": firearm_imported_without_authorization(entity_ref("urn:test:s5844:f2#f"), entity_ref("urn:test:s5844:i2#importer")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5844:i2#importer"));
    expect position(NoUnauthorizedFirearmImportation, VIOLATED);
}
