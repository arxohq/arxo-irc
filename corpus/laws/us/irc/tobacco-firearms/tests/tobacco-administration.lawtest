// Section 5703-5708 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

test "S5703-01-ORIGINAL-LIABILITY-MANUFACTURER" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tobacco_removal(entity_ref("urn:test:s5703:t1#e"), @2026-01-10, entity_ref("urn:test:s5703:t1#mfr")) { origin case_input; }
        assert "f1": smokeless_tobacco_removal(entity_ref("urn:test:s5703:t1#e"), Snuff, 10.0) { origin case_input; }
    }
    evaluate truth(us.irc.excise_goods::liable_for_excise(entity_ref("urn:test:s5703:t1#mfr"), entity_ref("urn:test:s5703:t1#e"), 15.10 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

