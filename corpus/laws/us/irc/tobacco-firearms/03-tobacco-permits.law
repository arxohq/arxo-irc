// Chapter 52, subchapter B: section 5711 (bond), section 5712 (application
// for permit), section 5713 (permit issuance/suspension/revocation).
// Priority sections 5712/5713, IRC-14 stage 1.

use self::{
    IRC_S5711_A,
    IRC_S5711_B,
    IRC_S5711_C,
    IRC_S5712,
    IRC_S5713_A,
    IRC_S5713_B,
    Person,
    Secretary,
};

pub enum TobaccoBusinessKind { ManufacturerOfTobaccoProducts; ManufacturerOfProcessedTobacco; ImporterOfTobaccoProductsOrProcessedTobacco; ExportWarehouseProprietor; }

// =====================================================================
// Section 5711 — bond
// =====================================================================

pub relation tobacco_business_commencing(p: Person, kind: TobaccoBusinessKind) kind empirical {
    label en unofficial "section 5711(a): a person about to commence business as a manufacturer of tobacco products or cigarette papers/tubes, or as an export warehouse proprietor";
}
@source(IRC_S5711_A, relation = formalizes, coverage = exact, quote = "Every person, before commencing business as a manufacturer of tobacco products or cigarette papers and tubes, or as an export warehouse proprietor, shall file such bond")
rule TobaccoBondDuty(p: Person, kind: TobaccoBusinessKind) defeasible {
    when tobacco_business_commencing(p, kind);
    then duty FileTobaccoBond {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition tobacco_bond_filed(p);
            window [-infinity, infinity];
        }
    };
}
pub relation tobacco_bond_filed(p: Person) kind empirical;
pub relation tobacco_bond_adequate(p: Person) kind empirical {
    label en unofficial "section 5711(b): the bond is adequate to protect the revenue, in the Secretary's determination";
}
@source(IRC_S5711_B, relation = formalizes, coverage = exact, quote = "No person shall engage in such business until he receives notice of approval of such bond.")
rule TobaccoBondApprovalPower(p: Person) defeasible {
    when tobacco_bond_filed(p) and tobacco_bond_adequate(p);
    then power ApproveTobaccoBond {
        holder Secretary;
        over p;
        exercise tobacco_bond_approval_exercised(p);
        valid_when tobacco_bond_adequate(p);
        effect tobacco_bond_approved(p);
        window [-infinity, infinity];
    };
}
pub relation tobacco_bond_approval_exercised(p: Person) kind empirical;
pub relation tobacco_bond_approved(p: Person) kind institutional;
pub relation tobacco_bond_no_longer_adequate(p: Person) kind empirical {
    label en unofficial "section 5711(c): the Secretary determines the previously approved bond no longer adequately protects the revenue (case-asserted determination)";
}
@source(IRC_S5711_C, relation = formalizes, coverage = exact, quote = "Any bond filed hereunder may be canceled, upon notice to the principal on the bond, whenever the Secretary determines that the bond no longer adequately protects the revenue.")
rule TobaccoBondCancellationPower(p: Person) defeasible {
    when tobacco_bond_approved(p) and tobacco_bond_no_longer_adequate(p);
    then power CancelTobaccoBond {
        holder Secretary;
        over p;
        exercise tobacco_bond_cancellation_exercised(p);
        valid_when tobacco_bond_no_longer_adequate(p);
        effect tobacco_bond_cancelled(p);
        window [-infinity, infinity];
    };
}
pub relation tobacco_bond_cancellation_exercised(p: Person) kind empirical;
pub relation tobacco_bond_cancelled(p: Person) kind institutional;

// =====================================================================
// Section 5712 — application for permit
// =====================================================================

pub entity TobaccoPermitApplication;
pub relation tobacco_permit_application(app: TobaccoPermitApplication, applicant: Person, kind: TobaccoBusinessKind) kind empirical {
    label en unofficial "section 5712: an application for the section 5713 permit, made before commencing business (or at another time the Secretary by regulation prescribes)";
}
pub relation tobacco_premises_inadequate(app: TobaccoPermitApplication) kind empirical {
    label en unofficial "section 5712(1): the premises on which it is proposed to conduct the business are not adequate to protect the revenue";
}
pub relation tobacco_activity_below_minimum_capacity(app: TobaccoPermitApplication) kind empirical {
    label en unofficial "section 5712(2): the proposed activity does not meet the Secretary's minimum capacity or activity requirements";
}
pub relation tobacco_applicant_unlikely_to_comply(app: TobaccoPermitApplication) kind empirical {
    label en unofficial "section 5712(3)(A): by reason of business experience, financial standing, trade connections, or prior/current felony proceedings relating to tobacco products, not likely to maintain compliant operations";
}
pub relation tobacco_applicant_felony_conviction(app: TobaccoPermitApplication) kind empirical {
    label en unofficial "section 5712(3)(B): convicted of a felony violation of Federal or State criminal law relating to tobacco products, processed tobacco, cigarette paper, or cigarette tubes";
}
pub relation tobacco_applicant_false_statement(app: TobaccoPermitApplication) kind empirical {
    label en unofficial "section 5712(3)(C): failed to disclose required material information or made a material false statement in the application";
}
pub relation tobacco_permit_denial_ground(app: TobaccoPermitApplication) kind institutional {
    label en official "section 5712(1)-(3): at least one ground exists on which the Secretary, after notice and hearing, may reject the application and deny the permit";
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "the premises on which it is proposed to conduct the business are not adequate to protect the revenue")
rule TobaccoDenialGroundPremises(app: TobaccoPermitApplication) strict {
    when tobacco_premises_inadequate(app);
    then tobacco_permit_denial_ground(app);
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "the activity proposed to be carried out at such premises does not meet such minimum capacity or activity requirements as the Secretary may prescribe")
rule TobaccoDenialGroundCapacity(app: TobaccoPermitApplication) strict {
    when tobacco_activity_below_minimum_capacity(app);
    then tobacco_permit_denial_ground(app);
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "not likely to maintain operations in compliance with this chapter")
rule TobaccoDenialGroundUnlikelyCompliance(app: TobaccoPermitApplication) strict {
    when tobacco_applicant_unlikely_to_comply(app);
    then tobacco_permit_denial_ground(app);
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "has been convicted of a felony violation of any provision of Federal or State criminal law relating to tobacco products")
rule TobaccoDenialGroundFelony(app: TobaccoPermitApplication) strict {
    when tobacco_applicant_felony_conviction(app);
    then tobacco_permit_denial_ground(app);
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "has failed to disclose any material information required or made any material false statement in the application therefor")
rule TobaccoDenialGroundFalseStatement(app: TobaccoPermitApplication) strict {
    when tobacco_applicant_false_statement(app);
    then tobacco_permit_denial_ground(app);
}
@source(IRC_S5712, relation = formalizes, coverage = exact, quote = "Every person, before commencing business as a manufacturer or importer of tobacco products or processed tobacco or as an export warehouse proprietor, and at such other time as the Secretary shall by regulation prescribe, shall make application for the permit provided for in section 5713.")
pub relation tobacco_permit_qualified(app: TobaccoPermitApplication) kind institutional {
    label en official "section 5712/5713(a): the application shows no denial ground -- the applicant is properly qualified for the permit";
}
rule TobaccoPermitQualified(app: TobaccoPermitApplication) defeasible {
    when tobacco_permit_application(app, _, _) and not_known(tobacco_permit_denial_ground(app));
    then tobacco_permit_qualified(app);
}

// =====================================================================
// Section 5713 — permit: issuance, suspension, revocation
// =====================================================================

@source(IRC_S5713_A, relation = formalizes, coverage = exact, quote = "Such permit, conditioned upon compliance with this chapter and regulations issued thereunder, shall be issued in such form and in such manner as the Secretary shall by regulation prescribe, to every person properly qualified under sections 5711 and 5712.")
rule TobaccoPermitIssuancePower(app: TobaccoPermitApplication, applicant: Person) defeasible {
    when tobacco_permit_application(app, applicant, _) and tobacco_bond_approved(applicant);
    then power IssueTobaccoPermit {
        holder Secretary;
        over app;
        exercise tobacco_permit_issuance_exercised(app);
        valid_when tobacco_permit_qualified(app);
        effect tobacco_permit_granted(applicant);
        window [-infinity, infinity];
    };
}
pub relation tobacco_permit_issuance_exercised(app: TobaccoPermitApplication) kind empirical;
pub relation tobacco_permit_granted(p: Person) kind institutional {
    label en official "section 5713(a): the person holds a valid permit to engage in the applied-for tobacco business";
}

@source(IRC_S5713_A, relation = formalizes, coverage = exact, quote = "A person shall not engage in business as a manufacturer or importer of tobacco products or processed tobacco or as an export warehouse proprietor without a permit to engage in such business.")
rule TobaccoNoOperatingWithoutPermit(p: Person) defeasible {
    when tobacco_business_operator(p);
    then prohibition NoOperatingWithoutTobaccoPermit {
        bearer p;
        beneficiary Secretary;
        action tobacco_business_operated(p);
        window [-infinity, infinity];
    };
    unless tobacco_permit_granted(p);
}
pub relation tobacco_business_operator(p: Person) kind empirical {
    label en unofficial "the case asserts this person is operating (or attempting to operate) a manufacturer/importer/export-warehouse-proprietor tobacco business";
}
pub relation tobacco_business_operated(p: Person) kind empirical {
    label en unofficial "the established act that VIOLATES the NoOperatingWithoutTobaccoPermit prohibition: this person in fact conducted the business";
}

// section 5713(b): suspension/revocation grounds (A)-(F), collapsed into one
// institutional ground relation (the show-cause hearing procedure itself --
// the order stating facts charged and citing the holder to respond -- is a
// PROCEDURAL step this package does not separately model; only the
// substantive grounds and the ultimate suspension/revocation power are).
pub relation tobacco_permit_bad_faith_noncompliance(p: Person) kind empirical {
    label en unofficial "section 5713(b)(1)(A): has not in good faith complied with this chapter, or with any other title provision involving intent to defraud";
}
pub relation tobacco_permit_condition_violated(p: Person) kind empirical {
    label en unofficial "section 5713(b)(1)(B): has violated the conditions of the permit";
}
pub relation tobacco_permit_application_false_statement(p: Person) kind empirical {
    label en unofficial "section 5713(b)(1)(C): failed to disclose required material information, or made a material false statement, in the permit application";
}
pub relation tobacco_permit_premises_not_maintained(p: Person) kind empirical {
    label en unofficial "section 5713(b)(1)(D): has failed to maintain the premises so as to protect the revenue";
}
pub relation tobacco_permit_holder_unlikely_to_comply(p: Person) kind empirical {
    label en unofficial "section 5713(b)(1)(E): by reason of previous/current felony proceedings relating to tobacco products, not likely to maintain compliant operations";
}
pub relation tobacco_permit_holder_felony_conviction(p: Person) kind empirical {
    label en unofficial "section 5713(b)(1)(F): convicted of a felony violation of Federal or State criminal law relating to tobacco products";
}
pub relation tobacco_permit_revocation_ground(p: Person) kind institutional {
    label en official "section 5713(b)(1)(A)-(F): at least one ground exists on which the Secretary may order the holder to show cause why the permit should not be suspended or revoked";
}
rule TobaccoRevocationGroundA(p: Person) strict { when tobacco_permit_bad_faith_noncompliance(p); then tobacco_permit_revocation_ground(p); }
rule TobaccoRevocationGroundB(p: Person) strict { when tobacco_permit_condition_violated(p); then tobacco_permit_revocation_ground(p); }
rule TobaccoRevocationGroundC(p: Person) strict { when tobacco_permit_application_false_statement(p); then tobacco_permit_revocation_ground(p); }
rule TobaccoRevocationGroundD(p: Person) strict { when tobacco_permit_premises_not_maintained(p); then tobacco_permit_revocation_ground(p); }
rule TobaccoRevocationGroundE(p: Person) strict { when tobacco_permit_holder_unlikely_to_comply(p); then tobacco_permit_revocation_ground(p); }
rule TobaccoRevocationGroundF(p: Person) strict { when tobacco_permit_holder_felony_conviction(p); then tobacco_permit_revocation_ground(p); }

@source(IRC_S5713_B, relation = formalizes, coverage = exact, quote = "If, after hearing, the Secretary finds that such person has not shown cause why his permit should not be suspended or revoked, such permit shall be suspended for such period as the Secretary deems proper or shall be revoked.")
rule TobaccoPermitSuspensionOrRevocationPower(p: Person) defeasible {
    when tobacco_permit_granted(p) and tobacco_permit_revocation_ground(p);
    then power SuspendOrRevokeTobaccoPermit {
        holder Secretary;
        over p;
        exercise tobacco_permit_suspension_or_revocation_exercised(p);
        valid_when tobacco_permit_revocation_ground(p);
        effect tobacco_permit_suspended_or_revoked(p);
        window [-infinity, infinity];
    };
}
pub relation tobacco_permit_suspension_or_revocation_exercised(p: Person) kind empirical;
pub relation tobacco_permit_suspended_or_revoked(p: Person) kind institutional {
    label en official "section 5713(b)(2): the permit has been suspended (for the period the Secretary deems proper) or revoked";
}
