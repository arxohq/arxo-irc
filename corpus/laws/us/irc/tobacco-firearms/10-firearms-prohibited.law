// Chapter 53, subchapter C (section 5861: prohibited acts) and subchapter D
// (section 5871: penalties; section 5872: forfeitures). Priority section
// 5861, IRC-14 stage 1.

// =====================================================================
// Section 5861 — prohibited acts
// =====================================================================

use self::{
    Firearm,
    FirearmCategory,
    FirearmMakingEvent,
    FirearmTransferEvent,
    IRC_S5861,
    IRC_S5871,
    IRC_S5872_A,
    Person,
    Secretary,
    firearm_category,
    firearm_importation_authorized,
    firearm_made_without_approval,
    firearm_making_application_complete,
    firearm_making_approved,
    firearm_making_event,
    firearm_possessor,
    firearm_registered,
    firearm_serial_number_assigned,
    firearm_transfer_application_complete,
    firearm_transfer_approved,
    firearm_transfer_event,
};

pub relation firearm_business_without_tax_or_registration(p: Person) kind empirical {
    label en unofficial "the established act underlying section 5861(a): engaging in business as a manufacturer/importer/dealer in firearms";
}
@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to engage in business as a manufacturer or importer of, or dealer in, firearms without having paid the special (occupational) tax required by section 5801 for his business or having registered as required by section 5802")
rule S5861a_NoUnlicensedFirearmsBusiness(p: Person) defeasible {
    when firearm_business_without_tax_or_registration(p);
    then prohibition S5861a_EngagingInBusinessWithoutTaxOrRegistration {
        bearer p;
        beneficiary Secretary;
        action firearm_business_without_tax_or_registration(p);
        window [-infinity, infinity];
    };
    unless firearm_occupational_tax_and_registration_current(p);
}
pub relation firearm_occupational_tax_and_registration_current(p: Person) kind empirical {
    label en unofficial "this person has paid the section 5801 occupational tax and registered as section 5802 requires";
}

pub relation firearm_received_or_possessed(p: Person, e: FirearmTransferEvent) kind empirical {
    label en unofficial "the established act underlying section 5861(b): this person received or possesses a firearm transferred to him";
}
@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to receive or possess a firearm transferred to him in violation of the provisions of this chapter")
rule S5861b_NoReceivingUnlawfullyTransferredFirearm(p: Person, e: FirearmTransferEvent) defeasible {
    when firearm_received_or_possessed(p, e);
    then prohibition S5861b_ReceivingOrPossessingUnlawfullyTransferredFirearm {
        bearer p;
        beneficiary Secretary;
        action firearm_received_or_possessed(p, e);
        window [-infinity, infinity];
    };
    unless firearm_transfer_approved(e, p);
}

pub relation firearm_received_or_possessed_from_making(p: Person, e: FirearmMakingEvent) kind empirical {
    label en unofficial "the established act underlying section 5861(c): this person received or possesses a firearm made";
}
@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to receive or possess a firearm made in violation of the provisions of this chapter")
rule S5861c_NoReceivingUnlawfullyMadeFirearm(p: Person, e: FirearmMakingEvent) defeasible {
    when firearm_received_or_possessed_from_making(p, e);
    then prohibition S5861c_ReceivingOrPossessingUnlawfullyMadeFirearm {
        bearer p;
        beneficiary Secretary;
        action firearm_received_or_possessed_from_making(p, e);
        window [-infinity, infinity];
    };
    unless firearm_making_approved(e, p);
}

@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to receive or possess a firearm which is not registered to him in the National Firearms Registration and Transfer Record")
rule S5861d_NoPossessingUnregisteredFirearm(p: Person, f: Firearm) defeasible {
    when firearm_possessor(p, f);
    then prohibition S5861d_PossessingUnregisteredFirearm {
        bearer p;
        beneficiary Secretary;
        action firearm_possessed_unregistered(p, f);
        window [-infinity, infinity];
    };
    unless firearm_registered_to(f, p);
}
pub relation firearm_possessed_unregistered(p: Person, f: Firearm) kind empirical;
pub relation firearm_registered_to(f: Firearm, p: Person) kind empirical {
    label en unofficial "the case asserts the National Firearms Registration and Transfer Record shows this firearm registered to this person";
}

@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to transfer a firearm in violation of the provisions of this chapter")
rule S5861e_NoUnlawfulTransfer(e: FirearmTransferEvent, transferor: Person) defeasible {
    when firearm_transfer_event(e, _, transferor, _, _) and not_known(firearm_transfer_application_complete(e));
    then prohibition S5861e_TransferringFirearmUnlawfully {
        bearer transferor;
        beneficiary Secretary;
        action firearm_transferred(e, transferor);
        window [-infinity, infinity];
    };
}
pub relation firearm_transferred(e: FirearmTransferEvent, transferor: Person) kind empirical {
    label en unofficial "established act: the transferor in fact transferred the firearm";
}

@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to make a firearm in violation of the provisions of this chapter")
rule S5861f_NoUnlawfulMaking(e: FirearmMakingEvent, maker: Person) defeasible {
    when firearm_making_event(e, _, maker, _) and not_known(firearm_making_application_complete(e));
    then prohibition S5861f_MakingFirearmUnlawfully {
        bearer maker;
        beneficiary Secretary;
        action firearm_made_without_approval(e, maker);
        window [-infinity, infinity];
    };
}

pub relation firearm_identification_altered(p: Person, f: Firearm) kind empirical {
    label en unofficial "the established act underlying section 5861(g): this person obliterated, removed, changed, or altered the required serial number/identification";
}
@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to obliterate, remove, change, or alter the serial number or other identification of a firearm required by this chapter")
rule S5861g_NoAlteringIdentification(p: Person, f: Firearm) strict {
    when firearm_identification_altered(p, f);
    then prohibition S5861g_AlteringFirearmIdentification {
        bearer p;
        beneficiary Secretary;
        action firearm_identification_altered(p, f);
        window [-infinity, infinity];
    };
}
@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to receive or possess a firearm having the serial number or other identification required by this chapter obliterated, removed, changed, or altered")
rule S5861h_NoPossessingAlteredIdentificationFirearm(p: Person, f: Firearm) strict {
    when firearm_possessor(p, f) and firearm_identification_currently_altered(f);
    then prohibition S5861h_PossessingAlteredIdentificationFirearm {
        bearer p;
        beneficiary Secretary;
        action firearm_possessed_with_altered_identification(p, f);
        window [-infinity, infinity];
    };
}
pub relation firearm_identification_currently_altered(f: Firearm) kind empirical;
pub relation firearm_possessed_with_altered_identification(p: Person, f: Firearm) kind empirical;

@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to receive or possess a firearm which is not identified by a serial number as required by this chapter")
rule S5861i_NoPossessingUnidentifiedFirearm(p: Person, f: Firearm) strict {
    when firearm_possessor(p, f) and not_known(firearm_category(f, DestructiveDevice)) and not_known(firearm_serial_number_assigned(f));
    then prohibition S5861i_PossessingUnidentifiedFirearm {
        bearer p;
        beneficiary Secretary;
        action firearm_possessed_without_serial_number(p, f);
        window [-infinity, infinity];
    };
}
pub relation firearm_possessed_without_serial_number(p: Person, f: Firearm) kind empirical;

pub relation firearm_transported_delivered_or_received_interstate(p: Person, f: Firearm) kind empirical {
    label en unofficial "the established act underlying section 5861(j): this person transported, delivered, or received the firearm in interstate commerce";
}
@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to transport, deliver, or receive any firearm in interstate commerce which has not been registered as required by this chapter")
rule S5861j_NoInterstateTransportOfUnregisteredFirearm(p: Person, f: Firearm) defeasible {
    when firearm_transported_delivered_or_received_interstate(p, f) and not_known(firearm_registered(f));
    then prohibition S5861j_InterstateTransportOfUnregisteredFirearm {
        bearer p;
        beneficiary Secretary;
        action firearm_transported_delivered_or_received_interstate(p, f);
        window [-infinity, infinity];
    };
}

@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to receive or possess a firearm which has been imported or brought into the United States in violation of section 5844")
rule S5861k_NoPossessingUnlawfullyImportedFirearm(p: Person, f: Firearm) defeasible {
    when firearm_possessor(p, f);
    then prohibition S5861k_PossessingUnlawfullyImportedFirearm {
        bearer p;
        beneficiary Secretary;
        action firearm_possessed_unlawfully_imported(p, f);
        window [-infinity, infinity];
    };
    unless firearm_importation_authorized(f, p);
}
pub relation firearm_possessed_unlawfully_imported(p: Person, f: Firearm) kind empirical;

pub relation firearm_false_entry_made(p: Person) kind empirical {
    label en unofficial "the established act underlying section 5861(l): this person made, or caused the making of, a false entry on a chapter-53 application, return, or record, knowing the entry to be false";
}
@source(IRC_S5861, relation = formalizes, coverage = partial, quote = "to make, or cause the making of, a false entry on any application, return, or record required by this chapter, knowing such entry to be false")
rule S5861l_NoFalseEntry(p: Person) strict {
    when firearm_false_entry_made(p);
    then prohibition S5861l_MakingFalseEntry {
        bearer p;
        beneficiary Secretary;
        action firearm_false_entry_made(p);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 5871 — penalties (offense classification; punishment itself is
// EXTERNAL/judicial per AGENT-BRIEF method)
// =====================================================================

pub relation firearm_chapter53_violation(p: Person) kind empirical {
    label en unofficial "the case asserts a section 5861 (or other chapter 53) violation by this person, feeding the section 5871 penalty classification independent of which specific S5861x_ prohibition position was raised";
}
pub relation firearm_chapter53_offense_classified(p: Person) kind institutional {
    label en official "section 5871: upon conviction, fined not more than $10,000, or imprisoned not more than ten years, or both -- punishment EXTERNAL/judicial, not computed by this package";
}
@source(IRC_S5871, relation = formalizes, coverage = exact, quote = "Any person who violates or fails to comply with any provision of this chapter shall, upon conviction, be fined not more than $10,000, or be imprisoned not more than ten years, or both.")
rule FirearmChapter53OffenseClassified(p: Person) strict {
    when firearm_chapter53_violation(p);
    then firearm_chapter53_offense_classified(p);
}

// =====================================================================
// Section 5872 — forfeitures
// =====================================================================

@source(IRC_S5872_A, relation = formalizes, coverage = exact, quote = "Any firearm involved in any violation of the provisions of this chapter shall be subject to seizure and forfeiture")
rule FirearmForfeitedOnChapter53Violation(f: Firearm, p: Person) strict {
    when firearm_possessor(p, f) and firearm_chapter53_violation(p);
    then firearm_forfeited(f);
}
pub relation firearm_forfeited(f: Firearm) kind institutional {
    label en official "section 5872(a): the firearm is subject to seizure and forfeiture; disposal follows section 5872(b) (no public sale -- destruction, transfer to a State/possession, or retention/transfer within the federal government)";
}
// section 5872(b) (disposal mechanics: no public sale; destruction or
// transfer by the Administrator of General Services) is administrative
// housekeeping over already-forfeited property, not a further norm
// addressed to a person; classified NON_NORMATIVE in the coverage row.
