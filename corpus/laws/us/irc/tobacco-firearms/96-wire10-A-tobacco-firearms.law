// Tobacco and firearms -- WIRE-10, group A (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 5872(b): the disposal of a firearm forfeited by reason of a violation of chapter 53. The text was classified NON_NORMATIVE
// ("administrative housekeeping") in stage 1, but it addresses the Secretary (delivery duty, no public sale) and the Administrator of
// General Services (powers over the delivered firearm). Section 5685(c) of chapter 51 (`us.irc.alcohol`) sends the firearms forfeited for a
// liquor-law violation to the same disposal "in the manner provided by section 5872"; that consumer derives the `pub` stub
// `firearm_forfeited_under_reference_to_5872` (qualified head), and this owner treats it exactly like a chapter 53 forfeiture.
//
// JUDGMENT CALLS
//  - "no notice of public sale shall be required" is a negative statement about a notice that no norm requires here: NON_NORMATIVE (no rule).
//  - The four dispositions of the Administrator (destroy; sell to a State, possession or political subdivision; retain for official
//    use of the Treasury Department at the Secretary's request; transfer without charge to an executive department or independent
//    establishment) are four separate powers, each valid only on a firearm delivered to the Administrator. The exercise facts are
//    case-asserted; the statute names no consequence beyond the disposition itself, so the effect is the disposition relation.
//  - "there is no remission or mitigation of forfeiture" is a case fact (`firearm_forfeiture_remitted_or_mitigated`): remission and
//    mitigation belong to the general forfeiture procedure of the internal revenue laws, which this package does not model.

language "law.core" version "0.2";
package us.irc.tobacco_firearms version "0.1.1";
namespace "urn:us:irc:tobacco_firearms:clir";

use self::{
    Firearm,
    IRC_S5703_D,
    IRC_S5872_B,
    Organ,
    Person,
    Secretary,
    TobaccoRemovalEvent,
    firearm_forfeited,
};

pub const GsaAdministrator: Organ = entity_ref("urn:us:irc:tobacco_firearms:clir#GsaAdministrator") {
    label en official "the Administrator of General Services, General Services Administration (section 5872(b))";
}

pub relation firearm_forfeited_under_reference_to_5872(f: Firearm) kind institutional {
    label en unofficial "the firearm is forfeited under a provision of this title outside chapter 53 that adopts the manner of disposal provided by section 5872 (derived by the referring package, section 5685(c) of chapter 51)";
}
pub relation firearm_subject_to_5872b_disposal(f: Firearm) kind institutional {
    label en official "the firearm is forfeited by reason of a violation of chapter 53 (or forfeited under a provision that adopts the manner provided by section 5872) and so is disposed of as section 5872(b) provides";
}
@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "In the case of the forfeiture of any firearm by reason of a violation of this chapter")
rule W10AFirearmDisposalAppliesToChapter53Forfeiture strict {
    label en official "section 5872(b): the disposal rules apply to a firearm forfeited by reason of a violation of chapter 53";
    for f: Firearm;
    when firearm_forfeited(f);
    then firearm_subject_to_5872b_disposal(f);
}
@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "In the case of the forfeiture of any firearm by reason of a violation of this chapter")
rule W10AFirearmDisposalAppliesByReference strict {
    label en official "a firearm forfeited under a provision that adopts the manner provided by section 5872 is disposed of as section 5872(b) provides";
    for f: Firearm;
    when firearm_forfeited_under_reference_to_5872(f);
    then firearm_subject_to_5872b_disposal(f);
}

pub relation firearm_forfeiture_remitted_or_mitigated(f: Firearm) kind empirical {
    label en official "there is a remission or mitigation of the forfeiture of the firearm (section 5872(b))";
}
pub relation firearm_delivered_to_gsa_administrator(f: Firearm) kind empirical {
    label en official "the firearm is delivered by the Secretary to the Administrator of General Services, General Services Administration (section 5872(b))";
}
pub relation firearm_sold_at_public_sale(f: Firearm) kind empirical {
    label en official "the firearm is sold at public sale (section 5872(b))";
}

@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "if such firearm is forfeited for a violation of this chapter and there is no remission or mitigation of forfeiture thereof, it shall be delivered by the Secretary to the Administrator of General Services, General Services Administration")
rule W10AFirearmDeliveryDuty defeasible {
    label en official "section 5872(b): a forfeited firearm with no remission or mitigation of forfeiture is delivered by the Secretary to the Administrator of General Services";
    for f: Firearm;
    when firearm_subject_to_5872b_disposal(f);
    then duty W10AFirearmDeliveryToGsaDuty {
        bearer Secretary;
        beneficiary GsaAdministrator;
        goal achievement {
            condition firearm_delivered_to_gsa_administrator(f);
            window [-infinity, infinity];
        }
    };
    unless firearm_forfeiture_remitted_or_mitigated(f) and firearm_subject_to_5872b_disposal(f);
}

@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "no such firearm shall be sold at public sale")
rule W10AFirearmNoPublicSaleBySecretary strict {
    label en official "section 5872(b): no firearm forfeited by reason of a violation of chapter 53 shall be sold at public sale (addressed to the Secretary, who holds the firearm until delivery)";
    for f: Firearm;
    when firearm_subject_to_5872b_disposal(f);
    then prohibition W10AFirearmNoPublicSaleBySecretaryProhibition {
        bearer Secretary;
        beneficiary GsaAdministrator;
        action firearm_sold_at_public_sale(f);
        window [-infinity, infinity];
    };
}
@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "no such firearm shall be sold at public sale")
rule W10AFirearmNoPublicSaleByAdministrator strict {
    label en official "section 5872(b): no firearm forfeited by reason of a violation of chapter 53 shall be sold at public sale (addressed also to the Administrator, who may sell it only to a State, possession or political subdivision)";
    for f: Firearm;
    when firearm_subject_to_5872b_disposal(f);
    then prohibition W10AFirearmNoPublicSaleByAdministratorProhibition {
        bearer GsaAdministrator;
        beneficiary Secretary;
        action firearm_sold_at_public_sale(f);
        window [-infinity, infinity];
    };
}

pub relation gsa_administrator_orders_firearm_destroyed(f: Firearm) kind empirical {
    label en official "the Administrator of General Services orders the delivered firearm destroyed (section 5872(b))";
}
pub relation firearm_ordered_destroyed(f: Firearm) kind institutional {
    label en official "the delivered firearm is ordered destroyed (section 5872(b))";
}
pub relation gsa_administrator_sells_firearm_to_state_or_political_subdivision(f: Firearm) kind empirical {
    label en official "the Administrator of General Services sells the delivered firearm to a State, or possession, or political subdivision thereof (section 5872(b))";
}
pub relation firearm_sold_to_state_or_political_subdivision(f: Firearm) kind institutional {
    label en official "the delivered firearm is sold to a State, or possession, or political subdivision thereof (section 5872(b))";
}
pub relation secretary_requests_retention_of_firearm_for_treasury_use(f: Firearm) kind empirical {
    label en official "the Secretary requests that the delivered firearm be retained for the official use of the Treasury Department (section 5872(b))";
}
pub relation gsa_administrator_authorizes_retention_of_firearm(f: Firearm) kind empirical {
    label en official "the Administrator of General Services authorizes the retention of the delivered firearm for the official use of the Treasury Department (section 5872(b))";
}
pub relation firearm_retained_for_treasury_official_use(f: Firearm) kind institutional {
    label en official "the delivered firearm is retained for the official use of the Treasury Department (section 5872(b))";
}
pub relation gsa_administrator_transfers_firearm_without_charge(f: Firearm) kind empirical {
    label en official "the Administrator of General Services transfers the delivered firearm without charge to an executive department or independent establishment of the Government for use by it (section 5872(b))";
}
pub relation firearm_transferred_to_federal_department_without_charge(f: Firearm) kind institutional {
    label en official "the delivered firearm is transferred without charge to an executive department or independent establishment of the Government for use by it (section 5872(b))";
}

@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "who may order such firearm destroyed")
rule W10AAdministratorMayOrderFirearmDestroyed defeasible {
    label en official "section 5872(b): the Administrator of General Services, to whom the firearm is delivered, may order it destroyed";
    for f: Firearm;
    when firearm_subject_to_5872b_disposal(f) and firearm_delivered_to_gsa_administrator(f);
    then power W10AFirearmDestructionPower {
        holder GsaAdministrator;
        over Secretary;
        exercise gsa_administrator_orders_firearm_destroyed(f);
        valid_when firearm_delivered_to_gsa_administrator(f);
        effect firearm_ordered_destroyed(f);
        window [-infinity, infinity];
    };
    unless firearm_forfeiture_remitted_or_mitigated(f) and firearm_subject_to_5872b_disposal(f) and firearm_delivered_to_gsa_administrator(f);
}
@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "may sell it to any State, or possession, or political subdivision thereof")
rule W10AAdministratorMaySellFirearmToState defeasible {
    label en official "section 5872(b): the Administrator of General Services may sell the delivered firearm to any State, or possession, or political subdivision thereof";
    for f: Firearm;
    when firearm_subject_to_5872b_disposal(f) and firearm_delivered_to_gsa_administrator(f);
    then power W10AFirearmSaleToStatePower {
        holder GsaAdministrator;
        over Secretary;
        exercise gsa_administrator_sells_firearm_to_state_or_political_subdivision(f);
        valid_when firearm_delivered_to_gsa_administrator(f);
        effect firearm_sold_to_state_or_political_subdivision(f);
        window [-infinity, infinity];
    };
    unless firearm_forfeiture_remitted_or_mitigated(f) and firearm_subject_to_5872b_disposal(f) and firearm_delivered_to_gsa_administrator(f);
}
@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "at the request of the Secretary, may authorize its retention for official use of the Treasury Department")
rule W10AAdministratorMayAuthorizeRetentionForTreasury defeasible {
    label en official "section 5872(b): the Administrator of General Services may, at the request of the Secretary, authorize the retention of the delivered firearm for official use of the Treasury Department";
    for f: Firearm;
    when firearm_subject_to_5872b_disposal(f) and firearm_delivered_to_gsa_administrator(f) and secretary_requests_retention_of_firearm_for_treasury_use(f);
    then power W10AFirearmRetentionPower {
        holder GsaAdministrator;
        over Secretary;
        exercise gsa_administrator_authorizes_retention_of_firearm(f);
        valid_when secretary_requests_retention_of_firearm_for_treasury_use(f);
        effect firearm_retained_for_treasury_official_use(f);
        window [-infinity, infinity];
    };
    unless firearm_forfeiture_remitted_or_mitigated(f) and firearm_subject_to_5872b_disposal(f) and firearm_delivered_to_gsa_administrator(f) and secretary_requests_retention_of_firearm_for_treasury_use(f);
}
@source(IRC_S5872_B, relation = formalizes, coverage = partial, quote = "may transfer it without charge to any executive department or independent establishment of the Government for use by it")
rule W10AAdministratorMayTransferFirearmToFederalDepartment defeasible {
    label en official "section 5872(b): the Administrator of General Services may transfer the delivered firearm without charge to any executive department or independent establishment of the Government for use by it";
    for f: Firearm;
    when firearm_subject_to_5872b_disposal(f) and firearm_delivered_to_gsa_administrator(f);
    then power W10AFirearmTransferPower {
        holder GsaAdministrator;
        over Secretary;
        exercise gsa_administrator_transfers_firearm_without_charge(f);
        valid_when firearm_delivered_to_gsa_administrator(f);
        effect firearm_transferred_to_federal_department_without_charge(f);
        window [-infinity, infinity];
    };
    unless firearm_forfeiture_remitted_or_mitigated(f) and firearm_subject_to_5872b_disposal(f) and firearm_delivered_to_gsa_administrator(f);
}

// =====================================================================================================================
// Section 5703(d): assessment of a chapter 52 tax that is not paid in full when due
// =====================================================================================================================
//
// "(d) Whenever any tax required to be paid by this chapter is not paid in full at the time required for such payment, it shall be the duty of the Secretary, subject
// to the limitations prescribed in section 6501, on proof satisfactory to him, to determine the amount of tax which has been omitted to be paid, and to make an
// assessment therefor against the person liable for the tax. ... Except in cases where delay may jeopardize collection of the tax, or where the amount is nominal or
// the result of an evident mathematical error, no such assessment shall be made until and after the person liable for the tax has been afforded reasonable notice and
// opportunity to show cause, in writing, against such assessment."
//
// The duty and the prior-notice prohibition are formalized here; the machinery is `us.irc.assessment` (sections 6201, 6203, 6501). `us.irc.assessment` imports this
// package (the reverse import is a cycle): it derives the stub `tobacco_assessment_barred_by_6501` (qualified head) from its own limitation period and reads the
// assessment made here as the exercise of its section 6201 authority (module 96-wire10-A-assessment.law).
//
// JUDGMENT CALLS
//  - "not paid in full at the time required" is the case-asserted omitted amount per event (the payment deadline itself is derived above in `tobacco_tax_deadline`).
//  - "on proof satisfactory to him" is the Secretary's own judgment: the duty is conditioned on the determination fact `tobacco_secretary_satisfied_of_omission`.
//  - The three exceptions (jeopardy, nominal amount, evident mathematical error) are case facts; "nominal" is not given a threshold by the statute.
//  - The taxable year of the event (bridge `tobacco_event_taxable_year`) is a case fact: chapter 52 tax is per event, the assessment clock is per (person, year, kind).

pub relation tobacco_tax_omitted_from_payment(e: TobaccoRemovalEvent, p: Person, amount: Money) kind empirical {
    label en official "the tax required to be paid by chapter 52 on the event is not paid in full at the time required: the amount of tax omitted to be paid, against the person liable";
}
pub relation tobacco_secretary_satisfied_of_omission(e: TobaccoRemovalEvent, p: Person) kind empirical {
    label en official "on proof satisfactory to the Secretary, the amount of tax omitted to be paid is determined";
}
pub relation tobacco_event_taxable_year(e: TobaccoRemovalEvent, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxable year under which the assessment of the event's tax is recorded (bridge to the section 6501 clock)";
}
pub relation tobacco_assessment_considered_on(e: TobaccoRemovalEvent, on: Date) kind empirical {
    label en unofficial "the day as of which the duty to assess is considered (a rule body has no ambient date): compared with the end of the section 6501 period";
}
pub relation tobacco_assessment_barred_by_6501(e: TobaccoRemovalEvent, p: Person) kind institutional {
    label en official "the assessment of the tax omitted on the event is barred by the limitations prescribed in section 6501 (derived by us.irc.assessment)";
}
pub relation tobacco_assessment_made(e: TobaccoRemovalEvent, p: Person, a: us.irc.core::Assessment, amount: Money) kind empirical {
    label en official "the Secretary makes the assessment of the omitted tax against the person liable for the tax (recorded as the assessment a)";
}
@source(IRC_S5703_D, relation = formalizes, coverage = partial, quote = "it shall be the duty of the Secretary, subject to the limitations prescribed in section 6501, on proof satisfactory to him, to determine the amount of tax which has been omitted to be paid, and to make an assessment therefor against the person liable for the tax")
rule W10ATobaccoAssessmentDuty defeasible {
    label en official "section 5703(d): the Secretary shall determine and assess the tax omitted to be paid, subject to the section 6501 limitations";
    for e: TobaccoRemovalEvent;
    for p: Person;
    for omitted: Money;
    when tobacco_tax_omitted_from_payment(e, p, omitted) and tobacco_secretary_satisfied_of_omission(e, p);
    then duty W10ATobaccoAssessOmittedTaxDuty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition tobacco_assessment_recorded(e, p);
            window [-infinity, infinity];
        }
    };
    unless tobacco_assessment_barred_by_6501(e, p) and tobacco_tax_omitted_from_payment(e, p, omitted) and tobacco_secretary_satisfied_of_omission(e, p);
}
pub relation tobacco_assessment_recorded(e: TobaccoRemovalEvent, p: Person) kind empirical {
    label en unofficial "an assessment of the omitted tax of the event is recorded against the person";
}
pub relation tobacco_notice_and_opportunity_to_show_cause_afforded(e: TobaccoRemovalEvent, p: Person) kind empirical {
    label en official "the person liable for the tax has been afforded reasonable notice and opportunity to show cause, in writing, against the assessment";
}
pub relation tobacco_delay_may_jeopardize_collection(e: TobaccoRemovalEvent, p: Person) kind empirical {
    label en official "delay may jeopardize collection of the tax";
}
pub relation tobacco_omitted_amount_nominal(e: TobaccoRemovalEvent, p: Person) kind empirical {
    label en official "the amount omitted is nominal";
}
pub relation tobacco_omission_result_of_evident_mathematical_error(e: TobaccoRemovalEvent, p: Person) kind empirical {
    label en official "the omission is the result of an evident mathematical error";
}
pub relation tobacco_assessment_made_before_notice(e: TobaccoRemovalEvent, p: Person) kind empirical {
    label en official "the assessment is made before the person liable has been afforded notice and opportunity to show cause";
}
pub relation tobacco_assessment_notice_exception(e: TobaccoRemovalEvent, p: Person) kind institutional {
    label en official "the prior notice is not required: delay may jeopardize collection, or the amount is nominal, or it is the result of an evident mathematical error";
}
rule W10ATobaccoNoticeExceptionJeopardy strict {
    label en official "section 5703(d): jeopardy excepts the assessment from the prior notice";
    for e: TobaccoRemovalEvent;
    for p: Person;
    when tobacco_delay_may_jeopardize_collection(e, p);
    then tobacco_assessment_notice_exception(e, p);
}
rule W10ATobaccoNoticeExceptionNominal strict {
    label en official "section 5703(d): a nominal amount excepts the assessment from the prior notice";
    for e: TobaccoRemovalEvent;
    for p: Person;
    when tobacco_omitted_amount_nominal(e, p);
    then tobacco_assessment_notice_exception(e, p);
}
rule W10ATobaccoNoticeExceptionMathError strict {
    label en official "section 5703(d): an evident mathematical error excepts the assessment from the prior notice";
    for e: TobaccoRemovalEvent;
    for p: Person;
    when tobacco_omission_result_of_evident_mathematical_error(e, p);
    then tobacco_assessment_notice_exception(e, p);
}
@source(IRC_S5703_D, relation = formalizes, coverage = partial, quote = "no such assessment shall be made until and after the person liable for the tax has been afforded reasonable notice and opportunity to show cause, in writing, against such assessment")
rule W10ATobaccoNoAssessmentBeforeShowCause defeasible {
    label en official "section 5703(d): outside the exceptions, no assessment is made before the person liable is afforded reasonable notice and opportunity to show cause";
    for e: TobaccoRemovalEvent;
    for p: Person;
    for omitted: Money;
    when tobacco_tax_omitted_from_payment(e, p, omitted);
    then prohibition W10ATobaccoNoAssessmentBeforeNoticeProhibition {
        bearer Secretary;
        beneficiary p;
        action tobacco_assessment_made_before_notice(e, p);
        window [-infinity, infinity];
    };
    unless tobacco_assessment_notice_exception(e, p) and tobacco_tax_omitted_from_payment(e, p, omitted);
    unless tobacco_notice_and_opportunity_to_show_cause_afforded(e, p) and tobacco_tax_omitted_from_payment(e, p, omitted);
}
