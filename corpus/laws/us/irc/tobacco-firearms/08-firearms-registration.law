// Chapter 53, subchapter B part I: section 5841 (National Firearms
// Registration and Transfer Record), section 5842 (identification of
// firearms), section 5843 (records and returns), section 5844
// (importation). Priority section 5841, IRC-14 stage 1.

// =====================================================================
// Section 5841 — registration of firearms
// =====================================================================

use self::{
    Firearm,
    FirearmCategory,
    FirearmMakingEvent,
    FirearmTradeRole,
    FirearmTransferEvent,
    IRC_S5841_A,
    IRC_S5841_B,
    IRC_S5841_C,
    IRC_S5841_E,
    IRC_S5842_A,
    IRC_S5842_B,
    IRC_S5842_C,
    IRC_S5843,
    IRC_S5844,
    Person,
    Secretary,
    firearm_category,
    firearm_making_approved,
    firearm_making_event,
    firearm_trade_person,
    firearm_transfer_approved,
    firearm_transfer_event,
};

@source(IRC_S5841_A, relation = formalizes, coverage = exact, quote = "The Secretary shall maintain a central registry of all firearms in the United States which are not in the possession or under the control of the United States. This registry shall be known as the National Firearms Registration and Transfer Record.")
rule NfrtrMaintenanceDuty() strict {
    when true;
    then duty MaintainNfrtr {
        bearer Secretary;
        beneficiary us.irc.core::Congress;
        goal maintenance {
            condition nfrtr_maintained();
            window [-infinity, infinity];
        }
    };
}
pub relation nfrtr_maintained() kind empirical {
    label en unofficial "the case asserts the Secretary is in fact maintaining the National Firearms Registration and Transfer Record (identification of the firearm, date of registration, identification/address of the person entitled to possession -- section 5841(a)(1)-(3))";
}

pub relation firearm_manufactured_imported_or_made_by(f: Firearm, p: Person) kind empirical {
    label en unofficial "section 5841(b) first sentence: this person manufactured, imported, or made this firearm";
}
@source(IRC_S5841_B, relation = formalizes, coverage = exact, quote = "Each manufacturer, importer, and maker shall register each firearm he manufactures, imports, or makes.")
rule FirearmRegistrationDutyMakerImporterManufacturer(f: Firearm, p: Person) defeasible {
    when firearm_manufactured_imported_or_made_by(f, p);
    then duty RegisterManufacturedImportedOrMadeFirearm {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition firearm_registered(f);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S5841_B, relation = formalizes, coverage = exact, quote = "Each firearm transferred shall be registered to the transferee by the transferor.")
rule FirearmRegistrationDutyTransferor(e: FirearmTransferEvent, transferor: Person) defeasible {
    when firearm_transfer_event(e, _, transferor, _, _);
    then duty RegisterTransferredFirearm {
        bearer transferor;
        beneficiary Secretary;
        goal achievement {
            condition firearm_transfer_registered(e);
            window [-infinity, infinity];
        }
    };
}
pub relation firearm_registered(f: Firearm) kind empirical;
pub relation firearm_transfer_registered(e: FirearmTransferEvent) kind empirical;

// section 5841(c): a manufacturer's notification of manufacture EFFECTS
// registration; an importer's/maker's/transferor's pre-transaction
// authorization EFFECTS registration. Modeled as the institutional
// consequence of the already-modeled section 5812/5822 approvals.
@source(IRC_S5841_C, relation = formalizes, coverage = exact, quote = "Each manufacturer shall notify the Secretary of the manufacture of a firearm in such manner as may by regulations be prescribed and such notification shall effect the registration of the firearm required by this section.")
rule FirearmManufactureNotificationEffectsRegistration(f: Firearm, p: Person) strict {
    when firearm_manufacture_notified(f, p);
    then firearm_registered(f);
}
pub relation firearm_manufacture_notified(f: Firearm, p: Person) kind empirical;
@source(IRC_S5841_C, relation = formalizes, coverage = exact, quote = "such authorization shall effect the registration of the firearm required by this section")
rule FirearmMakingApprovalEffectsRegistration(e: FirearmMakingEvent, maker: Person, f: Firearm) strict {
    when firearm_making_approved(e, maker) and firearm_making_event(e, f, maker, _);
    then firearm_registered(f);
}
@source(IRC_S5841_C, relation = formalizes, coverage = exact, quote = "such authorization shall effect the registration of the firearm required by this section")
rule FirearmTransferApprovalEffectsRegistration(e: FirearmTransferEvent, transferee: Person) strict {
    when firearm_transfer_approved(e, transferee);
    then firearm_transfer_registered(e);
}

// section 5841(d): firearms already recorded under the pre-1968 National
// Firearms Act are DEEMED registered -- a one-time transition rule about a
// historical possession record this package has no data source for
// (classified SOURCE_GAP/NON_NORMATIVE: the transition window closed
// decades ago and no current scenario reads it).

pub relation firearm_registration_retained(p: Person, f: Firearm) kind empirical {
    label en unofficial "section 5841(e): the case asserts this person, possessing a registered firearm, retains proof of registration";
}
@source(IRC_S5841_E, relation = formalizes, coverage = exact, quote = "A person possessing a firearm registered as required by this section shall retain proof of registration which shall be made available to the Secretary upon request.")
rule FirearmProofOfRegistrationDuty(p: Person, f: Firearm) defeasible {
    when firearm_registered(f) and firearm_possessor(p, f);
    then duty RetainProofOfFirearmRegistration {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition firearm_registration_retained(p, f);
            window [-infinity, infinity];
        }
    };
}
pub relation firearm_possessor(p: Person, f: Firearm) kind empirical {
    label en unofficial "the case asserts this person currently possesses this firearm";
}

// =====================================================================
// Section 5842 — identification of firearms
// =====================================================================

pub relation firearm_serial_number_assigned(f: Firearm) kind empirical {
    label en unofficial "section 5842(a): the firearm bears a non-removable/non-obliterable/non-alterable serial number, the manufacturer/importer/maker's name, and other Secretary-prescribed identification";
}
@source(IRC_S5842_A, relation = formalizes, coverage = exact, quote = "Each manufacturer and importer and anyone making a firearm shall identify each firearm, other than a destructive device, manufactured, imported, or made by a serial number which may not be readily removed, obliterated, or altered, the name of the manufacturer, importer, or maker, and such other identification as the Secretary may by regulations prescribe.")
rule FirearmIdentificationDuty(f: Firearm, p: Person) defeasible {
    when firearm_manufactured_imported_or_made_by(f, p) and not_known(firearm_category(f, DestructiveDevice));
    then duty IdentifyFirearm {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition firearm_serial_number_assigned(f);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S5842_B, relation = formalizes, coverage = exact, quote = "Any person who possesses a firearm, other than a destructive device, which does not bear the serial number and other information required by subsection (a) of this section shall identify the firearm with a serial number assigned by the Secretary and any other information the Secretary may by regulations prescribe.")
rule FirearmWithoutSerialNumberDuty(p: Person, f: Firearm) defeasible {
    when firearm_possessor(p, f) and not_known(firearm_category(f, DestructiveDevice)) and not_known(firearm_serial_number_assigned(f));
    then duty IdentifyUnserializedFirearm {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition firearm_serial_number_assigned(f);
            window [-infinity, infinity];
        }
    };
}
pub relation destructive_device_identified(f: Firearm) kind empirical {
    label en unofficial "section 5842(c): the destructive device is identified as the Secretary's regulations prescribe";
}
@source(IRC_S5842_C, relation = formalizes, coverage = exact, quote = "Any firearm classified as a destructive device shall be identified in such manner as the Secretary may by regulations prescribe.")
rule DestructiveDeviceIdentificationDuty(f: Firearm, p: Person) defeasible {
    when firearm_manufactured_imported_or_made_by(f, p) and firearm_category(f, DestructiveDevice);
    then duty IdentifyDestructiveDevice {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition destructive_device_identified(f);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 5843 — records and returns
// =====================================================================

@source(IRC_S5843, relation = formalizes, coverage = exact, quote = "Importers, manufacturers, and dealers shall keep such records of, and render such returns in relation to, the importation, manufacture, making, receipt, and sale, or other disposition, of firearms as the Secretary may by regulations prescribe.")
rule FirearmRecordsAndReturnsDuty(p: Person, trole: FirearmTradeRole) defeasible {
    when firearm_trade_person(p, trole);
    then duty MaintainFirearmRecordsAndReturns {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition firearm_records_and_returns_current(p);
            window [-infinity, infinity];
        }
    };
}
pub relation firearm_records_and_returns_current(p: Person) kind empirical;

// =====================================================================
// Section 5844 — importation
// =====================================================================

pub enum FirearmImportationGround { UnitedStatesOrStateUse; ScientificOrResearchPurpose; TestingOrModelOrSample; }
pub relation firearm_importation_event(f: Firearm, importer: Person, ground: FirearmImportationGround) kind empirical {
    label en unofficial "section 5844(1)-(3): the importer establishes, under Secretary regulations, one of the three grounds for importing/bringing a firearm into the United States or its territories";
}
pub relation firearm_conditional_importation_for_classification(f: Firearm, importer: Person) kind empirical {
    label en unofficial "section 5844 proviso: the Secretary permits conditional importation for examination/testing in connection with classifying the firearm";
}
@source(IRC_S5844, relation = formalizes, coverage = exact, quote = "No firearm shall be imported or brought into the United States or any territory under its control or jurisdiction unless the importer establishes, under regulations as may be prescribed by the Secretary, that the firearm to be imported or brought in is")
rule FirearmImportationRestricted(f: Firearm, importer: Person) defeasible {
    when firearm_possessor(importer, f);
    then prohibition NoUnauthorizedFirearmImportation {
        bearer importer;
        beneficiary Secretary;
        action firearm_imported_without_authorization(f, importer);
        window [-infinity, infinity];
    };
    unless firearm_importation_authorized(f, importer);
}
pub relation firearm_imported_without_authorization(f: Firearm, importer: Person) kind empirical;
pub relation firearm_importation_authorized(f: Firearm, importer: Person) kind institutional {
    label en official "section 5844(1)-(3) (or the conditional-importation-for-classification proviso): the importation is authorized";
}
rule FirearmImportationAuthorizedByGround(f: Firearm, importer: Person, ground: FirearmImportationGround) strict {
    when firearm_importation_event(f, importer, ground);
    then firearm_importation_authorized(f, importer);
}
rule FirearmImportationAuthorizedConditional(f: Firearm, importer: Person) strict {
    when firearm_conditional_importation_for_classification(f, importer);
    then firearm_importation_authorized(f, importer);
}
