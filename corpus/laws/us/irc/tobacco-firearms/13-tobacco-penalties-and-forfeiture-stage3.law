// Stage 3 (TECH_GAP reduction), part B: chapter 52 packages, export, penalties and forfeitures. Sections 5723(e) (exemption
// from the package requirement), 5754(a)(3) (exportation includes shipment to Puerto Rico), 5761(c)-(d) (the section 5704(b)
// and (d) carve-outs, the delivery-sale limit on the personal use exception), 5763(b)-(d) (forfeiture of packages, machinery,
// fixtures, premises and property used in violations).
//
// JUDGMENT CALLS:
// (1) Section 5761(c) "Except as provided in subsections (b) and (d) of section 5704": read as a carve-out for a sale, relanding
//     or receipt that is itself a transfer in bond or export removal under 5704(b) or a release of returned articles under 5704(d);
//     the carve-out is keyed on the movement (person, event), not on the earlier tax-free export removal of the same article,
//     which would swallow the very relanding the penalty punishes.
// (2) Section 5723(e) is read as exempting, by regulation (asserted), employee-use/experimental furnishing and transfers in
//     bond or releases in bond described in 5704(b)/(c); the 5704(b) fact also covers export removals (broader than the text of
//     (e), which names transfers to bonded premises).
// (3) Section 5763(b)-(c): "qualified" is read as holding an approved bond and a granted permit; the court's finding of intent to
//     defraud is an external judgment relation (DECISION-0194).

// =====================================================================
// Section 5723(e): exemption from the package requirement
// =====================================================================

use self::{
    IRC_S5723_A,
    IRC_S5723_E,
    IRC_S5754_A,
    IRC_S5761_C,
    IRC_S5761_D,
    IRC_S5763_B,
    IRC_S5763_C,
    IRC_S5763_D,
    Person,
    TobaccoRemovalEvent,
    tobacco_bond_approved,
    tobacco_bond_filed,
    tobacco_bonded_transfer_or_export_removal,
    tobacco_business_operator,
    tobacco_for_employee_use_or_experimental,
    tobacco_labeled_for_export,
    tobacco_package_exempted_from_ab,
    tobacco_packaged_before_removal,
    tobacco_permit_granted,
    tobacco_relanded_or_received_within_jurisdiction,
    tobacco_relanded_personal_use_quantity,
    tobacco_released_from_customs_custody_for_export_warehouse,
    tobacco_shipped_from_united_states,
};

pub relation tobacco_package_requirement_met_or_exempt(e: TobaccoRemovalEvent) kind institutional {
    label en official "section 5723(a), (e): the article was put up in the prescribed packages before removal, or is exempted from (a) and (b) by regulation";
}
@source(IRC_S5723_A, relation = formalizes, coverage = exact, quote = "All tobacco products, processed tobacco, and cigarette papers and tubes shall, before removal, be put up in such packages as the Secretary shall by regulation prescribe.")
rule TobaccoPackageRequirementMet(e: TobaccoRemovalEvent) strict {
    when tobacco_packaged_before_removal(e);
    then tobacco_package_requirement_met_or_exempt(e);
}
@source(IRC_S5723_E, relation = formalizes, coverage = exact, quote = "may be exempted from subsection (a) and (b) in accordance with such regulations as the Secretary shall prescribe.")
rule TobaccoPackageExemptEmployeeUse(e: TobaccoRemovalEvent) strict {
    when tobacco_package_exempted_from_ab(e) and tobacco_for_employee_use_or_experimental(e);
    then tobacco_package_requirement_met_or_exempt(e);
}
@source(IRC_S5723_E, relation = formalizes, coverage = exact, quote = "may be exempted from subsection (a) and (b) in accordance with such regulations as the Secretary shall prescribe.")
rule TobaccoPackageExemptBondedTransfer(e: TobaccoRemovalEvent) strict {
    when tobacco_package_exempted_from_ab(e) and tobacco_bonded_transfer_or_export_removal(e);
    then tobacco_package_requirement_met_or_exempt(e);
}
@source(IRC_S5723_E, relation = formalizes, coverage = exact, quote = "may be exempted from subsection (a) and (b) in accordance with such regulations as the Secretary shall prescribe.")
rule TobaccoPackageExemptCustomsRelease(e: TobaccoRemovalEvent) strict {
    when tobacco_package_exempted_from_ab(e) and tobacco_released_from_customs_custody_for_export_warehouse(e);
    then tobacco_package_requirement_met_or_exempt(e);
}

// =====================================================================
// Section 5754(a)(3): exportation includes shipment to Puerto Rico
// =====================================================================

pub relation tobacco_shipped_to_puerto_rico(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5754(a)(3): the article was shipped to the Commonwealth of Puerto Rico";
}
pub relation tobacco_treated_as_exported_5754a3(e: TobaccoRemovalEvent) kind institutional {
    label en official "sections 5754(a)(3), 5704(d), 5761: the article was exported, shipped for exportation, labeled for export, or shipped to Puerto Rico, which is treated as exportation";
}
@source(IRC_S5754_A, relation = formalizes, coverage = exact, quote = "references to exportation shall be treated as including a reference to shipment to the Commonwealth of Puerto Rico")
rule TobaccoTreatedAsExportedPuertoRico(e: TobaccoRemovalEvent) strict {
    when tobacco_shipped_to_puerto_rico(e);
    then tobacco_treated_as_exported_5754a3(e);
}
@source(IRC_S5754_A, relation = formalizes, coverage = partial, quote = "Tobacco products and cigarette papers and tubes manufactured in the United States and labeled for exportation under this chapter")
rule TobaccoTreatedAsExportedShipped(e: TobaccoRemovalEvent) strict {
    when tobacco_shipped_from_united_states(e);
    then tobacco_treated_as_exported_5754a3(e);
}
@source(IRC_S5754_A, relation = formalizes, coverage = partial, quote = "Tobacco products and cigarette papers and tubes manufactured in the United States and labeled for exportation under this chapter")
rule TobaccoTreatedAsExportedLabeled(e: TobaccoRemovalEvent) strict {
    when tobacco_labeled_for_export(e);
    then tobacco_treated_as_exported_5754a3(e);
}

// =====================================================================
// Section 5761(c)-(d): relanding, carve-outs and delivery sales
// =====================================================================

pub relation tobacco_sold_relanded_or_received_activity(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5761(c)(1)-(3): the person sold, relanded, received (or aided or abetted) the article within the jurisdiction of the United States; whether the article was labeled or shipped for exportation (including to Puerto Rico) is derived";
}
pub relation tobacco_reland_5761c_applies(p: Person, e: TobaccoRemovalEvent) kind institutional {
    label en official "section 5761(c): the person sold, relanded or received within the jurisdiction an article labeled or shipped for exportation";
}
@source(IRC_S5761_C, relation = formalizes, coverage = exact, quote = "every person who sells, relands, or receives within the jurisdiction of the United States any tobacco products or cigarette papers or tubes which have been labeled or shipped for exportation under this chapter")
rule TobaccoReland5761cAsserted(p: Person, e: TobaccoRemovalEvent) strict {
    when tobacco_relanded_or_received_within_jurisdiction(p, e);
    then tobacco_reland_5761c_applies(p, e);
}
@source(IRC_S5761_C, relation = formalizes, coverage = exact, quote = "every person who sells, relands, or receives within the jurisdiction of the United States any tobacco products or cigarette papers or tubes which have been labeled or shipped for exportation under this chapter")
rule TobaccoReland5761cDerived(p: Person, e: TobaccoRemovalEvent) strict {
    when tobacco_sold_relanded_or_received_activity(p, e) and tobacco_treated_as_exported_5754a3(e);
    then tobacco_reland_5761c_applies(p, e);
}
pub relation tobacco_movement_under_5704b(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5761(c) lead-in: the sale, relanding or receipt is itself a transfer in bond or export removal that section 5704(b) allows";
}
pub relation tobacco_movement_under_5704d(p: Person, e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5761(c) lead-in: the receipt is a release of returned articles that section 5704(d) allows";
}
pub relation tobacco_carved_out_by_5704b_or_d(p: Person, e: TobaccoRemovalEvent) kind institutional {
    label en official "section 5761(c): except as provided in subsections (b) and (d) of section 5704";
}
@source(IRC_S5761_C, relation = formalizes, coverage = exact, quote = "Except as provided in subsections (b) and (d) of section 5704—")
rule TobaccoCarvedOutBy5704b(p: Person, e: TobaccoRemovalEvent) strict {
    when tobacco_movement_under_5704b(p, e);
    then tobacco_carved_out_by_5704b_or_d(p, e);
}
@source(IRC_S5761_C, relation = formalizes, coverage = exact, quote = "Except as provided in subsections (b) and (d) of section 5704—")
rule TobaccoCarvedOutBy5704d(p: Person, e: TobaccoRemovalEvent) strict {
    when tobacco_movement_under_5704d(p, e);
    then tobacco_carved_out_by_5704b_or_d(p, e);
}

pub relation tobacco_sold_to_consumer(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5761(d)(3)(B): the tobacco product was sold to a consumer";
}
pub relation tobacco_order_placed_remotely(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5761(d)(3)(B)(i): the consumer submitted the order by telephone or other voice transmission, the mail, or the Internet or other online service, or the seller was otherwise not in the physical presence of the buyer when the order was made";
}
pub relation tobacco_delivered_remotely(e: TobaccoRemovalEvent) kind empirical {
    label en unofficial "section 5761(d)(3)(B)(ii): the product was delivered by a common carrier, private delivery service or the mail, or the seller was not in the physical presence of the buyer when the buyer obtained possession";
}
pub relation tobacco_delivery_sale(e: TobaccoRemovalEvent) kind institutional {
    label en official "section 5761(d)(3)(B): a sale of a tobacco product to a consumer ordered remotely or delivered remotely";
}
@source(IRC_S5761_D, relation = formalizes, coverage = exact, quote = "(i) the consumer submits the order for such sale by means of a telephone or other method of voice transmission, the mail, or the Internet or other online service, or the seller is otherwise not in the physical presence of the buyer when the request for purchase or order is made, or")
rule TobaccoDeliverySaleByOrder(e: TobaccoRemovalEvent) strict {
    when tobacco_sold_to_consumer(e) and tobacco_order_placed_remotely(e);
    then tobacco_delivery_sale(e);
}
@source(IRC_S5761_D, relation = formalizes, coverage = exact, quote = "(ii) the tobacco product is delivered by use of a common carrier, private delivery service, or the mail, or the seller is not in the physical presence of the buyer when the buyer obtains personal possession of the tobacco product.")
rule TobaccoDeliverySaleByDelivery(e: TobaccoRemovalEvent) strict {
    when tobacco_sold_to_consumer(e) and tobacco_delivered_remotely(e);
    then tobacco_delivery_sale(e);
}
pub relation tobacco_personal_use_exception_5761d2(p: Person, e: TobaccoRemovalEvent) kind institutional {
    label en official "section 5761(d)(2)-(3): the personal use quantity exception applies, unless the product was sold in connection with a delivery sale";
}
@source(IRC_S5761_D, relation = formalizes, coverage = exact, quote = "Paragraph (2) shall not apply to any tobacco product sold in connection with a delivery sale.")
rule TobaccoPersonalUseExceptionNotForDeliverySale(p: Person, e: TobaccoRemovalEvent) strict {
    when tobacco_relanded_personal_use_quantity(p, e) and not_known(tobacco_delivery_sale(e));
    then tobacco_personal_use_exception_5761d2(p, e);
}

// =====================================================================
// Section 5763(b)-(d): forfeiture of property on the premises of an operator
// =====================================================================

pub entity TobaccoProperty;
pub enum TobaccoPropertyKind { TobaccoArticle; Package; Machinery; Fixture; Equipment; OtherMaterial; OtherPersonalProperty; Building; Land; }
pub enum TobaccoOperatorFraudAct { FailsToKeepOrMakeRecord; FalseOrFraudulentRecord; RefusesToPayTax; EvadesTaxOrPayment; RemovesArticleContrary; }

pub relation tobacco_property_on_premises(prop: TobaccoProperty, operator: Person, kind: TobaccoPropertyKind) kind empirical {
    label en unofficial "section 5763(b)-(c): the property (or the operator's right, title and interest in the building or the lot) is on the premises of the operator";
}
pub relation tobacco_operator_fraud_act(operator: Person, act: TobaccoOperatorFraudAct) kind empirical {
    label en unofficial "section 5763(b): the operator failed to keep or make a required record, return, report or inventory, or kept or made a false or fraudulent one; refused to pay a tax or attempted to evade or defeat it or its payment; or removed an article subject to tax contrary to this chapter";
}
pub external judgment relation established_operator_intent_to_defraud(operator: Person) {
    authority DistrictCourt;
    label en official "section 5763(b): the court finds the operator acted with intent to defraud the United States (DECISION-0194: evaluative element, channel: adjudicated fact)";
}
pub relation tobacco_property_intended_or_used_in_violation(prop: TobaccoProperty) kind empirical {
    label en unofficial "section 5763(d): the property is intended for use in violating this chapter or its regulations, or has been so used";
}
pub relation tobacco_property_forfeited(prop: TobaccoProperty) kind institutional {
    label en official "section 5763(b)-(d): the property is forfeited to the United States (subsection (d): as provided in section 7302)";
}
@source(IRC_S5763_B, relation = formalizes, coverage = exact, quote = "packages, machinery, fixtures, equipment, and all other materials and personal property on the premises of any qualified manufacturer or importer of tobacco products or cigarette papers and tubes, or export warehouse proprietor, who, with intent to defraud the United States")
rule TobaccoPropertyForfeitedFraudulentQualifiedOperator(prop: TobaccoProperty, op: Person, k: TobaccoPropertyKind, act: TobaccoOperatorFraudAct) defeasible {
    when tobacco_property_on_premises(prop, op, k)
        and k != Building
        and k != Land
        and tobacco_bond_approved(op)
        and tobacco_permit_granted(op)
        and tobacco_operator_fraud_act(op, act)
        and established_operator_intent_to_defraud(op);
    then tobacco_property_forfeited(prop);
}
@source(IRC_S5763_C, relation = formalizes, coverage = exact, quote = "without filing the bond or obtaining the permit, as required by this chapter, together with all his right, title, and interest in the building in which such business is conducted, and the lot or tract of ground on which the building is located, shall be forfeited to the United States.")
rule TobaccoPropertyForfeitedIllicitOperatorNoBond(prop: TobaccoProperty, op: Person, k: TobaccoPropertyKind) defeasible {
    when tobacco_property_on_premises(prop, op, k) and tobacco_business_operator(op) and not_known(tobacco_bond_filed(op));
    then tobacco_property_forfeited(prop);
}
@source(IRC_S5763_C, relation = formalizes, coverage = exact, quote = "without filing the bond or obtaining the permit, as required by this chapter, together with all his right, title, and interest in the building in which such business is conducted, and the lot or tract of ground on which the building is located, shall be forfeited to the United States.")
rule TobaccoPropertyForfeitedIllicitOperatorNoPermit(prop: TobaccoProperty, op: Person, k: TobaccoPropertyKind) defeasible {
    when tobacco_property_on_premises(prop, op, k) and tobacco_business_operator(op) and not_known(tobacco_permit_granted(op));
    then tobacco_property_forfeited(prop);
}
@source(IRC_S5763_D, relation = formalizes, coverage = exact, quote = "All property intended for use in violating the provisions of this chapter, or regulations thereunder, or which has been so used, shall be forfeited to the United States as provided in section 7302.")
rule TobaccoPropertyForfeitedUsedInViolation(prop: TobaccoProperty) strict {
    when tobacco_property_intended_or_used_in_violation(prop);
    then tobacco_property_forfeited(prop);
}
