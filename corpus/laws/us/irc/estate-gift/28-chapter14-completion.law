// 26 U.S.C. §2701(a)(2)-(4), (c), (d), (e)(1)-(5); §2702(a)(3), (c), (d), (e);
// §2704(b)(3), (c); §2801(e)(4) — the rest of chapter 14 special valuation and
// the trust rules of the covered-expatriate tax. Stage 2 (DECISION-0379 with
// deontics) of `us.irc.estate_gift` (B01/IRC-11); continues
// 13-chapter14-special-valuation.law and 14-covered-expatriate-2801.law.
//
// SHAPE. Powers: the (c)(3)(C) elections about qualified payments (out for the
// transferor, in for an applicable family member, in for a right that is not
// otherwise a qualified payment), the §2701(d)(3)(A)(iii) election to treat a late
// payment as a taxable event, the foreign-trust election and its revocation
// with the Secretary's consent (§2801(e)(4)(B)(iii)). Prohibition: an election
// under (c)(3)(C) is irrevocable (iii). No new duties: chapter 14 imposes none.
//
// JUDGMENT CALLS
//  - (a)(3)(B): the value "as if each liquidation, put, call or conversion right
//    were exercised in the manner resulting in the lowest value" is the least of
//    the values the case asserts under each exercise scenario (a candidate plus
//    "no strictly lower candidate" step); the valuation under a scenario itself
//    is an appraisal and is asserted.
//  - (d)(2)(A): the reinvestment at the discount rate is a compounding ledger
//    over an indefinite period; both values are asserted, only the (C) grace
//    period (payments within 4 years of the due date are treated as paid when due),
//    the excess, the (B) limit (applicable percentage of the growth of the junior
//    equity) and the resulting increase are computed (TECH-GAPS G3618).
//  - The increase is published as `estate_increase_2701d` / `gift_increase_2701d`
//    (keyed by the event date; the gift year is the calendar year of the event) and
//    is NOT added into the taxable estate or taxable gifts yet (TECH-GAPS G3619).
//  - (e)(3): "to the extent held indirectly" is a qualitative attribution here;
//    the proportion of the indirect holding is a case fact of the interest, not
//    computed (TECH-GAPS G3620).
//  - (e)(6) and (e)(7), §2702(a)(3)(A)(iii), §2704(a)(3), (b)(4) delegate to
//    regulations: EXTERNAL_DEPENDENCY, no norm is invented.
//  - §2702(d): the portion factor is applied to the value of the retained interest
//    in the trust when the case asserts the value for the whole trust.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    IRC_S2701_A,
    IRC_S2701_C,
    IRC_S2701_D,
    IRC_S2701_E,
    IRC_S2702_A,
    IRC_S2702_C,
    IRC_S2702_D,
    IRC_S2704_B,
    IRC_S2704_C,
    IRC_S2801_E,
    Individual,
    Person,
    Secretary,
    Trust,
    applicable_family_member_2701,
    covered_expatriate,
    covered_gift_or_bequest_excepted,
    family_controls_entity_before_transfer_2704,
    qualified_payment_value_2701,
    retained_right_is_qualified_payment,
    retained_trust_interest,
    section_2701_value,
    section_2702_value,
    taxable_covered_gift_item,
    transfer_of_entity_interest_to_family_member,
};

// =====================================================================
// §2701(e)(1),(2),(4): family
// =====================================================================

pub relation spouse_2701(a: Person, b: Person) kind empirical {
    label en unofficial "a and b are spouses";
}
pub relation lineal_descendant_by_blood_2701(d: Person, of: Person) kind empirical {
    label en unofficial "d is a lineal descendant of the person by blood";
}
pub relation lineal_descendant_by_adoption_2701(d: Person, of: Person) kind empirical {
    label en unofficial "d is a lineal descendant of the person by legal adoption";
}
pub relation ancestor_by_blood_2701(a: Person, of: Person) kind empirical {
    label en unofficial "a is an ancestor of the person by blood";
}
pub relation sibling_2701(a: Person, b: Person) kind empirical {
    label en unofficial "a is a brother or sister of b";
}

@source(IRC_S2701_E, relation = formalizes, coverage = exact, quote = "A relationship by legal adoption shall be treated as a relationship by blood.")
relation lineal_descendant_2701(d: Person, of: Person) kind institutional {
    label en official "a lineal descendant, a relationship by legal adoption being treated as one by blood (section 2701(e)(4))";
}
rule LinealDescendantByBloodRule(d: Person, of: Person) defeasible {
    when lineal_descendant_by_blood_2701(d, of);
    then lineal_descendant_2701(d, of);
}
rule LinealDescendantByAdoptionRule(d: Person, of: Person) defeasible {
    label en official "adoption is treated as blood (section 2701(e)(4))";
    when lineal_descendant_by_adoption_2701(d, of);
    then lineal_descendant_2701(d, of);
}

@source(IRC_S2701_E, relation = formalizes, coverage = exact, quote = "the transferor's spouse")
pub relation member_of_family_2701e1(m: Person, transferor: Person) kind institutional {
    label en official "member of the family of the transferor: the spouse, a lineal descendant of the transferor or the transferor's spouse, and the spouse of any such descendant (section 2701(e)(1))";
}
rule MemberOfFamilySpouseRule(m: Person, transferor: Person) defeasible {
    when spouse_2701(m, transferor);
    then member_of_family_2701e1(m, transferor);
}
rule MemberOfFamilyDescendantRule(m: Person, transferor: Person) defeasible {
    when lineal_descendant_2701(m, transferor);
    then member_of_family_2701e1(m, transferor);
}
rule MemberOfFamilyDescendantOfSpouseRule(m: Person, transferor: Person, s: Person) defeasible {
    when spouse_2701(s, transferor);
    when lineal_descendant_2701(m, s);
    then member_of_family_2701e1(m, transferor);
}
rule MemberOfFamilySpouseOfDescendantRule(m: Person, transferor: Person, d: Person) defeasible {
    when lineal_descendant_2701(d, transferor);
    when spouse_2701(m, d);
    then member_of_family_2701e1(m, transferor);
}

@source(IRC_S2701_E, relation = formalizes, coverage = exact, quote = "an ancestor of the transferor or the transferor's spouse")
pub relation applicable_family_member_derived_2701e2(m: Person, transferor: Person) kind institutional {
    label en official "applicable family member: the spouse, an ancestor of the transferor or the transferor's spouse, and the spouse of any such ancestor (section 2701(e)(2))";
}
rule ApplicableFamilyMemberSpouseRule(m: Person, transferor: Person) defeasible {
    when spouse_2701(m, transferor);
    then applicable_family_member_derived_2701e2(m, transferor);
}
rule ApplicableFamilyMemberAncestorRule(m: Person, transferor: Person) defeasible {
    when ancestor_by_blood_2701(m, transferor);
    then applicable_family_member_derived_2701e2(m, transferor);
}
rule ApplicableFamilyMemberAncestorOfSpouseRule(m: Person, transferor: Person, s: Person) defeasible {
    when spouse_2701(s, transferor);
    when ancestor_by_blood_2701(m, s);
    then applicable_family_member_derived_2701e2(m, transferor);
}
rule ApplicableFamilyMemberSpouseOfAncestorRule(m: Person, transferor: Person, a: Person) defeasible {
    when ancestor_by_blood_2701(a, transferor);
    when spouse_2701(m, a);
    then applicable_family_member_derived_2701e2(m, transferor);
}

relation holder_is_applicable_family_member_2701(p: Person) kind institutional;
rule HolderIsApplicableFamilyMemberAssertedRule(p: Person, t: Person) defeasible {
    when applicable_family_member_2701(p, t);
    then holder_is_applicable_family_member_2701(p);
}
rule HolderIsApplicableFamilyMemberDerivedRule(p: Person, t: Person) defeasible {
    when applicable_family_member_derived_2701e2(p, t);
    then holder_is_applicable_family_member_2701(p);
}

// =====================================================================
// §2701(e)(3): attribution of indirect holdings
// =====================================================================

pub relation interest_held_directly_2701(i: Person, entity_id: Integer) kind empirical {
    label en unofficial "the individual holds the interest directly";
}
pub relation interest_held_through_conduit_2701(i: Person, entity_id: Integer, conduit: Integer) kind empirical {
    label en unofficial "the individual holds the interest indirectly through a corporation, partnership, trust or other entity";
}
pub relation indirect_holding_ceases_2701(i: Person, entity_id: Integer, on: Date) kind empirical {
    label en unofficial "a transfer results in the interest being treated as no longer held by the individual";
}
@source(IRC_S2701_E, relation = formalizes, coverage = exact, quote = "An individual shall be treated as holding any interest to the extent such interest is held indirectly by such individual through a corporation, partnership, trust, or other entity.")
pub relation interest_treated_as_held_2701e3(i: Person, entity_id: Integer) kind institutional {
    label en official "the individual is treated as holding the interest held directly or indirectly (section 2701(e)(3))";
}
rule InterestHeldDirectlyRule(i: Person, entity_id: Integer) defeasible {
    when interest_held_directly_2701(i, entity_id);
    then interest_treated_as_held_2701e3(i, entity_id);
}
rule InterestHeldIndirectlyRule(i: Person, entity_id: Integer, conduit: Integer) defeasible {
    when interest_held_through_conduit_2701(i, entity_id, conduit);
    then interest_treated_as_held_2701e3(i, entity_id);
}
@source(IRC_S2701_E, relation = formalizes, coverage = exact, quote = "any transfer which results in such interest being treated as no longer held by such individual shall be treated as a transfer of such interest")
pub relation deemed_transfer_of_indirect_interest_2701e3(i: Person, entity_id: Integer, on: Date) kind institutional {
    label en official "a transfer that ends an indirect holding is a transfer of the interest (section 2701(e)(3))";
}
rule DeemedTransferOfIndirectInterestRule(i: Person, entity_id: Integer, on: Date, conduit: Integer) defeasible {
    when indirect_holding_ceases_2701(i, entity_id, on);
    when interest_held_through_conduit_2701(i, entity_id, conduit);
    then deemed_transfer_of_indirect_interest_2701e3(i, entity_id, on);
}

// =====================================================================
// §2701(e)(5): changes in capital structure are transfers
// =====================================================================

pub enum CapitalChangeKind2701 {
    ContributionToCapital;
    Redemption;
    Recapitalization;
    OtherChange;
}
pub relation capital_structure_change_2701(taxpayer: Person, entity_id: Integer, kind: CapitalChangeKind2701, on: Date) kind empirical {
    label en unofficial "a contribution to capital, redemption, recapitalization or other change in the capital structure of the entity";
}
pub relation change_yields_applicable_retained_interest_2701(taxpayer: Person, entity_id: Integer, on: Date) kind empirical {
    label en unofficial "the taxpayer or an applicable family member receives (or under regulations holds immediately after) an applicable retained interest by reason of the change (section 2701(e)(5)(A), (B))";
}
pub relation interests_substantially_identical_2701(taxpayer: Person, entity_id: Integer, on: Date) kind empirical {
    label en unofficial "the interests held by the transferor, applicable family members and members of the family are substantially identical before and after the transaction (section 2701(e)(5), last sentence)";
}
@source(IRC_S2701_E, relation = formalizes, coverage = exact, quote = "a contribution to capital or a redemption, recapitalization, or other change in the capital structure of a corporation or partnership shall be treated as a transfer of an interest in such entity to which this section applies")
pub relation deemed_transfer_by_capital_change_2701e5(taxpayer: Person, entity_id: Integer, on: Date) kind institutional {
    label en official "the change in capital structure is a transfer to which section 2701 applies (section 2701(e)(5))";
}
rule CapitalContributionIsTransferRule(taxpayer: Person, entity_id: Integer, on: Date) defeasible {
    label en official "a contribution to capital is a transfer whether or not the interests are identical (section 2701(e)(5))";
    when capital_structure_change_2701(taxpayer, entity_id, ContributionToCapital, on);
    when change_yields_applicable_retained_interest_2701(taxpayer, entity_id, on);
    then deemed_transfer_by_capital_change_2701e5(taxpayer, entity_id, on);
}
rule CapitalChangeIsTransferRule(taxpayer: Person, entity_id: Integer, on: Date, kind: CapitalChangeKind2701) defeasible {
    label en official "any other change is a transfer unless the interests are substantially identical before and after (section 2701(e)(5))";
    when capital_structure_change_2701(taxpayer, entity_id, kind, on);
    when change_yields_applicable_retained_interest_2701(taxpayer, entity_id, on);
    when not_known(interests_substantially_identical_2701(taxpayer, entity_id, on));
    then deemed_transfer_by_capital_change_2701e5(taxpayer, entity_id, on);
}

// the transfer that section 2701(a)(1) needs: a family transfer, or one of the deemed transfers
relation family_transfer_for_2701(transferor: Person, entity_id: Integer) kind institutional;
rule FamilyTransferAssertedRule(transferor: Person, entity_id: Integer, transferee: Person, v: Money) defeasible {
    when transfer_of_entity_interest_to_family_member(transferor, transferee, entity_id, v);
    then family_transfer_for_2701(transferor, entity_id);
}
rule FamilyTransferByCapitalChangeRule(transferor: Person, entity_id: Integer, on: Date) defeasible {
    when deemed_transfer_by_capital_change_2701e5(transferor, entity_id, on);
    then family_transfer_for_2701(transferor, entity_id);
}
rule FamilyTransferByIndirectHoldingRule(transferor: Person, entity_id: Integer, on: Date) defeasible {
    when deemed_transfer_of_indirect_interest_2701e3(transferor, entity_id, on);
    then family_transfer_for_2701(transferor, entity_id);
}

// =====================================================================
// §2701(a)(1), (a)(2): the exceptions
// =====================================================================

pub relation transferred_interest_market_quoted_2701(transferor: Person, entity_id: Integer) kind empirical {
    label en unofficial "market quotations for the transferred interest are readily available on an established securities market as of the date of transfer (section 2701(a)(1), last sentence)";
}
pub relation retained_interest_market_quoted_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "market quotations for the retained interest are readily available on an established securities market (section 2701(a)(2)(A))";
}
pub relation retained_interest_same_class_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the retained interest is of the same class as the transferred interest (section 2701(a)(2)(B))";
}
pub relation retained_interest_proportionally_same_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the retained interest is proportionally the same as the transferred interest, without regard to nonlapsing differences in voting power (or, for a partnership, in management and limitations on liability) (section 2701(a)(2)(C)); a difference that lapses by reason of Federal or State law is treated as nonlapsing";
}
pub relation transferor_may_alter_transferee_liability_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the transferor or an applicable family member may alter the liability of the transferee of the transferred partnership property (section 2701(a)(2), flush text)";
}
@source(IRC_S2701_A, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any right with respect to an applicable retained interest if")
pub relation retained_interest_excepted_2701a2(p: Person, entity_id: Integer) kind institutional {
    label en official "paragraph (1) does not apply to the right: marketable, same class or proportionally the same retained interest (section 2701(a)(2))";
}
rule RetainedInterestExceptedMarketRule(p: Person, entity_id: Integer) defeasible {
    when retained_interest_market_quoted_2701(p, entity_id);
    then retained_interest_excepted_2701a2(p, entity_id);
}
rule RetainedInterestExceptedSameClassRule(p: Person, entity_id: Integer) defeasible {
    when retained_interest_same_class_2701(p, entity_id);
    then retained_interest_excepted_2701a2(p, entity_id);
}
rule RetainedInterestExceptedProportionalRule(p: Person, entity_id: Integer) defeasible {
    label en official "the proportional exception does not apply to a partnership interest whose transferor may alter the transferee's liability (section 2701(a)(2)(C), flush)";
    when retained_interest_proportionally_same_2701(p, entity_id);
    when not_known(transferor_may_alter_transferee_liability_2701(p, entity_id));
    then retained_interest_excepted_2701a2(p, entity_id);
}

// =====================================================================
// §2701(c)(2): liquidation, put, call or conversion rights
// =====================================================================

pub relation liquidation_put_call_conversion_right_2701(p: Person, entity_id: Integer, right_id: Integer) kind empirical {
    label en unofficial "a liquidation, put, call or conversion right, or any similar right, the exercise or nonexercise of which affects the value of the transferred interest (section 2701(c)(2)(A))";
}
pub relation right_fixed_time_and_amount_2701(p: Person, entity_id: Integer, right_id: Integer) kind empirical {
    label en unofficial "the right must be exercised at a specific time and at a specific amount (section 2701(c)(2)(B)(i))";
}
pub relation right_assumed_exercised_under_a3b_2701(p: Person, entity_id: Integer, right_id: Integer) kind empirical {
    label en unofficial "the right is assumed to be exercised in a particular manner under section 2701(a)(3)(B) (section 2701(c)(2)(B)(ii))";
}
pub relation right_converts_to_fixed_share_of_same_class_2701(p: Person, entity_id: Integer, right_id: Integer) kind empirical {
    label en unofficial "the right is to convert into a fixed number or percentage of shares of the same class (or of the same class but for nonlapsing voting differences) (section 2701(c)(2)(C)(i))";
}
pub relation right_nonlapsing_2701(p: Person, entity_id: Integer, right_id: Integer) kind empirical {
    label en unofficial "the right is nonlapsing (section 2701(c)(2)(C)(ii))";
}
pub relation right_adjusted_for_capital_changes_2701(p: Person, entity_id: Integer, right_id: Integer) kind empirical {
    label en unofficial "the right is subject to proportionate adjustments for splits, combinations, reclassifications and similar changes (section 2701(c)(2)(C)(iii))";
}
pub relation right_adjusted_for_unpaid_distributions_2701(p: Person, entity_id: Integer, right_id: Integer) kind empirical {
    label en unofficial "the right is subject to adjustments similar to those of subsection (d) for accumulated but unpaid distributions (section 2701(c)(2)(C)(iv))";
}
relation fixed_right_exception_2701(p: Person, entity_id: Integer, right_id: Integer) kind institutional;
rule FixedRightExceptionRule(p: Person, entity_id: Integer, right_id: Integer) defeasible {
    when right_fixed_time_and_amount_2701(p, entity_id, right_id);
    then fixed_right_exception_2701(p, entity_id, right_id);
}
rule AssumedExercisedRightIsFixedRule(p: Person, entity_id: Integer, right_id: Integer) defeasible {
    label en official "a right assumed to be exercised in a particular manner under subsection (a)(3)(B) is treated as so exercised (section 2701(c)(2)(B)(ii))";
    when right_assumed_exercised_under_a3b_2701(p, entity_id, right_id);
    then fixed_right_exception_2701(p, entity_id, right_id);
}
relation conversion_right_exception_2701(p: Person, entity_id: Integer, right_id: Integer) kind institutional;
rule ConversionRightExceptionRule(p: Person, entity_id: Integer, right_id: Integer) defeasible {
    when right_converts_to_fixed_share_of_same_class_2701(p, entity_id, right_id)
        and right_nonlapsing_2701(p, entity_id, right_id)
        and right_adjusted_for_capital_changes_2701(p, entity_id, right_id)
        and right_adjusted_for_unpaid_distributions_2701(p, entity_id, right_id);
    then conversion_right_exception_2701(p, entity_id, right_id);
}
pub relation counted_lpcc_right_2701(p: Person, entity_id: Integer, right_id: Integer) kind institutional {
    label en official "a liquidation, put, call or conversion right within section 2701(c)(2), the exceptions for fixed and convertible rights aside";
}
rule CountedLpccRightRule(p: Person, entity_id: Integer, right_id: Integer) defeasible {
    when liquidation_put_call_conversion_right_2701(p, entity_id, right_id);
    when not_known(fixed_right_exception_2701(p, entity_id, right_id));
    when not_known(conversion_right_exception_2701(p, entity_id, right_id));
    then counted_lpcc_right_2701(p, entity_id, right_id);
}
relation has_counted_lpcc_right_2701(p: Person, entity_id: Integer) kind institutional;
rule HasCountedLpccRightRule(p: Person, entity_id: Integer, right_id: Integer) defeasible {
    when counted_lpcc_right_2701(p, entity_id, right_id);
    then has_counted_lpcc_right_2701(p, entity_id);
}

// =====================================================================
// §2701(c)(1), (c)(3): distribution right and qualified payment
// =====================================================================

pub relation guaranteed_payment_of_fixed_amount_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the right is to a guaranteed payment described in section 707(c) of a fixed amount (section 2701(c)(1)(B)(iii))";
}
pub relation right_to_distributions_on_junior_interest_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the right is to distributions with respect to an interest junior to the rights of the transferred interest (section 2701(c)(1)(B)(i))";
}
pub relation right_to_distributions_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the right is to distributions from a corporation with respect to its stock or from a partnership with respect to a partner's interest (section 2701(c)(1)(A))";
}
@source(IRC_S2701_C, relation = formalizes, coverage = exact, quote = "The term \"distribution right\" does not include")
pub relation distribution_right_2701c1(p: Person, entity_id: Integer) kind institutional {
    label en official "distribution right: a right to distributions, other than those on a junior interest, liquidation, put, call or conversion rights, and fixed guaranteed payments (section 2701(c)(1))";
}
rule DistributionRightRule(p: Person, entity_id: Integer) defeasible {
    when right_to_distributions_2701(p, entity_id);
    when not_known(right_to_distributions_on_junior_interest_2701(p, entity_id));
    when not_known(guaranteed_payment_of_fixed_amount_2701(p, entity_id));
    then distribution_right_2701c1(p, entity_id);
}

pub relation dividend_on_cumulative_preferred_periodic_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "a dividend payable on a periodic basis under cumulative preferred stock (or a comparable payment under a partnership interest) (section 2701(c)(3)(A))";
}
pub relation payment_at_fixed_rate_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the dividend or comparable payment is determined at a fixed rate";
}
pub relation payment_rate_fixed_relation_to_market_rate_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the payment is determined at a rate bearing a fixed relationship to a specified market interest rate (section 2701(c)(3)(B))";
}
@source(IRC_S2701_C, relation = formalizes, coverage = exact, quote = "the term \"qualified payment\" means any dividend payable on a periodic basis under any cumulative preferred stock")
pub relation qualified_payment_by_definition_2701(p: Person, entity_id: Integer) kind institutional {
    label en official "the payment is a qualified payment as defined, before the elections of subparagraph (C) (section 2701(c)(3)(A), (B))";
}
rule QualifiedPaymentFixedRateRule(p: Person, entity_id: Integer) defeasible {
    when dividend_on_cumulative_preferred_periodic_2701(p, entity_id);
    when payment_at_fixed_rate_2701(p, entity_id);
    then qualified_payment_by_definition_2701(p, entity_id);
}
rule QualifiedPaymentMarketRelatedRule(p: Person, entity_id: Integer) defeasible {
    label en official "a payment at a rate bearing a fixed relationship to a specified market rate is fixed as to rate (section 2701(c)(3)(B))";
    when dividend_on_cumulative_preferred_periodic_2701(p, entity_id);
    when payment_rate_fixed_relation_to_market_rate_2701(p, entity_id);
    then qualified_payment_by_definition_2701(p, entity_id);
}

// (c)(3)(C): the elections
pub relation transferor_elects_not_qualified_payment_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the transferor elects not to treat the payments as qualified payments (section 2701(c)(3)(C)(i))";
}
pub relation family_member_elects_qualified_payment_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the applicable family member elects to treat the payments as qualified payments (section 2701(c)(3)(C)(i))";
}
pub relation election_treats_right_as_qualified_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the holder elects to treat a distribution right that is not otherwise a qualified payment as one, to be paid in the amounts and at the times specified (section 2701(c)(3)(C)(ii))";
}
pub relation election_terms_consistent_with_instrument_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the amounts and times specified are not inconsistent with the underlying legal instrument (section 2701(c)(3)(C)(ii), last sentence)";
}
pub relation distribution_right_not_otherwise_qualified_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the distribution right is not, without regard to subparagraph (C), a qualified payment";
}
pub relation qualified_payment_election_out_effective_2701(p: Person, entity_id: Integer) kind institutional {
    label en official "the transferor's payments are not treated as qualified payments (section 2701(c)(3)(C)(i))";
}
pub relation family_member_qualified_election_effective_2701(p: Person, entity_id: Integer) kind institutional {
    label en official "the applicable family member's payments are treated as qualified payments (section 2701(c)(3)(C)(i))";
}
pub relation qualified_payment_election_in_effective_2701(p: Person, entity_id: Integer) kind institutional {
    label en official "the right is treated as a qualified payment as elected (section 2701(c)(3)(C)(ii))";
}

@source(IRC_S2701_C, relation = formalizes, coverage = exact, quote = "unless the transferor elects not to treat such payments as qualified payments")
rule TransferorElectsOutOfQualifiedPaymentPower(p: Person, entity_id: Integer) strict {
    label en official "the transferor may elect not to treat payments as qualified payments (section 2701(c)(3)(C)(i))";
    when transferor_elects_not_qualified_payment_2701(p, entity_id);
    then power TransferorElectsOutOfQualifiedPayment {
        holder p;
        over p;
        exercise transferor_elects_not_qualified_payment_2701(p, entity_id);
        valid_when qualified_payment_by_definition_2701(p, entity_id);
        effect create(qualified_payment_election_out_effective_2701(p, entity_id));
        window [@1990-11-05, infinity);
    };
}
@source(IRC_S2701_C, relation = formalizes, coverage = exact, quote = "shall be treated as qualified payments only if such member elects to treat such payments as qualified payments")
rule FamilyMemberElectsQualifiedPaymentPower(p: Person, entity_id: Integer) strict {
    label en official "an applicable family member may elect to treat the payments as qualified payments (section 2701(c)(3)(C)(i))";
    when family_member_elects_qualified_payment_2701(p, entity_id);
    then power FamilyMemberElectsQualifiedPayment {
        holder p;
        over p;
        exercise family_member_elects_qualified_payment_2701(p, entity_id);
        valid_when holder_is_applicable_family_member_2701(p);
        effect create(family_member_qualified_election_effective_2701(p, entity_id));
        window [@1990-11-05, infinity);
    };
}
@source(IRC_S2701_C, relation = formalizes, coverage = exact, quote = "may elect to treat such right as a qualified payment, to be paid in the amounts and at the times specified in such election")
rule ElectsToTreatRightAsQualifiedPower(p: Person, entity_id: Integer) strict {
    label en official "a transferor or applicable family member may elect to treat a distribution right as a qualified payment, to the extent the terms are consistent with the instrument (section 2701(c)(3)(C)(ii))";
    when election_treats_right_as_qualified_2701(p, entity_id);
    when election_terms_consistent_with_instrument_2701(p, entity_id);
    then power ElectsToTreatRightAsQualified {
        holder p;
        over p;
        exercise election_treats_right_as_qualified_2701(p, entity_id);
        valid_when distribution_right_not_otherwise_qualified_2701(p, entity_id);
        effect create(qualified_payment_election_in_effective_2701(p, entity_id));
        window [@1990-11-05, infinity);
    };
}

relation qualified_payment_election_made_2701(p: Person, entity_id: Integer) kind institutional;
rule ElectionMadeOutRule(p: Person, entity_id: Integer) defeasible {
    when qualified_payment_election_out_effective_2701(p, entity_id);
    then qualified_payment_election_made_2701(p, entity_id);
}
rule ElectionMadeFamilyRule(p: Person, entity_id: Integer) defeasible {
    when family_member_qualified_election_effective_2701(p, entity_id);
    then qualified_payment_election_made_2701(p, entity_id);
}
rule ElectionMadeInRule(p: Person, entity_id: Integer) defeasible {
    when qualified_payment_election_in_effective_2701(p, entity_id);
    then qualified_payment_election_made_2701(p, entity_id);
}
@source(IRC_S2701_C, relation = formalizes, coverage = exact, quote = "Any election under this subparagraph with respect to an interest shall, once made, be irrevocable.")
rule QualifiedPaymentElectionIrrevocableRule(p: Person, entity_id: Integer) strict {
    label en official "an election under subparagraph (C), once made, is irrevocable (section 2701(c)(3)(C)(iii))";
    when qualified_payment_election_made_2701(p, entity_id);
    then prohibition QualifiedPaymentElectionRevocationProhibition {
        bearer p;
        beneficiary Secretary;
        action revokes_qualified_payment_election_2701(p, entity_id);
        window [@1990-11-05, infinity);
    };
}
pub relation revokes_qualified_payment_election_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the holder revokes an election made under section 2701(c)(3)(C)";
}

// the qualified payment as the section-2701 rules read it: by definition and not elected out
// (transferor), by definition and elected in (family member), or made so by election;
// the case-asserted classification of module 13 stays the input of the definition
relation qualified_payment_effective_2701(p: Person, entity_id: Integer) kind institutional;
rule QualifiedPaymentEffectiveTransferorRule(p: Person, entity_id: Integer) defeasible {
    label en official "the transferor's qualified payments are qualified unless the transferor elects otherwise (section 2701(c)(3)(C)(i))";
    when retained_right_is_qualified_payment(p, entity_id);
    when not_known(holder_is_applicable_family_member_2701(p));
    when not_known(qualified_payment_election_out_effective_2701(p, entity_id));
    then qualified_payment_effective_2701(p, entity_id);
}
rule QualifiedPaymentEffectiveFamilyMemberRule(p: Person, entity_id: Integer) defeasible {
    label en official "an applicable family member's payments are qualified only if the member elects (section 2701(c)(3)(C)(i))";
    when retained_right_is_qualified_payment(p, entity_id);
    when holder_is_applicable_family_member_2701(p);
    when family_member_qualified_election_effective_2701(p, entity_id);
    then qualified_payment_effective_2701(p, entity_id);
}
rule QualifiedPaymentEffectiveByElectionRule(p: Person, entity_id: Integer) defeasible {
    label en official "a right made a qualified payment by election is one (section 2701(c)(3)(C)(ii))";
    when qualified_payment_election_in_effective_2701(p, entity_id);
    then qualified_payment_effective_2701(p, entity_id);
}

// =====================================================================
// §2701(a)(3)(B), (C): value of qualified payments
// =====================================================================

pub relation qualified_payment_value_under_scenario_2701(p: Person, entity_id: Integer, scenario: Integer, value: Money) kind empirical {
    label en unofficial "the value of the distribution right and the liquidation, put, call and conversion rights if each such right were exercised in the manner of the scenario (section 2701(a)(3)(B))";
}
relation lower_scenario_value_exists_2701(p: Person, entity_id: Integer, value: Money) kind institutional;
rule LowerScenarioValueExistsRule(p: Person, entity_id: Integer, value: Money, s: Integer, lower: Money) defeasible {
    when qualified_payment_value_under_scenario_2701(p, entity_id, s, lower);
    when qualified_payment_value_under_scenario_2701(p, entity_id, _, value);
    when lower < value;
    then lower_scenario_value_exists_2701(p, entity_id, value);
}
@source(IRC_S2701_A, relation = formalizes, coverage = exact, quote = "the value of all such rights shall be determined as if each liquidation, put, call, or conversion right were exercised in the manner resulting in the lowest value being determined for all such rights")
pub relation qualified_payment_value_determined_2701(p: Person, entity_id: Integer, value: Money) kind institutional {
    label en official "the value of the qualified-payment right: the lowest scenario value where there are liquidation, put, call or conversion rights, otherwise without regard to section 2701 (section 2701(a)(3)(B), (C))";
}
rule QualifiedPaymentValueLowestRule(p: Person, entity_id: Integer, s: Integer, value: Money) defeasible {
    label en official "with such rights, the lowest-value manner of exercise governs (section 2701(a)(3)(B))";
    when has_counted_lpcc_right_2701(p, entity_id);
    when qualified_payment_value_under_scenario_2701(p, entity_id, s, value);
    unless lower_scenario_value_exists_2701(p, entity_id, value);
    then qualified_payment_value_determined_2701(p, entity_id, value);
}
rule QualifiedPaymentValueNoRightsRule(p: Person, entity_id: Integer, value: Money) defeasible {
    label en official "without such rights the distribution right is valued without regard to the section (section 2701(a)(3)(C))";
    when qualified_payment_value_2701(p, entity_id, value);
    when not_known(has_counted_lpcc_right_2701(p, entity_id));
    then qualified_payment_value_determined_2701(p, entity_id, value);
}

// =====================================================================
// §2701(a)(4): minimum valuation of junior equity
// =====================================================================

pub relation junior_equity_share_transferred_2701(transferor: Person, entity_id: Integer, share: Decimal) kind empirical {
    label en unofficial "the transferred interest is a junior equity interest (common stock, or a partnership interest junior in income and capital to all other classes) and is this share of all the junior equity interests (section 2701(a)(4)(B)(i))";
}
pub relation total_equity_value_2701(entity_id: Integer, v: Money) kind empirical {
    label en unofficial "the total value of all the equity interests in the entity (section 2701(a)(4)(A)(i))";
}
pub relation indebtedness_to_transferor_side_2701(entity_id: Integer, v: Money) kind empirical {
    label en unofficial "the total indebtedness of the entity to the transferor or an applicable family member (section 2701(a)(4)(A)(ii))";
}
@source(IRC_S2701_A, relation = formalizes, coverage = exact, quote = "equal to 10 percent of the sum of")
pub relation junior_equity_floor_value_2701(transferor: Person, entity_id: Integer, v: Money) kind institutional {
    label en official "the value the transferred junior equity would have if all the junior equity were 10 percent of the equity plus the indebtedness (section 2701(a)(4)(A))";
}
rule JuniorEquityFloorValueRule(transferor: Person, entity_id: Integer, share: Decimal, equity: Money, debt: Money) defeasible {
    when junior_equity_share_transferred_2701(transferor, entity_id, share);
    when total_equity_value_2701(entity_id, equity);
    when indebtedness_to_transferor_side_2701(entity_id, debt);
    then junior_equity_floor_value_2701(transferor, entity_id, round((equity + debt) * 0.10 * share, 2, "HALF_UP"));
}
@source(IRC_S2701_A, relation = formalizes, coverage = exact, quote = "such interest shall in no event be valued at an amount less than the value which would be determined")
pub relation junior_equity_transfer_value_2701a4(transferor: Person, entity_id: Integer, v: Money) kind institutional {
    label en official "the value of the transferred junior equity is at least the floor (section 2701(a)(4)(A))";
}
rule JuniorEquityTransferValueRule(transferor: Person, entity_id: Integer, transferee: Person, v: Money, floor: Money, ret: Money) defeasible {
    when transfer_of_entity_interest_to_family_member(transferor, transferee, entity_id, v);
    when section_2701_value(transferor, entity_id, ret);
    when junior_equity_floor_value_2701(transferor, entity_id, floor);
    then junior_equity_transfer_value_2701a4(transferor, entity_id, max(v, floor));
}

// =====================================================================
// §2701(d): cumulative unpaid distributions
// =====================================================================

pub enum TaxableEventKind2701d {
    DeathOfTransferor;
    TransferOfRetainedInterest;
    LatePaymentByElection;
}

relation distribution_right_valued_under_a3bc_2701(p: Person, entity_id: Integer) kind institutional;
rule DistributionRightValuedUnderA3bcRule(p: Person, entity_id: Integer, v: Money) defeasible {
    label en official "a distribution right to which subsection (a)(3)(B) or (C) applied (section 2701(d)(1))";
    when section_2701_value(p, entity_id, v);
    when qualified_payment_effective_2701(p, entity_id);
    then distribution_right_valued_under_a3bc_2701(p, entity_id);
}

// (d)(3): taxable events
pub relation transferor_dies_on_2701(p: Person, entity_id: Integer, on: Date) kind empirical {
    label en unofficial "the transferor dies on the date";
}
pub relation retained_interest_includible_in_gross_estate_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "the applicable retained interest conferring the distribution right is includible in the estate of the transferor (section 2701(d)(3)(A)(i))";
}
pub relation deduction_allowable_2056_or_2106a3_2701(p: Person, entity_id: Integer) kind empirical {
    label en unofficial "a deduction with respect to the interest is allowable under section 2056 or 2106(a)(3) (section 2701(d)(3)(B)(i))";
}
pub relation retained_interest_transferred_on_2701(p: Person, entity_id: Integer, on: Date) kind empirical {
    label en unofficial "the applicable retained interest is transferred on the date (section 2701(d)(3)(A)(ii))";
}
pub relation retained_interest_terminated_on_2701(p: Person, entity_id: Integer, on: Date) kind empirical {
    label en unofficial "the interest terminates on the date; a termination is treated as a transfer (section 2701(d)(5))";
}
pub relation transfer_to_spouse_no_taxable_gift_2701(p: Person, entity_id: Integer, on: Date, spouse: Person) kind empirical {
    label en unofficial "the transfer to the spouse of the transferor results in no taxable gift by reason of the section 2523 deduction, the section 2503(b) exclusion, or consideration provided by the spouse (section 2701(d)(3)(B)(ii))";
}
relation retained_interest_transfer_event_2701(p: Person, entity_id: Integer, on: Date) kind institutional;
rule TransferEventByTransferRule(p: Person, entity_id: Integer, on: Date) defeasible {
    when retained_interest_transferred_on_2701(p, entity_id, on);
    then retained_interest_transfer_event_2701(p, entity_id, on);
}
rule TransferEventByTerminationRule(p: Person, entity_id: Integer, on: Date) defeasible {
    label en official "any termination of an interest is treated as a transfer (section 2701(d)(5))";
    when retained_interest_terminated_on_2701(p, entity_id, on);
    then retained_interest_transfer_event_2701(p, entity_id, on);
}
relation transfer_to_spouse_excepted_2701(p: Person, entity_id: Integer, on: Date) kind institutional;
rule TransferToSpouseExceptedRule(p: Person, entity_id: Integer, on: Date, s: Person) defeasible {
    when transfer_to_spouse_no_taxable_gift_2701(p, entity_id, on, s);
    then transfer_to_spouse_excepted_2701(p, entity_id, on);
}

pub relation late_payment_2701d(p: Person, entity_id: Integer, due: Date, paid: Date) kind empirical {
    label en unofficial "a qualified payment due on `due` and paid on `paid`";
}
pub relation late_payment_taxable_event_elected_2701d(p: Person, entity_id: Integer, due: Date) kind institutional {
    label en official "the taxpayer's election to treat the late payment as a taxable event is in effect (section 2701(d)(3)(A)(iii))";
}
pub relation taxpayer_elects_late_payment_event_2701d(p: Person, entity_id: Integer, due: Date) kind empirical {
    label en unofficial "the taxpayer elects to treat payment of the qualified payment after the 4-year period as a taxable event";
}
@source(IRC_S2701_D, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer, the payment of any qualified payment after the period described in paragraph (2)(C), but only with respect to such payment.")
rule TaxpayerElectsLatePaymentEventPower(p: Person, entity_id: Integer, due: Date, paid: Date) strict {
    label en official "the taxpayer may elect to treat a payment made after the grace period as a taxable event, only with respect to that payment (section 2701(d)(3)(A)(iii))";
    when taxpayer_elects_late_payment_event_2701d(p, entity_id, due);
    when late_payment_2701d(p, entity_id, due, paid);
    then power TaxpayerElectsLatePaymentEvent {
        holder p;
        over p;
        exercise taxpayer_elects_late_payment_event_2701d(p, entity_id, due);
        valid_when distribution_right_valued_under_a3bc_2701(p, entity_id);
        effect create(late_payment_taxable_event_elected_2701d(p, entity_id, due));
        window [@1990-11-05, infinity);
    };
}

@source(IRC_S2701_D, relation = formalizes, coverage = exact, quote = "The term \"taxable event\" means any of the following:")
pub relation taxable_event_2701d(p: Person, entity_id: Integer, on: Date, kind: TaxableEventKind2701d) kind institutional {
    label en official "a taxable event with respect to a distribution right to which subsection (a)(3)(B) or (C) applied (section 2701(d)(3)(A))";
}
rule TaxableEventDeathRule(p: Person, entity_id: Integer, on: Date) defeasible {
    label en official "the death of the transferor, the interest being includible in the estate and not deductible under section 2056 or 2106(a)(3) (section 2701(d)(3)(A)(i), (B)(i))";
    when distribution_right_valued_under_a3bc_2701(p, entity_id);
    when transferor_dies_on_2701(p, entity_id, on);
    when retained_interest_includible_in_gross_estate_2701(p, entity_id);
    when not_known(deduction_allowable_2056_or_2106a3_2701(p, entity_id));
    then taxable_event_2701d(p, entity_id, on, DeathOfTransferor);
}
rule TaxableEventTransferRule(p: Person, entity_id: Integer, on: Date) defeasible {
    label en official "the transfer of the retained interest, unless it is a transfer to the spouse without a taxable gift (section 2701(d)(3)(A)(ii), (B)(ii))";
    when distribution_right_valued_under_a3bc_2701(p, entity_id);
    when retained_interest_transfer_event_2701(p, entity_id, on);
    when not_known(transfer_to_spouse_excepted_2701(p, entity_id, on));
    then taxable_event_2701d(p, entity_id, on, TransferOfRetainedInterest);
}
rule TaxableEventLatePaymentRule(p: Person, entity_id: Integer, due: Date, paid: Date) defeasible {
    label en official "the elected payment after the 4-year period (section 2701(d)(3)(A)(iii))";
    when distribution_right_valued_under_a3bc_2701(p, entity_id);
    when late_payment_2701d(p, entity_id, due, paid);
    when late_payment_taxable_event_elected_2701d(p, entity_id, due);
    when paid > add_calendar_period(due, 4 calendar_year);
    then taxable_event_2701d(p, entity_id, paid, LatePaymentByElection);
}

// (d)(3)(B)(iii), (d)(4): who is treated as the transferor
pub relation surviving_or_transferee_spouse_2701(s: Person, p: Person) kind empirical {
    label en unofficial "s is the transferee spouse or surviving spouse of p";
}
pub relation retained_interest_transferred_to_2701(p: Person, entity_id: Integer, on: Date, to: Person) kind empirical {
    label en unofficial "the retained interest is transferred to the person on the date";
}
@source(IRC_S2701_D, relation = formalizes, coverage = exact, quote = "the transferee spouse or surviving spouse (as the case may be) shall be treated in the same manner as the transferor in applying this subsection with respect to the interest involved")
pub relation treated_as_transferor_2701d(q: Person, p: Person, entity_id: Integer) kind institutional {
    label en official "q is treated in the same manner as the transferor p in applying subsection (d) to the interest (section 2701(d)(3)(B)(iii), (d)(4))";
}
rule SpouseSucceedsAtDeathRule(q: Person, p: Person, entity_id: Integer) defeasible {
    label en official "where death is not a taxable event because of the marital deduction, the surviving spouse succeeds to the transferor's treatment (section 2701(d)(3)(B)(iii))";
    when distribution_right_valued_under_a3bc_2701(p, entity_id);
    when deduction_allowable_2056_or_2106a3_2701(p, entity_id);
    when surviving_or_transferee_spouse_2701(q, p);
    then treated_as_transferor_2701d(q, p, entity_id);
}
rule SpouseSucceedsAtTransferRule(q: Person, p: Person, entity_id: Integer, on: Date) defeasible {
    label en official "a transferee spouse of an excepted transfer succeeds to the transferor's treatment (section 2701(d)(3)(B)(iii))";
    when distribution_right_valued_under_a3bc_2701(p, entity_id);
    when transfer_to_spouse_excepted_2701(p, entity_id, on);
    when surviving_or_transferee_spouse_2701(q, p);
    then treated_as_transferor_2701d(q, p, entity_id);
}
rule ApplicableFamilyMemberSameAsTransferorRule(q: Person, p: Person, entity_id: Integer) defeasible {
    label en official "an applicable family member is treated as the transferor for a distribution right it retains (section 2701(d)(4)(A))";
    when distribution_right_valued_under_a3bc_2701(q, entity_id);
    when holder_is_applicable_family_member_2701(q);
    when applicable_family_member_derived_2701e2(q, p);
    then treated_as_transferor_2701d(q, p, entity_id);
}
rule TransferToApplicableFamilyMemberRule(q: Person, p: Person, entity_id: Integer, on: Date) defeasible {
    label en official "a transferee applicable family member other than the spouse is treated as the transferor for later accumulations (section 2701(d)(4)(B))";
    when distribution_right_valued_under_a3bc_2701(p, entity_id);
    when retained_interest_transferred_to_2701(p, entity_id, on, q);
    when applicable_family_member_derived_2701e2(q, p);
    when not_known(spouse_2701(q, p));
    then treated_as_transferor_2701d(q, p, entity_id);
}
rule TransferBackToTransferorRule(p: Person, q: Person, entity_id: Integer, on: Date) defeasible {
    label en official "the subsection continues to apply to the transferor while the transferor holds the interest received from an applicable family member (section 2701(d)(4)(C))";
    when distribution_right_valued_under_a3bc_2701(q, entity_id);
    when retained_interest_transferred_to_2701(q, entity_id, on, p);
    when applicable_family_member_derived_2701e2(q, p);
    then treated_as_transferor_2701d(p, p, entity_id);
}

// (d)(2): the amount of the increase
pub relation qualified_payment_due_and_paid_2701d(p: Person, entity_id: Integer, due: Date, paid: Date) kind empirical {
    label en unofficial "a qualified payment due on `due` and actually paid on `paid` in the period from the transfer to the taxable event";
}
@source(IRC_S2701_D, relation = formalizes, coverage = exact, quote = "any payment of any distribution during the 4-year period beginning on its due date shall be treated as having been made on such due date")
pub relation qualified_payment_deemed_paid_on_2701d(p: Person, entity_id: Integer, due: Date, deemed: Date) kind institutional {
    label en official "the date on which the payment is treated as made: the due date within the 4-year grace period, otherwise the actual date (section 2701(d)(2)(C))";
}
rule PaymentWithinGraceTreatedOnDueDateRule(p: Person, entity_id: Integer, due: Date, paid: Date) defeasible {
    when qualified_payment_due_and_paid_2701d(p, entity_id, due, paid);
    when paid <= add_calendar_period(due, 4 calendar_year);
    then qualified_payment_deemed_paid_on_2701d(p, entity_id, due, due);
}
rule PaymentAfterGraceTreatedOnActualDateRule(p: Person, entity_id: Integer, due: Date, paid: Date) defeasible {
    when qualified_payment_due_and_paid_2701d(p, entity_id, due, paid);
    when paid > add_calendar_period(due, 4 calendar_year);
    then qualified_payment_deemed_paid_on_2701d(p, entity_id, due, paid);
}
pub relation value_of_payments_if_paid_when_due_reinvested_2701d(p: Person, entity_id: Integer, on: Date, v: Money) kind empirical {
    label en unofficial "the value at the taxable event of the qualified payments payable from the transfer, as if all were paid when due and reinvested at the discount rate (section 2701(d)(2)(A)(i))";
}
pub relation value_of_payments_at_deemed_dates_reinvested_2701d(p: Person, entity_id: Integer, on: Date, v: Money) kind empirical {
    label en unofficial "the value of the payments actually paid, computed on the basis of the time they were treated as paid (section 2701(d)(2)(A)(ii))";
}
pub relation cumulative_unpaid_excess_2701d(p: Person, entity_id: Integer, on: Date, excess: Money) kind institutional {
    label en official "the excess of the value if paid when due over the value on the actual timing (section 2701(d)(2)(A))";
}
rule CumulativeUnpaidExcessRule(p: Person, entity_id: Integer, on: Date, due_v: Money, actual_v: Money) defeasible {
    when value_of_payments_if_paid_when_due_reinvested_2701d(p, entity_id, on, due_v);
    when value_of_payments_at_deemed_dates_reinvested_2701d(p, entity_id, on, actual_v);
    then cumulative_unpaid_excess_2701d(p, entity_id, on, max(0.00 USD, due_v - actual_v));
}
pub relation junior_equity_value_at_event_2701d(p: Person, entity_id: Integer, on: Date, v: Money) kind empirical {
    label en unofficial "the value at the taxable event of all the equity interests junior to the applicable retained interest (section 2701(d)(2)(B)(i)(I))";
}
pub relation junior_equity_value_at_transfer_2701d(p: Person, entity_id: Integer, v: Money) kind empirical {
    label en unofficial "the value of such junior interests at the date of the transfer to which subsection (a)(1) applied (section 2701(d)(2)(B)(i)(II))";
}
pub relation shares_held_same_class_at_event_2701d(p: Person, entity_id: Integer, on: Date, n: Decimal) kind empirical {
    label en unofficial "the shares (or partnership interests) of the class held by the transferor as applicable retained interests at the taxable event (section 2701(d)(2)(B)(ii)(I))";
}
pub relation total_shares_same_class_at_event_2701d(entity_id: Integer, on: Date, n: Decimal) kind empirical {
    label en unofficial "the total shares of the class at the taxable event (section 2701(d)(2)(B)(ii)(II))";
}
@source(IRC_S2701_D, relation = formalizes, coverage = exact, quote = "The amount of the increase under subparagraph (A) shall not exceed the applicable percentage of the excess (if any)")
pub relation increase_limit_2701d(p: Person, entity_id: Integer, on: Date, limit: Money) kind institutional {
    label en official "the applicable percentage of the growth of the junior equity between the transfer and the taxable event (section 2701(d)(2)(B))";
}
rule IncreaseLimitRule(p: Person, entity_id: Integer, on: Date, at_event: Money, at_transfer: Money, held: Decimal, total: Decimal) defeasible {
    when junior_equity_value_at_event_2701d(p, entity_id, on, at_event);
    when junior_equity_value_at_transfer_2701d(p, entity_id, at_transfer);
    when shares_held_same_class_at_event_2701d(p, entity_id, on, held);
    when total_shares_same_class_at_event_2701d(entity_id, on, total);
    then increase_limit_2701d(p, entity_id, on, div_round(max(0.00 USD, at_event - at_transfer) * held, total, 2, "HALF_UP"));
}
@source(IRC_S2701_D, relation = formalizes, coverage = exact, quote = "the following shall be increased by the amount determined under paragraph (2)")
pub relation increase_amount_2701d(p: Person, entity_id: Integer, on: Date, kind: TaxableEventKind2701d, amount: Money) kind institutional {
    label en official "the increase determined under paragraph (2): the excess, not more than the limit (section 2701(d)(1), (2))";
}
rule IncreaseAmountRule(p: Person, entity_id: Integer, on: Date, kind: TaxableEventKind2701d, excess: Money, limit: Money) defeasible {
    when taxable_event_2701d(p, entity_id, on, kind);
    when cumulative_unpaid_excess_2701d(p, entity_id, on, excess);
    when increase_limit_2701d(p, entity_id, on, limit);
    then increase_amount_2701d(p, entity_id, on, kind, min(excess, limit));
}
pub relation estate_increase_2701d(p: Person, entity_id: Integer, on: Date, amount: Money) kind institutional {
    label en official "the taxable estate of the transferor is increased (section 2701(d)(1)(A))";
}
rule EstateIncreaseRule(p: Person, entity_id: Integer, on: Date, amount: Money) defeasible {
    when increase_amount_2701d(p, entity_id, on, DeathOfTransferor, amount);
    then estate_increase_2701d(p, entity_id, on, amount);
}
pub relation gift_increase_2701d(p: Person, entity_id: Integer, on: Date, amount: Money) kind institutional {
    label en official "the taxable gifts of the transferor for the calendar year of the event are increased (section 2701(d)(1)(B))";
}
rule GiftIncreaseTransferRule(p: Person, entity_id: Integer, on: Date, amount: Money) defeasible {
    when increase_amount_2701d(p, entity_id, on, TransferOfRetainedInterest, amount);
    then gift_increase_2701d(p, entity_id, on, amount);
}
rule GiftIncreaseLatePaymentRule(p: Person, entity_id: Integer, on: Date, amount: Money) defeasible {
    when increase_amount_2701d(p, entity_id, on, LatePaymentByElection, amount);
    then gift_increase_2701d(p, entity_id, on, amount);
}

// =====================================================================
// §2702(a)(3), (c), (d), (e)
// =====================================================================

pub relation trust_all_property_personal_residence_2702(trust: Trust) kind empirical {
    label en unofficial "all the property in the trust consists of a residence to be used as a personal residence by persons holding term interests in the trust (section 2702(a)(3)(A)(ii))";
}
@source(IRC_S2702_A, relation = formalizes, coverage = exact, quote = "if such transfer involves the transfer of an interest in trust all the property in which consists of a residence to be used as a personal residence by persons holding term interests in such trust")
pub relation section_2702_residence_exception_2702(p: Person, trust: Trust) kind institutional {
    label en official "subsection (a) does not apply to a personal residence trust (section 2702(a)(3)(A)(ii))";
}
rule PersonalResidenceTrustExceptionRule(p: Person, trust: Trust) defeasible {
    when retained_trust_interest(p, trust);
    when trust_all_property_personal_residence_2702(trust);
    then section_2702_residence_exception_2702(p, trust);
}

// (c)(1),(3),(4): term interests in property are treated as trust interests
pub enum TermInterestKind2702 {
    LifeInterest;
    TermOfYearsInterest;
}
pub relation term_interest_retained_2702(holder: Person, item: Asset, kind: TermInterestKind2702) kind empirical {
    label en unofficial "the holder retains a life interest or an interest for a term of years in property, and transfers the remainder to a member of the family (section 2702(c)(1), (3))";
}
pub relation term_interest_transfer_incomplete_gift_2702(holder: Person, item: Asset) kind empirical {
    label en unofficial "the transfer would not be treated as a gift whether or not consideration was received (section 2702(a)(3)(B))";
}
pub relation tangible_property_nonexercise_no_substantial_effect_2702(item: Asset) kind empirical {
    label en unofficial "the nonexercise of the rights under a term interest in tangible property would not have a substantial effect on the valuation of the remainder (section 2702(c)(4))";
}
pub relation term_interest_sale_price_to_unrelated_2702c4(holder: Person, item: Asset, v: Money) kind empirical {
    label en unofficial "the amount which the holder establishes for which the term interest could be sold to an unrelated third party (section 2702(c)(4)(B))";
}
pub relation term_interest_value_2702(holder: Person, item: Asset, v: Money) kind institutional {
    label en official "the value of the retained term interest in property for section 2702(a)(1): zero, or the unrelated-party sale price for tangible property whose nonexercise is immaterial (section 2702(c))";
}
rule TermInterestValueZeroRule(holder: Person, item: Asset, kind: TermInterestKind2702) defeasible {
    label en official "the transfer of an interest in property with a term interest is a transfer in trust: the retained term interest is a non-qualified interest valued at zero (section 2702(c)(1), (a)(2)(A))";
    when term_interest_retained_2702(holder, item, kind);
    when not_known(term_interest_transfer_incomplete_gift_2702(holder, item));
    when not_known(tangible_property_nonexercise_no_substantial_effect_2702(item));
    then term_interest_value_2702(holder, item, 0.00 USD);
}
rule TermInterestValueTangibleRule(holder: Person, item: Asset, kind: TermInterestKind2702, v: Money) defeasible {
    label en official "for tangible property whose nonexercise is immaterial the interest is worth what the holder establishes as its sale price to an unrelated party (section 2702(c)(4))";
    when term_interest_retained_2702(holder, item, kind);
    when not_known(term_interest_transfer_incomplete_gift_2702(holder, item));
    when tangible_property_nonexercise_no_substantial_effect_2702(item);
    when term_interest_sale_price_to_unrelated_2702c4(holder, item, v);
    then term_interest_value_2702(holder, item, v);
}

// (c)(2): joint purchases
pub relation joint_purchase_of_term_and_remainder_2702(term_holder: Person, other: Person, item: Asset) kind empirical {
    label en unofficial "members of the same family acquire interests in property with term interests in the same transaction or a series of related transactions (section 2702(c)(2))";
}
pub relation value_of_interest_acquired_by_other_2702(term_holder: Person, other: Person, item: Asset, v: Money) kind empirical {
    label en unofficial "the value of the interest acquired by the other person";
}
pub relation consideration_provided_by_other_2702(term_holder: Person, other: Person, item: Asset, v: Money) kind empirical {
    label en unofficial "the consideration provided by the other person for the interest";
}
@source(IRC_S2702_C, relation = formalizes, coverage = exact, quote = "shall be treated as having acquired the entire property and then transferred to the other persons the interests acquired by such other persons in the transaction")
pub relation deemed_transfer_in_joint_purchase_2702c2(term_holder: Person, other: Person, item: Asset, gift: Money) kind institutional {
    label en official "the acquirer of the term interest is treated as having acquired the whole and transferred the others' interests in exchange for the consideration they provided (section 2702(c)(2))";
}
rule DeemedTransferInJointPurchaseRule(term_holder: Person, other: Person, item: Asset, v: Money, paid: Money) defeasible {
    when joint_purchase_of_term_and_remainder_2702(term_holder, other, item);
    when value_of_interest_acquired_by_other_2702(term_holder, other, item, v);
    when consideration_provided_by_other_2702(term_holder, other, item, paid);
    then deemed_transfer_in_joint_purchase_2702c2(term_holder, other, item, max(0.00 USD, v - paid));
}

// (d): portion of a trust
pub relation transfer_of_specified_portion_2702d(p: Person, trust: Trust, portion: Decimal) kind empirical {
    label en unofficial "the transfer is of an income or remainder interest in a specified portion of the trust property, this fraction of it (section 2702(d))";
}
@source(IRC_S2702_D, relation = formalizes, coverage = exact, quote = "only such portion shall be taken into account in applying this section to such transfer")
pub relation section_2702_value_of_portion(p: Person, trust: Trust, v: Money) kind institutional {
    label en official "the section 2702 value taking into account only the specified portion (section 2702(d))";
}
rule Section2702ValueOfPortionRule(p: Person, trust: Trust, whole: Money, portion: Decimal) defeasible {
    when section_2702_value(p, trust, whole);
    when transfer_of_specified_portion_2702d(p, trust, portion);
    then section_2702_value_of_portion(p, trust, round(whole * portion, 2, "HALF_UP"));
}

// (e): member of the family has the meaning of section 2704(c)(2)
@source(IRC_S2704_C, relation = formalizes, coverage = exact, quote = "any brother or sister of the individual")
pub relation member_of_family_2704c2(m: Person, individual: Person) kind institutional {
    label en official "member of the family: the spouse, an ancestor or lineal descendant of the individual or the spouse, a brother or sister, and the spouse of any such ancestor, descendant, brother or sister (section 2704(c)(2)); section 2702(e) refers here";
}
rule Member2704SpouseRule(m: Person, individual: Person) defeasible {
    when spouse_2701(m, individual);
    then member_of_family_2704c2(m, individual);
}
rule Member2704AncestorRule(m: Person, individual: Person) defeasible {
    when ancestor_by_blood_2701(m, individual);
    then member_of_family_2704c2(m, individual);
}
rule Member2704DescendantRule(m: Person, individual: Person) defeasible {
    when lineal_descendant_by_blood_2701(m, individual);
    then member_of_family_2704c2(m, individual);
}
rule Member2704AncestorOfSpouseRule(m: Person, individual: Person, s: Person) defeasible {
    when spouse_2701(s, individual);
    when ancestor_by_blood_2701(m, s);
    then member_of_family_2704c2(m, individual);
}
rule Member2704DescendantOfSpouseRule(m: Person, individual: Person, s: Person) defeasible {
    when spouse_2701(s, individual);
    when lineal_descendant_by_blood_2701(m, s);
    then member_of_family_2704c2(m, individual);
}
rule Member2704SiblingRule(m: Person, individual: Person) defeasible {
    when sibling_2701(m, individual);
    then member_of_family_2704c2(m, individual);
}
rule Member2704SpouseOfAncestorRule(m: Person, individual: Person, a: Person) defeasible {
    when ancestor_by_blood_2701(a, individual);
    when spouse_2701(m, a);
    then member_of_family_2704c2(m, individual);
}
rule Member2704SpouseOfDescendantRule(m: Person, individual: Person, d: Person) defeasible {
    when lineal_descendant_by_blood_2701(d, individual);
    when spouse_2701(m, d);
    then member_of_family_2704c2(m, individual);
}
rule Member2704SpouseOfSiblingRule(m: Person, individual: Person, b: Person) defeasible {
    when sibling_2701(b, individual);
    when spouse_2701(m, b);
    then member_of_family_2704c2(m, individual);
}

// =====================================================================
// §2704(b)(3), (c)(1), (c)(3)
// =====================================================================

pub relation restriction_commercially_reasonable_financing_2704(entity_id: Integer, restriction_id: Integer) kind empirical {
    label en unofficial "the restriction is a commercially reasonable restriction arising as part of any financing by the entity (section 2704(b)(3)(A))";
}
pub relation financing_with_unrelated_person_2704(entity_id: Integer, restriction_id: Integer) kind empirical {
    label en unofficial "the financing is with a person who is not related to the transferor or transferee or a member of the family of either (section 2704(b)(3)(A))";
}
pub relation restriction_imposed_by_federal_or_state_law_2704(entity_id: Integer, restriction_id: Integer) kind empirical {
    label en unofficial "the restriction is imposed, or required to be imposed, by any Federal or State law (section 2704(b)(3)(B))";
}
@source(IRC_S2704_B, relation = formalizes, coverage = exact, quote = "The term \"applicable restriction\" shall not include")
pub relation applicable_restriction_excepted_2704b3(entity_id: Integer, restriction_id: Integer) kind institutional {
    label en official "the restriction is not an applicable restriction: commercially reasonable financing with an unrelated person, or imposed by Federal or State law (section 2704(b)(3))";
}
rule RestrictionExceptedFinancingRule(entity_id: Integer, restriction_id: Integer) defeasible {
    when restriction_commercially_reasonable_financing_2704(entity_id, restriction_id)
        and financing_with_unrelated_person_2704(entity_id, restriction_id);
    then applicable_restriction_excepted_2704b3(entity_id, restriction_id);
}
rule RestrictionExceptedLawRule(entity_id: Integer, restriction_id: Integer) defeasible {
    when restriction_imposed_by_federal_or_state_law_2704(entity_id, restriction_id);
    then applicable_restriction_excepted_2704b3(entity_id, restriction_id);
}

// (c)(1),(3): control by the 2701(b)(2) test, attribution by 2701(e)(3)
pub relation family_combined_share_2704(transferor: Person, entity_id: Integer, share: Decimal) kind empirical {
    label en unofficial "the share (by vote or value) of the entity held, counting indirect holdings, by the transferor and members of the transferor's family immediately before the transfer (section 2704(b)(1)(B), (c)(3))";
}
@source(IRC_S2704_C, relation = formalizes, coverage = exact, quote = "The term \"control\" has the meaning given such term by section 2701(b)(2).")
pub relation control_before_transfer_2704(transferor: Person, entity_id: Integer) kind institutional {
    label en official "the transferor and members of the family hold control (at least 50 percent) of the entity (section 2704(b)(1)(B), (c)(1))";
}
rule ControlBeforeTransferAssertedRule(transferor: Person, entity_id: Integer) defeasible {
    when family_controls_entity_before_transfer_2704(transferor, entity_id);
    then control_before_transfer_2704(transferor, entity_id);
}
rule ControlBeforeTransferByShareRule(transferor: Person, entity_id: Integer, share: Decimal) defeasible {
    when family_combined_share_2704(transferor, entity_id, share);
    when share >= 0.50;
    then control_before_transfer_2704(transferor, entity_id);
}
@source(IRC_S2704_C, relation = formalizes, coverage = exact, quote = "The rule of section 2701(e)(3) shall apply for purposes of determining the interests held by any individual.")
pub relation interest_held_for_2704_2704c3(i: Person, entity_id: Integer) kind institutional {
    label en official "interests held include those held indirectly (section 2704(c)(3), section 2701(e)(3))";
}
rule InterestHeldFor2704Rule(i: Person, entity_id: Integer) defeasible {
    when interest_treated_as_held_2701e3(i, entity_id);
    then interest_held_for_2704_2704c3(i, entity_id);
}

// =====================================================================
// §2801(e)(4): transfers in trust
// =====================================================================

pub relation domestic_trust_2801(trust: Trust) kind empirical {
    label en unofficial "the trust is a domestic trust";
}
pub relation foreign_trust_2801(trust: Trust) kind empirical {
    label en unofficial "the trust is a foreign trust";
}
pub relation united_states_citizen_or_resident_2801(p: Person) kind empirical {
    label en unofficial "the person is a United States citizen or resident";
}
pub relation foreign_trust_elects_domestic_treatment_2801(trust: Trust) kind empirical {
    label en unofficial "the foreign trust elects to be treated as a domestic trust solely for purposes of section 2801 (section 2801(e)(4)(B)(iii))";
}
pub relation secretary_consents_to_election_revocation_2801(trust: Trust) kind empirical {
    label en unofficial "the Secretary consents to the revocation of the election";
}
pub relation foreign_trust_revokes_domestic_election_2801(trust: Trust) kind empirical {
    label en unofficial "the foreign trust revokes its election";
}
pub relation foreign_trust_treated_as_domestic_2801(trust: Trust) kind institutional {
    label en official "the foreign trust is treated as a domestic trust for section 2801 by election (section 2801(e)(4)(B)(iii))";
}
pub relation foreign_trust_election_revoked_2801(trust: Trust) kind institutional {
    label en official "the foreign trust's election is revoked with the Secretary's consent (section 2801(e)(4)(B)(iii))";
}
@source(IRC_S2801_E, relation = formalizes, coverage = exact, quote = "a foreign trust may elect to be treated as a domestic trust")
rule ForeignTrustElectsDomesticTreatmentPower(trust: Trust) strict {
    label en official "a foreign trust may elect to be treated as a domestic trust (section 2801(e)(4)(B)(iii))";
    when foreign_trust_elects_domestic_treatment_2801(trust);
    then power ForeignTrustElectsDomesticTreatment {
        holder trust;
        over trust;
        exercise foreign_trust_elects_domestic_treatment_2801(trust);
        valid_when foreign_trust_2801(trust);
        effect create(foreign_trust_treated_as_domestic_2801(trust));
        window [@2008-06-17, infinity);
    };
}
@source(IRC_S2801_E, relation = formalizes, coverage = exact, quote = "Such an election may be revoked with the consent of the Secretary.")
rule ForeignTrustRevokesElectionPower(trust: Trust) strict {
    label en official "the election may be revoked with the consent of the Secretary (section 2801(e)(4)(B)(iii))";
    when foreign_trust_revokes_domestic_election_2801(trust);
    when foreign_trust_treated_as_domestic_2801(trust);
    then power ForeignTrustRevokesElection {
        holder trust;
        over trust;
        exercise foreign_trust_revokes_domestic_election_2801(trust);
        valid_when secretary_consents_to_election_revocation_2801(trust);
        effect create(foreign_trust_election_revoked_2801(trust));
        window [@2008-06-17, infinity);
    };
}
relation trust_treated_as_domestic_2801(trust: Trust) kind institutional;
rule TrustDomesticByNatureRule(trust: Trust) defeasible {
    when domestic_trust_2801(trust);
    then trust_treated_as_domestic_2801(trust);
}
rule TrustDomesticByElectionRule(trust: Trust) defeasible {
    when foreign_trust_treated_as_domestic_2801(trust);
    when not_known(foreign_trust_election_revoked_2801(trust));
    then trust_treated_as_domestic_2801(trust);
}

@source(IRC_S2801_E, relation = formalizes, coverage = exact, quote = "subsection (a) shall apply in the same manner as if such trust were a United States citizen")
pub relation trust_treated_as_united_states_citizen_2801(trust: Trust) kind institutional {
    label en official "a domestic trust receiving a covered gift or bequest is treated as a United States citizen and pays the tax (section 2801(e)(4)(A))";
}
rule DomesticTrustTreatedAsCitizenRule(trust: Trust) defeasible {
    when trust_treated_as_domestic_2801(trust);
    then trust_treated_as_united_states_citizen_2801(trust);
}

pub relation foreign_trust_distribution_of_covered_gift_2801(trust: Trust, recipient: Person, source_individual: Individual, item: Asset, y: Integer, value: Money) kind empirical {
    label en unofficial "a distribution (from income or corpus) attributable to a covered gift or bequest made to the foreign trust, to a United States citizen or resident recipient (section 2801(e)(4)(B)(i))";
}
rule ForeignTrustDistributionIsCoveredGiftRule(trust: Trust, recipient: Person, source_individual: Individual, item: Asset, y: Integer, value: Money) defeasible {
    label en official "a distribution from a foreign trust attributable to a covered gift is itself a covered gift or bequest to the citizen or resident recipient (section 2801(e)(4)(B)(i))";
    when foreign_trust_distribution_of_covered_gift_2801(trust, recipient, source_individual, item, y, value);
    when foreign_trust_2801(trust);
    when not_known(trust_treated_as_domestic_2801(trust));
    when united_states_citizen_or_resident_2801(recipient);
    when covered_expatriate(source_individual);
    when not_known(covered_gift_or_bequest_excepted(item));
    then taxable_covered_gift_item(recipient, source_individual, item, y, value);
}
pub relation tax_2801_paid_by_reason_of_foreign_trust_distribution(recipient: Person, y: Integer, amount: Money) kind empirical {
    label en unofficial "the tax imposed by section 2801 paid or accrued by the citizen or resident by reason of a distribution from a foreign trust (section 2801(e)(4)(B)(ii))";
}
pub relation portion_of_distribution_included_in_gross_income_tax_2801(recipient: Person, y: Integer, amount: Money) kind empirical {
    label en unofficial "the part of that tax that is imposed on the portion of the distribution included in the gross income of the recipient";
}
@source(IRC_S2801_E, relation = formalizes, coverage = exact, quote = "There shall be allowed as a deduction under section 164 the amount of tax imposed by this section")
pub relation deduction_164_for_foreign_trust_covered_gift_tax_2801(recipient: Person, y: Integer, amount: Money) kind institutional {
    label en official "deduction under section 164 for the tax paid by reason of a foreign trust distribution, only to the extent imposed on the part included in gross income (section 2801(e)(4)(B)(ii))";
}
rule Deduction164ForeignTrustRule(recipient: Person, y: Integer, paid: Money, included: Money) defeasible {
    when tax_2801_paid_by_reason_of_foreign_trust_distribution(recipient, y, paid);
    when portion_of_distribution_included_in_gross_income_tax_2801(recipient, y, included);
    then deduction_164_for_foreign_trust_covered_gift_tax_2801(recipient, y, min(paid, included));
}
