// 26 U.S.C. §2623 — Taxable amount in case of direct skip
fragment IRC_S2623 in IRC_2024_EDITION {
    kind section;
    locator "section/2623";
    text en official """Taxable amount in case of direct skip
For purposes of this chapter, the taxable amount in the case of a direct skip shall be the value of the property received by the transferee.""";
    content_hash "sha256:9cdaa0dd2f666bffe26d953bd3cb847a8f096874cdc45b2eb654d3bce76f7d9f";
