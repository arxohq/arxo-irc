    content_hash "sha256:bf7027aa03c221e2924dec94102db221ec6666731e9107e7aec0d1f581db2a6a";
}

// 26 U.S.C. 2519(a) — Dispositions of certain life estates
fragment IRC_S2519_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/2519/a";
    text en official """(a) General rule
For purposes of this chapter and chapter 11, any disposition of all or part of a qualifying income interest for life in any property to which this section applies shall be treated as a transfer of all interests in such property other than the qualifying income interest.""";
    content_hash "sha256:945b94825e3de8c41f5a05022d20aa777d3949e9a8b1d2c0fc87afed83309923";
}

// 26 U.S.C. 2519(b) — Dispositions of certain life estates
fragment IRC_S2519_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/2519/b";
    text en official """(b) Property to which this subsection applies
This section applies to any property if a deduction was allowed with respect to the transfer of such property to the donor—
(1) under section 2056 by reason of subsection (b)(7) thereof, or
(2) under section 2523 by reason of subsection (f) thereof.""";
    content_hash "sha256:b3db925d0bfb712278d2c735232808d1807911c61b6e4e52121cbf24ab2cc10e";
}

// 26 U.S.C. 2519(c) — Dispositions of certain life estates
fragment IRC_S2519_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/2519/c";
    text en official """(c) Cross reference
For right of recovery for gift tax in the case of property treated as transferred under this section, see section 2207A(b).""";
    content_hash "sha256:a53b2bb6ade8bc6c16da7f7e9bb932f30279937eefe63552a505a7fb81ffc3e7";
}

