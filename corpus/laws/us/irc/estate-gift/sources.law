// 26 U.S.C. 2624(a) — Valuation
fragment IRC_S2624_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/2624/a";
    text en official """(a) General rule
Except as otherwise provided in this chapter, property shall be valued as of the time of the generation-skipping transfer.""";
    content_hash "sha256:7e106b0e26e24c3aeb41b89163c1ab2da4052104349395cca7773d5a1f3083ab";
}

// 26 U.S.C. 2624(b) — Valuation
fragment IRC_S2624_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/2624/b";
    text en official """(b) Alternate valuation and special use valuation elections apply to certain direct skips
In the case of any direct skip of property which is included in the transferor's gross estate, the value of such property for purposes of this chapter shall be the same as its value for purposes of chapter 11 (determined with regard to sections 2032 and 2032A).""";
    content_hash "sha256:427e11c6582edc4cc7a2e14efa9710f0bc5e8ef36f9ad09384e2075495403a95";
}

// 26 U.S.C. 2624(c) — Valuation
fragment IRC_S2624_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/2624/c";
    text en official """(c) Alternate valuation election permitted in the case of taxable terminations occurring at death
If 1 or more taxable terminations with respect to the same trust occur at the same time as and as a result of the death of an individual, an election may be made to value all of the property included in such terminations in accordance with section 2032.""";
    content_hash "sha256:b553d551d902eec0d83624a9df5398bb827ad2c4754e1be56d1de4a4e1b553c7";
}

// 26 U.S.C. 2624(d) — Valuation
fragment IRC_S2624_D in IRC_2024_EDITION {
    kind subsection;
    locator "section/2624/d";
    text en official """(d) Reduction for consideration provided by transferee
For purposes of this chapter, the value of the property transferred shall be reduced by the amount of any consideration provided by the transferee.""";
    content_hash "sha256:e3cfce7a2e8fe1610205e557eda4123c97ccb037a193717d5ec2b43d7e3a05cf";
}

