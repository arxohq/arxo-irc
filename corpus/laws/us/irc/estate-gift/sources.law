// 26 U.S.C. 2621(a) — Taxable amount in case of taxable distribution
fragment IRC_S2621_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/2621/a";
    text en official """(a) In general
For purposes of this chapter, the taxable amount in the case of any taxable distribution shall be—
(1) the value of the property received by the transferee, reduced by
(2) any expense incurred by the transferee in connection with the determination, collection, or refund of the tax imposed by this chapter with respect to such distribution.""";
    content_hash "sha256:65b99b0ab5d144b088e763cb4cb96034fa2c2120ffff7f3534050050301a7164";
}

// 26 U.S.C. 2621(b) — Taxable amount in case of taxable distribution
fragment IRC_S2621_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/2621/b";
    text en official """(b) Payment of GST tax treated as taxable distribution
For purposes of this chapter, if any of the tax imposed by this chapter with respect to any taxable distribution is paid out of the trust, an amount equal to the portion so paid shall be treated as a taxable distribution.""";
    content_hash "sha256:04a164348d7c3c8a5173e995cfad14583495f514d7611e1938308bba9f7f3479";
}

// 26 U.S.C. §2621 — statutory note 4 (effectivedate-amendment-note)
