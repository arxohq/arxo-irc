// 26 U.S.C. 2044(a) — Certain property for which marital deduction was previously allowed
fragment IRC_S2044_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/2044/a";
    text en official """(a) General rule
The value of the gross estate shall include the value of any property to which this section applies in which the decedent had a qualifying income interest for life.""";
    content_hash "sha256:57d7e568d33610fefbad5b60cea0e6dcb98a8e3db6f32296c7433f18325369a2";
}

// 26 U.S.C. 2044(b) — Certain property for which marital deduction was previously allowed
fragment IRC_S2044_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/2044/b";
    text en official """(b) Property to which this section applies
This section applies to any property if—
(1) a deduction was allowed with respect to the transfer of such property to the decedent—
(A) under section 2056 by reason of subsection (b)(7) thereof, or
(B) under section 2523 by reason of subsection (f) thereof, and
(2) section 2519 (relating to dispositions of certain life estates) did not apply with respect to a disposition by the decedent of part or all of such property.""";
    content_hash "sha256:790c73d23328cbc3777338eb280d2cb05bbdc315575ac1fb4029cc0560c55997";
}

// 26 U.S.C. 2044(c) — Certain property for which marital deduction was previously allowed
fragment IRC_S2044_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/2044/c";
    text en official """(c) Property treated as having passed from decedent
For purposes of this chapter and chapter 13, property includible in the gross estate of the decedent under subsection (a) shall be treated as property passing from the decedent.""";
    content_hash "sha256:bd9b7c6764f597c081b772d693ff8fa615eaa481ffdde053cf9dc79154b08f22";
}

