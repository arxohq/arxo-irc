// 26 U.S.C. 2622(a) — Taxable amount in case of taxable termination
fragment IRC_S2622_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/2622/a";
    text en official """(a) In general
For purposes of this chapter, the taxable amount in the case of a taxable termination shall be—
(1) the value of all property with respect to which the taxable termination has occurred, reduced by
(2) any deduction allowed under subsection (b).""";
    content_hash "sha256:3f9de897a1b8403256606cb68e50f248f76f2e41da216d8d417496b64db2113d";
}

// 26 U.S.C. 2622(b) — Taxable amount in case of taxable termination
fragment IRC_S2622_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/2622/b";
    text en official """(b) Deduction for certain expenses
For purposes of subsection (a), there shall be allowed a deduction similar to the deduction allowed by section 2053 (relating to expenses, indebtedness, and taxes) for amounts attributable to the property with respect to which the taxable termination has occurred.""";
    content_hash "sha256:74d7c2345b59fe03c7f3d9c7ea651b5fa08b82f2c709f36256438ad25d03bde8";
}

