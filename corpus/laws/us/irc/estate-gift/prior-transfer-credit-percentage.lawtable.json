{
 "schemaVersion": "law.decision/0.1",
 "kind": "decision-table",
 "id": "urn:us:irc:estate_gift:clir:table:prior-transfer-credit-percentage",
 "mode": "rules",
 "hitPolicy": "first",
 "total": true,
 "inputs": [
  {
   "id": "years_predeceased",
   "name": "Full years by which the transferor predeceased the decedent (only invoked when this exceeds 2, per section 2013(a))",
   "type": { "name": "urn:law:std#Decimal" }
  }
 ],
 "outputs": [
  {
   "id": "pct",
   "name": "Percentage of the section 2013(b)/(c) amount allowed as the credit",
   "type": { "name": "urn:law:std#Decimal" }
  }
 ],
 "emit": {
  "predicate": "urn:us:irc:estate_gift:clir#prior_transfer_credit_percentage_by_years",
  "polarity": "positive",
  "args": [
   { "kind": "input", "id": "years_predeceased" },
   { "kind": "output", "id": "pct" }
  ]
 },
 "labels": [
  {
   "language": "en",
   "status": "official",
   "text": "Section 2013(a)(1)-(4): 80/60/40/20 percent by the two-year band (3rd-4th, 5th-6th, 7th-8th, 9th-10th year preceding the decedent's death) within which the transferor's death, more than 2 years before the decedent's, falls; the caller applies this table only when years_predeceased is greater than 2 (the within-2-years case is 100 percent, handled directly by the invoking rule, not by this table)."
  }
 ],
 "rows": [
  {
   "id": "third-or-fourth-year",
   "when": [
    { "input": "years_predeceased", "condition": { "kind": "comparison", "op": "lte", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "4" } } }
   ],
   "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.80" } } ],
   "anchors": ["IRC_S2013_A"]
  },
  {
   "id": "fifth-or-sixth-year",
   "when": [
    { "input": "years_predeceased", "condition": { "kind": "comparison", "op": "lte", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "6" } } }
   ],
   "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.60" } } ],
   "anchors": ["IRC_S2013_A"]
  },
  {
   "id": "seventh-or-eighth-year",
   "when": [
    { "input": "years_predeceased", "condition": { "kind": "comparison", "op": "lte", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "8" } } }
   ],
   "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.40" } } ],
   "anchors": ["IRC_S2013_A"]
  },
  {
   "id": "ninth-or-tenth-year",
   "when": [
    { "input": "years_predeceased", "condition": { "kind": "comparison", "op": "lte", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "10" } } }
   ],
   "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.20" } } ],
   "anchors": ["IRC_S2013_A"]
  },
  {
   "id": "beyond-tenth-year-not-eligible",
   "when": [ { "input": "years_predeceased", "condition": { "kind": "any" } } ],
   "then": [ { "output": "pct", "value": { "kind": "value", "type": { "name": "urn:law:std#Decimal" }, "value": "0.00" } } ],
   "anchors": ["IRC_S2013_A"]
  }
 ]
}
