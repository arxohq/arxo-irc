// 26 U.S.C. §§2701(a)-(e), 2702(a)-(b), 2703, 2704 — chapter 14 special
// valuation rules. Stage-2b module of `us.irc.estate_gift` (B01/IRC-11).
// Publishes `pub section_2701_value`.
//
// SCOPE: the CORE zero-value rule and its qualified-payment/control
// machinery for §2701(a)-(b), a family-attribution aggregate for §2701(e)
// (case-asserted, NOT derived from `us.irc.corporations::constructive_
// ownership` — importing that package was judged too large a structural
// change this late in a single pass; not attempted, TECH-GAPS.md G484), the
// §2702(a)-(b) parallel zero-value/qualified-interest rule for trusts, the
// full §2703 three-part exception test, and the §2704(a)-(b) lapse/
// restriction rules.
//
// NOT MODELLED this pass (TECH_GAP, TECH-GAPS.md G484): §2701(c)'s detailed
// distribution/liquidation-right definitions and the election mechanics of
// (c)(3)(C) (read as case-asserted classifications instead); §2701(d)'s
// cumulative-unpaid-qualified-payment increase (one of the most intricate
// computations in the Code — a reinvestment-at-a-discount-rate ledger over
// an indefinite period, genuinely out of budget); §2701(e)(1)-(2) beyond the
// family-attribution aggregate; §2702(c)-(e) (joint purchases, term-interest
// special valuation, portion-of-trust apportionment); §2704(a)(3),(b)(3)-(4)
// (similar-rights extension, the financing/Federal-law exceptions, the
// Secretary's other-restrictions authority).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    IRC_S2701_A,
    IRC_S2701_B,
    IRC_S2702_A,
    IRC_S2703_A,
    IRC_S2704_A,
    IRC_S2704_B,
    Person,
    Trust,
    applicable_restriction_excepted_2704b3,
    control_before_transfer_2704,
    family_transfer_for_2701,
    qualified_payment_effective_2701,
    qualified_payment_value_determined_2701,
    retained_interest_excepted_2701a2,
    section_2702_residence_exception_2702,
    transferred_interest_market_quoted_2701,
};

// =====================================================================
// §2701 — special valuation rules for corporation/partnership interests
// =====================================================================

pub enum RetainedInterestRightKind {
    DistributionRight;                    // (b)(1)(A)
    LiquidationPutCallConversionRight;    // (b)(1)(B)
}
pub relation applicable_retained_interest_2701(person: Person, entity_id: Integer, kind: RetainedInterestRightKind) kind empirical {
    label en unofficial "person holds an applicable retained interest of the stated kind in the entity, immediately after the transfer (section 2701(b)(1))";
}
pub relation transfer_of_entity_interest_to_family_member(transferor: Person, transferee: Person, entity_id: Integer, value: Money) kind empirical {
    label en unofficial "the transferor transferred an interest in the entity to (or for the benefit of) a member of the transferor's family (section 2701(a)(1))";
}
pub relation combined_vote_or_value_share_2701(transferor: Person, entity_id: Integer, share: Decimal) kind empirical {
    label en unofficial "the combined vote-or-value share of the entity held by the transferor and applicable family members, immediately before the transfer (section 2701(b)(2)(A) for a corporation; a partnership's capital-or-profits or general-partner test is read the same way, module scope)";
}

@source(IRC_S2701_B, relation = formalizes, coverage = partial, quote = "the term \"control\" means the holding of at least 50 percent (by vote or value) of the stock of the corporation")
pub relation transferor_family_controls_entity_2701(transferor: Person, entity_id: Integer) kind institutional {
    label en official "section 2701(b)(2): the transferor and applicable family members hold control (at least 50 percent) of the entity";
}
rule TransferorFamilyControlsEntity2701Rule(transferor: Person, entity_id: Integer, share: Decimal) strict {
    when combined_vote_or_value_share_2701(transferor, entity_id, share) and share >= 0.50;
    then transferor_family_controls_entity_2701(transferor, entity_id);
}

pub relation retained_right_is_qualified_payment(person: Person, entity_id: Integer) kind empirical {
    label en unofficial "the applicable retained interest's distribution right is a qualified payment (section 2701(c)(3)) — a fixed-rate cumulative preferred dividend/comparable partnership payment, or an interest elected to be so treated; case-asserted per the module header (the detailed fixed-rate/election tests are not independently derived)";
}
pub relation qualified_payment_value_2701(person: Person, entity_id: Integer, value: Money) kind empirical {
    label en unofficial "the value of the qualified-payment distribution right, determined without regard to section 2701 (section 2701(a)(3)(C)) or as if every liquidation/put/call/conversion right were exercised for the lowest resulting value (section 2701(a)(3)(B)) — case-asserted, the exercise-scenario minimization itself is not independently derived";
}

@source(IRC_S2701_A, relation = formalizes, coverage = exact, quote = "The value of any right described in paragraph (1), other than a distribution right which consists of a right to receive a qualified payment, shall be treated as being zero")
pub relation section_2701_value(transferor: Person, entity_id: Integer, value: Money) kind institutional {
    label en official "the section 2701(a)(3) value of the applicable retained interest: zero for a non-qualified-payment right (while control exists and a family transfer occurred), the case-asserted qualified-payment value otherwise";
}
rule Section2701ValueZeroRule(transferor: Person, entity_id: Integer, kind: RetainedInterestRightKind) defeasible {
    when applicable_retained_interest_2701(transferor, entity_id, kind);
    when family_transfer_for_2701(transferor, entity_id);
    when transferor_family_controls_entity_2701(transferor, entity_id);
    when not_known(retained_interest_excepted_2701a2(transferor, entity_id));
    when not_known(transferred_interest_market_quoted_2701(transferor, entity_id));
    when not_known(qualified_payment_effective_2701(transferor, entity_id));
    then section_2701_value(transferor, entity_id, 0.00 USD);
}
rule Section2701ValueQualifiedPaymentRule(transferor: Person, entity_id: Integer, value: Money) defeasible {
    when applicable_retained_interest_2701(transferor, entity_id, DistributionRight);
    when family_transfer_for_2701(transferor, entity_id);
    when transferor_family_controls_entity_2701(transferor, entity_id);
    when not_known(retained_interest_excepted_2701a2(transferor, entity_id));
    when not_known(transferred_interest_market_quoted_2701(transferor, entity_id));
    when qualified_payment_effective_2701(transferor, entity_id);
    when qualified_payment_value_determined_2701(transferor, entity_id, value);
    then section_2701_value(transferor, entity_id, value);
}

pub relation applicable_family_member_2701(candidate: Person, transferor: Person) kind empirical {
    label en unofficial "candidate is an applicable family member of the transferor: the transferor's spouse, or a lineal descendant of a parent of the transferor or the transferor's spouse (section 2701(e)(1)-(2)); case-asserted (module header: not derived from `us.irc.corporations::constructive_ownership`, TECH-GAPS.md G484)";
}

// =====================================================================
// §2702(a)-(b) — special valuation rules for trust interests
// =====================================================================

pub relation retained_trust_interest(transferor_or_family_member: Person, trust: Trust) kind empirical {
    label en unofficial "an interest in trust, transferred to (or for the benefit of) a member of the transferor's family, is retained by the transferor or an applicable family member (section 2702(a)(1))";
}
pub relation trust_transfer_incomplete_gift(transferor_or_family_member: Person, trust: Trust) kind empirical {
    label en unofficial "the transfer is an incomplete gift (section 2702(a)(3)(A)(i)/(B))";
}
pub enum QualifiedInterestKind {
    FixedAmountAnnually;             // (b)(1) - GRAT annuity interest
    FixedPercentageAnnually;         // (b)(2) - GRUT unitrust interest
    NoncontingentRemainder;          // (b)(3), only if others are (1)/(2)
}
pub relation qualified_interest_2702(transferor_or_family_member: Person, trust: Trust, kind: QualifiedInterestKind) kind empirical {
    label en unofficial "the retained interest is a qualified interest of the stated kind (section 2702(b))";
}
pub relation qualified_interest_actuarial_value_7520(transferor_or_family_member: Person, trust: Trust, value: Money) kind empirical {
    label en unofficial "the section 7520 actuarial value of the qualified interest (section 2702(a)(2)(B)) — EXTERNAL_DEPENDENCY: section 7520 is not modelled by any us.irc.* package";
}

@source(IRC_S2702_A, relation = formalizes, coverage = exact, quote = "The value of any retained interest which is not a qualified interest shall be treated as being zero")
pub relation section_2702_value(transferor_or_family_member: Person, trust: Trust, value: Money) kind institutional {
    label en official "the section 2702(a)(2) value of the retained trust interest: zero for a non-qualified interest, the section 7520 actuarial value for a qualified interest";
}
rule Section2702ValueZeroRule(transferor_or_family_member: Person, trust: Trust) defeasible {
    when retained_trust_interest(transferor_or_family_member, trust);
    when not_known(trust_transfer_incomplete_gift(transferor_or_family_member, trust));
    when not_known(section_2702_residence_exception_2702(transferor_or_family_member, trust));
    when not_known(has_qualified_interest_2702(transferor_or_family_member, trust));
    then section_2702_value(transferor_or_family_member, trust, 0.00 USD);
}
relation has_qualified_interest_2702(transferor_or_family_member: Person, trust: Trust) kind institutional;
rule HasQualifiedInterest2702Rule(transferor_or_family_member: Person, trust: Trust, kind: QualifiedInterestKind) defeasible {
    when qualified_interest_2702(transferor_or_family_member, trust, kind);
    then has_qualified_interest_2702(transferor_or_family_member, trust);
}
rule Section2702ValueQualifiedRule(transferor_or_family_member: Person, trust: Trust, value: Money) defeasible {
    when retained_trust_interest(transferor_or_family_member, trust);
    when not_known(trust_transfer_incomplete_gift(transferor_or_family_member, trust));
    when not_known(section_2702_residence_exception_2702(transferor_or_family_member, trust));
    when has_qualified_interest_2702(transferor_or_family_member, trust);
    when qualified_interest_actuarial_value_7520(transferor_or_family_member, trust, value);
    then section_2702_value(transferor_or_family_member, trust, value);
}

// =====================================================================
// §2703 — certain rights and restrictions disregarded
// =====================================================================

pub relation option_or_restriction_on_property(owner: Person, item: Asset, kind: OptionOrRestrictionKind) kind empirical {
    label en unofficial "item is subject to an option/agreement/right to acquire below fair market value, or a restriction on sale or use (section 2703(a))";
}
pub enum OptionOrRestrictionKind {
    OptionToAcquireBelowFairMarketValue; // (a)(1)
    RestrictionOnSaleOrUse;              // (a)(2)
}
pub relation option_or_restriction_bona_fide_business_arrangement(owner: Person, item: Asset) kind empirical {
    label en unofficial "the option/agreement/right/restriction is a bona fide business arrangement (section 2703(b)(1))";
}
pub relation option_or_restriction_not_a_device(owner: Person, item: Asset) kind empirical {
    label en unofficial "it is not a device to transfer the property to family members for less than full and adequate consideration (section 2703(b)(2))";
}
pub relation option_or_restriction_comparable_to_arms_length(owner: Person, item: Asset) kind empirical {
    label en unofficial "its terms are comparable to similar arrangements entered into at arm's length (section 2703(b)(3))";
}
relation option_or_restriction_meets_all_exceptions(owner: Person, item: Asset) kind institutional;
rule OptionOrRestrictionMeetsAllExceptionsRule(owner: Person, item: Asset) strict {
    when option_or_restriction_bona_fide_business_arrangement(owner, item)
        and option_or_restriction_not_a_device(owner, item)
        and option_or_restriction_comparable_to_arms_length(owner, item);
    then option_or_restriction_meets_all_exceptions(owner, item);
}

@source(IRC_S2703_A, relation = formalizes, coverage = exact, quote = "the value of any property shall be determined without regard to")
pub relation option_or_restriction_disregarded(owner: Person, item: Asset) kind institutional {
    label en official "section 2703(a): the option/agreement/right/restriction is disregarded in valuing the property, unless it meets all three section 2703(b) exceptions";
}
rule OptionOrRestrictionDisregardedRule(owner: Person, item: Asset, kind: OptionOrRestrictionKind) defeasible {
    when option_or_restriction_on_property(owner, item, kind);
    when not_known(option_or_restriction_meets_all_exceptions(owner, item));
    then option_or_restriction_disregarded(owner, item);
}

// =====================================================================
// §2704 — lapsing rights and restrictions
// =====================================================================

pub relation voting_or_liquidation_right_lapse(individual: Person, entity_id: Integer, on: Date) kind empirical {
    label en unofficial "a voting or liquidation right of individual in the entity lapsed on the stated date (section 2704(a)(1)(A))";
}
pub relation family_controls_entity_before_and_after_lapse(individual: Person, entity_id: Integer) kind empirical {
    label en unofficial "the individual and family members hold control of the entity both before and after the lapse (section 2704(a)(1)(B)) — reuses the section 2701(b)(2) control test by the module's own convention";
}
pub relation entity_interest_value_before_lapse_nonlapsing_assumption(individual: Person, entity_id: Integer, value: Money) kind empirical {
    label en unofficial "the value of all interests held by individual immediately before the lapse, determined as if the voting/liquidation rights were nonlapsing (section 2704(a)(2)(A))";
}
pub relation entity_interest_value_after_lapse(individual: Person, entity_id: Integer, value: Money) kind empirical {
    label en unofficial "the value of such interests immediately after the lapse (section 2704(a)(2)(B))";
}

@source(IRC_S2704_A, relation = formalizes, coverage = exact, quote = "such lapse shall be treated as a transfer by such individual by gift, or a transfer which is includible in the gross estate of the decedent, whichever is applicable")
pub relation lapse_deemed_transfer_amount_2704(individual: Person, entity_id: Integer, amount: Money) kind institutional {
    label en official "section 2704(a): the lapse is a deemed transfer, in the amount of the excess of the nonlapsing-assumption value over the post-lapse value";
}
rule LapseDeemedTransferAmount2704Rule(individual: Person, entity_id: Integer, on: Date, before: Money, after: Money) defeasible {
    when voting_or_liquidation_right_lapse(individual, entity_id, on);
    when family_controls_entity_before_and_after_lapse(individual, entity_id);
    when entity_interest_value_before_lapse_nonlapsing_assumption(individual, entity_id, before);
    when entity_interest_value_after_lapse(individual, entity_id, after);
    then lapse_deemed_transfer_amount_2704(individual, entity_id, max(0.00 USD, before - after));
}

pub relation applicable_restriction_on_liquidation(entity_id: Integer, restriction_id: Integer) kind empirical {
    label en unofficial "restriction_id effectively limits the entity's ability to liquidate, and either lapses after the transfer or is removable by the transferor/family (section 2704(b)(2))";
}
pub relation family_controls_entity_before_transfer_2704(transferor: Person, entity_id: Integer) kind empirical {
    label en unofficial "the transferor and family members hold control of the entity immediately before the transfer (section 2704(b)(1)(B))";
}

@source(IRC_S2704_B, relation = formalizes, coverage = exact, quote = "any applicable restriction shall be disregarded in determining the value of the transferred interest")
pub relation applicable_restriction_disregarded_2704(transferor: Person, entity_id: Integer, restriction_id: Integer) kind institutional {
    label en official "section 2704(b): the applicable restriction is disregarded in valuing the transferred interest";
}
rule ApplicableRestrictionDisregarded2704Rule(transferor: Person, entity_id: Integer, restriction_id: Integer) defeasible {
    when transfer_of_entity_interest_to_family_member(transferor, _, entity_id, _);
    when control_before_transfer_2704(transferor, entity_id);
    when applicable_restriction_on_liquidation(entity_id, restriction_id);
    when not_known(applicable_restriction_excepted_2704b3(entity_id, restriction_id));
    then applicable_restriction_disregarded_2704(transferor, entity_id, restriction_id);
}
