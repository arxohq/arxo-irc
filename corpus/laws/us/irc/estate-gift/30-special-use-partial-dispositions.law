// 26 U.S.C. §2032A(c)(2)(D), (E) — partial dispositions of the interest and the
// special rule for timber on qualified woodland. Stage 2 (DECISION-0379 with
// deontics) of `us.irc.estate_gift` (B01/IRC-11); continues
// 08-special-use-valuation-2032a.law and 27-special-use-valuation-completion.law.
//
// SHAPE. No positions: the section states the amount of the additional tax of each
// portion; the duty to pay it is `QualifiedHeirAdditionalTaxDuty` of module 08.
//
// JUDGMENT CALLS
//  - (D)(ii): "reduced by the tax imposed with respect to all prior transactions
//    involving portions" is a sum over the earlier portions of this very relation.
//    A predicate reading its own earlier tuples through a sum is not stratifiable
//    (LDC-E4102), so the prior total is a case input; the arithmetic of the
//    reduction is computed (TECH-GAPS G3616).
//  - (E)(ii)(II): "the additional tax determined if the entire interest had been
//    disposed of" is a counterfactual run of subsection (c)(2)(A): asserted.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2032A_C,
    Individual,
    adjusted_tax_difference_attributable_to_interest,
    recapture_event_within_window,
    special_use_value,
    woodland_election_effective,
};

pub relation portion_disposed_2032a(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, share: Decimal, realized: Money) kind empirical {
    label en unofficial "the qualified heir disposes of the n-th portion of the interest (or there is a cessation of use of the portion) on the date; the portion is this share of the interest; the amount realized on it (or, absent an arm's-length sale, its fair market value)";
}
pub relation prior_portion_taxes_2032ac2d(e: Estate, prop: Asset, n: Integer, total: Money) kind empirical {
    label en unofficial "the tax imposed by subsection (c) with respect to all prior transactions involving portions of the interest (asserted, see the module header)";
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "the value determined under subsection (a) taken into account under subparagraph (A)(ii) with respect to such portion shall be its pro rata share of such value of such interest")
pub relation portion_use_value_2032ac2di(e: Estate, prop: Asset, n: Integer, value: Money) kind institutional {
    label en official "the section 2032A(a) value taken into account for the portion: its pro rata share of the value of the interest (section 2032A(c)(2)(D)(i))";
}
rule PortionUseValueRule(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, share: Decimal, realized: Money, use_value: Money) defeasible {
    when portion_disposed_2032a(e, prop, heir, n, on, share, realized);
    when special_use_value(e, prop, use_value);
    then portion_use_value_2032ac2di(e, prop, n, round(use_value * share, 2, "HALF_UP"));
}
relation has_prior_portion_taxes_2032ac2d(e: Estate, prop: Asset, n: Integer) kind institutional;
rule HasPriorPortionTaxesRule(e: Estate, prop: Asset, n: Integer, total: Money) defeasible {
    when prior_portion_taxes_2032ac2d(e, prop, n, total);
    then has_prior_portion_taxes_2032ac2d(e, prop, n);
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "the adjusted tax difference attributable to the interest taken into account with respect to the transaction involving the second or any succeeding portion shall be reduced by the amount of the tax imposed by this subsection with respect to all prior transactions involving portions of such interest")
pub relation portion_additional_tax_2032ac2d(e: Estate, prop: Asset, n: Integer, amount: Money) kind institutional {
    label en official "the additional tax on the n-th portion: the lesser of the adjusted tax difference (less the tax on prior portions) and the excess of the amount realized over the portion's pro rata section 2032A(a) value (section 2032A(c)(2)(A), (D))";
}
rule PortionAdditionalTaxFirstRule(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, share: Decimal, realized: Money, diff: Money, pv: Money) defeasible {
    label en official "the first portion: no reduction for prior portions (section 2032A(c)(2)(D))";
    when portion_disposed_2032a(e, prop, heir, n, on, share, realized);
    when recapture_event_within_window(e, prop, heir, on);
    when adjusted_tax_difference_attributable_to_interest(e, prop, diff);
    when portion_use_value_2032ac2di(e, prop, n, pv);
    when not_known(has_prior_portion_taxes_2032ac2d(e, prop, n));
    then portion_additional_tax_2032ac2d(e, prop, n, min(diff, max(0.00 USD, realized - pv)));
}
rule PortionAdditionalTaxLaterRule(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, share: Decimal, realized: Money, diff: Money, pv: Money, prior: Money) defeasible {
    label en official "the second or a succeeding portion: the adjusted tax difference is reduced by the tax on all prior portions (section 2032A(c)(2)(D)(ii))";
    when portion_disposed_2032a(e, prop, heir, n, on, share, realized);
    when recapture_event_within_window(e, prop, heir, on);
    when adjusted_tax_difference_attributable_to_interest(e, prop, diff);
    when portion_use_value_2032ac2di(e, prop, n, pv);
    when prior_portion_taxes_2032ac2d(e, prop, n, prior);
    then portion_additional_tax_2032ac2d(e, prop, n, min(max(0.00 USD, diff - prior), max(0.00 USD, realized - pv)));
}

// (E): timber on qualified woodland
pub relation timber_disposed_or_severed_2032ac2e(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, realized: Money) kind empirical {
    label en unofficial "the qualified heir disposes of (or severs) standing timber on the qualified woodland on the date, the amount realized (or, other than a sale or exchange at arm's length, the fair market value of the portion disposed or severed)";
}
pub relation right_to_sever_disposed_2032ac2e(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, realized: Money) kind empirical {
    label en unofficial "the qualified heir disposes of a right to sever standing timber";
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "the disposition of a right to sever shall be treated as the disposition of the standing timber")
pub relation timber_disposition_2032ac2e(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, realized: Money) kind institutional {
    label en official "a disposition or severance of standing timber, or the disposition of a right to sever it, on woodland under the (e)(13)(A) election is the disposition of a portion of the interest (section 2032A(c)(2)(E)(i))";
}
rule TimberDispositionRule(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, realized: Money) defeasible {
    when woodland_election_effective(e, prop);
    when timber_disposed_or_severed_2032ac2e(e, prop, heir, n, on, realized);
    then timber_disposition_2032ac2e(e, prop, heir, n, on, realized);
}
rule RightToSeverDispositionRule(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, realized: Money) defeasible {
    when woodland_election_effective(e, prop);
    when right_to_sever_disposed_2032ac2e(e, prop, heir, n, on, realized);
    then timber_disposition_2032ac2e(e, prop, heir, n, on, realized);
}
pub relation additional_tax_if_entire_interest_disposed_2032ac2e(e: Estate, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the additional tax determined under paragraph (2) without regard to subparagraph (E) if the entire interest of the qualified heir in the woodland had been disposed of (section 2032A(c)(2)(E)(ii)(II))";
}
pub relation prior_timber_taxes_2032ac2e(e: Estate, prop: Asset, n: Integer, total: Money) kind empirical {
    label en unofficial "the additional tax imposed with respect to all prior transactions involving the woodland to which subparagraph (E) applied";
}
relation has_prior_timber_taxes_2032ac2e(e: Estate, prop: Asset, n: Integer) kind institutional;
rule HasPriorTimberTaxesRule(e: Estate, prop: Asset, n: Integer, total: Money) defeasible {
    when prior_timber_taxes_2032ac2e(e, prop, n, total);
    then has_prior_timber_taxes_2032ac2e(e, prop, n);
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "the amount of the additional tax imposed by paragraph (1) with respect to such disposition shall be an amount equal to the lesser of")
pub relation timber_additional_tax_2032ac2e(e: Estate, prop: Asset, n: Integer, amount: Money) kind institutional {
    label en official "the additional tax on the timber disposition: the lesser of the amount realized and the tax on the entire interest less the tax on the prior timber transactions (section 2032A(c)(2)(E)(ii))";
}
rule TimberAdditionalTaxFirstRule(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, realized: Money, entire: Money) defeasible {
    when timber_disposition_2032ac2e(e, prop, heir, n, on, realized);
    when additional_tax_if_entire_interest_disposed_2032ac2e(e, prop, entire);
    when not_known(has_prior_timber_taxes_2032ac2e(e, prop, n));
    then timber_additional_tax_2032ac2e(e, prop, n, min(realized, entire));
}
rule TimberAdditionalTaxLaterRule(e: Estate, prop: Asset, heir: Individual, n: Integer, on: Date, realized: Money, entire: Money, prior: Money) defeasible {
    when timber_disposition_2032ac2e(e, prop, heir, n, on, realized);
    when additional_tax_if_entire_interest_disposed_2032ac2e(e, prop, entire);
    when prior_timber_taxes_2032ac2e(e, prop, n, prior);
    then timber_additional_tax_2032ac2e(e, prop, n, min(realized, max(0.00 USD, entire - prior)));
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "The amount of additional tax imposed under paragraph (1) in any case in which a qualified heir disposes of his entire interest in the qualified woodland shall be reduced by any amount determined under this subparagraph with respect to such woodland.")
pub relation entire_interest_tax_after_timber_2032ac2e(e: Estate, prop: Asset, amount: Money) kind institutional {
    label en official "the tax on the disposition of the entire woodland interest, reduced by the amounts determined under subparagraph (E) (section 2032A(c)(2)(E), last sentence)";
}
rule EntireInterestTaxAfterTimberRule(e: Estate, prop: Asset, entire: Money) defeasible {
    when additional_tax_if_entire_interest_disposed_2032ac2e(e, prop, entire);
    when timber_additional_tax_2032ac2e(e, prop, _, _);
    then entire_interest_tax_after_timber_2032ac2e(e, prop, max(0.00 USD, entire - sum(collect all a: Money, k: Integer where timber_additional_tax_2032ac2e(e, prop, k, a), empty: 0.00 USD)));
}
