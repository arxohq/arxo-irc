// 26 U.S.C. §§2102(b)(2)-(5), 2105(d), 2107, 2108 (nonresidents, expatriates,
// reciprocity), §§2208-2209 (possessions), §2201 (wiring of the reduced rate
// schedule), §2204(b)-(c), §2205, §2207A(b), (d), §2207B(c) and the
// deontic layer of the recovery rights of §§2207A(a), 2207B(a). Stage 2
// (DECISION-0379 with deontics) of `us.irc.estate_gift` (B01/IRC-11).
//
// SHAPE. The President's proclamation of §2108 is a POWER whose validity is
// the three findings and the 30-day notice to Congress; the revocation is a
// second power under the same notice rule; the executor's application of
// §2204(b) yields a Secretary DUTY to notify and a fiduciary POWER to be
// discharged; the recovery rights are DUTIES of the recipient in favour of
// the estate (or of the person taxed).
//
// JUDGMENT CALLS
//  - §2107(c)(1) and (c)(3): the $13,000 credit of (c)(1) is the same credit as the
//    one that §2102(b) allows through (c)(3), not a second one: (c)(3) says the
//    sections 2012 and 2013 are applied "as if the credit allowed under paragraph
//    (1) were allowed under section 2010", which identifies it as the unified credit.
//    INTERPRETATION row; the module modifies nothing for it.
//  - §2107(c)(2)(B)(ii)(II), the tax "which would be imposed by section 2101 but for
//    this section", is a counterfactual asserted by the case (TECH-GAPS G368 class).
//  - §2108's effect (the pre-1967 text of sections 2101, 2102, 2106 and 6018) is
//    not pinned: the proclamation produces a relation, the pre-1967 tax is a
//    SOURCE_GAP row.
//  - `President` is declared here, as core declares the other organs; it should be
//    hoisted to `us.irc.core` (a pub at the owner, brief).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2102_B,
    IRC_S2105_D,
    IRC_S2107_A,
    IRC_S2107_B,
    IRC_S2107_C,
    IRC_S2107_D,
    IRC_S2108_A,
    IRC_S2108_B,
    IRC_S2204_B,
    IRC_S2205,
    IRC_S2207A_B,
    IRC_S2208,
    IRC_S2209,
    Individual,
    NonresidentUnifiedCreditAmount,
    Organ,
    Person,
    QualifiedDecedentReason2201,
    Secretary,
    TaxableYear,
    bracket_2201c,
    combat_zone_tentative_tax,
    date_of_death,
    decedent_citizen_or_resident,
    executor_of,
    foreign_corporation_us_asset_value,
    gift_tentative_tax_at_death_rates,
    has_elected_section_2201_not_to_apply,
    nonresident_estate_tax,
    nonresident_estate_tax_imposed,
    nonresident_not_citizen,
    post_1976_taxable_gifts_of_decedent,
    qualified_decedent_2201,
    qualifying_income_interest_disposition,
    section_2107_applies,
    section_2207a_estate_tax_recovery_amount,
    section_2207b_recovery_amount,
    tentative_tax,
    tentative_tax_on_amount,
    us_situs_gross_estate,
};

const DistrictCourt: Organ = us.irc.core::DistrictCourt;
pub const President: Organ = entity_ref("urn:us:irc:estate_gift:clir#president") {
    label en unofficial "the President of the United States";
}

// =====================================================================
// §§2208, 2209: residents of possessions
// =====================================================================

pub relation decedent_us_citizen_resident_of_possession(e: Estate) kind empirical {
    label en unofficial "the decedent was a citizen of the United States and a resident of a possession thereof at the time of death";
}
pub relation decedent_citizenship_acquired_solely_by_possession_status(e: Estate) kind empirical {
    label en unofficial "the decedent acquired United States citizenship solely by reason of (1) being a citizen of the possession, or (2) birth or residence within the possession";
}
@source(IRC_S2208, relation = formalizes, coverage = exact, quote = "shall, for purposes of the tax imposed by this chapter, be considered a \"citizen\" of the United States within the meaning of that term wherever used in this title unless he acquired his United States citizenship solely by reason of")
pub relation possession_decedent_treated_as_citizen_2208(e: Estate) kind institutional {
    label en official "a citizen resident in a possession is a citizen for the estate tax unless citizenship was acquired solely through the possession (section 2208)";
}
rule PossessionDecedentTreatedAsCitizenRule(e: Estate) defeasible {
    when decedent_us_citizen_resident_of_possession(e);
    when not_known(decedent_citizenship_acquired_solely_by_possession_status(e));
    then possession_decedent_treated_as_citizen_2208(e);
}
rule DecedentCitizenByPossessionRule(e: Estate) defeasible {
    when possession_decedent_treated_as_citizen_2208(e);
    then decedent_citizen_or_resident(e);
}
@source(IRC_S2209, relation = formalizes, coverage = exact, quote = "but only if such person acquired his United States citizenship solely by reason of")
pub relation possession_decedent_treated_as_nonresident_2209(e: Estate) kind institutional {
    label en official "a citizen resident in a possession is a nonresident not a citizen only if citizenship was acquired solely through the possession (section 2209)";
}
rule PossessionDecedentTreatedAsNonresidentRule(e: Estate) defeasible {
    when decedent_us_citizen_resident_of_possession(e);
    when decedent_citizenship_acquired_solely_by_possession_status(e);
    then possession_decedent_treated_as_nonresident_2209(e);
}
rule NonresidentNotCitizenByPossessionRule(e: Estate) defeasible {
    when possession_decedent_treated_as_nonresident_2209(e);
    then nonresident_not_citizen(e);
}

// =====================================================================
// §2102(b)(2)-(5): the unified credit of the nonresident estate
// =====================================================================

pub relation worldwide_gross_estate_value(e: Estate, amount: Money) kind empirical {
    label en unofficial "the value of the decedent's entire gross estate wherever situated";
}
pub relation treaty_requires_proportional_credit(e: Estate) kind empirical {
    label en unofficial "a treaty obligation of the United States requires the proportional credit of section 2102(b)(3)(A)";
}
pub relation treaty_exempt_property_value(e: Estate, amount: Money) kind empirical {
    label en unofficial "the value of property exempt from the tax of this subchapter under a treaty obligation, not treated as situated in the United States (section 2102(b)(3)(A), last sentence)";
}
pub relation gift_tax_credit_allowed_on_decedents_gifts(e: Estate, amount: Money) kind empirical {
    label en unofficial "the credit allowed under section 2505 with respect to gifts made by the decedent (section 2102(b)(3)(B))";
}
pub relation nonresident_credit_before_gift_credit_reduction(e: Estate, amount: Money) kind institutional {
    label en official "the dollar amount of the credit before the section 2505 reduction: $13,000; for a section 2209 possession decedent the greater of $13,000 and $46,800 times the US share of the gross estate; where a treaty requires it, the applicable credit amount of section 2010(c) times the US share (section 2102(b)(1)-(3)(A))";
}
relation us_share_of_gross_estate_numerator(e: Estate, amount: Money) kind institutional;
rule UsShareNumeratorRule(e: Estate, us_gross: Money) defeasible {
    when us_situs_gross_estate(e, us_gross);
    then us_share_of_gross_estate_numerator(e, us_gross);
}
rule NonresidentCreditDefaultRule(e: Estate) defeasible {
    label en official "the unified credit of the nonresident estate is $13,000 (section 2102(b)(1))";
    when nonresident_not_citizen(e);
    when not_known(possession_decedent_treated_as_nonresident_2209(e));
    when not_known(treaty_requires_proportional_credit(e));
    then nonresident_credit_before_gift_credit_reduction(e, NonresidentUnifiedCreditAmount);
}
rule NonresidentCreditPossessionRule(e: Estate, us_gross: Money, world: Money) defeasible {
    label en official "for a decedent treated as a nonresident not a citizen under section 2209 the credit is the greater of $13,000 and the proportion of $46,800 (section 2102(b)(2))";
    when possession_decedent_treated_as_nonresident_2209(e);
    when not_known(treaty_requires_proportional_credit(e));
    when us_situs_gross_estate(e, us_gross);
    when worldwide_gross_estate_value(e, world) and world > 0.00 USD;
    then nonresident_credit_before_gift_credit_reduction(e, max(NonresidentUnifiedCreditAmount, div_round(46800.00 USD * (us_gross / 1.00 USD), world / 1.00 USD, 2, "HALF_UP")));
}
rule NonresidentCreditTreatyRule(e: Estate, us_gross: Money, exempt: Money, world: Money, base: Money, tax: Money) defeasible {
    label en official "to the extent required by treaty the credit is the applicable credit amount of section 2010(c) times the share of the gross estate situated in the United States (section 2102(b)(3)(A))";
    when treaty_requires_proportional_credit(e);
    when us_situs_gross_estate(e, us_gross);
    when treaty_exempt_property_value(e, exempt);
    when worldwide_gross_estate_value(e, world) and world > 0.00 USD;
    when nonresident_basic_exclusion_tax(e, tax);
    then nonresident_credit_before_gift_credit_reduction(e, div_round(tax * (max(0.00 USD, us_gross - exempt) / 1.00 USD), world / 1.00 USD, 2, "HALF_UP"));
}
relation nonresident_basic_exclusion_tax(e: Estate, amount: Money) kind institutional;
rule NonresidentBasicExclusionTaxRule(e: Estate, tax: Money) defeasible {
    when nonresident_not_citizen(e);
    when tentative_tax_on_amount(BasicExclusionAmount + 0.00 USD, tax);
    then nonresident_basic_exclusion_tax(e, tax);
}
@source(IRC_S2102_B, relation = formalizes, coverage = exact, quote = "each dollar amount contained in paragraph (1) or (2) or subparagraph (A) of this paragraph (whichever applies) shall be reduced by the amount so allowed")
pub relation nonresident_credit_after_gift_credit_reduction(e: Estate, amount: Money) kind institutional {
    label en official "the credit reduced by the section 2505 credit allowed for the decedent's gifts (section 2102(b)(3)(B))";
}
rule NonresidentCreditAfterGiftCreditReductionRule(e: Estate, base: Money) defeasible {
    when nonresident_credit_before_gift_credit_reduction(e, base);
    then nonresident_credit_after_gift_credit_reduction(e, max(0.00 USD, base - sum(collect all g: Money where gift_tax_credit_allowed_on_decedents_gifts(e, g), empty: 0.00 USD)));
}

// =====================================================================
// §2105(d): stock in a regulated investment company (decedents dying before 2012)
// =====================================================================

pub relation ric_stock_owned_by_nonresident(e: Estate, item: Asset, value: Money) kind empirical {
    label en unofficial "stock in a regulated investment company (section 851) owned by the nonresident not a citizen, of the stated value";
}
pub relation ric_qualifying_assets_at_prior_quarter_end(e: Estate, item: Asset, qualifying: Money, total: Money) kind empirical {
    label en unofficial "at the end of the quarter of the company's taxable year immediately preceding the date of death (or another time the Secretary designates), the assets that were qualifying assets with respect to the decedent, and the total assets: assets that, if owned directly by the decedent, would be section 2105(b) amounts or deposits, debt obligations of the last sentence of section 2104(c), or other property not within the United States";
}
@source(IRC_S2105_D, relation = formalizes, coverage = exact, quote = "shall not be deemed property within the United States in the proportion that, at the end of the quarter of such investment company's taxable year immediately preceding a decedent's date of death")
pub relation ric_stock_value_not_in_united_states_2105d(e: Estate, item: Asset, amount: Money) kind institutional {
    label en official "the part of the value of RIC stock that is not property within the United States: the qualifying-asset share of the stock's value; the subsection does not apply to estates of decedents dying after December 31, 2011 (section 2105(d)(3))";
}
rule RicStockValueNotInUnitedStatesRule(e: Estate, item: Asset, value: Money, qualifying: Money, total: Money, dod: Date) defeasible {
    when ric_stock_owned_by_nonresident(e, item, value);
    when ric_qualifying_assets_at_prior_quarter_end(e, item, qualifying, total) and total > 0.00 USD;
    when date_of_death(e, dod) and dod <= @2011-12-31;
    then ric_stock_value_not_in_united_states_2105d(e, item, div_round(value * (qualifying / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// =====================================================================
// §2107: expatriates
// =====================================================================

pub relation decedent_subject_to_877b_in_year_of_death(e: Estate) kind empirical {
    label en unofficial "the date of death occurs during a taxable year with respect to which the decedent is subject to tax under section 877(b); section 877 is owned by us.irc.international";
}
@source(IRC_S2107_A, relation = formalizes, coverage = exact, quote = "if the date of death occurs during a taxable year with respect to which the decedent is subject to tax under section 877(b)")
rule Section2107AppliesRule(e: Estate) defeasible {
    label en official "section 2107 applies to a nonresident not a citizen who dies in a year for which he is subject to tax under section 877(b)";
    when nonresident_not_citizen(e);
    when decedent_subject_to_877b_in_year_of_death(e);
    then section_2107_applies(e);
}
rule NonresidentEstateTaxImposedExpatriateRule(e: Estate) defeasible {
    label en official "a tax computed in accordance with the table of section 2001 is imposed on the taxable estate, determined under section 2106, of an expatriate (section 2107(a))";
    when section_2107_applies(e);
    then nonresident_estate_tax_imposed(e);
}
pub relation decedent_share_of_foreign_corporation_voting_power(e: Estate, corp: Person, share: Decimal) kind empirical {
    label en unofficial "the share of the total combined voting power of all classes of voting stock that the decedent owned within the meaning of section 958(a) at death (section 2107(b)(1))";
}
pub relation decedent_share_of_foreign_corporation_votes_or_value_958b(e: Estate, corp: Person, share: Decimal) kind empirical {
    label en unofficial "the greater of the share of voting power and the share of value that the decedent owned within the meaning of section 958(a) or is considered to have owned under section 958(b) at death (section 2107(b)(2)); attribution asserted, TECH-GAPS G3609";
}
pub relation decedent_foreign_stock_fair_market_value(e: Estate, corp: Person, value: Money) kind empirical {
    label en unofficial "the fair market value of the stock of the foreign corporation owned within the meaning of section 958(a) by the decedent at death";
}
pub relation section_2107b_stock_included_value(e: Estate, corp: Person, amount: Money) kind institutional {
    label en official "the proportion of the value of the foreign corporation's stock, the US-situated assets over all assets, included in the gross estate of an expatriate who owned at least 10 percent of the voting power and more than 50 percent of voting power or value (section 2107(b))";
}
@source(IRC_S2107_B, relation = formalizes, coverage = exact, quote = "then that proportion of the fair market value of the stock of such foreign corporation owned (within the meaning of section 958(a)) by such decedent at the time of his death, which the fair market value of any assets owned by such foreign corporation and situated in the United States, at the time of his death, bears to the total fair market value of all assets owned by such foreign corporation at the time of his death, shall be included in the gross estate of such decedent")
rule Section2107bStockIncludedValueRule(e: Estate, corp: Person, direct: Decimal, total: Decimal, stock: Money, us_assets: Money, all_assets: Money) defeasible {
    when section_2107_applies(e);
    when decedent_share_of_foreign_corporation_voting_power(e, corp, direct) and direct >= 0.10;
    when decedent_share_of_foreign_corporation_votes_or_value_958b(e, corp, total) and total > 0.50;
    when decedent_foreign_stock_fair_market_value(e, corp, stock);
    when foreign_corporation_us_asset_value(corp, us_assets, all_assets) and all_assets > 0.00 USD;
    then section_2107b_stock_included_value(e, corp, div_round(stock * (us_assets / 1.00 USD), all_assets / 1.00 USD, 2, "HALF_UP"));
}
// (c): credits
pub relation foreign_death_tax_paid_on_2107b_stock(e: Estate, country: Text, amount: Money) kind empirical {
    label en unofficial "estate, inheritance, legacy or succession taxes actually paid to the foreign country in respect of property included in the gross estate solely by reason of subsection (b) (section 2107(c)(2)(A))";
}
pub relation value_of_2107b_property_subjected_by_country(e: Estate, country: Text, value: Money) kind empirical {
    label en unofficial "the value of the property subjected to such taxes by the foreign country and included in the gross estate solely by reason of subsection (b)";
}
pub relation value_of_all_property_subjected_by_country(e: Estate, country: Text, value: Money) kind empirical {
    label en unofficial "the value of all property subjected to such taxes by the foreign country";
}
pub relation value_of_all_property_included_solely_by_2107b(e: Estate, value: Money) kind empirical {
    label en unofficial "the total value of all property included in the gross estate solely by reason of subsection (b) (section 2107(c)(2)(C))";
}
pub relation tax_that_2101_would_impose_but_for_2107(e: Estate, amount: Money) kind empirical {
    label en unofficial "the tax which would be imposed by section 2101 but for section 2107 (section 2107(c)(2)(B)(ii)(II)); a counterfactual asserted by the case, TECH-GAPS G368 class";
}
pub relation section_2107_tax(e: Estate, amount: Money) kind institutional {
    label en unofficial "the tax imposed by section 2107(a), before the (c)(2) foreign credit: the section 2101 computation on the section 2106 taxable estate, less the unified credit of section 2102(b) (the credit of section 2107(c)(1), see the module header)";
}
rule Section2107TaxRule(e: Estate, tax: Money) defeasible {
    when section_2107_applies(e);
    when nonresident_estate_tax(e, tax);
    then section_2107_tax(e, tax);
}
relation foreign_credit_ratio_limit_2107c2bi(e: Estate, country: Text, amount: Money) kind institutional;
rule ForeignCreditRatioLimitRule(e: Estate, country: Text, paid: Money, included: Money, all: Money) defeasible {
    when foreign_death_tax_paid_on_2107b_stock(e, country, paid);
    when value_of_2107b_property_subjected_by_country(e, country, included);
    when value_of_all_property_subjected_by_country(e, country, all) and all > 0.00 USD;
    then foreign_credit_ratio_limit_2107c2bi(e, country, div_round(paid * (included / 1.00 USD), all / 1.00 USD, 2, "HALF_UP"));
}
relation foreign_credit_share_limit_2107c2bii(e: Estate, country: Text, amount: Money) kind institutional;
rule ForeignCreditShareLimitRule(e: Estate, country: Text, included: Money, total_solely: Money, t2107: Money, t2101: Money) defeasible {
    when value_of_2107b_property_subjected_by_country(e, country, included);
    when value_of_all_property_included_solely_by_2107b(e, total_solely) and total_solely > 0.00 USD;
    when section_2107_tax(e, t2107);
    when tax_that_2101_would_impose_but_for_2107(e, t2101);
    then foreign_credit_share_limit_2107c2bii(e, country, div_round(max(0.00 USD, t2107 - t2101) * (included / 1.00 USD), total_solely / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S2107_C, relation = formalizes, coverage = exact, quote = "The credit allowed by subparagraph (A) for such taxes paid to a foreign country shall not exceed the lesser of")
pub relation foreign_death_tax_credit_2107c2(e: Estate, country: Text, amount: Money) kind institutional {
    label en official "the credit for foreign death taxes on property included solely by subsection (b): the lesser of the ratio limit and the property's proportionate share of the excess of the section 2107 tax over the section 2101 tax (section 2107(c)(2))";
}
rule ForeignDeathTaxCredit2107c2Rule(e: Estate, country: Text, ratio_limit: Money, share_limit: Money) defeasible {
    when foreign_credit_ratio_limit_2107c2bi(e, country, ratio_limit);
    when foreign_credit_share_limit_2107c2bii(e, country, share_limit);
    then foreign_death_tax_credit_2107c2(e, country, min(ratio_limit, share_limit));
}
// (d): the burden of proof on loss of citizenship
pub relation secretary_establishes_expatriation_reduces_taxes(e: Estate) kind empirical {
    label en unofficial "the Secretary establishes that it is reasonable to believe that the individual's loss of United States citizenship would, but for section 2107, result in a substantial reduction in the estate, inheritance, legacy and succession taxes on the transfer of his estate (section 2107(d))";
}
pub relation executor_proves_loss_of_citizenship_had_no_tax_purpose(e: Estate) kind empirical {
    label en unofficial "the executor proves that the loss of citizenship did not have for one of its principal purposes the avoidance of taxes under this subtitle or subtitle A";
}
@source(IRC_S2107_D, relation = formalizes, coverage = exact, quote = "the burden of proving that such loss of citizenship did not have for one of its principal purposes the avoidance of taxes under this subtitle or subtitle A shall be on the executor of such individual's estate")
pub relation expatriation_tax_avoidance_purpose_presumed_2107d(e: Estate) kind institutional {
    label en official "once the Secretary establishes the reasonable belief, the executor bears the burden of proving no principal tax-avoidance purpose, and absent that proof the purpose is presumed (section 2107(d))";
}
rule ExpatriationTaxAvoidancePurposePresumedRule(e: Estate) defeasible {
    when secretary_establishes_expatriation_reduces_taxes(e);
    then expatriation_tax_avoidance_purpose_presumed_2107d(e);
    unless executor_proves_loss_of_citizenship_had_no_tax_purpose(e);
}

// =====================================================================
// §2108: the President's proclamation
// =====================================================================

pub external judgment relation president_finds_more_burdensome_foreign_estate_tax_2108a1(country: Text) {
    authority President;
    label en official "under the laws of the foreign country, considering its tax system, a more burdensome tax is imposed on the transfer of estates of decedents who were citizens of the United States and not residents of it than this subchapter imposes on residents of that country (section 2108(a)(1))";
}
pub relation foreign_country_did_not_revise_on_request(country: Text) kind empirical {
    label en unofficial "the foreign country, when requested by the United States to do so, has not acted to revise or reduce its tax so that it is no more burdensome (section 2108(a)(2))";
}
pub external judgment relation president_finds_public_interest_2108a3(country: Text) {
    authority President;
    label en official "it is in the public interest to apply pre-1967 tax provisions to the transfer of estates of decedents who were residents of the foreign country (section 2108(a)(3))";
}
pub relation congress_notified_on(country: Text, d: Date) kind empirical {
    label en unofficial "the President notified the Senate and the House of Representatives of his intention to issue the proclamation (section 2108(c))";
}
pub relation proclamation_issued_on(country: Text, d: Date) kind empirical {
    label en unofficial "the President issues the proclamation on the stated date";
}
relation congress_notice_30_days_before_proclamation(country: Text) kind institutional;
rule CongressNotice30DaysBeforeProclamationRule(country: Text, notified: Date, issued: Date, calendar_before_1: Date) defeasible {
    label en official "no proclamation unless at least 30 days before it the President has notified the Senate and the House (section 2108(c))";
    when congress_notified_on(country, notified);
    when proclamation_issued_on(country, issued) and notified <= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(issued, 30, us.irc.core::CalendarDay, calendar_before_1);
    then congress_notice_30_days_before_proclamation(country);
}
relation proclamation_conditions_2108a(country: Text) kind institutional;
rule ProclamationConditions2108aRule(country: Text) defeasible {
    when president_finds_more_burdensome_foreign_estate_tax_2108a1(country);
    when foreign_country_did_not_revise_on_request(country);
    when president_finds_public_interest_2108a3(country);
    when congress_notice_30_days_before_proclamation(country);
    then proclamation_conditions_2108a(country);
}
pub relation president_proclaims_pre_1967_provisions(country: Text, w: Interval<Instant>) kind empirical {
    label en unofficial "the President proclaims that the tax on the transfer of the estate of every decedent who was a resident of the foreign country shall, for decedents dying after the proclamation, be determined without regard to the amendments of November 13, 1966 to sections 2101, 2102, 2106 and 6018";
}
pub relation pre_1967_provisions_apply_to_residents_of(country: Text) kind institutional {
    label en official "for decedents resident in the foreign country and dying after the proclamation the tax is determined without regard to the amendments made on or after November 13, 1966 to sections 2101, 2102, 2106 and 6018 (section 2108(a)); the pre-1967 text is not pinned, SOURCE_GAP";
}
@source(IRC_S2108_A, relation = formalizes, coverage = exact, quote = "the President shall proclaim that the tax on the transfer of the estate of every decedent who was a resident of such foreign country at the time of his death shall, in the case of decedents dying after the date of such proclamation, be determined under this subchapter without regard to amendments")
rule PresidentProclaimsPre1967ProvisionsPower(country: Text, w: Interval<Instant>) strict {
    label en official "the President, on three findings and a 30-day notice to Congress, proclaims that pre-1967 provisions apply to residents of the foreign country (section 2108(a), (c))";
    when president_proclaims_pre_1967_provisions(country, w);
    then power PresidentProclamation2108a {
        holder President;
        over country;
        exercise president_proclaims_pre_1967_provisions(country, w);
        valid_when proclamation_conditions_2108a(country);
        effect create(pre_1967_provisions_apply_to_residents_of(country));
        window w;
    };
}
pub external judgment relation president_finds_foreign_laws_modified_2108b(country: Text) {
    authority President;
    label en official "the laws of the foreign country have been modified so that the tax on estates of United States citizens not residents of it is no longer more burdensome than the tax on its residents (section 2108(b))";
}
relation revocation_conditions_2108b(country: Text) kind institutional;
rule RevocationConditions2108bRule(country: Text) defeasible {
    when president_finds_foreign_laws_modified_2108b(country);
    when congress_notice_30_days_before_proclamation(country);
    then revocation_conditions_2108b(country);
}
pub relation president_revokes_proclamation(country: Text, w: Interval<Instant>) kind empirical {
    label en unofficial "the President proclaims that the tax on the transfer of estates of residents of the foreign country is no longer determined under the pre-1967 provisions";
}
pub relation proclamation_2108_revoked(country: Text) kind institutional {
    label en official "the earlier proclamation is revoked for decedents dying after the revocation (section 2108(b))";
}
@source(IRC_S2108_B, relation = formalizes, coverage = exact, quote = "Whenever the President finds that the laws of any foreign country with respect to which the President has made a proclamation under subsection (a) have been modified")
rule PresidentRevokesProclamationPower(country: Text, w: Interval<Instant>) strict {
    label en official "on a finding that the foreign laws have been modified, and after the 30-day notice, the President proclaims the revocation (section 2108(b), (c))";
    when president_revokes_proclamation(country, w);
    then power PresidentRevocation2108b {
        holder President;
        over country;
        exercise president_revokes_proclamation(country, w);
        valid_when revocation_conditions_2108b(country);
        effect create(proclamation_2108_revoked(country));
        window w;
    };
}

// =====================================================================
// §2201: the reduced rate schedule enters the estate tax chain
// =====================================================================

relation section_2201_reduced_schedule_applies(e: Estate) kind institutional;
rule Section2201ReducedScheduleAppliesRule(e: Estate) defeasible {
    label en official "the section 2201(c) schedule is deemed the section 2001(c) schedule for a qualified decedent unless the executor elects otherwise (section 2201(a))";
    when qualified_decedent_2201(e, _);
    when not_known(has_elected_section_2201_not_to_apply(e));
    then section_2201_reduced_schedule_applies(e);
}
rule TentativeTaxCombatZoneRule(e: Estate, amount: Money) defeasible {
    label en official "the tentative tax on the sum of the taxable estate and the adjusted taxable gifts is computed under the section 2201(c) schedule (section 2201(a), 2001(b)(1))";
    when section_2201_reduced_schedule_applies(e);
    when combat_zone_tentative_tax(e, amount);
    then tentative_tax(e, amount);
}
rule GiftTentativeTaxAtDeathRatesCombatZoneRule(e: Estate, base: Money, lower: Money, base_tax: Money, rate: Decimal) defeasible {
    label en official "the reduced schedule is also the schedule at death for the tentative tax on post-1976 gifts (sections 2201(a), 2001(g)(1)); it is not used for the section 2010 credit (section 2201(d))";
    when section_2201_reduced_schedule_applies(e);
    when post_1976_taxable_gifts_of_decedent(e, base);
    when bracket_2201c(base, lower, base_tax, rate);
    then gift_tentative_tax_at_death_rates(e, base_tax + rate * (base - lower));
}

// =====================================================================
// §2204(b), (c): the fiduciary other than the executor
// =====================================================================

pub relation fiduciary_application_for_discharge(e: Estate, f: Person, on: Date) kind empirical {
    label en unofficial "a fiduciary other than the executor, not a fiduciary of the estate of a nonresident decedent, makes written application to the Secretary for determination of the estate tax for which the fiduciary may be personally liable and for discharge (section 2204(b))";
}
pub relation fiduciary_of_nonresident_decedent(e: Estate, f: Person) kind empirical {
    label en unofficial "the fiduciary acts in respect of the estate of a nonresident decedent";
}
pub relation executor_discharged_on(e: Estate, x: Person, d: Date) kind empirical {
    label en unofficial "the executor is discharged from personal liability under subsection (a) on the stated date";
}
pub relation secretary_notified_fiduciary(e: Estate, f: Person) kind empirical {
    label en unofficial "the Secretary notified the fiduciary of the amount of tax for which the fiduciary is liable, or that the fiduciary is not liable";
}
relation fiduciary_notice_candidate(e: Estate, f: Person, d: Date) kind institutional;
rule FiduciaryNoticeCandidateAfterExecutorDischargeRule(e: Estate, f: Person, discharged: Date, x: Person) defeasible {
    when fiduciary_application_for_discharge(e, f, _);
    when not_known(fiduciary_of_nonresident_decedent(e, f));
    when executor_discharged_on(e, x, discharged);
    then fiduciary_notice_candidate(e, f, discharged);
}
rule FiduciaryNoticeCandidateAfterSixMonthsRule(e: Estate, f: Person, applied: Date) defeasible {
    when fiduciary_application_for_discharge(e, f, applied);
    when not_known(fiduciary_of_nonresident_decedent(e, f));
    then fiduciary_notice_candidate(e, f, add_calendar_period(applied, 6 calendar_month));
}
relation later_fiduciary_notice_candidate_exists(e: Estate, f: Person, d: Date) kind institutional;
rule LaterFiduciaryNoticeCandidateExistsRule(e: Estate, f: Person, d: Date, d2: Date) defeasible {
    when fiduciary_notice_candidate(e, f, d);
    when fiduciary_notice_candidate(e, f, d2) and d2 > d;
    then later_fiduciary_notice_candidate_exists(e, f, d);
}
pub relation fiduciary_notice_date_2204b(e: Estate, f: Person, d: Date) kind institutional {
    label en official "the Secretary notifies the fiduciary upon the executor's discharge under subsection (a), or upon the expiration of 6 months after the application, if later (section 2204(b))";
}
rule FiduciaryNoticeDate2204bRule(e: Estate, f: Person, d: Date) defeasible {
    when fiduciary_notice_candidate(e, f, d);
    unless later_fiduciary_notice_candidate_exists(e, f, d);
    then fiduciary_notice_date_2204b(e, f, d);
}
@source(IRC_S2204_B, relation = formalizes, coverage = exact, quote = "the Secretary upon the discharge of the executor from personal liability under subsection (a), or upon the expiration of 6 months after the making of such application by the fiduciary, if later, shall notify the fiduciary")
rule SecretaryNotifyFiduciaryDutyRule(e: Estate, f: Person, on: Date, due: Date) defeasible {
    label en official "the Secretary shall notify the fiduciary of the tax for which it is liable, or that it is not liable, at the later of the executor's discharge and 6 months after the application (section 2204(b))";
    when fiduciary_application_for_discharge(e, f, on);
    when fiduciary_notice_date_2204b(e, f, due);
    then duty SecretaryNotifyFiduciaryDuty {
        bearer Secretary;
        beneficiary f;
        achieve secretary_notified_fiduciary(e, f) during [on, due];
    };
}
pub relation fiduciary_paid_amount_determined_liable(e: Estate, f: Person) kind empirical {
    label en unofficial "the fiduciary paid the amount of tax for which it was determined liable, other than amounts whose time for payment is extended under section 6161, 6163 or 6166";
}
pub relation fiduciary_furnished_bond_or_equivalent(e: Estate, f: Person) kind empirical {
    label en unofficial "the fiduciary furnished any bond required for any amount for which the time for payment is extended";
}
pub relation special_lien_agreement_6324A_meets_requirements(e: Estate, f: Person) kind empirical {
    label en unofficial "an agreement meeting the requirements of section 6324A (special lien for estate tax deferred under section 6166) is furnished; section 6324A is owned by us.irc.collection";
}
pub relation fiduciary_notified_not_liable(e: Estate, f: Person) kind empirical {
    label en unofficial "the fiduciary received notification of a determination that it is not liable for any such tax";
}
pub relation bond_treated_as_furnished_2204c(e: Estate, f: Person) kind institutional {
    label en official "a section 6324A agreement is treated as the furnishing of bond for the amount whose payment is extended under section 6166 (section 2204(c))";
}
rule BondTreatedAsFurnishedByLienAgreementRule(e: Estate, f: Person) defeasible {
    when special_lien_agreement_6324A_meets_requirements(e, f);
    then bond_treated_as_furnished_2204c(e, f);
}
rule BondTreatedAsFurnishedByBondRule(e: Estate, f: Person) defeasible {
    when fiduciary_furnished_bond_or_equivalent(e, f);
    then bond_treated_as_furnished_2204c(e, f);
}
pub relation fiduciary_discharged_from_personal_liability(e: Estate, f: Person) kind institutional {
    label en official "the fiduciary is discharged from personal liability for any deficiency thereafter found due and is entitled to a receipt (section 2204(b))";
}
@source(IRC_S2204_B, relation = formalizes, coverage = exact, quote = "the fiduciary shall be discharged from personal liability for any deficiency in such tax thereafter found to be due and shall be entitled to a receipt or writing evidencing such discharge")
rule FiduciaryDischargeByPaymentPower(e: Estate, f: Person, on: Date) strict {
    label en official "the fiduciary who pays the tax determined, and furnishes any required bond, is discharged (section 2204(b))";
    when fiduciary_application_for_discharge(e, f, on);
    when fiduciary_paid_amount_determined_liable(e, f);
    then power FiduciaryDischargeByPayment {
        holder f;
        over e;
        exercise fiduciary_paid_amount_determined_liable(e, f);
        valid_when secretary_notified_fiduciary(e, f);
        effect create(fiduciary_discharged_from_personal_liability(e, f));
        window [on, infinity);
    };
}
rule FiduciaryDischargeByNotLiableNotificationRule(e: Estate, f: Person) defeasible {
    label en official "on receipt of notification that the fiduciary is not liable the fiduciary is discharged (section 2204(b))";
    when fiduciary_notified_not_liable(e, f);
    then fiduciary_discharged_from_personal_liability(e, f);
}

// =====================================================================
// §2205: reimbursement out of the estate
// =====================================================================

pub relation tax_paid_out_of_share_of_person_other_than_executor(e: Estate, p: Person, amount: Money) kind empirical {
    label en unofficial "the tax or a part of it, of the stated amount, is paid by, or collected out of, that part of the estate passing to or in the possession of a person other than the executor in his capacity as such";
}
pub relation undistributed_estate_available_for_reimbursement(e: Estate) kind empirical {
    label en unofficial "a part of the estate is still undistributed";
}
pub relation will_directs_otherwise_on_tax_burden(e: Estate) kind empirical {
    label en unofficial "the will of the decedent otherwise directs how the tax is to be borne (section 2205, last clause)";
}
pub relation reimbursement_from_undistributed_estate_made(e: Estate, p: Person) kind empirical {
    label en unofficial "the person has been reimbursed out of the undistributed part of the estate";
}
pub external judgment relation just_and_equitable_contribution_due(e: Estate, p: Person) {
    authority DistrictCourt;
    label en official "a just and equitable contribution by the persons whose interest in the estate would have been reduced if the tax had been paid before distribution, or whose interest is subject to equal or prior liability for taxes, debts or other charges (section 2205)";
}
pub relation reimbursement_entitlement_2205(e: Estate, p: Person, amount: Money) kind institutional {
    label en official "the person is entitled to reimbursement of the tax collected out of the person's share, out of the undistributed estate or by a just and equitable contribution, unless the will directs otherwise (section 2205)";
}
@source(IRC_S2205, relation = formalizes, coverage = exact, quote = "such person shall be entitled to reimbursement out of any part of the estate still undistributed or by a just and equitable contribution")
rule ReimbursementEntitlement2205Rule(e: Estate, p: Person, amount: Money) defeasible {
    when tax_paid_out_of_share_of_person_other_than_executor(e, p, amount);
    then reimbursement_entitlement_2205(e, p, amount);
    unless will_directs_otherwise_on_tax_burden(e) and tax_paid_out_of_share_of_person_other_than_executor(e, p, amount);
}
pub relation equitable_contribution_entitlement_2205(e: Estate, p: Person) kind institutional {
    label en official "the person is entitled to a just and equitable contribution from those whose interests would have been reduced, as the court determines (section 2205)";
}
rule EquitableContributionEntitlement2205Rule(e: Estate, p: Person, amount: Money) defeasible {
    when reimbursement_entitlement_2205(e, p, amount);
    when just_and_equitable_contribution_due(e, p);
    then equitable_contribution_entitlement_2205(e, p);
}
rule ExecutorReimbursementDutyRule(e: Estate, p: Person, amount: Money, x: Person, w: Interval<Instant>) defeasible {
    label en official "the executor shall reimburse the person out of the undistributed estate (section 2205); the equitable contribution among others is the court's (EVALUATIVE)";
    when reimbursement_entitlement_2205(e, p, amount);
    when undistributed_estate_available_for_reimbursement(e);
    when executor_of(e, x, w);
    then duty ExecutorReimbursementDuty {
        bearer x;
        beneficiary p;
        achieve reimbursement_from_undistributed_estate_made(e, p) during w;
    };
}

// =====================================================================
// §2207A(b), §2207A(a) and §2207B(a): the recovery rights as duties
// =====================================================================

pub relation gift_tax_total_for_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total tax for the calendar year under chapter 12 (section 2207A(b)(1))";
}
pub relation gift_tax_total_for_year_without_2519_property(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total tax which would have been payable under chapter 12 for the year if the value of the property treated as transferred under section 2519 had not been taken into account (section 2207A(b)(2)); a counterfactual asserted by the case";
}
pub relation property_transferred_under_2519_recipient(p: Individual, y: TaxableYear, item: Asset, recipient: Person) kind empirical {
    label en unofficial "the person receives property treated as transferred by p under section 2519";
}
@source(IRC_S2207A_B, relation = formalizes, coverage = exact, quote = "such person shall be entitled to recover from the person receiving the property the amount by which")
pub relation gift_tax_recovery_amount_2207Ab(p: Individual, y: TaxableYear, item: Asset, recipient: Person, amount: Money) kind institutional {
    label en official "the person taxed under chapter 12 on property treated as transferred under section 2519 recovers from the recipient the excess of the total tax for the year over the tax without the property (section 2207A(b))";
}
rule GiftTaxRecoveryAmount2207AbRule(p: Individual, y: TaxableYear, item: Asset, recipient: Person, with_property: Money, without_property: Money) defeasible {
    when property_transferred_under_2519_recipient(p, y, item, recipient);
    when gift_tax_total_for_year(p, y, with_property);
    when gift_tax_total_for_year_without_2519_property(p, y, without_property);
    then gift_tax_recovery_amount_2207Ab(p, y, item, recipient, max(0.00 USD, with_property - without_property));
}
pub relation section_2207a_recovery_paid(e: Estate, item: Asset, recipient: Person) kind empirical {
    label en unofficial "the recipient has paid the estate the amount recoverable under section 2207A(a)";
}
rule Section2207aRecoveryDutyRule(e: Estate, item: Asset, recipient: Person, amount: Money, dod: Date) defeasible {
    label en official "the recipient of section 2044 property owes the estate the amount recoverable (section 2207A(a)); the statute names no time, so the duty runs from the date of death without end";
    when section_2207a_estate_tax_recovery_amount(e, item, recipient, amount) and amount > 0.00 USD;
    when date_of_death(e, dod);
    then duty Section2207aRecoveryDuty {
        bearer recipient;
        beneficiary e;
        achieve section_2207a_recovery_paid(e, item, recipient) during [dod, infinity);
    };
}
pub relation section_2207b_recovery_paid(e: Estate, item: Asset, recipient: Person) kind empirical {
    label en unofficial "the recipient has paid the estate the amount recoverable under section 2207B(a)";
}
rule Section2207bRecoveryDutyRule(e: Estate, item: Asset, recipient: Person, amount: Money, dod: Date) defeasible {
    label en official "the recipient of section 2036 property owes the estate the amount recoverable (section 2207B(a))";
    when section_2207b_recovery_amount(e, item, recipient, amount) and amount > 0.00 USD;
    when date_of_death(e, dod);
    then duty Section2207bRecoveryDuty {
        bearer recipient;
        beneficiary e;
        achieve section_2207b_recovery_paid(e, item, recipient) during [dod, infinity);
    };
}
pub relation gift_tax_recovery_paid_2207Ab(p: Individual, y: TaxableYear, item: Asset, recipient: Person) kind empirical {
    label en unofficial "the recipient has paid the person the amount recoverable under section 2207A(b)";
}
rule GiftTaxRecoveryDuty2207AbRule(p: Individual, y: TaxableYear, item: Asset, recipient: Person, amount: Money, on: Date) defeasible {
    label en official "the recipient of property treated as transferred under section 2519 owes the taxed person the recoverable gift tax (section 2207A(b))";
    when gift_tax_recovery_amount_2207Ab(p, y, item, recipient, amount) and amount > 0.00 USD;
    when qualifying_income_interest_disposition(p, item, on, _);
    then duty GiftTaxRecoveryDuty2207Ab {
        bearer recipient;
        beneficiary p;
        achieve gift_tax_recovery_paid_2207Ab(p, y, item, recipient) during [on, infinity);
    };
}
