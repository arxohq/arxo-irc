// 26 U.S.C. §§2011-2016 — the remaining chapter 11 credits layered on top of
// the section 2010 unified credit (`estate_tax_after_unified_credit`,
// declared in 02-unified-credit.law). Produces the FINAL `estate_tax`
// (`pub relation`, declared once in 01-estate-imposition.law) by chaining:
// estate_tax_after_unified_credit -> - section 2012 gift-tax credit (pre-1977
// gifts) -> - section 2013 prior-transfer credit -> - section 2014 foreign
// death tax credit -> estate_tax. Stage-2 module of `us.irc.estate_gift`
// (B01/IRC-11); stage-1 modules 00-06 are unchanged except for the
// `estate_tax_after_unified_credit` rename documented in 02-unified-credit.law.
//
// PRIORITY FOR THIS PASS: §2013 (explicitly named by the stage-2 task) is
// modelled in full, (a)-(f). §2011 is REPEALED (no executable content).
// §2012 (pre-1977 gifts) and §2014(a)-(b)/(g) are modelled because they share
// §2013's ratio-credit shape almost exactly and the marginal cost was low;
// §2014(c)-(f), (h), §2015 and §2016 are NOT modelled this pass (see the
// TECH_GAP/NON_NORMATIVE notes at the end of this file and TECH-GAPS.md
// G367-G370) — budget, not a language limitation, except where noted.
//
// JUDGMENT CALLS (recorded once here, apply to every credit below):
//  - "Federal estate tax paid" / "estate tax paid" / "such tax actually paid"
//    by or with respect to the TRANSFEROR's estate is read as that estate's
//    OWN `estate_tax_after_unified_credit` (i.e. computed WITHOUT that
//    estate's own possible section 2012/2013/2014 credits), not the fully
//    layered `estate_tax`. Two reasons: (1) section 2013(c)(1)(A) itself asks
//    for the tax "computed without regard to this section" for the ANCHOR
//    estate, so symmetry for the transferor's own figure is defensible; (2)
//    reading the transferor's fully-layered `estate_tax` would make
//    `estate_tax` both a producer input and (transitively, through this very
//    module) a consumer of `prior_transfer_credit`'s own relation symbol —
//    the self-referential-guard trap this package's HANDOFF entry already
//    documents four other instances of (LDC-E4102, unstratifiable even
//    without a real data cycle). TECH-GAPS.md G367: the transferor's own
//    section 2012/2013 credits are consequently NOT compounded into the
//    figure used here — a documented simplification, not a silent drop.
//  - Every "years between two deaths" and "value of property transferred/
//    subjected to a foreign tax" figure is read as a CASE-ASSERTED empirical
//    fact (`transferor_predeceased_decedent_by_years`,
//    `prior_transfer_property_value`, `foreign_death_tax_property_value`,
//    …), not derived from raw dates or from a counterfactual re-run of the
//    gross-estate computation. This mirrors the already-established
//    convention for a holding-period count elsewhere in the corpus
//    (`corpus/laws/us/irc/credits/50-recapture.law`'s `full_years_held`) and
//    avoids inventing a "months/years between two Date values" primitive
//    this package would otherwise need to build from scratch. Recomputing
//    "the estate tax computed by EXCLUDING the transferred property from the
//    gross estate" (section 2013(c)(1)(B), section 2014(c)(2)) would require
//    a full counterfactual gross-estate/deduction re-run — TECH-GAPS.md G368,
//    modelled here as a case-asserted empirical amount instead
//    (`estate_tax_excluding_prior_transfer`, `estate_tax_excluding_foreign_
//    property`) with the STATUTORY FORMULA for what that amount must equal
//    documented in the relation's label, not silently guessed by the case.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Estate,
    EstateDeductionKind,
    IRC_S2012_A,
    IRC_S2013_A,
    IRC_S2013_B,
    IRC_S2013_C,
    IRC_S2013_D,
    IRC_S2014_A,
    IRC_S2014_B,
    IRC_S2016,
    Person,
    Secretary,
    credit_denied_2014h,
    estate_deduction_allowed,
    estate_tax,
    estate_tax_after_2010_2012_2014,
    estate_tax_after_unified_credit,
    executor_of,
    federal_estate_tax_with_2013f,
    foreign_taxed_property_value_2014c2,
    gift_after_1976_no_credit_2012e,
    gift_tax_paid_for_credit_2012,
    gift_value_for_2012_ratio,
    gross_estate,
    prior_transfer_credit_limit_applied_2013c,
    prior_transfer_value_net_2013d,
    spouse_of,
    taxable_estate,
    transferor_taxable_estate_for_2013,
};

// =====================================================================
// §2011 — REPEALED (Pub. L. 113-295, div. A, title II, §221(a)(95)(A)(i),
// Dec. 19, 2014, 128 Stat. 4051, subject to a savings provision). No
// executable content: NON_NORMATIVE / repealed_or_reserved, see the
// coverage row (26/2011/note/2/1). Nothing else to model.
// =====================================================================

// =====================================================================
// §2012 — Credit for gift tax on pre-1977 gifts (still-live text: applies
// only where a chapter-12 gift tax, or a corresponding pre-1977 gift tax,
// was actually paid on a gift now pulled into the gross estate; for gifts
// made after 1976 the SAME cumulative chapter-12 tax is instead credited
// under section 2001(b)(2), already modelled in 01-estate-imposition.law's
// `gift_tax_payable_at_current_rates`, so a case for a post-1976 gift simply
// never asserts `gift_paid_before_1977` and this module never fires).
// =====================================================================

pub relation gift_paid_before_1977(e: Estate, gift_id: Integer) kind empirical {
    label en unofficial "a gift, includible in this estate's gross estate, on which a chapter-12 (or corresponding prior-law) gift tax was actually paid before 1977 (section 2012(a))";
}
pub relation gift_tax_paid_on_gift_2012(e: Estate, gift_id: Integer, amount: Money) kind empirical {
    label en unofficial "the amount of tax actually paid under chapter 12 (or corresponding prior law) with respect to the gift (section 2012(a); section 2012(c) doubles this fact per half where the gift was split under section 2513, read directly as the ALREADY-combined amount for both halves, per the module header's convention of asserting combined case facts rather than decomposing every split-gift computation a second time)";
}
pub relation gift_value_reduced_2012b(e: Estate, gift_id: Integer, value: Money) kind empirical {
    label en unofficial "the value of the gift (at the time of the gift or of death, whichever is lower), AFTER the section 2012(b)(1)-(3) reductions for the section 2503(a) annual-exclusion amount and, if applicable, the section 2056(a) marital or section 2055/2106(a)(2) charitable deduction taken with respect to that gift";
}

@source(IRC_S2012_A, relation = formalizes, coverage = partial, quote = "there shall be credited against the tax imposed by section 2001 the amount of the tax paid on a gift under chapter 12")
pub relation gift_tax_credit_2012_ratio_limit(e: Estate, gift_id: Integer, amount: Money) kind institutional {
    label en official "the section 2012(a) ratio limitation on the credit for the stated gift: the tax imposed by section 2001 (after the section 2010 unified credit) multiplied by the ratio the reduced gift value bears to the entire gross estate reduced by the aggregate charitable and marital deductions";
}
rule GiftTaxCredit2012RatioLimitRule(
    e: Estate,
    gift_id: Integer,
    tax_after_2010: Money,
    gift_value: Money,
    gross: Money,
    charitable: Money,
    marital: Money
) defeasible {
    when gift_paid_before_1977(e, gift_id);
    when estate_tax_after_unified_credit(e, tax_after_2010);
    when gift_value_for_2012_ratio(e, gift_id, gift_value);
    when gross_estate(e, gross);
    when charitable_and_marital_deduction_total_2012(e, charitable, marital);
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then gift_tax_credit_2012_ratio_limit(e, gift_id, div_round(tax_after_2010 * (gift_value / 1.00 USD), (gross - charitable - marital) / 1.00 USD, 2, "HALF_UP"));
}

// Helper: the "aggregate amount of the charitable and marital deductions" the
// ratio's denominator subtracts (section 2012(a)'s own final clause).
pub relation charitable_and_marital_deduction_total_2012(e: Estate, charitable: Money, marital: Money) kind institutional {
    label en unofficial "the charitable (section 2055/2106(a)(2)) and marital (section 2056) deduction amounts allowed to this estate, read from `estate_deduction_allowed` (01-estate-imposition.law); zero where none is allowed";
}
rule CharitableAndMaritalTotal2012BothRule(e: Estate, c: Money, m: Money) defeasible {
    when estate_deduction_allowed(e, CharitableDeduction, c);
    when estate_deduction_allowed(e, MaritalDeduction, m);
    then charitable_and_marital_deduction_total_2012(e, c, m);
}
relation has_charitable_deduction_2012(e: Estate) kind institutional;
rule HasCharitableDeduction2012Rule(e: Estate) defeasible {
    when estate_deduction_allowed(e, CharitableDeduction, _);
    then has_charitable_deduction_2012(e);
}
relation has_marital_deduction_2012(e: Estate) kind institutional;
rule HasMaritalDeduction2012Rule(e: Estate) defeasible {
    when estate_deduction_allowed(e, MaritalDeduction, _);
    then has_marital_deduction_2012(e);
}
rule CharitableAndMaritalTotal2012MaritalOnlyRule(e: Estate, m: Money) defeasible {
    when estate_deduction_allowed(e, MaritalDeduction, m);
    when not_known(has_charitable_deduction_2012(e));
    then charitable_and_marital_deduction_total_2012(e, 0.00 USD, m);
}
rule CharitableAndMaritalTotal2012CharitableOnlyRule(e: Estate, c: Money) defeasible {
    when estate_deduction_allowed(e, CharitableDeduction, c);
    when not_known(has_marital_deduction_2012(e));
    then charitable_and_marital_deduction_total_2012(e, c, 0.00 USD);
}
rule CharitableAndMaritalTotal2012NeitherRule(e: Estate) defeasible {
    when estate_tax_after_unified_credit(e, _);
    when not_known(has_charitable_deduction_2012(e));
    when not_known(has_marital_deduction_2012(e));
    then charitable_and_marital_deduction_total_2012(e, 0.00 USD, 0.00 USD);
}

@source(IRC_S2012_A, relation = formalizes, coverage = exact, quote = "there shall be credited against the tax imposed by section 2001 the amount of the tax paid on a gift under chapter 12")
pub relation gift_tax_credit_2012(e: Estate, gift_id: Integer, amount: Money) kind institutional {
    label en official "the section 2012 credit for the stated gift: the lesser of the gift tax actually paid on it and the section 2012(a) ratio limitation";
}
rule GiftTaxCredit2012Rule(e: Estate, gift_id: Integer, paid: Money, limit: Money) defeasible {
    when gift_tax_paid_for_credit_2012(e, gift_id, paid);
    when not_known(gift_after_1976_no_credit_2012e(e, gift_id));
    when gift_tax_credit_2012_ratio_limit(e, gift_id, limit);
    then gift_tax_credit_2012(e, gift_id, min(paid, limit));
}

pub relation total_gift_tax_credit_2012(e: Estate, amount: Money) kind institutional {
    label en official "the sum, over every pre-1977 gift now in the gross estate, of the section 2012 credit allowed for it";
}
rule TotalGiftTaxCredit2012Rule(e: Estate) defeasible {
    when gift_tax_credit_2012(e, _, _);
    then total_gift_tax_credit_2012(e, sum all c: Money for gift_id: Integer where gift_tax_credit_2012(e, gift_id, c));
}
relation has_gift_tax_credit_2012(e: Estate) kind institutional;
rule HasGiftTaxCredit2012Rule(e: Estate) defeasible {
    when total_gift_tax_credit_2012(e, _);
    then has_gift_tax_credit_2012(e);
}

// §2012(d)-(e): "amount of tax paid" / "amount of such gift" definitions and
// the section 2010(b) pre-1977-specific-exemption coordination bar. NOT
// modelled: definitional refinements of facts this module already takes as
// case-asserted (`gift_tax_paid_on_gift_2012`, `gift_value_reduced_2012b`
// already read as the POST-(b)/(d) combined figures) — NON_NORMATIVE for
// this package's purposes (the definitional text is absorbed into the
// label of the fact it defines, not a separate computable norm), except
// (e)'s cross-reference to section 2010(b) (TECH_GAP: section 2010(b) itself
// is not modelled in this package, see 02-unified-credit.law's header).

// =====================================================================
// §2013 — Credit for tax on prior transfers. THE STAGE-2 PRIORITY.
// =====================================================================

// --- (a): general rule and the eligibility/percentage schedule -------------

pub relation prior_transfer_from(transferor_estate: Estate, decedent_estate: Estate) kind empirical {
    label en unofficial "transferor_estate is a \"transferor\" (section 2013(a)) with respect to decedent_estate: property passed from transferor_estate's decedent to decedent_estate's decedent (by death, including by exercise/non-exercise of a power of appointment)";
}
pub relation transferor_predeceased_decedent_by_years(transferor_estate: Estate, decedent_estate: Estate, years: Decimal) kind empirical {
    label en unofficial "the transferor died this many full years BEFORE the decedent (section 2013(a); asserted directly, see the module header's judgment call on date arithmetic)";
}
pub relation transferor_died_after_decedent_by_years(transferor_estate: Estate, decedent_estate: Estate, years: Decimal) kind empirical {
    label en unofficial "the transferor died this many full years AFTER the decedent (section 2013(a)'s \"within 2 years after the decedent's death\" branch)";
}

@source(IRC_S2013_A, relation = formalizes, coverage = partial, quote = "who died within 10 years before, or within 2 years after, the decedent's death")
pub relation eligible_prior_transferor(transferor_estate: Estate, decedent_estate: Estate) kind institutional {
    label en official "the transferor is within section 2013(a)'s eligible window: died within 10 years before, or within 2 years after, the decedent's death";
}
rule EligiblePriorTransferorBeforeRule(transferor_estate: Estate, decedent_estate: Estate, years: Decimal) defeasible {
    when prior_transfer_from(transferor_estate, decedent_estate);
    when transferor_predeceased_decedent_by_years(transferor_estate, decedent_estate, years) and years <= 10.0;
    then eligible_prior_transferor(transferor_estate, decedent_estate);
}
rule EligiblePriorTransferorAfterRule(transferor_estate: Estate, decedent_estate: Estate, years: Decimal) defeasible {
    when prior_transfer_from(transferor_estate, decedent_estate);
    when transferor_died_after_decedent_by_years(transferor_estate, decedent_estate, years) and years <= 2.0;
    then eligible_prior_transferor(transferor_estate, decedent_estate);
}

@source(IRC_S2013_A, relation = formalizes, coverage = exact, quote = "the credit shall be the following percentage of the amount so determined")
pub relation prior_transfer_credit_percentage(transferor_estate: Estate, decedent_estate: Estate, pct: Decimal) kind institutional {
    label en official "the percentage of the section 2013(b)/(c) amount allowed as the credit: 100 percent within 2 years either direction; 80/60/40/20 percent by two-year band if the transferor predeceased by more than 2 (up to 10) years (section 2013(a))";
}
rule PriorTransferCreditPercentageWithinTwoYearsBeforeRule(transferor_estate: Estate, decedent_estate: Estate, years: Decimal) defeasible {
    when transferor_predeceased_decedent_by_years(transferor_estate, decedent_estate, years) and years <= 2.0;
    then prior_transfer_credit_percentage(transferor_estate, decedent_estate, 1.00);
}
rule PriorTransferCreditPercentageWithinTwoYearsAfterRule(transferor_estate: Estate, decedent_estate: Estate, years: Decimal) defeasible {
    when transferor_died_after_decedent_by_years(transferor_estate, decedent_estate, years) and years <= 2.0;
    then prior_transfer_credit_percentage(transferor_estate, decedent_estate, 1.00);
}
relation prior_transfer_credit_percentage_by_years(years_predeceased: Decimal, pct: Decimal) kind institutional;
rule PriorTransferCreditPercentageBeyondTwoYearsRule(transferor_estate: Estate, decedent_estate: Estate, years: Decimal, pct: Decimal) defeasible {
    when transferor_predeceased_decedent_by_years(transferor_estate, decedent_estate, years) and years > 2.0;
    when prior_transfer_credit_percentage_by_years(years, pct);
    then prior_transfer_credit_percentage(transferor_estate, decedent_estate, pct);
}

// --- (b): computation of the credit (before the (c) limitation) ------------

pub relation prior_transfer_property_value(transferor_estate: Estate, decedent_estate: Estate, value: Money) kind empirical {
    label en unofficial "the value of the property transferred to the decedent by the transferor, as determined under section 2013(d) (asserted directly: see the module header's judgment call — (d)(1)-(3)'s own adjustments are the case's responsibility to have already applied when giving this figure)";
}
pub relation transferor_taxable_estate(transferor_estate: Estate, amount: Money) kind institutional {
    label en unofficial "the transferor's own taxable estate for purposes of the section 2013(b) ratio: read from `taxable_estate` (01-estate-imposition.law) when the transferor's estate is itself modelled in this case, or asserted directly for a transferor outside the case's own gross-estate computation";
}
rule TransferorTaxableEstateFromOwnComputationRule(transferor_estate: Estate, amount: Money) defeasible {
    when taxable_estate(transferor_estate, amount);
    then transferor_taxable_estate(transferor_estate, amount);
}
pub relation death_taxes_paid_by_transferor_estate(transferor_estate: Estate, amount: Money) kind empirical {
    label en unofficial "death taxes (state, foreign, etc.) paid with respect to the transferor's estate, subtracted from the transferor's taxable estate in the section 2013(b) ratio denominator; zero where none is asserted";
}
relation has_death_taxes_paid_2013(transferor_estate: Estate) kind institutional;
rule HasDeathTaxesPaid2013Rule(transferor_estate: Estate) defeasible {
    when death_taxes_paid_by_transferor_estate(transferor_estate, _);
    then has_death_taxes_paid_2013(transferor_estate);
}
pub relation federal_estate_tax_paid_for_2013b(transferor_estate: Estate, amount: Money) kind institutional {
    label en official "the \"estate tax paid\" of section 2013(b)'s first sentence, adjusted per its second sentence: the transferor's own Federal estate tax (after the section 2010 credit only, see the module header's judgment call), increased by any section 2012 credit allowed against it";
}
rule FederalEstateTaxPaidFor2013bWithGiftCreditRule(transferor_estate: Estate, base: Money, c12: Money) defeasible {
    when estate_tax_after_unified_credit(transferor_estate, base);
    when total_gift_tax_credit_2012(transferor_estate, c12);
    then federal_estate_tax_paid_for_2013b(transferor_estate, base + c12);
}
rule FederalEstateTaxPaidFor2013bNoGiftCreditRule(transferor_estate: Estate, base: Money) defeasible {
    when estate_tax_after_unified_credit(transferor_estate, base);
    when not_known(has_gift_tax_credit_2012(transferor_estate));
    then federal_estate_tax_paid_for_2013b(transferor_estate, base);
}

@source(IRC_S2013_B, relation = formalizes, coverage = exact, quote = "the credit provided by this section shall be an amount which bears the same ratio to the estate tax paid (adjusted as indicated hereinafter) with respect to the estate of the transferor as the value of the property transferred bears to the taxable estate of the transferor (determined for purposes of the estate tax) decreased by any death taxes paid with respect to such estate")
pub relation prior_transfer_credit_before_limitation(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind institutional {
    label en official "the section 2013(b) amount before the section 2013(a) percentage and the section 2013(c) limitation: the transferor's adjusted estate tax paid, times the ratio the transferred property's value bears to the transferor's taxable estate less death taxes paid";
}
rule PriorTransferCreditBeforeLimitationWithDeathTaxesRule(
    transferor_estate: Estate,
    decedent_estate: Estate,
    tax_paid: Money,
    value: Money,
    taxable: Money,
    death_taxes: Money
) defeasible {
    when eligible_prior_transferor(transferor_estate, decedent_estate);
    when federal_estate_tax_with_2013f(transferor_estate, decedent_estate, tax_paid);
    when prior_transfer_value_net_2013d(transferor_estate, decedent_estate, value);
    when transferor_taxable_estate_for_2013(transferor_estate, decedent_estate, taxable);
    when death_taxes_paid_by_transferor_estate(transferor_estate, death_taxes);
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then prior_transfer_credit_before_limitation(transferor_estate, decedent_estate, div_round(tax_paid * (value / 1.00 USD), (taxable - death_taxes) / 1.00 USD, 2, "HALF_UP"));
}
rule PriorTransferCreditBeforeLimitationNoDeathTaxesRule(
    transferor_estate: Estate,
    decedent_estate: Estate,
    tax_paid: Money,
    value: Money,
    taxable: Money
) defeasible {
    when eligible_prior_transferor(transferor_estate, decedent_estate);
    when federal_estate_tax_with_2013f(transferor_estate, decedent_estate, tax_paid);
    when prior_transfer_value_net_2013d(transferor_estate, decedent_estate, value);
    when transferor_taxable_estate_for_2013(transferor_estate, decedent_estate, taxable);
    when not_known(has_death_taxes_paid_2013(transferor_estate));
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then prior_transfer_credit_before_limitation(transferor_estate, decedent_estate, div_round(tax_paid * (value / 1.00 USD), taxable / 1.00 USD, 2, "HALF_UP"));
}

// Apply the (a) percentage.
pub relation prior_transfer_credit_after_percentage(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind institutional {
    label en unofficial "the section 2013(b) amount after the section 2013(a) percentage, before the section 2013(c) limitation";
}
rule PriorTransferCreditAfterPercentageRule(transferor_estate: Estate, decedent_estate: Estate, base: Money, pct: Decimal) defeasible {
    when prior_transfer_credit_before_limitation(transferor_estate, decedent_estate, base);
    when prior_transfer_credit_percentage(transferor_estate, decedent_estate, pct);
    then prior_transfer_credit_after_percentage(transferor_estate, decedent_estate, round(base * pct, 2, "HALF_UP"));
}

// --- (c): limitation on credit ----------------------------------------------
// (c)(1)(B)'s "tax computed by excluding ... the value of such property
// transferred" is a full counterfactual re-run of the gross-estate/deduction
// chain — TECH-GAPS.md G368, read as a case-asserted amount per the module
// header's judgment call, with the statutory formula recorded in the label.

pub relation estate_tax_excluding_prior_transfer(decedent_estate: Estate, transferor_estate: Estate, amount: Money) kind empirical {
    label en unofficial "section 2013(c)(1)(B): the tax that would be imposed by section 2001, computed by excluding the value of the property transferred by transferor_estate from the decedent's gross estate, and reducing any section 2055/2106(a)(2) charitable deduction by the property's proportionate share (section 2013(c)(1)'s final sentence) — asserted directly, see TECH-GAPS.md G368";
}

@source(IRC_S2013_C, relation = formalizes, coverage = exact, quote = "The credit provided in this section shall not exceed the amount by which")
pub relation prior_transfer_credit_limitation(decedent_estate: Estate, transferor_estate: Estate, amount: Money) kind institutional {
    label en official "the section 2013(c)(1) limitation for the stated transferor: the decedent's tax imposed by section 2001 (after the sections 2010, 2012 and 2014 credits, computed without regard to section 2013) minus the same tax computed excluding the transferred property";
}
rule PriorTransferCreditLimitationRule(
    decedent_estate: Estate,
    transferor_estate: Estate,
    after_credits: Money,
    excluding: Money
) defeasible {
    label en official "the tax after the sections 2010, 2012 and 2014 credits, computed without regard to this section, over the tax computed excluding the transferred property (section 2013(c)(1))";
    when estate_tax_after_2010_2012_2014(decedent_estate, after_credits);
    when estate_tax_excluding_prior_transfer(decedent_estate, transferor_estate, excluding);
    then prior_transfer_credit_limitation(decedent_estate, transferor_estate, max(0.00 USD, after_credits - excluding));
}

// (c)(2): two or more transferors — the aggregate limitation is apportioned
// by each transferor's share of the total value transferred. Modelled by
// applying (c)(1)'s per-transferor limitation independently and then, ONLY
// where the sum of the per-transferor tentative credits would exceed the sum
// of the per-transferor limitations, this package does not derive the
// proportional apportionment automatically — TECH-GAPS.md G369 (would need
// an aggregate-then-redistribute pass this package's other aggregate
// patterns, e.g. `total_gift_tax_credit_2012`, do not need because their caps
// apply per-item already). A single-transferor case (the common one, and
// every scenario this pass writes) is unaffected: the per-transferor min
// below is exact for it.

@source(IRC_S2013_A, relation = formalizes, coverage = exact, quote = "The tax imposed by section 2001 shall be credited with all or a part of the amount of the Federal estate tax paid with respect to the transfer of property")
pub relation prior_transfer_credit(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind institutional {
    label en official "the section 2013 credit for tax on prior transfers, for the stated transferor: the lesser of the section 2013(a)-(b) amount and the section 2013(c)(1) limitation (see this module's header for the (c)(2) multiple-transferor simplification)";
}
rule PriorTransferCreditRule(transferor_estate: Estate, decedent_estate: Estate, amount: Money, limit: Money) defeasible {
    when prior_transfer_credit_after_percentage(transferor_estate, decedent_estate, amount);
    when prior_transfer_credit_limit_applied_2013c(decedent_estate, transferor_estate, limit);
    then prior_transfer_credit(transferor_estate, decedent_estate, min(amount, limit));
}

pub relation total_prior_transfer_credit(decedent_estate: Estate, amount: Money) kind institutional {
    label en official "the sum, over every eligible transferor, of the section 2013 credit allowed (section 2013(c)(2)'s aggregation for the multiple-transferor case, see the header simplification)";
}
rule TotalPriorTransferCreditRule(decedent_estate: Estate) defeasible {
    when prior_transfer_credit(_, decedent_estate, _);
    then total_prior_transfer_credit(decedent_estate, sum all c: Money for transferor_estate: Estate where prior_transfer_credit(transferor_estate, decedent_estate, c));
}
relation has_prior_transfer_credit(decedent_estate: Estate) kind institutional;
rule HasPriorTransferCreditRule(decedent_estate: Estate) defeasible {
    when total_prior_transfer_credit(decedent_estate, _);
    then has_prior_transfer_credit(decedent_estate);
}

// --- (d): valuation of property transferred ---------------------------------
// (d)(1)-(2) (net-of-tax and net-of-encumbrance value) are absorbed into the
// case-asserted `prior_transfer_property_value` (module header judgment
// call). (d)(3) (spousal reduction by the section 2056 marital deduction
// allowed on the TRANSFEROR's own estate) is modelled directly, since it
// reads facts this package already computes on the transferor's own estate.

@source(IRC_S2013_D, relation = formalizes, coverage = partial, quote = "if the decedent was the spouse of the transferor at the time of the transferor's death, the net value of the property transferred to the decedent shall be reduced by the amount allowed under section 2056")
pub relation prior_transfer_property_value_spousal_adjustment_applies(transferor_estate: Estate, decedent_estate: Estate) kind institutional {
    label en official "section 2013(d)(3): the decedent was the transferor's spouse at the transferor's death, so the transferred property's value is reduced by the transferor's own section 2056 marital deduction (the case's `prior_transfer_property_value` for this pair must already reflect that reduction, per the module header's convention — this relation flags WHEN the reduction is required, so a case omitting it is a documented gap, not a silent one)";
}
rule PriorTransferPropertyValueSpousalAdjustmentRule(transferor_estate: Estate, decedent_estate: Estate) defeasible {
    when spouse_of(decedent_estate, transferor_estate);
    when prior_transfer_from(transferor_estate, decedent_estate);
    then prior_transfer_property_value_spousal_adjustment_applies(transferor_estate, decedent_estate);
}

// --- (e): "property" defined ------------------------------------------------
// Absorbed into the scope of `prior_transfer_property_value`/`prior_transfer_from`
// (a beneficial interest, including a general power of appointment under
// section 2041, is already within "property transferred" as this package's
// relations are typed) — NON_NORMATIVE (a definitional clause the executable
// relations already implement by their own domain, not a separate norm).

// --- (f): treatment of additional §2032A(c) recapture tax ------------------
// TECH_GAP: depends on section 2032A(c) (not modelled this pass, see the
// separate priority list) and on knowing the exact date the additional tax
// was imposed relative to "2 years after the decedent's death" — deferred,
// TECH-GAPS.md G370.

// =====================================================================
// §2014 — Credit for foreign death taxes. (a) and (b) modelled; (c)-(h) are
// NON_NORMATIVE (valuation/evidentiary/definitional clauses folded into the
// facts already asserted) or TECH_GAP (period of limitation needs chapter 66
// machinery not imported; the Presidential-reciprocity power of (h) is
// out of scope) — see the coverage notes.
// =====================================================================

pub relation foreign_death_tax_paid(e: Estate, country: Text, amount: Money) kind empirical {
    label en unofficial "estate, inheritance, legacy, or succession tax actually paid to the named foreign country (or possession, section 2014(g)) with respect to property included in the gross estate (section 2014(a))";
}
pub relation foreign_taxed_property_in_gross_estate(e: Estate, country: Text, value: Money) kind empirical {
    label en unofficial "the value of property situated in the named foreign country, subjected to that country's tax, and included in the gross estate (section 2014(b)(1)(A)-(C))";
}
pub relation foreign_taxed_property_total(e: Estate, country: Text, value: Money) kind empirical {
    label en unofficial "the value of ALL property subjected to the named foreign country's tax (section 2014(b)(1)'s ratio denominator)";
}

@source(IRC_S2014_B, relation = formalizes, coverage = partial, quote = "shall not, with respect to any such tax, exceed an amount which bears the same ratio to the amount of such tax actually paid to such foreign country as the value of property which is—")
pub relation foreign_death_tax_credit_per_country_limit(e: Estate, country: Text, amount: Money) kind institutional {
    label en official "the section 2014(b)(1) per-country limitation: the foreign tax actually paid, times the ratio the in-gross-estate portion bears to all property subjected to that country's tax";
}
rule ForeignDeathTaxCreditPerCountryLimitRule(e: Estate, country: Text, paid: Money, in_estate: Money, total: Money) defeasible {
    when foreign_death_tax_paid(e, country, paid);
    when foreign_taxed_property_value_2014c2(e, country, in_estate);
    when foreign_taxed_property_total(e, country, total);
    when not_known(credit_denied_2014h(e, country));
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then foreign_death_tax_credit_per_country_limit(e, country, div_round(paid * (in_estate / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

pub relation foreign_death_tax_credit_aggregate_limit(e: Estate, amount: Money) kind institutional {
    label en official "the section 2014(b)(2) aggregate limitation across every foreign country: the tax imposed by section 2001 (after the sections 2010 and 2012 credits) times the ratio the total in-gross-estate foreign-taxed value bears to the entire gross estate reduced by the aggregate section 2055/2056 deductions";
}
rule ForeignDeathTaxCreditAggregateLimitWithGiftCreditRule(
    e: Estate,
    after_2010: Money,
    c12: Money,
    total_in_estate: Money,
    gross: Money,
    charitable: Money,
    marital: Money
) defeasible {
    when estate_tax_after_unified_credit(e, after_2010);
    when total_gift_tax_credit_2012(e, c12);
    when total_foreign_taxed_property_in_gross_estate(e, total_in_estate);
    when gross_estate(e, gross);
    when charitable_and_marital_deduction_total_2012(e, charitable, marital);
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then foreign_death_tax_credit_aggregate_limit(e, div_round((after_2010 - c12) * (total_in_estate / 1.00 USD), (gross - charitable - marital) / 1.00 USD, 2, "HALF_UP"));
}
rule ForeignDeathTaxCreditAggregateLimitNoGiftCreditRule(
    e: Estate,
    after_2010: Money,
    total_in_estate: Money,
    gross: Money,
    charitable: Money,
    marital: Money
) defeasible {
    when estate_tax_after_unified_credit(e, after_2010);
    when not_known(has_gift_tax_credit_2012(e));
    when total_foreign_taxed_property_in_gross_estate(e, total_in_estate);
    when gross_estate(e, gross);
    when charitable_and_marital_deduction_total_2012(e, charitable, marital);
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then foreign_death_tax_credit_aggregate_limit(e, div_round(after_2010 * (total_in_estate / 1.00 USD), (gross - charitable - marital) / 1.00 USD, 2, "HALF_UP"));
}
pub relation total_foreign_taxed_property_in_gross_estate(e: Estate, amount: Money) kind institutional {
    label en unofficial "the sum, over every foreign country, of the in-gross-estate foreign-taxed value (section 2014(b)(2)'s ratio numerator)";
}
rule TotalForeignTaxedPropertyInGrossEstateRule(e: Estate) defeasible {
    when foreign_taxed_property_value_2014c2(e, _, _);
    then total_foreign_taxed_property_in_gross_estate(e, sum all v: Money for country: Text where foreign_taxed_property_value_2014c2(e, country, v));
}

@source(IRC_S2014_A, relation = formalizes, coverage = exact, quote = "The tax imposed by section 2001 shall be credited with the amount of any estate, inheritance, legacy, or succession taxes actually paid to any foreign country")
pub relation foreign_death_tax_credit_per_country(e: Estate, country: Text, amount: Money) kind institutional {
    label en official "the section 2014 credit for the named foreign country's tax: the lesser of the section 2014(b)(1) per-country limitation and the section 2014(b)(2) aggregate limitation's per-country share is NOT separately apportioned this pass (TECH-GAPS.md G370 note below) — modelled as the per-country limitation, capped in total by the aggregate limitation via `foreign_death_tax_credit`";
}
rule ForeignDeathTaxCreditPerCountryRule(e: Estate, country: Text, amount: Money) defeasible {
    when foreign_death_tax_credit_per_country_limit(e, country, amount);
    then foreign_death_tax_credit_per_country(e, country, amount);
}
pub relation total_foreign_death_tax_credit_before_aggregate_limit(e: Estate, amount: Money) kind institutional {
    label en unofficial "the sum of every per-country section 2014(b)(1) limitation, before the section 2014(b)(2) aggregate cap";
}
rule TotalForeignDeathTaxCreditBeforeAggregateLimitRule(e: Estate) defeasible {
    when foreign_death_tax_credit_per_country(e, _, _);
    then total_foreign_death_tax_credit_before_aggregate_limit(e, sum all c: Money for country: Text where foreign_death_tax_credit_per_country(e, country, c));
}

@source(IRC_S2014_B, relation = formalizes, coverage = exact, quote = "shall not, with respect to all such taxes, exceed an amount which bears the same ratio to the tax imposed by section 2001")
pub relation foreign_death_tax_credit(e: Estate, amount: Money) kind institutional {
    label en official "the section 2014 credit for foreign death taxes: the lesser of the sum of the section 2014(b)(1) per-country limitations and the section 2014(b)(2) aggregate limitation";
}
rule ForeignDeathTaxCreditRule(e: Estate, before_aggregate: Money, aggregate_limit: Money) defeasible {
    when total_foreign_death_tax_credit_before_aggregate_limit(e, before_aggregate);
    when foreign_death_tax_credit_aggregate_limit(e, aggregate_limit);
    then foreign_death_tax_credit(e, min(before_aggregate, aggregate_limit));
}
relation has_foreign_death_tax_credit(e: Estate) kind institutional;
rule HasForeignDeathTaxCreditRule(e: Estate) defeasible {
    when foreign_death_tax_credit(e, _);
    then has_foreign_death_tax_credit(e);
}

// §2014(g): "each possession of the United States shall be deemed to be a
// foreign country" — a one-line definitional extension of the SCOPE of
// `foreign_death_tax_paid`'s `country` argument (a case may name a
// possession there directly); no separate rule needed. EXECUTABLE by scope,
// not by a further relation.

// §2014(c) (valuation refinements to the ratios already computed above),
// (d) (evidentiary proof-of-credit precondition), (f) (exclusion of property
// separately deducted under section 2053(d), not modelled — section 2053(d)
// itself is not in this package's stage-1 or stage-2 scope), and (h) (the
// Presidential-reciprocity power) are NOT modelled — see coverage notes.
// §2014(e) (4-year period-of-limitation on claiming the credit) is TECH_GAP:
// needs chapter 66's assessment/refund-period machinery (owned by
// `assessment`, not imported here).

// =====================================================================
// §2015 — Credit for death taxes on remainders. Depends entirely on a
// section 6163(a) election to postpone payment of the tax attributable to a
// reversionary/remainder interest — chapter 62 (`administration` package)
// infrastructure this package does not import. TECH_GAP in full: no
// executable content this pass (see coverage notes; TECH-GAPS.md G370).
// =====================================================================

// =====================================================================
// §2016 — Recovery of taxes claimed as credit under section 2014. Modelled
// as (1) the executor's duty to notify the Secretary of a foreign-country
// recovery, and (2) the Secretary's resulting redetermination of the tax as
// an institutional effect (the interest-free-until-receipt rule of the last
// sentence is NOT modelled — TECH_GAP, needs the underlying interest-on-
// deficiency computation owned by another package).
// =====================================================================

pub relation foreign_death_tax_credit_recovered(e: Estate, country: Text, amount: Money) kind empirical {
    label en unofficial "an amount of tax previously claimed as a section 2014 credit has been recovered from the named foreign country (section 2016)";
}

pub relation notice_of_recovery_given(e: Estate, x: Person, country: Text) kind empirical {
    label en unofficial "the executor (or recovering person) gave the Secretary notice of the recovery (performance of the section 2016 duty)";
}

@source(IRC_S2016, relation = formalizes, coverage = partial, quote = "the executor, or any other person or persons recovering such amount, shall give notice of such recovery to the Secretary")
rule ExecutorNotifyRecoveryDutyRule(e: Estate, x: Person, country: Text, w: Interval<Instant>) defeasible {
    label en official "the executor (or recovering person) shall give notice of such recovery to the Secretary (section 2016) — the WINDOW here is an EXTERNAL_DEPENDENCY on unpinned Treasury regulations (TECH-GAPS.md G370), not a statutory fixed number of days, and is simply the executor's own tenure window `w` as a placeholder bound";
    when foreign_death_tax_credit_recovered(e, country, _)
        and executor_of(e, x, w);
    then duty ExecutorNotifyRecoveryDuty {
        bearer x;
        beneficiary Secretary;
        achieve notice_of_recovery_given(e, x, country) during w;
    };
}

@source(IRC_S2016, relation = formalizes, coverage = partial, quote = "the Secretary shall (despite the provisions of section 6501) redetermine the amount of the tax under this chapter")
pub relation estate_tax_redetermined_after_recovery(e: Estate, amount: Money) kind institutional {
    label en official "the redetermined chapter 11 tax after a section 2014-credit recovery (section 2016): the tax before redetermination, increased by the recovered amount (the recovered tax is no longer creditable)";
}
rule EstateTaxRedeterminedAfterRecoveryRule(e: Estate, before: Money, recovered: Money) defeasible {
    when estate_tax(e, before);
    when foreign_death_tax_credit_recovered(e, _, recovered);
    then estate_tax_redetermined_after_recovery(e, before + recovered);
}

// =====================================================================
// FINAL INTERFACE: estate_tax = estate_tax_after_unified_credit - section
// 2012 credit - section 2013 credit - section 2014 credit. `estate_tax` is
// declared once, as `pub relation`, in 01-estate-imposition.law; every branch
// below is a `defeasible` rule on that SAME head (matching the pattern
// 02-unified-credit.law already uses for `estate_tax_after_unified_credit`).
// Sections 2015-2016 are NOT layered into this arithmetic (2015 has no
// executable content this pass; 2016's redetermination is its own separate
// relation, `estate_tax_redetermined_after_recovery`, deliberately NOT fed
// back into `estate_tax` itself — section 2016 describes a POST-finality
// correction, not a first-instance component of the tax).
// =====================================================================

pub relation total_chapter11_credits_2012_2013_2014(e: Estate, amount: Money) kind institutional {
    label en unofficial "the sum of whichever of the section 2012, 2013 and 2014 credits are present for this estate";
}
rule TotalCh11CreditsAllThreeRule(e: Estate, c12: Money, c13: Money, c14: Money) defeasible {
    when total_gift_tax_credit_2012(e, c12);
    when total_prior_transfer_credit(e, c13);
    when foreign_death_tax_credit(e, c14);
    then total_chapter11_credits_2012_2013_2014(e, c12 + c13 + c14);
}
rule TotalCh11Credits2012And2013OnlyRule(e: Estate, c12: Money, c13: Money) defeasible {
    when total_gift_tax_credit_2012(e, c12);
    when total_prior_transfer_credit(e, c13);
    when not_known(has_foreign_death_tax_credit(e));
    then total_chapter11_credits_2012_2013_2014(e, c12 + c13);
}
rule TotalCh11Credits2012And2014OnlyRule(e: Estate, c12: Money, c14: Money) defeasible {
    when total_gift_tax_credit_2012(e, c12);
    when not_known(has_prior_transfer_credit(e));
    when foreign_death_tax_credit(e, c14);
    then total_chapter11_credits_2012_2013_2014(e, c12 + c14);
}
rule TotalCh11Credits2013And2014OnlyRule(e: Estate, c13: Money, c14: Money) defeasible {
    when not_known(has_gift_tax_credit_2012(e));
    when total_prior_transfer_credit(e, c13);
    when foreign_death_tax_credit(e, c14);
    then total_chapter11_credits_2012_2013_2014(e, c13 + c14);
}
rule TotalCh11Credits2012OnlyRule(e: Estate, c12: Money) defeasible {
    when total_gift_tax_credit_2012(e, c12);
    when not_known(has_prior_transfer_credit(e));
    when not_known(has_foreign_death_tax_credit(e));
    then total_chapter11_credits_2012_2013_2014(e, c12);
}
rule TotalCh11Credits2013OnlyRule(e: Estate, c13: Money) defeasible {
    when not_known(has_gift_tax_credit_2012(e));
    when total_prior_transfer_credit(e, c13);
    when not_known(has_foreign_death_tax_credit(e));
    then total_chapter11_credits_2012_2013_2014(e, c13);
}
rule TotalCh11Credits2014OnlyRule(e: Estate, c14: Money) defeasible {
    when not_known(has_gift_tax_credit_2012(e));
    when not_known(has_prior_transfer_credit(e));
    when foreign_death_tax_credit(e, c14);
    then total_chapter11_credits_2012_2013_2014(e, c14);
}
relation has_ch11_credits_2012_2013_2014(e: Estate) kind institutional;
rule HasCh11Credits2012_2013_2014Rule(e: Estate) defeasible {
    when total_chapter11_credits_2012_2013_2014(e, _);
    then has_ch11_credits_2012_2013_2014(e);
}

rule EstateTaxFinalWithChapter11CreditsRule(e: Estate, after_2010: Money, credits: Money) defeasible {
    when estate_tax_after_unified_credit(e, after_2010);
    when total_chapter11_credits_2012_2013_2014(e, credits);
    then estate_tax(e, max(0.00 USD, after_2010 - min(credits, after_2010)));
}
rule EstateTaxFinalNoChapter11CreditsRule(e: Estate, after_2010: Money) defeasible {
    when estate_tax_after_unified_credit(e, after_2010);
    when not_known(has_ch11_credits_2012_2013_2014(e));
    then estate_tax(e, after_2010);
}
