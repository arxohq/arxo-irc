// 26 U.S.C. §2032A(b)(4)-(5), (c)(2)(D)-(E), (c)(3), (c)(6)(B), (c)(7)-(8),
// (d)(1), (d)(3), (e)(3)-(5), (e)(7), (e)(9), (e)(11)-(14), (f), (g), (h), (i)
// — the rest of special use valuation and its recapture. Stage 2
// (DECISION-0379 with deontics) of `us.irc.estate_gift` (B01/IRC-11);
// continues 08-special-use-valuation-2032a.law.
//
// SHAPE. Powers: the executor's cure of a defective election (d)(3) — with the
// executor's LIBERTY to cure for at most 90 days after notice —, the woodland
// election (e)(13), the qualified heir's bond (e)(11), the Secretary's assessment
// of the additional tax after the (f) period; duties: the Secretary's notice of
// the maximum tax (e)(11). Involuntary conversions (h) and like-kind exchanges (i)
// reduce the additional tax by the ratio of replacement to realization.
//
// JUDGMENT CALLS
//  - (c)(2)(D)(ii) and (E)(ii)(II): the additional tax "reduced by the tax imposed
//    on all prior transactions" is one step over an asserted prior total: a chain
//    over successive portions is the same recursion as before (TECH-GAPS G3616).
//  - (c)(7)(A)(ii): the 10-year period "extended by the period after the decedent's
//    death and before the commencement date" is computed as ending 10 years after
//    the commencement date (calendar years; the day-count difference of an
//    extension by a period of days is not separately computed).
//  - (e)(6) material participation "in a manner similar to" §1402(a)(1) is a case
//    fact (EXTERNAL_DEPENDENCY on the self-employment package).
//  - (e)(8) valuation factors are an appraisal (EVALUATIVE): the value is asserted.
//  - (e)(10) community property is an interpretive directive (INTERPRETATION).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2032A_B,
    IRC_S2032A_C,
    IRC_S2032A_D,
    IRC_S2032A_E,
    IRC_S2032A_F,
    IRC_S2032A_G,
    IRC_S2032A_H,
    IRC_S2032A_I,
    Individual,
    Person,
    Secretary,
    Trust,
    date_of_death,
    decedent_individual,
    disposition_or_cessation_event,
    executor_of,
    has_qualified_use,
    meets_five_of_eight_year_test,
    qualified_heir,
    qualified_heir_ceases_qualified_use,
    qualified_heir_disposes_of_interest,
    qualified_real_property,
    qualified_real_property_value_for_use,
    special_use_valuation_election_made,
    special_use_valuation_election_valid,
    surviving_spouse_of,
};

// =====================================================================
// (c)(1), (c)(7)(A): the recapture window
// =====================================================================

pub relation qualified_heir_death_date(heir: Individual, d: Date) kind empirical {
    label en unofficial "the date of the death of the qualified heir";
}
relation heir_death_recorded_2032a(heir: Individual) kind institutional;
rule HeirDeathRecordedRule(heir: Individual) defeasible {
    when qualified_heir_death_date(heir, _);
    then heir_death_recorded_2032a(heir);
}
pub relation heir_commencement_of_use_date(e: Estate, prop: Asset, d: Date) kind empirical {
    label en unofficial "the date on which the qualified heir begins to use the qualified real property (the commencement date, section 2032A(c)(7)(A))";
}
pub relation commencement_within_two_years_of_death(e: Estate, prop: Asset) kind institutional {
    label en official "the commencement date is before the date 2 years after the decedent's death (section 2032A(c)(7)(A))";
}
rule CommencementWithinTwoYearsRule(e: Estate, prop: Asset, dod: Date, start: Date) defeasible {
    when date_of_death(e, dod);
    when heir_commencement_of_use_date(e, prop, start) and start < add_calendar_period(dod, 2 calendar_year);
    then commencement_within_two_years_of_death(e, prop);
}
pub relation recapture_window_end_2032a(e: Estate, prop: Asset, end: Date) kind institutional {
    label en official "the last day of the 10-year recapture period: 10 years after the decedent's death, or, where use begins within 2 years, extended by the period before the commencement date (section 2032A(c)(1), (7)(A)(ii))";
}
rule RecaptureWindowEndDefaultRule(e: Estate, prop: Asset, dod: Date) defeasible {
    when date_of_death(e, dod);
    when qualified_real_property(e, prop);
    when not_known(commencement_within_two_years_of_death(e, prop));
    then recapture_window_end_2032a(e, prop, add_calendar_period(dod, 10 calendar_year));
}
rule RecaptureWindowEndExtendedRule(e: Estate, prop: Asset, start: Date) defeasible {
    when commencement_within_two_years_of_death(e, prop);
    when heir_commencement_of_use_date(e, prop, start);
    then recapture_window_end_2032a(e, prop, add_calendar_period(start, 10 calendar_year));
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "no tax shall be imposed under paragraph (1) by reason of the failure by the qualified heir to so use such property before the commencement date")
pub relation no_recapture_for_failure_before_commencement_2032ac7a(e: Estate, prop: Asset, on: Date) kind institutional {
    label en official "no tax is imposed for the heir's failure to use the property before the commencement date, when use begins within 2 years of death (section 2032A(c)(7)(A)(i))";
}
rule NoRecaptureBeforeCommencementRule(e: Estate, prop: Asset, on: Date, start: Date) defeasible {
    when commencement_within_two_years_of_death(e, prop);
    when heir_commencement_of_use_date(e, prop, start);
    when qualified_heir_ceases_qualified_use(e, prop, _, on) and on < start;
    then no_recapture_for_failure_before_commencement_2032ac7a(e, prop, on);
}
// (c)(3): one additional tax per portion
relation disposition_of_same_property_recorded_2032ac3(e: Estate, prop: Asset) kind institutional;
rule DispositionOfSamePropertyRecordedRule(e: Estate, prop: Asset) defeasible {
    when qualified_heir_disposes_of_interest(e, prop, _, _, _);
    then disposition_of_same_property_recorded_2032ac3(e, prop);
}
// (c)(7)(E), (c)(8)
pub relation rented_to_family_member_on_net_cash_basis(e: Estate, prop: Asset, heir: Individual) kind empirical {
    label en unofficial "a surviving spouse or lineal descendant of the decedent rents the property to a member of the family of the spouse or descendant on a net cash basis (a legally adopted child counting as a child by blood) (section 2032A(c)(7)(E))";
}
pub relation heir_is_surviving_spouse_or_lineal_descendant_of_decedent(heir: Individual, e: Estate) kind empirical {
    label en unofficial "the heir is a surviving spouse or a lineal descendant of the decedent";
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "a surviving spouse or lineal descendant of the decedent shall not be treated as failing to use qualified real property in a qualified use solely because such spouse or descendant rents such property to a member of the family of such spouse or descendant on a net cash basis")
pub relation net_cash_rent_to_family_not_cessation_2032ac7e(e: Estate, prop: Asset, heir: Individual) kind institutional {
    label en official "renting to a family member on a net cash basis is not a failure to use for the qualified use (section 2032A(c)(7)(E))";
}
rule NetCashRentToFamilyNotCessationRule(e: Estate, prop: Asset, heir: Individual) defeasible {
    when rented_to_family_member_on_net_cash_basis(e, prop, heir);
    when heir_is_surviving_spouse_or_lineal_descendant_of_decedent(heir, e);
    then net_cash_rent_to_family_not_cessation_2032ac7e(e, prop, heir);
}
pub relation qualified_conservation_contribution_by_heir(e: Estate, prop: Asset, heir: Individual, on: Date) kind empirical {
    label en unofficial "a qualified conservation contribution (section 170(h)) by gift or otherwise of an interest in the property, made by the heir on the stated date";
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "A qualified conservation contribution (as defined in section 170(h)) by gift or otherwise shall not be deemed a disposition under subsection (c)(1)(A).")
pub relation qualified_conservation_contribution_2032ac8(e: Estate, prop: Asset, heir: Individual, on: Date) kind institutional {
    label en official "a qualified conservation contribution is not a disposition for recapture (section 2032A(c)(8))";
}
rule QualifiedConservationContributionRule(e: Estate, prop: Asset, heir: Individual, on: Date) defeasible {
    when qualified_conservation_contribution_by_heir(e, prop, heir, on);
    then qualified_conservation_contribution_2032ac8(e, prop, heir, on);
}

// =====================================================================
// (c)(6)(B), (c)(7)(B)-(D): cessation by lack of material participation
// =====================================================================

pub relation no_material_participation_years_in_window(e: Estate, prop: Asset, heir: Individual, window_end: Date, years: Decimal) kind empirical {
    label en unofficial "within an 8-year period ending after the decedent's death and before the heir's death, ending on the stated date, the periods aggregating this many years with no material participation by the decedent, the heir or a member of their family (section 2032A(c)(6)(B))";
}
pub relation active_management_years_by_eligible_heir(e: Estate, prop: Asset, heir: Individual, window_end: Date, years: Decimal) kind empirical {
    label en unofficial "of those years, the periods in which an eligible qualified heir, or the fiduciary of one, actively managed the farm or business (section 2032A(c)(7)(B)); only periods during which the heir meets the eligibility requirement";
}
pub relation heir_date_of_birth_2032a(heir: Individual, born: Date) kind empirical {
    label en unofficial "the date of birth of the qualified heir";
}
pub relation heir_is_disabled_2032ab4b(heir: Individual) kind empirical {
    label en unofficial "the heir has a mental or physical impairment which renders him unable to materially participate in the operation of the farm or other business (section 2032A(b)(4)(B), by (c)(7)(C)(iii))";
}
pub relation heir_is_student_152f2(heir: Individual) kind empirical {
    label en unofficial "the heir is a student within the meaning of section 152(f)(2) for the calendar year (section 2032A(c)(7)(D)); section 152 is owned by us.irc.gross_income";
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "the term \"eligible qualified heir\" means a qualified heir who")
pub relation eligible_qualified_heir_2032ac7c(heir: Individual, e: Estate, asof: Date) kind institutional {
    label en official "an eligible qualified heir on the date: the surviving spouse of the decedent, under 21, disabled, or a student (section 2032A(c)(7)(C))";
}
rule EligibleQualifiedHeirSpouseRule(heir: Individual, e: Estate, asof: Date) defeasible {
    when surviving_spouse_of(e, heir);
    when no_material_participation_years_in_window(e, _, heir, asof, _);
    then eligible_qualified_heir_2032ac7c(heir, e, asof);
}
rule EligibleQualifiedHeirUnder21Rule(heir: Individual, e: Estate, asof: Date, born: Date) defeasible {
    when qualified_heir(heir, _, e);
    when no_material_participation_years_in_window(e, _, heir, asof, _);
    when heir_date_of_birth_2032a(heir, born) and asof < add_calendar_period(born, 21 calendar_year);
    then eligible_qualified_heir_2032ac7c(heir, e, asof);
}
rule EligibleQualifiedHeirDisabledRule(heir: Individual, e: Estate, asof: Date) defeasible {
    when qualified_heir(heir, _, e);
    when no_material_participation_years_in_window(e, _, heir, asof, _);
    when heir_is_disabled_2032ab4b(heir);
    then eligible_qualified_heir_2032ac7c(heir, e, asof);
}
rule EligibleQualifiedHeirStudentRule(heir: Individual, e: Estate, asof: Date) defeasible {
    when qualified_heir(heir, _, e);
    when no_material_participation_years_in_window(e, _, heir, asof, _);
    when heir_is_student_152f2(heir);
    then eligible_qualified_heir_2032ac7c(heir, e, asof);
}
pub relation effective_no_participation_years(e: Estate, prop: Asset, heir: Individual, window_end: Date, years: Decimal) kind institutional {
    label en official "the years without material participation, less the years of active management by an eligible qualified heir, which count as material participation (section 2032A(c)(6)(B), (7)(B))";
}
rule EffectiveNoParticipationYearsRule(e: Estate, prop: Asset, heir: Individual, end: Date, raw: Decimal) defeasible {
    when no_material_participation_years_in_window(e, prop, heir, end, raw);
    when eligible_qualified_heir_2032ac7c(heir, e, end);
    when active_management_years_by_eligible_heir(e, prop, heir, end, _);
    then effective_no_participation_years(e, prop, heir, end, max(0.0, raw - sum(collect all a: Decimal where active_management_years_by_eligible_heir(e, prop, heir, end, a), empty: 0.0)));
}
rule EffectiveNoParticipationYearsIneligibleRule(e: Estate, prop: Asset, heir: Individual, end: Date, raw: Decimal) defeasible {
    when no_material_participation_years_in_window(e, prop, heir, end, raw);
    when not_known(eligible_qualified_heir_2032ac7c(heir, e, end));
    then effective_no_participation_years(e, prop, heir, end, raw);
}
rule EffectiveNoParticipationYearsNoManagementRule(e: Estate, prop: Asset, heir: Individual, end: Date, raw: Decimal) defeasible {
    when no_material_participation_years_in_window(e, prop, heir, end, raw);
    when eligible_qualified_heir_2032ac7c(heir, e, end);
    when not_known(active_management_recorded_2032a(e, prop, heir, end));
    then effective_no_participation_years(e, prop, heir, end, raw);
}
relation active_management_recorded_2032a(e: Estate, prop: Asset, heir: Individual, end: Date) kind institutional;
rule ActiveManagementRecordedRule(e: Estate, prop: Asset, heir: Individual, end: Date) defeasible {
    when active_management_years_by_eligible_heir(e, prop, heir, end, _);
    then active_management_recorded_2032a(e, prop, heir, end);
}
@source(IRC_S2032A_C, relation = formalizes, coverage = exact, quote = "during any period of 8 years ending after the date of the decedent's death and before the date of the death of the qualified heir, there had been periods aggregating more than 3 years during which")
rule CessationByNonParticipationRule(e: Estate, prop: Asset, heir: Individual, end: Date, years: Decimal, dod: Date) defeasible {
    label en official "real property ceases to be used for the qualified use if, in an 8-year period ending after death and before the heir's death, periods aggregating more than 3 years had no material participation (section 2032A(c)(6)(B))";
    when effective_no_participation_years(e, prop, heir, end, years) and years > 3.0;
    when date_of_death(e, dod) and end > dod;
    when not_known(heir_death_recorded_2032a(heir));
    then disposition_or_cessation_event(e, prop, heir, end);
}
rule CessationByNonParticipationHeirDeathRule(e: Estate, prop: Asset, heir: Individual, end: Date, years: Decimal, dod: Date, died: Date) defeasible {
    when effective_no_participation_years(e, prop, heir, end, years) and years > 3.0;
    when date_of_death(e, dod) and end > dod;
    when qualified_heir_death_date(heir, died) and end < died;
    then disposition_or_cessation_event(e, prop, heir, end);
}

// =====================================================================
// (b)(4), (b)(5): retired or disabled decedents; surviving spouses
// =====================================================================

pub relation decedent_material_participation_not_met_at_death(e: Estate, prop: Asset) kind empirical {
    label en unofficial "on the date of death the requirements of paragraph (1)(C)(ii) with respect to the decedent are not met for the property (section 2032A(b)(4)(A))";
}
pub relation decedent_old_age_benefit_period_began(e: Estate, d: Date) kind empirical {
    label en unofficial "the continuous period, ending on the date of death, during which the decedent was receiving old-age benefits under title II of the Social Security Act began on the stated date";
}
pub relation decedent_disabled_period_began(e: Estate, d: Date) kind empirical {
    label en unofficial "the continuous period, ending on the date of death, during which the decedent was disabled (a mental or physical impairment rendering him unable to materially participate, section 2032A(b)(4)(B)) began on the stated date";
}
relation continuous_period_start_candidate(e: Estate, d: Date) kind institutional;
rule ContinuousPeriodStartOldAgeRule(e: Estate, d: Date) defeasible {
    when decedent_old_age_benefit_period_began(e, d);
    then continuous_period_start_candidate(e, d);
}
rule ContinuousPeriodStartDisabledRule(e: Estate, d: Date) defeasible {
    when decedent_disabled_period_began(e, d);
    then continuous_period_start_candidate(e, d);
}
relation earlier_continuous_period_start_exists(e: Estate, d: Date) kind institutional;
rule EarlierContinuousPeriodStartExistsRule(e: Estate, d: Date, d2: Date) defeasible {
    when continuous_period_start_candidate(e, d);
    when continuous_period_start_candidate(e, d2) and d2 < d;
    then earlier_continuous_period_start_exists(e, d);
}
@source(IRC_S2032A_B, relation = formalizes, coverage = exact, quote = "then paragraph (1)(C)(ii) shall be applied with respect to such property by substituting \"the date on which the longer of such continuous periods began\" for \"the date of the decedent's death\" in paragraph (1)(C)")
pub relation substituted_reference_date_2032ab4(e: Estate, d: Date) kind institutional {
    label en official "the date on which the longer of the continuous periods began: it replaces the date of death as the end of the 8-year period of subparagraph (C) (section 2032A(b)(4)(A))";
}
rule SubstitutedReferenceDateRule(e: Estate, d: Date) defeasible {
    when continuous_period_start_candidate(e, d);
    unless earlier_continuous_period_start_exists(e, d);
    then substituted_reference_date_2032ab4(e, d);
}
relation retired_or_disabled_substitution_applies_2032ab4(e: Estate, prop: Asset) kind institutional;
rule RetiredOrDisabledSubstitutionAppliesRule(e: Estate, prop: Asset, d: Date) defeasible {
    when decedent_material_participation_not_met_at_death(e, prop);
    when substituted_reference_date_2032ab4(e, d);
    then retired_or_disabled_substitution_applies_2032ab4(e, prop);
}
pub relation ownership_use_participation_years_before_substituted_date(e: Estate, prop: Asset, years: Decimal) kind empirical {
    label en unofficial "the years, of the 8-year period ending on the substituted date, in which the property was owned and used for a qualified use with material participation (section 2032A(b)(1)(C), (b)(4)(A))";
}
rule MeetsFiveOfEightYearTestSubstitutedRule(prop: Asset, e: Estate, years: Decimal) defeasible {
    label en official "the 5-of-8-year test with the period ending on the substituted date (section 2032A(b)(4)(A))";
    when retired_or_disabled_substitution_applies_2032ab4(e, prop);
    when ownership_use_participation_years_before_substituted_date(e, prop, years) and years >= 5.0;
    then meets_five_of_eight_year_test(prop, e);
}
@source(IRC_S2032A_B, relation = formalizes, coverage = exact, quote = "the period ending on the date on which the continuous period taken into account under subparagraph (A) began shall be treated as the period immediately before the decedent's death")
pub relation recapture_reference_period_end_2032ab4c(e: Estate, d: Date) kind institutional {
    label en official "for the recapture test of (c)(6)(B)(i) the period ending on the substituted date is the period immediately before the decedent's death (section 2032A(b)(4)(C))";
}
rule RecaptureReferencePeriodEndRule(e: Estate, d: Date) defeasible {
    when substituted_reference_date_2032ab4(e, d);
    then recapture_reference_period_end_2032ab4c(e, d);
}
// (b)(5): a surviving spouse's active management is material participation
pub relation first_decedent_qualified_real_property_disregarding_D_and_election(first_estate: Estate, prop: Asset) kind empirical {
    label en unofficial "the property is qualified real property with respect to the first decedent, determined without regard to subparagraph (D) of paragraph (1) and without regard to whether an election was made (section 2032A(b)(5)(B))";
}
pub relation property_passed_from_first_decedent_to_surviving_spouse(first_estate: Estate, prop: Asset, spouse: Individual) kind empirical {
    label en unofficial "the property was acquired from or passed from the first decedent to the surviving spouse";
}
pub relation spouse_makes_management_decisions_other_than_daily(spouse: Individual, prop: Asset) kind empirical {
    label en unofficial "the person makes the management decisions of the business, other than the daily operating decisions (active management, section 2032A(e)(12))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "The term \"active management\" means the making of the management decisions of a business (other than the daily operating decisions).")
pub relation active_management_2032ae12(p: Individual, prop: Asset) kind institutional {
    label en official "active management: making the management decisions of the business, other than the daily operating decisions (section 2032A(e)(12))";
}
rule ActiveManagement2032ae12Rule(p: Individual, prop: Asset) defeasible {
    when spouse_makes_management_decisions_other_than_daily(p, prop);
    then active_management_2032ae12(p, prop);
}
@source(IRC_S2032A_B, relation = formalizes, coverage = exact, quote = "active management of the farm or other business by the surviving spouse shall be treated as material participation by such surviving spouse in the operation of such farm or business")
pub relation surviving_spouse_active_management_is_participation_2032ab5(spouse: Individual, prop: Asset) kind institutional {
    label en official "in the estate of the surviving spouse, active management by the spouse of property that was qualified real property in the first decedent's estate counts as material participation (section 2032A(b)(5)(A))";
}
rule SurvivingSpouseActiveManagementIsParticipationRule(spouse: Individual, prop: Asset, first_estate: Estate) defeasible {
    when first_decedent_qualified_real_property_disregarding_D_and_election(first_estate, prop);
    when property_passed_from_first_decedent_to_surviving_spouse(first_estate, prop, spouse);
    when active_management_2032ae12(spouse, prop);
    then surviving_spouse_active_management_is_participation_2032ab5(spouse, prop);
}
pub relation years_owned_used_with_participation_or_spouse_management(e: Estate, prop: Asset, years: Decimal) kind empirical {
    label en unofficial "the years, of the 8-year period ending on the date of death, in which the property was owned and used for a qualified use with material participation or, for the estate of a surviving spouse, active management (section 2032A(b)(5)(A), (C))";
}
rule MeetsFiveOfEightYearTestSpouseManagementRule(prop: Asset, e: Estate, spouse: Individual, years: Decimal) defeasible {
    label en official "the 5-of-8-year test in the estate of a surviving spouse, counting the spouse's active management as material participation (section 2032A(b)(5)(A))";
    when decedent_individual(e, spouse);
    when surviving_spouse_active_management_is_participation_2032ab5(spouse, prop);
    when years_owned_used_with_participation_or_spouse_management(e, prop, years) and years >= 5.0;
    then meets_five_of_eight_year_test(prop, e);
}

// =====================================================================
// (d): election and agreement
// =====================================================================

pub relation executor_revokes_2032a_election(e: Estate, x: Person) kind empirical {
    label en unofficial "the executor purports to revoke the section 2032A election";
}
@source(IRC_S2032A_D, relation = formalizes, coverage = exact, quote = "Such an election, once made, shall be irrevocable.")
rule SpecialUseValuationElectionIrrevocableRule(e: Estate, x: Person, w: Interval<Instant>) defeasible {
    label en official "an election under section 2032A, once made, shall be irrevocable: the executor may not revoke it (section 2032A(d)(1))";
    when executor_of(e, x, w);
    when special_use_valuation_election_valid(e);
    then prohibition SpecialUseValuationElectionRevocationProhibition {
        bearer x;
        beneficiary Secretary;
        action executor_revokes_2032a_election(e, x);
        window w;
    };
}
pub relation election_defect_notified_on(e: Estate, d: Date) kind empirical {
    label en unofficial "the Secretary notifies the executor that the notice of election does not contain all required information, or that signatures of persons required to enter the agreement are missing, or the agreement lacks required information (section 2032A(d)(3)(A)-(B)); the election and agreement were submitted within the time prescribed";
}
pub relation election_defect_cured_on(e: Estate, d: Date) kind empirical {
    label en unofficial "the executor provides the missing information or signatures on the stated date";
}
pub relation executor_cures_election_defect(e: Estate, x: Person) kind empirical {
    label en unofficial "the executor provides the missing information or signatures";
}
@source(IRC_S2032A_D, relation = formalizes, coverage = exact, quote = "the executor will have a reasonable period of time (not exceeding 90 days) after notification of such failures to provide such information or signatures")
rule ExecutorMayCureElectionDefectRule(e: Estate, x: Person, notified: Date) defeasible {
    label en official "the executor has a period of at most 90 days after notice of a defect to cure it (section 2032A(d)(3)); the regulation may set a shorter reasonable period, the statute's ceiling is applied";
    when executor_of(e, x, _);
    when election_defect_notified_on(e, notified);
    then liberty ExecutorMayCureElectionDefect {
        holder x;
        against Secretary;
        action executor_cures_election_defect(e, x);
        window [notified, add_calendar_period(notified, 90 calendar_day)];
    };
}
relation election_defect_timely_cured(e: Estate) kind institutional;
rule ElectionDefectTimelyCuredRule(e: Estate, notified: Date, cured: Date) defeasible {
    when election_defect_notified_on(e, notified);
    when election_defect_cured_on(e, cured) and cured <= add_calendar_period(notified, 90 calendar_day);
    then election_defect_timely_cured(e);
}
rule SpecialUseValuationElectionValidAfterCureRule(e: Estate, x: Person, w: Interval<Instant>) defeasible {
    label en official "an election submitted in time whose defect is cured within the period is valid (section 2032A(d)(3))";
    when executor_of(e, x, w);
    when special_use_valuation_election_made(e, x, w);
    when election_defect_timely_cured(e);
    then special_use_valuation_election_valid(e);
}

// =====================================================================
// (e)(3)-(5), (7), (9), (11)-(14)
// =====================================================================

pub relation improvement_on_real_property_meeting_5_of_8(e: Estate, prop: Asset, improvement: Asset) kind empirical {
    label en unofficial "a residential building or related improvement occupied on a regular basis by the owner or lessee or persons employed to operate or maintain the property, or a road, building or other structure or improvement functionally related to the qualified use, on real property meeting subsection (b)(1)(C) (section 2032A(e)(3))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "shall be treated as real property devoted to the qualified use")
pub relation improvement_treated_as_qualified_use_2032ae3(e: Estate, improvement: Asset) kind institutional {
    label en official "such improvements are treated as real property devoted to the qualified use (section 2032A(e)(3))";
}
rule ImprovementTreatedAsQualifiedUseRule(e: Estate, prop: Asset, improvement: Asset) defeasible {
    when improvement_on_real_property_meeting_5_of_8(e, prop, improvement);
    when meets_five_of_eight_year_test(prop, e);
    then improvement_treated_as_qualified_use_2032ae3(e, improvement);
}
rule HasQualifiedUseByImprovementRule(e: Estate, improvement: Asset) defeasible {
    when improvement_treated_as_qualified_use_2032ae3(e, improvement);
    then has_qualified_use(improvement, e);
}
pub enum FarmKind {
    StockFarm; DairyFarm; PoultryFarm; FruitFarm; FurbearingAnimalFarm; TruckFarm;
    Plantation; Ranch; Nursery; Range; GreenhouseOrSimilar; Orchard; Woodland;
    OtherKindOfFarm;
}
pub relation property_kind_of_farm(prop: Asset, kind: FarmKind) kind empirical {
    label en unofficial "the property is a farm of the stated kind, including greenhouses or similar structures used primarily for raising agricultural or horticultural commodities (section 2032A(e)(4))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = partial, quote = "The term \"farm\" includes stock, dairy, poultry, fruit, furbearing animal, and truck farms, plantations, ranches, nurseries, ranges, greenhouses or other similar structures used primarily for the raising of agricultural or horticultural commodities, and orchards and woodlands.")
pub relation is_farm_2032ae4(prop: Asset) kind institutional {
    label en official "the property is a farm within section 2032A(e)(4)";
}
rule IsFarmRule(prop: Asset, kind: FarmKind) defeasible {
    when property_kind_of_farm(prop, kind) and kind != OtherKindOfFarm;
    then is_farm_2032ae4(prop);
}
pub relation activity_cultivating_soil_or_raising_commodity_on_farm(prop: Asset) kind empirical {
    label en unofficial "cultivating the soil or raising or harvesting any agricultural or horticultural commodity, including raising, shearing, feeding, caring for, training and managing animals, on a farm (section 2032A(e)(5)(A))";
}
pub relation activity_handling_or_storing_commodity_on_farm(prop: Asset) kind empirical {
    label en unofficial "handling, drying, packing, grading or storing on a farm an agricultural or horticultural commodity in its unmanufactured state (section 2032A(e)(5)(B))";
}
pub relation operator_regularly_produces_more_than_half_of_treated_commodity(prop: Asset) kind empirical {
    label en unofficial "the owner, tenant or operator of the farm regularly produces more than one-half of the commodity so treated";
}
pub relation activity_timber_operations(prop: Asset) kind empirical {
    label en unofficial "the planting, cultivating, caring for or cutting of trees, or the preparation (other than milling) of trees for market (section 2032A(e)(5)(C))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "The term \"farming purposes\" means")
pub relation farming_purposes_2032ae5(prop: Asset) kind institutional {
    label en official "the activity on the property is for farming purposes (section 2032A(e)(5))";
}
rule FarmingPurposesCultivationRule(prop: Asset) defeasible {
    when activity_cultivating_soil_or_raising_commodity_on_farm(prop);
    when is_farm_2032ae4(prop);
    then farming_purposes_2032ae5(prop);
}
rule FarmingPurposesHandlingRule(prop: Asset) defeasible {
    when activity_handling_or_storing_commodity_on_farm(prop);
    when operator_regularly_produces_more_than_half_of_treated_commodity(prop);
    when is_farm_2032ae4(prop);
    then farming_purposes_2032ae5(prop);
}
rule FarmingPurposesTimberRule(prop: Asset) defeasible {
    when activity_timber_operations(prop);
    then farming_purposes_2032ae5(prop);
}
// (7): the farm formula
pub relation average_annual_gross_cash_rental_comparable_land(e: Estate, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the average annual gross cash rental for comparable land used for farming purposes and located in the locality of the farm, over the 5 most recent calendar years ending before the date of death (section 2032A(e)(7)(A))";
}
pub relation average_annual_net_share_rental_comparable_land(e: Estate, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the average annual net share rental of comparable land: the value of the produce received by the lessor less the cash operating expenses paid by the lessor under the lease (section 2032A(e)(7)(B)(ii))";
}
pub relation average_annual_real_estate_taxes_comparable_land(e: Estate, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the average annual State and local real estate taxes for the comparable land";
}
pub relation average_annual_effective_federal_land_bank_rate(e: Estate, prop: Asset, rate: Decimal) kind empirical {
    label en unofficial "the average annual effective interest rate for all new Federal Land Bank loans, over the same 5 calendar years";
}
pub relation no_comparable_land_for_gross_cash_rental(e: Estate, prop: Asset) kind empirical {
    label en unofficial "it is established that there is no comparable land from which the average annual gross cash rental may be determined";
}
pub relation executor_elects_no_formula_valuation(e: Estate, prop: Asset) kind empirical {
    label en unofficial "the executor elects to have the value of the farm for farming purposes determined under paragraph (8), there being no comparable land from which the average net share rental may be determined (section 2032A(e)(7)(C)(ii))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "the value of a farm for farming purposes shall be determined by dividing")
pub relation farm_value_by_formula_2032ae7(e: Estate, prop: Asset, value: Money) kind institutional {
    label en official "the value of a farm for farming purposes: the excess of the average annual gross cash rental (or, where there is none, the net share rental) over the average annual real estate taxes, divided by the average annual effective Federal Land Bank interest rate (section 2032A(e)(7)(A)-(B))";
}
rule FarmValueByCashRentalFormulaRule(e: Estate, prop: Asset, rent: Money, taxes: Money, rate: Decimal) defeasible {
    when farming_purposes_2032ae5(prop);
    when average_annual_gross_cash_rental_comparable_land(e, prop, rent);
    when average_annual_real_estate_taxes_comparable_land(e, prop, taxes);
    when average_annual_effective_federal_land_bank_rate(e, prop, rate) and rate > 0.0;
    when not_known(no_comparable_land_for_gross_cash_rental(e, prop));
    then farm_value_by_formula_2032ae7(e, prop, div_round(max(0.00 USD, rent - taxes), rate, 2, "HALF_UP"));
}
rule FarmValueByNetShareRentalFormulaRule(e: Estate, prop: Asset, share_rent: Money, taxes: Money, rate: Decimal) defeasible {
    label en official "where there is no comparable land with a gross cash rental but there is with a net share rental, the net share rental is substituted (section 2032A(e)(7)(B)(i))";
    when farming_purposes_2032ae5(prop);
    when no_comparable_land_for_gross_cash_rental(e, prop);
    when average_annual_net_share_rental_comparable_land(e, prop, share_rent);
    when average_annual_real_estate_taxes_comparable_land(e, prop, taxes);
    when average_annual_effective_federal_land_bank_rate(e, prop, rate) and rate > 0.0;
    then farm_value_by_formula_2032ae7(e, prop, div_round(max(0.00 USD, share_rent - taxes), rate, 2, "HALF_UP"));
}
rule QualifiedRealPropertyValueForUseByFormulaRule(e: Estate, prop: Asset, value: Money) defeasible {
    label en official "a farm's value for the qualified use is the section 2032A(e)(7) formula value where the formula applies (section 2032A(a)(1)(A), (e)(7))";
    when farm_value_by_formula_2032ae7(e, prop, value);
    then qualified_real_property_value_for_use(e, prop, value);
}
// (9): property acquired from the decedent
pub relation considered_acquired_from_decedent_under_1014b(e: Estate, prop: Asset, person: Individual) kind empirical {
    label en unofficial "the property is considered acquired from or to have passed from the decedent under section 1014(b) (section 2032A(e)(9)(A)); section 1014 is owned by us.irc.property_transactions";
}
pub relation property_acquired_by_person_from_estate(e: Estate, prop: Asset, person: Individual) kind empirical {
    label en unofficial "the property is acquired by the person from the estate (section 2032A(e)(9)(B))";
}
pub relation property_acquired_by_person_from_trust_includible_in_gross_estate(e: Estate, prop: Asset, person: Individual) kind empirical {
    label en unofficial "the property is acquired by the person from a trust, to the extent it is includible in the gross estate of the decedent (section 2032A(e)(9)(C))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "Property shall be considered to have been acquired from or to have passed from the decedent if")
pub relation property_passed_from_decedent_2032ae9(e: Estate, prop: Asset, person: Individual) kind institutional {
    label en official "the property is considered acquired from or passed from the decedent: under section 1014(b), from the estate, or from a trust to the extent includible in the gross estate (section 2032A(e)(9))";
}
rule PropertyPassedFromDecedent1014bRule(e: Estate, prop: Asset, person: Individual) defeasible {
    when considered_acquired_from_decedent_under_1014b(e, prop, person);
    then property_passed_from_decedent_2032ae9(e, prop, person);
}
rule PropertyPassedFromDecedentEstateRule(e: Estate, prop: Asset, person: Individual) defeasible {
    when property_acquired_by_person_from_estate(e, prop, person);
    then property_passed_from_decedent_2032ae9(e, prop, person);
}
rule PropertyPassedFromDecedentTrustRule(e: Estate, prop: Asset, person: Individual) defeasible {
    when property_acquired_by_person_from_trust_includible_in_gross_estate(e, prop, person);
    then property_passed_from_decedent_2032ae9(e, prop, person);
}
// (11): bond in lieu of personal liability
pub relation heir_application_for_maximum_additional_tax(e: Estate, prop: Asset, heir: Individual, on: Date) kind empirical {
    label en unofficial "the qualified heir makes written application to the Secretary for determination of the maximum additional tax that may be imposed by subsection (c) with respect to the heir's interest (section 2032A(e)(11))";
}
pub relation secretary_notified_heir_of_maximum_additional_tax(e: Estate, prop: Asset, heir: Individual) kind empirical {
    label en unofficial "the Secretary notified the heir of the maximum amount";
}
pub relation heir_furnishes_bond_in_maximum_amount(e: Estate, prop: Asset, heir: Individual) kind empirical {
    label en unofficial "the qualified heir furnishes a bond in the amount and for the period required";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "the Secretary (as soon as possible, and in any event within 1 year after the making of such application) shall notify the heir of such maximum amount")
rule SecretaryNotifyMaximumAdditionalTaxDutyRule(e: Estate, prop: Asset, heir: Individual, on: Date) defeasible {
    label en official "the Secretary shall notify the heir of the maximum additional tax within 1 year of the application (section 2032A(e)(11))";
    when heir_application_for_maximum_additional_tax(e, prop, heir, on);
    then duty SecretaryNotifyMaximumAdditionalTaxDuty {
        bearer Secretary;
        beneficiary heir;
        achieve secretary_notified_heir_of_maximum_additional_tax(e, prop, heir) during [on, add_calendar_period(on, 1 calendar_year)];
    };
}
pub relation heir_discharged_from_2032a_personal_liability(e: Estate, prop: Asset, heir: Individual) kind institutional {
    label en official "the heir, on furnishing the bond, is discharged from personal liability for the additional tax and is entitled to a receipt (section 2032A(e)(11), (c)(5))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "The qualified heir, on furnishing a bond in such amount and for such period as may be required, shall be discharged from personal liability for any additional tax imposed by subsection (c)")
rule HeirDischargeByBondPower(e: Estate, prop: Asset, heir: Individual, on: Date) strict {
    label en official "the qualified heir who furnishes the required bond is discharged from personal liability (section 2032A(e)(11))";
    when heir_application_for_maximum_additional_tax(e, prop, heir, on);
    when heir_furnishes_bond_in_maximum_amount(e, prop, heir);
    then power HeirDischargeByBond {
        holder heir;
        over prop;
        exercise heir_furnishes_bond_in_maximum_amount(e, prop, heir);
        valid_when secretary_notified_heir_of_maximum_additional_tax(e, prop, heir);
        effect create(heir_discharged_from_2032a_personal_liability(e, prop, heir));
        window [on, infinity);
    };
}
// (13): woodlands
pub relation woodland_used_in_timber_operations(prop: Asset) kind empirical {
    label en unofficial "the real property is used in timber operations (section 2032A(e)(13)(B)(i))";
}
pub relation woodland_identifiable_area_with_records(prop: Asset) kind empirical {
    label en unofficial "the property is an identifiable area of land, such as an acre or other area for which records are normally maintained in conducting timber operations (section 2032A(e)(13)(B)(ii))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "The term \"qualified woodland\" means any real property which")
pub relation qualified_woodland_2032ae13b(prop: Asset) kind institutional {
    label en official "qualified woodland: real property used in timber operations, an identifiable area with records (section 2032A(e)(13)(B))";
}
rule QualifiedWoodlandRule(prop: Asset) defeasible {
    when woodland_used_in_timber_operations(prop);
    when woodland_identifiable_area_with_records(prop);
    then qualified_woodland_2032ae13b(prop);
}
pub relation woodland_election_made_on_return(e: Estate, prop: Asset, x: Person, w: Interval<Instant>) kind empirical {
    label en unofficial "the executor elects, on the return of the tax imposed by section 2001, that trees growing on the qualified woodland not be treated as a crop";
}
pub relation woodland_election_effective(e: Estate, prop: Asset) kind institutional {
    label en official "trees growing on the qualified woodland are not treated as a crop (section 2032A(e)(13)(A))";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "In the case of any qualified woodland with respect to which the executor elects to have this subparagraph apply, trees growing on such woodland shall not be treated as a crop.")
rule WoodlandElectionPower(e: Estate, prop: Asset, x: Person, w: Interval<Instant>) strict {
    label en official "the executor may elect that trees on a qualified woodland not be treated as a crop; irrevocable once made (section 2032A(e)(13)(A), (D))";
    when executor_of(e, x, w);
    when woodland_election_made_on_return(e, prop, x, w);
    then power WoodlandElection {
        holder x;
        over prop;
        exercise woodland_election_made_on_return(e, prop, x, w);
        valid_when qualified_woodland_2032ae13b(prop);
        effect create(woodland_election_effective(e, prop));
        window w;
    };
}
// (14): replacement property
pub relation replacement_property_for_2032a(e: Estate, replacement: Asset, replaced: Asset) kind empirical {
    label en unofficial "the replacement is real property acquired in a section 1031 exchange or whose acquisition results in nonrecognition of gain under section 1033, used for the same qualified use as the replaced property was (section 2032A(e)(14)(C))";
}
pub relation replacement_fair_market_value_at_acquisition(e: Estate, replacement: Asset, value: Money) kind empirical {
    label en unofficial "the fair market value of the qualified replacement property as of the date of its acquisition";
}
pub relation replaced_fair_market_value_at_disposition(e: Estate, replaced: Asset, value: Money) kind empirical {
    label en unofficial "the fair market value of the replaced property as of the date of its disposition";
}
pub relation replaced_property_years(e: Estate, replaced: Asset, years: Decimal) kind empirical {
    label en unofficial "the years of ownership, qualified use and material participation with respect to the replaced property by the decedent or a member of his family";
}
@source(IRC_S2032A_E, relation = formalizes, coverage = exact, quote = "any period during which there was ownership, qualified use, or material participation with respect to the replaced property by the decedent or any member of his family shall be treated as a period during which there was such ownership, use, or material participation")
pub relation replacement_property_years_credited_2032ae14(e: Estate, replacement: Asset, years: Decimal) kind institutional {
    label en official "the periods of the replaced property count for the replacement, to the extent the replacement's value at acquisition does not exceed the replaced property's at disposition (section 2032A(e)(14)(A)-(B))";
}
rule ReplacementPropertyYearsCreditedRule(e: Estate, replacement: Asset, replaced: Asset, years: Decimal, new_value: Money, old_value: Money) defeasible {
    when replacement_property_for_2032a(e, replacement, replaced);
    when replaced_property_years(e, replaced, years);
    when replacement_fair_market_value_at_acquisition(e, replacement, new_value);
    when replaced_fair_market_value_at_disposition(e, replaced, old_value) and new_value <= old_value;
    then replacement_property_years_credited_2032ae14(e, replacement, years);
}
rule ReplacementPropertyYearsCreditedProRataRule(e: Estate, replacement: Asset, replaced: Asset, years: Decimal, new_value: Money, old_value: Money) defeasible {
    label en official "to the extent the replacement's value exceeds the replaced property's the credit is limited: the years are reduced in the ratio of the values (section 2032A(e)(14)(B))";
    when replacement_property_for_2032a(e, replacement, replaced);
    when replaced_property_years(e, replaced, years);
    when replacement_fair_market_value_at_acquisition(e, replacement, new_value);
    when replaced_fair_market_value_at_disposition(e, replaced, old_value) and new_value > old_value;
    then replacement_property_years_credited_2032ae14(e, replacement, years * (old_value / new_value));
}

// =====================================================================
// (f), (g): assessment period; interests in entities
// =====================================================================

pub relation secretary_notified_of_disposition_or_cessation_on(e: Estate, prop: Asset, d: Date) kind empirical {
    label en unofficial "the Secretary is notified, in the manner prescribed by regulations, of the disposition or cessation of use, or (for an involuntary conversion or exchange) of the replacement of the converted property or the acquisition of the exchange property, on the stated date";
}
@source(IRC_S2032A_F, relation = formalizes, coverage = exact, quote = "the statutory period for the assessment of any additional tax under subsection (c) attributable to such disposition or cessation shall not expire before the expiration of 3 years from the date the Secretary is notified")
pub relation additional_tax_assessment_period_floor_2032af(e: Estate, prop: Asset, floor_date: Date) kind institutional {
    label en official "the period for assessing the additional tax does not expire before 3 years after the Secretary is notified of the disposition or cessation (or of the replacement or exchange property) (section 2032A(f)(1)); a lower bound, the section 6501 period belongs to us.irc.assessment";
}
rule AdditionalTaxAssessmentPeriodFloorRule(e: Estate, prop: Asset, notified: Date) defeasible {
    when secretary_notified_of_disposition_or_cessation_on(e, prop, notified);
    then additional_tax_assessment_period_floor_2032af(e, prop, add_calendar_period(notified, 3 calendar_year));
}
pub relation secretary_assesses_2032a_additional_tax_on(e: Estate, prop: Asset, heir: Individual, d: Date) kind empirical {
    label en unofficial "the Secretary assesses the additional tax on the stated date";
}
pub relation assessment_within_2032af_period(e: Estate, prop: Asset) kind institutional {
    label en unofficial "the assessment is made before the expiration of the 3-year period of section 2032A(f)";
}
rule AssessmentWithin2032afPeriodRule(e: Estate, prop: Asset, heir: Individual, made: Date, floor_date: Date) defeasible {
    when secretary_assesses_2032a_additional_tax_on(e, prop, heir, made);
    when additional_tax_assessment_period_floor_2032af(e, prop, floor_date) and made <= floor_date;
    then assessment_within_2032af_period(e, prop);
}
pub relation additional_tax_assessed_2032af2(e: Estate, prop: Asset, heir: Individual) kind institutional {
    label en official "the additional tax is assessed within the 3-year period notwithstanding any other law or rule of law that would prevent it (section 2032A(f)(2))";
}
@source(IRC_S2032A_F, relation = formalizes, coverage = exact, quote = "such additional tax may be assessed before the expiration of such 3-year period notwithstanding the provisions of any other law or rule of law which would otherwise prevent such assessment")
rule SecretaryAssessesAdditionalTaxPower(e: Estate, prop: Asset, heir: Individual, made: Date) strict {
    label en official "the Secretary may assess the additional tax within the 3-year period from notification, whatever other law would bar it (section 2032A(f)(2))";
    when secretary_assesses_2032a_additional_tax_on(e, prop, heir, made);
    then power SecretaryAssessesAdditionalTax {
        holder Secretary;
        over heir;
        exercise secretary_assesses_2032a_additional_tax_on(e, prop, heir, made);
        valid_when assessment_within_2032af_period(e, prop);
        effect create(additional_tax_assessed_2032af2(e, prop, heir));
        window [@1976-01-01, infinity);
    };
}
pub relation discretionary_trust_all_beneficiaries_qualified_heirs(t: Trust) kind empirical {
    label en unofficial "the trust is a discretionary trust all the beneficiaries of which are qualified heirs (section 2032A(g))";
}
@source(IRC_S2032A_G, relation = formalizes, coverage = exact, quote = "an interest in a discretionary trust all the beneficiaries of which are qualified heirs shall be treated as a present interest")
pub relation trust_interest_treated_as_present_interest_2032ag(t: Trust) kind institutional {
    label en official "an interest in a discretionary trust all of whose beneficiaries are qualified heirs is a present interest (section 2032A(g)); the regulations for interests in partnerships, corporations and trusts that are closely held businesses (section 6166(b)(1)) are the Secretary's";
}
rule TrustInterestTreatedAsPresentInterestRule(t: Trust) defeasible {
    when discretionary_trust_all_beneficiaries_qualified_heirs(t);
    then trust_interest_treated_as_present_interest_2032ag(t);
}

// =====================================================================
// (h), (i): involuntary conversions and section 1031 exchanges
// =====================================================================

pub relation involuntary_conversion_of_qualified_real_property(e: Estate, prop: Asset, heir: Individual, on: Date) kind empirical {
    label en unofficial "there is a compulsory or involuntary conversion within the meaning of section 1033 of an interest in qualified real property";
}
pub relation amount_realized_on_conversion(e: Estate, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the amount realized on the involuntary conversion";
}
pub relation cost_of_qualified_replacement_property(e: Estate, prop: Asset, cost: Money) kind empirical {
    label en unofficial "the cost of the qualified replacement property: real property into which the qualified real property is converted (1033(a)(1)), or purchased by the heir in the period of section 1033(a)(2)(B), to be used for the qualified use under which the property qualified (section 2032A(h)(3)(B))";
}
pub relation tax_that_would_be_imposed_on_conversion(e: Estate, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the amount of the tax which, but for subsection (h), would have been imposed on the conversion (the additional tax of (c) computed as on a disposition)";
}
@source(IRC_S2032A_H, relation = formalizes, coverage = exact, quote = "no tax shall be imposed by subsection (c) on such conversion if the cost of the qualified replacement property equals or exceeds the amount realized on such conversion")
pub relation conversion_additional_tax_2032ah1(e: Estate, prop: Asset, amount: Money) kind institutional {
    label en official "no additional tax on an involuntary conversion if the replacement's cost equals or exceeds the amount realized; otherwise the tax reduced in the ratio of cost to amount realized (section 2032A(h)(1))";
}
rule ConversionAdditionalTaxFullReplacementRule(e: Estate, prop: Asset, cost: Money, realized: Money) defeasible {
    when involuntary_conversion_of_qualified_real_property(e, prop, _, _);
    when cost_of_qualified_replacement_property(e, prop, cost);
    when amount_realized_on_conversion(e, prop, realized) and cost >= realized;
    then conversion_additional_tax_2032ah1(e, prop, 0.00 USD);
}
rule ConversionAdditionalTaxPartialReplacementRule(e: Estate, prop: Asset, cost: Money, realized: Money, tax: Money) defeasible {
    label en official "the tax is reduced by the amount that bears the same ratio to it as the replacement cost bears to the amount realized (section 2032A(h)(1)(B))";
    when involuntary_conversion_of_qualified_real_property(e, prop, _, _);
    when cost_of_qualified_replacement_property(e, prop, cost);
    when amount_realized_on_conversion(e, prop, realized) and realized > 0.00 USD and cost < realized;
    when tax_that_would_be_imposed_on_conversion(e, prop, tax);
    then conversion_additional_tax_2032ah1(e, prop, tax - div_round(tax * (cost / 1.00 USD), realized / 1.00 USD, 2, "HALF_UP"));
}
rule ConversionAdditionalTaxNoReplacementRule(e: Estate, prop: Asset, tax: Money) defeasible {
    when involuntary_conversion_of_qualified_real_property(e, prop, _, _);
    when not_known(replacement_cost_recorded(e, prop));
    when tax_that_would_be_imposed_on_conversion(e, prop, tax);
    then conversion_additional_tax_2032ah1(e, prop, tax);
}
relation replacement_cost_recorded(e: Estate, prop: Asset) kind institutional;
rule ReplacementCostRecordedRule(e: Estate, prop: Asset) defeasible {
    when cost_of_qualified_replacement_property(e, prop, _);
    then replacement_cost_recorded(e, prop);
}
pub relation replacement_property_recapture_window_end_2032ah2a(e: Estate, prop: Asset, end: Date) kind empirical {
    label en unofficial "the last day of the 10-year period for the replacement property: the 10 years extended by any period, beyond the 2-year period of section 1033(a)(2)(B)(i), during which the qualified heir was allowed to replace the property (section 2032A(h)(2)(A)); asserted, because the extension is a number of days that add_calendar_period does not take from a variable (TECH-GAPS G3617)";
}

@source(IRC_S2032A_H, relation = formalizes, coverage = exact, quote = "any tax imposed by subsection (c) on the involuntary conversion shall be treated as a tax imposed on a partial disposition")
pub relation conversion_tax_treated_as_partial_disposition_2032ah2b(e: Estate, prop: Asset) kind institutional {
    label en official "the tax on the conversion is treated as a tax on a partial disposition (section 2032A(h)(2)(B)); it enters the prior-tax reduction of (c)(2)(D)(ii)";
}
rule ConversionTaxTreatedAsPartialDispositionRule(e: Estate, prop: Asset, tax: Money) defeasible {
    when conversion_additional_tax_2032ah1(e, prop, tax);
    then conversion_tax_treated_as_partial_disposition_2032ah2b(e, prop);
}
// (i): section 1031 exchanges
pub relation exchange_of_qualified_real_property_under_1031(e: Estate, prop: Asset, heir: Individual, on: Date) kind empirical {
    label en unofficial "an interest in qualified real property is exchanged for an interest in qualified exchange property (and possibly other property) in a transaction that qualifies under section 1031";
}
pub relation exchanged_solely_for_qualified_exchange_property(e: Estate, prop: Asset) kind empirical {
    label en unofficial "the exchange is solely for an interest in qualified exchange property";
}
pub relation fair_market_value_of_exchange_property_at_exchange(e: Estate, prop: Asset, value: Money) kind empirical {
    label en unofficial "the fair market value of the qualified exchange property, determined as of the time of the exchange (section 2032A(i)(1)(B))";
}
pub relation fair_market_value_of_qualified_real_property_exchanged(e: Estate, prop: Asset, value: Money) kind empirical {
    label en unofficial "the fair market value of the qualified real property exchanged, determined as of the time of the exchange";
}
pub relation tax_that_would_be_imposed_on_exchange(e: Estate, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the tax which, but for subparagraph (B), would have been imposed on the exchange under subsection (c)(1)";
}
@source(IRC_S2032A_I, relation = formalizes, coverage = exact, quote = "no tax shall be imposed by subsection (c) by reason of such exchange")
pub relation exchange_additional_tax_2032ai1(e: Estate, prop: Asset, amount: Money) kind institutional {
    label en official "no additional tax on an exchange solely for qualified exchange property; on an exchange with other property the tax is reduced in the ratio of the exchange property's value to the value of the property exchanged (section 2032A(i)(1))";
}
rule ExchangeAdditionalTaxSolelyRule(e: Estate, prop: Asset) defeasible {
    when exchange_of_qualified_real_property_under_1031(e, prop, _, _);
    when exchanged_solely_for_qualified_exchange_property(e, prop);
    then exchange_additional_tax_2032ai1(e, prop, 0.00 USD);
}
rule ExchangeAdditionalTaxWithBootRule(e: Estate, prop: Asset, tax: Money, exchange_value: Money, exchanged_value: Money) defeasible {
    label en official "the tax is reduced by the amount that bears the same ratio to it as the fair market value of the exchange property bears to that of the property exchanged (section 2032A(i)(1)(B))";
    when exchange_of_qualified_real_property_under_1031(e, prop, _, _);
    when not_known(exchanged_solely_for_qualified_exchange_property(e, prop));
    when tax_that_would_be_imposed_on_exchange(e, prop, tax);
    when fair_market_value_of_exchange_property_at_exchange(e, prop, exchange_value);
    when fair_market_value_of_qualified_real_property_exchanged(e, prop, exchanged_value) and exchanged_value > 0.00 USD;
    then exchange_additional_tax_2032ai1(e, prop, tax - div_round(tax * (exchange_value / 1.00 USD), exchanged_value / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S2032A_I, relation = formalizes, coverage = exact, quote = "any tax imposed by subsection (c) by reason of the exchange shall be treated as a tax imposed on a partial disposition")
pub relation exchange_tax_treated_as_partial_disposition_2032ai2b(e: Estate, prop: Asset) kind institutional {
    label en official "the tax on the exchange is treated as a tax on a partial disposition (section 2032A(i)(2)(B))";
}
rule ExchangeTaxTreatedAsPartialDispositionRule(e: Estate, prop: Asset, tax: Money) defeasible {
    when exchange_additional_tax_2032ai1(e, prop, tax);
    then exchange_tax_treated_as_partial_disposition_2032ai2b(e, prop);
}
pub relation exchange_property_used_for_same_qualified_use(e: Estate, prop: Asset) kind empirical {
    label en unofficial "the real property is to be used for the qualified use under which the real property exchanged originally qualified under subsection (a)";
}
@source(IRC_S2032A_I, relation = formalizes, coverage = exact, quote = "the term \"qualified exchange property\" means real property which is to be used for the qualified use set forth in subparagraph (A) or (B) of subsection (b)(2) under which the real property exchanged therefor originally qualified under subsection (a)")
pub relation qualified_exchange_property_2032ai3(e: Estate, prop: Asset) kind institutional {
    label en official "qualified exchange property: real property to be used for the qualified use under which the exchanged property originally qualified (section 2032A(i)(3))";
}
rule QualifiedExchangePropertyRule(e: Estate, prop: Asset) defeasible {
    when exchange_property_used_for_same_qualified_use(e, prop);
    then qualified_exchange_property_2032ai3(e, prop);
}
// (h)(3)(B): the same for conversions
pub relation replacement_property_used_for_same_qualified_use(e: Estate, prop: Asset) kind empirical {
    label en unofficial "the replacement property is to be used for the qualified use under which the qualified real property qualified under subsection (a)";
}
pub relation replacement_is_real_property_converted_or_purchased_in_1033_period(e: Estate, prop: Asset) kind empirical {
    label en unofficial "the real property into which the qualified real property is converted (section 1033(a)(1)), or purchased by the heir in the period of section 1033(a)(2)(B) to replace it";
}
@source(IRC_S2032A_H, relation = formalizes, coverage = exact, quote = "Such term only includes property which is to be used for the qualified use set forth in subparagraph (A) or (B) of subsection (b)(2) under which the qualified real property qualified under subsection (a).")
pub relation qualified_replacement_property_2032ah3b(e: Estate, prop: Asset) kind institutional {
    label en official "qualified replacement property: real property into which the property is converted or purchased in the section 1033 period, to be used for the same qualified use (section 2032A(h)(3)(B))";
}
rule QualifiedReplacementProperty2032ah3bRule(e: Estate, prop: Asset) defeasible {
    when replacement_is_real_property_converted_or_purchased_in_1033_period(e, prop);
    when replacement_property_used_for_same_qualified_use(e, prop);
    then qualified_replacement_property_2032ah3b(e, prop);
}
