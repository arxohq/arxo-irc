// 26 U.S.C. §§2504, 2511(a)-(b), 2514(b),(e), 2516, 2519, 2522(a)-(c) —
// remaining chapter 12 (gift tax) provisions. Stage-2b module of
// `us.irc.estate_gift` (B01/IRC-11).
//
// NOT MODELLED this pass (TECH_GAP/NON_NORMATIVE, TECH-GAPS.md G481):
// §2504(a)-(b),(d) (absorbed as historical/terminology notes — this
// package's own cumulative-gift chain in 05-gift-tax.law already treats
// every period uniformly rather than applying each period's own prior law);
// §2514(a),(c),(d),(f) (pre-1942 transitional rules, the general-power
// definition's ascertainable-standard/joint-power carve-outs, the second-
// power-creation rule, the date-of-creation-by-will rule); §2519(c) (cross-
// reference only); §2522(d)-(f) (the easement/fractional-gift special rules,
// cross-references).
//
// JUDGMENT CALLS:
//  - §2511(a)'s nonresident-donor US-situs limitation reuses this package's
//    §2104/§2105-derived `property_situated_in_us` relation (09-nonresidents-
//    2101-2108.law) — the situs test is the SAME one chapter 11 already
//    uses, per §2511(b)'s own cross-reference to the identical stock/debt
//    categories.
//  - §2522(a)-(c) mirrors §2055(a)/(e)(2)'s split-interest structure almost
//    verbatim; the same `split_interest_qualifies_remainder`/`_guaranteed_
//    or_fixed_percentage` relations (10-charitable-marital-deductions.law)
//    are reused for the gift-tax side rather than duplicated.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    CharitableRecipientKind,
    Estate,
    IRC_S2504_C,
    IRC_S2511_A,
    IRC_S2514_B,
    IRC_S2514_E,
    IRC_S2516,
    IRC_S2519_A,
    IRC_S2522_A,
    IRC_S2522_C,
    Individual,
    TaxableYear,
    charitable_gift_2522,
    charitable_gift_deduction_disallowed_daf_2522c5,
    charitable_gift_deduction_disallowed_fractional_2522e1,
    donor_nonresident_not_citizen_chapter12,
    gift_power_excluded_from_general_2514c,
    gift_to_spouse,
    intangible_gift_by_nonresident_not_taxed_2501a2,
    property_situated_in_us,
    qtip_election_made,
    qtip_gift_election_made,
    separate_properties_art_and_copyright_2522,
    split_interest_qualifies_guaranteed_or_fixed_percentage,
    split_interest_qualifies_remainder,
    taxable_gifts,
};

// =====================================================================
// §2504 — taxable gifts for preceding calendar periods
// =====================================================================

pub relation prior_gift_assessment_period_expired(donor: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the section 6501 period for assessing gift tax on the donor's gifts for calendar period y has expired (section 2504(c)); asserted directly (the assessment-period computation itself is owned by `assessment`, not imported here)";
}
pub relation prior_gift_value_finally_determined(donor: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value finally determined (section 2001(f)(2)) for the donor's taxable gifts of calendar period y (section 2504(c))";
}

@source(IRC_S2504_C, relation = formalizes, coverage = partial, quote = "the value thereof shall, for purposes of computing the tax under this chapter, be the value as finally determined")
pub relation taxable_gift_value_for_cumulative_computation(donor: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 2504(c): once the assessment period has expired for a prior period's gift, its value for computing later years' cumulative tax is locked at the finally-determined figure (NOT yet wired into 05-gift-tax.law's own `cumulative_taxable_gifts_before` chain — TECH-GAPS.md G481)";
}
rule TaxableGiftValueFinallyDeterminedRule(donor: Individual, y: TaxableYear, amount: Money) defeasible {
    when prior_gift_assessment_period_expired(donor, y);
    when prior_gift_value_finally_determined(donor, y, amount);
    then taxable_gift_value_for_cumulative_computation(donor, y, amount);
}
rule TaxableGiftValueOrdinaryRule(donor: Individual, y: TaxableYear, amount: Money) defeasible {
    when taxable_gifts(donor, y, amount);
    when not_known(prior_gift_assessment_period_expired(donor, y));
    then taxable_gift_value_for_cumulative_computation(donor, y, amount);
}

// =====================================================================
// §2511 — transfers in general
// =====================================================================

pub relation gift_donor_nonresident_not_citizen(donor: Individual) kind empirical {
    label en unofficial "the donor is a nonresident not a citizen of the United States (section 2511(a))";
}
pub relation gift_item_situated_in_us(item: Asset) kind institutional {
    label en unofficial "item is situated within the United States for chapter 12 purposes (section 2511(a); the section 2511(b) stock/debt categories reuse the section 2104-derived `property_situated_in_us` classification)";
}
rule GiftItemSitusFromChapter11Rule(item: Asset) defeasible {
    when property_situated_in_us(item);
    then gift_item_situated_in_us(item);
}

@source(IRC_S2511_A, relation = formalizes, coverage = exact, quote = "in the case of a nonresident not a citizen of the United States, shall apply to a transfer only if the property is situated within the United States")
pub relation gift_tax_applies_to_transfer(donor: Individual, item: Asset) kind institutional {
    label en official "section 2511(a): the chapter 12 tax applies to a transfer of item by donor — always for a citizen/resident donor, and only for US-situs property for a nonresident-not-citizen donor";
}
rule GiftTaxAppliesResidentDonorRule(donor: Individual, item: Asset) defeasible {
    when not_known(donor_nonresident_not_citizen_chapter12(donor));
    when gift_to_spouse(donor, _, item, _, _);
    then gift_tax_applies_to_transfer(donor, item);
}
rule GiftTaxAppliesNonresidentDonorUsSitusRule(donor: Individual, item: Asset) defeasible {
    when donor_nonresident_not_citizen_chapter12(donor);
    when gift_item_situated_in_us(item);
    when not_known(intangible_gift_by_nonresident_not_taxed_2501a2(donor, item));
    then gift_tax_applies_to_transfer(donor, item);
}
// Section 2511(b) itself is absorbed into `gift_item_situated_in_us`'s reuse
// of the section 2104 stock/debt situs categories (module header).

// =====================================================================
// §2514 — powers of appointment
// =====================================================================

pub relation general_power_of_appointment(p: Individual, power_id: Integer) kind empirical {
    label en unofficial "power_id is a general power of appointment possessed by p, created after October 21, 1942 (section 2514(b))";
}
pub relation general_power_exercised_or_released(p: Individual, power_id: Integer, on: Date) kind empirical {
    label en unofficial "p exercised or released the general power of appointment (section 2514(b))";
}

@source(IRC_S2514_B, relation = formalizes, coverage = exact, quote = "The exercise or release of a general power of appointment created after October 21, 1942, shall be deemed a transfer of property by the individual possessing such power")
pub relation general_power_exercise_or_release_is_transfer(p: Individual, power_id: Integer, on: Date) kind institutional {
    label en official "section 2514(b): the exercise or release of a post-1942 general power of appointment is deemed a transfer by its possessor";
}
rule GeneralPowerExerciseOrReleaseIsTransferRule(p: Individual, power_id: Integer, on: Date) defeasible {
    when general_power_of_appointment(p, power_id);
    when general_power_exercised_or_released(p, power_id, on);
    when not_known(gift_power_excluded_from_general_2514c(p, power_id));
    then general_power_exercise_or_release_is_transfer(p, power_id, on);
}

pub relation power_lapse(p: Individual, power_id: Integer, y: Integer, appointable_value: Money) kind empirical {
    label en unofficial "the power lapsed during calendar year y, and the value of the property that could have been appointed by its exercise was appointable_value (section 2514(e))";
}
pub relation lapsed_power_assets_aggregate_value(p: Individual, power_id: Integer, y: Integer, amount: Money) kind empirical {
    label en unofficial "the aggregate value of the assets out of which (or the proceeds of which) the lapsed power's exercise could be satisfied (section 2514(e)(2)'s ratio base)";
}

@source(IRC_S2514_E, relation = formalizes, coverage = exact, quote = "The lapse of a power of appointment created after October 21, 1942, during the life of the individual possessing the power shall be considered a release of such power")
pub relation power_lapse_release_amount(p: Individual, power_id: Integer, y: Integer, amount: Money) kind institutional {
    label en official "section 2514(e): the lapse is treated as a release, but only to the extent the appointable value exceeds the greater of $5,000 or 5 percent of the aggregate asset value (the '5-or-5' exception)";
}
rule PowerLapseReleaseAmountRule(p: Individual, power_id: Integer, y: Integer, appointable: Money, assets: Money) defeasible {
    when power_lapse(p, power_id, y, appointable);
    when lapsed_power_assets_aggregate_value(p, power_id, y, assets);
    then power_lapse_release_amount(p, power_id, y, max(0.00 USD, appointable - max(5000.00 USD, round(0.05 * assets, 2, "HALF_UP"))));
}

// =====================================================================
// §2516 — certain property settlements
// =====================================================================

pub relation marital_property_settlement_agreement(husband: Individual, wife: Individual, agreement_on: Date) kind empirical {
    label en unofficial "husband and wife entered into a written agreement relative to their marital and property rights on agreement_on (section 2516)";
}
pub relation marital_property_settlement_divorce(husband: Individual, wife: Individual, divorce_on: Date) kind empirical {
    label en unofficial "husband and wife divorced on divorce_on (section 2516)";
}
pub relation property_settlement_transfer(husband: Individual, wife: Individual, recipient: Individual, item: Asset, purpose: PropertySettlementPurpose) kind empirical {
    label en unofficial "a transfer made pursuant to the agreement, of the stated purpose (section 2516(1)-(2))";
}
pub enum PropertySettlementPurpose {
    SettlementOfMaritalOrPropertyRights;  // (1)
    SupportOfIssueOfMarriageDuringMinority; // (2)
}

@source(IRC_S2516, relation = formalizes, coverage = exact, quote = "shall be deemed to be transfers made for a full and adequate consideration in money or money's worth")
pub relation property_settlement_deemed_full_consideration(husband: Individual, wife: Individual, item: Asset) kind institutional {
    label en official "section 2516: a property-settlement transfer within the exact 3-year divorce window is deemed made for full and adequate consideration (no gift)";
}
rule PropertySettlementDeemedFullConsiderationRule(husband: Individual, wife: Individual, item: Asset, purpose: PropertySettlementPurpose, agreement_on: Date, divorce_on: Date, calendar_before_1: Date) strict {
    when marital_property_settlement_agreement(husband, wife, agreement_on);
    when marital_property_settlement_divorce(husband, wife, divorce_on)
        and divorce_on >= calendar_before_1
        and divorce_on < add_calendar_period(agreement_on, 2 calendar_year);
    when property_settlement_transfer(husband, wife, _, item, purpose)
        and us.irc.core::civil_calendar_boundary_before(agreement_on, 1, us.irc.core::CalendarYear, calendar_before_1);
    then property_settlement_deemed_full_consideration(husband, wife, item);
}

// =====================================================================
// §2519 — dispositions of certain qualifying income interests for life
// =====================================================================

pub relation qtip_property_2519(item: Asset) kind empirical {
    label en unofficial "a section 2056(b)(7) or section 2523(f) deduction was allowed with respect to the transfer of item to the donor of the qualifying income interest (section 2519(b))";
}
pub relation qualifying_income_interest_disposition(p: Individual, item: Asset, on: Date, value_of_remaining_interests: Money) kind empirical {
    label en unofficial "p disposed of all or part of a qualifying income interest for life in item (section 2519(a))";
}

@source(IRC_S2519_A, relation = formalizes, coverage = exact, quote = "any disposition of all or part of a qualifying income interest for life in any property to which this section applies shall be treated as a transfer of all interests in such property other than the qualifying income interest")
pub relation qualifying_income_interest_disposition_is_transfer(p: Individual, item: Asset, on: Date, amount: Money) kind institutional {
    label en official "section 2519(a): the disposition is treated as a transfer of all the OTHER interests in the property (not merely the income interest itself)";
}
rule QualifyingIncomeInterestDispositionIsTransferRule(p: Individual, item: Asset, on: Date, value: Money) defeasible {
    when qtip_property_2519(item);
    when qualifying_income_interest_disposition(p, item, on, value);
    then qualifying_income_interest_disposition_is_transfer(p, item, on, value);
}
rule QtipProperty2519FromEstateElectionRule(item: Asset) defeasible {
    when qtip_election_made(_, item);
    then qtip_property_2519(item);
}
rule QtipProperty2519FromGiftElectionRule(item: Asset) defeasible {
    when qtip_gift_election_made(_, _, item, _);
    then qtip_property_2519(item);
}

// =====================================================================
// §2522(a)-(c) — gift tax charitable deduction
// =====================================================================

pub relation charitable_gift(donor: Individual, y: Integer, item: Asset, kind: CharitableRecipientKind, value: Money) kind empirical {
    label en unofficial "the donor made a gift of item, of the stated section 2522 recipient kind, at the stated value, during calendar year y (section 2522(a)-(b); the (a)/(b) citizen-vs-nonresident-donor distinction is not separately gated — the recipient-kind enum already narrows a nonresident donor's domestic-only categories via the case's own classification choice)";
}
pub relation charitable_gift_split_interest(donor: Individual, item: Asset) kind empirical {
    label en unofficial "an interest in item (other than one described in section 170(f)(3)(B)) is retained by the donor or passes to a non-charitable person/use for less than full consideration (section 2522(c)(2))";
}

@source(IRC_S2522_C, relation = formalizes, coverage = partial, quote = "no deduction shall be allowed under this section for the interest which is, or has been transferred to the person, or for the use, described in subsection (a) or (b)")
pub relation charitable_gift_deduction_disallowed_split_interest(donor: Individual, item: Asset) kind institutional {
    label en official "section 2522(c)(2): the split-interest disallowance, absent a qualifying remainder trust or guaranteed-annuity/fixed-percentage exception (the SAME exception relations as section 2055(e)(2), reused per the module header)";
}
rule CharitableGiftDeductionDisallowedSplitInterestRule(donor: Individual, item: Asset) defeasible {
    when charitable_gift_split_interest(donor, item);
    when not_known(split_interest_qualifies_2522(item));
    when not_known(separate_properties_art_and_copyright_2522(donor, item));
    then charitable_gift_deduction_disallowed_split_interest(donor, item);
}
relation split_interest_qualifies_2522(item: Asset) kind institutional;
rule SplitInterestQualifies2522RemainderRule(item: Asset) defeasible {
    when split_interest_qualifies_remainder(_, item);
    then split_interest_qualifies_2522(item);
}
rule SplitInterestQualifies2522OtherRule(item: Asset) defeasible {
    when split_interest_qualifies_guaranteed_or_fixed_percentage(_, item);
    then split_interest_qualifies_2522(item);
}

@source(IRC_S2522_A, relation = formalizes, coverage = exact, quote = "there shall be allowed as a deduction in the case of a citizen or resident the amount of all gifts made during such year")
pub relation charitable_deduction_2522_item(donor: Individual, y: Integer, item: Asset, amount: Money) kind institutional {
    label en official "the section 2522 charitable deduction allowed for the stated gift item";
}
rule CharitableDeduction2522ItemAllowedRule(donor: Individual, y: Integer, item: Asset, value: Money) defeasible {
    when charitable_gift_2522(donor, y, item, _, value);
    when not_known(charitable_gift_deduction_disallowed_split_interest(donor, item));
    when not_known(charitable_gift_deduction_disallowed_daf_2522c5(donor, item));
    when not_known(charitable_gift_deduction_disallowed_fractional_2522e1(donor, item));
    then charitable_deduction_2522_item(donor, y, item, value);
}

pub relation charitable_deduction_2522(donor: Individual, y: Integer, amount: Money) kind institutional {
    label en official "the total section 2522 gift tax charitable deduction for the donor for calendar year y (section 2522(c)(1)'s section 508(d)/4948(c)(4) bar is NOT separately modelled, module header)";
}
rule CharitableDeduction2522Rule(donor: Individual, y: Integer) defeasible {
    when charitable_deduction_2522_item(donor, y, _, _);
    then charitable_deduction_2522(donor, y, sum all v: Money for item: Asset where charitable_deduction_2522_item(donor, y, item, v));
}
