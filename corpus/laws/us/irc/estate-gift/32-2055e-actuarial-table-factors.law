// Section 2055(e) actuarial values from the section 7520 tables (G4-RMD
// wire, 27.09.2026, implemented_unverified; scenarios written, NOT
// executed; no legal review).
//
// FROM-PACKAGE: `us.cfr.t26_7520_2031` (20.2031-7 Table S, pinned eCFR
// 2026-09-24; factors as `tables/*.lawtable.json`, structural mirrors).
// That package is rule-less by design: the factor enters here as a
// CASE-SELECTED fact (the case asserts the Table S row it reads at the
// valuation's section 7520 rate), and the rule below computes the
// qualified interest's actuarial value as principal x factor instead of
// asserting the value directly (module 19 keeps the direct assertion as
// the fallback where no table row is selected). Only key literals are
// modelled (Table S remainder factor); the rate itself stays EXEC in
// administration (26/7520/a/u3) and is read here as a case fact.

// =====================================================================
// 26/2055/e/u9: actuarial value of the qualified interest from tables
// =====================================================================

use self::{
    Asset,
    Estate,
    IRC_S2055_E,
    qualified_interest_actuarial_value,
};

pub relation qualified_interest_principal_2055e(e: Estate, item: Asset, principal: Money) kind empirical {
    label en unofficial "the principal amount to which the Table S factor applies for the qualified interest (case-asserted)";
}
pub relation qualified_interest_table_factor_selected_2055e(e: Estate, item: Asset, rate: Decimal, age: Integer, factor: Decimal) kind empirical {
    label en unofficial "the Table S remainder factor the case selects for the qualified interest at this section 7520 rate and age (20.2031-7 Table S; case-asserted key literal)";
}
@source(IRC_S2055_E, relation = formalizes, coverage = contextual, quote = "(I) the actuarial value (determined as of the date of the decedent's death) of the qualified interest, and")
rule QualifiedInterestActuarialValueFromTable(e: Estate, item: Asset, principal: Money, rate: Decimal, age: Integer, factor: Decimal) defeasible {
    label en official "the actuarial value of the qualified interest is the principal times the case-selected Table S factor (section 2055(e)(3)(B)(i)(I) via the section 7520 tables)";
    when qualified_interest_principal_2055e(e, item, principal)
        and qualified_interest_table_factor_selected_2055e(e, item, rate, age, factor);
    then qualified_interest_actuarial_value(e, item, round(principal * factor, 2, "HALF_UP"));
}
