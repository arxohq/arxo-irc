// 26 U.S.C. §2056A — qualified domestic trust (QDOT). Stage 2 (DECISION-0379
// with deontics) of `us.irc.estate_gift` (B01/IRC-11). Companion of
// 17-marital-deduction-2056-completion.law, which holds the §2056(d) side
// (the noncitizen-spouse bar, the (d)(2) exception through this section, the
// (d)(5) determination date).
//
// SHAPE. (a) definition = trustee and withholding requirements of the
// instrument on a date, an external judgment about the Secretary's
// collection regulations, and the executor's election; (d) the election is a
// POWER of the executor (valid when the return is timely: not filed more than
// a year after its due date with extensions) and its irrevocability a
// PROHIBITION; (b) the tax on a taxable event is a computed relation with the
// section 2001(c) table; the trustee's personal liability (b)(6) is a DUTY
// with the statutory due dates of (b)(5); the surviving spouse's election of
// (b)(12)(C) is a POWER.
//
// JUDGMENT CALLS
//  - §2056A(b)(2)(A) is computed as tentative-tax(base + prior + amount) minus
//    tentative-tax(base + prior), base = taxable estate + adjusted taxable
//    gifts (`tentative_tax_base`). The gift-tax subtraction of §2001(b)(2)
//    appears in both minuends and cancels; the §2010 credit likewise. The
//    only place where the cancellation is inexact is the zero floor of a tax
//    below the credit: not modelled (TECH-GAPS G3601).
//  - "The highest rate of tax in effect under section 2001 as of the date of
//    the decedent's death" is read from the pinned rate table (one edition:
//    the rates in force as this package pins them); a decedent whose death
//    predates that table needs a historical rate edition (TECH-GAPS G3602,
//    same class as the stage-1 rate-edition notes).
//  - §2056A(b)(10)(A) benefits (sections 2014, 2032, 2032A, 2055, 2056,
//    2058, 6166 allowed to the spouse's estate for the remaining-property
//    tax) need a run of the spouse's estate computation with the property
//    in it: the reduction is a case-asserted amount (TECH-GAPS G3603, the
//    counterfactual class of G368).
//  - §2056A(b)(11) (tax paid out of the trust is itself a distribution)
//    generates a geometric series of taxes on taxes; only the first deemed
//    distribution is modelled (TECH-GAPS G3604).
//  - The order "(A) resident at all times, and (B) no tax before citizenship
//    or (C) election" of (b)(12) is read as (A) and ((B) or (C)), the reading
//    of 26 CFR 20.2056A-10; INTERPRETATION row.
//  - The section applies to estates of decedents dying after 10 Nov 1988
//    (statutory note, 100-647 §5033(d)(1)): the qualification rule carries
//    that date as a guard.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2056A_A,
    IRC_S2056A_B,
    IRC_S2056A_D,
    Individual,
    Person,
    Secretary,
    TaxableYear,
    Trust,
    bracket_2001c,
    date_of_death,
    disqualifying_power_over_qtip_property,
    estate_return_due_date_with_extensions,
    estate_return_filed_on,
    executor_of,
    interest_passes_to_surviving_spouse,
    life_estate_power_of_appointment_2056b5,
    other_person_power_to_appoint_to_non_spouse,
    property_passes_in_qdot_2056d2,
    qdot_determination_date_2056d5,
    qualifying_income_interest_for_life_2056b7,
    spouse_power_exercisable_alone_and_in_all_events,
    spouse_power_to_appoint_in_favor_of_self_or_estate,
    surviving_spouse_of,
    tentative_tax_base,
};

// --- (a): the definition of a qualified domestic trust ----------------------

pub relation us_trustee_required_by_instrument_on(t: Trust, d: Date) kind empirical {
    label en unofficial "on the stated date the trust instrument requires that at least one trustee be an individual citizen of the United States or a domestic corporation (section 2056A(a)(1)(A))";
}
pub relation withholding_right_provided_by_instrument_on(t: Trust, d: Date) kind empirical {
    label en unofficial "on the stated date the trust instrument provides that no distribution other than of income may be made unless a trustee who is an individual citizen of the United States or a domestic corporation has the right to withhold the tax imposed by this section on the distribution (section 2056A(a)(1)(B))";
}
// (a)(1)(A) opens "except as provided in regulations": a regulatory
// exception is an external judgment of the Secretary, not a case fact.
pub external judgment relation regulation_excuses_us_trustee_requirement_2056a(t: Trust, d: Date) {
    authority Secretary;
    label en official "except as provided in regulations prescribed by the Secretary (section 2056A(a)(1)(A))";
}
pub external judgment relation trust_meets_collection_requirements_by_regulation_2056a2(t: Trust, d: Date) {
    authority Secretary;
    label en official "such trust meets such requirements as the Secretary may by regulations prescribe to ensure the collection of any tax imposed by subsection (b) (section 2056A(a)(2))";
}

relation us_trustee_requirement_satisfied_on(t: Trust, d: Date) kind institutional;
rule UsTrusteeRequirementByInstrumentRule(t: Trust, d: Date) defeasible {
    when us_trustee_required_by_instrument_on(t, d);
    then us_trustee_requirement_satisfied_on(t, d);
}
rule UsTrusteeRequirementByRegulationRule(t: Trust, d: Date) defeasible {
    when regulation_excuses_us_trustee_requirement_2056a(t, d);
    then us_trustee_requirement_satisfied_on(t, d);
}

// (d): the election. Made by the executor on the return; irrevocable; not
// available if the return is filed more than a year after the time
// prescribed by law (including extensions).
pub relation qdot_election_made_on_return(e: Estate, t: Trust, x: Person, w: Interval<Instant>) kind empirical {
    label en unofficial "the executor elects, on the return of the tax imposed by section 2001, that section 2056A applies to the trust";
}
relation qdot_election_return_timely(e: Estate) kind institutional {
    label en unofficial "the return is filed not more than one year after the time prescribed by law (including extensions) for filing it (section 2056A(d), last sentence)";
}
rule QdotElectionReturnTimelyRule(e: Estate, filed: Date, due: Date) defeasible {
    when estate_return_filed_on(e, filed);
    when estate_return_due_date_with_extensions(e, due) and filed <= add_calendar_period(due, 1 calendar_year);
    then qdot_election_return_timely(e);
}
pub relation qdot_election_effective(e: Estate, t: Trust) kind institutional {
    label en official "an election under section 2056A applies to the trust (section 2056A(a)(3), (d))";
}
@source(IRC_S2056A_D, relation = formalizes, coverage = exact, quote = "An election under this section with respect to any trust shall be made by the executor on the return of the tax imposed by section 2001.")
rule QdotElectionPower(e: Estate, t: Trust, x: Person, w: Interval<Instant>) strict {
    label en official "the executor may elect, on the return, that the trust be a qualified domestic trust; no election may be made on a return filed more than one year late (section 2056A(d))";
    when executor_of(e, x, w);
    when qdot_election_made_on_return(e, t, x, w);
    then power QdotElection {
        holder x;
        over e;
        exercise qdot_election_made_on_return(e, t, x, w);
        valid_when qdot_election_return_timely(e);
        effect create(qdot_election_effective(e, t));
        window w;
    };
}
pub relation executor_revokes_qdot_election(e: Estate, t: Trust, x: Person) kind empirical {
    label en unofficial "the executor purports to revoke the section 2056A election made for the trust";
}
@source(IRC_S2056A_D, relation = formalizes, coverage = exact, quote = "Such an election, once made, shall be irrevocable.")
rule QdotElectionIrrevocableRule(e: Estate, t: Trust, x: Person, w: Interval<Instant>) strict {
    label en official "a section 2056A election, once made, shall be irrevocable: the executor may not revoke it (section 2056A(d))";
    when executor_of(e, x, w);
    when qdot_election_effective(e, t);
    then prohibition QdotElectionRevocationProhibition {
        bearer x;
        beneficiary Secretary;
        action executor_revokes_qdot_election(e, t, x);
        window w;
    };
}

pub relation qdot_requirements_met_on(e: Estate, t: Trust, d: Date) kind institutional {
    label en official "the trust meets the requirements of section 2056A(a)(1) and (2) on the stated date";
}
rule QdotRequirementsMetOnRule(e: Estate, t: Trust, d: Date) defeasible {
    label en official "the trust instrument requires a U.S. trustee and preserves the right to withhold, and the trust meets the Secretary's collection requirements (section 2056A(a)(1)-(2))";
    when qdot_election_effective(e, t);
    when us_trustee_requirement_satisfied_on(t, d);
    when withholding_right_provided_by_instrument_on(t, d);
    when trust_meets_collection_requirements_by_regulation_2056a2(t, d);
    then qdot_requirements_met_on(e, t, d);
}

@source(IRC_S2056A_A, relation = formalizes, coverage = exact, quote = "the term \"qualified domestic trust\" means, with respect to any decedent, any trust if")
pub relation trust_qualifies_as_qdot_2056a(e: Estate, t: Trust) kind institutional {
    label en official "the trust is a qualified domestic trust with respect to the decedent: requirements (1)-(2) met on the (d)(5) determination date and the election applies (section 2056A(a))";
}
rule TrustQualifiesAsQdotRule(e: Estate, t: Trust, d: Date, dod: Date) defeasible {
    when date_of_death(e, dod) and dod > @1988-11-10;
    when qdot_election_effective(e, t);
    when qdot_determination_date_2056d5(e, t, d);
    when qdot_requirements_met_on(e, t, d);
    then trust_qualifies_as_qdot_2056a(e, t);
}

// (b)(14): a withholding provision is not, by itself, a failure of the
// (b)(5) or (b)(7) income-interest tests.
pub relation income_entitlement_impaired_only_by_qdot_withholding_provision(e: Estate, item: Asset) kind empirical {
    label en unofficial "the spouse's income entitlement fails the section 2056(b)(5) or (b)(7) test only because the instrument permits withholding an amount from a distribution to pay the tax imposed by section 2056A(b)(1)";
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "Any interest in a qualified domestic trust shall not be treated as failing to meet the requirements of paragraph (5) or (7) of section 2056(b) merely by reason of any provision of the trust instrument permitting the withholding from any distribution of an amount to pay the tax imposed by paragraph (1) on such distribution.")
rule QdotWithholdingDoesNotDefeatQtipIncomeInterestRule(e: Estate, item: Asset) defeasible {
    label en official "a QDOT withholding provision does not defeat the section 2056(b)(7) qualifying income interest (section 2056A(b)(14))";
    when property_passes_in_qdot_2056d2(e, item);
    when income_entitlement_impaired_only_by_qdot_withholding_provision(e, item);
    when not_known(disqualifying_power_over_qtip_property(e, item));
    then qualifying_income_interest_for_life_2056b7(e, item);
}
rule QdotWithholdingDoesNotDefeatLifeEstatePowerRule(e: Estate, item: Asset) defeasible {
    label en official "a QDOT withholding provision does not defeat the section 2056(b)(5) life estate with power of appointment (section 2056A(b)(14))";
    when property_passes_in_qdot_2056d2(e, item);
    when income_entitlement_impaired_only_by_qdot_withholding_provision(e, item);
    when interest_passes_to_surviving_spouse(e, item, _);
    when spouse_power_to_appoint_in_favor_of_self_or_estate(e, item);
    when spouse_power_exercisable_alone_and_in_all_events(e, item);
    when not_known(other_person_power_to_appoint_to_non_spouse(e, item));
    then life_estate_power_of_appointment_2056b5(e, item);
}

// --- (b)(1), (9): the taxable events ----------------------------------------

pub enum QdotEventKind {
    DistributionBeforeSpouseDeath;   // (b)(1)(A)
    PropertyRemainingAtSpouseDeath;  // (b)(1)(B)
    CessationOfQualification;        // (b)(4)
}
// Events are numbered within the estate (one running sequence per decedent),
// so that "previous taxable events" of (b)(2)(A)(i)(II) has an order even on one date.
pub relation qdot_distribution_made(e: Estate, n: Integer, t: Trust, on: Date, amount: Money) kind empirical {
    label en unofficial "a distribution of the stated amount is made from the qualified domestic trust to the surviving spouse or another person on the stated date (event number n of the estate)";
}
pub relation surviving_spouse_death_date(e: Estate, d: Date) kind empirical {
    label en unofficial "the date of death of the surviving spouse of the decedent";
}
pub relation qdot_property_value_at_spouse_death(e: Estate, n: Integer, t: Trust, on: Date, value: Money) kind empirical {
    label en unofficial "the value of the property remaining in the trust on the date of death of the surviving spouse (event number n)";
}
pub relation qdot_ceases_to_meet_requirements(e: Estate, n: Integer, t: Trust, on: Date, value: Money) kind empirical {
    label en unofficial "the trust ceases to meet the requirements of section 2056A(a)(1) and (2) on the stated date, the value of the property then remaining in it being as stated (event number n)";
}
pub relation qdot_distribution_income_portion(e: Estate, n: Integer, amount: Money) kind empirical {
    label en unofficial "the part of the distribution that is a distribution of income to the surviving spouse (section 2056A(b)(3)(A); income as in section 643(b), section 2056A(c)(2))";
}
pub relation qdot_distribution_reimbursement_of_subtitle_a_tax(e: Estate, n: Integer, amount: Money) kind empirical {
    label en unofficial "the part of the distribution that reimburses the surviving spouse for tax imposed by subtitle A on an item of trust income to which the spouse is not entitled under the terms of the trust (section 2056A(b)(15))";
}
pub external judgment relation qdot_distribution_on_account_of_hardship(e: Estate, n: Integer) {
    authority Secretary;
    label en official "any distribution to the surviving spouse on account of hardship (section 2056A(b)(3)(B))";
}

relation qdot_distribution_before_spouse_death(e: Estate, n: Integer) kind institutional;
rule QdotDistributionBeforeSpouseDeathKnownRule(e: Estate, n: Integer, on: Date, died: Date) defeasible {
    when qdot_distribution_made(e, n, _, on, _);
    when surviving_spouse_death_date(e, died) and on < died;
    then qdot_distribution_before_spouse_death(e, n);
}
rule QdotDistributionBeforeSpouseDeathAliveRule(e: Estate, n: Integer, on: Date) defeasible {
    when qdot_distribution_made(e, n, _, on, _);
    when not_known(spouse_death_date_recorded(e));
    then qdot_distribution_before_spouse_death(e, n);
}
relation spouse_death_date_recorded(e: Estate) kind institutional;
rule SpouseDeathDateRecordedRule(e: Estate) defeasible {
    when surviving_spouse_death_date(e, _);
    then spouse_death_date_recorded(e);
}

// (b)(3)(A): income distributions are not taxed; (b)(15): reimbursement for
// subtitle A tax on income not the spouse's; (b)(3)(B): hardship. What remains
// of the distribution is the "amount involved".
relation qdot_distribution_taxable_candidate(e: Estate, n: Integer) kind institutional;
rule QdotDistributionTaxableCandidateRule(e: Estate, n: Integer) defeasible {
    label en official "a distribution before the spouse's death is taxable unless made on account of hardship (section 2056A(b)(1)(A), (3)(B))";
    when qdot_distribution_before_spouse_death(e, n);
    then qdot_distribution_taxable_candidate(e, n);
    unless qdot_distribution_on_account_of_hardship(e, n);
}
relation qdot_distribution_income_amount_or_zero(e: Estate, n: Integer, amount: Money) kind institutional;
rule QdotDistributionIncomeAmountRule(e: Estate, n: Integer, a: Money) defeasible {
    when qdot_distribution_income_portion(e, n, a);
    then qdot_distribution_income_amount_or_zero(e, n, a);
}
rule QdotDistributionIncomeAmountNoneRule(e: Estate, n: Integer) defeasible {
    when qdot_distribution_made(e, n, _, _, _);
    when not_known(qdot_distribution_income_portion_present(e, n));
    then qdot_distribution_income_amount_or_zero(e, n, 0.00 USD);
}
relation qdot_distribution_income_portion_present(e: Estate, n: Integer) kind institutional;
rule QdotDistributionIncomePortionPresentRule(e: Estate, n: Integer) defeasible {
    when qdot_distribution_income_portion(e, n, _);
    then qdot_distribution_income_portion_present(e, n);
}
relation qdot_distribution_reimbursement_amount_or_zero(e: Estate, n: Integer, amount: Money) kind institutional;
rule QdotDistributionReimbursementAmountRule(e: Estate, n: Integer, a: Money) defeasible {
    when qdot_distribution_reimbursement_of_subtitle_a_tax(e, n, a);
    then qdot_distribution_reimbursement_amount_or_zero(e, n, a);
}
rule QdotDistributionReimbursementAmountNoneRule(e: Estate, n: Integer) defeasible {
    when qdot_distribution_made(e, n, _, _, _);
    when not_known(qdot_distribution_reimbursement_present(e, n));
    then qdot_distribution_reimbursement_amount_or_zero(e, n, 0.00 USD);
}
relation qdot_distribution_reimbursement_present(e: Estate, n: Integer) kind institutional;
rule QdotDistributionReimbursementPresentRule(e: Estate, n: Integer) defeasible {
    when qdot_distribution_reimbursement_of_subtitle_a_tax(e, n, _);
    then qdot_distribution_reimbursement_present(e, n);
}

// (b)(12): the surviving spouse becomes a citizen.
pub relation surviving_spouse_became_citizen_on(e: Estate, d: Date) kind empirical {
    label en unofficial "the surviving spouse of the decedent becomes a citizen of the United States on the stated date";
}
pub relation spouse_resident_at_all_times_between_death_and_citizenship(e: Estate) kind empirical {
    label en unofficial "the spouse was a resident of the United States at all times after the decedent's death and before becoming a citizen (section 2056A(b)(12)(A))";
}
pub relation citizenship_election_made(e: Estate, s: Individual, w: Interval<Instant>) kind empirical {
    label en unofficial "the spouse elects the treatment of section 2056A(b)(12)(C)(i) (distribution taxed as taxable gift) and (ii) (reduction as credit under section 2505)";
}
pub relation citizenship_election_effective(e: Estate) kind institutional {
    label en official "the surviving spouse's section 2056A(b)(12)(C) election is effective";
}
@source(IRC_S2056A_B, relation = formalizes, coverage = partial, quote = "such spouse elects")
rule CitizenshipElectionPower(e: Estate, s: Individual, w: Interval<Instant>) strict {
    label en official "the surviving spouse who becomes a citizen may elect to treat distributions on which tax was imposed as taxable gifts and the reduction by the section 2010 credit as a section 2505 credit (section 2056A(b)(12)(C))";
    when surviving_spouse_of(e, s);
    when citizenship_election_made(e, s, w);
    then power CitizenshipElection {
        holder s;
        over e;
        exercise citizenship_election_made(e, s, w);
        valid_when spouse_resident_at_all_times_between_death_and_citizenship(e);
        effect create(citizenship_election_effective(e));
        window w;
    };
}
relation qdot_tax_imposed_before_citizenship(e: Estate) kind institutional;
rule QdotTaxImposedBeforeCitizenshipRule(e: Estate, n: Integer, on: Date, became: Date) defeasible {
    when qdot_event_pre_relief(e, n, _, on, _);
    when surviving_spouse_became_citizen_on(e, became) and on < became;
    then qdot_tax_imposed_before_citizenship(e);
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "paragraph (1)(A) shall not apply to any distributions after such spouse becomes such a citizen (and paragraph (1)(B) shall not apply)")
pub relation qdot_tax_ceases_on_citizenship_2056ab12(e: Estate) kind institutional {
    label en official "paragraph (1)(A) does not apply to later distributions and paragraph (1)(B) does not apply: the spouse became a citizen, was resident throughout, and either no tax was imposed before citizenship or the spouse elected (section 2056A(b)(12))";
}
rule QdotTaxCeasesOnCitizenshipNoPriorTaxRule(e: Estate, became: Date) defeasible {
    when surviving_spouse_became_citizen_on(e, became);
    when spouse_resident_at_all_times_between_death_and_citizenship(e);
    when not_known(qdot_tax_imposed_before_citizenship(e));
    then qdot_tax_ceases_on_citizenship_2056ab12(e);
}
rule QdotTaxCeasesOnCitizenshipElectionRule(e: Estate, became: Date) defeasible {
    when surviving_spouse_became_citizen_on(e, became);
    when spouse_resident_at_all_times_between_death_and_citizenship(e);
    when citizenship_election_effective(e);
    then qdot_tax_ceases_on_citizenship_2056ab12(e);
}

// The amount involved in each taxable event.
pub relation qdot_taxable_event_amount(e: Estate, n: Integer, on: Date, amount: Money) kind institutional {
    label en official "the amount involved in a taxable event (section 2056A(b)(1), (2)(A)(i)(I)): a distribution other than income, hardship and reimbursement; the value of the property remaining at the spouse's death; the value on the date of cessation";
}
pub relation qdot_taxable_event_kind(e: Estate, n: Integer, kind: QdotEventKind) kind institutional {
    label en official "the kind of taxable event (section 2056A(b)(1), (4), (9))";
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "The term \"taxable event\" means the event resulting in tax being imposed under paragraph (1).")
pub relation qdot_taxable_event(e: Estate, n: Integer) kind institutional {
    label en official "a taxable event: a distribution before the spouse's death, or the property remaining at the spouse's death, or cessation of qualification (section 2056A(b)(9))";
}
// Amounts BEFORE the (b)(12) citizenship relief. The relief itself reads
// whether tax was imposed before citizenship, so the amounts it reads must not
// depend on the relief (no cycle through negation).
relation qdot_event_pre_relief(e: Estate, n: Integer, kind: QdotEventKind, on: Date, amount: Money) kind institutional;
rule QdotDistributionPreReliefRule(e: Estate, n: Integer, on: Date, gross: Money, income: Money, reimb: Money) defeasible {
    label en official "the tax is imposed on a distribution, less the income distribution and the reimbursement of subtitle A tax (section 2056A(b)(1)(A), (3)(A), (15))";
    when qdot_distribution_made(e, n, _, on, gross);
    when qdot_distribution_taxable_candidate(e, n);
    when qdot_distribution_income_amount_or_zero(e, n, income);
    when qdot_distribution_reimbursement_amount_or_zero(e, n, reimb);
    then qdot_event_pre_relief(e, n, DistributionBeforeSpouseDeath, on, max(0.00 USD, gross - income - reimb));
}
pub relation qdot_remaining_property_benefit_reduction(e: Estate, n: Integer, amount: Money) kind empirical {
    label en unofficial "the amount by which the benefits of sections 2014, 2032, 2032A, 2055, 2056, 2058 or 6166, allowable to the spouse's estate as if the remaining property were includible in it, reduce the property taxed under section 2056A(b)(1)(B) (section 2056A(b)(10)(A)); case-asserted, TECH-GAPS G3603";
}
relation qdot_remaining_property_benefit_amount_or_zero(e: Estate, n: Integer, amount: Money) kind institutional;
rule QdotRemainingPropertyBenefitAmountRule(e: Estate, n: Integer, a: Money) defeasible {
    when qdot_remaining_property_benefit_reduction(e, n, a);
    then qdot_remaining_property_benefit_amount_or_zero(e, n, a);
}
rule QdotRemainingPropertyBenefitAmountNoneRule(e: Estate, n: Integer) defeasible {
    when qdot_property_value_at_spouse_death(e, n, _, _, _);
    when not_known(qdot_remaining_property_benefit_present(e, n));
    then qdot_remaining_property_benefit_amount_or_zero(e, n, 0.00 USD);
}
relation qdot_remaining_property_benefit_present(e: Estate, n: Integer) kind institutional;
rule QdotRemainingPropertyBenefitPresentRule(e: Estate, n: Integer) defeasible {
    when qdot_remaining_property_benefit_reduction(e, n, _);
    then qdot_remaining_property_benefit_present(e, n);
}
rule QdotRemainingPropertyPreReliefRule(e: Estate, n: Integer, on: Date, value: Money, benefit: Money) defeasible {
    label en official "the tax is imposed on the value of the property remaining in the trust on the date of the spouse's death, less the benefits allowed by (b)(10)(A) (section 2056A(b)(1)(B))";
    when qdot_property_value_at_spouse_death(e, n, _, on, value);
    when qdot_remaining_property_benefit_amount_or_zero(e, n, benefit);
    then qdot_event_pre_relief(e, n, PropertyRemainingAtSpouseDeath, on, max(0.00 USD, value - benefit));
}
rule QdotCessationPreReliefRule(e: Estate, n: Integer, on: Date, value: Money) defeasible {
    label en official "if the trust ceases to meet requirements (1) and (2) of subsection (a), the tax applies as if the surviving spouse died on the date of cessation (section 2056A(b)(4))";
    when qdot_ceases_to_meet_requirements(e, n, _, on, value);
    then qdot_event_pre_relief(e, n, CessationOfQualification, on, value);
}
relation qdot_distribution_after_citizenship_relief(e: Estate, n: Integer) kind institutional;
rule QdotDistributionAfterCitizenshipReliefRule(e: Estate, n: Integer, on: Date, became: Date) defeasible {
    when qdot_tax_ceases_on_citizenship_2056ab12(e);
    when qdot_distribution_made(e, n, _, on, _);
    when surviving_spouse_became_citizen_on(e, became) and on > became;
    then qdot_distribution_after_citizenship_relief(e, n);
}

rule QdotDistributionTaxableAmountRule(e: Estate, n: Integer, on: Date, amount: Money) defeasible {
    label en official "a distribution is a taxable amount unless it is a distribution after the spouse became a citizen with the (b)(12) consequences";
    when qdot_event_pre_relief(e, n, DistributionBeforeSpouseDeath, on, amount);
    when not_known(qdot_distribution_after_citizenship_relief(e, n));
    then qdot_taxable_event_amount(e, n, on, amount);
}
rule QdotRemainingPropertyTaxableAmountRule(e: Estate, n: Integer, on: Date, amount: Money) defeasible {
    label en official "paragraph (1)(B) does not apply once the (b)(12) citizenship relief applies";
    when qdot_event_pre_relief(e, n, PropertyRemainingAtSpouseDeath, on, amount);
    when not_known(qdot_tax_ceases_on_citizenship_2056ab12(e));
    then qdot_taxable_event_amount(e, n, on, amount);
}
rule QdotCessationTaxableAmountRule(e: Estate, n: Integer, on: Date, amount: Money) defeasible {
    label en official "a cessation is treated as the spouse's death, so the (b)(12) relief that displaces paragraph (1)(B) displaces it too";
    when qdot_event_pre_relief(e, n, CessationOfQualification, on, amount);
    when not_known(qdot_tax_ceases_on_citizenship_2056ab12(e));
    then qdot_taxable_event_amount(e, n, on, amount);
}
rule QdotTaxableEventRule(e: Estate, n: Integer, on: Date, amount: Money) defeasible {
    when qdot_taxable_event_amount(e, n, on, amount);
    then qdot_taxable_event(e, n);
}
rule QdotTaxableEventKindRule(e: Estate, n: Integer, kind: QdotEventKind, on: Date, amount: Money) defeasible {
    when qdot_taxable_event_amount(e, n, on, amount);
    when qdot_event_pre_relief(e, n, kind, on, amount);
    then qdot_taxable_event_kind(e, n, kind);
}

// (b)(11): a portion of the tax paid out of the trust is itself a distribution
// (first deemed distribution only; TECH-GAPS G3604).
pub relation qdot_tax_paid_out_of_trust(e: Estate, n: Integer, amount: Money) kind empirical {
    label en unofficial "the portion of the tax imposed with respect to distribution number n that is paid out of the trust";
}
@source(IRC_S2056A_B, relation = formalizes, coverage = partial, quote = "if any portion of the tax imposed by paragraph (1)(A) with respect to any distribution is paid out of the trust, an amount equal to the portion so paid shall be treated as a distribution described in paragraph (1)(A)")
pub relation qdot_deemed_distribution_from_tax_paid_out_of_trust(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "an amount equal to the tax portion paid out of the trust is treated as a further distribution described in paragraph (1)(A); only the first round is computed (TECH-GAPS G3604)";
}
rule QdotDeemedDistributionFromTaxPaidRule(e: Estate, n: Integer, a: Money) defeasible {
    when qdot_tax_paid_out_of_trust(e, n, a);
    when qdot_distribution_before_spouse_death(e, n);
    then qdot_deemed_distribution_from_tax_paid_out_of_trust(e, n, a);
}

// --- (b)(2): the amount of tax -----------------------------------------------

relation qdot_event_precedes(e: Estate, earlier: Integer, later: Integer) kind institutional;
rule QdotEventPrecedesByDateRule(e: Estate, m: Integer, n: Integer, d1: Date, d2: Date) defeasible {
    when qdot_taxable_event_amount(e, m, d1, _);
    when qdot_taxable_event_amount(e, n, d2, _);
    when d1 < d2;
    then qdot_event_precedes(e, m, n);
}
rule QdotEventPrecedesByNumberRule(e: Estate, m: Integer, n: Integer, d1: Date, d2: Date) defeasible {
    when qdot_taxable_event_amount(e, m, d1, _);
    when qdot_taxable_event_amount(e, n, d2, _);
    when d1 == d2 and m < n;
    then qdot_event_precedes(e, m, n);
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "the aggregate amount involved in previous taxable events with respect to qualified domestic trusts of such decedent")
pub relation qdot_previous_events_aggregate(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "the aggregate amount involved in previous taxable events with respect to qualified domestic trusts of the decedent (section 2056A(b)(2)(A)(i)(II))";
}
rule QdotPreviousEventsAggregateRule(e: Estate, n: Integer) defeasible {
    when qdot_taxable_event_amount(e, n, _, _);
    then qdot_previous_events_aggregate(e, n, sum(collect all a: Money, m: Integer where qdot_event_precedes(e, m, n) and qdot_taxable_event_amount(e, m, _, a), empty: 0.00 USD));
}
relation qdot_tax_base_without_event(e: Estate, n: Integer, base: Money) kind institutional;
relation qdot_tax_base_with_event(e: Estate, n: Integer, base: Money) kind institutional;
rule QdotTaxBaseWithoutEventRule(e: Estate, n: Integer, tentative_base: Money, prior: Money) defeasible {
    when tentative_tax_base(e, tentative_base);
    when qdot_previous_events_aggregate(e, n, prior);
    then qdot_tax_base_without_event(e, n, tentative_base + prior);
}
rule QdotTaxBaseWithEventRule(e: Estate, n: Integer, tentative_base: Money, prior: Money, on: Date, amount: Money) defeasible {
    when tentative_tax_base(e, tentative_base);
    when qdot_previous_events_aggregate(e, n, prior);
    when qdot_taxable_event_amount(e, n, on, amount);
    then qdot_tax_base_with_event(e, n, tentative_base + prior + amount);
}
pub relation qdot_tax_on_event_by_difference(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "section 2056A(b)(2)(A): the tax which would have been imposed under section 2001 with the taxable estate increased by the amount involved plus previous events, less the tax with it increased by the previous events only";
}
rule QdotTaxOnEventByDifferenceRule(e: Estate, n: Integer, b_with: Money, b_without: Money, l1: Money, t1: Money, r1: Decimal, l2: Money, t2: Money, r2: Decimal) defeasible {
    when qdot_tax_base_with_event(e, n, b_with);
    when bracket_2001c(b_with, l1, t1, r1);
    when qdot_tax_base_without_event(e, n, b_without);
    when bracket_2001c(b_without, l2, t2, r2);
    then qdot_tax_on_event_by_difference(e, n, max(0.00 USD, (t1 + r1 * (b_with - l1)) - (t2 + r2 * (b_without - l2))));
}

// (b)(2)(B)-(C): the highest rate at the date of death where the decedent's tax
// is not finally determined, or where several QDOTs exist without a designated
// responsible person.
const QdotHighestRateProbeBase: Money = 100000000.00 USD;
relation estate_highest_rate_probe_base(e: Estate, base: Money) kind institutional;
rule EstateHighestRateProbeBaseRule(e: Estate, dod: Date) defeasible {
    when date_of_death(e, dod);
    then estate_highest_rate_probe_base(e, QdotHighestRateProbeBase);
}
pub relation estate_highest_rate_2001_at_death(e: Estate, rate: Decimal) kind institutional {
    label en official "the highest rate of tax in effect under section 2001 as of the date of the decedent's death, read from the pinned section 2001(c) schedule (TECH-GAPS G3602 for earlier rate editions)";
}
rule EstateHighestRate2001AtDeathRule(e: Estate, probe: Money, lower: Money, base_tax: Money, rate: Decimal) defeasible {
    when estate_highest_rate_probe_base(e, probe);
    when bracket_2001c(probe, lower, base_tax, rate);
    then estate_highest_rate_2001_at_death(e, rate);
}
pub relation estate_tax_finally_determined_on(e: Estate, d: Date) kind empirical {
    label en unofficial "the tax imposed on the decedent's estate under section 2001 is finally determined on the stated date";
}
relation estate_tax_not_finally_determined_before(e: Estate, n: Integer) kind institutional;
rule EstateTaxNotFinallyDeterminedNoDateRule(e: Estate, n: Integer) defeasible {
    when qdot_taxable_event_amount(e, n, _, _);
    when not_known(estate_tax_final_determination_recorded(e));
    then estate_tax_not_finally_determined_before(e, n);
}
rule EstateTaxNotFinallyDeterminedLaterRule(e: Estate, n: Integer, on: Date, final_on: Date) defeasible {
    when qdot_taxable_event_amount(e, n, on, _);
    when estate_tax_finally_determined_on(e, final_on) and on < final_on;
    then estate_tax_not_finally_determined_before(e, n);
}
relation estate_tax_final_determination_recorded(e: Estate) kind institutional;
rule EstateTaxFinalDeterminationRecordedRule(e: Estate) defeasible {
    when estate_tax_finally_determined_on(e, _);
    then estate_tax_final_determination_recorded(e);
}

pub relation executor_designates_qdot_responsible_person(e: Estate, p: Person) kind empirical {
    label en unofficial "the decedent's executor designates one person responsible for filing all returns of, and paying, the tax imposed under paragraph (1) with respect to all the trusts";
}
pub relation designated_person_is_us_citizen_or_domestic_corporation(p: Person) kind empirical {
    label en unofficial "the designated person is an individual citizen of the United States or a domestic corporation (section 2056A(b)(2)(C)(i))";
}
pub external judgment relation designated_person_meets_regulations_2056ab2c(p: Person) {
    authority Secretary;
    label en official "the designated person meets such requirements as the Secretary may by regulations prescribe (section 2056A(b)(2)(C)(ii))";
}
relation qdot_responsible_person_designation_valid(e: Estate) kind institutional;
rule QdotResponsiblePersonDesignationValidRule(e: Estate, p: Person) defeasible {
    when executor_designates_qdot_responsible_person(e, p);
    when designated_person_is_us_citizen_or_domestic_corporation(p);
    when designated_person_meets_regulations_2056ab2c(p);
    then qdot_responsible_person_designation_valid(e);
}
relation multiple_qdots_without_valid_designation(e: Estate) kind institutional;
rule MultipleQdotsWithoutValidDesignationRule(e: Estate, a: Trust, b: Trust) defeasible {
    when qdot_election_effective(e, a);
    when qdot_election_effective(e, b) and a != b;
    when not_known(qdot_responsible_person_designation_valid(e));
    then multiple_qdots_without_valid_designation(e);
}

@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "the amount of the tax imposed by paragraph (1) on such event shall be determined by using the highest rate of tax in effect under section 2001 as of the date of the decedent's death")
pub relation qdot_tax_on_event_at_highest_rate(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "the tax on the event at the highest section 2001 rate at the date of death: applies where the decedent's tax is not finally determined before the event, or where there are several trusts and no valid designation (section 2056A(b)(2)(B)(i), (C))";
}
rule QdotTaxAtHighestRateNotFinalRule(e: Estate, n: Integer, rate: Decimal, amount: Money) defeasible {
    when qdot_taxable_event_amount(e, n, _, amount);
    when estate_tax_not_finally_determined_before(e, n);
    when estate_highest_rate_2001_at_death(e, rate);
    then qdot_tax_on_event_at_highest_rate(e, n, round(amount * rate, 2, "HALF_UP"));
}
rule QdotTaxAtHighestRateMultipleRule(e: Estate, n: Integer, rate: Decimal, amount: Money) defeasible {
    when qdot_taxable_event_amount(e, n, _, amount);
    when multiple_qdots_without_valid_designation(e);
    when estate_highest_rate_2001_at_death(e, rate);
    then qdot_tax_on_event_at_highest_rate(e, n, round(amount * rate, 2, "HALF_UP"));
}

@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "In the case of any taxable event, the amount of the estate tax imposed by paragraph (1) shall be the amount equal to")
pub relation qdot_estate_tax_on_event(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "the estate tax imposed by paragraph (1) on the taxable event: the (A) difference once the decedent's tax is final and one person is responsible; the highest-rate amount of (B)(i) or (C) otherwise";
}
rule QdotEstateTaxOnEventByDifferenceRule(e: Estate, n: Integer, amount: Money) defeasible {
    when qdot_tax_on_event_by_difference(e, n, amount);
    when not_known(estate_tax_not_finally_determined_before(e, n));
    when not_known(multiple_qdots_without_valid_designation(e));
    then qdot_estate_tax_on_event(e, n, amount);
}
rule QdotEstateTaxOnEventHighestRateRule(e: Estate, n: Integer, amount: Money) defeasible {
    when qdot_tax_on_event_at_highest_rate(e, n, amount);
    then qdot_estate_tax_on_event(e, n, amount);
}

// (b)(2)(B)(ii): refund of the excess once the decedent's tax is finally
// determined, on a claim filed within a year of the final determination.
pub relation qdot_tax_paid_at_highest_rate_excess(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "the amount by which the tax determined under (B)(i) exceeds the tax determined under (A) on the basis of the final determination (section 2056A(b)(2)(B)(ii))";
}
rule QdotTaxPaidAtHighestRateExcessRule(e: Estate, n: Integer, tentative: Money, final_tax: Money) defeasible {
    when qdot_tax_on_event_at_highest_rate(e, n, tentative);
    when qdot_tax_on_event_by_difference(e, n, final_tax);
    when estate_tax_finally_determined_on(e, _);
    when tentative > final_tax;
    then qdot_tax_paid_at_highest_rate_excess(e, n, tentative - final_tax);
}
pub relation qdot_refund_claim_filed_on(e: Estate, n: Integer, x: Person, d: Date) kind empirical {
    label en unofficial "a claim for credit or refund of the excess is filed on the stated date";
}
relation qdot_refund_claim_timely(e: Estate, n: Integer) kind institutional;
rule QdotRefundClaimTimelyRule(e: Estate, n: Integer, x: Person, filed: Date, final_on: Date) defeasible {
    when qdot_refund_claim_filed_on(e, n, x, filed);
    when estate_tax_finally_determined_on(e, final_on) and filed <= add_calendar_period(final_on, 1 calendar_year);
    then qdot_refund_claim_timely(e, n);
}
pub relation qdot_excess_allowed_as_credit_or_refund(e: Estate, n: Integer) kind institutional {
    label en official "the excess is allowed as a credit or refund (with interest), the claim having been filed not later than 1 year after the final determination (section 2056A(b)(2)(B)(ii)); interest itself is owned by payment-refunds-interest";
}
pub relation qdot_trustee_of(t: Trust, x: Person) kind empirical {
    label en unofficial "x is a trustee of the qualified domestic trust";
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "such excess shall be allowed as a credit or refund (with interest) if claim therefor is filed not later than 1 year after the date of such final determination")
rule QdotRefundClaimPower(e: Estate, n: Integer, t: Trust, x: Person, filed: Date) strict {
    label en official "the person who paid may claim credit or refund of the excess within 1 year of the final determination (section 2056A(b)(2)(B)(ii))";
    when qdot_trustee_of(t, x);
    when qdot_refund_claim_filed_on(e, n, x, filed);
    when qdot_tax_paid_at_highest_rate_excess(e, n, _);
    then power QdotExcessRefundClaim {
        holder x;
        over e;
        exercise qdot_refund_claim_filed_on(e, n, x, filed);
        valid_when qdot_refund_claim_timely(e, n);
        effect create(qdot_excess_allowed_as_credit_or_refund(e, n));
        window [@1988-11-11, infinity);
    };
}

// --- (b)(5): due date; (b)(6): the trustee's personal liability --------------

pub relation qdot_event_calendar_year(e: Estate, n: Integer, y: TaxableYear) kind empirical {
    label en unofficial "the calendar year in which the taxable event occurs";
}
relation qdot_distribution_due_candidate(e: Estate, n: Integer, d: Date) kind institutional;
rule QdotDistributionDueCandidateGeneralRule(e: Estate, n: Integer, y: TaxableYear, close: Date) defeasible {
    label en official "due and payable on the 15th day of the 4th month following the calendar year in which the taxable event occurs (section 2056A(b)(5)(A))";
    when qdot_event_calendar_year(e, n, y) and us.irc.core::ends(y, close);
    when qdot_taxable_event_kind(e, n, DistributionBeforeSpouseDeath);
    then qdot_distribution_due_candidate(e, n, add_calendar_period(add_calendar_period(add_calendar_period(close, 1 calendar_day), 3 calendar_month), 14 calendar_day));
}
relation qdot_spouse_death_tax_due_date(e: Estate, d: Date) kind institutional;
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "The estate tax imposed by paragraph (1)(B) shall be due and payable on the date 9 months after the date of such death.")
rule QdotSpouseDeathTaxDueDateRule(e: Estate, died: Date) defeasible {
    label en official "the tax on the property remaining is due 9 months after the surviving spouse's death (section 2056A(b)(5)(B))";
    when surviving_spouse_death_date(e, died);
    then qdot_spouse_death_tax_due_date(e, add_calendar_period(died, 9 calendar_month));
}
rule QdotDistributionDueCandidateDeathYearRule(e: Estate, n: Integer, y: TaxableYear, start: Date, close: Date, died: Date, due: Date) defeasible {
    label en official "distributions during the calendar year in which the spouse dies are due not later than the date the paragraph (1)(B) tax is due (section 2056A(b)(5)(A), proviso)";
    when qdot_event_calendar_year(e, n, y) and us.irc.core::begins(y, start) and us.irc.core::ends(y, close);
    when qdot_taxable_event_kind(e, n, DistributionBeforeSpouseDeath);
    when surviving_spouse_death_date(e, died) and died >= start and died <= close;
    when qdot_spouse_death_tax_due_date(e, due);
    then qdot_distribution_due_candidate(e, n, due);
}
relation qdot_distribution_earlier_due_candidate_exists(e: Estate, n: Integer, d: Date) kind institutional;
rule QdotDistributionEarlierDueCandidateExistsRule(e: Estate, n: Integer, d: Date, d2: Date) defeasible {
    when qdot_distribution_due_candidate(e, n, d);
    when qdot_distribution_due_candidate(e, n, d2) and d2 < d;
    then qdot_distribution_earlier_due_candidate_exists(e, n, d);
}
pub relation qdot_tax_due_date(e: Estate, n: Integer, d: Date) kind institutional {
    label en official "the date the estate tax on the taxable event is due and payable (section 2056A(b)(5))";
}
rule QdotTaxDueDateDistributionRule(e: Estate, n: Integer, d: Date) defeasible {
    when qdot_distribution_due_candidate(e, n, d);
    unless qdot_distribution_earlier_due_candidate_exists(e, n, d);
    then qdot_tax_due_date(e, n, d);
}
rule QdotTaxDueDateRemainingRule(e: Estate, n: Integer, d: Date) defeasible {
    when qdot_taxable_event_kind(e, n, PropertyRemainingAtSpouseDeath);
    when qdot_spouse_death_tax_due_date(e, d);
    then qdot_tax_due_date(e, n, d);
}
pub relation qdot_tax_paid(e: Estate, n: Integer) kind empirical {
    label en unofficial "the tax imposed by paragraph (1) on the taxable event has been paid";
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "Each trustee shall be personally liable for the amount of the tax imposed by paragraph (1).")
rule QdotTrusteePersonalLiabilityDutyRule(e: Estate, n: Integer, t: Trust, x: Person, on: Date, due: Date) defeasible {
    label en official "each trustee is personally liable for the tax imposed by paragraph (1): a duty to pay it by its due date (section 2056A(b)(6)); the rules similar to section 2204 are TECH-GAPS G3605";
    when qdot_taxable_event_amount(e, n, on, _);
    when qdot_tax_due_date(e, n, due);
    when qdot_trustee_of(t, x);
    when qdot_election_effective(e, t);
    then duty QdotTrusteeTaxPaymentDuty {
        bearer x;
        beneficiary Secretary;
        achieve qdot_tax_paid(e, n) during [on, due];
    };
}

// --- (b)(7), (8), (10)(B)-(C), (13): treatments by other provisions ---------

pub relation qdot_tax_paid_amount(e: Estate, n: Integer, amount: Money) kind empirical {
    label en unofficial "the amount of tax paid under paragraph (1) on the event";
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "For purposes of section 2056(d), any tax paid under paragraph (1) shall be treated as a tax paid under section 2001 with respect to the estate of the decedent.")
pub relation qdot_tax_treated_as_section_2001_tax_paid(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "tax paid under paragraph (1) is treated as tax paid under section 2001 with respect to the decedent's estate for section 2056(d)(3) (section 2056A(b)(7))";
}
rule QdotTaxTreatedAsSection2001TaxPaidRule(e: Estate, n: Integer, a: Money) defeasible {
    when qdot_tax_paid_amount(e, n, a);
    when qdot_tax_paid(e, n);
    then qdot_tax_treated_as_section_2001_tax_paid(e, n, a);
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "For purposes of section 6324, any tax imposed by paragraph (1) shall be treated as an estate tax imposed under this chapter with respect to a decedent dying on the date of the taxable event")
pub relation qdot_tax_treated_as_estate_tax_for_lien_6324(e: Estate, n: Integer, on: Date) kind institutional {
    label en official "for section 6324 the tax on the event is an estate tax of a decedent dying on the date of the event, and the property involved is the gross estate (section 2056A(b)(8)); section 6324 is not owned by this package";
}
rule QdotTaxTreatedAsEstateTaxFor6324Rule(e: Estate, n: Integer, on: Date) defeasible {
    when qdot_taxable_event_amount(e, n, on, _);
    then qdot_tax_treated_as_estate_tax_for_lien_6324(e, n, on);
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "the tax imposed by paragraph (1)(B) with respect to such property shall be treated as a Federal estate tax payable with respect to the estate of the surviving spouse")
pub relation qdot_remaining_property_tax_treated_as_federal_estate_tax_for_303(e: Estate, n: Integer) kind institutional {
    label en official "for section 303 the tax on the property remaining is a Federal estate tax payable with respect to the surviving spouse's estate, if that estate meets section 303 (section 2056A(b)(10)(B)); section 303 is owned by us.irc.corporations";
}
rule QdotRemainingPropertyTaxTreatedAsFederalEstateTaxFor303Rule(e: Estate, n: Integer) defeasible {
    when qdot_taxable_event_kind(e, n, PropertyRemainingAtSpouseDeath);
    then qdot_remaining_property_tax_treated_as_federal_estate_tax_for_303(e, n);
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "The provisions of section 6161(a)(2) shall apply with respect to the tax imposed by paragraph (1)(B), and the reference in such section to the executor shall be treated as a reference to the trustees of the trust.")
pub relation section_6161a2_applies_to_trustees_of_qdot(e: Estate, n: Integer, t: Trust) kind institutional {
    label en official "section 6161(a)(2) applies to the tax on the property remaining, and its reference to the executor is a reference to the trustees (section 2056A(b)(10)(C)); section 6161 is owned by us.irc.payment_refunds_interest";
}
rule Section6161a2AppliesToTrusteesOfQdotRule(e: Estate, n: Integer, t: Trust) defeasible {
    when qdot_taxable_event_kind(e, n, PropertyRemainingAtSpouseDeath);
    when qdot_election_effective(e, t);
    then section_6161a2_applies_to_trustees_of_qdot(e, n, t);
}
@source(IRC_S2056A_B, relation = formalizes, coverage = exact, quote = "any distribution on which tax is imposed by paragraph (1)(A) shall be treated as a transfer by gift, and any tax paid under paragraph (1)(A) shall be treated as a gift tax")
pub relation qdot_distribution_treated_as_gift_for_1015(e: Estate, n: Integer) kind institutional {
    label en official "for section 1015 a distribution taxed under paragraph (1)(A) is a transfer by gift, and the tax paid a gift tax (section 2056A(b)(13)); section 1015 is owned by us.irc.property_transactions";
}
rule QdotDistributionTreatedAsGiftFor1015Rule(e: Estate, n: Integer) defeasible {
    when qdot_taxable_event_kind(e, n, DistributionBeforeSpouseDeath);
    then qdot_distribution_treated_as_gift_for_1015(e, n);
}

// (b)(11) second round (bounded; TECH-GAPS G3604): the first-round tax paid
// out of the trust is itself a distribution, so the (b)(2)(A) difference is
// recomputed on the base increased by that tax. Rounds 3+ are an explicit
// truncation, flagged, not silently dropped.
relation qdot_tax_base_with_event_second_round(e: Estate, n: Integer, base: Money) kind institutional;
rule QdotTaxBaseWithEventSecondRoundRule(e: Estate, n: Integer, tentative_base: Money, prior: Money, on: Date, amount: Money, tax1: Money) defeasible {
    when tentative_tax_base(e, tentative_base);
    when qdot_previous_events_aggregate(e, n, prior);
    when qdot_taxable_event_amount(e, n, on, amount);
    when qdot_tax_on_event_by_difference(e, n, tax1);
    when qdot_tax_paid_out_of_trust(e, n, tax1);
    then qdot_tax_base_with_event_second_round(e, n, tentative_base + prior + amount + tax1);
}
pub relation qdot_tax_total_second_round(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "section 2056A(b)(2)(A) recomputed with the first-round trust-paid tax added to the amount involved (second round of (b)(11))";
}
rule QdotTaxTotalSecondRoundRule(e: Estate, n: Integer, b_with2: Money, b_without: Money, l1: Money, t1: Money, r1: Decimal, l2: Money, t2: Money, r2: Decimal) defeasible {
    when qdot_tax_base_with_event_second_round(e, n, b_with2);
    when bracket_2001c(b_with2, l1, t1, r1);
    when qdot_tax_base_without_event(e, n, b_without);
    when bracket_2001c(b_without, l2, t2, r2);
    then qdot_tax_total_second_round(e, n, max(0.00 USD, (t1 + r1 * (b_with2 - l1)) - (t2 + r2 * (b_without - l2))));
}
@source(IRC_S2056A_B, relation = formalizes, coverage = partial, quote = "if any portion of the tax imposed by paragraph (1)(A) with respect to any distribution is paid out of the trust, an amount equal to the portion so paid shall be treated as a distribution described in paragraph (1)(A)")
pub relation qdot_tax_incremental_second_round(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "the incremental second-round tax: the recomputed total less the first-round tax";
}
rule QdotTaxIncrementalSecondRoundRule(e: Estate, n: Integer, total2: Money, tax1: Money) defeasible {
    when qdot_tax_total_second_round(e, n, total2);
    when qdot_tax_on_event_by_difference(e, n, tax1);
    then qdot_tax_incremental_second_round(e, n, max(0.00 USD, total2 - tax1));
}
pub relation qdot_trust_tax_truncated_after_two_rounds(e: Estate, n: Integer) kind institutional {
    label en official "the (b)(11) tax-on-tax series is truncated after two computed rounds: the second round's own trust-paid consequence is flagged, not derived (TECH-GAPS G3604 remainder)";
}
rule QdotTruncatedAfterTwoRoundsRule(e: Estate, n: Integer) defeasible {
    when qdot_tax_incremental_second_round(e, n, _);
    then qdot_trust_tax_truncated_after_two_rounds(e, n);
}
