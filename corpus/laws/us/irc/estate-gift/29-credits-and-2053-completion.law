// 26 U.S.C. §2012(b),(c),(e); §2013(c)(1)(A)-(B),(c)(2),(d),(f); §2014(c)(2),(f),(h);
// §2053(b),(c),(d). Stage 2 (DECISION-0379 with deontics) of `us.irc.estate_gift`
// (B01/IRC-11); continues 07-credits-2011-2016.law and 04-deductions.law.
//
// SHAPE. Powers: the executor's election to deduct a foreign death tax (§2053(d)(1));
// the President's proclamation conditioning the §2014(a) credit on reciprocity
// (§2014(h)). No duties or prohibitions: these sections state amounts and limits.
//
// JUDGMENT CALLS
//  - §2013(c)(1)(A): the limitation reads the tax "after deducting the credits
//    provided for in sections 2010, 2012, and 2014" (stage 1 deducted 2010 and 2012
//    only); `estate_tax_after_2010_2012_2014` is the new base.
//  - §2013(c)(1)(B): the tax "computed by excluding from the gross estate the value of
//    such property" is a counterfactual re-run of the whole estate computation and stays
//    an asserted amount (TECH-GAPS G3621); the charitable-deduction adjustment the flush
//    text prescribes for that computation IS computed here.
//  - §2013(c)(2): the aggregate limitation for two or more transferors is computed from an
//    asserted "tax excluding all transfers" and apportioned by net transferred value;
//    the per-transferor figure of (c)(1) is not used then.
//  - §2013(d): the base value is the value used for the transferor's Federal estate tax;
//    the three adjustments are asserted amounts (the tax effect and the encumbrances are
//    net-value computations of the case), the marital reduction of (d)(3) applies only
//    where the decedent was the transferor's spouse.
//  - §2013(f): the transferor's tax and taxable estate "as if section 2032A did not apply"
//    are counterfactual: the case asserts the recomputed value and taxable estate.
//  - §2014(c)(2): the reduction of the ratio values by the charitable and marital deductions
//    is "in accordance with regulations": an asserted amount (EXTERNAL_DEPENDENCY).
//  - §2053(c)(1)(B)-(D): the three bars are case-classified items (the kind of tax is a
//    characterization of the claim), the bar then removes the item from every category.
//  - §2053(c)(2): the cap applies to the amounts of subsection (a), not to (b) or (d).
//  - §2053(d)(1): the deduction amount is asserted "in accordance with regulations".

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2012_B,
    IRC_S2012_C,
    IRC_S2012_E,
    IRC_S2013_C,
    IRC_S2013_D,
    IRC_S2013_F,
    IRC_S2014_C,
    IRC_S2014_F,
    IRC_S2014_H,
    IRC_S2053_B,
    IRC_S2053_C,
    IRC_S2053_D,
    Person,
    President,
    charitable_and_marital_deduction_total_2012,
    claims_against_estate,
    date_of_death,
    decedent_citizen_or_resident,
    deductible_claim_2053,
    eligible_prior_transferor,
    estate_tax_after_unified_credit,
    executor_of,
    expenses_indebtedness_and_taxes_total_2053,
    federal_estate_tax_paid_for_2013b,
    foreign_death_tax_credit,
    foreign_taxed_property_in_gross_estate,
    gift_tax_paid_on_gift_2012,
    gift_value_reduced_2012b,
    gross_estate,
    has_2053_item,
    has_foreign_death_tax_credit,
    has_gift_tax_credit_2012,
    prior_transfer_credit_limitation,
    prior_transfer_from,
    prior_transfer_property_value,
    prior_transfer_property_value_spousal_adjustment_applies,
    section_2053a_gross_2053,
    settlement_losses_deduction_2054,
    total_gift_tax_credit_2012,
    transferor_taxable_estate,
};

// =====================================================================
// §2012(b), (c), (e)
// =====================================================================

pub relation gift_made_on_2012(e: Estate, gift_id: Integer, on: Date) kind empirical {
    label en unofficial "the date on which the gift was made";
}
@source(IRC_S2012_E, relation = formalizes, coverage = exact, quote = "No credit shall be allowed under this section with respect to the amount of any tax paid under chapter 12 on any gift made after December 31, 1976.")
pub relation gift_after_1976_no_credit_2012e(e: Estate, gift_id: Integer) kind institutional {
    label en official "no section 2012 credit for tax paid on a gift made after December 31, 1976 (section 2012(e))";
}
rule GiftAfter1976NoCreditRule(e: Estate, gift_id: Integer, on: Date) defeasible {
    when gift_made_on_2012(e, gift_id, on);
    when on > @1976-12-31;
    then gift_after_1976_no_credit_2012e(e, gift_id);
}

pub relation gift_value_at_lower_of_gift_or_death_2012(e: Estate, gift_id: Integer, value: Money) kind empirical {
    label en unofficial "the value of the gift at the time of the gift or of the death, the lower, before the section 2012(b) reductions (section 2012(a))";
}
pub relation annual_exclusion_amount_excluded_2012b1(e: Estate, gift_id: Integer, amount: Money) kind empirical {
    label en unofficial "the amount of the gift excluded under section 2503(a) (or corresponding prior law) in determining the gifts of the calendar quarter (calendar year before 1971) in which it was made (section 2012(b)(1))";
}
pub relation gift_marital_deduction_allowed_2012b2(e: Estate, gift_id: Integer) kind empirical {
    label en unofficial "a deduction with respect to the gift is allowed under section 2056(a) (section 2012(b)(2))";
}
pub relation gift_charitable_deduction_allowed_2012b3(e: Estate, gift_id: Integer) kind empirical {
    label en unofficial "a deduction with respect to the gift is allowed under section 2055 or 2106(a)(2) (section 2012(b)(3))";
}
relation gift_value_after_exclusion_2012b1(e: Estate, gift_id: Integer, value: Money) kind institutional;
rule GiftValueAfterExclusionRule(e: Estate, gift_id: Integer, v: Money, x: Money) defeasible {
    when gift_value_at_lower_of_gift_or_death_2012(e, gift_id, v);
    when annual_exclusion_amount_excluded_2012b1(e, gift_id, x);
    then gift_value_after_exclusion_2012b1(e, gift_id, max(0.00 USD, v - x));
}
relation has_exclusion_fact_2012b1(e: Estate, gift_id: Integer) kind institutional;
rule HasExclusionFact2012b1Rule(e: Estate, gift_id: Integer, x: Money) defeasible {
    when annual_exclusion_amount_excluded_2012b1(e, gift_id, x);
    then has_exclusion_fact_2012b1(e, gift_id);
}
rule GiftValueNoExclusionRule(e: Estate, gift_id: Integer, v: Money) defeasible {
    when gift_value_at_lower_of_gift_or_death_2012(e, gift_id, v);
    when not_known(has_exclusion_fact_2012b1(e, gift_id));
    then gift_value_after_exclusion_2012b1(e, gift_id, v);
}
@source(IRC_S2012_B, relation = formalizes, coverage = exact, quote = "the value at the time of the gift or at the time of the death, referred to in such ratio, shall be reduced")
pub relation gift_value_reduced_2012b_derived(e: Estate, gift_id: Integer, value: Money) kind institutional {
    label en official "the gift value for the section 2012(a) ratio after the (b)(1) exclusion and, where a marital or charitable deduction is allowed with respect to the gift, after reducing it by the whole of the remainder (section 2012(b))";
}
rule GiftValueReducedRule(e: Estate, gift_id: Integer, v: Money) defeasible {
    when gift_value_after_exclusion_2012b1(e, gift_id, v);
    when not_known(gift_marital_deduction_allowed_2012b2(e, gift_id));
    when not_known(gift_charitable_deduction_allowed_2012b3(e, gift_id));
    then gift_value_reduced_2012b_derived(e, gift_id, v);
}
rule GiftValueReducedMaritalRule(e: Estate, gift_id: Integer, v: Money) defeasible {
    label en official "a marital deduction reduces the value by the amount of the value, reduced as in (1): to zero (section 2012(b)(2))";
    when gift_value_after_exclusion_2012b1(e, gift_id, v);
    when gift_marital_deduction_allowed_2012b2(e, gift_id);
    then gift_value_reduced_2012b_derived(e, gift_id, 0.00 USD);
}
rule GiftValueReducedCharitableRule(e: Estate, gift_id: Integer, v: Money) defeasible {
    label en official "a charitable deduction reduces the value by the amount of the value, reduced as in (1): to zero (section 2012(b)(3))";
    when gift_value_after_exclusion_2012b1(e, gift_id, v);
    when gift_charitable_deduction_allowed_2012b3(e, gift_id);
    then gift_value_reduced_2012b_derived(e, gift_id, 0.00 USD);
}

// (c): a gift considered made one-half by the spouse
pub relation gift_split_with_spouse_2012c(e: Estate, gift_id: Integer) kind empirical {
    label en unofficial "the decedent was the donor but under section 2513 (or corresponding prior law) the gift was considered as made one-half by the spouse";
}
pub relation gift_tax_paid_on_half_2012c(e: Estate, gift_id: Integer, half: Integer, amount: Money) kind empirical {
    label en unofficial "the tax paid with respect to the half (1 the decedent's, 2 the spouse's) of the split gift, computed as in section 2012(d)";
}
pub relation gift_half_value_reduced_2012c(e: Estate, gift_id: Integer, half: Integer, value: Money) kind empirical {
    label en unofficial "the value of the half of the split gift, reduced as provided in section 2012(b)(1)";
}
@source(IRC_S2012_C, relation = formalizes, coverage = exact, quote = "includes the amounts paid with respect to each half of such gift")
pub relation gift_tax_paid_for_credit_2012(e: Estate, gift_id: Integer, amount: Money) kind institutional {
    label en official "the tax paid on the gift under chapter 12: as asserted, or for a split gift the sum of the amounts paid with respect to each half (section 2012(a), (c)(1))";
}
rule GiftTaxPaidAssertedRule(e: Estate, gift_id: Integer, paid: Money) defeasible {
    when gift_tax_paid_on_gift_2012(e, gift_id, paid);
    when not_known(gift_split_with_spouse_2012c(e, gift_id));
    then gift_tax_paid_for_credit_2012(e, gift_id, paid);
}
rule GiftTaxPaidSplitRule(e: Estate, gift_id: Integer) defeasible {
    when gift_split_with_spouse_2012c(e, gift_id);
    when gift_tax_paid_on_half_2012c(e, gift_id, _, _);
    then gift_tax_paid_for_credit_2012(e, gift_id, sum(collect all a: Money, h: Integer where gift_tax_paid_on_half_2012c(e, gift_id, h, a), empty: 0.00 USD));
}
@source(IRC_S2012_C, relation = formalizes, coverage = exact, quote = "the value at the time of the gift or at the time of the death, referred to in such ratio, includes such value with respect to each half of such gift")
pub relation gift_value_for_2012_ratio(e: Estate, gift_id: Integer, value: Money) kind institutional {
    label en official "the gift value in the section 2012(a) ratio: as asserted after the (b) reductions, derived from the (b) reductions, or for a split gift the sum of both halves (section 2012(b), (c)(2))";
}
rule GiftValueRatioAssertedRule(e: Estate, gift_id: Integer, v: Money) defeasible {
    when gift_value_reduced_2012b(e, gift_id, v);
    then gift_value_for_2012_ratio(e, gift_id, v);
}
rule GiftValueRatioDerivedRule(e: Estate, gift_id: Integer, v: Money) defeasible {
    when gift_value_reduced_2012b_derived(e, gift_id, v);
    when not_known(gift_split_with_spouse_2012c(e, gift_id));
    then gift_value_for_2012_ratio(e, gift_id, v);
}
rule GiftValueRatioSplitRule(e: Estate, gift_id: Integer) defeasible {
    when gift_split_with_spouse_2012c(e, gift_id);
    when gift_half_value_reduced_2012c(e, gift_id, _, _);
    then gift_value_for_2012_ratio(e, gift_id, sum(collect all v: Money, h: Integer where gift_half_value_reduced_2012c(e, gift_id, h, v), empty: 0.00 USD));
}

// =====================================================================
// §2013(c)(1), (c)(2), (d), (f)
// =====================================================================

// the tax the (c)(1)(A) limitation starts from
pub relation estate_tax_after_2010_2012_2014(e: Estate, amount: Money) kind institutional {
    label en official "the tax imposed by section 2001 after deducting the credits provided for in sections 2010, 2012 and 2014, computed without regard to section 2013 (section 2013(c)(1)(A))";
}
rule EstateTaxAfter201020122014Rule(e: Estate, base: Money, c12: Money, c14: Money) defeasible {
    when estate_tax_after_unified_credit(e, base);
    when total_gift_tax_credit_2012(e, c12);
    when foreign_death_tax_credit(e, c14);
    then estate_tax_after_2010_2012_2014(e, max(0.00 USD, base - c12 - c14));
}
rule EstateTaxAfter20102012Rule(e: Estate, base: Money, c12: Money) defeasible {
    when estate_tax_after_unified_credit(e, base);
    when total_gift_tax_credit_2012(e, c12);
    when not_known(has_foreign_death_tax_credit(e));
    then estate_tax_after_2010_2012_2014(e, max(0.00 USD, base - c12));
}
rule EstateTaxAfter20102014Rule(e: Estate, base: Money, c14: Money) defeasible {
    when estate_tax_after_unified_credit(e, base);
    when not_known(has_gift_tax_credit_2012(e));
    when foreign_death_tax_credit(e, c14);
    then estate_tax_after_2010_2012_2014(e, max(0.00 USD, base - c14));
}
rule EstateTaxAfter2010Rule(e: Estate, base: Money) defeasible {
    when estate_tax_after_unified_credit(e, base);
    when not_known(has_gift_tax_credit_2012(e));
    when not_known(has_foreign_death_tax_credit(e));
    then estate_tax_after_2010_2012_2014(e, base);
}

// (c)(1) flush text: the charitable deduction in the counterfactual computation
@source(IRC_S2013_C, relation = formalizes, coverage = exact, quote = "the amount of such deduction shall be reduced by that part of such deduction which the value of such property transferred bears to the decedent's entire gross estate reduced by the deductions allowed under sections 2053 and 2054")
pub relation charitable_deduction_reduced_for_2013c1(decedent_estate: Estate, transferor_estate: Estate, amount: Money) kind institutional {
    label en official "the charitable deduction for the computation excluding the transferred property: reduced by the part which the transferred value bears to the gross estate less the section 2053 and 2054 deductions (section 2013(c)(1), flush)";
}
rule CharitableDeductionReducedFor2013cRule(decedent_estate: Estate, transferor_estate: Estate, charitable: Money, marital: Money, value: Money, gross: Money) defeasible {
    when charitable_and_marital_deduction_total_2012(decedent_estate, charitable, marital);
    when charitable > 0.00 USD;
    when prior_transfer_value_net_2013d(transferor_estate, decedent_estate, value);
    when gross_estate(decedent_estate, gross);
    then charitable_deduction_reduced_for_2013c1(decedent_estate, transferor_estate, charitable - div_round(charitable * (value / 1.00 USD), (gross - sum(collect all a: Money where expenses_indebtedness_and_taxes_total_2053(decedent_estate, a), empty: 0.00 USD) - sum(collect all a: Money where settlement_losses_deduction_2054(decedent_estate, a), empty: 0.00 USD)) / 1.00 USD, 2, "HALF_UP"));
}

// (c)(2): two or more transferors
pub relation estate_tax_excluding_all_prior_transfers(decedent_estate: Estate, amount: Money) kind empirical {
    label en unofficial "the tax computed by excluding from the gross estate the value of the property transferred by all the transferors, with the section 2013(c)(1) adjustment (section 2013(c)(2))";
}
relation two_or_more_transferors_2013(decedent_estate: Estate) kind institutional;
rule TwoOrMoreTransferorsRule(decedent_estate: Estate, t1: Estate, t2: Estate) defeasible {
    when eligible_prior_transferor(t1, decedent_estate);
    when eligible_prior_transferor(t2, decedent_estate);
    when t1 != t2;
    then two_or_more_transferors_2013(decedent_estate);
}
pub relation aggregate_prior_transfer_value_2013c2(decedent_estate: Estate, value: Money) kind institutional {
    label en official "the aggregate value of the property transferred to the decedent by the transferors (section 2013(c)(2))";
}
rule AggregatePriorTransferValueRule(decedent_estate: Estate, t: Estate) defeasible {
    when two_or_more_transferors_2013(decedent_estate);
    when eligible_prior_transferor(t, decedent_estate);
    then aggregate_prior_transfer_value_2013c2(decedent_estate, sum(collect all v: Money, x: Estate where eligible_prior_transferor(x, decedent_estate) and prior_transfer_value_net_2013d(x, decedent_estate, v), empty: 0.00 USD));
}
pub relation aggregate_limitation_2013c2(decedent_estate: Estate, amount: Money) kind institutional {
    label en official "the aggregate limitation: the tax after the credits over the tax excluding all the transferred property (section 2013(c)(2))";
}
rule AggregateLimitationRule(decedent_estate: Estate, after_credits: Money, excluding: Money) defeasible {
    when two_or_more_transferors_2013(decedent_estate);
    when estate_tax_after_2010_2012_2014(decedent_estate, after_credits);
    when estate_tax_excluding_all_prior_transfers(decedent_estate, excluding);
    then aggregate_limitation_2013c2(decedent_estate, max(0.00 USD, after_credits - excluding));
}
pub relation prior_transfer_credit_limit_applied_2013c(decedent_estate: Estate, transferor_estate: Estate, amount: Money) kind institutional {
    label en official "the limitation applied to the transferor: the section 2013(c)(1) limit, or for two or more transferors the aggregate limitation apportioned by the value each transferred (section 2013(c)(1), (2))";
}
rule LimitAppliedSingleTransferorRule(decedent_estate: Estate, transferor_estate: Estate, limit: Money) defeasible {
    when prior_transfer_credit_limitation(decedent_estate, transferor_estate, limit);
    when not_known(two_or_more_transferors_2013(decedent_estate));
    then prior_transfer_credit_limit_applied_2013c(decedent_estate, transferor_estate, limit);
}
@source(IRC_S2013_C, relation = formalizes, coverage = exact, quote = "The aggregate limitation so determined shall be apportioned in accordance with the value of the property transferred to the decedent by each transferor.")
rule LimitAppliedApportionedRule(decedent_estate: Estate, transferor_estate: Estate, aggregate: Money, total: Money, value: Money) defeasible {
    when aggregate_limitation_2013c2(decedent_estate, aggregate);
    when aggregate_prior_transfer_value_2013c2(decedent_estate, total);
    when eligible_prior_transferor(transferor_estate, decedent_estate);
    when prior_transfer_value_net_2013d(transferor_estate, decedent_estate, value);
    then prior_transfer_credit_limit_applied_2013c(decedent_estate, transferor_estate, div_round(aggregate * (value / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// (d): the value of the property transferred
pub enum ValueAdjustmentKind2013d {
    TransferTaxEffect;
    EncumbranceOrObligation;
}
pub relation prior_transfer_value_adjustment_2013d(transferor_estate: Estate, decedent_estate: Estate, kind: ValueAdjustmentKind2013d, amount: Money) kind empirical {
    label en unofficial "the reduction of the value of the property transferred: for the effect of the estate, succession, legacy or inheritance tax on the net value to the decedent ((d)(1)), or for an encumbrance or obligation taken into account as in determining a gift ((d)(2))";
}
pub relation marital_deduction_of_transferor_for_prior_transfer_2013d3(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind empirical {
    label en unofficial "the amount allowed under section 2056 as a deduction from the transferor's gross estate for the property transferred to the decedent spouse";
}
relation prior_transfer_value_base_2013(transferor_estate: Estate, decedent_estate: Estate, value: Money) kind institutional;
rule PriorTransferValueBaseRule(transferor_estate: Estate, decedent_estate: Estate, v: Money) defeasible {
    when prior_transfer_property_value(transferor_estate, decedent_estate, v);
    when not_known(section_2013f_applies(transferor_estate, decedent_estate));
    then prior_transfer_value_base_2013(transferor_estate, decedent_estate, v);
}
rule PriorTransferValueBaseWithout2032aRule(transferor_estate: Estate, decedent_estate: Estate, v: Money) defeasible {
    label en official "the value of the property is determined as if section 2032A did not apply (section 2013(f)(2))";
    when section_2013f_applies(transferor_estate, decedent_estate);
    when prior_transfer_value_without_2032a_2013f(transferor_estate, decedent_estate, v);
    then prior_transfer_value_base_2013(transferor_estate, decedent_estate, v);
}
relation prior_transfer_adjustments_other_2013d(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind institutional;
rule PriorTransferAdjustmentsOtherRule(transferor_estate: Estate, decedent_estate: Estate) defeasible {
    when prior_transfer_from(transferor_estate, decedent_estate);
    then prior_transfer_adjustments_other_2013d(transferor_estate, decedent_estate, sum(collect all a: Money, k: ValueAdjustmentKind2013d where prior_transfer_value_adjustment_2013d(transferor_estate, decedent_estate, k, a), empty: 0.00 USD));
}
relation prior_transfer_spousal_reduction_2013d3(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind institutional;
rule PriorTransferSpousalReductionRule(transferor_estate: Estate, decedent_estate: Estate, a: Money) defeasible {
    label en official "where the decedent was the transferor's spouse at the transferor's death the net value is reduced by the section 2056 deduction (section 2013(d)(3))";
    when prior_transfer_property_value_spousal_adjustment_applies(transferor_estate, decedent_estate);
    when marital_deduction_of_transferor_for_prior_transfer_2013d3(transferor_estate, decedent_estate, a);
    then prior_transfer_spousal_reduction_2013d3(transferor_estate, decedent_estate, a);
}
rule PriorTransferNoSpousalReductionRule(transferor_estate: Estate, decedent_estate: Estate) defeasible {
    when prior_transfer_from(transferor_estate, decedent_estate);
    when not_known(prior_transfer_property_value_spousal_adjustment_applies(transferor_estate, decedent_estate));
    then prior_transfer_spousal_reduction_2013d3(transferor_estate, decedent_estate, 0.00 USD);
}
relation has_marital_deduction_fact_2013d3(transferor_estate: Estate, decedent_estate: Estate) kind institutional;
rule HasMaritalDeductionFact2013d3Rule(transferor_estate: Estate, decedent_estate: Estate, a: Money) defeasible {
    when marital_deduction_of_transferor_for_prior_transfer_2013d3(transferor_estate, decedent_estate, a);
    then has_marital_deduction_fact_2013d3(transferor_estate, decedent_estate);
}
rule PriorTransferSpousalNoDeductionRule(transferor_estate: Estate, decedent_estate: Estate) defeasible {
    when prior_transfer_property_value_spousal_adjustment_applies(transferor_estate, decedent_estate);
    when not_known(has_marital_deduction_fact_2013d3(transferor_estate, decedent_estate));
    then prior_transfer_spousal_reduction_2013d3(transferor_estate, decedent_estate, 0.00 USD);
}
@source(IRC_S2013_D, relation = formalizes, coverage = exact, quote = "The value of property transferred to the decedent shall be the value used for the purpose of determining the Federal estate tax liability of the estate of the transferor but")
pub relation prior_transfer_value_net_2013d(transferor_estate: Estate, decedent_estate: Estate, value: Money) kind institutional {
    label en official "the value of the property transferred to the decedent: the value used for the transferor's Federal estate tax, less the tax effect, encumbrances and obligations, and (for the transferor's spouse) the marital deduction (section 2013(d))";
}
rule PriorTransferValueNetRule(transferor_estate: Estate, decedent_estate: Estate, base: Money, others: Money, spousal: Money) defeasible {
    when prior_transfer_value_base_2013(transferor_estate, decedent_estate, base);
    when prior_transfer_adjustments_other_2013d(transferor_estate, decedent_estate, others);
    when prior_transfer_spousal_reduction_2013d3(transferor_estate, decedent_estate, spousal);
    then prior_transfer_value_net_2013d(transferor_estate, decedent_estate, max(0.00 USD, base - others - spousal));
}

// (f): section 2032A additional tax within two years
pub relation additional_tax_2032a_within_two_years_2013f(transferor_estate: Estate, decedent_estate: Estate, prop: Asset, amount: Money) kind institutional {
    label en official "the section 2032A(c) additional tax on the transferor's property imposed before the date 2 years after the decedent's death (section 2013(f))";
}
pub relation transferor_additional_tax_2032a_imposed_2013f(transferor_estate: Estate, prop: Asset, amount: Money, on: Date) kind empirical {
    label en unofficial "the section 2032A(c) additional tax on the transferor's property, as computed in the transferor's own estate, imposed on the date (asserted: reading the transferor's own recapture computation here would make the credit depend on its own estate tax, TECH-GAPS G3622)";
}
rule AdditionalTax2032aWithinTwoYearsRule(transferor_estate: Estate, decedent_estate: Estate, prop: Asset, on: Date, amount: Money, dd: Date) defeasible {
    when transferor_additional_tax_2032a_imposed_2013f(transferor_estate, prop, amount, on);
    when prior_transfer_from(transferor_estate, decedent_estate);
    when date_of_death(decedent_estate, dd);
    when on < add_calendar_period(dd, 2 calendar_year);
    then additional_tax_2032a_within_two_years_2013f(transferor_estate, decedent_estate, prop, amount);
}
relation section_2013f_applies(transferor_estate: Estate, decedent_estate: Estate) kind institutional;
rule Section2013fAppliesRule(transferor_estate: Estate, decedent_estate: Estate, prop: Asset, a: Money) defeasible {
    when additional_tax_2032a_within_two_years_2013f(transferor_estate, decedent_estate, prop, a);
    then section_2013f_applies(transferor_estate, decedent_estate);
}
pub relation prior_transfer_value_without_2032a_2013f(transferor_estate: Estate, decedent_estate: Estate, value: Money) kind empirical {
    label en unofficial "the value of the property transferred, determined as if section 2032A did not apply (section 2013(f)(2))";
}
pub relation transferor_taxable_estate_without_2032a_2013f(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind empirical {
    label en unofficial "the amount of the transferor's taxable estate determined as if section 2032A did not apply (section 2013(f)(2))";
}
@source(IRC_S2013_F, relation = formalizes, coverage = exact, quote = "the additional tax imposed by section 2032A(c) shall be treated as a Federal estate tax payable with respect to the estate of the transferor")
pub relation federal_estate_tax_with_2013f(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind institutional {
    label en official "the Federal estate tax paid by the transferor's estate, plus the section 2032A additional tax imposed within 2 years of the decedent's death (section 2013(f)(1))";
}
rule FederalEstateTaxWith2013fRule(transferor_estate: Estate, decedent_estate: Estate, base: Money) defeasible {
    when federal_estate_tax_paid_for_2013b(transferor_estate, base);
    when prior_transfer_from(transferor_estate, decedent_estate);
    when section_2013f_applies(transferor_estate, decedent_estate);
    then federal_estate_tax_with_2013f(transferor_estate, decedent_estate, base + sum(collect all a: Money, p: Asset where additional_tax_2032a_within_two_years_2013f(transferor_estate, decedent_estate, p, a), empty: 0.00 USD));
}
rule FederalEstateTaxNo2013fRule(transferor_estate: Estate, decedent_estate: Estate, base: Money) defeasible {
    when federal_estate_tax_paid_for_2013b(transferor_estate, base);
    when prior_transfer_from(transferor_estate, decedent_estate);
    when not_known(section_2013f_applies(transferor_estate, decedent_estate));
    then federal_estate_tax_with_2013f(transferor_estate, decedent_estate, base);
}
relation transferor_taxable_estate_for_2013(transferor_estate: Estate, decedent_estate: Estate, amount: Money) kind institutional;
rule TransferorTaxableEstateFor2013Rule(transferor_estate: Estate, decedent_estate: Estate, amount: Money) defeasible {
    when transferor_taxable_estate(transferor_estate, amount);
    when prior_transfer_from(transferor_estate, decedent_estate);
    when not_known(section_2013f_applies(transferor_estate, decedent_estate));
    then transferor_taxable_estate_for_2013(transferor_estate, decedent_estate, amount);
}
rule TransferorTaxableEstateWithout2032aRule(transferor_estate: Estate, decedent_estate: Estate, amount: Money) defeasible {
    when section_2013f_applies(transferor_estate, decedent_estate);
    when transferor_taxable_estate_without_2032a_2013f(transferor_estate, decedent_estate, amount);
    then transferor_taxable_estate_for_2013(transferor_estate, decedent_estate, amount);
}

// =====================================================================
// §2014(c)(2), (f), (h)
// =====================================================================

pub relation foreign_taxed_property_reduction_2014c2(e: Estate, country: Text, amount: Money) kind empirical {
    label en unofficial "the amount by which the value of the foreign-taxed property in the gross estate is reduced to reflect, in accordance with regulations, the deductions allowed for it under sections 2055 and 2056 (section 2014(c)(2))";
}
pub relation property_deducted_under_2053d_2014f(e: Estate, country: Text, value: Money) kind empirical {
    label en unofficial "the value of the property in respect of which the section 2053(d) deduction is allowed (section 2014(f))";
}
@source(IRC_S2014_F, relation = formalizes, coverage = exact, quote = "shall not include any property in respect of which such deduction is allowed under section 2053(d)")
pub relation foreign_taxed_property_excluded_2014f(e: Estate, country: Text, value: Money) kind institutional {
    label en official "property for which the section 2053(d) foreign death tax deduction is taken is not foreign-taxed property for the credit (section 2014(f))";
}
rule ForeignTaxedPropertyExcluded2014fRule(e: Estate, country: Text, v: Money) defeasible {
    when foreign_death_tax_deduction_elected_2053d(e);
    when property_deducted_under_2053d_2014f(e, country, v);
    then foreign_taxed_property_excluded_2014f(e, country, v);
}
@source(IRC_S2014_C, relation = formalizes, coverage = exact, quote = "The values referred to in the ratio stated in subsection (b)(2) are the values determined under this chapter")
pub relation foreign_taxed_property_value_2014c2(e: Estate, country: Text, value: Money) kind institutional {
    label en official "the value of the foreign-taxed property in the gross estate for the ratio: as determined under chapter 11, reduced for the charitable and marital deductions and by the property deducted under section 2053(d) (section 2014(c)(2), (f))";
}
rule ForeignTaxedPropertyValueRule(e: Estate, country: Text, v: Money) defeasible {
    when foreign_taxed_property_in_gross_estate(e, country, v);
    then foreign_taxed_property_value_2014c2(e, country, max(0.00 USD, v
        - sum(collect all a: Money where foreign_taxed_property_reduction_2014c2(e, country, a), empty: 0.00 USD)
        - sum(collect all a: Money where foreign_taxed_property_excluded_2014f(e, country, a), empty: 0.00 USD)));
}

// (h): reciprocity for certain alien residents
pub external judgment relation president_finds_no_similar_credit_2014h1(country: Text) {
    authority President;
    label en official "the foreign country, in imposing death taxes, does not allow citizens of the United States resident there a credit similar to the credit of subsection (a) (section 2014(h)(1))";
}
pub relation foreign_country_did_not_act_on_request_2014h2(country: Text) kind empirical {
    label en unofficial "the foreign country, when requested by the United States, has not acted to provide a similar credit (section 2014(h)(2))";
}
pub external judgment relation president_finds_public_interest_2014h3(country: Text) {
    authority President;
    label en official "it is in the public interest to allow the credit to citizens or subjects of the country only if it allows a similar credit (section 2014(h)(3))";
}
relation proclamation_conditions_2014h(country: Text) kind institutional;
rule ProclamationConditions2014hRule(country: Text) defeasible {
    when president_finds_no_similar_credit_2014h1(country);
    when foreign_country_did_not_act_on_request_2014h2(country);
    when president_finds_public_interest_2014h3(country);
    then proclamation_conditions_2014h(country);
}
pub relation president_proclaims_similar_credit_condition_2014h(country: Text, w: Interval<Instant>) kind empirical {
    label en unofficial "the President proclaims that for citizens or subjects of the country dying while the proclamation is in effect the credit is allowed only if the country allows a similar credit to citizens of the United States resident there";
}
pub relation similar_credit_condition_in_effect_2014h(country: Text) kind institutional {
    label en official "the credit for citizens or subjects of the country is allowed only if the country allows a similar credit (section 2014(h))";
}
@source(IRC_S2014_H, relation = formalizes, coverage = exact, quote = "the President shall proclaim that, in the case of citizens or subjects of such foreign country dying while the proclamation remains in effect")
rule PresidentProclaimsSimilarCreditConditionPower(country: Text, w: Interval<Instant>) strict {
    label en official "on the three findings the President proclaims that the credit is allowed only against reciprocity (section 2014(h))";
    when president_proclaims_similar_credit_condition_2014h(country, w);
    then power PresidentProclamation2014h {
        holder President;
        over country;
        exercise president_proclaims_similar_credit_condition_2014h(country, w);
        valid_when proclamation_conditions_2014h(country);
        effect create(similar_credit_condition_in_effect_2014h(country));
        window w;
    };
}
pub relation decedent_citizen_or_subject_of_2014h(e: Estate, country: Text) kind empirical {
    label en unofficial "the decedent was a citizen or subject of the foreign country";
}
pub relation country_allows_similar_credit_2014h(country: Text) kind empirical {
    label en unofficial "the foreign country allows a similar credit to citizens of the United States resident in it at the time of death";
}
@source(IRC_S2014_H, relation = formalizes, coverage = exact, quote = "the credit under subsection (a) shall be allowed only if such foreign country allows such a similar credit")
pub relation credit_denied_2014h(e: Estate, country: Text) kind institutional {
    label en official "the section 2014(a) credit is not allowed: the decedent was a citizen or subject of a country under a proclamation and the country allows no similar credit (section 2014(h))";
}
rule CreditDenied2014hRule(e: Estate, country: Text) defeasible {
    when decedent_citizen_or_subject_of_2014h(e, country);
    when similar_credit_condition_in_effect_2014h(country);
    when not_known(country_allows_similar_credit_2014h(country));
    then credit_denied_2014h(e, country);
}

// =====================================================================
// §2053(c)(1)(A)-(D): limitations on the deductions
// =====================================================================

pub relation claim_is_promise_to_make_charitable_gift_2053c1a(e: Estate, amount: Money) kind empirical {
    label en unofficial "the claim is founded on a promise or agreement of the decedent to make a contribution or gift to or for the use of a donee described in section 2055 (section 2053(c)(1)(A))";
}
pub relation pledge_allowable_as_2055_bequest_2053c1a(e: Estate, amount: Money, allowable: Money) kind empirical {
    label en unofficial "the amount that would be allowable as a section 2055 deduction if the promise or agreement were a bequest";
}
@source(IRC_S2053_C, relation = formalizes, coverage = exact, quote = "the deduction for such claims shall not be so limited, but shall be limited to the extent that it would be allowable as a deduction under section 2055 if such promise or agreement constituted a bequest")
rule DeductibleClaimCharitablePledgeRule(e: Estate, amount: Money, allowable: Money) defeasible {
    label en official "a claim on the decedent's promise to make a charitable gift is deductible to the extent it would be under section 2055 as a bequest, not limited by consideration (section 2053(c)(1)(A))";
    when claims_against_estate(e, amount);
    when claim_is_promise_to_make_charitable_gift_2053c1a(e, amount);
    when pledge_allowable_as_2055_bequest_2053c1a(e, amount, allowable);
    when not_known(deduction_barred_2053c1(e, amount));
    then deductible_claim_2053(e, min(amount, allowable));
}
pub relation item_is_postdeath_income_tax_2053c1b(e: Estate, amount: Money) kind empirical {
    label en unofficial "the item is an income tax on income received after the decedent's death (section 2053(c)(1)(B))";
}
pub relation item_is_unaccrued_property_tax_2053c1b(e: Estate, amount: Money) kind empirical {
    label en unofficial "the item is a property tax not accrued before the decedent's death (section 2053(c)(1)(B))";
}
pub relation item_is_estate_or_inheritance_tax_2053c1b(e: Estate, amount: Money) kind empirical {
    label en unofficial "the item is an estate, succession, legacy or inheritance tax (section 2053(c)(1)(B))";
}
pub relation claim_by_remainderman_on_2044_property_2053c1c(e: Estate, amount: Money) kind empirical {
    label en unofficial "the claim is by a remainderman relating to property described in section 2044 (section 2053(c)(1)(C))";
}
pub relation item_is_interest_on_6166_deferred_tax_2053c1d(e: Estate, amount: Money) kind empirical {
    label en unofficial "the item is interest under section 6601 on an unpaid portion of the section 2001 tax for a period during which an extension under section 6166 is in effect (section 2053(c)(1)(D))";
}
pub relation foreign_death_tax_item_2053d(e: Estate, amount: Money) kind empirical {
    label en unofficial "the item is a foreign death tax for which the executor elected the section 2053(d) deduction";
}
@source(IRC_S2053_C, relation = formalizes, coverage = exact, quote = "shall not be deductible under this section")
pub relation deduction_barred_2053c1(e: Estate, amount: Money) kind institutional {
    label en official "no deduction under section 2053 for the item: postdeath income tax, unaccrued property tax, transfer tax, a remainderman's claim on section 2044 property, or interest on a section 6166 deferral (section 2053(c)(1)(B)-(D))";
}
rule BarredPostdeathIncomeTaxRule(e: Estate, amount: Money) defeasible {
    when item_is_postdeath_income_tax_2053c1b(e, amount);
    then deduction_barred_2053c1(e, amount);
}
rule BarredUnaccruedPropertyTaxRule(e: Estate, amount: Money) defeasible {
    when item_is_unaccrued_property_tax_2053c1b(e, amount);
    then deduction_barred_2053c1(e, amount);
}
rule BarredTransferTaxRule(e: Estate, amount: Money) defeasible {
    label en official "an estate, succession, legacy or inheritance tax is not deductible under this section, save the section 2053(d) foreign tax election (section 2053(c)(1)(B), (d)(1))";
    when item_is_estate_or_inheritance_tax_2053c1b(e, amount);
    when not_known(foreign_death_tax_item_2053d(e, amount));
    then deduction_barred_2053c1(e, amount);
}
rule BarredRemaindermanClaimRule(e: Estate, amount: Money) defeasible {
    when claim_by_remainderman_on_2044_property_2053c1c(e, amount);
    then deduction_barred_2053c1(e, amount);
}
rule BarredSection6166InterestRule(e: Estate, amount: Money) defeasible {
    when item_is_interest_on_6166_deferred_tax_2053c1d(e, amount);
    then deduction_barred_2053c1(e, amount);
}

// =====================================================================
// §2053(b): administration of property not subject to claims
// =====================================================================

pub relation nonprobate_administration_expense_2053b(e: Estate, item: Asset, amount: Money, paid_on: Date) kind empirical {
    label en unofficial "an expense incurred in administering property not subject to claims which is included in the gross estate, paid on the date (section 2053(b))";
}
pub relation nonprobate_expense_allowable_as_if_subject_to_claims_2053b(e: Estate, item: Asset) kind empirical {
    label en unofficial "the expense would be allowable under subsection (a) if the property were subject to claims";
}
pub relation assessment_period_expiry_2053b(e: Estate, d: Date) kind empirical {
    label en unofficial "the date on which the period of limitation for assessment under section 6501 expires";
}
relation deductible_nonprobate_item_2053b(e: Estate, item: Asset, amount: Money) kind institutional;
@source(IRC_S2053_B, relation = formalizes, coverage = exact, quote = "there shall be deducted in determining the taxable estate amounts representing expenses incurred in administering property not subject to claims which is included in the gross estate")
rule DeductibleNonprobateItemRule(e: Estate, item: Asset, amount: Money, paid: Date, expiry: Date) defeasible {
    label en official "the expense of administering property not subject to claims, allowable as under (a) and paid before the assessment period expires (section 2053(b))";
    when nonprobate_administration_expense_2053b(e, item, amount, paid);
    when nonprobate_expense_allowable_as_if_subject_to_claims_2053b(e, item);
    when assessment_period_expiry_2053b(e, expiry);
    when paid <= expiry;
    when not_known(deduction_barred_2053c1(e, amount));
    then deductible_nonprobate_item_2053b(e, item, amount);
}
pub relation deductible_nonprobate_administration_2053b(e: Estate, amount: Money) kind institutional {
    label en official "the total of the expenses of administering property not subject to claims that are deductible (section 2053(b))";
}
rule DeductibleNonprobateAdministrationRule(e: Estate, item: Asset, amount: Money) defeasible {
    when deductible_nonprobate_item_2053b(e, item, amount);
    then deductible_nonprobate_administration_2053b(e, sum(collect all a: Money, i: Asset where deductible_nonprobate_item_2053b(e, i, a), empty: 0.00 USD));
}
rule Has2053ItemNonprobateRule(e: Estate) defeasible {
    when deductible_nonprobate_administration_2053b(e, _);
    then has_2053_item(e);
}
rule Has2053ItemForeignDeathTaxRule(e: Estate) defeasible {
    when deductible_foreign_death_tax_2053d(e, _);
    then has_2053_item(e);
}

// =====================================================================
// §2053(c)(2): the cap on the subsection (a) amounts
// =====================================================================

pub relation property_subject_to_claims_value_2053c2(e: Estate, value: Money) kind empirical {
    label en unofficial "the value at the decedent's death of the property subject to claims (property included in the gross estate which would bear the burden of the deductions), reduced by the section 2054 deduction attributable to it (section 2053(c)(2))";
}
pub relation deduction_amount_paid_before_return_due_2053c2(e: Estate, amount: Money) kind empirical {
    label en unofficial "the part of the subsection (a) deductions that represents amounts paid before the date prescribed for filing the estate tax return";
}
relation section_2053a_capped_2053(e: Estate, amount: Money) kind institutional;
relation has_property_subject_to_claims_value_2053c2(e: Estate) kind institutional;
rule HasPropertySubjectToClaimsValueRule(e: Estate, v: Money) defeasible {
    when property_subject_to_claims_value_2053c2(e, v);
    then has_property_subject_to_claims_value_2053c2(e);
}
@source(IRC_S2053_C, relation = formalizes, coverage = exact, quote = "there shall be disallowed the amount by which the deductions specified therein exceed the value, at the time of the decedent's death, of property subject to claims")
rule Section2053aCappedRule(e: Estate, gross: Money, psc: Money) defeasible {
    label en official "the subsection (a) deductions in excess of the value of the property subject to claims are disallowed, except amounts paid before the return is due (section 2053(c)(2))";
    when section_2053a_gross_2053(e, gross);
    when property_subject_to_claims_value_2053c2(e, psc);
    then section_2053a_capped_2053(e, gross - max(0.00 USD, max(0.00 USD, gross - psc) - sum(collect all a: Money where deduction_amount_paid_before_return_due_2053c2(e, a), empty: 0.00 USD)));
}
rule Section2053aUncappedRule(e: Estate, gross: Money) defeasible {
    when section_2053a_gross_2053(e, gross);
    when not_known(has_property_subject_to_claims_value_2053c2(e));
    then section_2053a_capped_2053(e, gross);
}

// =====================================================================
// §2053(d): election to deduct foreign death taxes
// =====================================================================

pub relation foreign_death_tax_paid_on_charitable_transfer_2053d1(e: Estate, country: Text, amount: Money) kind empirical {
    label en unofficial "an estate, succession, legacy or inheritance tax imposed by and actually paid to the foreign country, in respect of property situated within it and included in the gross estate, upon a transfer by the decedent for a section 2055 use (amount as determined under the regulations) (section 2053(d)(1))";
}
pub relation decrease_in_tax_borne_by_noncharitable_transferees_2053d2(e: Estate) kind empirical {
    label en unofficial "a decrease in the section 2001 tax resulting from the deduction would benefit transferees other than those described in section 2055 or 2106(a)(2)";
}
pub relation estate_tax_equitably_apportioned_among_transferees_2053d2(e: Estate) kind empirical {
    label en unofficial "the tax imposed by section 2001 is equitably apportioned among all the transferees, including the charitable ones (section 2053(d)(2))";
}
relation decrease_inures_solely_to_charity_2053d2(e: Estate) kind institutional;
rule DecreaseInuresSolelyToCharityRule(e: Estate, country: Text, amount: Money) defeasible {
    label en official "the decrease in tax inures solely for the benefit of the charitable transferees (section 2053(d)(2))";
    when foreign_death_tax_paid_on_charitable_transfer_2053d1(e, country, amount);
    when not_known(decrease_in_tax_borne_by_noncharitable_transferees_2053d2(e));
    then decrease_inures_solely_to_charity_2053d2(e);
}
rule DecreaseInuresApportionedRule(e: Estate, country: Text, amount: Money) defeasible {
    label en official "where the tax is equitably apportioned, any decrease in tax the noncharitable transferees must pay is disregarded (section 2053(d)(2))";
    when foreign_death_tax_paid_on_charitable_transfer_2053d1(e, country, amount);
    when estate_tax_equitably_apportioned_among_transferees_2053d2(e);
    then decrease_inures_solely_to_charity_2053d2(e);
}
relation foreign_death_tax_deduction_conditions_2053d(e: Estate) kind institutional;
rule ForeignDeathTaxDeductionConditionsRule(e: Estate, country: Text, amount: Money) defeasible {
    label en official "a citizen or resident decedent, a foreign tax actually paid on a charitable transfer, and a decrease that inures solely to the charitable transferees (section 2053(d)(1), (2))";
    when decedent_citizen_or_resident(e);
    when foreign_death_tax_paid_on_charitable_transfer_2053d1(e, country, amount);
    when decrease_inures_solely_to_charity_2053d2(e);
    then foreign_death_tax_deduction_conditions_2053d(e);
}
pub relation foreign_death_tax_deduction_election_made_2053d(e: Estate, x: Person, w: Interval<Instant>) kind empirical {
    label en unofficial "the executor elects, before the assessment period expires, to deduct the foreign death tax (section 2053(d)(1))";
}
pub relation foreign_death_tax_deduction_elected_2053d(e: Estate) kind institutional {
    label en official "the executor's election to deduct foreign death taxes is in effect (section 2053(d)(1))";
}
@source(IRC_S2053_D, relation = formalizes, coverage = exact, quote = "the value of the taxable estate may be determined, if the executor so elects before the expiration of the period of limitation for assessment provided in section 6501")
rule ExecutorElectsForeignDeathTaxDeductionPower(e: Estate, x: Person, w: Interval<Instant>) strict {
    label en official "the executor may elect to deduct the foreign death tax on a charitable transfer notwithstanding subsection (c)(1)(B) (section 2053(d)(1))";
    when executor_of(e, x, w);
    when foreign_death_tax_deduction_election_made_2053d(e, x, w);
    then power ExecutorElectsForeignDeathTaxDeduction {
        holder x;
        over e;
        exercise foreign_death_tax_deduction_election_made_2053d(e, x, w);
        valid_when foreign_death_tax_deduction_conditions_2053d(e);
        effect create(foreign_death_tax_deduction_elected_2053d(e));
        window w;
    };
}
@source(IRC_S2053_D, relation = formalizes, coverage = exact, quote = "by deducting from the value of the gross estate the amount")
pub relation deductible_foreign_death_tax_2053d(e: Estate, amount: Money) kind institutional {
    label en official "the foreign death tax deduction under the executor's election (section 2053(d)(1))";
}
rule DeductibleForeignDeathTaxRule(e: Estate, country: Text, amount: Money) defeasible {
    when foreign_death_tax_deduction_elected_2053d(e);
    when foreign_death_tax_paid_on_charitable_transfer_2053d1(e, country, amount);
    then deductible_foreign_death_tax_2053d(e, sum(collect all a: Money, c: Text where foreign_death_tax_paid_on_charitable_transfer_2053d1(e, c, a), empty: 0.00 USD));
}
pub relation treaty_credit_waived_2053d3a(e: Estate, country: Text) kind institutional {
    label en official "the election waives the right to claim a credit under a death tax convention with the country for the tax deducted (section 2053(d)(3)(A))";
}
rule TreatyCreditWaivedRule(e: Estate, country: Text, amount: Money) defeasible {
    when foreign_death_tax_deduction_elected_2053d(e);
    when foreign_death_tax_paid_on_charitable_transfer_2053d1(e, country, amount);
    then treaty_credit_waived_2053d3a(e, country);
}

// the section 2053 total: the capped subsection (a) amounts plus (b) and (d)
rule ExpensesIndebtednessAndTaxesTotalWith2053Rule(e: Estate, capped: Money) defeasible {
    label en official "the section 2053 deduction: the subsection (a) amounts as capped by (c)(2), plus the subsection (b) expenses and the (d) foreign death tax (section 2053(a)-(d))";
    when section_2053a_capped_2053(e, capped);
    then expenses_indebtedness_and_taxes_total_2053(e, capped
        + sum(collect all a: Money where deductible_nonprobate_administration_2053b(e, a), empty: 0.00 USD)
        + sum(collect all a: Money where deductible_foreign_death_tax_2053d(e, a), empty: 0.00 USD));
}
