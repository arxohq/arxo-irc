// Estate and gift -- WIRE-7 (26.09.2026, DECISION-0379, implemented_unverified).
//
// Each relation below was a local contract (a fact or an underived institutional placeholder naming its owner). The owner package
// publishes the same concept, so the local relation is now DERIVED from the owner's `pub` relation; the case-fact channel stays valid
// (an institutional relation may still be asserted, DECISIONS Д-15/Д-19), so existing scenarios are unchanged. Nothing is restated.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Individual,
    covered_expatriate,
};

rule W7CoveredExpatriateFromInternational strict {
    label en official "section 2801(f): a covered expatriate is the section 877A(g)(1) expatriate of the owner package `international`";
    for individual: Individual;
    when us.irc.international::covered_expatriate_877ag1(individual);
    then covered_expatriate(individual);
}

