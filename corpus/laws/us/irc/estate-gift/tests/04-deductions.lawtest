// Sections 2053, 2056 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2053-01-FUNERAL-EXPENSES-DEDUCTED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": funeral_expenses(entity_ref("urn:test:s2053:t1#e"), 15000 USD) { origin case_input; }
    }
    evaluate truth(estate_deduction_allowed(entity_ref("urn:test:s2053:t1#e"), ExpensesIndebtednessAndTaxes, 15000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2056-01-MARITAL-DEDUCTION-OUTRIGHT-BEQUEST" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": interest_passes_to_surviving_spouse(entity_ref("urn:test:s2056:t1#e"), entity_ref("urn:test:s2056:t1#item"), 400000 USD) { origin case_input; }
    }
    evaluate truth(estate_deduction_allowed(entity_ref("urn:test:s2056:t1#e"), MaritalDeduction, 400000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2056-02-TERMINABLE-INTEREST-DISQUALIFIED-WITHOUT-QTIP" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": interest_passes_to_surviving_spouse(entity_ref("urn:test:s2056:t2#e"), entity_ref("urn:test:s2056:t2#item"), 400000 USD) { origin case_input; }
        assert "f1": terminable_interest(entity_ref("urn:test:s2056:t2#e"), entity_ref("urn:test:s2056:t2#item")) { origin case_input; }
        assert "f2": other_person_may_possess_after_termination(entity_ref("urn:test:s2056:t2#e"), entity_ref("urn:test:s2056:t2#item")) { origin case_input; }
    }
    evaluate truth(estate_deduction_allowed(entity_ref("urn:test:s2056:t2#e"), MaritalDeduction, 400000 USD));
    expect truth_status == NEITHER;
}

test "S2056-03-QTIP-ELECTION-SAVES-TERMINABLE-INTEREST" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": interest_passes_to_surviving_spouse(entity_ref("urn:test:s2056:t3#e"), entity_ref("urn:test:s2056:t3#item"), 400000 USD) { origin case_input; }
        assert "f1": terminable_interest(entity_ref("urn:test:s2056:t3#e"), entity_ref("urn:test:s2056:t3#item")) { origin case_input; }
        assert "f2": other_person_may_possess_after_termination(entity_ref("urn:test:s2056:t3#e"), entity_ref("urn:test:s2056:t3#item")) { origin case_input; }
        assert "f3": executor_of(entity_ref("urn:test:s2056:t3#e"), entity_ref("urn:test:s2056:t3#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f4": surviving_spouse_qualifying_income_interest_for_life(entity_ref("urn:test:s2056:t3#e"), entity_ref("urn:test:s2056:t3#item")) { origin case_input; }
        assert "f5": qtip_election_made(entity_ref("urn:test:s2056:t3#e"), entity_ref("urn:test:s2056:t3#item")) { origin case_input; }
    }
    evaluate truth(estate_deduction_allowed(entity_ref("urn:test:s2056:t3#e"), MaritalDeduction, 400000 USD));
    expect truth_status == TRUE_ONLY;
}
