// Sections 2031-2042 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2033-01-OUTRIGHT-INTEREST-VALUED-AT-DEATH" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": value_at_death(entity_ref("urn:test:s2033:t1#e"), entity_ref("urn:test:s2033:t1#house"), 500000 USD) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2033:t1#e"), entity_ref("urn:test:s2033:t1#house"), 500000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2032-01-ALTERNATE-VALUATION-DISPOSED-WITHIN-6-MONTHS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_of(entity_ref("urn:test:s2032:t1#e"), entity_ref("urn:test:s2032:t1#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f1": alternate_valuation_return_filed(entity_ref("urn:test:s2032:t1#e")) { origin case_input; }
        assert "f2": alternate_valuation_decreases_gross_estate(entity_ref("urn:test:s2032:t1#e")) { origin case_input; }
        assert "f3": alternate_valuation_decreases_tax(entity_ref("urn:test:s2032:t1#e")) { origin case_input; }
        assert "f4": alternate_valuation_return_timely(entity_ref("urn:test:s2032:t1#e")) { origin case_input; }
        assert "f5": disposed_within_6_months(entity_ref("urn:test:s2032:t1#e"), entity_ref("urn:test:s2032:t1#stock")) { origin case_input; }
        assert "f6": value_at_disposition(entity_ref("urn:test:s2032:t1#e"), entity_ref("urn:test:s2032:t1#stock"), 400000 USD) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2032:t1#e"), entity_ref("urn:test:s2032:t1#stock"), 400000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2032-02-ELECTION-INVALID-DOES-NOT-DECREASE-TAX" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_of(entity_ref("urn:test:s2032:t2#e"), entity_ref("urn:test:s2032:t2#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f1": alternate_valuation_return_filed(entity_ref("urn:test:s2032:t2#e")) { origin case_input; }
        assert "f2": alternate_valuation_decreases_gross_estate(entity_ref("urn:test:s2032:t2#e")) { origin case_input; }
        assert "f3": alternate_valuation_return_timely(entity_ref("urn:test:s2032:t2#e")) { origin case_input; }
    }
    // alternate_valuation_decreases_tax not asserted: POWER_INVALID_EXERCISE.
    evaluate truth(alternate_valuation_elected(entity_ref("urn:test:s2032:t2#e")));
    expect truth_status == FALSE_ONLY;
}

test "S2035-01-GIFT-WITHIN-3-YEARS-OF-DEATH-INCLUDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": transferred_or_power_relinquished_within_3_years(entity_ref("urn:test:s2035:t1#e"), entity_ref("urn:test:s2035:t1#item")) { origin case_input; }
        assert "f1": would_be_included_under_2036_2037_2038_2042(entity_ref("urn:test:s2035:t1#e"), entity_ref("urn:test:s2035:t1#item")) { origin case_input; }
        assert "f2": value_at_death(entity_ref("urn:test:s2035:t1#e"), entity_ref("urn:test:s2035:t1#item"), 250000 USD) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2035:t1#e"), entity_ref("urn:test:s2035:t1#item"), 250000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2035-02-BONA-FIDE-SALE-NOT-INCLUDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": transferred_or_power_relinquished_within_3_years(entity_ref("urn:test:s2035:t2#e"), entity_ref("urn:test:s2035:t2#item")) { origin case_input; }
        assert "f1": would_be_included_under_2036_2037_2038_2042(entity_ref("urn:test:s2035:t2#e"), entity_ref("urn:test:s2035:t2#item")) { origin case_input; }
        assert "f2": bona_fide_sale_for_full_consideration(entity_ref("urn:test:s2035:t2#e"), entity_ref("urn:test:s2035:t2#item")) { origin case_input; }
        assert "f3": value_at_death(entity_ref("urn:test:s2035:t2#e"), entity_ref("urn:test:s2035:t2#item"), 250000 USD) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2035:t2#e"), entity_ref("urn:test:s2035:t2#item"), 250000 USD));
    expect truth_status == NEITHER;
}

test "S2040-01-QUALIFIED-JOINT-INTEREST-50-PERCENT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_joint_interest(entity_ref("urn:test:s2040:t1#e"), entity_ref("urn:test:s2040:t1#house")) { origin case_input; }
        assert "f1": joint_interest_total_value(entity_ref("urn:test:s2040:t1#e"), entity_ref("urn:test:s2040:t1#house"), 600000 USD) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2040:t1#e"), entity_ref("urn:test:s2040:t1#house"), 300000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2041-01-GENERAL-POWER-LAPSE-AT-5001-EXCEEDS-5-OR-5" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": power_lapsed_during_year(entity_ref("urn:test:s2041:t1#e"), entity_ref("urn:test:s2041:t1#fund")) { origin case_input; }
        assert "f1": lapsed_power_property_value(entity_ref("urn:test:s2041:t1#e"), entity_ref("urn:test:s2041:t1#fund"), 5001 USD) { origin case_input; }
        assert "f2": aggregate_value_of_fund_at_lapse(entity_ref("urn:test:s2041:t1#e"), entity_ref("urn:test:s2041:t1#fund"), 50000 USD) { origin case_input; }
    }
    // threshold = max(5000, 5% * 50000 = 2500) = 5000; 5001 > 5000, excess = 1.
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2041:t1#e"), entity_ref("urn:test:s2041:t1#fund"), 1 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2041-02-GENERAL-POWER-LAPSE-AT-5000-WITHIN-5-OR-5" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": power_lapsed_during_year(entity_ref("urn:test:s2041:t2#e"), entity_ref("urn:test:s2041:t2#fund")) { origin case_input; }
        assert "f1": lapsed_power_property_value(entity_ref("urn:test:s2041:t2#e"), entity_ref("urn:test:s2041:t2#fund"), 5000 USD) { origin case_input; }
        assert "f2": aggregate_value_of_fund_at_lapse(entity_ref("urn:test:s2041:t2#e"), entity_ref("urn:test:s2041:t2#fund"), 50000 USD) { origin case_input; }
    }
    evaluate truth(lapsed_power_within_5_or_5_exception(entity_ref("urn:test:s2041:t2#e"), entity_ref("urn:test:s2041:t2#fund")));
    expect truth_status == TRUE_ONLY;
}

