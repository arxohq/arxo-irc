    evaluate truth(qualified_disclaimer(entity_ref("urn:test:s2518c3:t58#p"), entity_ref("urn:test:s2518c3:t58#i")));
    expect truth_status == TRUE_ONLY;
}

test "S2518C3-02-TRANSFER-TO-OTHER-PERSONS-NOT-A-DISCLAIMER" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": written_transfer_of_entire_interest(entity_ref("urn:test:s2518c3:t59#p"), entity_ref("urn:test:s2518c3:t59#i")) { origin case_input; }
        assert "f1": transfer_meets_2518b2_and_b3_like_requirements(entity_ref("urn:test:s2518c3:t59#p"), entity_ref("urn:test:s2518c3:t59#i")) { origin case_input; }
    }
    evaluate truth(qualified_disclaimer(entity_ref("urn:test:s2518c3:t59#p"), entity_ref("urn:test:s2518c3:t59#i")));
    expect truth_status == NEITHER;
}
