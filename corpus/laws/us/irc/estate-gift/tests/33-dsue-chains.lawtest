        assert "g": gross_estate(entity_ref("urn:test:s33:d1b#e"), 8500000 USD) { origin case_input; }
        assert "d": estate_deduction_allowed(entity_ref("urn:test:s33:d1b#e"), ExpensesIndebtednessAndTaxes, 500000 USD) { origin case_input; }
        assert "x": dsue_gen1_examination_base(entity_ref("urn:test:s33:d1b#e"), 8200000 USD) { origin case_input; }
    }
    // recalculated = 13.99 - 8.2 = 5.79; final follows the recalculation.
    evaluate truth(dsue_gen1_final(entity_ref("urn:test:s33:d1b#e"), 5790000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

