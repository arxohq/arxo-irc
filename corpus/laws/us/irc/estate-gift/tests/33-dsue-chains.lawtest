        assert "h": last_deceased_is_gen2(entity_ref("urn:test:s33:sf#e"), entity_ref("urn:test:s33:d2f#e")) { origin case_input; }
        assert "sg": gross_estate(entity_ref("urn:test:s33:sf#e"), 31000000 USD) { origin case_input; }
        assert "sd": estate_deduction_allowed(entity_ref("urn:test:s33:sf#e"), ExpensesIndebtednessAndTaxes, 1000000 USD) { origin case_input; }
        assert "si": decedent_individual(entity_ref("urn:test:s33:sf#e"), entity_ref("urn:test:s33:sf#p")) { origin case_input; }
        assert "sy": us.irc.core::calendar_year_of(entity_ref("urn:test:s33:sf#y2020"), 2020) { origin case_input; }
        assert "st": taxable_gifts(entity_ref("urn:test:s33:sf#p"), entity_ref("urn:test:s33:sf#y2020"), 2000000 USD) { origin case_input; }
        // Top-bracket row bracket-12 of the pinned rate-schedule-2001c sidecar (lower $1M, base $345,800, rate 40%): mode:rules sidecars are not expanded by lower, so the row is a case fact.
        assert "br": bracket_2001c(32000000 USD, 1000000 USD, 345800 USD, 0.40) { origin case_input; }
        assert "br2": bracket_2001c(25790000 USD, 1000000 USD, 345800 USD, 0.40) { origin case_input; }
    }
    // base = 30 + 2 = 32; tentative = 345800 + 0.40 * 31 = 12745800.
    // gift tentative on 2 = 745800, wiped by the 10261800 credit -> payable 0.
    // after unified = 12745800 - 10261800 = 2484000; no ch.11 credits.
    evaluate truth(estate_tax(entity_ref("urn:test:s33:sf#e"), 2484000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S33-10-QDOT-FIRST-ROUND-TAX" {
    given {
        context { legal_time @2028-06-01; decision_time @2028-06-01T09:00:00-05:00; knowledge_time @2028-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "sg": gross_estate(entity_ref("urn:test:s33:sq#e"), 31000000 USD) { origin case_input; }
        assert "sd": estate_deduction_allowed(entity_ref("urn:test:s33:sq#e"), ExpensesIndebtednessAndTaxes, 1000000 USD) { origin case_input; }
        assert "si": decedent_individual(entity_ref("urn:test:s33:sq#e"), entity_ref("urn:test:s33:sq#p")) { origin case_input; }
        assert "sy": us.irc.core::calendar_year_of(entity_ref("urn:test:s33:sq#y2020"), 2020) { origin case_input; }
        assert "st": taxable_gifts(entity_ref("urn:test:s33:sq#p"), entity_ref("urn:test:s33:sq#y2020"), 2000000 USD) { origin case_input; }
        assert "q0": qdot_distribution_made(entity_ref("urn:test:s33:sq#e"), 1, entity_ref("urn:test:s33:sq#t"), @2028-06-01, 2000000 USD) { origin case_input; }
        // Top-bracket row bracket-12 of the pinned rate-schedule-2001c sidecar (lower $1M, base $345,800, rate 40%): mode:rules sidecars are not expanded by lower, so the row is a case fact.
        assert "br": bracket_2001c(34000000 USD, 1000000 USD, 345800 USD, 0.40) { origin case_input; }
        assert "br2": bracket_2001c(32000000 USD, 1000000 USD, 345800 USD, 0.40) { origin case_input; }
    }
    // base 32, with 34: tentative 13545800 - 12745800 = 800000.
    evaluate truth(qdot_tax_on_event_by_difference(entity_ref("urn:test:s33:sq#e"), 1, 800000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

