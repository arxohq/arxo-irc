// DSUE chains (module 33) and QDOT second round (module 18). Expected
// values are hand-computed from the pinned parameters and the 2001(c)
// table; the engine derives every figure.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S33-01-GEN1-PRELIMINARY-2025" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "e0": executor_of(entity_ref("urn:test:s33:d1#e"), entity_ref("urn:test:s33:d1#x"), [@2025-01-01, infinity)) { origin case_input; }
        assert "bx": basic_exclusion_amount_at_death(entity_ref("urn:test:s33:d1#e"), 13990000 USD) { origin case_input; }
        assert "e1": dsue_return_filed(entity_ref("urn:test:s33:d1#e")) { origin case_input; }
        assert "e2": dsue_return_timely(entity_ref("urn:test:s33:d1#e")) { origin case_input; }
        assert "e3": portability_elected(entity_ref("urn:test:s33:d1#e")) { origin case_input; }
        assert "g": gross_estate(entity_ref("urn:test:s33:d1#e"), 8500000 USD) { origin case_input; }
        assert "d": estate_deduction_allowed(entity_ref("urn:test:s33:d1#e"), ExpensesIndebtednessAndTaxes, 500000 USD) { origin case_input; }
    }
    // base = 8.5 - 0.5 = 8.0 (no gifts); DSUE = 13.99 - 8.0 = 5.99.
    evaluate truth(dsue_gen1_preliminary(entity_ref("urn:test:s33:d1#e"), 5990000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S33-02-GEN1-RECALCULATED-AND-FINAL" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
