test "S2603A1-01-TRANSFEREE-OF-TAXABLE-DISTRIBUTION-PAYS" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gst_transfer_kind(entity_ref("urn:test:s2603a1:t0#t"), TaxableDistribution) { origin case_input; }
        assert "f1": transferee_of(entity_ref("urn:test:s2603a1:t0#t"), entity_ref("urn:test:s2603a1:t0#c")) { origin case_input; }
    }
    evaluate truth(gst_tax_liable_person(entity_ref("urn:test:s2603a1:t0#t"), entity_ref("urn:test:s2603a1:t0#c")));
    expect truth_status == TRUE_ONLY;
}

