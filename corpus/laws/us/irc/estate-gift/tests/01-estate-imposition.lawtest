// Section 2001/2002 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2001-01-CITIZEN-DECEDENT-TAX-IMPOSED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s2001:t1#e")) { origin case_input; }
    }
    evaluate truth(estate_tax_imposed(entity_ref("urn:test:s2001:t1#e")));
    expect truth_status == TRUE_ONLY;
}

test "S2001-02-TENTATIVE-TAX-AT-RATE-BRACKET-BOUNDARY" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": taxable_estate(entity_ref("urn:test:s2001:t2#e"), 20000 USD) { origin case_input; }
    }
    // At exactly $20,000 (upper bound of bracket 2), tentative tax = $3,800.
    evaluate truth(tentative_tax(entity_ref("urn:test:s2001:t2#e"), 3800 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2001-03-TENTATIVE-TAX-ABOVE-ONE-MILLION-TOP-RATE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": taxable_estate(entity_ref("urn:test:s2001:t3#e"), 1500000 USD) { origin case_input; }
    }
    // $345,800 + 40% * (1,500,000 - 1,000,000) = 545,800
    evaluate truth(tentative_tax(entity_ref("urn:test:s2001:t3#e"), 545800 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2001-04-UNKNOWN-GROSS-ESTATE-UNDETERMINED-TAXABLE-ESTATE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    evaluate truth(taxable_estate(entity_ref("urn:test:s2001:t4#e"), 0 USD));
    expect truth_status == NEITHER;
}

test "S2002-01-EXECUTOR-DUTY-PERFORMED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s2002:t1#e")) { origin case_input; }
        assert "f1": executor_of(entity_ref("urn:test:s2002:t1#e"), entity_ref("urn:test:s2002:t1#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f2": estate_tax_paid(entity_ref("urn:test:s2002:t1#e")) { origin case_input; }
    }
    evaluate positions();
    expect position(ExecutorEstateTaxPaymentDuty, SATISFIED);
}

test "S2002-02-EXECUTOR-DUTY-VIOLATED" {
    given {
        context {
            legal_time @2030-01-01;
            decision_time @2030-01-01T09:00:00-05:00;
            knowledge_time @2030-01-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s2002:t2#e")) { origin case_input; }
        assert "f1": executor_of(entity_ref("urn:test:s2002:t2#e"), entity_ref("urn:test:s2002:t2#x"), [@2024-01-01, @2024-06-01)) { origin case_input; }
    }
    evaluate positions();
    expect position(ExecutorEstateTaxPaymentDuty, VIOLATED);
}
