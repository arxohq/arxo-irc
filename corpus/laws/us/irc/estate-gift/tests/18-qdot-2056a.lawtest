// Section 2056A (qualified domestic trust) scenarios (module 18). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2056A-01-EXECUTOR-ELECTION-ON-TIMELY-RETURN-IS-EFFECTIVE" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_of(entity_ref("urn:test:s2056a:t0#e"), entity_ref("urn:test:s2056a:t0#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f1": qdot_election_made_on_return(entity_ref("urn:test:s2056a:t0#e"), entity_ref("urn:test:s2056a:t0#t"), entity_ref("urn:test:s2056a:t0#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f2": estate_return_filed_on(entity_ref("urn:test:s2056a:t0#e"), @2025-09-01) { origin case_input; }
        assert "f3": estate_return_due_date_with_extensions(entity_ref("urn:test:s2056a:t0#e"), @2025-10-15) { origin case_input; }
        assert "f4": date_of_death(entity_ref("urn:test:s2056a:t0#e"), @2025-01-10) { origin case_input; }
    }
    evaluate truth(qdot_election_effective(entity_ref("urn:test:s2056a:t0#e"), entity_ref("urn:test:s2056a:t0#t")));
    expect truth_status == TRUE_ONLY;
}

