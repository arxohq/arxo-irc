test "S2056A-40-WITHHOLDING-PROVISION-DOES-NOT-DEFEAT-QUALIFYING-INCOME-INTEREST" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_of(entity_ref("urn:test:s2056a:t39#e"), entity_ref("urn:test:s2056a:t39#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f1": qdot_election_made_on_return(entity_ref("urn:test:s2056a:t39#e"), entity_ref("urn:test:s2056a:t39#t"), entity_ref("urn:test:s2056a:t39#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f2": estate_return_filed_on(entity_ref("urn:test:s2056a:t39#e"), @2025-09-01) { origin case_input; }
        assert "f3": estate_return_due_date_with_extensions(entity_ref("urn:test:s2056a:t39#e"), @2025-10-15) { origin case_input; }
        assert "f4": date_of_death(entity_ref("urn:test:s2056a:t39#e"), @2025-01-10) { origin case_input; }
        assert "f5": us_trustee_required_by_instrument_on(entity_ref("urn:test:s2056a:t39#t"), @2025-09-01) { origin case_input; }
        assert "f6": withholding_right_provided_by_instrument_on(entity_ref("urn:test:s2056a:t39#t"), @2025-09-01) { origin case_input; }
        assert "f7": trust_meets_collection_requirements_by_regulation_2056a2(entity_ref("urn:test:s2056a:t39#t"), @2025-09-01) { origin adjudicated; }
        assert "f8": property_transferred_to_trust_before_return(entity_ref("urn:test:s2056a:t39#e"), entity_ref("urn:test:s2056a:t39#item"), entity_ref("urn:test:s2056a:t39#t")) { origin case_input; }
        assert "f9": income_entitlement_impaired_only_by_qdot_withholding_provision(entity_ref("urn:test:s2056a:t39#e"), entity_ref("urn:test:s2056a:t39#item")) { origin case_input; }
    }
    evaluate truth(qualifying_income_interest_for_life_2056b7(entity_ref("urn:test:s2056a:t39#e"), entity_ref("urn:test:s2056a:t39#item")));
    expect truth_status == TRUE_ONLY;
}

