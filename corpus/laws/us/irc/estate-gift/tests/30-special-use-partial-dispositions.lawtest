// Section 2032A(c)(2)(D), (E) partial dispositions and timber scenarios (module 30). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2032AC2D1-01-PORTION-VALUE-IS-THE-PRO-RATA-SHARE" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": date_of_death(entity_ref("urn:test:s2032ac2d1:t0#e"), @2020-06-01) { origin case_input; }
        assert "f1": gross_estate(entity_ref("urn:test:s2032ac2d1:t0#e"), 1200000 USD) { origin case_input; }
        assert "f2": property_fair_market_value(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p"), 1000000 USD) { origin case_input; }
        assert "f3": qualified_real_property_value_for_use(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p"), 600000 USD) { origin case_input; }
        assert "f4": qualified_heir(entity_ref("urn:test:s2032ac2d1:t0#h"), entity_ref("urn:test:s2032ac2d1:t0#p"), entity_ref("urn:test:s2032ac2d1:t0#e")) { origin case_input; }
        assert "f5": qualified_use(entity_ref("urn:test:s2032ac2d1:t0#p"), Farming, entity_ref("urn:test:s2032ac2d1:t0#h"), entity_ref("urn:test:s2032ac2d1:t0#e")) { origin case_input; }
        assert "f6": designated_in_agreement(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p")) { origin case_input; }
        assert "f7": ownership_use_participation_years(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p"), 6.0) { origin case_input; }
        assert "f8": property_located_in_united_states(entity_ref("urn:test:s2032ac2d1:t0#p")) { origin case_input; }
        assert "f9": executor_of(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f10": special_use_valuation_election_made(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f11": special_use_valuation_agreement_signed_by_all_interested_persons(entity_ref("urn:test:s2032ac2d1:t0#e")) { origin case_input; }
        assert "f12": qualified_heir_disposes_of_interest(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p"), entity_ref("urn:test:s2032ac2d1:t0#h"), entity_ref("urn:test:s2032ac2d1:t0#o"), @2025-01-01) { origin case_input; }
        assert "f13": special_use_value(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p"), 400000 USD) { origin case_input; }
        assert "f14": adjusted_tax_difference_attributable_to_interest(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p"), 90000 USD) { origin case_input; }
        assert "f15": portion_disposed_2032a(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p"), entity_ref("urn:test:s2032ac2d1:t0#h"), 1, @2025-01-01, 0.25, 250000 USD) { origin case_input; }
    }
    evaluate truth(portion_use_value_2032ac2di(entity_ref("urn:test:s2032ac2d1:t0#e"), entity_ref("urn:test:s2032ac2d1:t0#p"), 1, 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}

