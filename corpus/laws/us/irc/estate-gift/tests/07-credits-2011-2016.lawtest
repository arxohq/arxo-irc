    // NEITHER, not a negative finding.
    evaluate truth(prior_transfer_credit(entity_ref("urn:test:s2013:t8#tr"), entity_ref("urn:test:s2013:t8#e"), 1.00 USD));
    expect truth_status == NEITHER;
}

// --- §2012: pre-1977 gift tax credit ----------------------------------------

test "S2012-01-PRE-1977-GIFT-CREDIT-RATIO" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_paid_before_1977(entity_ref("urn:test:s2012:t1#e"), 1) { origin case_input; }
        assert "f1": gift_tax_paid_on_gift_2012(entity_ref("urn:test:s2012:t1#e"), 1, 5000 USD) { origin case_input; }
        assert "f2": gift_value_reduced_2012b(entity_ref("urn:test:s2012:t1#e"), 1, 100000 USD) { origin case_input; }
        assert "f3": estate_tax_after_unified_credit(entity_ref("urn:test:s2012:t1#e"), 200000 USD) { origin case_input; }
        assert "f4": gross_estate(entity_ref("urn:test:s2012:t1#e"), 1000000 USD) { origin case_input; }
    }
    // Ratio limit = 200,000 * (100,000 / 1,000,000) = 20,000; actual tax
    // paid (5,000) is lower, so the credit is the lesser: 5,000.
    evaluate truth(gift_tax_credit_2012(entity_ref("urn:test:s2012:t1#e"), 1, 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §2014: foreign death tax credit -----------------------------------------

test "S2014-01-PER-COUNTRY-LIMIT-BINDS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": foreign_death_tax_paid(entity_ref("urn:test:s2014:t1#e"), "France", 40000 USD) { origin case_input; }
        assert "f1": foreign_taxed_property_in_gross_estate(entity_ref("urn:test:s2014:t1#e"), "France", 300000 USD) { origin case_input; }
        assert "f2": foreign_taxed_property_total(entity_ref("urn:test:s2014:t1#e"), "France", 400000 USD) { origin case_input; }
    }
    // 40,000 * (300,000/400,000) = 30,000
    evaluate truth(foreign_death_tax_credit_per_country_limit(entity_ref("urn:test:s2014:t1#e"), "France", 30000.00 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §2016: recovery duty and redetermination -------------------------------

test "S2016-01-EXECUTOR-DUTY-TO-NOTIFY-RECOVERY-PERFORMED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": foreign_death_tax_credit_recovered(entity_ref("urn:test:s2016:t1#e"), "France", 10000 USD) { origin case_input; }
        assert "f1": executor_of(entity_ref("urn:test:s2016:t1#e"), entity_ref("urn:test:s2016:t1#x"), [@2024-01-01, @2025-12-31]) { origin case_input; }
        assert "f2": notice_of_recovery_given(entity_ref("urn:test:s2016:t1#e"), entity_ref("urn:test:s2016:t1#x"), "France") { origin case_input; }
    }
    evaluate positions();
    expect position(ExecutorNotifyRecoveryDuty, SATISFIED);
}

test "S2016-02-RECOVERY-REDETERMINES-TAX" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": estate_tax(entity_ref("urn:test:s2016:t2#e"), 90000 USD) { origin case_input; }
        assert "f1": foreign_death_tax_credit_recovered(entity_ref("urn:test:s2016:t2#e"), "France", 10000 USD) { origin case_input; }
    }
    evaluate truth(estate_tax_redetermined_after_recovery(entity_ref("urn:test:s2016:t2#e"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}
