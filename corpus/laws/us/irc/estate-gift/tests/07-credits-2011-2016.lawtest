// Sections 2011-2016 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

// --- §2013(a): percentage schedule by years-before-death boundary ----------

test "S2013-01-WITHIN-TWO-YEARS-BEFORE-FULL-PERCENTAGE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": transferor_predeceased_decedent_by_years(entity_ref("urn:test:s2013:t1#tr"), entity_ref("urn:test:s2013:t1#e"), 2.0) { origin case_input; }
    }
    evaluate truth(prior_transfer_credit_percentage(entity_ref("urn:test:s2013:t1#tr"), entity_ref("urn:test:s2013:t1#e"), 1.00));
    expect truth_status == TRUE_ONLY;
}

