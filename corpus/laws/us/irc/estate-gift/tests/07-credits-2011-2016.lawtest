test "S2013-05-BEYOND-TEN-YEARS-NOT-ELIGIBLE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": transferor_predeceased_decedent_by_years(entity_ref("urn:test:s2013:t5#tr"), entity_ref("urn:test:s2013:t5#e"), 11.0) { origin case_input; }
        assert "f1": prior_transfer_from(entity_ref("urn:test:s2013:t5#tr"), entity_ref("urn:test:s2013:t5#e")) { origin case_input; }
    }
    // More than 10 years before: not an eligible prior transferor at all
    // (excluded from the class, not merely a zero percentage).
    evaluate truth(eligible_prior_transferor(entity_ref("urn:test:s2013:t5#tr"), entity_ref("urn:test:s2013:t5#e")));
    expect truth_status == NEITHER;
}

// --- §2013(b)-(c): the full credit computation, single transferor ----------

test "S2013-06-FULL-CREDIT-COMPUTATION-NO-LIMITATION-BINDING" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        // Transferor's estate: taxable estate $1,000,000, own tax after the
        // section 2010 credit only is $50,000 (asserted directly, since the
        // transferor's OWN estate is not separately built out in this
        // scenario's world). No death taxes paid, no section 2012 credit.
        assert "f0": prior_transfer_from(entity_ref("urn:test:s2013:t6#tr"), entity_ref("urn:test:s2013:t6#e")) { origin case_input; }
        assert "f1": transferor_predeceased_decedent_by_years(entity_ref("urn:test:s2013:t6#tr"), entity_ref("urn:test:s2013:t6#e"), 2.0) { origin case_input; }
        assert "f2": estate_tax_after_unified_credit(entity_ref("urn:test:s2013:t6#tr"), 50000 USD) { origin case_input; }
        assert "f3": prior_transfer_property_value(entity_ref("urn:test:s2013:t6#tr"), entity_ref("urn:test:s2013:t6#e"), 200000 USD) { origin case_input; }
        assert "f4": transferor_taxable_estate(entity_ref("urn:test:s2013:t6#tr"), 1000000 USD) { origin case_input; }
        // Limitation (c): decedent's own tax after 2010 far exceeds the
        // tentative credit, so the limitation never binds.
        assert "f5": estate_tax_after_unified_credit(entity_ref("urn:test:s2013:t6#e"), 300000 USD) { origin case_input; }
        assert "f6": estate_tax_excluding_prior_transfer(entity_ref("urn:test:s2013:t6#e"), entity_ref("urn:test:s2013:t6#tr"), 260000 USD) { origin case_input; }
    }
    // Ratio = 200,000 / 1,000,000 = 0.20; before-percentage credit =
    // 50,000 * 0.20 = 10,000; percentage (within 2 years) = 100% => 10,000.
    // Limitation = 300,000 - 260,000 = 40,000, does not bind.
    evaluate truth(prior_transfer_credit(entity_ref("urn:test:s2013:t6#tr"), entity_ref("urn:test:s2013:t6#e"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2013-07-LIMITATION-BINDS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": prior_transfer_from(entity_ref("urn:test:s2013:t7#tr"), entity_ref("urn:test:s2013:t7#e")) { origin case_input; }
        assert "f1": transferor_predeceased_decedent_by_years(entity_ref("urn:test:s2013:t7#tr"), entity_ref("urn:test:s2013:t7#e"), 4.0) { origin case_input; }
        assert "f2": estate_tax_after_unified_credit(entity_ref("urn:test:s2013:t7#tr"), 100000 USD) { origin case_input; }
        assert "f3": prior_transfer_property_value(entity_ref("urn:test:s2013:t7#tr"), entity_ref("urn:test:s2013:t7#e"), 500000 USD) { origin case_input; }
        assert "f4": transferor_taxable_estate(entity_ref("urn:test:s2013:t7#tr"), 1000000 USD) { origin case_input; }
        // Before-percentage credit = 100,000 * 0.5 = 50,000; 3rd/4th year
        // percentage = 80% => 40,000 tentative. Limitation set tighter, at
        // 15,000, so it caps the allowed credit.
        assert "f5": estate_tax_after_unified_credit(entity_ref("urn:test:s2013:t7#e"), 100000 USD) { origin case_input; }
        assert "f6": estate_tax_excluding_prior_transfer(entity_ref("urn:test:s2013:t7#e"), entity_ref("urn:test:s2013:t7#tr"), 85000 USD) { origin case_input; }
    }
    evaluate truth(prior_transfer_credit(entity_ref("urn:test:s2013:t7#tr"), entity_ref("urn:test:s2013:t7#e"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
}

