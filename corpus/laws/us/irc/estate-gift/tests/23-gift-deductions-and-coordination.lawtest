// Sections 2522(c)-(e), 2523(c)-(i), 2524, 2001(b)(2),(d)-(g), 2010(b), 2505(b) scenarios (module 23). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2522D-01-EASEMENT-GIFT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_real_property_interest_gift(entity_ref("urn:test:s2522d:t0#d"), 2026, entity_ref("urn:test:s2522d:t0#i"), 300000 USD) { origin case_input; }
        assert "f1": gift_meets_section_170h_without_4a(entity_ref("urn:test:s2522d:t0#d"), entity_ref("urn:test:s2522d:t0#i")) { origin case_input; }
    }
    evaluate truth(charitable_deduction_2522_item(entity_ref("urn:test:s2522d:t0#d"), 2026, entity_ref("urn:test:s2522d:t0#i"), 300000 USD));
    expect truth_status == TRUE_ONLY;
}

