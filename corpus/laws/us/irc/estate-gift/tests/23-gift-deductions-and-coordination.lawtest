        assert "f2": qtip_gift_election_made(entity_ref("urn:test:s2523f4:t31#d"), entity_ref("urn:test:s2523f4:t31#s"), entity_ref("urn:test:s2523f4:t31#i"), 2026) { origin case_input; }
        assert "f3": donor_revokes_qtip_gift_election(entity_ref("urn:test:s2523f4:t31#d"), entity_ref("urn:test:s2523f4:t31#s"), entity_ref("urn:test:s2523f4:t31#i")) { origin case_input; }
    }
    evaluate positions();
    expect position(QtipGiftElectionRevocationProhibition, VIOLATED);
}

