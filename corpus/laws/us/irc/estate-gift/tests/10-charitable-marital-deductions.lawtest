// Sections 2055/2523 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2055-01-OUTRIGHT-CHARITABLE-BEQUEST-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": charitable_bequest(entity_ref("urn:test:s2055:t1#e"), entity_ref("urn:test:s2055:t1#item"), ReligiousCharitableScientificLiteraryEducational, 200000 USD) { origin case_input; }
    }
    evaluate truth(charitable_deduction_2055(entity_ref("urn:test:s2055:t1#e"), 200000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2055-02-SPLIT-INTEREST-WITHOUT-QUALIFYING-TRUST-DISALLOWED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": charitable_bequest(entity_ref("urn:test:s2055:t2#e"), entity_ref("urn:test:s2055:t2#item"), ReligiousCharitableScientificLiteraryEducational, 200000 USD) { origin case_input; }
        assert "f1": split_interest_transfer(entity_ref("urn:test:s2055:t2#e"), entity_ref("urn:test:s2055:t2#item")) { origin case_input; }
    }
    // Split interest, no CRAT/CRUT/pooled-income-fund or annuity/fixed
    // percentage exception: disallowed under section 2055(e)(2).
    evaluate truth(charitable_deduction_item_2055(entity_ref("urn:test:s2055:t2#e"), entity_ref("urn:test:s2055:t2#item"), 200000.00 USD));
    expect truth_status == NEITHER;
}

test "S2055-03-SPLIT-INTEREST-CRAT-ALLOWED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": charitable_bequest(entity_ref("urn:test:s2055:t3#e"), entity_ref("urn:test:s2055:t3#item"), ReligiousCharitableScientificLiteraryEducational, 200000 USD) { origin case_input; }
        assert "f1": split_interest_transfer(entity_ref("urn:test:s2055:t3#e"), entity_ref("urn:test:s2055:t3#item")) { origin case_input; }
        assert "f2": split_interest_qualifies_remainder(entity_ref("urn:test:s2055:t3#e"), entity_ref("urn:test:s2055:t3#item")) { origin case_input; }
    }
    evaluate truth(charitable_deduction_item_2055(entity_ref("urn:test:s2055:t3#e"), entity_ref("urn:test:s2055:t3#item"), 200000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2523-01-OUTRIGHT-GIFT-TO-CITIZEN-SPOUSE-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_spouse(entity_ref("urn:test:s2523:t1#donor"), entity_ref("urn:test:s2523:t1#donee"), entity_ref("urn:test:s2523:t1#item"), 2024, 50000 USD) { origin case_input; }
        assert "f1": donee_spouse_is_us_citizen(entity_ref("urn:test:s2523:t1#donee")) { origin case_input; }
    }
    evaluate truth(marital_deduction_2523(entity_ref("urn:test:s2523:t1#donor"), 2024, 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2523-02-TERMINABLE-INTEREST-WITH-RETAINED-INTEREST-DISALLOWED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_spouse(entity_ref("urn:test:s2523:t2#donor"), entity_ref("urn:test:s2523:t2#donee"), entity_ref("urn:test:s2523:t2#item"), 2024, 50000 USD) { origin case_input; }
        assert "f1": donee_spouse_is_us_citizen(entity_ref("urn:test:s2523:t2#donee")) { origin case_input; }
        assert "f2": gift_interest_terminable(entity_ref("urn:test:s2523:t2#donor"), entity_ref("urn:test:s2523:t2#donee"), entity_ref("urn:test:s2523:t2#item")) { origin case_input; }
        assert "f3": donor_retains_or_transfers_other_interest(entity_ref("urn:test:s2523:t2#donor"), entity_ref("urn:test:s2523:t2#donee"), entity_ref("urn:test:s2523:t2#item")) { origin case_input; }
    }
    evaluate truth(marital_deduction_item_2523(entity_ref("urn:test:s2523:t2#donor"), entity_ref("urn:test:s2523:t2#donee"), entity_ref("urn:test:s2523:t2#item"), 2024, 50000.00 USD));
    expect truth_status == NEITHER;
}

test "S2523-03-QTIP-ELECTION-VALID-TERMINABLE-INTEREST-ALLOWED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_spouse(entity_ref("urn:test:s2523:t3#donor"), entity_ref("urn:test:s2523:t3#donee"), entity_ref("urn:test:s2523:t3#item"), 2024, 50000 USD) { origin case_input; }
        assert "f1": donee_spouse_is_us_citizen(entity_ref("urn:test:s2523:t3#donee")) { origin case_input; }
        assert "f2": gift_interest_terminable(entity_ref("urn:test:s2523:t3#donor"), entity_ref("urn:test:s2523:t3#donee"), entity_ref("urn:test:s2523:t3#item")) { origin case_input; }
        assert "f3": donor_retains_or_transfers_other_interest(entity_ref("urn:test:s2523:t3#donor"), entity_ref("urn:test:s2523:t3#donee"), entity_ref("urn:test:s2523:t3#item")) { origin case_input; }
        assert "f4": qtip_gift_election_made(entity_ref("urn:test:s2523:t3#donor"), entity_ref("urn:test:s2523:t3#donee"), entity_ref("urn:test:s2523:t3#item"), 2024) { origin case_input; }
        assert "f5": qtip_qualifying_income_interest_for_life(entity_ref("urn:test:s2523:t3#donor"), entity_ref("urn:test:s2523:t3#donee"), entity_ref("urn:test:s2523:t3#item")) { origin case_input; }
    }
    evaluate truth(marital_deduction_item_2523(entity_ref("urn:test:s2523:t3#donor"), entity_ref("urn:test:s2523:t3#donee"), entity_ref("urn:test:s2523:t3#item"), 2024, 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2523-04-NONCITIZEN-SPOUSE-NO-DEDUCTION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_spouse(entity_ref("urn:test:s2523:t4#donor"), entity_ref("urn:test:s2523:t4#donee"), entity_ref("urn:test:s2523:t4#item"), 2024, 50000 USD) { origin case_input; }
    }
    // No citizenship asserted: not_known(donee_spouse_is_us_citizen(...))
    // triggers the section 2523(i)(1) bar.
    evaluate truth(marital_deduction_disallowed_noncitizen_spouse_2523(entity_ref("urn:test:s2523:t4#donor"), entity_ref("urn:test:s2523:t4#donee")));
    expect truth_status == TRUE_ONLY;
}
