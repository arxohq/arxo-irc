// Sections 2601-2602, 2611-2613, 2631-2632, 2641-2642, 2651 scenarios.
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2613-01-GRANDCHILD-IS-SKIP-PERSON" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": generation_assignment(entity_ref("urn:test:s2613:t1#grandchild"), entity_ref("urn:test:s2613:t1#transferor"), 2) { origin case_input; }
    }
    evaluate truth(skip_person_natural(entity_ref("urn:test:s2613:t1#grandchild"), entity_ref("urn:test:s2613:t1#transferor")));
    expect truth_status == TRUE_ONLY;
}

test "S2613-02-CHILD-IS-NOT-SKIP-PERSON" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": generation_assignment(entity_ref("urn:test:s2613:t2#child"), entity_ref("urn:test:s2613:t2#transferor"), 1) { origin case_input; }
    }
    evaluate truth(skip_person_natural(entity_ref("urn:test:s2613:t2#child"), entity_ref("urn:test:s2613:t2#transferor")));
    expect truth_status == NEITHER;
}

test "S2612-01-DIRECT-SKIP-TO-GRANDCHILD" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": transferor_of(entity_ref("urn:test:s2612:t1#t"), entity_ref("urn:test:s2612:t1#transferor")) { origin case_input; }
        assert "f1": transferee_of(entity_ref("urn:test:s2612:t1#t"), entity_ref("urn:test:s2612:t1#grandchild")) { origin case_input; }
        assert "f2": subject_to_chapter_11_or_12_tax(entity_ref("urn:test:s2612:t1#t")) { origin case_input; }
        assert "f3": generation_assignment(entity_ref("urn:test:s2612:t1#grandchild"), entity_ref("urn:test:s2612:t1#transferor"), 2) { origin case_input; }
    }
    evaluate truth(gst_transfer_kind(entity_ref("urn:test:s2612:t1#t"), DirectSkip));
    expect truth_status == TRUE_ONLY;
}

test "S2642-01-INCLUSION-RATIO-ZERO-FULL-EXEMPTION-ALLOCATED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gst_transfer_trust(entity_ref("urn:test:s2642:t1#t"), entity_ref("urn:test:s2642:t1#trust")) { origin case_input; }
        assert "f1": transferor_of_trust(entity_ref("urn:test:s2642:t1#trust"), entity_ref("urn:test:s2642:t1#transferor")) { origin case_input; }
        assert "f2": gst_exemption_allocated(entity_ref("urn:test:s2642:t1#transferor"), entity_ref("urn:test:s2642:t1#trust"), 100000 USD) { origin case_input; }
        assert "f3": gst_property_value_transferred(entity_ref("urn:test:s2642:t1#t"), 100000 USD) { origin case_input; }
    }
    evaluate truth(gst_inclusion_ratio(entity_ref("urn:test:s2642:t1#t"), 0.0));
    expect truth_status == TRUE_ONLY;
}

test "S2642-02-INCLUSION-RATIO-ONE-NO-EXEMPTION-ALLOCATED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gst_transfer_trust(entity_ref("urn:test:s2642:t2#t"), entity_ref("urn:test:s2642:t2#trust")) { origin case_input; }
        assert "f1": transferor_of_trust(entity_ref("urn:test:s2642:t2#trust"), entity_ref("urn:test:s2642:t2#transferor")) { origin case_input; }
        assert "f2": gst_exemption_allocated(entity_ref("urn:test:s2642:t2#transferor"), entity_ref("urn:test:s2642:t2#trust"), 0 USD) { origin case_input; }
        assert "f3": gst_property_value_transferred(entity_ref("urn:test:s2642:t2#t"), 100000 USD) { origin case_input; }
    }
    evaluate truth(gst_inclusion_ratio(entity_ref("urn:test:s2642:t2#t"), 1.0));
    expect truth_status == TRUE_ONLY;
}

test "S2651-01-GENERATION-ASSIGNMENT-37-5-YEAR-BOUNDARY-ONE-GENERATION-DOWN" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": birth_year_gap_from_transferor(entity_ref("urn:test:s2651:t1#p"), entity_ref("urn:test:s2651:t1#transferor"), 37.5) { origin case_input; }
    }
    evaluate truth(generation_assignment(entity_ref("urn:test:s2651:t1#p"), entity_ref("urn:test:s2651:t1#transferor"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S2651-02-GENERATION-ASSIGNMENT-JUST-OVER-37-5-YEARS-UNDETERMINED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": birth_year_gap_from_transferor(entity_ref("urn:test:s2651:t2#p"), entity_ref("urn:test:s2651:t2#transferor"), 37.6) { origin case_input; }
    }
    // Section 2651(d)(3) ("a new generation every 25 years") is not modelled
    // (TECH-GAPS.md G83): no generation is assigned past the 37.5-year band.
    evaluate truth(generation_assignment(entity_ref("urn:test:s2651:t2#p"), entity_ref("urn:test:s2651:t2#transferor"), 2));
    expect truth_status == NEITHER;
}
