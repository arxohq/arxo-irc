// Sections 2501-2503, 2505, 2512-2513, 2518 scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2503-01-ANNUAL-EXCLUSION-TWO-DONEES" {
    given {
        context {
            legal_time @1990-06-01;
            decision_time @1990-06-01T09:00:00-05:00;
            knowledge_time @1990-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_donee_during_year(entity_ref("urn:test:s2503:t1#donor"), entity_ref("urn:test:s2503:t1#y"), entity_ref("urn:test:s2503:t1#d1"), 8000 USD) { origin case_input; }
        assert "f1": gift_to_donee_during_year(entity_ref("urn:test:s2503:t1#donor"), entity_ref("urn:test:s2503:t1#y"), entity_ref("urn:test:s2503:t1#d2"), 15000 USD) { origin case_input; }
    }
    // d1: 8000 - min(8000,10000) = 0. d2: 15000 - 10000 = 5000. Total = 5000.
    evaluate truth(taxable_gifts(entity_ref("urn:test:s2503:t1#donor"), entity_ref("urn:test:s2503:t1#y"), 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2503-02-FUTURE-INTEREST-GIFT-NO-EXCLUSION" {
    given {
        context {
            legal_time @1990-06-01;
            decision_time @1990-06-01T09:00:00-05:00;
            knowledge_time @1990-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_donee_during_year(entity_ref("urn:test:s2503:t2#donor"), entity_ref("urn:test:s2503:t2#y"), entity_ref("urn:test:s2503:t2#d1"), 8000 USD) { origin case_input; }
        assert "f1": gift_is_future_interest(entity_ref("urn:test:s2503:t2#donor"), entity_ref("urn:test:s2503:t2#y"), entity_ref("urn:test:s2503:t2#d1")) { origin case_input; }
    }
    evaluate truth(taxable_gifts(entity_ref("urn:test:s2503:t2#donor"), entity_ref("urn:test:s2503:t2#y"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

// G81: indexed annual exclusion from the pinned Revenue Procedures.
test "S2503-03-ANNUAL-EXCLUSION-2025-REV-PROC-2024-40" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-04:00;
            knowledge_time @2025-06-01T09:00:00-04:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_donee_during_year(entity_ref("urn:test:s2503:t3#donor"), entity_ref("urn:test:s2503:t3#y"), entity_ref("urn:test:s2503:t3#d1"), 25000 USD) { origin case_input; }
    }
    // 25000 - min(25000, 19000) = 6000.
    evaluate truth(taxable_gifts(entity_ref("urn:test:s2503:t3#donor"), entity_ref("urn:test:s2503:t3#y"), 6000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2503-04-ANNUAL-EXCLUSION-2026-REV-PROC-2025-32" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-04:00;
            knowledge_time @2026-06-01T09:00:00-04:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_donee_during_year(entity_ref("urn:test:s2503:t4#donor"), entity_ref("urn:test:s2503:t4#y"), entity_ref("urn:test:s2503:t4#d1"), 19000 USD) { origin case_input; }
    }
    // 19000 - min(19000, 19000) = 0.
    evaluate truth(taxable_gifts(entity_ref("urn:test:s2503:t4#donor"), entity_ref("urn:test:s2503:t4#y"), 0 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2503-05-ANNUAL-EXCLUSION-2010-STILL-A-SOURCE-GAP" {
    given {
        context {
            legal_time @2010-06-01;
            decision_time @2010-06-01T09:00:00-04:00;
            knowledge_time @2010-06-01T09:00:00-04:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_to_donee_during_year(entity_ref("urn:test:s2503:t5#donor"), entity_ref("urn:test:s2503:t5#y"), entity_ref("urn:test:s2503:t5#d1"), 25000 USD) { origin case_input; }
    }
    // 1999-2024 lie inside the coverage without a pinned figure.
    evaluate truth(taxable_gifts(entity_ref("urn:test:s2503:t5#donor"), entity_ref("urn:test:s2503:t5#y"), 12000 USD));
    expect truth_status == NEITHER;
}

test "S2512-01-BARGAIN-SALE-DEEMED-GIFT" {
    given {
        context {
            legal_time @1990-06-01;
            decision_time @1990-06-01T09:00:00-05:00;
            knowledge_time @1990-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_property_value(entity_ref("urn:test:s2512:t1#donor"), entity_ref("urn:test:s2512:t1#y"), entity_ref("urn:test:s2512:t1#donee"), 100000 USD) { origin case_input; }
        assert "f1": consideration_received(entity_ref("urn:test:s2512:t1#donor"), entity_ref("urn:test:s2512:t1#y"), entity_ref("urn:test:s2512:t1#donee"), 60000 USD) { origin case_input; }
    }
    evaluate truth(gift_to_donee_during_year(entity_ref("urn:test:s2512:t1#donor"), entity_ref("urn:test:s2512:t1#y"), entity_ref("urn:test:s2512:t1#donee"), 40000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2513-01-GIFT-SPLITTING-WITH-TIMELY-CONSENT" {
    given {
        context {
            legal_time @2024-04-01;
            decision_time @2024-04-01T09:00:00-05:00;
            knowledge_time @2024-04-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": spouse_of(entity_ref("urn:test:s2513:t1#donor"), entity_ref("urn:test:s2513:t1#spouse")) { origin case_input; }
        assert "f1": gift_splitting_consent_signified(entity_ref("urn:test:s2513:t1#spouse"), entity_ref("urn:test:s2513:t1#y2023")) { origin case_input; }
        assert "f2": gift_splitting_consent_timely(entity_ref("urn:test:s2513:t1#spouse"), entity_ref("urn:test:s2513:t1#y2023")) { origin case_input; }
    }
    evaluate truth(gift_splitting_elected(entity_ref("urn:test:s2513:t1#donor"), entity_ref("urn:test:s2513:t1#spouse"), entity_ref("urn:test:s2513:t1#y2023")));
    expect truth_status == TRUE_ONLY;
}

test "S2513-02-GIFT-SPLITTING-WITHOUT-CONSENT-NOT-ELECTED" {
    given {
        context {
            legal_time @2024-04-01;
            decision_time @2024-04-01T09:00:00-05:00;
            knowledge_time @2024-04-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": spouse_of(entity_ref("urn:test:s2513:t2#donor"), entity_ref("urn:test:s2513:t2#spouse")) { origin case_input; }
    }
    evaluate truth(gift_splitting_elected(entity_ref("urn:test:s2513:t2#donor"), entity_ref("urn:test:s2513:t2#spouse"), entity_ref("urn:test:s2513:t2#y2023")));
    expect truth_status == NEITHER;
}

test "S2518-01-DISCLAIMER-AT-9-MONTHS-QUALIFIED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": disclaimer_in_writing(entity_ref("urn:test:s2518:t1#p"), entity_ref("urn:test:s2518:t1#item")) { origin case_input; }
        assert "f1": disclaimer_received_timely(entity_ref("urn:test:s2518:t1#p"), entity_ref("urn:test:s2518:t1#item")) { origin case_input; }
        assert "f2": disclaimed_interest_passes_without_direction(entity_ref("urn:test:s2518:t1#p"), entity_ref("urn:test:s2518:t1#item")) { origin case_input; }
    }
    evaluate truth(qualified_disclaimer(entity_ref("urn:test:s2518:t1#p"), entity_ref("urn:test:s2518:t1#item")));
    expect truth_status == TRUE_ONLY;
}

test "S2518-02-DISCLAIMER-ONE-DAY-LATE-NOT-QUALIFIED" {
    given {
        context {
            legal_time @2024-06-02;
            decision_time @2024-06-02T09:00:00-05:00;
            knowledge_time @2024-06-02T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": disclaimer_in_writing(entity_ref("urn:test:s2518:t2#p"), entity_ref("urn:test:s2518:t2#item")) { origin case_input; }
        assert "f1": disclaimed_interest_passes_without_direction(entity_ref("urn:test:s2518:t2#p"), entity_ref("urn:test:s2518:t2#item")) { origin case_input; }
    }
    // disclaimer_received_timely NOT asserted (received one day past the
    // 9-month window): not a qualified disclaimer.
    evaluate truth(qualified_disclaimer(entity_ref("urn:test:s2518:t2#p"), entity_ref("urn:test:s2518:t2#item")));
    expect truth_status == NEITHER;
}
