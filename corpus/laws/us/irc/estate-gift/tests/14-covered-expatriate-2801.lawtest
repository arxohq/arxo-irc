// Section 2801 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2801-01-COVERED-GIFT-TAX-ABOVE-ANNUAL-EXCLUSION" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-05:00;
            knowledge_time @2025-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": covered_expatriate(entity_ref("urn:test:s2801:t1#donor")) { origin case_input; }
        assert "f1": covered_gift_or_bequest(entity_ref("urn:test:s2801:t1#recipient"), entity_ref("urn:test:s2801:t1#donor"), entity_ref("urn:test:s2801:t1#item"), 2025, 100000 USD) { origin case_input; }
    }
    // 100,000 - 19,000 (2025 annual exclusion) = 81,000; 81,000 * 40% = 32,400.
    evaluate truth(covered_gift_tax_2801(entity_ref("urn:test:s2801:t1#recipient"), 2025, 32400.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2801-02-EXCEPTED-BY-TIMELY-GIFT-TAX-RETURN" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-05:00;
            knowledge_time @2025-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": covered_expatriate(entity_ref("urn:test:s2801:t2#donor")) { origin case_input; }
        assert "f1": covered_gift_or_bequest(entity_ref("urn:test:s2801:t2#recipient"), entity_ref("urn:test:s2801:t2#donor"), entity_ref("urn:test:s2801:t2#item"), 2025, 100000 USD) { origin case_input; }
        assert "f2": covered_transfer_shown_on_timely_chapter_11_or_12_return(entity_ref("urn:test:s2801:t2#item")) { origin case_input; }
    }
    evaluate truth(taxable_covered_gift_item(entity_ref("urn:test:s2801:t2#recipient"), entity_ref("urn:test:s2801:t2#donor"), entity_ref("urn:test:s2801:t2#item"), 2025, 100000.00 USD));
    expect truth_status == NEITHER;
}

test "S2801-03-FOREIGN-TAX-REDUCES-COVERED-GIFT-TAX" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-05:00;
            knowledge_time @2025-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": covered_expatriate(entity_ref("urn:test:s2801:t3#donor")) { origin case_input; }
        assert "f1": covered_gift_or_bequest(entity_ref("urn:test:s2801:t3#recipient"), entity_ref("urn:test:s2801:t3#donor"), entity_ref("urn:test:s2801:t3#item"), 2025, 100000 USD) { origin case_input; }
        assert "f2": foreign_gift_or_estate_tax_paid_2801(entity_ref("urn:test:s2801:t3#recipient"), 2025, 10000 USD) { origin case_input; }
    }
    // 81,000 * 40% = 32,400; less 10,000 foreign tax = 22,400.
    evaluate truth(covered_gift_tax_2801(entity_ref("urn:test:s2801:t3#recipient"), 2025, 22400.00 USD));
    expect truth_status == TRUE_ONLY;
}
