            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": state_death_tax_paid(entity_ref("urn:test:s2058:t52#e"), 1, "Oregon", 50000 USD) { origin case_input; }
        assert "f1": jurisdiction_is_state_or_district_of_columbia("Oregon") { origin case_input; }
        assert "f2": state_death_tax_in_respect_of_gross_estate_property(entity_ref("urn:test:s2058:t52#e"), 1) { origin case_input; }
        assert "f3": date_of_death(entity_ref("urn:test:s2058:t52#e"), @2025-01-10) { origin case_input; }
        assert "f4": estate_return_filed_on(entity_ref("urn:test:s2058:t52#e"), @2025-09-01) { origin case_input; }
        assert "f5": executor_of(entity_ref("urn:test:s2058:t52#e"), entity_ref("urn:test:s2058:t52#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f6": state_tax_refund_claim_filed_on(entity_ref("urn:test:s2058:t52#e"), entity_ref("urn:test:s2058:t52#x"), @2029-09-02) { origin case_input; }
    }
    evaluate truth(state_tax_deduction_refund_allowed_without_interest(entity_ref("urn:test:s2058:t52#e")));
