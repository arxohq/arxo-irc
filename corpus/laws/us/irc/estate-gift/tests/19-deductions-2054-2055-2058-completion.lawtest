// Sections 2043(b)(2), 2053 totals, 2054, 2055(b)-(f), 2058 scenarios (module 19). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2053-02-EQUAL-FUNERAL-AND-ADMINISTRATION-AMOUNTS-BOTH-COUNTED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": funeral_expenses(entity_ref("urn:test:s2053:t0#e"), 10000 USD) { origin case_input; }
        assert "f1": administration_expenses(entity_ref("urn:test:s2053:t0#e"), 10000 USD) { origin case_input; }
    }
    evaluate truth(estate_deduction_allowed(entity_ref("urn:test:s2053:t0#e"), ExpensesIndebtednessAndTaxes, 20000 USD));
    expect truth_status == TRUE_ONLY;
}

