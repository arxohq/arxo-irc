// Scenarios for 32-2055e-actuarial-table-factors.law (26/2055/e/u9 wire).
// NOT executed in this stage — `implemented_unverified`.
// Key literal: Table S remainder factor at 3.2% for age 75 -> 0.69903
// (pinned `us.cfr.t26_7520_2031`, 20.2031-7 Table 2, eCFR 2026-09-24):
// 100000 USD x 0.69903 = 69903.00 USD.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2055E3T-01-ACTUARIAL-VALUE-FROM-TABLE-S-FACTOR" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_interest_principal_2055e(entity_ref("urn:test:s2055e3t:t1#e"), entity_ref("urn:test:s2055e3t:t1#item"), 100000 USD) { origin case_input; }
        assert "f1": qualified_interest_table_factor_selected_2055e(entity_ref("urn:test:s2055e3t:t1#e"), entity_ref("urn:test:s2055e3t:t1#item"), 0.032, 75, 0.69903) { origin case_input; }
    }
    evaluate truth(qualified_interest_actuarial_value(entity_ref("urn:test:s2055e3t:t1#e"), entity_ref("urn:test:s2055e3t:t1#item"), 69903.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2055E3T-02-NO-ACTUARIAL-VALUE-WITHOUT-TABLE-SELECTION" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_interest_principal_2055e(entity_ref("urn:test:s2055e3t:t2#e"), entity_ref("urn:test:s2055e3t:t2#item"), 100000 USD) { origin case_input; }
    }
    // no qualified_interest_table_factor_selected_2055e asserted -> no derivation
    evaluate truth(qualified_interest_actuarial_value(entity_ref("urn:test:s2055e3t:t2#e"), entity_ref("urn:test:s2055e3t:t2#item"), 69903.00 USD));
    expect truth_status == NEITHER;
}
