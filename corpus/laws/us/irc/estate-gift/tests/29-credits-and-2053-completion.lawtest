test "S2012A-01-CREDIT-IS-THE-GIFT-TAX-WHEN-BELOW-THE-LIMIT" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_paid_before_1977(entity_ref("urn:test:s2012a:t3#e"), 1) { origin case_input; }
        assert "f1": estate_tax_after_unified_credit(entity_ref("urn:test:s2012a:t3#e"), 500000 USD) { origin case_input; }
        assert "f2": gross_estate(entity_ref("urn:test:s2012a:t3#e"), 2000000 USD) { origin case_input; }
        assert "f3": gift_tax_paid_on_gift_2012(entity_ref("urn:test:s2012a:t3#e"), 1, 80000 USD) { origin case_input; }
        assert "f4": gift_value_reduced_2012b(entity_ref("urn:test:s2012a:t3#e"), 1, 400000 USD) { origin case_input; }
    }
    evaluate truth(gift_tax_credit_2012(entity_ref("urn:test:s2012a:t3#e"), 1, 80000.00 USD));
    expect truth_status == TRUE_ONLY;
}

