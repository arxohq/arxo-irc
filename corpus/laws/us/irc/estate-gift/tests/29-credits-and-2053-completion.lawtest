// Sections 2012(b),(c),(e); 2013(c),(d),(f); 2014(c)(2),(f),(h); 2053(b)-(d) completion scenarios (module 29). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2012E-01-GIFT-BEFORE-1977-CREDIT-NOT-BARRED" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_made_on_2012(entity_ref("urn:test:s2012e:t0#e"), 1, @1976-12-31) { origin case_input; }
    }
    evaluate truth(gift_after_1976_no_credit_2012e(entity_ref("urn:test:s2012e:t0#e"), 1));
    expect truth_status == NEITHER;
}

