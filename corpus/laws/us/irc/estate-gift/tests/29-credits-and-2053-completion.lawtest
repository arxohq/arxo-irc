test "S2014H-01-THREE-FINDINGS-SUPPORT-THE-PROCLAMATION" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": president_finds_no_similar_credit_2014h1("XX") { origin adjudicated; }
        assert "f1": foreign_country_did_not_act_on_request_2014h2("XX") { origin case_input; }
        assert "f2": president_finds_public_interest_2014h3("XX") { origin adjudicated; }
