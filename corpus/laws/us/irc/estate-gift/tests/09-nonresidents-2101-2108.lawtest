// Sections 2101-2108 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2103-01-US-SITUS-GROSS-ESTATE-STOCK-INCLUDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": date_of_death(entity_ref("urn:test:s2103:t1#e"), @2024-06-01) { origin case_input; }
        assert "f1": gross_estate_item(entity_ref("urn:test:s2103:t1#e"), entity_ref("urn:test:s2103:t1#stock"), 500000 USD) { origin case_input; }
        assert "f2": gross_estate_item(entity_ref("urn:test:s2103:t1#e"), entity_ref("urn:test:s2103:t1#foreignbond"), 200000 USD) { origin case_input; }
        assert "f3": nonresident_property_classified(entity_ref("urn:test:s2103:t1#stock"), StockInDomesticCorporation) { origin case_input; }
        assert "f4": nonresident_property_classified(entity_ref("urn:test:s2103:t1#foreignbond"), OtherPropertyWithoutUnitedStates) { origin case_input; }
    }
    // Only the domestic stock is US-situs.
    evaluate truth(us_situs_gross_estate(entity_ref("urn:test:s2103:t1#e"), 500000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2105-01-LIFE-INSURANCE-PROCEEDS-EXCLUDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": nonresident_property_classified(entity_ref("urn:test:s2105:t1#policy"), LifeInsuranceProceeds) { origin case_input; }
    }
    evaluate truth(property_situated_in_us(entity_ref("urn:test:s2105:t1#policy")));
    expect truth_status == NEITHER;
}

test "S2106-01-TAXABLE-ESTATE-PRO-RATA-WITH-DISCLOSURE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us_situs_gross_estate(entity_ref("urn:test:s2106:t1#e"), 500000 USD) { origin case_input; }
        assert "f1": gross_estate(entity_ref("urn:test:s2106:t1#e"), 1000000 USD) { origin case_input; }
        assert "f2": total_estate_deductions(entity_ref("urn:test:s2106:t1#e"), 100000 USD) { origin case_input; }
        assert "f3": worldwide_gross_estate_disclosed_on_return(entity_ref("urn:test:s2106:t1#e")) { origin case_input; }
        assert "f4": nonresident_charitable_deduction(entity_ref("urn:test:s2106:t1#e"), 0.00 USD) { origin case_input; }
        assert "f5": nonresident_marital_deduction(entity_ref("urn:test:s2106:t1#e"), 0.00 USD) { origin case_input; }
        assert "f6": state_death_taxes_paid_on_us_situs_property(entity_ref("urn:test:s2106:t1#e"), 0.00 USD) { origin case_input; }
    }
    // Pro rata expenses = 100,000 * (500,000/1,000,000) = 50,000.
    // Taxable estate = 500,000 - 50,000 = 450,000.
    evaluate truth(nonresident_taxable_estate(entity_ref("urn:test:s2106:t1#e"), 450000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2106-02-NO-DISCLOSURE-EXPENSES-DEDUCTION-DENIED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us_situs_gross_estate(entity_ref("urn:test:s2106:t2#e"), 500000 USD) { origin case_input; }
        assert "f1": nonresident_marital_deduction(entity_ref("urn:test:s2106:t2#e"), 100000 USD) { origin case_input; }
    }
    // No disclosure asserted: paragraphs (1)-(2) barred; only the marital
    // deduction (3) survives, per section 2106(b)'s literal paragraph scope.
    evaluate truth(nonresident_taxable_estate(entity_ref("urn:test:s2106:t2#e"), 400000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2101-01-TAX-IMPOSED-AND-COMPUTED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": date_of_death(entity_ref("urn:test:s2101:t1#e"), @2024-06-01) { origin case_input; }
        assert "f1": nonresident_taxable_estate(entity_ref("urn:test:s2101:t1#e"), 1500000 USD) { origin case_input; }
    }
    // No adjusted taxable gifts: tentative tax on 1,500,000 alone.
    // 345,800 + 40% * (1,500,000 - 1,000,000) = 545,800.
    evaluate truth(nonresident_estate_tax_before_credit(entity_ref("urn:test:s2101:t1#e"), 545800.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2102-01-UNIFIED-CREDIT-13000" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": nonresident_estate_tax_before_credit(entity_ref("urn:test:s2102:t1#e"), 545800 USD) { origin case_input; }
    }
    evaluate truth(nonresident_unified_credit(entity_ref("urn:test:s2102:t1#e"), 13000.00 USD));
    expect truth_status == TRUE_ONLY;
}
