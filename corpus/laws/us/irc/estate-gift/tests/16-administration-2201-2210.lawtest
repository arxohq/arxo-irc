    }
    evaluate truth(section_2207b_recovery_amount(entity_ref("urn:test:s2207b:t1#e"), entity_ref("urn:test:s2207b:t1#item"), entity_ref("urn:test:s2207b:t1#recipient"), 40000.00 USD));
