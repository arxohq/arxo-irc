// Sections 2201, 2204, 2206, 2207, 2207A, 2207B scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2201-01-COMBAT-ZONE-DECEDENT-REDUCED-RATE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_decedent_2201(entity_ref("urn:test:s2201:t1#e"), KilledOrDiedInCombatZone) { origin case_input; }
        assert "f1": tentative_tax_base(entity_ref("urn:test:s2201:t1#e"), 200000 USD) { origin case_input; }
    }
    // $1,500 + 3% * (200,000-200,000) = $1,500 at the exact bracket boundary.
    evaluate truth(combat_zone_tentative_tax(entity_ref("urn:test:s2201:t1#e"), 1500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2204-01-SECRETARY-NOTIFY-DUTY-SATISFIED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_application_for_discharge(entity_ref("urn:test:s2204:t1#e"), entity_ref("urn:test:s2204:t1#x"), @2024-01-01) { origin case_input; }
        assert "f1": secretary_notified_tax_amount(entity_ref("urn:test:s2204:t1#e"), entity_ref("urn:test:s2204:t1#x")) { origin case_input; }
    }
    evaluate positions();
    expect position(SecretaryNotifyTaxAmountDuty, SATISFIED);
}

test "S2204-02-EXECUTOR-DISCHARGED-AFTER-PAYMENT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_application_for_discharge(entity_ref("urn:test:s2204:t2#e"), entity_ref("urn:test:s2204:t2#x"), @2024-01-01) { origin case_input; }
        assert "f1": secretary_notified_tax_amount(entity_ref("urn:test:s2204:t2#e"), entity_ref("urn:test:s2204:t2#x")) { origin case_input; }
        assert "f2": executor_paid_notified_amount(entity_ref("urn:test:s2204:t2#e"), entity_ref("urn:test:s2204:t2#x")) { origin case_input; }
    }
    evaluate truth(executor_discharged_from_personal_liability(entity_ref("urn:test:s2204:t2#e"), entity_ref("urn:test:s2204:t2#x")));
    expect truth_status == TRUE_ONLY;
}

test "S2206-01-LIFE-INSURANCE-BENEFICIARY-RECOVERY-RATIO" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": life_insurance_proceeds_in_gross_estate(entity_ref("urn:test:s2206:t1#e"), entity_ref("urn:test:s2206:t1#policy"), entity_ref("urn:test:s2206:t1#ben"), 200000 USD) { origin case_input; }
        assert "f1": estate_tax(entity_ref("urn:test:s2206:t1#e"), 100000 USD) { origin case_input; }
        assert "f2": taxable_estate(entity_ref("urn:test:s2206:t1#e"), 1000000 USD) { origin case_input; }
    }
    // 100,000 * (200,000/1,000,000) = 20,000.
    evaluate truth(life_insurance_beneficiary_recovery_amount(entity_ref("urn:test:s2206:t1#e"), entity_ref("urn:test:s2206:t1#policy"), entity_ref("urn:test:s2206:t1#ben"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2207A-01-SECTION-2044-RECOVERY-DIFFERENCE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": section_2044_property_recipient(entity_ref("urn:test:s2207a:t1#e"), entity_ref("urn:test:s2207a:t1#item"), entity_ref("urn:test:s2207a:t1#recipient")) { origin case_input; }
        assert "f1": estate_tax(entity_ref("urn:test:s2207a:t1#e"), 150000 USD) { origin case_input; }
        assert "f2": estate_tax_without_2044_property(entity_ref("urn:test:s2207a:t1#e"), entity_ref("urn:test:s2207a:t1#item"), 100000 USD) { origin case_input; }
    }
    evaluate truth(section_2207a_estate_tax_recovery_amount(entity_ref("urn:test:s2207a:t1#e"), entity_ref("urn:test:s2207a:t1#item"), entity_ref("urn:test:s2207a:t1#recipient"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

