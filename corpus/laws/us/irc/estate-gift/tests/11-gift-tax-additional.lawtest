// Sections 2504, 2511, 2514, 2516, 2519, 2522 scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2504-01-FINALLY-DETERMINED-VALUE-LOCKED-IN" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": prior_gift_assessment_period_expired(entity_ref("urn:test:s2504:t1#donor"), entity_ref("urn:test:s2504:t1#y2020")) { origin case_input; }
        assert "f1": prior_gift_value_finally_determined(entity_ref("urn:test:s2504:t1#donor"), entity_ref("urn:test:s2504:t1#y2020"), 50000 USD) { origin case_input; }
    }
    evaluate truth(taxable_gift_value_for_cumulative_computation(entity_ref("urn:test:s2504:t1#donor"), entity_ref("urn:test:s2504:t1#y2020"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2511-01-NONRESIDENT-DONOR-US-SITUS-TAXED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gift_donor_nonresident_not_citizen(entity_ref("urn:test:s2511:t1#donor")) { origin case_input; }
        assert "f1": nonresident_property_classified(entity_ref("urn:test:s2511:t1#stock"), StockInDomesticCorporation) { origin case_input; }
    }
    evaluate truth(gift_tax_applies_to_transfer(entity_ref("urn:test:s2511:t1#donor"), entity_ref("urn:test:s2511:t1#stock")));
    expect truth_status == TRUE_ONLY;
}

test "S2514-01-POST-1942-POWER-EXERCISE-IS-TRANSFER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": general_power_of_appointment(entity_ref("urn:test:s2514:t1#p"), 1) { origin case_input; }
        assert "f1": general_power_exercised_or_released(entity_ref("urn:test:s2514:t1#p"), 1, @2024-03-01) { origin case_input; }
    }
    evaluate truth(general_power_exercise_or_release_is_transfer(entity_ref("urn:test:s2514:t1#p"), 1, @2024-03-01));
    expect truth_status == TRUE_ONLY;
}

test "S2514-02-LAPSE-WITHIN-5-OR-5-NO-RELEASE-AMOUNT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": power_lapse(entity_ref("urn:test:s2514:t2#p"), 1, 2024, 4000 USD) { origin case_input; }
        assert "f1": lapsed_power_assets_aggregate_value(entity_ref("urn:test:s2514:t2#p"), 1, 2024, 200000 USD) { origin case_input; }
    }
    // Greater of $5,000 or 5% * 200,000 = 10,000; appointable 4,000 is below
    // both, so the release amount is $0 (the "5-or-5" exception fully absorbs it).
    evaluate truth(power_lapse_release_amount(entity_ref("urn:test:s2514:t2#p"), 1, 2024, 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2514-03-LAPSE-EXCEEDING-5-OR-5-PARTIAL-RELEASE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": power_lapse(entity_ref("urn:test:s2514:t3#p"), 1, 2024, 30000 USD) { origin case_input; }
        assert "f1": lapsed_power_assets_aggregate_value(entity_ref("urn:test:s2514:t3#p"), 1, 2024, 200000 USD) { origin case_input; }
    }
    // Greater of $5,000 or 10,000 = 10,000; 30,000 - 10,000 = 20,000.
    evaluate truth(power_lapse_release_amount(entity_ref("urn:test:s2514:t3#p"), 1, 2024, 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2516-01-PROPERTY-SETTLEMENT-WITHIN-WINDOW-FULL-CONSIDERATION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": marital_property_settlement_agreement(entity_ref("urn:test:s2516:t1#h"), entity_ref("urn:test:s2516:t1#w"), @2024-01-15) { origin case_input; }
        assert "f1": marital_property_settlement_divorce(entity_ref("urn:test:s2516:t1#h"), entity_ref("urn:test:s2516:t1#w"), @2024-06-01) { origin case_input; }
        assert "f2": property_settlement_transfer(entity_ref("urn:test:s2516:t1#h"), entity_ref("urn:test:s2516:t1#w"), entity_ref("urn:test:s2516:t1#w"), entity_ref("urn:test:s2516:t1#item"), SettlementOfMaritalOrPropertyRights) { origin case_input; }
    }
    evaluate truth(property_settlement_deemed_full_consideration(entity_ref("urn:test:s2516:t1#h"), entity_ref("urn:test:s2516:t1#w"), entity_ref("urn:test:s2516:t1#item")));
    expect truth_status == TRUE_ONLY;
}

test "S2519-01-QTIP-DISPOSITION-IS-TRANSFER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qtip_election_made(entity_ref("urn:test:s2519:t1#e"), entity_ref("urn:test:s2519:t1#item")) { origin case_input; }
        assert "f1": qualifying_income_interest_disposition(entity_ref("urn:test:s2519:t1#p"), entity_ref("urn:test:s2519:t1#item"), @2024-03-01, 300000 USD) { origin case_input; }
    }
    evaluate truth(qualifying_income_interest_disposition_is_transfer(entity_ref("urn:test:s2519:t1#p"), entity_ref("urn:test:s2519:t1#item"), @2024-03-01, 300000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2522-01-OUTRIGHT-CHARITABLE-GIFT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": charitable_gift(entity_ref("urn:test:s2522:t1#donor"), 2024, entity_ref("urn:test:s2522:t1#item"), ReligiousCharitableScientificLiteraryEducational, 20000 USD) { origin case_input; }
    }
    evaluate truth(charitable_deduction_2522(entity_ref("urn:test:s2522:t1#donor"), 2024, 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}
