// Sections 2031(c), 2032(b), 2035(b),(c),(e), 2036(b), 2038(b), 2041 scenarios (module 21). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2035B-01-GIFT-TAX-ON-FIRST-DAY-OF-THREE-YEAR-PERIOD-ADDED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": date_of_death(entity_ref("urn:test:s2035b:t0#e"), @2025-01-10) { origin case_input; }
        assert "f1": chapter12_tax_paid_on_gift(entity_ref("urn:test:s2035b:t0#e"), 1, @2022-01-11, 30000 USD) { origin case_input; }
    }
    evaluate truth(gift_tax_gross_up_item_2035b(entity_ref("urn:test:s2035b:t0#e"), 1, 30000 USD));
    expect truth_status == TRUE_ONLY;
}

