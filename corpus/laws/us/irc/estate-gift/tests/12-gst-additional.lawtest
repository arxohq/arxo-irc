        }
        assert "f0": gst_transfer_kind(entity_ref("urn:test:s2622:t1#t"), TaxableTermination) { origin case_input; }
        assert "f1": gst_property_value_transferred(entity_ref("urn:test:s2622:t1#t"), 500000 USD) { origin case_input; }
        assert "f2": gst_termination_expense_deduction(entity_ref("urn:test:s2622:t1#t"), 10000 USD) { origin case_input; }
    }
    evaluate truth(gst_taxable_amount(entity_ref("urn:test:s2622:t1#t"), 490000.00 USD));
    expect truth_status == TRUE_ONLY;
}

