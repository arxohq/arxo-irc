            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qtip_trust_for_reverse_election(entity_ref("urn:test:s2652:t1#e"), entity_ref("urn:test:s2652:t1#trust")) { origin case_input; }
        assert "f1": reverse_qtip_election_made(entity_ref("urn:test:s2652:t1#e"), entity_ref("urn:test:s2652:t1#trust")) { origin case_input; }
    }
    evaluate truth(reverse_qtip_treated_as_transferor(entity_ref("urn:test:s2652:t1#e"), entity_ref("urn:test:s2652:t1#trust")));
    expect truth_status == TRUE_ONLY;
}

test "S2653-01-MULTIPLE-SKIP-GENERATION-REASSIGNMENT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gst_transfer_held_in_trust_after(entity_ref("urn:test:s2653:t1#t"), entity_ref("urn:test:s2653:t1#trust")) { origin case_input; }
        assert "f1": highest_interest_holder_generation(entity_ref("urn:test:s2653:t1#trust"), 2) { origin case_input; }
    }
    evaluate truth(multiple_skip_transferor_generation(entity_ref("urn:test:s2653:t1#t"), entity_ref("urn:test:s2653:t1#trust"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S2654-01-TRUSTEE-IMMUNE-NO-KNOWLEDGE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": trustee_gst_tax_increase_cause(entity_ref("urn:test:s2654:t1#trustee"), entity_ref("urn:test:s2654:t1#trust"), InclusionRatioGreaterThanComputedOnReturn) { origin case_input; }
    }
    evaluate truth(trustee_immune_from_gst_tax_increase(entity_ref("urn:test:s2654:t1#trustee"), entity_ref("urn:test:s2654:t1#trust")));
