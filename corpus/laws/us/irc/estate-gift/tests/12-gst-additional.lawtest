// Sections 2621-2624, 2652(a)(3), 2653, 2654 scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2621-01-TAXABLE-DISTRIBUTION-AMOUNT-NET-OF-EXPENSE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gst_transfer_kind(entity_ref("urn:test:s2621:t1#t"), TaxableDistribution) { origin case_input; }
        assert "f1": gst_property_value_transferred(entity_ref("urn:test:s2621:t1#t"), 100000 USD) { origin case_input; }
        assert "f2": gst_transferee_expense(entity_ref("urn:test:s2621:t1#t"), 2000 USD) { origin case_input; }
    }
    evaluate truth(gst_taxable_amount(entity_ref("urn:test:s2621:t1#t"), 98000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2622-01-TAXABLE-TERMINATION-AMOUNT-NET-OF-DEDUCTION" {
    given {
