// Section 2032A(b)(4)-(5), (c), (d), (e), (f)-(i) completion scenarios (module 27). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2032AC1-01-EVENT-ON-LAST-DAY-OF-TEN-YEARS-WITHIN-WINDOW" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": date_of_death(entity_ref("urn:test:s2032ac1:t0#e"), @2020-06-01) { origin case_input; }
        assert "f1": gross_estate(entity_ref("urn:test:s2032ac1:t0#e"), 1200000 USD) { origin case_input; }
        assert "f2": property_fair_market_value(entity_ref("urn:test:s2032ac1:t0#e"), entity_ref("urn:test:s2032ac1:t0#p"), 1000000 USD) { origin case_input; }
        assert "f3": qualified_real_property_value_for_use(entity_ref("urn:test:s2032ac1:t0#e"), entity_ref("urn:test:s2032ac1:t0#p"), 600000 USD) { origin case_input; }
        assert "f4": qualified_heir(entity_ref("urn:test:s2032ac1:t0#h"), entity_ref("urn:test:s2032ac1:t0#p"), entity_ref("urn:test:s2032ac1:t0#e")) { origin case_input; }
        assert "f5": qualified_use(entity_ref("urn:test:s2032ac1:t0#p"), Farming, entity_ref("urn:test:s2032ac1:t0#h"), entity_ref("urn:test:s2032ac1:t0#e")) { origin case_input; }
        assert "f6": designated_in_agreement(entity_ref("urn:test:s2032ac1:t0#e"), entity_ref("urn:test:s2032ac1:t0#p")) { origin case_input; }
        assert "f7": ownership_use_participation_years(entity_ref("urn:test:s2032ac1:t0#e"), entity_ref("urn:test:s2032ac1:t0#p"), 6.0) { origin case_input; }
        assert "f8": property_located_in_united_states(entity_ref("urn:test:s2032ac1:t0#p")) { origin case_input; }
        assert "f9": executor_of(entity_ref("urn:test:s2032ac1:t0#e"), entity_ref("urn:test:s2032ac1:t0#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f10": special_use_valuation_election_made(entity_ref("urn:test:s2032ac1:t0#e"), entity_ref("urn:test:s2032ac1:t0#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f11": special_use_valuation_agreement_signed_by_all_interested_persons(entity_ref("urn:test:s2032ac1:t0#e")) { origin case_input; }
        assert "f12": qualified_heir_disposes_of_interest(entity_ref("urn:test:s2032ac1:t0#e"), entity_ref("urn:test:s2032ac1:t0#p"), entity_ref("urn:test:s2032ac1:t0#h"), entity_ref("urn:test:s2032ac1:t0#o"), @2030-06-01) { origin case_input; }
    }
    evaluate truth(recapture_event_within_window(entity_ref("urn:test:s2032ac1:t0#e"), entity_ref("urn:test:s2032ac1:t0#p"), entity_ref("urn:test:s2032ac1:t0#h"), @2030-06-01));
    expect truth_status == TRUE_ONLY;
}

test "S2032AC1-02-EVENT-DAY-AFTER-TEN-YEARS-OUTSIDE-WINDOW" {
