    evaluate truth(recapture_event_within_window(entity_ref("urn:test:s2032ac1:t1#e"), entity_ref("urn:test:s2032ac1:t1#p"), entity_ref("urn:test:s2032ac1:t1#h"), @2030-06-02));
    expect truth_status == NEITHER;
}

