// Sections 2631, 2632, 2642 scenarios (module 24). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2632A-01-ALLOCATION-ON-ESTATE-RETURN-DUE-DATE-TIMELY" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": gst_allocation_filed_on(entity_ref("urn:test:s2632a:t0#p"), @2026-04-01) { origin case_input; }
        assert "f1": transferor_estate_return_due_date(entity_ref("urn:test:s2632a:t0#p"), @2026-04-01) { origin case_input; }
        assert "f2": us.irc.core::year_of(entity_ref("urn:test:s2632a:t0#p"), entity_ref("urn:test:s2632a:t0#y")) { origin case_input; }
    }
    evaluate truth(gst_allocation_by_due_date(entity_ref("urn:test:s2632a:t0#p"), entity_ref("urn:test:s2632a:t0#y")));
    expect truth_status == TRUE_ONLY;
}

