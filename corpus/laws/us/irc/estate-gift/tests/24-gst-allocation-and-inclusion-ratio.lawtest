        assert "f1": lifetime_transfer_year(entity_ref("urn:test:s2632b:t6#x"), entity_ref("urn:test:s2632b:t6#y")) { origin case_input; }
        assert "f2": us.irc.core::calendar_year_of(entity_ref("urn:test:s2632b:t6#y"), 2026) { origin case_input; }
        assert "f3": lifetime_transfer_subject_to_chapter12_tax(entity_ref("urn:test:s2632b:t6#x")) { origin case_input; }
