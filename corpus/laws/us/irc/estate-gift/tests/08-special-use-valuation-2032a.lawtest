        assert "f6": qualified_heir(entity_ref("urn:test:s2032a:t7#heir"), entity_ref("urn:test:s2032a:t7#farm"), entity_ref("urn:test:s2032a:t7#e")) { origin case_input; }
        assert "f7": qualified_use(entity_ref("urn:test:s2032a:t7#farm"), Farming, entity_ref("urn:test:s2032a:t7#heir"), entity_ref("urn:test:s2032a:t7#e")) { origin case_input; }
        assert "f8": designated_in_agreement(entity_ref("urn:test:s2032a:t7#e"), entity_ref("urn:test:s2032a:t7#farm")) { origin case_input; }
        assert "f9": ownership_use_participation_years(entity_ref("urn:test:s2032a:t7#e"), entity_ref("urn:test:s2032a:t7#farm"), 6.0) { origin case_input; }
        assert "f10": amount_realized_on_disposition(entity_ref("urn:test:s2032a:t7#e"), entity_ref("urn:test:s2032a:t7#farm"), 900000 USD) { origin case_input; }
        assert "f11": gross_estate(entity_ref("urn:test:s2032a:t7#e"), 1200000 USD) { origin case_input; }
        assert "f12": section_2032a_additional_tax_paid(entity_ref("urn:test:s2032a:t7#e"), entity_ref("urn:test:s2032a:t7#farm"), entity_ref("urn:test:s2032a:t7#heir")) { origin case_input; }
    }
    evaluate positions();
    expect position(QualifiedHeirAdditionalTaxDuty, SATISFIED);
}

test "S2032A-08-ELECTION-VALID-WITH-AGREEMENT" {
    given {
        context {
            legal_time @1998-06-01;
            decision_time @1998-06-01T09:00:00-05:00;
            knowledge_time @1998-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_of(entity_ref("urn:test:s2032a:t8#e"), entity_ref("urn:test:s2032a:t8#x"), [@1998-01-01, @1999-12-31]) { origin case_input; }
        assert "f1": special_use_valuation_election_made(entity_ref("urn:test:s2032a:t8#e"), entity_ref("urn:test:s2032a:t8#x"), [@1998-01-01, @1999-12-31]) { origin case_input; }
        assert "f2": special_use_valuation_agreement_signed_by_all_interested_persons(entity_ref("urn:test:s2032a:t8#e")) { origin case_input; }
    }
    evaluate truth(special_use_valuation_election_valid(entity_ref("urn:test:s2032a:t8#e")));
    expect truth_status == TRUE_ONLY;
}

test "S2032A-09-ELECTION-INVALID-NO-AGREEMENT" {
    given {
        context {
            legal_time @1998-06-01;
            decision_time @1998-06-01T09:00:00-05:00;
            knowledge_time @1998-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_of(entity_ref("urn:test:s2032a:t9#e"), entity_ref("urn:test:s2032a:t9#x"), [@1998-01-01, @1999-12-31]) { origin case_input; }
        assert "f1": special_use_valuation_election_made(entity_ref("urn:test:s2032a:t9#e"), entity_ref("urn:test:s2032a:t9#x"), [@1998-01-01, @1999-12-31]) { origin case_input; }
    }
    // No agreement asserted: election exercised but invalid (POWER_INVALID_EXERCISE).
    evaluate truth(special_use_valuation_election_valid(entity_ref("urn:test:s2032a:t9#e")));
    expect truth_status == FALSE_ONLY;
}
