// Section 2032A scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2032A-01-SPECIAL-USE-VALUE-ELECTED-WITHIN-CAP" {
    given {
        context {
            legal_time @1998-06-01;
            decision_time @1998-06-01T09:00:00-05:00;
            knowledge_time @1998-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": date_of_death(entity_ref("urn:test:s2032a:t1#e"), @1998-06-01) { origin case_input; }
        assert "f1": executor_of(entity_ref("urn:test:s2032a:t1#e"), entity_ref("urn:test:s2032a:t1#x"), [@1998-01-01, @1999-12-31]) { origin case_input; }
        assert "f2": special_use_valuation_election_made(entity_ref("urn:test:s2032a:t1#e"), entity_ref("urn:test:s2032a:t1#x"), [@1998-01-01, @1999-12-31]) { origin case_input; }
        assert "f3": special_use_valuation_agreement_signed_by_all_interested_persons(entity_ref("urn:test:s2032a:t1#e")) { origin case_input; }
        assert "f4": property_located_in_united_states(entity_ref("urn:test:s2032a:t1#farm")) { origin case_input; }
        assert "f5": qualified_heir(entity_ref("urn:test:s2032a:t1#heir"), entity_ref("urn:test:s2032a:t1#farm"), entity_ref("urn:test:s2032a:t1#e")) { origin case_input; }
        assert "f6": qualified_use(entity_ref("urn:test:s2032a:t1#farm"), Farming, entity_ref("urn:test:s2032a:t1#heir"), entity_ref("urn:test:s2032a:t1#e")) { origin case_input; }
        assert "f7": ownership_use_participation_years(entity_ref("urn:test:s2032a:t1#e"), entity_ref("urn:test:s2032a:t1#farm"), 6.0) { origin case_input; }
        assert "f8": designated_in_agreement(entity_ref("urn:test:s2032a:t1#e"), entity_ref("urn:test:s2032a:t1#farm")) { origin case_input; }
        assert "f9": property_fair_market_value(entity_ref("urn:test:s2032a:t1#e"), entity_ref("urn:test:s2032a:t1#farm"), 1000000 USD) { origin case_input; }
        assert "f10": qualified_real_property_value_for_use(entity_ref("urn:test:s2032a:t1#e"), entity_ref("urn:test:s2032a:t1#farm"), 500000 USD) { origin case_input; }
        assert "f11": gross_estate(entity_ref("urn:test:s2032a:t1#e"), 1200000 USD) { origin case_input; }
    }
    // Reduction = 1,000,000 - 500,000 = 500,000, within the $750,000 cap.
    evaluate truth(special_use_value(entity_ref("urn:test:s2032a:t1#e"), entity_ref("urn:test:s2032a:t1#farm"), 500000 USD));
    expect truth_status == TRUE_ONLY;
}

