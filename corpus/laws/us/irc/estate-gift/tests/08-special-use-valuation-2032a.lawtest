test "S2032A-03-FIFTY-PERCENT-TEST" {
    given {
        context {
            legal_time @1998-06-01;
            decision_time @1998-06-01T09:00:00-05:00;
            knowledge_time @1998-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": qualified_heir(entity_ref("urn:test:s2032a:t3#heir"), entity_ref("urn:test:s2032a:t3#farm"), entity_ref("urn:test:s2032a:t3#e")) { origin case_input; }
        assert "f1": qualified_use(entity_ref("urn:test:s2032a:t3#farm"), Farming, entity_ref("urn:test:s2032a:t3#heir"), entity_ref("urn:test:s2032a:t3#e")) { origin case_input; }
        assert "f2": property_fair_market_value(entity_ref("urn:test:s2032a:t3#e"), entity_ref("urn:test:s2032a:t3#farm"), 600000 USD) { origin case_input; }
        assert "f3": gross_estate(entity_ref("urn:test:s2032a:t3#e"), 1000000 USD) { origin case_input; }
    }
    // 600,000 / 1,000,000 = 60% >= 50%.
    evaluate truth(fifty_percent_test_satisfied(entity_ref("urn:test:s2032a:t3#e")));
    expect truth_status == TRUE_ONLY;
}

