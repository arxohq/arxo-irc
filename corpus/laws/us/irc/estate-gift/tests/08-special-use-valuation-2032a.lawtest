test "S2032A-06-DISPOSITION-WITHIN-TEN-YEARS-RECAPTURE" {
    given {
        context {
            legal_time @2005-06-01;
            decision_time @2005-06-01T09:00:00-05:00;
            knowledge_time @2005-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": date_of_death(entity_ref("urn:test:s2032a:t6#e"), @1998-06-01) { origin case_input; }
        assert "f1": qualified_heir_disposes_of_interest(entity_ref("urn:test:s2032a:t6#e"), entity_ref("urn:test:s2032a:t6#farm"), entity_ref("urn:test:s2032a:t6#heir"), entity_ref("urn:test:s2032a:t6#stranger"), @2005-06-01) { origin case_input; }
        assert "f2": estate_tax_without_2032a(entity_ref("urn:test:s2032a:t6#e"), 300000 USD) { origin case_input; }
        assert "f3": estate_tax(entity_ref("urn:test:s2032a:t6#e"), 100000 USD) { origin case_input; }
        assert "f4": property_fair_market_value(entity_ref("urn:test:s2032a:t6#e"), entity_ref("urn:test:s2032a:t6#farm"), 1000000 USD) { origin case_input; }
        assert "f5": qualified_real_property_value_for_use(entity_ref("urn:test:s2032a:t6#e"), entity_ref("urn:test:s2032a:t6#farm"), 500000 USD) { origin case_input; }
        assert "f6": qualified_heir(entity_ref("urn:test:s2032a:t6#heir"), entity_ref("urn:test:s2032a:t6#farm"), entity_ref("urn:test:s2032a:t6#e")) { origin case_input; }
        assert "f7": qualified_use(entity_ref("urn:test:s2032a:t6#farm"), Farming, entity_ref("urn:test:s2032a:t6#heir"), entity_ref("urn:test:s2032a:t6#e")) { origin case_input; }
        assert "f8": designated_in_agreement(entity_ref("urn:test:s2032a:t6#e"), entity_ref("urn:test:s2032a:t6#farm")) { origin case_input; }
        assert "f9": ownership_use_participation_years(entity_ref("urn:test:s2032a:t6#e"), entity_ref("urn:test:s2032a:t6#farm"), 6.0) { origin case_input; }
        assert "f10": amount_realized_on_disposition(entity_ref("urn:test:s2032a:t6#e"), entity_ref("urn:test:s2032a:t6#farm"), 900000 USD) { origin case_input; }
        assert "f11": gross_estate(entity_ref("urn:test:s2032a:t6#e"), 1200000 USD) { origin case_input; }
    }
    // Adjusted tax diff = 300,000-100,000 = 200,000; single qualified real
    // property => apportioned diff = 200,000 (100% share). Excess of amount
    // realized (900,000) over section 2032A value (500,000) = 400,000.
    // Additional tax = lesser(200,000, 400,000) = 200,000.
    evaluate truth(section_2032a_additional_tax(entity_ref("urn:test:s2032a:t6#e"), entity_ref("urn:test:s2032a:t6#farm"), 200000.00 USD));
    expect truth_status == TRUE_ONLY;
}

