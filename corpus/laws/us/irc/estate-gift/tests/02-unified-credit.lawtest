// Section 2010 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2010-01-BASIC-EXCLUSION-2011-EXACT-5M" {
    given {
        context {
            legal_time @2011-06-01;
            decision_time @2011-06-01T09:00:00-05:00;
            knowledge_time @2011-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    evaluate truth(applicable_exclusion_amount(entity_ref("urn:test:s2010:t1#e"), 5000000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2010-02-BASIC-EXCLUSION-2026-EXACT-15M-AFTER-PL119-21" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    evaluate truth(applicable_exclusion_amount(entity_ref("urn:test:s2010:t2#e"), 15000000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2010-03-BASIC-EXCLUSION-2015-UNDETERMINED-SOURCE-GAP" {
    given {
        context {
            legal_time @2015-06-01;
            decision_time @2015-06-01T09:00:00-05:00;
            knowledge_time @2015-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    // No pinned Rev. Proc. figure for 2015: MISSING_PARAMETER_VALUE, not a
    // fabricated indexed amount.
    evaluate truth(applicable_exclusion_amount(entity_ref("urn:test:s2010:t3#e"), 5430000 USD));
    expect truth_status == NEITHER;
}

// G81: the 2025 figure is the Rev. Proc. 2024-40 section 2.41 value pinned in
// `us.irc.inflation_adjustments`, not the unadjusted statutory base.
// RED on 25.09 in BOTH evaluators, for a reason outside this scenario: the
// A3 parameter `BasicExclusionAmount` written as a bare head argument
// (`ApplicableExclusionAmountNoDsueRule`) yields NEITHER in every year, while
// the same parameter inside an expression evaluates (`+ 0.00 USD` made this
// scenario pass in a scratch world). Static check is silent. Finding for
// qualification (compiler vs SPEC) — TECH-GAPS "Сортировка", not patched here.
test "S2010-06-BASIC-EXCLUSION-2025-REV-PROC-2024-40" {
    given {
        context {
            legal_time @2025-06-01;
            decision_time @2025-06-01T09:00:00-04:00;
            knowledge_time @2025-06-01T09:00:00-04:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s2010:t6#e")) { origin case_input; }
    }
    evaluate truth(applicable_exclusion_amount(entity_ref("urn:test:s2010:t6#e"), 13990000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2010-07-BASIC-EXCLUSION-2024-STILL-A-SOURCE-GAP" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-04:00;
            knowledge_time @2024-06-01T09:00:00-04:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s2010:t7#e")) { origin case_input; }
    }
    // Rev. Proc. 2023-34 (the 2024 figure) is not pinned: no value, not a guess.
    evaluate truth(applicable_exclusion_amount(entity_ref("urn:test:s2010:t7#e"), 13610000 USD));
    expect truth_status == NEITHER;
}

test "S2010-04-PORTABILITY-VALID-WITH-TIMELY-RETURN" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_of(entity_ref("urn:test:s2010:t4#e1"), entity_ref("urn:test:s2010:t4#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f1": dsue_return_filed(entity_ref("urn:test:s2010:t4#e1")) { origin case_input; }
        assert "f2": dsue_return_timely(entity_ref("urn:test:s2010:t4#e1")) { origin case_input; }
        assert "f3": portability_elected(entity_ref("urn:test:s2010:t4#e1")) { origin case_input; }
    }
    evaluate truth(portability_election_valid(entity_ref("urn:test:s2010:t4#e1")));
    expect truth_status == TRUE_ONLY;
}

test "S2010-05-PORTABILITY-INVALID-RETURN-NOT-TIMELY" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": executor_of(entity_ref("urn:test:s2010:t5#e1"), entity_ref("urn:test:s2010:t5#x"), [@2024-01-01, infinity)) { origin case_input; }
        assert "f1": dsue_return_filed(entity_ref("urn:test:s2010:t5#e1")) { origin case_input; }
        assert "f2": portability_elected(entity_ref("urn:test:s2010:t5#e1")) { origin case_input; }
    }
    // dsue_return_timely not asserted: POWER_INVALID_EXERCISE, no effect.
    evaluate truth(portability_election_valid(entity_ref("urn:test:s2010:t5#e1")));
    expect truth_status == FALSE_ONLY;
}
