// Sections 2037, 2039 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2037-01-REVERSION-EXCEEDS-5-PERCENT-INCLUDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": possession_obtainable_only_by_surviving_decedent(entity_ref("urn:test:s2037:t1#e"), entity_ref("urn:test:s2037:t1#item")) { origin case_input; }
        assert "f1": reversionary_interest_value_2037(entity_ref("urn:test:s2037:t1#e"), entity_ref("urn:test:s2037:t1#item"), 60000 USD) { origin case_input; }
        assert "f2": value_at_death(entity_ref("urn:test:s2037:t1#e"), entity_ref("urn:test:s2037:t1#item"), 1000000 USD) { origin case_input; }
    }
    // 60,000 / 1,000,000 = 6% > 5%.
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2037:t1#e"), entity_ref("urn:test:s2037:t1#item"), 1000000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2037-02-REVERSION-BELOW-5-PERCENT-NOT-INCLUDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": possession_obtainable_only_by_surviving_decedent(entity_ref("urn:test:s2037:t2#e"), entity_ref("urn:test:s2037:t2#item")) { origin case_input; }
        assert "f1": reversionary_interest_value_2037(entity_ref("urn:test:s2037:t2#e"), entity_ref("urn:test:s2037:t2#item"), 10000 USD) { origin case_input; }
        assert "f2": value_at_death(entity_ref("urn:test:s2037:t2#e"), entity_ref("urn:test:s2037:t2#item"), 1000000 USD) { origin case_input; }
    }
    evaluate truth(reversionary_interest_exceeds_5_percent(entity_ref("urn:test:s2037:t2#e"), entity_ref("urn:test:s2037:t2#item")));
    expect truth_status == NEITHER;
}

test "S2039-01-ANNUITY-PARTIAL-CONTRIBUTION-RATIO" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": annuity_receivable_by_surviving_beneficiary(entity_ref("urn:test:s2039:t1#e"), entity_ref("urn:test:s2039:t1#contract"), entity_ref("urn:test:s2039:t1#ben"), true) { origin case_input; }
        assert "f1": decedent_had_annuity_right(entity_ref("urn:test:s2039:t1#e"), entity_ref("urn:test:s2039:t1#contract")) { origin case_input; }
        assert "f2": annuity_full_value(entity_ref("urn:test:s2039:t1#e"), entity_ref("urn:test:s2039:t1#contract"), 100000 USD) { origin case_input; }
        assert "f3": decedent_contribution_ratio_2039(entity_ref("urn:test:s2039:t1#e"), entity_ref("urn:test:s2039:t1#contract"), 0.60) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2039:t1#e"), entity_ref("urn:test:s2039:t1#contract"), 60000.00 USD));
    expect truth_status == TRUE_ONLY;
}
