            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": dower_or_curtesy_interest_value(entity_ref("urn:test:s2034:t1#e"), entity_ref("urn:test:s2034:t1#item"), 150000 USD) { origin case_input; }
        assert "f1": alternate_valuation_elected(entity_ref("urn:test:s2034:t1#e")) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2034:t1#e"), entity_ref("urn:test:s2034:t1#item"), 150000 USD));
    expect truth_status == NEITHER;
}

test "S2043-01-PARTIAL-CONSIDERATION-INCLUDES-ONLY-THE-EXCESS" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": retained_possession_enjoyment_or_income(entity_ref("urn:test:s2043:t2#e"), entity_ref("urn:test:s2043:t2#item")) { origin case_input; }
        assert "f1": value_at_death(entity_ref("urn:test:s2043:t2#e"), entity_ref("urn:test:s2043:t2#item"), 1000000 USD) { origin case_input; }
        assert "f2": consideration_received_by_decedent(entity_ref("urn:test:s2043:t2#e"), entity_ref("urn:test:s2043:t2#item"), 400000 USD) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2043:t2#e"), entity_ref("urn:test:s2043:t2#item"), 600000 USD));
    expect truth_status == TRUE_ONLY;
}

