        assert "f1": decedent_qualifying_income_interest_for_life(entity_ref("urn:test:s2044:t12#e"), entity_ref("urn:test:s2044:t12#item")) { origin case_input; }
        assert "f2": value_at_death(entity_ref("urn:test:s2044:t12#e"), entity_ref("urn:test:s2044:t12#item"), 800000 USD) { origin case_input; }
        assert "f3": decedent_individual(entity_ref("urn:test:s2044:t12#e"), entity_ref("urn:test:s2044:t12#p")) { origin case_input; }
        assert "f4": qtip_property_2519(entity_ref("urn:test:s2044:t12#item")) { origin case_input; }
        assert "f5": qualifying_income_interest_disposition(entity_ref("urn:test:s2044:t12#p"), entity_ref("urn:test:s2044:t12#item"), @2020-06-01, 300000 USD) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2044:t12#e"), entity_ref("urn:test:s2044:t12#item"), 800000 USD));
    expect truth_status == NEITHER;
}

