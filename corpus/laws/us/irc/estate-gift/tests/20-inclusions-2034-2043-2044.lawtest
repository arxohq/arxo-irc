// Sections 2034, 2043, 2044, 2045 scenarios (module 20). NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF). Expectations come from the statute text.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2034-01-DOWER-INTEREST-VALUE-INCLUDED" {
    given {
        context {
            legal_time @2026-01-15;
            decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": dower_or_curtesy_interest_value(entity_ref("urn:test:s2034:t0#e"), entity_ref("urn:test:s2034:t0#item"), 150000 USD) { origin case_input; }
    }
    evaluate truth(gross_estate_item(entity_ref("urn:test:s2034:t0#e"), entity_ref("urn:test:s2034:t0#item"), 150000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2034-02-DOWER-INTEREST-NOT-INCLUDED-UNDER-ALTERNATE-VALUATION-DEFAULT-RULE" {
    given {
        context {
            legal_time @2026-01-15;
