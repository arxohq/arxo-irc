test "S2208-01-POSSESSION-RESIDENT-CITIZEN-TREATED-AS-CITIZEN" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": decedent_us_citizen_resident_of_possession(entity_ref("urn:test:s2208:t0#e")) { origin case_input; }
    }
    evaluate truth(possession_decedent_treated_as_citizen_2208(entity_ref("urn:test:s2208:t0#e")));
    expect truth_status == TRUE_ONLY;
}

