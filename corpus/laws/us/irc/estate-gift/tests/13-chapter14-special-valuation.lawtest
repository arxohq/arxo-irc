test "S2704-01-LAPSE-DEEMED-TRANSFER-AMOUNT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": voting_or_liquidation_right_lapse(entity_ref("urn:test:s2704:t1#p"), 1, @2024-03-01) { origin case_input; }
        assert "f1": family_controls_entity_before_and_after_lapse(entity_ref("urn:test:s2704:t1#p"), 1) { origin case_input; }
        assert "f2": entity_interest_value_before_lapse_nonlapsing_assumption(entity_ref("urn:test:s2704:t1#p"), 1, 500000 USD) { origin case_input; }
        assert "f3": entity_interest_value_after_lapse(entity_ref("urn:test:s2704:t1#p"), 1, 400000 USD) { origin case_input; }
    }
    evaluate truth(lapse_deemed_transfer_amount_2704(entity_ref("urn:test:s2704:t1#p"), 1, 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}
