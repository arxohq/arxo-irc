test "S2703-01-BUY-SELL-MEETING-ALL-EXCEPTIONS-NOT-DISREGARDED" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": option_or_restriction_on_property(entity_ref("urn:test:s2703:t1#owner"), entity_ref("urn:test:s2703:t1#stock"), OptionToAcquireBelowFairMarketValue) { origin case_input; }
        assert "f1": option_or_restriction_bona_fide_business_arrangement(entity_ref("urn:test:s2703:t1#owner"), entity_ref("urn:test:s2703:t1#stock")) { origin case_input; }
        assert "f2": option_or_restriction_not_a_device(entity_ref("urn:test:s2703:t1#owner"), entity_ref("urn:test:s2703:t1#stock")) { origin case_input; }
        assert "f3": option_or_restriction_comparable_to_arms_length(entity_ref("urn:test:s2703:t1#owner"), entity_ref("urn:test:s2703:t1#stock")) { origin case_input; }
    }
    evaluate truth(option_or_restriction_disregarded(entity_ref("urn:test:s2703:t1#owner"), entity_ref("urn:test:s2703:t1#stock")));
    expect truth_status == NEITHER;
}

