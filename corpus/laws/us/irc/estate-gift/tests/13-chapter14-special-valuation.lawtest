// Sections 2701-2704 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

test "S2701-01-NONQUALIFIED-DISTRIBUTION-RIGHT-ZERO-VALUE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_retained_interest_2701(entity_ref("urn:test:s2701:t1#parent"), 1, DistributionRight) { origin case_input; }
        assert "f1": transfer_of_entity_interest_to_family_member(entity_ref("urn:test:s2701:t1#parent"), entity_ref("urn:test:s2701:t1#child"), 1, 100000 USD) { origin case_input; }
        assert "f2": combined_vote_or_value_share_2701(entity_ref("urn:test:s2701:t1#parent"), 1, 0.80) { origin case_input; }
    }
    evaluate truth(section_2701_value(entity_ref("urn:test:s2701:t1#parent"), 1, 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2701-02-QUALIFIED-PAYMENT-ACTUAL-VALUE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": applicable_retained_interest_2701(entity_ref("urn:test:s2701:t2#parent"), 1, DistributionRight) { origin case_input; }
        assert "f1": transfer_of_entity_interest_to_family_member(entity_ref("urn:test:s2701:t2#parent"), entity_ref("urn:test:s2701:t2#child"), 1, 100000 USD) { origin case_input; }
        assert "f2": combined_vote_or_value_share_2701(entity_ref("urn:test:s2701:t2#parent"), 1, 0.80) { origin case_input; }
        assert "f3": retained_right_is_qualified_payment(entity_ref("urn:test:s2701:t2#parent"), 1) { origin case_input; }
        assert "f4": qualified_payment_value_2701(entity_ref("urn:test:s2701:t2#parent"), 1, 40000 USD) { origin case_input; }
    }
    evaluate truth(section_2701_value(entity_ref("urn:test:s2701:t2#parent"), 1, 40000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S2702-01-GRAT-QUALIFIED-INTEREST-ACTUARIAL-VALUE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": retained_trust_interest(entity_ref("urn:test:s2702:t1#grantor"), entity_ref("urn:test:s2702:t1#trust")) { origin case_input; }
        assert "f1": qualified_interest_2702(entity_ref("urn:test:s2702:t1#grantor"), entity_ref("urn:test:s2702:t1#trust"), FixedAmountAnnually) { origin case_input; }
        assert "f2": qualified_interest_actuarial_value_7520(entity_ref("urn:test:s2702:t1#grantor"), entity_ref("urn:test:s2702:t1#trust"), 250000 USD) { origin case_input; }
    }
    evaluate truth(section_2702_value(entity_ref("urn:test:s2702:t1#grantor"), entity_ref("urn:test:s2702:t1#trust"), 250000.00 USD));
    expect truth_status == TRUE_ONLY;
}

