// 26 U.S.C. §§2053, 2056 — expenses/indebtedness/taxes deduction and the
// marital deduction (including the terminable-interest rule and the QTIP
// election).
//
// JUDGMENT CALLS:
//  - §2053(b) (expenses of administering non-probate property) and §2053(c)
//    (the consideration-limitation and property-subject-to-claims cap) are
//    NOT modelled: TECH_GAP, narrower administration-law tests than the
//    core (a)(1)-(4) categories this stage covers.
//  - §2053(d) (election to deduct foreign death taxes in lieu of a section
//    2014 credit) is NOT modelled: TECH_GAP, a cross-reference power against
//    a credit this stage's §2011-2016 scope does not reach (see report).
//  - §2056(b)(1)'s general terminable-interest rule and (b)(7)'s QTIP
//    exception are modelled fully; (b)(3) (the 6-month/common-disaster
//    survivorship exception), (b)(5)/(b)(6) (life-estate-with-power-of-
//    appointment marital trusts), (b)(8) (charitable remainder trust
//    exception), (c) (the "passing from the decedent" definition) and (d)
//    (the noncitizen-spouse/QDOT rules) are NOT modelled this stage:
//    TECH_GAP/NON_NORMATIVE as noted per rule below — §2056 alone carries
//    130 disposition rows and this stage reaches only the operative core.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    EstateDeductionKind,
    IRC_S2053_A,
    IRC_S2056_A,
    IRC_S2056_B,
    Person,
    claim_is_promise_to_make_charitable_gift_2053c1a,
    deduction_barred_2053c1,
    deduction_barred_by_alternate_valuation_2032b,
    estate_deduction_allowed,
    executor_of,
    marital_deductible_value,
    marital_deduction_barred_noncitizen_2056d1,
    other_person_interest_2056b1,
    terminable_interest_effective,
    terminable_interest_exception_2056b,
};

// --- §2053: expenses, indebtedness, and taxes -------------------------------

pub relation funeral_expenses(e: Estate, amount: Money) kind empirical {
    label en unofficial "funeral expenses allowable by the law of the jurisdiction administering the estate (section 2053(a)(1))";
}
pub relation administration_expenses(e: Estate, amount: Money) kind empirical {
    label en unofficial "administration expenses allowable by the law of the jurisdiction administering the estate (section 2053(a)(2))";
}
pub relation claims_against_estate(e: Estate, amount: Money) kind empirical {
    label en unofficial "claims against the estate allowable by the law of the jurisdiction administering the estate (section 2053(a)(3))";
}
pub relation unpaid_mortgages_or_indebtedness(e: Estate, amount: Money) kind empirical {
    label en unofficial "unpaid mortgages on, or indebtedness in respect of, property included at its undiminished value (section 2053(a)(4))";
}
pub relation claim_founded_on_promise_bona_fide_full_consideration(e: Estate, amount: Money) kind empirical {
    label en unofficial "the claim, when founded on a promise or agreement, was contracted bona fide and for adequate and full consideration in money or money's worth (section 2053(c)(1)(A))";
}

// Each category yields its own relation; 19-deductions-2054-2055-2058-completion.law
// adds them into ONE estate-level total (`expenses_indebtedness_and_taxes_total_2053`),
// because `total_estate_deductions` sums over (amount, kind) and two categories with
// equal amounts would otherwise collapse into one tuple.
pub relation deductible_funeral_expense_2053(e: Estate, amount: Money) kind institutional {
    label en unofficial "a funeral expense deductible under section 2053(a)(1)";
}
pub relation deductible_administration_expense_2053(e: Estate, amount: Money) kind institutional {
    label en unofficial "an administration expense deductible under section 2053(a)(2)";
}
pub relation deductible_claim_2053(e: Estate, amount: Money) kind institutional {
    label en unofficial "a claim against the estate deductible under section 2053(a)(3) and (c)(1)(A): contracted bona fide for adequate and full consideration, directly or through section 2043(b)(2)";
}
pub relation deductible_indebtedness_2053(e: Estate, amount: Money) kind institutional {
    label en unofficial "an unpaid mortgage or indebtedness deductible under section 2053(a)(4)";
}
@source(IRC_S2053_A, relation = formalizes, coverage = exact, quote = "the value of the taxable estate shall be determined by deducting from the value of the gross estate such amounts")
rule Section2053FuneralExpensesDeductionRule(e: Estate, amount: Money) defeasible {
    label en official "funeral expenses allowable under local law are deducted (section 2053(a)(1))";
    when funeral_expenses(e, amount);
    when not_known(deduction_barred_2053c1(e, amount));
    then deductible_funeral_expense_2053(e, amount);
}
rule Section2053AdministrationExpensesDeductionRule(e: Estate, amount: Money) defeasible {
    label en official "administration expenses allowable under local law are deducted (section 2053(a)(2))";
    when administration_expenses(e, amount);
    when not_known(deduction_barred_2053c1(e, amount));
    then deductible_administration_expense_2053(e, amount);
}
rule Section2053ClaimsDeductionRule(e: Estate, amount: Money) defeasible {
    label en official "claims against the estate, when founded on a promise or agreement contracted bona fide and for full consideration, are deducted (section 2053(a)(3), (c)(1)(A))";
    when claims_against_estate(e, amount)
        and claim_founded_on_promise_bona_fide_full_consideration(e, amount);
    when not_known(claim_is_promise_to_make_charitable_gift_2053c1a(e, amount));
    when not_known(deduction_barred_2053c1(e, amount));
    then deductible_claim_2053(e, amount);
}
rule Section2053UnpaidMortgagesDeductionRule(e: Estate, amount: Money) defeasible {
    label en official "unpaid mortgages or indebtedness are deducted where the undiminished value is included in the gross estate (section 2053(a)(4))";
    when unpaid_mortgages_or_indebtedness(e, amount);
    when not_known(deduction_barred_2053c1(e, amount));
    then deductible_indebtedness_2053(e, amount);
}

// Section 2053(c)(1)(B) ("Any income taxes on income received after the
// death of the decedent, or property taxes not accrued before his death, or
// any estate, succession, legacy, or inheritance taxes, shall not be
// deductible under this section.") is a NEGATIVE scope limit on the four
// deduction categories above, not a separate computable rule: this stage
// relies on the case never asserting such an item as `claims_against_estate`
// etc. in the first place, rather than deriving an exclusion test over an
// open-ended category of "kinds of tax" — classified NON_NORMATIVE (scope
// clarification) in the coverage row.

// --- §2056: bequests, etc., to surviving spouse -----------------------------

pub relation interest_passes_to_surviving_spouse(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "an interest in property that passes or has passed from the decedent to the surviving spouse, to the extent included in the gross estate (section 2056(a))";
}
pub relation terminable_interest(e: Estate, item: Asset) kind empirical {
    label en unofficial "the interest passing to the surviving spouse will terminate or fail on the lapse of time, an event, or a contingency (section 2056(b)(1))";
}
pub relation other_person_may_possess_after_termination(e: Estate, item: Asset) kind empirical {
    label en unofficial "an interest in the same property passes from the decedent (for less than full consideration) to a person other than the surviving spouse who (or whose heirs/assigns) may possess or enjoy the property after the spouse's interest terminates (section 2056(b)(1)(A)-(B))";
}
pub relation qtip_election_made(e: Estate, item: Asset) kind empirical {
    label en unofficial "the executor made the section 2056(b)(7) QTIP election with respect to this property on the estate tax return";
}
pub relation surviving_spouse_qualifying_income_interest_for_life(e: Estate, item: Asset) kind empirical {
    label en unofficial "the surviving spouse is entitled to all the income from the property, payable at least annually, and no person has a power to appoint any part of the property to anyone other than the surviving spouse during the spouse's life (section 2056(b)(7)(B)(ii))";
}

pub relation marital_deduction_item_2056(e: Estate, item: Asset, amount: Money) kind institutional {
    label en official "the section 2056(a) marital deduction allowed for the stated item (one tuple per item: the estate-level total below is aggregated over items so that equal item amounts are not collapsed)";
}
@source(IRC_S2056_A, relation = formalizes, coverage = exact, quote = "the value of the taxable estate shall, except as limited by subsection (b), be determined by deducting from the value of the gross estate an amount equal to the value of any interest in property which passes or has passed from the decedent to his surviving spouse, but only to the extent that such interest is included in determining the value of the gross estate")
rule Section2056MaritalDeductionGeneralRule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "the marital deduction: the value of an interest passing to the surviving spouse, to the extent included in the gross estate, EXCEPT a terminable interest disqualified by subsection (b) and property barred by subsection (d) (section 2056(a)); the value is the section 2056(b)(2)/(4) adjusted value";
    when marital_deductible_value(e, item, amount)
        and not_known(disqualified_terminable_interest(e, item));
    when not_known(marital_deduction_barred_noncitizen_2056d1(e, item));
    when not_known(deduction_barred_by_alternate_valuation_2032b(e, item));
    then marital_deduction_item_2056(e, item, amount);
}
pub relation marital_deduction_total_2056(e: Estate, amount: Money) kind institutional {
    label en official "the total section 2056 marital deduction: the sum over allowed items";
}
rule MaritalDeductionTotal2056Rule(e: Estate) defeasible {
    when marital_deduction_item_2056(e, _, _);
    then marital_deduction_total_2056(e, sum(collect all v: Money, item: Asset where marital_deduction_item_2056(e, item, v), empty: 0.00 USD));
}
rule MaritalDeductionEstateDeductionRule(e: Estate, total: Money) defeasible {
    label en official "the section 2056 total enters the taxable estate as the marital deduction (section 2051)";
    when marital_deduction_total_2056(e, total);
    then estate_deduction_allowed(e, MaritalDeduction, total);
}

@source(IRC_S2056_B, relation = formalizes, coverage = exact, quote = "no deduction shall be allowed under this section with respect to such interest")
pub relation disqualified_terminable_interest(e: Estate, item: Asset) kind institutional {
    label en official "the terminable-interest rule disqualifies the interest from the marital deduction unless a QTIP (or other subsection (b) exception) election saves it (section 2056(b)(1))";
}
rule DisqualifiedTerminableInterestRule(e: Estate, item: Asset) defeasible {
    label en official "a terminable interest passing to the spouse, where another person may possess or enjoy the property after termination, is disqualified unless a subsection (b) exception applies (section 2056(b)(1), (3), (5)-(8))";
    when terminable_interest_effective(e, item)
        and other_person_interest_2056b1(e, item);
    when not_known(terminable_interest_exception_2056b(e, item));
    then disqualified_terminable_interest(e, item);
}

@source(IRC_S2056_B, relation = formalizes, coverage = exact, quote = "In the case of qualified terminable interest property")
pub relation qtip_saved(e: Estate, item: Asset) kind institutional {
    label en official "a valid QTIP election treats the property as passing entirely to the surviving spouse, overriding the terminable-interest disqualification (section 2056(b)(7))";
}

@source(IRC_S2056_B, relation = formalizes, coverage = exact, quote = "An election under this paragraph with respect to any property shall be made by the executor on the return of tax imposed by section 2001. Such an election, once made, shall be irrevocable.")
rule QtipElectionPower(e: Estate, item: Asset, x: Person, w: Interval<Instant>) strict {
    label en official "the QTIP election is made by the executor on the estate tax return (section 2056(b)(7)(B)(v))";
    when executor_of(e, x, w)
        and qtip_election_made(e, item);
    then power QtipElection {
        holder x;
        over e;
        exercise qtip_election_made(e, item);
        valid_when qtip_election_validly_makeable(e, item);
        effect create(qtip_saved(e, item));
        window w;
    };
}
pub relation qtip_election_validly_makeable(e: Estate, item: Asset) kind institutional {
    label en official "the property is qualified terminable interest property: it passes from the decedent and the surviving spouse has a qualifying income interest for life (section 2056(b)(7)(B)(i))";
}
rule QtipElectionValidlyMakeableRule(e: Estate, item: Asset) strict {
    when interest_passes_to_surviving_spouse(e, item, _)
        and surviving_spouse_qualifying_income_interest_for_life(e, item);
    then qtip_election_validly_makeable(e, item);
}
