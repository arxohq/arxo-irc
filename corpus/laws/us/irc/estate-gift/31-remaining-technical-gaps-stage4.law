// Estate and gift -- stage 4 (26.09.2026, DECISION-0379, implemented_unverified): technical gaps of stage 2 that admit a
// bounded statement: section 2001(f)(1)(B) (the section 2701(d) increase valued as finally determined), section 2001(g)
// (the at-death rates closed form; the regulation-delegated (g)(2)), section 2013(c)(1)(B) (the tax computed excluding the
// transferred property), section 2055(e)(3)(E) (the limitation of the reformation deduction) and section 2522(c)(4)(B)
// (rules similar to section 2055(e)(3), copied for gifts).
//
// METHOD AND JUDGMENT CALLS.
//  - Section 2013(c)(1)(B): the tentative base is reduced by the value of the property and increased by the charitable
//    deduction attributable to it (case fact), and the rate schedule and the credit of the estate are applied again; the
//    other consequences of excluding the property (marital deduction, section 2032A) are the case responsibility.
//  - Section 2055(e)(3)(E): the two actuarial values (section 7520) are case facts; the limitation is a minimum.
//  - Section 2522(c)(4)(B): "rules similar to" is a copy of the section 2055(e)(3)(A)-(B) rules over the gift relations; the
//    asserted gift_qualified_reformation_2055e3B of module 23 stays a valid input.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2001_F,
    IRC_S2013_C,
    IRC_S2055_E,
    IRC_S2522_C,
    Individual,
    TaxableYear,
    adjusted_taxable_gifts,
    applicable_credit_amount,
    bracket_2001c,
    decedent_individual,
    estate_tax_after_2010_2012_2014,
    gift_tax_payable_at_current_rates,
    has_gift_tax_payable_at_current_rates,
    prior_gift_assessment_period_expired,
    prior_transfer_credit_limitation,
    prior_transfer_property_value,
    qualified_interest_actuarial_value,
    qualified_reformation_2055e3,
    reformable_interest_actuarial_value,
    split_interest_qualifies_2522,
    tentative_tax_base,
};

// ============================================================================
// section 2001(f)(1)(B): the section 2701(d) increase, valued as finally determined
// ============================================================================

pub relation increase_2701d_value_shown_on_return_2001f2A(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) kind empirical {
    label en official "section 2001(f)(2)(A): the value of the section 2701(d) increase is shown on a return under chapter 12 (disclosed adequately)";
}
pub relation increase_2701d_contested_by_secretary_2001f2A(donor: Individual, y: TaxableYear, entity_id: Integer) kind empirical {
    label en official "section 2001(f)(2)(A): the Secretary contested the value before the time under section 6501 expired";
}
pub relation increase_2701d_value_specified_and_not_contested_2001f2B(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) kind empirical {
    label en official "section 2001(f)(2)(B): in a case not described in (A), the value is specified by the Secretary and not timely contested by the taxpayer";
}
pub relation increase_2701d_value_by_court_or_settlement_2001f2C(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) kind empirical {
    label en official "section 2001(f)(2)(C): the value is determined by a court or pursuant to a settlement agreement with the Secretary";
}
pub relation increase_2701d_value_finally_determined_2001f2(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) kind institutional {
    label en official "section 2001(f)(2) applied to an increase in taxable gifts required under section 2701(d)";
}
@source(IRC_S2001_F, quote = "(A) the value is shown on a return under such chapter and such value is not contested by the Secretary before the expiration of the time referred to in paragraph (1) with respect to such return;")
rule Increase2701dFinalShownOnReturn(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) defeasible {
    label en official "section 2001(f)(2)(A)";
    when increase_2701d_value_shown_on_return_2001f2A(donor, y, entity_id, amount);
    when prior_gift_assessment_period_expired(donor, y);
    when not_known(increase_2701d_contested_by_secretary_2001f2A(donor, y, entity_id));
    then increase_2701d_value_finally_determined_2001f2(donor, y, entity_id, amount);
}
@source(IRC_S2001_F, quote = "(B) in a case not described in subparagraph (A), the value is specified by the Secretary and such value is not timely contested by the taxpayer; or")
rule Increase2701dFinalSpecified(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) defeasible {
    label en official "section 2001(f)(2)(B)";
    when increase_2701d_value_specified_and_not_contested_2001f2B(donor, y, entity_id, amount);
    then increase_2701d_value_finally_determined_2001f2(donor, y, entity_id, amount);
}
@source(IRC_S2001_F, quote = "(C) the value is determined by a court or pursuant to a settlement agreement with the Secretary.")
rule Increase2701dFinalCourt(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) defeasible {
    label en official "section 2001(f)(2)(C)";
    when increase_2701d_value_by_court_or_settlement_2001f2C(donor, y, entity_id, amount);
    then increase_2701d_value_finally_determined_2001f2(donor, y, entity_id, amount);
}
pub relation increase_2701d_value_for_estate_tax_2001f1B(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) kind institutional {
    label en official "section 2001(f)(1)(B): the value of the increase in taxable gifts for computing the estate tax is the value as finally determined for chapter 12 once the assessment period has expired";
}
@source(IRC_S2001_F, quote = "(B) an increase in taxable gifts required under section 2701(d),")
rule Increase2701dValueForEstateTax(donor: Individual, y: TaxableYear, entity_id: Integer, amount: Money) defeasible {
    label en official "section 2001(f)(1)(B)";
    when increase_2701d_value_finally_determined_2001f2(donor, y, entity_id, amount);
    when prior_gift_assessment_period_expired(donor, y);
    then increase_2701d_value_for_estate_tax_2001f1B(donor, y, entity_id, amount);
}
pub relation adjusted_taxable_gifts_including_2701d_increases(e: Estate, amount: Money) kind institutional {
    label en official "section 2001(b)(1)(B) with (f)(1)(B) and section 2701(d)(1)(B): the adjusted taxable gifts plus the finally determined increases in taxable gifts (added beside adjusted_taxable_gifts of module 05, which is not changed)";
}
@source(IRC_S2001_F, quote = "(B) an increase in taxable gifts required under section 2701(d),")
rule AdjustedTaxableGiftsIncludingIncreases2701d(e: Estate, donor: Individual, gifts: Money) defeasible {
    label en official "section 2001(b)(1)(B), (f)(1)(B)";
    when decedent_individual(e, donor);
    when adjusted_taxable_gifts(e, gifts);
    then adjusted_taxable_gifts_including_2701d_increases(e, gifts + sum(collect all a: Money, y: TaxableYear, n: Integer where increase_2701d_value_for_estate_tax_2001f1B(donor, y, n, a), empty: 0.00 USD));
}

// ============================================================================
// section 2013(c)(1)(B): the tax computed excluding the transferred property
// ============================================================================

pub relation charitable_deduction_attributable_to_transferred_property_2013c1B(decedent_estate: Estate, transferor_estate: Estate, amount: Money) kind empirical {
    label en official "section 2013(c)(1)(B): the section 2055 or 2106(a)(2) charitable deduction attributable to the transferred property, to be removed when the property is excluded (case fact)";
}
pub relation tentative_base_excluding_prior_transfer_2013c1B(decedent_estate: Estate, transferor_estate: Estate, base: Money) kind institutional {
    label en official "section 2013(c)(1)(B): the tentative tax base with the value of the transferred property excluded from the gross estate and the attributable charitable deduction removed";
}
@source(IRC_S2013_C, quote = "(B) such tax computed by excluding from the decedent's gross estate the value of such property transferred and, if applicable, by making the adjustment hereinafter indicated.")
rule TentativeBaseExcludingPriorTransfer(e: Estate, t: Estate, base: Money, value: Money, charitable: Money) defeasible {
    label en official "section 2013(c)(1)(B): base minus the value of the property plus the charitable deduction attributable to it (not below zero)";
    when tentative_tax_base(e, base);
    when prior_transfer_property_value(t, e, value);
    when charitable_deduction_attributable_to_transferred_property_2013c1B(e, t, charitable);
    then tentative_base_excluding_prior_transfer_2013c1B(e, t, max(0.00 USD, base - value + charitable));
}
rule TentativeBaseExcludingPriorTransferNoCharitable(e: Estate, t: Estate, base: Money, value: Money) defeasible {
    label en official "section 2013(c)(1)(B): no charitable deduction attributable to the property";
    when tentative_tax_base(e, base);
    when prior_transfer_property_value(t, e, value);
    unless charitable_deduction_attributable_to_transferred_property_2013c1B(e, t, _) and tentative_tax_base(e, base) and prior_transfer_property_value(t, e, value);
    then tentative_base_excluding_prior_transfer_2013c1B(e, t, max(0.00 USD, base - value));
}
pub relation estate_tax_excluding_prior_transfer_derived_2013c1B(decedent_estate: Estate, transferor_estate: Estate, amount: Money) kind institutional {
    label en official "section 2013(c)(1)(B): the estate tax after the unified credit computed on the base excluding the transferred property (the schedule of section 2001(c), the gift tax payable at the rates at death and the credit of the estate applied again)";
}
@source(IRC_S2013_C, quote = "(B) such tax computed by excluding from the decedent's gross estate the value of such property transferred and, if applicable, by making the adjustment hereinafter indicated.")
rule EstateTaxExcludingPriorTransferWithGiftTax(e: Estate, t: Estate, base2: Money, lower: Money, base_tax: Money, rate: Decimal, gift_tax: Money, credit: Money) defeasible {
    label en official "section 2013(c)(1)(B) with post-1976 gift tax payable";
    when tentative_base_excluding_prior_transfer_2013c1B(e, t, base2);
    when bracket_2001c(base2, lower, base_tax, rate);
    when gift_tax_payable_at_current_rates(e, gift_tax);
    when applicable_credit_amount(e, credit);
    then estate_tax_excluding_prior_transfer_derived_2013c1B(e, t, max(0.00 USD, max(0.00 USD, base_tax + rate * (base2 - lower) - gift_tax) - credit));
}
rule EstateTaxExcludingPriorTransferNoGiftTax(e: Estate, t: Estate, base2: Money, lower: Money, base_tax: Money, rate: Decimal, credit: Money) defeasible {
    label en official "section 2013(c)(1)(B) without post-1976 gift tax payable";
    when tentative_base_excluding_prior_transfer_2013c1B(e, t, base2);
    when bracket_2001c(base2, lower, base_tax, rate);
    when applicable_credit_amount(e, credit);
    when not_known(has_gift_tax_payable_at_current_rates(e));
    then estate_tax_excluding_prior_transfer_derived_2013c1B(e, t, max(0.00 USD, base_tax + rate * (base2 - lower) - credit));
}
@source(IRC_S2013_C, quote = "The credit provided in this section shall not exceed the amount by which")
rule PriorTransferCreditLimitationFromDerived2013c1B(e: Estate, t: Estate, after_credits: Money, excluding: Money) defeasible {
    label en official "section 2013(c)(1): the limitation read on the derived tax excluding the transferred property";
    when estate_tax_after_2010_2012_2014(e, after_credits);
    when estate_tax_excluding_prior_transfer_derived_2013c1B(e, t, excluding);
    then prior_transfer_credit_limitation(e, t, max(0.00 USD, after_credits - excluding));
}

// ============================================================================
// section 2055(e)(3)(E): the limitation of the deduction for a qualified reformation
// ============================================================================

pub relation deduction_for_qualified_reformation_2055e3E(e: Estate, item: Asset, amount: Money) kind institutional {
    label en official "section 2055(e)(3)(E): the deduction for the qualified reformation is not more than the deduction which would have been allowable for the reformable interest but for paragraph (2), that is, its actuarial value; the deduction of the qualified interest is its actuarial value. JUDGMENT CALL: the two section 7520 values are case facts";
}
@source(IRC_S2055_E, quote = "(E) Limitation.—The deduction referred to in subparagraph (A) shall not exceed the amount of the deduction which would have been allowable for the reformable interest but for paragraph (2).")
rule DeductionForQualifiedReformationLimited(e: Estate, item: Asset, qualified: Money, reformable: Money) defeasible {
    label en official "section 2055(e)(3)(E): the smaller of the qualified interest value and the reformable interest value";
    when qualified_reformation_2055e3(e, item);
    when qualified_interest_actuarial_value(e, item, qualified);
    when reformable_interest_actuarial_value(e, item, reformable);
    then deduction_for_qualified_reformation_2055e3E(e, item, min(qualified, reformable));
}

// ============================================================================
// section 2522(c)(4)(B): rules similar to section 2055(e)(3), copied for the gift tax
// ============================================================================

pub relation gift_split_interest_transfer_2522c2(donor: Individual, item: Asset) kind empirical {
    label en official "section 2522(c)(2): the transfer is a split-interest transfer that would be deductible but for paragraph (2)";
}
pub relation gift_reformable_interest_payments_fixed_2522c4B(donor: Individual, item: Asset) kind empirical {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(C)(i): the non-charitable payments are fixed";
}
pub relation gift_reformable_interest_actuarial_value_2522c4B(donor: Individual, item: Asset, value: Money) kind empirical {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(B)(i)(II): the actuarial value of the reformable interest at the date of the gift";
}
pub relation gift_qualified_interest_actuarial_value_2522c4B(donor: Individual, item: Asset, value: Money) kind empirical {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(B)(i)(I): the actuarial value of the qualified interest at the date of the gift";
}
pub relation gift_reformation_changes_reformable_into_qualified_2522c4B(donor: Individual, item: Asset) kind empirical {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(B): a reformation, amendment or construction changes a reformable interest into a qualified interest";
}
pub relation gift_reformation_duration_condition_2522c4B(donor: Individual, item: Asset) kind empirical {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(B)(ii): the duration condition: the nonremainder interest terminates at the same time, or the interests are for the same period";
}
pub relation gift_reformation_effective_as_of_date_of_gift_2522c4B(donor: Individual, item: Asset) kind empirical {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(B)(iii): the change is effective as of the date of the gift";
}
pub relation gift_reformable_interest_2522c4B(donor: Individual, item: Asset) kind institutional {
    label en official "section 2522(c)(4)(B): an interest that would be deductible but for paragraph (2), with fixed non-charitable payments";
}
rule GiftReformableInterest2522c4B(donor: Individual, item: Asset) defeasible {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(A), (C)(i)";
    when gift_split_interest_transfer_2522c2(donor, item);
    when gift_reformable_interest_payments_fixed_2522c4B(donor, item);
    then gift_reformable_interest_2522c4B(donor, item);
}
pub relation gift_reformation_within_five_percent_2522c4B(donor: Individual, item: Asset) kind institutional {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(B)(i): any difference between the actuarial values does not exceed 5 percent of the value of the reformable interest";
}
rule GiftReformationWithinFivePercent2522c4B(donor: Individual, item: Asset, qualified: Money, reformable: Money) defeasible {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(B)(i)";
    when gift_qualified_interest_actuarial_value_2522c4B(donor, item, qualified);
    when gift_reformable_interest_actuarial_value_2522c4B(donor, item, reformable);
    when abs(qualified - reformable) <= 0.05 * reformable;
    then gift_reformation_within_five_percent_2522c4B(donor, item);
}
pub relation gift_qualified_reformation_2522c4B(donor: Individual, item: Asset) kind institutional {
    label en official "section 2522(c)(4)(B): a qualified reformation for the gift tax, by rules similar to section 2055(e)(3)(A)-(B)";
}
@source(IRC_S2522_C, quote = "For purposes of this paragraph, rules similar to the rules of section 2055(e)(3) shall apply.")
rule GiftQualifiedReformation2522c4B(donor: Individual, item: Asset) defeasible {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(A)-(B)";
    when gift_reformable_interest_2522c4B(donor, item);
    when gift_reformation_changes_reformable_into_qualified_2522c4B(donor, item);
    when gift_reformation_within_five_percent_2522c4B(donor, item);
    when gift_reformation_duration_condition_2522c4B(donor, item);
    when gift_reformation_effective_as_of_date_of_gift_2522c4B(donor, item);
    then gift_qualified_reformation_2522c4B(donor, item);
}
@source(IRC_S2522_C, quote = "A deduction shall be allowed under subsection (a) in respect of any qualified reformation (within the meaning of section 2055(e)(3)(B)).")
rule SplitInterestQualifies2522ByAnalogousReformation(donor: Individual, item: Asset) defeasible {
    label en official "section 2522(c)(4)(A) on the qualified reformation derived by (B)";
    when gift_qualified_reformation_2522c4B(donor, item);
    then split_interest_qualifies_2522(item);
}
pub relation gift_deduction_for_qualified_reformation_2522c4B(donor: Individual, item: Asset, amount: Money) kind institutional {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(E): the deduction is not more than the deduction allowable for the reformable interest but for paragraph (2)";
}
rule GiftDeductionForQualifiedReformationLimited(donor: Individual, item: Asset, qualified: Money, reformable: Money) defeasible {
    label en official "section 2522(c)(4)(B) with section 2055(e)(3)(E)";
    when gift_qualified_reformation_2522c4B(donor, item);
    when gift_qualified_interest_actuarial_value_2522c4B(donor, item, qualified);
    when gift_reformable_interest_actuarial_value_2522c4B(donor, item, reformable);
    then gift_deduction_for_qualified_reformation_2522c4B(donor, item, min(qualified, reformable));
}
