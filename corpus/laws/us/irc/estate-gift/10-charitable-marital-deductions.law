// 26 U.S.C. §2055(a),(e) — estate tax charitable deduction — and §2523(a),
// (b),(f),(i) — gift tax marital deduction. Stage-2b module of
// `us.irc.estate_gift` (B01/IRC-11). Publishes `pub charitable_deduction_2055`
// and `pub marital_deduction_2523`.
//
// NOT MODELLED this pass (TECH_GAP, TECH-GAPS.md G480): section 2055(b)-(d)
// (powers-of-appointment inclusion, death-taxes-payable-out-of-bequest
// reduction, the redundant gross-estate-inclusion cap — (d) is naturally
// satisfied by this module's design and not separately gated), 2055(e)(3)-(5)
// (reformation-to-qualify procedures, works-of-art/copyright splitting,
// donor-advised-fund conditions), 2055(f)-(g) (not read this pass); section
// 2523(c)-(e),(g),(h) (unidentified-asset reduction, joint-tenancy carve-out,
// life-estate-with-power-of-appointment-in-donee alternative to QTIP,
// charitable-remainder-trust special rule, double-deduction bar).
//
// JUDGMENT CALLS:
//  - Section 2055(e)(2)'s split-interest disallowance is modelled as a
//    positive predicate + exception, per this package's usual idiom: a
//    transfer is disallowed only when BOTH `split_interest_transfer` (a
//    non-charitable interest in the SAME property passes to a non-described
//    person/use) AND neither qualifying-remainder nor qualifying-other-
//    interest exception is asserted.
//  - Section 2523(b)'s terminable-interest bar likewise requires BOTH
//    `gift_interest_terminable` AND `donor_retains_or_transfers_other_
//    interest` (the statute's own two-part test), not terminability alone.
//  - Section 2523(i)'s "$100,000" substitute figure is the pinned STATUTORY
//    text; the amount actually in force today is indexed by a separate,
//    later technical correction this task's SOURCE-MANIFEST.json does not
//    pin as amending this specific cross-reference — SOURCE_GAP, same
//    pattern as `annual-exclusion-amount.lawparam.json`'s own base-vs-
//    indexed distinction.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2055_A,
    IRC_S2055_E,
    IRC_S2523_A,
    IRC_S2523_B,
    IRC_S2523_F,
    IRC_S2523_I,
    Individual,
    charitable_deduction_disallowed_2055e1,
    charitable_deduction_disallowed_daf_2055e5,
    charitable_deduction_disallowed_void_trust_2055e3j,
    charitable_transfer_capped_2055d,
    deduction_barred_by_alternate_valuation_2032b,
    gift_terminable_interest_exception_2523,
    gift_to_spouse_net_value_2523c,
    section_2523i_not_applicable_to_annuity_transfer,
    separate_properties_art_and_copyright_2055e4,
};

// =====================================================================
// §2055 — estate tax charitable deduction
// =====================================================================

pub enum CharitableRecipientKind {
    GovernmentPublicPurpose;                         // (a)(1)
    ReligiousCharitableScientificLiteraryEducational; // (a)(2)
    FraternalSocietyOrTrust;                          // (a)(3)
    VeteransOrganization;                             // (a)(4)
    EmployeeStockOwnershipPlanQualifiedTransfer;      // (a)(5)
    QualifiedRealPropertyInterestTransfer;            // (f)
}
pub relation charitable_bequest(e: Estate, item: Asset, kind: CharitableRecipientKind, value: Money) kind empirical {
    label en unofficial "a bequest, legacy, devise or transfer of item, of the stated section 2055(a) recipient kind, at the stated value (section 2055(a))";
}
pub relation split_interest_transfer(e: Estate, item: Asset) kind empirical {
    label en unofficial "an interest in item (other than one extinguished at death) passes, for less than full consideration, to a person or use NOT described in section 2055(a) (section 2055(e)(2))";
}
pub relation split_interest_qualifies_remainder(e: Estate, item: Asset) kind empirical {
    label en unofficial "the charitable interest in item is a remainder in a charitable remainder annuity trust, charitable remainder unitrust, or pooled income fund (section 2055(e)(2)(A))";
}
pub relation split_interest_qualifies_guaranteed_or_fixed_percentage(e: Estate, item: Asset) kind empirical {
    label en unofficial "the charitable interest in item is a guaranteed annuity or a fixed percentage of the annually-redetermined fair market value (section 2055(e)(2)(B))";
}
relation split_interest_qualifies(e: Estate, item: Asset) kind institutional;
rule SplitInterestQualifiesRemainderRule(e: Estate, item: Asset) defeasible {
    when split_interest_qualifies_remainder(e, item);
    then split_interest_qualifies(e, item);
}
rule SplitInterestQualifiesOtherRule(e: Estate, item: Asset) defeasible {
    when split_interest_qualifies_guaranteed_or_fixed_percentage(e, item);
    then split_interest_qualifies(e, item);
}

@source(IRC_S2055_E, relation = formalizes, coverage = partial, quote = "no deduction shall be allowed under this section for the interest which passes or has passed to the person, or for the use, described in subsection (a) unless")
pub relation charitable_deduction_disallowed_split_interest(e: Estate, item: Asset) kind institutional {
    label en official "section 2055(e)(2): the charitable interest is disallowed because a split, non-qualifying non-charitable interest exists in the same property";
}
rule CharitableDeductionDisallowedSplitInterestRule(e: Estate, item: Asset) defeasible {
    when split_interest_transfer(e, item);
    when not_known(split_interest_qualifies(e, item));
    when not_known(separate_properties_art_and_copyright_2055e4(e, item));
    then charitable_deduction_disallowed_split_interest(e, item);
}

@source(IRC_S2055_A, relation = formalizes, coverage = exact, quote = "the value of the taxable estate shall be determined by deducting from the value of the gross estate the amount of all bequests, legacies, devises, or transfers")
pub relation charitable_deduction_item_2055(e: Estate, item: Asset, amount: Money) kind institutional {
    label en official "the section 2055(a) charitable deduction allowed for the stated item";
}
rule CharitableDeductionItem2055AllowedRule(e: Estate, item: Asset, value: Money) defeasible {
    label en official "the section 2055(a) deduction for a transfer, after (b) (2041 property), (c) (death taxes), (d) (cap) and unless disallowed by (e)(1), (e)(2), (e)(3)(J) or (e)(5)";
    when charitable_transfer_capped_2055d(e, item, value);
    when not_known(charitable_deduction_disallowed_split_interest(e, item));
    when not_known(charitable_deduction_disallowed_2055e1(e, item));
    when not_known(charitable_deduction_disallowed_daf_2055e5(e, item));
    when not_known(charitable_deduction_disallowed_void_trust_2055e3j(e, item));
    when not_known(deduction_barred_by_alternate_valuation_2032b(e, item));
    then charitable_deduction_item_2055(e, item, value);
}

pub relation charitable_deduction_2055(e: Estate, amount: Money) kind institutional {
    label en official "the total section 2055 charitable deduction: the sum of every allowed item, per subsection (a) (the (c) death-taxes-payable-out-of-bequest reduction and the (d) gross-estate-value cap are NOT separately modelled, module header)";
}
rule CharitableDeduction2055Rule(e: Estate) defeasible {
    when charitable_deduction_item_2055(e, _, _);
    then charitable_deduction_2055(e, sum all v: Money for item: Asset where charitable_deduction_item_2055(e, item, v));
}
relation has_charitable_deduction_item_2055(e: Estate) kind institutional;
rule HasCharitableDeductionItem2055Rule(e: Estate) defeasible {
    when charitable_deduction_item_2055(e, _, _);
    then has_charitable_deduction_item_2055(e);
}

// =====================================================================
// §2523 — gift tax marital deduction
// =====================================================================

pub relation gift_to_spouse(donor: Individual, donee: Individual, item: Asset, y: Integer, value: Money) kind empirical {
    label en unofficial "the donor transferred item to the donee, the donor's spouse at the time of the gift, during calendar year y, at the stated value (section 2523(a))";
}
pub relation gift_interest_terminable(donor: Individual, donee: Individual, item: Asset) kind empirical {
    label en unofficial "the interest transferred to the donee spouse will terminate or fail on the lapse of time, an event or contingency, or its non-occurrence (section 2523(b))";
}
pub relation donor_retains_or_transfers_other_interest(donor: Individual, donee: Individual, item: Asset) kind empirical {
    label en unofficial "the donor retains, or transfers to a third person for less than full consideration, an interest in the same property (or a power to appoint it) such that it may be possessed or enjoyed after the donee spouse's interest terminates (section 2523(b)(1)-(2))";
}

pub relation qtip_qualifying_income_interest_for_life(donor: Individual, donee: Individual, item: Asset) kind institutional {
    label en unofficial "the donee spouse has a qualifying income interest for life in item (section 2523(f)(2)(B))";
}
pub relation qtip_gift_election_made(donor: Individual, donee: Individual, item: Asset, y: Integer) kind empirical {
    label en unofficial "the donor made the section 2523(f) election with respect to item, on or before the section 6075(b) gift tax return due date for year y (section 2523(f)(4))";
}
relation qtip_gift_election_valid(donor: Individual, donee: Individual, item: Asset, y: Integer) kind institutional {
    label en unofficial "the section 2523(f) QTIP election is validly exercised";
}

@source(IRC_S2523_F, relation = formalizes, coverage = partial, quote = "such property shall be treated as transferred to the donee spouse")
rule QtipGiftElectionPower(donor: Individual, donee: Individual, item: Asset, y: Integer) strict {
    label en official "in the case of qualified terminable interest property, for purposes of subsection (a) such property shall be treated as transferred to the donee spouse (section 2523(f)(1)(A))";
    when qtip_gift_election_made(donor, donee, item, y);
    then power QtipGiftElection {
        holder donor;
        over item;
        exercise qtip_gift_election_made(donor, donee, item, y);
        valid_when qtip_qualifying_income_interest_for_life(donor, donee, item);
        effect qtip_gift_election_valid(donor, donee, item, y);
        window [@0001-01-01, infinity);
    };
}

pub relation donee_spouse_is_us_citizen(donee: Individual) kind empirical {
    label en unofficial "the donee spouse is a citizen of the United States (section 2523(i))";
}

@source(IRC_S2523_B, relation = formalizes, coverage = partial, quote = "no deduction shall be allowed with respect to such interest")
pub relation marital_deduction_disallowed_terminable_2523(donor: Individual, donee: Individual, item: Asset) kind institutional {
    label en official "section 2523(b): the terminable-interest deduction bar applies (terminable interest AND a retained/shifted interest or power), absent a valid QTIP election";
}
rule MaritalDeductionDisallowedTerminable2523Rule(donor: Individual, donee: Individual, item: Asset, y: Integer) defeasible {
    when gift_interest_terminable(donor, donee, item);
    when donor_retains_or_transfers_other_interest(donor, donee, item);
    when gift_to_spouse(donor, donee, item, y, _);
    when not_known(gift_terminable_interest_exception_2523(donor, donee, item));
    then marital_deduction_disallowed_terminable_2523(donor, donee, item);
}

@source(IRC_S2523_I, relation = formalizes, coverage = exact, quote = "no deduction shall be allowed under this section")
pub relation marital_deduction_disallowed_noncitizen_spouse_2523(donor: Individual, donee: Individual) kind institutional {
    label en official "section 2523(i)(1): no marital deduction is allowed where the donee spouse is not a citizen of the United States";
}
rule MaritalDeductionDisallowedNoncitizenSpouse2523Rule(donor: Individual, donee: Individual) defeasible {
    when not_known(donee_spouse_is_us_citizen(donee));
    when gift_to_spouse(donor, donee, _, _, _);
    when not_known(section_2523i_not_applicable_to_annuity_transfer(donor, donee));
    then marital_deduction_disallowed_noncitizen_spouse_2523(donor, donee);
}

@source(IRC_S2523_A, relation = formalizes, coverage = exact, quote = "there shall be allowed as a deduction in computing taxable gifts for the calendar year an amount with respect to such interest equal to its value")
pub relation marital_deduction_item_2523(donor: Individual, donee: Individual, item: Asset, y: Integer, amount: Money) kind institutional {
    label en official "the section 2523(a) marital deduction allowed for the stated gift item";
}
rule MaritalDeductionItem2523AllowedRule(donor: Individual, donee: Individual, item: Asset, y: Integer, value: Money) defeasible {
    when gift_to_spouse_net_value_2523c(donor, donee, item, y, value);
    when donee_spouse_is_us_citizen(donee);
    when not_known(marital_deduction_disallowed_terminable_2523(donor, donee, item));
    then marital_deduction_item_2523(donor, donee, item, y, value);
}

pub relation marital_deduction_2523(donor: Individual, y: Integer, amount: Money) kind institutional {
    label en official "the total section 2523 gift tax marital deduction for the donor for calendar year y";
}
rule MaritalDeduction2523Rule(donor: Individual, y: Integer) defeasible {
    when marital_deduction_item_2523(donor, _, _, y, _);
    then marital_deduction_2523(donor, y, sum all v: Money for donee: Individual, item: Asset where marital_deduction_item_2523(donor, donee, item, y, v));
}

const NoncitizenSpouseAnnualExclusion: Money = 100000.00 USD;
// §2503(b)/§2523(i)(2)'s substituted figure: the pinned STATUTORY $100,000,
// not the actually-in-force indexed amount (currently ~$185,000 for recent
// years under a separate, unpinned technical-correction chain) — SOURCE_GAP,
// see the module header.
