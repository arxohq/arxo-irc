// 26 U.S.C. §2037 (transfers taking effect at death) and §2039 (annuities) —
// remaining chapter 11 gross-estate inclusions. Stage-2b module of
// `us.irc.estate_gift` (B01/IRC-11). Extends `gross_estate_item` (`pub
// relation`, declared once in 03-gross-estate-inclusions.law) with two more
// producing rules, matching that module's own §2036/§2038 idiom exactly
// (`bona_fide_sale_for_full_consideration`, `value_at_death`, `alternate_
// valuation_elected` reused without redeclaration).
//
// JUDGMENT CALL: the section 2037(b) actuarial valuation of the retained
// reversionary interest ("usual methods of valuation, including ... tables
// of mortality and actuarial principles, under regulations prescribed by
// the Secretary" — i.e. section 7520) is read as a CASE-ASSERTED empirical
// fact, classified EXTERNAL_DEPENDENCY on section 7520 (not imported by any
// `us.irc.*` package yet) — exactly the treatment the coordinator's own task
// text calls for.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2037_A,
    IRC_S2039_A,
    Person,
    alternate_valuation_elected,
    bona_fide_sale_for_full_consideration,
    gross_estate_item,
    partial_consideration_2043,
    value_at_death,
};

// =====================================================================
// §2037 — transfers taking effect at death
// =====================================================================

pub relation possession_obtainable_only_by_surviving_decedent(e: Estate, item: Asset) kind empirical {
    label en unofficial "possession or enjoyment of item can, through ownership of the transferred interest, be obtained only by surviving the decedent (section 2037(a)(1))";
}
pub relation reversionary_interest_value_2037(e: Estate, item: Asset, value: Money) kind empirical {
    label en unofficial "the value of the decedent's retained reversionary interest in item, immediately before death, under section 7520 actuarial methods (section 2037(a)(2)/(b)) — EXTERNAL_DEPENDENCY: section 7520 is not modelled by any us.irc.* package";
}
pub relation beneficiary_general_power_exercisable_before_death_2037(e: Estate, item: Asset) kind empirical {
    label en unofficial "possession or enjoyment of item could have been obtained by any beneficiary during the decedent's life through a general power of appointment (section 2041) exercisable immediately before the decedent's death (section 2037(b)'s closing exception)";
}

@source(IRC_S2037_A, relation = formalizes, coverage = partial, quote = "the value of such reversionary interest immediately before the death of the decedent exceeds 5 percent of the value of such property")
pub relation reversionary_interest_exceeds_5_percent(e: Estate, item: Asset) kind institutional {
    label en official "section 2037(a)(2): the retained reversionary interest exceeds 5 percent of the value of the property";
}
rule ReversionaryInterestExceeds5PercentRule(e: Estate, item: Asset, reversion: Money, total: Money) strict {
    when reversionary_interest_value_2037(e, item, reversion);
    when value_at_death(e, item, total) and total > 0.00 USD
        and div_round(reversion, total, 6, "HALF_UP") > 0.05;
    then reversionary_interest_exceeds_5_percent(e, item);
}

@source(IRC_S2037_A, relation = formalizes, coverage = exact, quote = "The value of the gross estate shall include the value of all property to the extent of any interest therein of which the decedent has at any time after September 7, 1916, made a transfer")
rule GrossEstateItemUnder2037Rule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "section 2037(a): property is included in the gross estate where possession is obtainable only by surviving the decedent AND the decedent's retained reversionary interest exceeds 5 percent of its value, absent the section 2037(b) general-power exception";
    when possession_obtainable_only_by_surviving_decedent(e, item)
        and reversionary_interest_exceeds_5_percent(e, item)
        and not_known(bona_fide_sale_for_full_consideration(e, item))
        and not_known(partial_consideration_2043(e, item))
        and not_known(beneficiary_general_power_exercisable_before_death_2037(e, item))
        and value_at_death(e, item, amount)
        and not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, amount);
}

// =====================================================================
// §2039 — annuities
// =====================================================================

pub relation annuity_receivable_by_surviving_beneficiary(e: Estate, item: Asset, beneficiary: Person, contract_entered_after_1931: Boolean) kind empirical {
    label en unofficial "an annuity or other payment (other than life insurance) is receivable by beneficiary by reason of surviving the decedent, under a contract entered into after March 3, 1931 (section 2039(a))";
}
pub relation decedent_had_annuity_right(e: Estate, item: Asset) kind empirical {
    label en unofficial "under the contract, an annuity or payment was payable to the decedent, or the decedent possessed the right to receive it (alone or with another), for life or for a period not ascertainable without reference to death or not in fact ending before death (section 2039(a))";
}
pub relation annuity_full_value(e: Estate, item: Asset, value: Money) kind empirical {
    label en unofficial "the value of the annuity or other payment receivable by the surviving beneficiary (section 2039(a))";
}
pub relation decedent_contribution_ratio_2039(e: Estate, item: Asset, ratio: Decimal) kind empirical {
    label en unofficial "the proportion of the purchase price of the contract contributed by the decedent, including any employer contribution made by reason of the decedent's employment (section 2039(b))";
}

@source(IRC_S2039_A, relation = formalizes, coverage = exact, quote = "The gross estate shall include the value of an annuity or other payment receivable by any beneficiary by reason of surviving the decedent")
rule GrossEstateItemUnder2039Rule(e: Estate, item: Asset, beneficiary: Person, full_value: Money, ratio: Decimal) defeasible {
    label en official "section 2039(a)-(b): the gross estate includes the portion of the annuity's value proportionate to the decedent's own contribution to the purchase price";
    when annuity_receivable_by_surviving_beneficiary(e, item, beneficiary, true)
        and decedent_had_annuity_right(e, item)
        and annuity_full_value(e, item, full_value)
        and decedent_contribution_ratio_2039(e, item, ratio)
        and not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, round(full_value * ratio, 2, "HALF_UP"));
}
