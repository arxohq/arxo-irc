// 26 U.S.C. §§2031(c)(4)-(10), 2032(b), 2035(b), (c), (e), 2036(b), 2038(b),
// 2041(a)(1), (a)(3), (b)(1)(B)-(C), (b)(3) — the parts of the gross-estate
// sections that stage 1 left as TECH_GAP ("not modelled this stage") although
// none needs anything the language lacks. Stage 2 (DECISION-0379 with
// deontics) of `us.irc.estate_gift` (B01/IRC-11).
//
// STRUCTURE. `GrossEstateRule` (03) now reads two more terms: the §2035(b)
// gift-tax gross-up (`gift_tax_gross_up_item_2035b`, here) and the §2031(c)
// exclusion (`conservation_easement_exclusion`, 03). The §2031(c) election is
// a POWER of the executor with the return date as validity condition, its
// irrevocability a PROHIBITION. Powers of appointment: one derived relation for
// the era of creation, one for the general power after the conjunction rules of
// (b)(1)(B)-(C), and whole/fractional inclusion rules.
//
// JUDGMENT CALLS
//  - §2031(c)(4): "to the extent that the land is debt-financed" is read as a
//    reduction of the land base by the unpaid acquisition indebtedness.
//  - §2035(c)(1) and (c)(2) produce VALUES FOR OTHER SECTIONS' TESTS (303(b),
//    2032A, 6324, 6166): they are relations, not changes of `gross_estate`.
//  - Ownership attribution "with the application of section 318" (§2036(b)(2)) and
//    the 30 percent test through §2057(e)(3) (§2031(c)(10)) are case-asserted
//    percentages: the owners of those rules are other packages or a repealed
//    section (TECH-GAPS G3609).
//  - Local-law questions ("can be validly exercised so as to postpone vesting",
//    §2041(a)(3)) are case facts asserted with a judicial or appraisal origin.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    CharitableRecipientKind,
    Estate,
    IRC_S2031_C,
    IRC_S2032_B,
    IRC_S2035_B,
    IRC_S2035_C,
    IRC_S2035_E,
    IRC_S2036_B,
    IRC_S2038_B,
    IRC_S2041_A,
    IRC_S2041_B,
    Person,
    Secretary,
    alternate_valuation_elected,
    bona_fide_sale_for_full_consideration,
    charitable_bequest,
    date_of_death,
    estate_return_due_date_with_extensions,
    executor_of,
    general_power_of_appointment_at_death_or_exercised,
    gross_estate,
    gross_estate_item,
    gross_estate_item_present,
    interest_passes_to_surviving_spouse,
    land_value_for_easement,
    otherwise_includible_under_2035_to_2038_or_2041,
    partial_consideration_2043,
    power_limited_by_ascertainable_standard,
    value_at_death,
    would_be_included_under_2036_2037_2038_2042,
};

// =====================================================================
// §2035(b): the gift tax on gifts within 3 years is added to the gross estate
// =====================================================================

pub relation chapter12_tax_paid_on_gift(e: Estate, n: Integer, gift_made_on: Date, amount: Money) kind empirical {
    label en unofficial "tax paid under chapter 12 by the decedent or the estate on gift number n, made by the decedent or the decedent's spouse on the stated date (section 2035(b))";
}
@source(IRC_S2035_B, relation = formalizes, coverage = exact, quote = "The amount of the gross estate (determined without regard to this subsection) shall be increased by the amount of any tax paid under chapter 12 by the decedent or his estate on any gift made by the decedent or his spouse during the 3-year period ending on the date of the decedent's death.")
pub relation gift_tax_gross_up_item_2035b(e: Estate, n: Integer, amount: Money) kind institutional {
    label en official "gift tax paid on a gift made during the 3-year period ending on the date of death: an increase of the gross estate (section 2035(b))";
}
rule GiftTaxGrossUpItem2035bRule(e: Estate, n: Integer, on: Date, amount: Money, dod: Date, calendar_before_1: Date) defeasible {
    label en official "the gross estate is increased by chapter 12 tax paid on a gift made in the 3 years ending on the date of death (section 2035(b))";
    when chapter12_tax_paid_on_gift(e, n, on, amount);
    when date_of_death(e, dod) and on > calendar_before_1 and on <= dod
        and us.irc.core::civil_calendar_boundary_before(dod, 3, us.irc.core::CalendarYear, calendar_before_1);
    then gift_tax_gross_up_item_2035b(e, n, amount);
}

// =====================================================================
// §2035(c): values for other sections; (e): revocable trusts
// =====================================================================

pub relation three_year_transfer_value(e: Estate, item: Asset, value: Money) kind empirical {
    label en unofficial "the value of property of which the decedent made a transfer, by trust or otherwise, during the 3-year period ending on the date of death (section 2035(c)(1))";
}
pub relation transfer_with_respect_to_life_insurance_policy(e: Estate, item: Asset) kind empirical {
    label en unofficial "the transfer is a transfer with respect to a life insurance policy (section 2035(c)(3))";
}
pub relation gift_tax_return_not_required_for_donee(e: Estate, item: Asset) kind empirical {
    label en unofficial "the decedent was not required by section 6019 (other than by reason of section 6019(2)) to file a gift tax return for the year with respect to transfers to this donee (section 2035(c)(3)); section 6019 is owned by us.irc.returns";
}
relation transfer_excluded_from_2035c1(e: Estate, item: Asset) kind institutional;
rule TransferExcludedFrom2035c1BonaFideSaleRule(e: Estate, item: Asset) defeasible {
    label en official "paragraph (1) does not apply to a bona fide sale for an adequate and full consideration (section 2035(d))";
    when three_year_transfer_value(e, item, _);
    when bona_fide_sale_for_full_consideration(e, item);
    then transfer_excluded_from_2035c1(e, item);
}
rule TransferExcludedFrom2035c1SmallGiftRule(e: Estate, item: Asset) defeasible {
    label en official "paragraph (1) does not apply to a transfer, other than of a life insurance policy, to a donee for whom no gift tax return was required (section 2035(c)(3))";
    when three_year_transfer_value(e, item, _);
    when gift_tax_return_not_required_for_donee(e, item);
    when not_known(transfer_with_respect_to_life_insurance_policy(e, item));
    then transfer_excluded_from_2035c1(e, item);
}
pub relation three_year_transfer_added_for_2035c(e: Estate, item: Asset, value: Money) kind institutional {
    label en official "the transfer is counted in the value of the gross estate for the purposes of sections 303(b), 2032A and subchapter C of chapter 64 (section 2035(c)(1)); not counted again if already in the gross estate";
}
rule ThreeYearTransferAddedFor2035cRule(e: Estate, item: Asset, value: Money) defeasible {
    when three_year_transfer_value(e, item, value);
    when not_known(transfer_excluded_from_2035c1(e, item));
    when not_known(gross_estate_item_present(e, item));
    then three_year_transfer_added_for_2035c(e, item, value);
}
@source(IRC_S2035_C, relation = formalizes, coverage = exact, quote = "the value of the gross estate shall include the value of all property to the extent of any interest therein of which the decedent has at any time made a transfer, by trust or otherwise, during the 3-year period ending on the date of the decedent's death")
pub relation gross_estate_for_2035c_purposes(e: Estate, amount: Money) kind institutional {
    label en official "the value of the gross estate for sections 303(b), 2032A and subchapter C of chapter 64: the gross estate plus 3-year transfers not otherwise included (section 2035(c)(1)); consumers are owned by other packages";
}
rule GrossEstateFor2035cPurposesRule(e: Estate, gross: Money) defeasible {
    when gross_estate(e, gross);
    then gross_estate_for_2035c_purposes(e, gross + sum(collect all v: Money, i: Asset where three_year_transfer_added_for_2035c(e, i, v), empty: 0.00 USD));
}
pub relation estate_meets_6166_35_percent_with_2035a(e: Estate) kind empirical {
    label en unofficial "the estate meets the 35 percent of adjusted gross estate requirement of section 6166(a)(1) with the application of section 2035(a) (result of us.irc.payment_refunds_interest)";
}
pub relation estate_meets_6166_35_percent_without_2035a(e: Estate) kind empirical {
    label en unofficial "the estate meets the 35 percent requirement of section 6166(a)(1) without the application of section 2035(a)";
}
@source(IRC_S2035_C, relation = formalizes, coverage = exact, quote = "An estate shall be treated as meeting the 35 percent of adjusted gross estate requirement of section 6166(a)(1) only if the estate meets such requirement both with and without the application of subsection (a).")
pub relation estate_treated_as_meeting_6166_35_percent_test(e: Estate) kind institutional {
    label en official "the estate meets the 35 percent requirement both with and without section 2035(a) (section 2035(c)(2)); the two inputs are results of the section 6166 owner";
}
rule EstateTreatedAsMeeting6166Rule(e: Estate) defeasible {
    when estate_meets_6166_35_percent_with_2035a(e);
    when estate_meets_6166_35_percent_without_2035a(e);
    then estate_treated_as_meeting_6166_35_percent_test(e);
}

pub relation trust_portion_treated_as_owned_by_decedent_under_676(e: Estate, item: Asset) kind empirical {
    label en unofficial "during the period of the transfer the trust portion was treated under section 676 as owned by the decedent by reason of a power in the grantor, determined without regard to section 672(e) (section 2035(e))";
}
pub relation transfer_from_trust_portion_within_3_years(e: Estate, item: Asset) kind empirical {
    label en unofficial "the property was transferred out of the trust portion during the 3-year period ending on the date of death";
}
@source(IRC_S2035_E, relation = formalizes, coverage = exact, quote = "any transfer from any portion of a trust during any period that such portion was treated under section 676 as owned by the decedent by reason of a power in the grantor (determined without regard to section 672(e)) shall be treated as a transfer made directly by the decedent")
pub relation transfer_from_revocable_trust_treated_as_direct_2035e(e: Estate, item: Asset) kind institutional {
    label en official "a transfer from a revocable trust portion is a transfer made directly by the decedent, for sections 2035 and 2038 (section 2035(e))";
}
rule TransferFromRevocableTrustTreatedAsDirectRule(e: Estate, item: Asset) defeasible {
    when transfer_from_trust_portion_within_3_years(e, item);
    when trust_portion_treated_as_owned_by_decedent_under_676(e, item);
    then transfer_from_revocable_trust_treated_as_direct_2035e(e, item);
}
rule GrossEstateItemUnder2035eRule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "property distributed within 3 years from a trust portion treated as owned under section 676 is included as if the decedent had transferred it directly (sections 2035(a), (e))";
    when transfer_from_revocable_trust_treated_as_direct_2035e(e, item);
    when would_be_included_under_2036_2037_2038_2042(e, item);
    when not_known(bona_fide_sale_for_full_consideration(e, item));
    when not_known(partial_consideration_2043(e, item));
    when value_at_death(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, amount);
}

// =====================================================================
// §2036(b): voting rights of a controlled corporation
// =====================================================================

pub relation retained_right_to_vote_stock_of_corporation(e: Estate, item: Asset) kind empirical {
    label en unofficial "the decedent retained, directly or indirectly, the right to vote shares of stock of a corporation that are part of the transferred property (section 2036(b)(1))";
}
pub relation decedent_voting_power_share_within_3_years(e: Estate, item: Asset, share: Decimal) kind empirical {
    label en unofficial "the greatest share of the total combined voting power of all classes of voting stock that the decedent, at any time after the transfer and during the 3-year period ending on the date of death, owned with the application of section 318 or had the right, alone or in conjunction with any person, to vote (section 2036(b)(2)); attribution is case-asserted, TECH-GAPS G3609";
}
@source(IRC_S2036_B, relation = formalizes, coverage = exact, quote = "a corporation shall be treated as a controlled corporation if, at any time after the transfer of the property and during the 3-year period ending on the date of the decedent's death, the decedent owned (with the application of section 318), or had the right (either alone or in conjunction with any person) to vote, stock possessing at least 20 percent of the total combined voting power of all classes of stock")
pub relation controlled_corporation_2036b2(e: Estate, item: Asset) kind institutional {
    label en official "the corporation is a controlled corporation: the decedent owned or could vote at least 20 percent of the combined voting power within the 3 years before death (section 2036(b)(2))";
}
rule ControlledCorporation2036b2Rule(e: Estate, item: Asset, share: Decimal) defeasible {
    when decedent_voting_power_share_within_3_years(e, item, share) and share >= 0.20;
    then controlled_corporation_2036b2(e, item);
}
@source(IRC_S2036_B, relation = formalizes, coverage = exact, quote = "the retention of the right to vote (directly or indirectly) shares of stock of a controlled corporation shall be considered to be a retention of the enjoyment of transferred property")
rule GrossEstateItemUnder2036bRule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "retaining the right to vote shares of a controlled corporation is a retention of the enjoyment of the transferred property: the property is included (sections 2036(a)(1), (b)(1))";
    when retained_right_to_vote_stock_of_corporation(e, item);
    when controlled_corporation_2036b2(e, item);
    when not_known(bona_fide_sale_for_full_consideration(e, item));
    when not_known(partial_consideration_2043(e, item));
    when value_at_death(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, amount);
}
pub relation voting_rights_relinquished_or_ceased_within_3_years(e: Estate, item: Asset) kind empirical {
    label en unofficial "the decedent relinquished, or ceased to hold, the voting rights during the 3-year period ending on the date of death (section 2036(b)(3))";
}
@source(IRC_S2036_B, relation = formalizes, coverage = exact, quote = "For purposes of applying section 2035 with respect to paragraph (1), the relinquishment or cessation of voting rights shall be treated as a transfer of property made by the decedent.")
rule GrossEstateItemUnder2036b3Rule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "relinquishing or ceasing voting rights of a controlled corporation within 3 years of death is a section 2035 transfer (section 2036(b)(3))";
    when voting_rights_relinquished_or_ceased_within_3_years(e, item);
    when controlled_corporation_2036b2(e, item);
    when not_known(bona_fide_sale_for_full_consideration(e, item));
    when not_known(partial_consideration_2043(e, item));
    when value_at_death(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, amount);
}

// =====================================================================
// §2038(b): the power exists though subject to notice or delay
// =====================================================================

pub relation power_subject_to_notice_or_delay_2038b(e: Estate, item: Asset) kind empirical {
    label en unofficial "the power to alter, amend, revoke or terminate is subject to a precedent giving of notice, or its exercise takes effect only after a stated period, whether or not notice was given or the power exercised on or before the date of death (section 2038(b))";
}
pub relation interest_excluded_from_2038_power_by_notice_period(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the value of the interests that would have been excluded from the power had the decedent lived (section 2038(b), proper adjustment); if notice was not given by death it is considered given on the date of death";
}
@source(IRC_S2038_B, relation = formalizes, coverage = exact, quote = "the power to alter, amend, revoke, or terminate shall be considered to exist on the date of the decedent's death even though the exercise of the power is subject to a precedent giving of notice or even though the alteration, amendment, revocation, or termination takes effect only on the expiration of a stated period after the exercise of the power")
rule GrossEstateItemUnder2038bRule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "a power subject to notice or delay is treated as existing at death; the included value is adjusted by the interests excluded from the power (section 2038(b))";
    when power_subject_to_notice_or_delay_2038b(e, item);
    when not_known(bona_fide_sale_for_full_consideration(e, item));
    when not_known(partial_consideration_2043(e, item));
    when value_at_death(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, max(0.00 USD, amount - sum(collect all x: Money where interest_excluded_from_2038_power_by_notice_period(e, item, x), empty: 0.00 USD)));
}
rule OtherwiseIncludibleUnder2038bRule(e: Estate, item: Asset) defeasible {
    when power_subject_to_notice_or_delay_2038b(e, item);
    then otherwise_includible_under_2035_to_2038_or_2041(e, item);
}

// =====================================================================
// §2041: era of creation, conjunction powers, pre-1943 powers, postponement
// =====================================================================

pub relation power_creation_date(e: Estate, item: Asset, d: Date) kind empirical {
    label en unofficial "the date the power of appointment was created (for a power created by will, the date the will was executed)";
}
pub relation power_created_by_will(e: Estate, item: Asset) kind empirical {
    label en unofficial "the power was created by a will";
}
pub relation testator_died_on(e: Estate, item: Asset, d: Date) kind empirical {
    label en unofficial "the person executing the will creating the power died on the stated date";
}
pub relation will_republished_after_oct_21_1942(e: Estate, item: Asset) kind empirical {
    label en unofficial "the will was republished, by codicil or otherwise, after October 21, 1942";
}
@source(IRC_S2041_B, relation = formalizes, coverage = exact, quote = "a power of appointment created by a will executed on or before October 21, 1942, shall be considered a power created on or before such date if the person executing such will dies before July 1, 1949, without having republished such will, by codicil or otherwise, after October 21, 1942")
pub relation power_created_on_or_before_oct_21_1942(e: Estate, item: Asset) kind institutional {
    label en official "the power is one created on or before October 21, 1942 (sections 2041(a)(1), (b)(3))";
}
rule PowerCreatedOnOrBefore1942ByDateRule(e: Estate, item: Asset, d: Date) defeasible {
    when power_creation_date(e, item, d) and d <= @1942-10-21;
    when not_known(power_created_by_will(e, item));
    then power_created_on_or_before_oct_21_1942(e, item);
}
rule PowerCreatedOnOrBefore1942ByWillRule(e: Estate, item: Asset, d: Date, died: Date) defeasible {
    label en official "a will executed on or before October 21, 1942 creates a pre-1943 power only if the testator died before July 1, 1949 without republication after that date (section 2041(b)(3))";
    when power_created_by_will(e, item);
    when power_creation_date(e, item, d) and d <= @1942-10-21;
    when testator_died_on(e, item, died) and died < @1949-07-01;
    when not_known(will_republished_after_oct_21_1942(e, item));
    then power_created_on_or_before_oct_21_1942(e, item);
}
pub relation power_created_after_oct_21_1942(e: Estate, item: Asset) kind institutional {
    label en official "the power was created after October 21, 1942";
}
rule PowerCreatedAfter1942Rule(e: Estate, item: Asset, d: Date) defeasible {
    when power_creation_date(e, item, d);
    when not_known(power_created_on_or_before_oct_21_1942(e, item));
    then power_created_after_oct_21_1942(e, item);
}

// (b)(1)(B)-(C): powers exercisable only in conjunction with another person
pub relation power_exercisable_only_in_conjunction(e: Estate, item: Asset) kind empirical {
    label en unofficial "the power is exercisable by the decedent only in conjunction with another person";
}
pub relation conjunction_only_with_creator_of_power(e: Estate, item: Asset) kind empirical {
    label en unofficial "the power is not exercisable by the decedent except in conjunction with the creator of the power (section 2041(b)(1)(C)(i))";
}
pub relation conjunction_only_with_adverse_person(e: Estate, item: Asset) kind empirical {
    label en unofficial "the power is not exercisable by the decedent except in conjunction with a person having a substantial interest in the property adverse to exercise in the decedent's favor; a person who after the decedent's death may exercise a power in his own favor is deemed adverse (section 2041(b)(1)(C)(ii))";
}
pub relation persons_in_favor_of_whom_power_exercisable(e: Estate, item: Asset, count_including_decedent: Integer) kind empirical {
    label en unofficial "the number of persons, including the decedent, in favor of whom the power is exercisable (his estate, his creditors or the creditors of his estate counted as in favor of the person), after clauses (i) and (ii) (section 2041(b)(1)(C)(iii))";
}
relation general_power_2041_candidate(e: Estate, item: Asset) kind institutional;
rule GeneralPower2041CandidateAtDeathRule(e: Estate, item: Asset) defeasible {
    when general_power_of_appointment_at_death_or_exercised(e, item);
    when not_known(power_limited_by_ascertainable_standard(e, item));
    when not_known(conjunction_only_with_creator_of_power(e, item));
    when not_known(conjunction_only_with_adverse_person(e, item));
    then general_power_2041_candidate(e, item);
}
pub relation general_power_subject_to_notice_or_delay_2041a2(e: Estate, item: Asset) kind empirical {
    label en unofficial "the decedent's general power created after October 21, 1942 is subject to a precedent giving of notice, or its exercise takes effect only after a stated period (section 2041(a)(2), last sentence); such a power is considered to exist on the date of death";
}
rule GeneralPower2041CandidateNoticeRule(e: Estate, item: Asset) defeasible {
    label en official "a power subject to notice or delay is considered to exist at death (section 2041(a)(2), last sentence)";
    when general_power_subject_to_notice_or_delay_2041a2(e, item);
    when not_known(power_limited_by_ascertainable_standard(e, item));
    when not_known(conjunction_only_with_creator_of_power(e, item));
    when not_known(conjunction_only_with_adverse_person(e, item));
    then general_power_2041_candidate(e, item);
}
relation other_persons_in_favor_recorded(e: Estate, item: Asset) kind institutional;
rule OtherPersonsInFavorRecordedRule(e: Estate, item: Asset, n: Integer) defeasible {
    when persons_in_favor_of_whom_power_exercisable(e, item, n) and n >= 2;
    then other_persons_in_favor_recorded(e, item);
}
relation general_power_2041_whole(e: Estate, item: Asset) kind institutional;
rule GeneralPower2041WholeRule(e: Estate, item: Asset) defeasible {
    when general_power_2041_candidate(e, item);
    when not_known(other_persons_in_favor_recorded(e, item));
    then general_power_2041_whole(e, item);
}
@source(IRC_S2041_B, relation = formalizes, coverage = exact, quote = "such power shall be deemed a general power of appointment only in respect of a fractional part of the property subject to such power, such part to be determined by dividing the value of such property by the number of such persons (including the decedent) in favor of whom such power is exercisable")
rule GrossEstateItemUnder2041FractionalRule(e: Estate, item: Asset, n: Integer, amount: Money) defeasible {
    label en official "a general power exercisable also in favor of other persons is a general power only as to the fraction 1/n of the property, n counting the decedent (section 2041(b)(1)(C)(iii))";
    when general_power_2041_candidate(e, item);
    when persons_in_favor_of_whom_power_exercisable(e, item, n) and n >= 2;
    when not_known(bona_fide_sale_for_full_consideration(e, item));
    when not_known(partial_consideration_2043(e, item));
    when value_at_death(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, div_round(amount, n * 1.0, 2, "HALF_UP"));
}

// (a)(1): general powers created on or before October 21, 1942
pub relation pre_1943_general_power_exercised_by_decedent(e: Estate, item: Asset) kind empirical {
    label en unofficial "the decedent exercised a general power of appointment created on or before October 21, 1942, by will or by a disposition of a nature that, as a transfer of the decedent's own property, would be includible under sections 2035 to 2038 (section 2041(a)(1)(A)-(B)); failure to exercise or complete release is not an exercise";
}
pub relation pre_1943_power_partially_released_on(e: Estate, item: Asset, d: Date) kind empirical {
    label en unofficial "the power was partially released so that it is no longer a general power, on the stated date";
}
pub relation donee_under_legal_disability_on_oct_21_1942_until(e: Estate, item: Asset, ended: Date) kind empirical {
    label en unofficial "the donee was under a legal disability to release the power on October 21, 1942; the disability terminated on the stated date";
}
relation pre_1943_partial_release_exception(e: Estate, item: Asset) kind institutional;
rule Pre1943PartialReleaseBefore1951Rule(e: Estate, item: Asset, d: Date) defeasible {
    label en official "a partial release before November 1, 1951 (section 2041(a)(1)(i))";
    when pre_1943_power_partially_released_on(e, item, d) and d < @1951-11-01;
    then pre_1943_partial_release_exception(e, item);
}
rule Pre1943PartialReleaseAfterDisabilityRule(e: Estate, item: Asset, d: Date, ended: Date) defeasible {
    label en official "a partial release, by a donee under legal disability on October 21, 1942, not later than 6 months after the disability ended (section 2041(a)(1)(ii))";
    when pre_1943_power_partially_released_on(e, item, d);
    when donee_under_legal_disability_on_oct_21_1942_until(e, item, ended) and d <= add_calendar_period(ended, 6 calendar_month);
    then pre_1943_partial_release_exception(e, item);
}
@source(IRC_S2041_A, relation = formalizes, coverage = exact, quote = "To the extent of any property with respect to which a general power of appointment created on or before October 21, 1942, is exercised by the decedent")
rule GrossEstateItemUnder2041a1Rule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "property subject to a general power created on or before October 21, 1942 is included only if the decedent exercised it; a conjunction power is not general (sections 2041(a)(1), (b)(1)(B))";
    when power_created_on_or_before_oct_21_1942(e, item);
    when pre_1943_general_power_exercised_by_decedent(e, item);
    when not_known(pre_1943_partial_release_exception(e, item));
    when not_known(power_exercisable_only_in_conjunction(e, item));
    when not_known(bona_fide_sale_for_full_consideration(e, item));
    when not_known(partial_consideration_2043(e, item));
    when value_at_death(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, amount);
}

// (a)(3): exercise by creating a postponing power
pub relation second_power_created_by_exercise(e: Estate, item: Asset) kind empirical {
    label en unofficial "the decedent, by will or by a disposition includible under section 2035, 2036 or 2037, exercised a power created after October 21, 1942 by creating another power of appointment (section 2041(a)(3))";
}
pub relation second_power_can_postpone_vesting_under_local_law(e: Estate, item: Asset) kind empirical {
    label en unofficial "under the applicable local law the second power can be validly exercised so as to postpone the vesting of an interest, or suspend absolute ownership or the power of alienation, for a period ascertainable without regard to the date of creation of the first power; a local-law determination asserted with an adjudicated origin";
}
@source(IRC_S2041_A, relation = formalizes, coverage = exact, quote = "exercises a power of appointment created after October 21, 1942, by creating another power of appointment which under the applicable local law can be validly exercised so as to postpone the vesting of any estate or interest in such property")
rule GrossEstateItemUnder2041a3Rule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "exercising a post-1942 power by creating another power that can postpone vesting includes the property (section 2041(a)(3))";
    when power_created_after_oct_21_1942(e, item);
    when second_power_created_by_exercise(e, item);
    when second_power_can_postpone_vesting_under_local_law(e, item);
    when not_known(bona_fide_sale_for_full_consideration(e, item));
    when value_at_death(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, amount);
}

// =====================================================================
// §2031(c): the conservation easement exclusion, the rest
// =====================================================================

pub relation conservation_easement_election_made_on_return(e: Estate, x: Person, w: Interval<Instant>) kind empirical {
    label en unofficial "the executor makes the section 2031(c)(6) election on the return of the tax imposed by section 2001";
}
pub relation conservation_easement_election_return_on_time(e: Estate) kind institutional {
    label en unofficial "the election is made on or before the due date (including extensions) of the return (section 2031(c)(6))";
}
pub relation conservation_easement_election_return_filed_on(e: Estate, d: Date) kind empirical {
    label en unofficial "the return carrying the election is filed on the stated date";
}
rule ConservationEasementElectionReturnOnTimeRule(e: Estate, filed: Date, due: Date) defeasible {
    when conservation_easement_election_return_filed_on(e, filed);
    when estate_return_due_date_with_extensions(e, due) and filed <= due;
    then conservation_easement_election_return_on_time(e);
}
pub relation conservation_easement_election_valid(e: Estate) kind institutional {
    label en official "the section 2031(c) election is validly made";
}
@source(IRC_S2031_C, relation = formalizes, coverage = exact, quote = "The election under this subsection shall be made on or before the due date (including extensions) for filing the return of tax imposed by section 2001 and shall be made on such return.")
rule ConservationEasementElectionPower(e: Estate, x: Person, w: Interval<Instant>) strict {
    label en official "the executor may elect the section 2031(c) exclusion on the return, on or before its due date (section 2031(c)(6))";
    when executor_of(e, x, w);
    when conservation_easement_election_made_on_return(e, x, w);
    then power ConservationEasementElection {
        holder x;
        over e;
        exercise conservation_easement_election_made_on_return(e, x, w);
        valid_when conservation_easement_election_return_on_time(e);
        effect create(conservation_easement_election_valid(e));
        window w;
    };
}
pub relation executor_revokes_conservation_easement_election(e: Estate, x: Person) kind empirical {
    label en unofficial "the executor purports to revoke the section 2031(c) election";
}
@source(IRC_S2031_C, relation = formalizes, coverage = exact, quote = "Such an election, once made, shall be irrevocable.")
rule ConservationEasementElectionIrrevocableRule(e: Estate, x: Person, w: Interval<Instant>) strict {
    label en official "an election under section 2031(c), once made, shall be irrevocable (section 2031(c)(6))";
    when executor_of(e, x, w);
    when conservation_easement_election_valid(e);
    then prohibition ConservationEasementElectionRevocationProhibition {
        bearer x;
        beneficiary Secretary;
        action executor_revokes_conservation_easement_election(e, x);
        window w;
    };
}

// (8): the definitions of land subject to a qualified conservation easement
pub relation land_in_united_states_or_possession(e: Estate, item: Asset) kind empirical {
    label en unofficial "the land is located in the United States or any possession of the United States (section 2031(c)(8)(A)(i))";
}
pub relation land_owned_by_decedent_or_family_throughout_3_years(e: Estate, item: Asset) kind empirical {
    label en unofficial "the land was owned by the decedent or a member of the decedent's family at all times during the 3-year period ending on the date of death (section 2031(c)(8)(A)(ii)); family as in section 2032A(e)(2), through member_of_family_2032a";
}
pub enum ConservationEasementMakerKind {
    MakerIsDecedent;
    MakerIsFamilyMember;
    MakerIsExecutor;
    MakerIsTrusteeOfTrustHoldingLand;
}
pub relation conservation_easement_made_by(e: Estate, item: Asset, kind: ConservationEasementMakerKind) kind empirical {
    label en unofficial "a qualified conservation easement has been made, as of the date of the election, by an individual described in subparagraph (C) of the stated kind (section 2031(c)(8)(A)(iii), (C))";
}
pub relation qualified_conservation_contribution_of_real_property_interest(e: Estate, item: Asset) kind empirical {
    label en unofficial "a qualified conservation contribution (section 170(h)(1)) of a qualified real property interest (section 170(h)(2)(C)), clause (iv) of section 170(h)(4)(A) not applying, whose use restriction includes a prohibition on more than a de minimis commercial recreational use (section 2031(c)(8)(B)); section 170(h) is owned by another package";
}
@source(IRC_S2031_C, relation = formalizes, coverage = exact, quote = "The term \"land subject to a qualified conservation easement\" means land")
pub relation land_subject_to_qualified_conservation_easement(e: Estate, item: Asset) kind institutional {
    label en official "land in the United States or a possession, owned by the decedent or family for the 3 years before death, subject to a qualified conservation easement made by a described individual (section 2031(c)(8)(A))";
}
rule LandSubjectToQualifiedConservationEasementRule(e: Estate, item: Asset, kind: ConservationEasementMakerKind) defeasible {
    when land_in_united_states_or_possession(e, item);
    when land_owned_by_decedent_or_family_throughout_3_years(e, item);
    when conservation_easement_made_by(e, item, kind);
    when qualified_conservation_contribution_of_real_property_interest(e, item);
    then land_subject_to_qualified_conservation_easement(e, item);
}

// (4): debt-financed property; (5): retained development rights
pub relation acquisition_indebtedness_unpaid_at_death(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the unpaid amount, on the date of death, of acquisition indebtedness on the land: indebtedness incurred by the donor in acquiring it, before or foreseeably after acquisition and but for it, and extensions, renewals and refinancings (section 2031(c)(4)(B))";
}
pub relation retained_development_right_value(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the value of any development right retained by the donor in the conveyance of the qualified conservation easement: a right to use the land for a commercial purpose not subordinate to and directly supportive of its use as a farm for farming purposes (section 2031(c)(5)(D))";
}
@source(IRC_S2031_C, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to the value of any development right retained by the donor in the conveyance of a qualified conservation easement.")
pub relation conservation_easement_land_base_2031c(e: Estate, item: Asset, amount: Money) kind institutional {
    label en official "the land value on which the exclusion is computed: the value of the land (net of any section 2055(f) deduction), less retained development rights and the debt-financed part (section 2031(c)(1), (4)-(5))";
}
rule ConservationEasementLandBaseRule(e: Estate, item: Asset, land_value: Money) defeasible {
    when land_value_for_easement(e, item, land_value);
    then conservation_easement_land_base_2031c(e, item, max(0.00 USD, land_value
        - sum(collect all d: Money where retained_development_right_value(e, item, d), empty: 0.00 USD)
        - sum(collect all b: Money where acquisition_indebtedness_unpaid_at_death(e, item, b), empty: 0.00 USD)));
}
pub relation development_right_included_in_computation_2031c7(e: Estate, item: Asset, amount: Money) kind institutional {
    label en official "the value of a retained development right is included in the computation of the tax: it is outside the exclusion base and the land item stays in the gross estate at that value (section 2031(c)(7)); the forms are the Secretary's";
}
rule DevelopmentRightIncludedInComputation2031c7Rule(e: Estate, item: Asset, v: Money) defeasible {
    when conservation_easement_election_valid(e);
    when retained_development_right_value(e, item, v);
    then development_right_included_in_computation_2031c7(e, item, v);
}
// (5)(B)-(C): extinguishing the retained rights by agreement, and the additional
// tax on a failure to implement it by the earlier of 2 years after death and a sale.
pub relation development_right_extinguishment_agreement_filed_with_return(e: Estate, item: Asset) kind empirical {
    label en unofficial "every person in being with an interest in the land executed an agreement to extinguish permanently some or all retained development rights, on or before the return date, and the agreement is filed with the return (section 2031(c)(5)(B))";
}
pub relation extinguished_development_right_value(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the tax that would have been due on the retained development rights subject to the agreement (section 2031(c)(5)(C)); the counterfactual amount is case-asserted, TECH-GAPS G368 class";
}
pub relation agreement_implemented_on(e: Estate, item: Asset, d: Date) kind empirical {
    label en unofficial "the agreement to extinguish the development rights is implemented on the stated date";
}
pub relation land_sold_on(e: Estate, item: Asset, d: Date) kind empirical {
    label en unofficial "the land subject to the qualified conservation easement is sold on the stated date";
}
relation implementation_deadline_candidate_2031c5c(e: Estate, item: Asset, d: Date) kind institutional;
rule ImplementationDeadlineTwoYearsRule(e: Estate, item: Asset, dod: Date) defeasible {
    when development_right_extinguishment_agreement_filed_with_return(e, item);
    when date_of_death(e, dod);
    then implementation_deadline_candidate_2031c5c(e, item, add_calendar_period(dod, 2 calendar_year));
}
rule ImplementationDeadlineSaleRule(e: Estate, item: Asset, sold: Date) defeasible {
    when development_right_extinguishment_agreement_filed_with_return(e, item);
    when land_sold_on(e, item, sold);
    then implementation_deadline_candidate_2031c5c(e, item, sold);
}
relation earlier_implementation_deadline_exists(e: Estate, item: Asset, d: Date) kind institutional;
rule EarlierImplementationDeadlineExistsRule(e: Estate, item: Asset, d: Date, d2: Date) defeasible {
    when implementation_deadline_candidate_2031c5c(e, item, d);
    when implementation_deadline_candidate_2031c5c(e, item, d2) and d2 < d;
    then earlier_implementation_deadline_exists(e, item, d);
}
pub relation implementation_deadline_2031c5c(e: Estate, item: Asset, d: Date) kind institutional {
    label en official "the earlier of 2 years after the decedent's death and the date of sale of the land (section 2031(c)(5)(C)(i)-(ii))";
}
rule ImplementationDeadline2031c5cRule(e: Estate, item: Asset, d: Date) defeasible {
    when implementation_deadline_candidate_2031c5c(e, item, d);
    unless earlier_implementation_deadline_exists(e, item, d);
    then implementation_deadline_2031c5c(e, item, d);
}
relation agreement_implemented_in_time(e: Estate, item: Asset) kind institutional;
rule AgreementImplementedInTimeRule(e: Estate, item: Asset, done: Date, deadline: Date) defeasible {
    when agreement_implemented_on(e, item, done);
    when implementation_deadline_2031c5c(e, item, deadline) and done <= deadline;
    then agreement_implemented_in_time(e, item);
}
@source(IRC_S2031_C, relation = formalizes, coverage = partial, quote = "shall result in the imposition of an additional tax in the amount of the tax which would have been due on the retained development rights subject to such agreement")
pub relation additional_tax_on_unimplemented_agreement_2031c5c(e: Estate, item: Asset, amount: Money) kind institutional {
    label en official "failure to implement the agreement by the deadline imposes an additional tax equal to the tax that would have been due on the rights; the due date, the last day of the 6th month after the deadline, needs month-end arithmetic (TECH-GAPS G3610)";
}
rule AdditionalTaxOnUnimplementedAgreementRule(e: Estate, item: Asset, amount: Money, deadline: Date) defeasible {
    when development_right_extinguishment_agreement_filed_with_return(e, item);
    when implementation_deadline_2031c5c(e, item, deadline);
    when extinguished_development_right_value(e, item, amount);
    when not_known(agreement_implemented_in_time(e, item));
    then additional_tax_on_unimplemented_agreement_2031c5c(e, item, amount);
}

// (9): an easement granted after death
pub relation easement_granted_after_death_before_return_due(e: Estate, item: Asset) kind empirical {
    label en unofficial "the qualified conservation easement is granted after the date of death and on or before the due date (including extensions) of the return (section 2031(c)(9))";
}
pub relation chapter1_charitable_deduction_allowed_for_easement_grant(e: Estate, item: Asset) kind empirical {
    label en unofficial "a charitable deduction is allowed under chapter 1 to any person with respect to the grant of the easement";
}
@source(IRC_S2031_C, relation = formalizes, coverage = exact, quote = "the deduction under section 2055(f) with respect to such easement shall be allowed to the estate but only if no charitable deduction is allowed under chapter 1 to any person with respect to the grant of such easement")
pub relation post_death_easement_deduction_barred_2031c9(e: Estate, item: Asset) kind institutional {
    label en official "the section 2055(f) deduction for an easement granted after death is not allowed where a chapter 1 charitable deduction is allowed for the grant (section 2031(c)(9))";
}
rule PostDeathEasementDeductionBarredRule(e: Estate, item: Asset) defeasible {
    when easement_granted_after_death_before_return_due(e, item);
    when chapter1_charitable_deduction_allowed_for_easement_grant(e, item);
    then post_death_easement_deduction_barred_2031c9(e, item);
}

// (10): interests in entities
pub relation decedent_ownership_share_of_entity_2057e3(e: Estate, held_entity: Person, share: Decimal) kind empirical {
    label en unofficial "the share of the partnership, corporation or trust owned directly or indirectly by the decedent under the rules of section 2057(e)(3) as in effect before its repeal (section 2031(c)(10)); attribution is case-asserted";
}
@source(IRC_S2031_C, relation = formalizes, coverage = exact, quote = "This section shall apply to an interest in a partnership, corporation, or trust if at least 30 percent of the entity is owned (directly or indirectly) by the decedent")
pub relation section_2031c_applies_to_entity_interest(e: Estate, held_entity: Person) kind institutional {
    label en official "section 2031(c) applies to an interest in an entity at least 30 percent owned by the decedent (section 2031(c)(10))";
}
rule Section2031cAppliesToEntityInterestRule(e: Estate, held_entity: Person, share: Decimal) defeasible {
    when decedent_ownership_share_of_entity_2057e3(e, held_entity, share) and share >= 0.30;
    then section_2031c_applies_to_entity_interest(e, held_entity);
}

// =====================================================================
// §2032(b): the valuation of deductions under alternate valuation
// =====================================================================

pub relation alternate_valuation_value_increase(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the increase in value of the property between the date of death and the alternate valuation date (or the date of distribution or disposition), not due to mere lapse of time or the occurrence or nonoccurrence of a contingency (section 2032(b)); an appraised fact";
}
pub relation alternate_valuation_value_decrease(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the decrease in value between the date of death and the alternate valuation date, not due to mere lapse of time or a contingency (section 2032(b))";
}
pub relation alternate_valuation_adjustment_2032b(e: Estate, item: Asset, increase: Money, decrease: Money) kind institutional {
    label en official "the net adjustment of a charitable or marital deduction value under an election: the value at death, with adjustment for the difference in value at the alternate date (section 2032(b)(1)-(2))";
}
rule AlternateValuationAdjustment2032bRule(e: Estate, item: Asset) defeasible {
    when alternate_valuation_elected(e);
    when interest_passes_to_surviving_spouse(e, item, _);
    then alternate_valuation_adjustment_2032b(e, item,
        sum(collect all v: Money where alternate_valuation_value_increase(e, item, v), empty: 0.00 USD),
        sum(collect all v: Money where alternate_valuation_value_decrease(e, item, v), empty: 0.00 USD));
}
rule AlternateValuationAdjustment2032bCharitableRule(e: Estate, item: Asset) defeasible {
    when alternate_valuation_elected(e);
    when charitable_bequest(e, item, _, _);
    then alternate_valuation_adjustment_2032b(e, item,
        sum(collect all v: Money where alternate_valuation_value_increase(e, item, v), empty: 0.00 USD),
        sum(collect all v: Money where alternate_valuation_value_decrease(e, item, v), empty: 0.00 USD));
}
pub relation deduction_already_given_effect_by_alternate_valuation(e: Estate, item: Asset) kind empirical {
    label en unofficial "allowance for the item is in effect given by the alternate valuation (section 2032(b), first sentence)";
}
@source(IRC_S2032_B, relation = formalizes, coverage = exact, quote = "No deduction under this chapter of any item shall be allowed if allowance for such items is in effect given by the alternate valuation provided by this section.")
pub relation deduction_barred_by_alternate_valuation_2032b(e: Estate, item: Asset) kind institutional {
    label en official "no deduction for an item whose allowance is in effect given by the alternate valuation (section 2032(b))";
}
rule DeductionBarredByAlternateValuationRule(e: Estate, item: Asset) defeasible {
    when alternate_valuation_elected(e);
    when deduction_already_given_effect_by_alternate_valuation(e, item);
    then deduction_barred_by_alternate_valuation_2032b(e, item);
}
