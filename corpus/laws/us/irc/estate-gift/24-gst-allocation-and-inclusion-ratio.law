// 26 U.S.C. §§2631(a)-(b), 2632(a)-(e), 2642(a)(1)(B), (a)(3), (b)-(f) — the
// allocation of the GST exemption (by the transferor, the executor, or by
// deemed allocation) and the rules that fix the inclusion ratio: timing and
// valuation, nontaxable gifts, recomputation on later transfers, charitable
// lead annuity trusts, estate tax inclusion periods, qualified severance.
// Stage 2 (DECISION-0379 with deontics) of `us.irc.estate_gift` (B01/IRC-11).
//
// SHAPE. Elections and allocations are POWERS (the transferor's or the
// executor's allocation, the election out of a deemed allocation, the election
// to treat a trust as a GST trust, the retroactive allocation of §2632(d));
// irrevocability of an allocation is a PROHIBITION; the trustee's right to
// sever a trust "at any time" is a LIBERTY. Deemed allocations produce the
// derived `gst_exemption_deemed_allocated_to_trust`, added to the asserted
// allocations in `gst_exemption_allocation_total`, which the applicable-fraction
// rules of 06 read.
//
// JUDGMENT CALLS
//  - The running balance of GST exemption already used is case-asserted
//    (`gst_exemption_previously_used`): deriving it from earlier deemed
//    allocations is the year-by-year recursion of TECH-GAPS G1 class. The same
//    holds for the applicable fraction "in effect" before a later transfer
//    (§2642(d)): one recomputation step is executable, a chain of them is
//    TECH-GAPS G3615.
//  - The interest factor of §2642(e)(2) is a case-asserted factor: `pow` takes
//    integers only (TECH-GAPS G3614).
//  - §2642(f) is applied to the transfer as a whole; the spouse-as-transferor
//    reading of (f)(4) is a case fact (`etip_spouse_treated_as_transferor`).
//  - §2632(e)(2): the proportional allocation is capped at the nonexempt portion
//    of each property, so that no applicable fraction exceeds 1.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Estate,
    GstTransfer,
    GstTransferKind,
    IRC_S2631_A,
    IRC_S2631_B,
    IRC_S2632_A,
    IRC_S2632_B,
    IRC_S2632_C,
    IRC_S2632_D,
    IRC_S2632_E,
    IRC_S2642_A,
    IRC_S2642_B,
    IRC_S2642_C,
    IRC_S2642_D,
    IRC_S2642_E,
    IRC_S2642_F,
    Individual,
    Person,
    Secretary,
    TaxableYear,
    Trust,
    decedent_individual,
    estate_return_due_date_with_extensions,
    executor_of,
    generation_assignment_effective,
    gst_allocation_by_due_date,
    gst_applicable_fraction,
    gst_exemption_allocated,
    gst_exemption_allocation_valid,
    gst_exemption_amount,
    gst_inclusion_ratio,
    gst_property_value_transferred,
    gst_recovered_taxes_and_charitable_deduction,
    gst_transfer_kind,
    gst_transfer_trust,
    has_recovered_taxes_and_charitable_deduction,
};

pub entity LifetimeTransfer {
    label en unofficial "a lifetime transfer subject to the chapter 12 tax, the subject of the deemed allocations of section 2632(b) and (c)";
}
pub relation lifetime_transfer_by(x: LifetimeTransfer, transferor: Individual) kind empirical {
    label en unofficial "the individual who makes the lifetime transfer";
}
pub relation lifetime_transfer_to_trust(x: LifetimeTransfer, trust: Trust) kind empirical {
    label en unofficial "the transfer is made to the trust";
}
pub relation lifetime_transfer_year(x: LifetimeTransfer, y: TaxableYear) kind empirical {
    label en unofficial "the calendar year in which the transfer is made";
}
pub relation lifetime_transfer_value(x: LifetimeTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property transferred";
}
pub relation lifetime_transfer_is_direct_skip(x: LifetimeTransfer) kind empirical {
    label en unofficial "the transfer is a direct skip (section 2612(c))";
}
pub relation lifetime_transfer_subject_to_chapter12_tax(x: LifetimeTransfer) kind empirical {
    label en unofficial "the transfer is subject to the tax imposed by chapter 12";
}
pub relation lifetime_transfer_is_gst(x: LifetimeTransfer, t: GstTransfer) kind empirical {
    label en unofficial "the lifetime transfer is the generation-skipping transfer t (a direct skip)";
}
pub relation gst_exemption_previously_used(x: LifetimeTransfer, amount: Money) kind empirical {
    label en unofficial "the part of the individual's GST exemption already allocated by the individual, or treated as allocated under section 2632(b)(1) or (c)(1) for earlier transfers; a running balance asserted by the case";
}

// =====================================================================
// §2631(a): the allocation by the transferor or by the executor
// =====================================================================

pub relation gst_allocation_filed_on(transferor: Individual, d: Date) kind empirical {
    label en unofficial "the individual's allocation of the GST exemption is filed on the stated date";
}
pub relation transferor_estate_return_due_date(transferor: Individual, d: Date) kind empirical {
    label en unofficial "the date prescribed for filing the estate tax return of the individual's estate, determined with regard to extensions, regardless of whether a return is required; recorded once the individual has died (section 2632(a)(1))";
}
relation transferor_estate_return_due_date_recorded(transferor: Individual) kind institutional;
rule TransferorEstateReturnDueDateRecordedRule(transferor: Individual) defeasible {
    when transferor_estate_return_due_date(transferor, _);
    then transferor_estate_return_due_date_recorded(transferor);
}
@source(IRC_S2632_A, relation = formalizes, coverage = exact, quote = "Any allocation by an individual of his GST exemption under section 2631(a) may be made at any time on or before the date prescribed for filing the estate tax return for such individual's estate (determined with regard to extensions), regardless of whether such a return is required to be filed.")
rule GstAllocationByDueDateAfterDeathRule(transferor: Individual, y: TaxableYear, filed: Date, due: Date) defeasible {
    label en official "an allocation filed on or before the date prescribed for the individual's estate tax return, with extensions, is timely (section 2632(a)(1))";
    when gst_allocation_filed_on(transferor, filed);
    when transferor_estate_return_due_date(transferor, due) and filed <= due;
    when us.irc.core::year_of(transferor, y);
    then gst_allocation_by_due_date(transferor, y);
}
rule GstAllocationByDueDateLivingRule(transferor: Individual, y: TaxableYear, filed: Date) defeasible {
    label en official "while the individual lives no estate tax return date has arrived: an allocation is timely (section 2632(a)(1))";
    when gst_allocation_filed_on(transferor, filed);
    when not_known(transferor_estate_return_due_date_recorded(transferor));
    when us.irc.core::year_of(transferor, y);
    then gst_allocation_by_due_date(transferor, y);
}
pub relation gst_exemption_allocated_by_executor(e: Estate, x: Person, trust_or_property: Trust, amount: Money) kind empirical {
    label en unofficial "the executor allocates GST exemption of the decedent to property of which the decedent is the transferor (section 2631(a))";
}
pub relation gst_executor_allocation_timely(e: Estate) kind institutional {
    label en unofficial "the executor's allocation is made on or before the date prescribed for filing the estate tax return, with extensions (section 2632(a)(1))";
}
pub relation gst_executor_allocation_filed_on(e: Estate, d: Date) kind empirical {
    label en unofficial "the executor's allocation is filed on the stated date";
}
rule GstExecutorAllocationTimelyRule(e: Estate, filed: Date, due: Date) defeasible {
    when gst_executor_allocation_filed_on(e, filed);
    when estate_return_due_date_with_extensions(e, due) and filed <= due;
    then gst_executor_allocation_timely(e);
}
@source(IRC_S2631_A, relation = formalizes, coverage = exact, quote = "every individual shall be allowed a GST exemption amount which may be allocated by such individual (or his executor) to any property with respect to which such individual is the transferor")
rule GstExemptionAllocationByExecutorPower(e: Estate, x: Person, p: Individual, trust_or_property: Trust, amount: Money, w: Interval<Instant>) strict {
    label en official "the executor may allocate the decedent's GST exemption to property of which the decedent is the transferor, on or before the estate tax return date (sections 2631(a), 2632(a)(1))";
    when executor_of(e, x, w);
    when decedent_individual(e, p);
    when gst_exemption_allocated_by_executor(e, x, trust_or_property, amount);
    then power GstExemptionAllocationByExecutor {
        holder x;
        over trust_or_property;
        exercise gst_exemption_allocated_by_executor(e, x, trust_or_property, amount);
        valid_when gst_executor_allocation_timely(e);
        effect create(gst_exemption_allocation_valid(p, trust_or_property));
        window w;
    };
}
// (b): allocations are irrevocable
pub relation transferor_revokes_gst_allocation(transferor: Person, trust_or_property: Trust) kind empirical {
    label en unofficial "the transferor purports to revoke an allocation of GST exemption";
}
@source(IRC_S2631_B, relation = formalizes, coverage = exact, quote = "Any allocation under subsection (a), once made, shall be irrevocable.")
rule GstAllocationIrrevocableRule(transferor: Person, trust_or_property: Trust) defeasible {
    label en official "an allocation, once made, shall be irrevocable: the transferor may not revoke it (section 2631(b))";
    when gst_exemption_allocation_valid(transferor, trust_or_property);
    then prohibition GstAllocationRevocationProhibition {
        bearer transferor;
        beneficiary Secretary;
        action transferor_revokes_gst_allocation(transferor, trust_or_property);
        window [@1986-10-23, infinity);
    };
}

// The deemed allocations produce a second source of allocated exemption.
pub relation gst_exemption_deemed_allocated_to_trust(transferor: Person, trust: Trust, amount: Money) kind institutional {
    label en unofficial "the GST exemption deemed allocated to the trust by sections 2632(b)(1), (c)(1), (d) or (e), summed";
}
pub relation gst_exemption_allocation_total(transferor: Person, trust: Trust, amount: Money) kind institutional {
    label en unofficial "the GST exemption allocated to the trust: the transferor's or executor's allocations plus deemed allocations (section 2642(a)(2)(A))";
}
rule GstExemptionAllocationTotalFromAllocatedRule(transferor: Person, trust: Trust) defeasible {
    when gst_exemption_allocated(transferor, trust, _);
    then gst_exemption_allocation_total(transferor, trust,
        sum(collect all a: Money where gst_exemption_allocated(transferor, trust, a), empty: 0.00 USD)
        + sum(collect all d: Money where gst_exemption_deemed_allocated_to_trust(transferor, trust, d), empty: 0.00 USD));
}
rule GstExemptionAllocationTotalFromDeemedRule(transferor: Person, trust: Trust) defeasible {
    when gst_exemption_deemed_allocated_to_trust(transferor, trust, _);
    when not_known(gst_exemption_asserted_allocation_present(transferor, trust));
    then gst_exemption_allocation_total(transferor, trust, sum(collect all d: Money where gst_exemption_deemed_allocated_to_trust(transferor, trust, d), empty: 0.00 USD));
}
relation gst_exemption_asserted_allocation_present(transferor: Person, trust: Trust) kind institutional;
rule GstExemptionAssertedAllocationPresentRule(transferor: Person, trust: Trust) defeasible {
    when gst_exemption_allocated(transferor, trust, _);
    then gst_exemption_asserted_allocation_present(transferor, trust);
}

// =====================================================================
// §2632(b): deemed allocation to a lifetime direct skip
// =====================================================================

pub relation gst_unused_exemption_2632(x: LifetimeTransfer, amount: Money) kind institutional {
    label en official "the unused portion of the individual's GST exemption: the exemption amount for the year less what has previously been allocated or treated as allocated (section 2632(b)(2), (c)(2))";
}
rule GstUnusedExemption2632Rule(x: LifetimeTransfer, y: TaxableYear, exemption: Money, used: Money) defeasible {
    when lifetime_transfer_year(x, y);
    when gst_exemption_amount(y, exemption);
    when gst_exemption_previously_used(x, used);
    then gst_unused_exemption_2632(x, max(0.00 USD, exemption - used));
}
pub relation gst_election_out_of_deemed_allocation_made(x: LifetimeTransfer, transferor: Individual, w: Interval<Instant>) kind empirical {
    label en unofficial "the individual elects that the deemed allocation of section 2632(b) (or (c)) not apply to the transfer";
}
pub relation gst_election_on_timely_gift_tax_return(x: LifetimeTransfer) kind empirical {
    label en unofficial "the election is filed on a timely filed gift tax return for the calendar year in which the transfer was made or deemed made (section 2632(c)(5)(B)(i)), or on a later date the Secretary prescribes";
}
pub relation gst_auto_allocation_elected_out(x: LifetimeTransfer) kind institutional {
    label en official "the deemed allocation does not apply to the transfer: the individual elected out (sections 2632(b)(3), (c)(5)(A)(i)(I))";
}
@source(IRC_S2632_B, relation = formalizes, coverage = exact, quote = "An individual may elect to have this subsection not apply to a transfer.")
rule GstAutoAllocationElectOutPower(x: LifetimeTransfer, transferor: Individual, w: Interval<Instant>) strict {
    label en official "the individual may elect that the deemed allocation not apply to the transfer (section 2632(b)(3), (c)(5)(A)(i)(I))";
    when lifetime_transfer_by(x, transferor);
    when gst_election_out_of_deemed_allocation_made(x, transferor, w);
    then power GstAutoAllocationElectOut {
        holder transferor;
        over x;
        exercise gst_election_out_of_deemed_allocation_made(x, transferor, w);
        valid_when gst_election_on_timely_gift_tax_return(x);
        effect create(gst_auto_allocation_elected_out(x));
        window w;
    };
}
pub relation gst_deemed_allocation(x: LifetimeTransfer, amount: Money) kind institutional {
    label en official "the unused GST exemption deemed allocated to the transfer: as much as makes the inclusion ratio zero, and the whole unused portion if the transfer exceeds it (sections 2632(b)(1), (c)(1))";
}
@source(IRC_S2632_B, relation = formalizes, coverage = exact, quote = "any unused portion of such individual's GST exemption shall be allocated to the property transferred to the extent necessary to make the inclusion ratio for such property zero")
rule GstDeemedAllocationDirectSkipRule(x: LifetimeTransfer, unused: Money, value: Money) defeasible {
    label en official "a lifetime direct skip receives the unused GST exemption, up to its value (section 2632(b)(1))";
    when lifetime_transfer_is_direct_skip(x);
    when lifetime_transfer_subject_to_chapter12_tax(x);
    when gst_unused_exemption_2632(x, unused);
    when lifetime_transfer_value(x, value);
    when not_known(gst_auto_allocation_elected_out(x));
    then gst_deemed_allocation(x, min(unused, value));
}
rule GstDeemedAllocationIndirectSkipRule(x: LifetimeTransfer, trust: Trust, transferor: Individual, unused: Money, value: Money) defeasible {
    label en official "a lifetime indirect skip, a transfer to a GST trust, receives the unused GST exemption, up to its value (section 2632(c)(1))";
    when gst_indirect_skip(x);
    when gst_unused_exemption_2632(x, unused);
    when lifetime_transfer_value(x, value);
    when not_known(gst_auto_allocation_elected_out(x));
    then gst_deemed_allocation(x, min(unused, value));
}
rule GstDeemedAllocationToTrustRule(x: LifetimeTransfer, transferor: Individual, trust: Trust) defeasible {
    label en official "the deemed allocation to a transfer to a trust adds to the exemption allocated to the trust";
    when gst_deemed_allocation(x, _);
    when lifetime_transfer_by(x, transferor);
    when lifetime_transfer_to_trust(x, trust);
    then gst_exemption_deemed_allocated_to_trust(transferor, trust, sum(collect all a: Money, x2: LifetimeTransfer where lifetime_transfer_by(x2, transferor) and lifetime_transfer_to_trust(x2, trust) and gst_deemed_allocation(x2, a), empty: 0.00 USD));
}
pub relation gst_allocation_to_direct_skip(t: GstTransfer, amount: Money) kind institutional {
    label en official "the GST exemption allocated to the property involved in a direct skip (section 2642(a)(2)(A)): asserted, or deemed under section 2632(b)(1)";
}
pub relation gst_allocation_to_direct_skip_asserted(t: GstTransfer, amount: Money) kind empirical {
    label en unofficial "the GST exemption the transferor allocated to the property involved in the direct skip";
}
rule GstAllocationToDirectSkipAssertedRule(t: GstTransfer, a: Money) defeasible {
    when gst_allocation_to_direct_skip_asserted(t, a);
    then gst_allocation_to_direct_skip(t, a);
}
rule GstAllocationToDirectSkipDeemedRule(t: GstTransfer, x: LifetimeTransfer, a: Money) defeasible {
    when lifetime_transfer_is_gst(x, t);
    when gst_deemed_allocation(x, a);
    then gst_allocation_to_direct_skip(t, a);
}

// =====================================================================
// §2632(c): indirect skips and the GST trust
// =====================================================================

pub relation trust_could_have_generation_skipping_transfer(trust: Trust, transferor: Individual) kind empirical {
    label en unofficial "the trust could have a generation-skipping transfer with respect to the transferor (section 2632(c)(3)(B))";
}
pub relation corpus_share_to_non_skip_before_age_46(trust: Trust, share: Decimal) kind empirical {
    label en unofficial "the share of the trust corpus that must be distributed to, or may be withdrawn by, non-skip individuals before age 46, or by dates or events expected before age 46 (section 2632(c)(3)(B)(i))";
}
pub relation corpus_share_to_non_skip_living_at_death_of_older_person(trust: Trust, share: Decimal) kind empirical {
    label en unofficial "the share of the corpus that must be distributed to, or may be withdrawn by, non-skip individuals living at the death of another person identified in the instrument who is more than 10 years older (section 2632(c)(3)(B)(ii))";
}
pub relation corpus_share_to_estate_or_general_power_if_nonskip_dies(trust: Trust, share: Decimal) kind empirical {
    label en unofficial "the share of the corpus that, if non-skip individuals die on or before a date or event of (i) or (ii), must be distributed to their estates or is subject to their general power of appointment (section 2632(c)(3)(B)(iii))";
}
pub relation trust_portion_includible_in_nonskip_estate(trust: Trust) kind empirical {
    label en unofficial "any portion of the trust would be included in the gross estate of a non-skip person, other than the transferor, if that person died immediately after the transfer; a right to withdraw up to the annual exclusion amount is disregarded and powers of appointment are assumed unexercised (section 2632(c)(3)(B)(iv), flush)";
}
pub relation trust_is_clat_crat_or_crut(trust: Trust) kind empirical {
    label en unofficial "the trust is a charitable lead annuity trust, a charitable remainder annuity trust or a charitable remainder unitrust (section 2632(c)(3)(B)(v))";
}
pub relation trust_fixed_percentage_lead_with_principal_to_nonskip(trust: Trust) kind empirical {
    label en unofficial "a deduction was allowed under section 2522 for a right to annual payments of a fixed percentage of the net fair market value of the trust property, and the trust must pay principal to a non-skip person alive when the payments terminate (section 2632(c)(3)(B)(vi))";
}
relation gst_trust_exception_applies(trust: Trust) kind institutional;
rule GstTrustExceptionEarlyDistributionRule(trust: Trust, share: Decimal) defeasible {
    when corpus_share_to_non_skip_before_age_46(trust, share) and share > 0.25;
    then gst_trust_exception_applies(trust);
}
rule GstTrustExceptionOlderPersonRule(trust: Trust, share: Decimal) defeasible {
    when corpus_share_to_non_skip_living_at_death_of_older_person(trust, share) and share > 0.25;
    then gst_trust_exception_applies(trust);
}
rule GstTrustExceptionEstateOrPowerRule(trust: Trust, share: Decimal) defeasible {
    when corpus_share_to_estate_or_general_power_if_nonskip_dies(trust, share) and share > 0.25;
    then gst_trust_exception_applies(trust);
}
rule GstTrustExceptionIncludibleRule(trust: Trust) defeasible {
    when trust_portion_includible_in_nonskip_estate(trust);
    then gst_trust_exception_applies(trust);
}
rule GstTrustExceptionCharitableRule(trust: Trust) defeasible {
    when trust_is_clat_crat_or_crut(trust);
    then gst_trust_exception_applies(trust);
}
rule GstTrustExceptionFixedPercentageRule(trust: Trust) defeasible {
    when trust_fixed_percentage_lead_with_principal_to_nonskip(trust);
    then gst_trust_exception_applies(trust);
}
pub relation trust_elected_as_gst_trust(trust: Trust, transferor: Individual) kind institutional {
    label en official "the transferor has elected to treat the trust as a GST trust (section 2632(c)(5)(A)(ii))";
}
pub relation gst_trust_election_made(trust: Trust, transferor: Individual, w: Interval<Instant>) kind empirical {
    label en unofficial "the transferor elects to treat the trust as a GST trust for any or all transfers";
}
pub relation gst_trust_election_on_timely_return_for_effective_year(trust: Trust, transferor: Individual) kind empirical {
    label en unofficial "the election is made on a timely filed gift tax return for the calendar year for which it is to become effective (section 2632(c)(5)(B)(ii))";
}
@source(IRC_S2632_C, relation = formalizes, coverage = exact, quote = "may elect to treat any trust as a GST trust for purposes of this subsection with respect to any or all transfers made by such individual to such trust")
rule GstTrustElectionPower(trust: Trust, transferor: Individual, w: Interval<Instant>) strict {
    label en official "the individual may elect to treat a trust as a GST trust (section 2632(c)(5)(A)(ii)), on a timely filed gift tax return for the year the election becomes effective";
    when gst_trust_election_made(trust, transferor, w);
    then power GstTrustElection {
        holder transferor;
        over trust;
        exercise gst_trust_election_made(trust, transferor, w);
        valid_when gst_trust_election_on_timely_return_for_effective_year(trust, transferor);
        effect create(trust_elected_as_gst_trust(trust, transferor));
        window w;
    };
}
@source(IRC_S2632_C, relation = formalizes, coverage = exact, quote = "The term \"GST trust\" means a trust that could have a generation-skipping transfer with respect to the transferor unless")
pub relation gst_trust_2632c3b(trust: Trust, transferor: Individual) kind institutional {
    label en official "a GST trust: a trust that could have a generation-skipping transfer with respect to the transferor and meets none of the exceptions (i)-(vi), or that the transferor elected to treat as a GST trust (section 2632(c)(3)(B), (5))";
}
rule GstTrust2632c3bRule(trust: Trust, transferor: Individual) defeasible {
    when trust_could_have_generation_skipping_transfer(trust, transferor);
    when not_known(gst_trust_exception_applies(trust));
    then gst_trust_2632c3b(trust, transferor);
}
rule GstTrustByElectionRule(trust: Trust, transferor: Individual) defeasible {
    when trust_elected_as_gst_trust(trust, transferor);
    then gst_trust_2632c3b(trust, transferor);
}
@source(IRC_S2632_C, relation = formalizes, coverage = exact, quote = "the term \"indirect skip\" means any transfer of property (other than a direct skip) subject to the tax imposed by chapter 12 made to a GST trust")
pub relation gst_indirect_skip(x: LifetimeTransfer) kind institutional {
    label en official "an indirect skip: a transfer subject to chapter 12 tax, other than a direct skip, made to a GST trust (section 2632(c)(3)(A))";
}
rule GstIndirectSkipRule(x: LifetimeTransfer, trust: Trust, transferor: Individual) defeasible {
    when lifetime_transfer_subject_to_chapter12_tax(x);
    when not_known(lifetime_transfer_is_direct_skip(x));
    when lifetime_transfer_by(x, transferor);
    when lifetime_transfer_to_trust(x, trust);
    when gst_trust_2632c3b(trust, transferor);
    then gst_indirect_skip(x);
}
// (c)(5)(A)(i)(II): an election for all transfers to a particular trust
pub relation gst_election_out_for_all_transfers_to_trust(trust: Trust, transferor: Individual) kind empirical {
    label en unofficial "the individual elects that section 2632(c) not apply to any or all transfers made by the individual to the particular trust (section 2632(c)(5)(A)(i)(II))";
}
rule GstAutoAllocationElectedOutForTrustRule(x: LifetimeTransfer, trust: Trust, transferor: Individual) defeasible {
    when lifetime_transfer_by(x, transferor);
    when lifetime_transfer_to_trust(x, trust);
    when gst_election_out_for_all_transfers_to_trust(trust, transferor);
    then gst_auto_allocation_elected_out(x);
}
// (c)(4): an indirect skip during an estate tax inclusion period
pub relation etip_close_date(x: LifetimeTransfer, d: Date) kind empirical {
    label en unofficial "the close of the estate tax inclusion period for the transfer (section 2642(f)(3))";
}
pub relation lifetime_transfer_subject_to_2642f(x: LifetimeTransfer) kind empirical {
    label en unofficial "section 2642(f) applies to the transfer: an inter vivos transfer whose value would be includible in the transferor's gross estate if the transferor died immediately after it, other than by reason of section 2035";
}
pub relation value_of_trust_property_at_etip_close(x: LifetimeTransfer, amount: Money) kind empirical {
    label en unofficial "the fair market value of the trust property at the close of the estate tax inclusion period (section 2632(c)(4))";
}
@source(IRC_S2632_C, relation = formalizes, coverage = exact, quote = "an indirect skip to which section 2642(f) applies shall be deemed to have been made only at the close of the estate tax inclusion period")
pub relation indirect_skip_deemed_made_at_etip_close(x: LifetimeTransfer, d: Date, value: Money) kind institutional {
    label en official "an indirect skip subject to section 2642(f) is deemed made at the close of the estate tax inclusion period, at the trust property's value then (section 2632(c)(4))";
}
rule IndirectSkipDeemedMadeAtEtipCloseRule(x: LifetimeTransfer, closed: Date, value: Money) defeasible {
    when gst_indirect_skip(x);
    when lifetime_transfer_subject_to_2642f(x);
    when etip_close_date(x, closed);
    when value_of_trust_property_at_etip_close(x, value);
    then indirect_skip_deemed_made_at_etip_close(x, closed, value);
}

// =====================================================================
// §2632(d): retroactive allocation on the death of a non-skip person
// =====================================================================

pub relation nonskip_person_has_interest_or_future_interest_in_trust(trust: Trust, p: Person) kind empirical {
    label en unofficial "a non-skip person has an interest or a future interest in a trust to which a transfer has been made; a future interest exists if the trust may permit income or corpus to be paid to the person on a future date or dates (section 2632(d)(1)(A), (3))";
}
pub relation nonskip_person_lineal_descendant_of_grandparent_of_transferor_or_spouse(p: Person, transferor: Individual) kind empirical {
    label en unofficial "the person is a lineal descendant of a grandparent of the transferor or of a grandparent of the transferor's spouse or former spouse (section 2632(d)(1)(B)(i))";
}
pub relation nonskip_person_predeceases_transferor(p: Person, transferor: Individual) kind empirical {
    label en unofficial "the person dies before the transferor (section 2632(d)(1)(C))";
}
relation retroactive_allocation_conditions_met(trust: Trust, transferor: Individual) kind institutional;
rule RetroactiveAllocationConditionsMetRule(trust: Trust, transferor: Individual, p: Person, g: Integer) defeasible {
    when nonskip_person_has_interest_or_future_interest_in_trust(trust, p);
    when nonskip_person_lineal_descendant_of_grandparent_of_transferor_or_spouse(p, transferor);
    when generation_assignment_effective(p, transferor, g) and g >= 1;
    when nonskip_person_predeceases_transferor(p, transferor);
    then retroactive_allocation_conditions_met(trust, transferor);
}
pub relation retroactive_gst_allocation_made(trust: Trust, transferor: Individual, amount: Money, w: Interval<Instant>) kind empirical {
    label en unofficial "the transferor allocates unused GST exemption to previous transfers to the trust on a chronological basis (section 2632(d)(1))";
}
pub relation retroactive_gst_allocation_effective(trust: Trust, transferor: Individual) kind institutional {
    label en official "the retroactive allocation is effective (section 2632(d))";
}
@source(IRC_S2632_D, relation = formalizes, coverage = exact, quote = "then the transferor may make an allocation of any of such transferor's unused GST exemption to any previous transfer or transfers to the trust on a chronological basis")
rule RetroactiveGstAllocationPower(trust: Trust, transferor: Individual, amount: Money, w: Interval<Instant>) strict {
    label en official "the transferor may allocate unused GST exemption to previous transfers to a trust when a non-skip descendant with an interest predeceases the transferor (section 2632(d)(1))";
    when retroactive_gst_allocation_made(trust, transferor, amount, w);
    then power RetroactiveGstAllocation {
        holder transferor;
        over trust;
        exercise retroactive_gst_allocation_made(trust, transferor, amount, w);
        valid_when retroactive_allocation_conditions_met(trust, transferor);
        effect create(retroactive_gst_allocation_effective(trust, transferor));
        window w;
    };
}
pub relation retroactive_allocation_return_filed_on(trust: Trust, transferor: Individual, d: Date) kind empirical {
    label en unofficial "the allocation is made on a gift tax return filed on the stated date";
}
pub relation nonskip_person_death_calendar_year_return_due(trust: Trust, transferor: Individual, d: Date) kind empirical {
    label en unofficial "the date prescribed by section 6075(b) for gifts made within the calendar year in which the non-skip person's death occurred";
}
pub relation nonskip_person_death_date(p: Person, d: Date) kind empirical {
    label en unofficial "the date of death of the non-skip person";
}
@source(IRC_S2632_D, relation = formalizes, coverage = exact, quote = "such allocation shall be effective immediately before such death")
pub relation retroactive_allocation_treated_as_timely_2632d2(trust: Trust, transferor: Individual) kind institutional {
    label en official "the allocation is made on a return filed by the section 6075(b) date for the year of the death: the transfers are valued as if allocated on timely returns for their own years, the allocation is effective immediately before the death, and unused exemption is determined immediately before the death (section 2632(d)(2))";
}
rule RetroactiveAllocationTreatedAsTimelyRule(trust: Trust, transferor: Individual, filed: Date, due: Date) defeasible {
    when retroactive_gst_allocation_effective(trust, transferor);
    when retroactive_allocation_return_filed_on(trust, transferor, filed);
    when nonskip_person_death_calendar_year_return_due(trust, transferor, due) and filed <= due;
    then retroactive_allocation_treated_as_timely_2632d2(trust, transferor);
}
pub relation retroactive_allocation_effective_date(trust: Trust, transferor: Individual, d: Date) kind institutional {
    label en official "the date immediately before the death of the non-skip person, on which a timely retroactive allocation takes effect (section 2632(d)(2)(B)); the exemption available is that determined immediately before the death (2632(d)(2)(C))";
}
rule RetroactiveAllocationEffectiveDateRule(trust: Trust, transferor: Individual, p: Person, died: Date, calendar_before_1: Date) defeasible {
    when retroactive_allocation_treated_as_timely_2632d2(trust, transferor);
    when nonskip_person_has_interest_or_future_interest_in_trust(trust, p);
    when nonskip_person_death_date(p, died)
        and us.irc.core::civil_calendar_boundary_before(died, 1, us.irc.core::CalendarDay, calendar_before_1);
    then retroactive_allocation_effective_date(trust, transferor, calendar_before_1);
}

// =====================================================================
// §2632(e): deemed allocation of the exemption unused at death
// =====================================================================

pub enum GstDeathAllocationCategory {
    DirectSkipAtDeath;                 // (e)(1)(A)
    TrustWithPossibleDistributionOrTermination;   // (e)(1)(B)
}
pub relation gst_exemption_unallocated_at_return_due_date(transferor: Individual, amount: Money) kind empirical {
    label en unofficial "the portion of the individual's GST exemption not allocated within the time prescribed by subsection (a)";
}
pub relation gst_death_property(transferor: Individual, k: Integer, category: GstDeathAllocationCategory, value: Money, inclusion_ratio: Decimal) kind empirical {
    label en unofficial "property k that is the subject of a direct skip at the individual's death, or a trust with respect to which the individual is the transferor and from which a taxable distribution or taxable termination might occur at or after death, with its value and inclusion ratio at the time of allocation";
}
pub relation gst_nonexempt_portion(transferor: Individual, k: Integer, amount: Money) kind institutional {
    label en official "the nonexempt portion: the value at the time of allocation multiplied by the inclusion ratio (section 2632(e)(2)(B))";
}
rule GstNonexemptPortionRule(transferor: Individual, k: Integer, value: Money, ratio: Decimal) defeasible {
    when gst_death_property(transferor, k, _, value, ratio);
    then gst_nonexempt_portion(transferor, k, round(value * ratio, 2, "HALF_UP"));
}
pub relation gst_nonexempt_total_by_category(transferor: Individual, category: GstDeathAllocationCategory, amount: Money) kind institutional {
    label en unofficial "the sum of the nonexempt portions of the properties of the category";
}
rule GstNonexemptTotalByCategoryRule(transferor: Individual, category: GstDeathAllocationCategory) defeasible {
    when gst_death_property(transferor, _, category, _, _);
    then gst_nonexempt_total_by_category(transferor, category, sum(collect all a: Money, k: Integer where gst_death_property(transferor, k, category, _, _) and gst_nonexempt_portion(transferor, k, a), empty: 0.00 USD));
}
pub relation gst_death_allocation_to_category(transferor: Individual, category: GstDeathAllocationCategory, amount: Money) kind institutional {
    label en official "the unused exemption deemed allocated to the category: first to direct skips at death, then to trusts (section 2632(e)(1))";
}
rule GstDeathAllocationFirstCategoryRule(transferor: Individual, unused: Money, nonexempt: Money) defeasible {
    when gst_exemption_unallocated_at_return_due_date(transferor, unused);
    when gst_nonexempt_total_by_category(transferor, DirectSkipAtDeath, nonexempt);
    then gst_death_allocation_to_category(transferor, DirectSkipAtDeath, min(unused, nonexempt));
}
rule GstDeathAllocationSecondCategoryWithFirstRule(transferor: Individual, unused: Money, first_nonexempt: Money, second_nonexempt: Money) defeasible {
    when gst_exemption_unallocated_at_return_due_date(transferor, unused);
    when gst_nonexempt_total_by_category(transferor, DirectSkipAtDeath, first_nonexempt);
    when gst_nonexempt_total_by_category(transferor, TrustWithPossibleDistributionOrTermination, second_nonexempt);
    then gst_death_allocation_to_category(transferor, TrustWithPossibleDistributionOrTermination, min(max(0.00 USD, unused - first_nonexempt), second_nonexempt));
}
rule GstDeathAllocationSecondCategoryAloneRule(transferor: Individual, unused: Money, second_nonexempt: Money) defeasible {
    when gst_exemption_unallocated_at_return_due_date(transferor, unused);
    when gst_nonexempt_total_by_category(transferor, TrustWithPossibleDistributionOrTermination, second_nonexempt);
    when not_known(gst_direct_skip_at_death_present(transferor));
    then gst_death_allocation_to_category(transferor, TrustWithPossibleDistributionOrTermination, min(unused, second_nonexempt));
}
relation gst_direct_skip_at_death_present(transferor: Individual) kind institutional;
rule GstDirectSkipAtDeathPresentRule(transferor: Individual) defeasible {
    when gst_death_property(transferor, _, DirectSkipAtDeath, _, _);
    then gst_direct_skip_at_death_present(transferor);
}
pub relation gst_death_allocation_to_property(transferor: Individual, k: Integer, amount: Money) kind institutional {
    label en official "the exemption deemed allocated to property k: in proportion to the nonexempt portions within its category (section 2632(e)(2)(A))";
}
@source(IRC_S2632_E, relation = formalizes, coverage = exact, quote = "in proportion to the respective amounts (at the time of allocation) of the nonexempt portions of such properties or trusts")
rule GstDeathAllocationToPropertyRule(transferor: Individual, k: Integer, category: GstDeathAllocationCategory, alloc: Money, total: Money, own: Money) defeasible {
    label en official "each property of the category receives its proportional share of the category's allocation (section 2632(e)(2))";
    when gst_death_property(transferor, k, category, _, _);
    when gst_death_allocation_to_category(transferor, category, alloc);
    when gst_nonexempt_total_by_category(transferor, category, total) and total > 0.00 USD;
    when gst_nonexempt_portion(transferor, k, own);
    then gst_death_allocation_to_property(transferor, k, div_round(alloc * (own / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// =====================================================================
// §2642(a): direct skip fraction; severance
// =====================================================================

@source(IRC_S2642_A, relation = formalizes, coverage = exact, quote = "in the case of a direct skip, the applicable fraction determined for such skip")
rule GstApplicableFractionDirectSkipRule(t: GstTransfer, allocated: Money, value: Money, reductions: Money) defeasible {
    label en official "for a direct skip the applicable fraction is the exemption allocated to the property involved over its value net of recovered taxes and charitable deductions (section 2642(a)(1)(B), (2))";
    when gst_transfer_kind(t, DirectSkip);
    when gst_allocation_to_direct_skip(t, allocated);
    when gst_property_value_transferred(t, value);
    when gst_recovered_taxes_and_charitable_deduction(t, reductions);
    then gst_applicable_fraction(t, allocated / (value - reductions));
}
rule GstApplicableFractionDirectSkipNoReductionsRule(t: GstTransfer, allocated: Money, value: Money) defeasible {
    when gst_transfer_kind(t, DirectSkip);
    when gst_allocation_to_direct_skip(t, allocated);
    when gst_property_value_transferred(t, value);
    when not_known(has_recovered_taxes_and_charitable_deduction(t));
    then gst_applicable_fraction(t, allocated / value);
}

pub relation trust_divided_on_fractional_basis(trust: Trust, s: Integer) kind empirical {
    label en unofficial "the single trust was divided on a fractional basis (section 2642(a)(3)(B)(i)(I)); s numbers the severance";
}
pub relation new_trusts_same_succession_of_interests(trust: Trust, s: Integer) kind empirical {
    label en unofficial "the terms of the new trusts, in the aggregate, provide for the same succession of interests of beneficiaries as the original trust (section 2642(a)(3)(B)(i)(II))";
}
pub relation trust_severed_into_two_trusts(trust: Trust, s: Integer, exempt_trust: Trust, other_trust: Trust) kind empirical {
    label en unofficial "the trust is divided into two trusts, exempt_trust receiving a fractional share and other_trust the rest";
}
pub relation severed_share_fraction(trust: Trust, s: Integer, fraction: Decimal) kind empirical {
    label en unofficial "the fractional share of the total value of all trust assets received by the first new trust";
}
pub relation trust_applicable_fraction_immediately_before_severance(trust: Trust, s: Integer, fraction: Decimal) kind empirical {
    label en unofficial "the applicable fraction of the single trust immediately before the severance";
}
@source(IRC_S2642_A, relation = formalizes, coverage = partial, quote = "The term \"qualified severance\" means the division of a single trust and the creation (by any means available under the governing instrument or under local law) of two or more trusts if")
pub relation qualified_severance_2642a3(trust: Trust, s: Integer) kind institutional {
    label en official "a qualified severance: divided on a fractional basis into trusts providing in the aggregate the same succession of interests (section 2642(a)(3)(B)(i)); the regulatory severances of (iii) are the Secretary's";
}
rule QualifiedSeveranceRule(trust: Trust, s: Integer) defeasible {
    when trust_divided_on_fractional_basis(trust, s);
    when new_trusts_same_succession_of_interests(trust, s);
    then qualified_severance_2642a3(trust, s);
}
pub relation severed_trusts_treated_as_separate_2642a3a(trust: Trust, s: Integer, new_trust: Trust) kind institutional {
    label en official "the trusts resulting from a qualified severance are treated as separate trusts thereafter (section 2642(a)(3)(A))";
}
rule SeveredTrustsTreatedAsSeparateRule(trust: Trust, s: Integer, a: Trust, b: Trust) defeasible {
    when qualified_severance_2642a3(trust, s);
    when trust_severed_into_two_trusts(trust, s, a, b);
    then severed_trusts_treated_as_separate_2642a3a(trust, s, a);
}
rule SeveredTrustsTreatedAsSeparateOtherRule(trust: Trust, s: Integer, a: Trust, b: Trust) defeasible {
    when qualified_severance_2642a3(trust, s);
    when trust_severed_into_two_trusts(trust, s, a, b);
    then severed_trusts_treated_as_separate_2642a3a(trust, s, b);
}
pub relation severance_share_equals_applicable_fraction(trust: Trust, s: Integer) kind institutional;
rule SeveranceShareEqualsApplicableFractionRule(trust: Trust, s: Integer, share: Decimal, fraction: Decimal) defeasible {
    when severed_share_fraction(trust, s, share);
    when trust_applicable_fraction_immediately_before_severance(trust, s, fraction) and share == fraction;
    then severance_share_equals_applicable_fraction(trust, s);
}
pub relation severed_trust_inclusion_ratio(new_trust: Trust, ratio: Decimal) kind institutional {
    label en official "a trust with an inclusion ratio above zero and below 1 is severed in a qualified way only into two trusts, one taking a share equal to the applicable fraction: it has inclusion ratio zero and the other 1 (section 2642(a)(3)(B)(ii))";
}
rule SeveredTrustInclusionRatioExemptRule(trust: Trust, s: Integer, a: Trust, b: Trust, fraction: Decimal) defeasible {
    when qualified_severance_2642a3(trust, s);
    when trust_severed_into_two_trusts(trust, s, a, b);
    when trust_applicable_fraction_immediately_before_severance(trust, s, fraction) and fraction > 0.0 and fraction < 1.0;
    when severance_share_equals_applicable_fraction(trust, s);
    then severed_trust_inclusion_ratio(a, 0.0);
}
rule SeveredTrustInclusionRatioOtherRule(trust: Trust, s: Integer, a: Trust, b: Trust, fraction: Decimal) defeasible {
    when qualified_severance_2642a3(trust, s);
    when trust_severed_into_two_trusts(trust, s, a, b);
    when trust_applicable_fraction_immediately_before_severance(trust, s, fraction) and fraction > 0.0 and fraction < 1.0;
    when severance_share_equals_applicable_fraction(trust, s);
    then severed_trust_inclusion_ratio(b, 1.0);
}
// (C): a severance may be made at any time. The trustee holds a liberty.
pub relation trustee_severs_trust(trustee: Person, trust: Trust, s: Integer) kind empirical {
    label en unofficial "the trustee divides the trust and creates two or more trusts";
}
pub relation trustee_of_gst_trust(trust: Trust, trustee: Person) kind empirical {
    label en unofficial "the person is a trustee of the trust";
}
@source(IRC_S2642_A, relation = formalizes, coverage = exact, quote = "A severance pursuant to this paragraph may be made at any time.")
rule TrusteeMaySeverTrustAtAnyTimeRule(trust: Trust, trustee: Person) defeasible {
    label en official "a qualified severance may be made at any time; the manner of reporting it is prescribed by the Secretary (section 2642(a)(3)(C)); applicable to severances after December 31, 2000";
    when trustee_of_gst_trust(trust, trustee);
    then liberty TrusteeMaySeverTrust {
        holder trustee;
        against Secretary;
        action trustee_severs_trust(trustee, trust, 1);
        window [@2001-01-01, infinity);
    };
}

// =====================================================================
// §2642(b): valuation and effective date of the allocation
// =====================================================================

pub relation allocation_on_timely_gift_tax_return_or_deemed(x: LifetimeTransfer) kind empirical {
    label en unofficial "the allocation is made on a gift tax return filed on or before the date prescribed by section 6075(b) for the transfer, or is deemed made under section 2632(b)(1) or (c)(1) (section 2642(b)(1))";
}
pub relation transfer_value_finally_determined_chapter12(x: LifetimeTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the transferred property as finally determined for chapter 12 (section 2001(f)(2))";
}
pub relation transfer_date(x: LifetimeTransfer, d: Date) kind empirical {
    label en unofficial "the date of the transfer";
}
pub relation allocation_filed_late_on(x: LifetimeTransfer, d: Date) kind empirical {
    label en unofficial "the allocation to an inter vivos transfer is filed with the Secretary on the stated date, not on a timely filed gift tax return and not deemed made under section 2632(b)(1)";
}
pub relation value_of_property_when_allocation_filed(x: LifetimeTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property at the time the late allocation is filed with the Secretary (section 2642(b)(3)(A))";
}
pub relation allocation_value_2642b(x: LifetimeTransfer, amount: Money) kind institutional {
    label en official "the value of the property for purposes of the applicable fraction: as finally determined for chapter 12 (timely or deemed allocation), or its value when the allocation is filed (late allocation) (section 2642(b)(1)(A), (3)(A)); the section 2642(f) cases are handled below";
}
rule AllocationValueTimelyRule(x: LifetimeTransfer, value: Money) defeasible {
    when allocation_on_timely_gift_tax_return_or_deemed(x);
    when not_known(lifetime_transfer_subject_to_2642f(x));
    when transfer_value_finally_determined_chapter12(x, value);
    then allocation_value_2642b(x, value);
}
rule AllocationValueLateRule(x: LifetimeTransfer, value: Money) defeasible {
    when allocation_filed_late_on(x, _);
    when not_known(allocation_on_timely_gift_tax_return_or_deemed(x));
    when not_known(lifetime_transfer_subject_to_2642f(x));
    when value_of_property_when_allocation_filed(x, value);
    then allocation_value_2642b(x, value);
}
pub relation allocation_effective_from(x: LifetimeTransfer, d: Date) kind institutional {
    label en official "the date from which the allocation is effective: the date of the transfer (timely or deemed allocation) or the date the late allocation is filed with the Secretary (section 2642(b)(1)(B), (3)(B)); after the close of the estate tax inclusion period for section 2642(f) transfers";
}
rule AllocationEffectiveFromTransferRule(x: LifetimeTransfer, d: Date) defeasible {
    when allocation_on_timely_gift_tax_return_or_deemed(x);
    when not_known(lifetime_transfer_subject_to_2642f(x));
    when transfer_date(x, d);
    then allocation_effective_from(x, d);
}
rule AllocationEffectiveFromFilingRule(x: LifetimeTransfer, d: Date) defeasible {
    when allocation_filed_late_on(x, d);
    when not_known(allocation_on_timely_gift_tax_return_or_deemed(x));
    when not_known(lifetime_transfer_subject_to_2642f(x));
    then allocation_effective_from(x, d);
}
// (b)(2): transfers and allocations at death
pub relation gst_transfer_at_death_of_transferor(t: GstTransfer) kind empirical {
    label en unofficial "the property is transferred as a result of the death of the transferor";
}
pub relation value_finally_determined_chapter11(t: GstTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property as finally determined for chapter 11";
}
pub relation post_death_value_change_requirements_met(t: GstTransfer) kind empirical {
    label en unofficial "the requirements prescribed by the Secretary respecting allocation of post-death changes in value are met";
}
pub relation value_at_time_of_distribution(t: GstTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property at the time of the distribution concerned";
}
pub relation allocation_value_at_death_2642b2a(t: GstTransfer, amount: Money) kind institutional {
    label en official "property transferred at death is valued as finally determined for chapter 11, or, if the post-death change-in-value requirements are not met, at the time of the distribution (section 2642(b)(2)(A))";
}
rule AllocationValueAtDeathFinalRule(t: GstTransfer, value: Money) defeasible {
    when gst_transfer_at_death_of_transferor(t);
    when post_death_value_change_requirements_met(t);
    when value_finally_determined_chapter11(t, value);
    then allocation_value_at_death_2642b2a(t, value);
}
rule AllocationValueAtDeathDistributionRule(t: GstTransfer, value: Money) defeasible {
    when gst_transfer_at_death_of_transferor(t);
    when not_known(post_death_value_change_requirements_met(t));
    when value_at_time_of_distribution(t, value);
    then allocation_value_at_death_2642b2a(t, value);
}
pub relation transferor_date_of_death_gst(t: GstTransfer, d: Date) kind empirical {
    label en unofficial "the date of death of the transferor";
}
pub relation allocation_effective_at_death_2642b2b(t: GstTransfer, d: Date) kind institutional {
    label en official "an allocation to property transferred at death is effective on and after the date of death (section 2642(b)(2)(B))";
}
rule AllocationEffectiveAtDeathRule(t: GstTransfer, d: Date) defeasible {
    when gst_transfer_at_death_of_transferor(t);
    when transferor_date_of_death_gst(t, d);
    then allocation_effective_at_death_2642b2b(t, d);
}
// (b)(4): QTIP trusts
pub relation spouse_treated_as_transferor_under_2652a_with_2044_inclusion(t: GstTransfer) kind empirical {
    label en unofficial "the value of the property is included in the estate of a spouse by virtue of section 2044, and the spouse is treated as the transferor of the property under section 2652(a)";
}
pub relation value_in_estate_of_spouse_chapter11(t: GstTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property for purposes of chapter 11 in the estate of the spouse";
}
@source(IRC_S2642_B, relation = formalizes, coverage = exact, quote = "the value of such property for purposes of subsection (a) shall be its value for purposes of chapter 11 in the estate of such spouse")
pub relation allocation_value_qtip_2642b4(t: GstTransfer, amount: Money) kind institutional {
    label en official "QTIP property included in a spouse's estate under section 2044, the spouse being the transferor, is valued as in the spouse's chapter 11 estate (section 2642(b)(4))";
}
rule AllocationValueQtipRule(t: GstTransfer, value: Money) defeasible {
    when spouse_treated_as_transferor_under_2652a_with_2044_inclusion(t);
    when value_in_estate_of_spouse_chapter11(t, value);
    then allocation_value_qtip_2642b4(t, value);
}

// =====================================================================
// §2642(c): direct skips that are nontaxable gifts
// =====================================================================

pub relation direct_skip_nontaxable_gift_by_2503b_or_2503e(t: GstTransfer) kind empirical {
    label en unofficial "the direct skip is a nontaxable gift: a transfer to the extent it is not treated as a taxable gift by reason of section 2503(b) (with section 2513) or section 2503(e) (section 2642(c)(3))";
}
pub relation skip_transfer_in_trust_for_one_individual(t: GstTransfer) kind empirical {
    label en unofficial "the direct skip is a transfer to a trust for the benefit of an individual";
}
pub relation trust_no_distribution_to_others_during_individual_life(t: GstTransfer) kind empirical {
    label en unofficial "during the life of the individual no portion of the corpus or income of the trust may be distributed to, or for the benefit of, any person other than the individual, disregarding discretionary support and Uniform Gifts to Minors Act uses (section 2642(c)(2)(A), by section 2652(c)(3))";
}
pub relation trust_assets_includible_in_individuals_estate(t: GstTransfer) kind empirical {
    label en unofficial "if the trust does not terminate before the individual dies, its assets will be includible in the gross estate of the individual (section 2642(c)(2)(B))";
}
relation nontaxable_gift_trust_conditions_met(t: GstTransfer) kind institutional;
rule NontaxableGiftTrustConditionsMetRule(t: GstTransfer) defeasible {
    when trust_no_distribution_to_others_during_individual_life(t);
    when trust_assets_includible_in_individuals_estate(t);
    then nontaxable_gift_trust_conditions_met(t);
}
@source(IRC_S2642_C, relation = formalizes, coverage = exact, quote = "In the case of a direct skip which is a nontaxable gift, the inclusion ratio shall be zero.")
rule GstInclusionRatioNontaxableGiftOutrightRule(t: GstTransfer) defeasible {
    label en official "the inclusion ratio of a direct skip that is a nontaxable gift is zero (section 2642(c)(1))";
    when gst_transfer_kind(t, DirectSkip);
    when direct_skip_nontaxable_gift_by_2503b_or_2503e(t);
    when not_known(skip_transfer_in_trust_for_one_individual(t));
    then gst_inclusion_ratio(t, 0.0);
}
rule GstInclusionRatioNontaxableGiftTrustRule(t: GstTransfer) defeasible {
    label en official "a transfer to a trust for one individual gets the zero inclusion ratio only if the trust meets (A) and (B) (section 2642(c)(2))";
    when gst_transfer_kind(t, DirectSkip);
    when direct_skip_nontaxable_gift_by_2503b_or_2503e(t);
    when skip_transfer_in_trust_for_one_individual(t);
    when nontaxable_gift_trust_conditions_met(t);
    then gst_inclusion_ratio(t, 0.0);
}

// =====================================================================
// §2642(d): recomputation on another transfer to an existing trust
// =====================================================================

pub relation transfer_to_existing_trust(t: GstTransfer, trust: Trust) kind empirical {
    label en unofficial "the transfer is made to a trust in existence before the transfer (section 2642(d)(1))";
}
pub relation exemption_allocated_to_property_in_transfer(t: GstTransfer, amount: Money) kind empirical {
    label en unofficial "the amount of GST exemption allocated to the property involved in the transfer (section 2642(d)(2)(A)(i))";
}
pub relation value_of_all_trust_property_immediately_before_transfer(t: GstTransfer, amount: Money) kind empirical {
    label en unofficial "the value of all the property in the trust immediately before the transfer (section 2642(d)(2)(B)(ii), (3)(A))";
}
pub relation applicable_fraction_in_effect_before_transfer(t: GstTransfer, fraction: Decimal) kind empirical {
    label en unofficial "the applicable fraction in effect for the trust immediately before the transfer (section 2642(d)(3)(B))";
}
pub relation value_of_property_in_transfer(t: GstTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property involved in the transfer (section 2642(d)(2)(B)(i))";
}
pub relation recoveries_and_charitable_deduction_on_transfer(t: GstTransfer, amount: Money) kind empirical {
    label en unofficial "any Federal estate tax or State death tax actually recovered from the trust attributable to the property, plus any charitable deduction allowed under section 2055 or 2522 with respect to it (section 2642(d)(2)(B)(i)(I)-(II))";
}
pub relation late_allocation_with_previous_allocation(t: GstTransfer) kind empirical {
    label en unofficial "the allocation of GST exemption to the property is not made on a timely filed gift tax return required by section 6019, and there was a previous allocation with respect to property transferred to the trust (section 2642(d)(4))";
}
pub relation nontax_portion_of_trust(t: GstTransfer, amount: Money) kind institutional {
    label en official "the nontax portion: the value of all the trust property times the applicable fraction in effect (section 2642(d)(3))";
}
rule NontaxPortionOfTrustRule(t: GstTransfer, total: Money, fraction: Decimal) defeasible {
    when value_of_all_trust_property_immediately_before_transfer(t, total);
    when applicable_fraction_in_effect_before_transfer(t, fraction);
    then nontax_portion_of_trust(t, round(total * fraction, 2, "HALF_UP"));
}
@source(IRC_S2642_D, relation = formalizes, coverage = exact, quote = "the applicable fraction for such trust shall be recomputed as of the time of such transfer in the manner provided in paragraph (2)")
pub relation recomputed_applicable_fraction_2642d(t: GstTransfer, fraction: Decimal) kind institutional {
    label en official "the recomputed applicable fraction: (exemption allocated to the transfer plus the nontax portion) over (value of the transfer, net of recoveries and charitable deductions, plus the value of all trust property before the transfer) (section 2642(d)(2)); one step, the chain over successive transfers is TECH-GAPS G3615";
}
rule RecomputedApplicableFraction2642dRule(t: GstTransfer, allocated: Money, nontax: Money, value: Money, reductions: Money, before: Money) defeasible {
    when transfer_to_existing_trust(t, _);
    when exemption_allocated_to_property_in_transfer(t, allocated);
    when nontax_portion_of_trust(t, nontax);
    when value_of_property_in_transfer(t, value);
    when recoveries_and_charitable_deduction_on_transfer(t, reductions);
    when value_of_all_trust_property_immediately_before_transfer(t, before);
    then recomputed_applicable_fraction_2642d(t, (allocated + nontax) / ((value - reductions) + before));
}
rule RecomputedApplicableFraction2642dNoReductionsRule(t: GstTransfer, allocated: Money, nontax: Money, value: Money, before: Money) defeasible {
    when transfer_to_existing_trust(t, _);
    when exemption_allocated_to_property_in_transfer(t, allocated);
    when nontax_portion_of_trust(t, nontax);
    when value_of_property_in_transfer(t, value);
    when not_known(has_recoveries_and_charitable_deduction_on_transfer(t));
    when value_of_all_trust_property_immediately_before_transfer(t, before);
    then recomputed_applicable_fraction_2642d(t, (allocated + nontax) / (value + before));
}
relation has_recoveries_and_charitable_deduction_on_transfer(t: GstTransfer) kind institutional;
rule HasRecoveriesAndCharitableDeductionOnTransferRule(t: GstTransfer) defeasible {
    when recoveries_and_charitable_deduction_on_transfer(t, _);
    then has_recoveries_and_charitable_deduction_on_transfer(t);
}
rule RecomputedApplicableFractionIsTheFractionRule(t: GstTransfer, fraction: Decimal) defeasible {
    label en official "the recomputed fraction is the applicable fraction of the trust for the transfer (section 2642(d)(1), (4))";
    when recomputed_applicable_fraction_2642d(t, fraction);
    then gst_applicable_fraction(t, fraction);
}

// =====================================================================
// §2642(e): charitable lead annuity trusts
// =====================================================================

pub relation trust_is_charitable_lead_annuity_trust(trust: Trust) kind empirical {
    label en unofficial "the trust is one in which there is a charitable lead annuity: an interest in the form of a guaranteed annuity with respect to which a deduction was allowed under section 2055 or 2522 (section 2642(e)(3))";
}
pub relation clat_interest_factor(trust: Trust, factor: Decimal) kind empirical {
    label en unofficial "the factor (1 + r)^n for interest at the rate r used to determine the section 2055 or 2522 deduction, over the actual period n of the charitable lead annuity; case-asserted because `pow` takes integers only (TECH-GAPS G3614)";
}
pub relation value_of_clat_property_after_termination(trust: Trust, amount: Money) kind empirical {
    label en unofficial "the value of all the property in the trust immediately after the termination of the charitable lead annuity";
}
pub relation clat_gst_exemption_allocated(trust: Trust, amount: Money) kind empirical {
    label en unofficial "the GST exemption allocated to the charitable lead annuity trust";
}
@source(IRC_S2642_E, relation = formalizes, coverage = exact, quote = "the adjusted GST exemption is an amount equal to the GST exemption allocated to the trust increased by interest determined")
pub relation adjusted_gst_exemption_2642e2(trust: Trust, amount: Money) kind institutional {
    label en official "the GST exemption allocated to the trust, increased by interest at the deduction rate for the actual period of the annuity (section 2642(e)(2))";
}
rule AdjustedGstExemption2642e2Rule(trust: Trust, allocated: Money, factor: Decimal) defeasible {
    when trust_is_charitable_lead_annuity_trust(trust);
    when clat_gst_exemption_allocated(trust, allocated);
    when clat_interest_factor(trust, factor);
    then adjusted_gst_exemption_2642e2(trust, round(allocated * factor, 2, "HALF_UP"));
}
@source(IRC_S2642_E, relation = formalizes, coverage = exact, quote = "the applicable fraction shall be a fraction")
pub relation clat_applicable_fraction_2642e1(trust: Trust, fraction: Decimal) kind institutional {
    label en official "for a charitable lead annuity trust the applicable fraction is the adjusted GST exemption over the value of all trust property immediately after the annuity ends (section 2642(e)(1))";
}
rule ClatApplicableFraction2642e1Rule(trust: Trust, adjusted: Money, value: Money) defeasible {
    when adjusted_gst_exemption_2642e2(trust, adjusted);
    when value_of_clat_property_after_termination(trust, value) and value > 0.00 USD;
    then clat_applicable_fraction_2642e1(trust, adjusted / value);
}
rule GstApplicableFractionClatRule(t: GstTransfer, trust: Trust, fraction: Decimal) defeasible {
    when gst_transfer_trust(t, trust);
    when clat_applicable_fraction_2642e1(trust, fraction);
    then gst_applicable_fraction(t, fraction);
}

// =====================================================================
// §2642(f): the estate tax inclusion period
// =====================================================================

pub relation etip_inclusion_ceased_on(x: LifetimeTransfer, d: Date) kind empirical {
    label en unofficial "the date on which the property would no longer be includible in the transferor's gross estate if the transferor died";
}
pub relation etip_gst_occurs_on(x: LifetimeTransfer, d: Date) kind empirical {
    label en unofficial "the date on which there is a generation-skipping transfer with respect to the property";
}
pub relation etip_transferor_death_date(x: LifetimeTransfer, d: Date) kind empirical {
    label en unofficial "the date of the death of the transferor";
}
pub relation etip_spouse_treated_as_transferor(x: LifetimeTransfer) kind empirical {
    label en unofficial "except as provided in regulations, a reference to an individual or transferor includes the spouse of the individual or transferor (section 2642(f)(4)); the includibility test is read in the spouse's estate";
}
relation etip_end_candidate(x: LifetimeTransfer, d: Date) kind institutional;
rule EtipEndCandidateCeasedRule(x: LifetimeTransfer, d: Date) defeasible {
    when lifetime_transfer_subject_to_2642f(x);
    when etip_inclusion_ceased_on(x, d);
    then etip_end_candidate(x, d);
}
rule EtipEndCandidateGstRule(x: LifetimeTransfer, d: Date) defeasible {
    when lifetime_transfer_subject_to_2642f(x);
    when etip_gst_occurs_on(x, d);
    then etip_end_candidate(x, d);
}
rule EtipEndCandidateDeathRule(x: LifetimeTransfer, d: Date) defeasible {
    when lifetime_transfer_subject_to_2642f(x);
    when etip_transferor_death_date(x, d);
    then etip_end_candidate(x, d);
}
relation earlier_etip_end_candidate_exists(x: LifetimeTransfer, d: Date) kind institutional;
rule EarlierEtipEndCandidateExistsRule(x: LifetimeTransfer, d: Date, d2: Date) defeasible {
    when etip_end_candidate(x, d);
    when etip_end_candidate(x, d2) and d2 < d;
    then earlier_etip_end_candidate_exists(x, d);
}
@source(IRC_S2642_F, relation = formalizes, coverage = exact, quote = "Such period shall in no event extend beyond the earlier of")
pub relation etip_closes_on_2642f3(x: LifetimeTransfer, d: Date) kind institutional {
    label en official "the estate tax inclusion period closes when the property would no longer be includible, or, at the latest, at the earlier of the date of a generation-skipping transfer and the date of the transferor's death (section 2642(f)(3))";
}
rule EtipClosesOn2642f3Rule(x: LifetimeTransfer, d: Date) defeasible {
    when etip_end_candidate(x, d);
    unless earlier_etip_end_candidate_exists(x, d);
    then etip_closes_on_2642f3(x, d);
}
pub relation allocation_attempted_on(x: LifetimeTransfer, d: Date) kind empirical {
    label en unofficial "the individual attempts to allocate GST exemption to the property on the stated date";
}
@source(IRC_S2642_F, relation = formalizes, coverage = exact, quote = "any allocation of GST exemption to such property shall not be made before the close of the estate tax inclusion period")
pub relation allocation_premature_2642f1(x: LifetimeTransfer) kind institutional {
    label en official "an allocation to section 2642(f) property made before the close of the estate tax inclusion period is not permitted (section 2642(f)(1))";
}
rule AllocationPrematureRule(x: LifetimeTransfer, attempted: Date, closed: Date) defeasible {
    when lifetime_transfer_subject_to_2642f(x);
    when allocation_attempted_on(x, attempted);
    when etip_closes_on_2642f3(x, closed) and attempted < closed;
    then allocation_premature_2642f1(x);
}
pub relation transfer_includible_in_gross_estate_of_transferor_ch11(x: LifetimeTransfer) kind empirical {
    label en unofficial "the property is includible in the gross estate of the transferor, other than by reason of section 2035 (section 2642(f)(2)(A))";
}
pub relation value_for_chapter_11(x: LifetimeTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property for purposes of chapter 11";
}
pub relation value_at_etip_close(x: LifetimeTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property as of the close of the estate tax inclusion period";
}
pub relation etip_allocation_timely_return_for_close_year(x: LifetimeTransfer) kind empirical {
    label en unofficial "the allocation is made on a timely filed gift tax return for the calendar year in which the period ends";
}
pub relation etip_allocation_filed_value(x: LifetimeTransfer, amount: Money) kind empirical {
    label en unofficial "the value of the property as of the time the allocation is filed with the Secretary";
}
@source(IRC_S2642_F, relation = formalizes, coverage = exact, quote = "In the case of any property to which paragraph (1) applies, the value of such property shall be")
pub relation allocation_value_etip_2642f2(x: LifetimeTransfer, amount: Money) kind institutional {
    label en official "section 2642(f) property is valued as in chapter 11 if includible in the transferor's gross estate other than by section 2035, otherwise at the close of the period, or at filing if the allocation is not on a timely return (section 2642(f)(2))";
}
rule AllocationValueEtipIncludibleRule(x: LifetimeTransfer, value: Money) defeasible {
    when lifetime_transfer_subject_to_2642f(x);
    when transfer_includible_in_gross_estate_of_transferor_ch11(x);
    when value_for_chapter_11(x, value);
    then allocation_value_etip_2642f2(x, value);
}
rule AllocationValueEtipCloseRule(x: LifetimeTransfer, value: Money) defeasible {
    when lifetime_transfer_subject_to_2642f(x);
    when not_known(transfer_includible_in_gross_estate_of_transferor_ch11(x));
    when etip_allocation_timely_return_for_close_year(x);
    when value_at_etip_close(x, value);
    then allocation_value_etip_2642f2(x, value);
}
rule AllocationValueEtipLateRule(x: LifetimeTransfer, value: Money) defeasible {
    when lifetime_transfer_subject_to_2642f(x);
    when not_known(transfer_includible_in_gross_estate_of_transferor_ch11(x));
    when not_known(etip_allocation_timely_return_for_close_year(x));
    when etip_allocation_filed_value(x, value);
    then allocation_value_etip_2642f2(x, value);
}
pub relation direct_skip_treated_as_occurring_at_etip_close(x: LifetimeTransfer, d: Date) kind institutional {
    label en official "a direct skip subject to section 2642(f) is treated as occurring as of the close of the estate tax inclusion period (section 2642(f)(1))";
}
rule DirectSkipTreatedAsOccurringAtEtipCloseRule(x: LifetimeTransfer, d: Date) defeasible {
    when lifetime_transfer_subject_to_2642f(x);
    when lifetime_transfer_is_direct_skip(x);
    when etip_closes_on_2642f3(x, d);
    then direct_skip_treated_as_occurring_at_etip_close(x, d);
}
