// §2010(c)(4) DSUE for a CHAIN of predeceased spouses (stage 4).
//
// STRATIFIED TIERS (TECH-GAPS.md G85 closed for up to two predeceased
// spouses; three or more remain an explicit boundary). Generation 1 is the
// first deceased spouse (who held no DSUE); generation 2 is the survivor of
// generation 1, remarried and deceased holding generation 1's final DSUE.
// Generation 2 reads generation 1's FINAL amount through an explicit history
// link — distinct predicates, acyclic, no unstratifiable recursion. The
// single-spouse rule in 02-unified-credit.law is untouched.
//
// Four figures are distinguished per generation: preliminary (as filed),
// recalculated (after examination of an adjusted base), final (recalculated
// when an examination fact exists, else preliminary), and available (the
// final of the last deceased spouse, carried to the survivor by link).

use self::{
    Estate,
    IRC_S2010_C,
    date_of_death,
    deceased_spousal_unused_exclusion_amount,
    dsue_return_filed,
    dsue_return_timely,
    portability_elected,
    tentative_tax_base,
};

pub relation basic_exclusion_amount_at_death(d: Estate, amount: Money) kind empirical {
    label en unofficial "the basic exclusion amount for the calendar year of the decedent's death, read by the case from the pinned basic-exclusion-amount.lawparam.json year row (2025: $13,990,000 per Rev. Proc. 2024-40 section 2.41; 2026: $15,000,000 per Pub. L. 119-21 section 70106): a chain spans years but a case has one legal_time, so the death-year figure is a cited case fact, never the current-year parameter";
}

// --- Generation 1: first deceased spouse -----------------------------------

@source(IRC_S2010_C, relation = formalizes, coverage = partial, quote = "the lesser of")
pub relation dsue_gen1_admitted_base(d1: Estate, base: Money) kind institutional {
    label en official "the generation-1 tentative base admitted by the section 2010(c)(5)(A) election conditions restated as case facts (filed, elected, timely: a defeasible premise on the power-created validity does not evaluate, and a strict gate cannot read the defeasible tentative base, so the gate mirrors the power's exercise/valid_when conditions; the power itself remains the normative record; the section 2010(c)(4) arithmetic sits in a separate rule)";
}
rule DsueGen1AdmittedBaseRule(d1: Estate, base: Money) defeasible {
    when dsue_return_filed(d1);
    when portability_elected(d1);
    when dsue_return_timely(d1);
    when tentative_tax_base(d1, base);
    then dsue_gen1_admitted_base(d1, base);
}
@source(IRC_S2010_C, relation = formalizes, coverage = partial, quote = "the lesser of")
pub relation dsue_gen1_preliminary(d1: Estate, amount: Money) kind institutional {
    label en official "generation-1 DSUE as filed: the admitted-base figure, only with a valid portability election";
}
rule DsueGen1PreliminaryRule(d1: Estate, base: Money, excl: Money) defeasible {
    when dsue_gen1_admitted_base(d1, base);
    when basic_exclusion_amount_at_death(d1, excl);
    then dsue_gen1_preliminary(d1, max(0.00 USD, excl - base));
}
pub relation dsue_gen1_examination_base(d1: Estate, amount: Money) kind empirical {
    label en unofficial "the first deceased spouse's tentative tax base as finally determined on examination under section 2010(c)(5)(B) (authority outcome, not a model computation)";
}
@source(IRC_S2010_C, relation = formalizes, coverage = partial, quote = "the lesser of")
pub relation dsue_gen1_recalculated(d1: Estate, amount: Money) kind institutional {
    label en official "generation-1 DSUE recalculated on the examination base (election-gated by the final rules, not here)";
}
rule DsueGen1RecalculatedRule(d1: Estate, base: Money, excl: Money) defeasible {
    when dsue_gen1_examination_base(d1, base);
    when basic_exclusion_amount_at_death(d1, excl);
    then dsue_gen1_recalculated(d1, max(0.00 USD, excl - base));
}
relation has_gen1_recalculation(d1: Estate) kind institutional;
rule HasGen1RecalculationRule(d1: Estate) defeasible {
    when dsue_gen1_recalculated(d1, _);
    then has_gen1_recalculation(d1);
}
@source(IRC_S2010_C, relation = formalizes, coverage = partial, quote = "the lesser of")
pub relation dsue_gen1_admitted_exam_base(d1: Estate, base: Money) kind institutional {
    label en official "the generation-1 examination base admitted by the restated section 2010(c)(5)(A) conditions (same mirror as the preliminary gate)";
}
rule DsueGen1AdmittedExamBaseRule(d1: Estate, base: Money) defeasible {
    when dsue_return_filed(d1);
    when portability_elected(d1);
    when dsue_return_timely(d1);
    when dsue_gen1_examination_base(d1, base);
    then dsue_gen1_admitted_exam_base(d1, base);
}
pub relation dsue_gen1_final(d1: Estate, amount: Money) kind institutional {
    label en official "generation-1 final DSUE: recalculated after examination, else preliminary";
}
rule DsueGen1FinalRecalculatedRule(d1: Estate, base: Money, excl: Money) defeasible {
    when dsue_gen1_admitted_exam_base(d1, base);
    when basic_exclusion_amount_at_death(d1, excl);
    then dsue_gen1_final(d1, max(0.00 USD, excl - base));
}
rule DsueGen1FinalPreliminaryRule(d1: Estate, amount: Money) defeasible {
    when dsue_gen1_preliminary(d1, amount);
    when not_known(has_gen1_recalculation(d1));
    then dsue_gen1_final(d1, amount);
}
// --- Carry: the second decedent held generation 1's final DSUE -------------

pub relation prior_dsue_link(d2: Estate, d1: Estate) kind empirical {
    label en unofficial "the decedent of d2 (survivor of the first deceased spouse, remarried) held generation 1's DSUE from d1 — the explicit history link; the FIGURE travels by computation, never by assertion";
}
pub relation dsue_gen1_available_to(d2: Estate, amount: Money) kind institutional {
    label en official "generation-1 final DSUE available to the second decedent, carried by history link";
}
rule DsueGen1AvailableToRule(d2: Estate, d1: Estate, amount: Money) defeasible {
    when prior_dsue_link(d2, d1);
    when dsue_gen1_final(d1, amount);
    then dsue_gen1_available_to(d2, amount);
}

// --- Generation 2: last deceased spouse ------------------------------------

@source(IRC_S2010_C, relation = formalizes, coverage = partial, quote = "the lesser of")
pub relation dsue_gen2_admitted_inputs(d2: Estate, base: Money, held: Money) kind institutional {
    label en official "the generation-2 tentative base and held generation-1 DSUE admitted by the section 2010(c)(5)(A) election conditions restated as case facts (filed, elected, timely: a defeasible premise on the power-created validity does not evaluate and a strict gate cannot read the defeasible held-DSUE carry, so the gate mirrors the power's exercise/valid_when conditions; the power itself remains the normative record; the section 2010(c)(4)(B) arithmetic sits in the guarded rules below)";
}
rule DsueGen2AdmittedInputsRule(d2: Estate, base: Money, held: Money) defeasible {
    when dsue_return_filed(d2);
    when portability_elected(d2);
    when dsue_return_timely(d2);
    when tentative_tax_base(d2, base);
    when dsue_gen1_available_to(d2, held);
    then dsue_gen2_admitted_inputs(d2, base, held);
}
@source(IRC_S2010_C, relation = formalizes, coverage = partial, quote = "the lesser of")
pub relation dsue_gen2_preliminary(d2: Estate, amount: Money) kind institutional {
    label en official "generation-2 DSUE as filed: with d = base minus held, the lesser of basic or basic - d, floored at zero — split in two guarded rules because max around min does not evaluate; inputs already election-gated";
}
rule DsueGen2PreliminaryNonnegativeRule(d2: Estate, base: Money, held: Money, excl: Money) defeasible {
    when dsue_gen2_admitted_inputs(d2, base, held);
    when basic_exclusion_amount_at_death(d2, excl);
    when base - held >= 0.00 USD;
    then dsue_gen2_preliminary(d2, max(0.00 USD, excl - (base - held)));
}
rule DsueGen2PreliminaryCappedRule(d2: Estate, base: Money, held: Money, excl: Money) defeasible {
    when dsue_gen2_admitted_inputs(d2, base, held);
    when basic_exclusion_amount_at_death(d2, excl);
    when base - held < 0.00 USD;
    then dsue_gen2_preliminary(d2, excl);
}

pub relation dsue_gen2_examination_base(d2: Estate, amount: Money) kind empirical {
    label en unofficial "the last deceased spouse's tentative tax base as finally determined on examination (authority outcome)";
}
@source(IRC_S2010_C, relation = formalizes, coverage = partial, quote = "the lesser of")
pub relation dsue_gen2_recalculated(d2: Estate, amount: Money) kind institutional {
    label en official "generation-2 DSUE recalculated on the examination base";
}
pub relation dsue_gen2_admitted_exam_inputs(d2: Estate, base: Money, held: Money) kind institutional {
    label en official "the generation-2 examination base and held generation-1 DSUE admitted by the restated section 2010(c)(5)(A) conditions (same mirror as the preliminary inputs)";
}
rule DsueGen2AdmittedExamInputsRule(d2: Estate, base: Money, held: Money) defeasible {
    when dsue_return_filed(d2);
    when portability_elected(d2);
    when dsue_return_timely(d2);
    when dsue_gen2_examination_base(d2, base);
    when dsue_gen1_available_to(d2, held);
    then dsue_gen2_admitted_exam_inputs(d2, base, held);
}
rule DsueGen2RecalculatedNonnegativeRule(d2: Estate, base: Money, held: Money, excl: Money) defeasible {
    when dsue_gen2_admitted_exam_inputs(d2, base, held);
    when basic_exclusion_amount_at_death(d2, excl);
    when base - held >= 0.00 USD;
    then dsue_gen2_recalculated(d2, max(0.00 USD, excl - (base - held)));
}
rule DsueGen2RecalculatedCappedRule(d2: Estate, base: Money, held: Money, excl: Money) defeasible {
    when dsue_gen2_admitted_exam_inputs(d2, base, held);
    when basic_exclusion_amount_at_death(d2, excl);
    when base - held < 0.00 USD;
    then dsue_gen2_recalculated(d2, excl);
}

relation has_gen2_recalculation(d2: Estate) kind institutional;
rule HasGen2RecalculationRule(d2: Estate) defeasible {
    when dsue_gen2_recalculated(d2, _);
    then has_gen2_recalculation(d2);
}
pub relation dsue_gen2_final(d2: Estate, amount: Money) kind institutional {
    label en official "generation-2 final DSUE: recalculated after examination, else preliminary";
}
rule DsueGen2FinalRecalculatedRule(d2: Estate, amount: Money) defeasible {
    when dsue_gen2_recalculated(d2, amount);
    then dsue_gen2_final(d2, amount);
}
rule DsueGen2FinalPreliminaryRule(d2: Estate, amount: Money) defeasible {
    when dsue_gen2_preliminary(d2, amount);
    when not_known(has_gen2_recalculation(d2));
    then dsue_gen2_final(d2, amount);
}

// --- Available to the surviving estate + bridge into the credit chain ------

pub relation last_deceased_is_gen1(surviving_estate: Estate, d1: Estate) kind empirical {
    label en unofficial "the history determines the first deceased spouse as the last deceased spouse (one predeceased spouse)";
}
pub relation last_deceased_is_gen2(surviving_estate: Estate, d2: Estate) kind empirical {
    label en unofficial "the history determines the second deceased spouse as the last deceased spouse (two predeceased spouses)";
}
pub relation dsue_available_to_survivor(surviving_estate: Estate, amount: Money) kind institutional {
    label en official "the DSUE available to the surviving estate: the final of the last deceased spouse (section 2010(c)(4)(B)(i))";
}
rule DsueAvailableGen1Rule(surviving_estate: Estate, d1: Estate, amount: Money) defeasible {
    when last_deceased_is_gen1(surviving_estate, d1);
    when dsue_gen1_final(d1, amount);
    then dsue_available_to_survivor(surviving_estate, amount);
}
rule DsueAvailableGen2Rule(surviving_estate: Estate, d2: Estate, amount: Money) defeasible {
    when last_deceased_is_gen2(surviving_estate, d2);
    when dsue_gen2_final(d2, amount);
    then dsue_available_to_survivor(surviving_estate, amount);
}
rule DsueAvailableBridgesToCreditChain(surviving_estate: Estate, amount: Money) defeasible {
    when dsue_available_to_survivor(surviving_estate, amount);
    then deceased_spousal_unused_exclusion_amount(surviving_estate, amount);
}

// --- Death-date order validation (temporal events) --------------------------

pub relation spouse_death_order_ok(d1: Estate, d2: Estate) kind institutional {
    label en official "the first deceased spouse died before the second — the chain order validated from death dates, not assumed from the link";
}
rule SpouseDeathOrderOkRule(d1: Estate, d2: Estate, earlier: Date, later: Date) defeasible {
    when date_of_death(d1, earlier);
    when date_of_death(d2, later);
    when earlier < later;
    then spouse_death_order_ok(d1, d2);
}
