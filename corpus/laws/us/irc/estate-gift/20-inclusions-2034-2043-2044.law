// 26 U.S.C. §2034 (dower or curtesy), §2043 (transfers for insufficient
// consideration), §2044 (certain property for which a marital deduction was
// previously allowed), §2045 (prior interests), §2046 (disclaimers, pointer) and
// §2051 (the taxable estate). Stage 2 (DECISION-0379 with deontics) of
// `us.irc.estate_gift` (B01/IRC-11). Extends `gross_estate_item` (declared once
// in 03-gross-estate-inclusions.law) with more producing rules.
//
// §2043 CHANGES THE AMOUNT of an inclusion rather than adding one: the sections
// 2035-2038 and 2041 include the full value, §2043(a) includes only the excess
// over the consideration received. The five producing rules therefore carry
// `not_known(partial_consideration_2043(e, item))` (03 and 15), and the rule
// here produces the reduced amount. `gross_estate` sums over (item, amount), so
// two amounts for one item would be added: the guard is what keeps one.
//
// JUDGMENT CALLS
//  - The value of the dower or curtesy interest and the consideration received
//    are appraised facts of the case (DECISION-0194: fair market value is the
//    case's, not derived here).
//  - §2045 ("whenever made") has no executable content beyond the absence of a
//    transfer-date guard in the sections 2034-2042 rules; scenario S2045-01
//    asserts that a transfer from 1935 is included. §2046 is a pointer to §2518.

language "law.core" version "0.2";
package us.irc.estate_gift version "0.1.1";
namespace "urn:us:irc:estate_gift:clir";

use self::{
    Asset,
    Estate,
    IRC_S2034,
    IRC_S2043_A,
    IRC_S2043_B,
    IRC_S2044_A,
    IRC_S2044_B,
    IRC_S2044_C,
    Individual,
    Person,
    alternate_valuation_elected,
    beneficiary_general_power_exercisable_before_death_2037,
    bona_fide_sale_for_full_consideration,
    decedent_individual,
    general_power_2041_candidate,
    gross_estate_item,
    interest_passes_from_decedent,
    possession_obtainable_only_by_surviving_decedent,
    power_to_alter_amend_revoke_or_terminate_at_death,
    qualifying_income_interest_disposition_is_transfer,
    retained_possession_enjoyment_or_income,
    retained_right_to_designate_possessors,
    reversionary_interest_exceeds_5_percent,
    section_2044_property_recipient,
    such_power_relinquished_within_3_years,
    transferred_or_power_relinquished_within_3_years,
    value_at_death,
    would_be_included_under_2036_2037_2038_2042,
};

// --- §2034 ------------------------------------------------------------------

pub relation dower_or_curtesy_interest_value(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the value of the property to the extent of the interest of the surviving spouse, existing at the time of the decedent's death as dower or curtesy, or by virtue of a statute creating an estate in lieu of dower or curtesy (section 2034)";
}
@source(IRC_S2034, relation = formalizes, coverage = exact, quote = "The value of the gross estate shall include the value of all property to the extent of any interest therein of the surviving spouse, existing at the time of the decedent's death as dower or curtesy, or by virtue of a statute creating an estate in lieu of dower or curtesy.")
rule GrossEstateItemUnder2034Rule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "the gross estate includes the value of property to the extent of the surviving spouse's dower or curtesy interest at the decedent's death (section 2034)";
    when dower_or_curtesy_interest_value(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, amount);
}

// --- §2043 ------------------------------------------------------------------

pub relation consideration_received_by_decedent(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the value of the consideration in money or money's worth received by the decedent for the transfer, trust, interest, right or power (section 2043(a))";
}
pub relation marital_rights_relinquishment_value(e: Estate, item: Asset, amount: Money) kind empirical {
    label en unofficial "the part of the consideration that is a relinquishment or promised relinquishment of dower or curtesy, of a statutory estate in lieu of it, or of other marital rights in the decedent's property or estate (section 2043(b)(1))";
}
@source(IRC_S2043_B, relation = formalizes, coverage = exact, quote = "a relinquishment or promised relinquishment of dower or curtesy, or of a statutory estate created in lieu of dower or curtesy, or of other marital rights in the decedent's property or estate, shall not be considered to any extent a consideration \"in money or money's worth\"")
pub relation recognized_consideration_2043(e: Estate, item: Asset, amount: Money) kind institutional {
    label en official "the consideration that counts under section 2043(a): the consideration received, less any relinquishment of marital rights (section 2043(b)(1))";
}
rule RecognizedConsideration2043Rule(e: Estate, item: Asset, received: Money) defeasible {
    when consideration_received_by_decedent(e, item, received);
    then recognized_consideration_2043(e, item, max(0.00 USD, received - sum(collect all m: Money where marital_rights_relinquishment_value(e, item, m), empty: 0.00 USD)));
}
relation partial_consideration_2043(e: Estate, item: Asset) kind institutional {
    label en unofficial "the transfer was made for a consideration in money or money's worth but was not a bona fide sale for an adequate and full consideration (section 2043(a))";
}
rule PartialConsideration2043Rule(e: Estate, item: Asset, c: Money) defeasible {
    when recognized_consideration_2043(e, item, c) and c > 0.00 USD;
    when not_known(bona_fide_sale_for_full_consideration(e, item));
    then partial_consideration_2043(e, item);
}
// "the property otherwise to be included on account of such transaction": one
// rule per enumerated section, restating that section's own conditions.
relation otherwise_includible_under_2035_to_2038_or_2041(e: Estate, item: Asset) kind institutional;
rule OtherwiseIncludibleUnder2035Rule(e: Estate, item: Asset) defeasible {
    when transferred_or_power_relinquished_within_3_years(e, item);
    when would_be_included_under_2036_2037_2038_2042(e, item);
    then otherwise_includible_under_2035_to_2038_or_2041(e, item);
}
rule OtherwiseIncludibleUnder2036Rule(e: Estate, item: Asset) defeasible {
    when retained_possession_enjoyment_or_income(e, item);
    then otherwise_includible_under_2035_to_2038_or_2041(e, item);
}
rule OtherwiseIncludibleUnder2036DesignateRule(e: Estate, item: Asset) defeasible {
    when retained_right_to_designate_possessors(e, item);
    then otherwise_includible_under_2035_to_2038_or_2041(e, item);
}
rule OtherwiseIncludibleUnder2037Rule(e: Estate, item: Asset) defeasible {
    when possession_obtainable_only_by_surviving_decedent(e, item);
    when reversionary_interest_exceeds_5_percent(e, item);
    when not_known(beneficiary_general_power_exercisable_before_death_2037(e, item));
    then otherwise_includible_under_2035_to_2038_or_2041(e, item);
}
rule OtherwiseIncludibleUnder2038Rule(e: Estate, item: Asset) defeasible {
    when power_to_alter_amend_revoke_or_terminate_at_death(e, item);
    then otherwise_includible_under_2035_to_2038_or_2041(e, item);
}
rule OtherwiseIncludibleUnder2038RelinquishedRule(e: Estate, item: Asset) defeasible {
    when such_power_relinquished_within_3_years(e, item);
    then otherwise_includible_under_2035_to_2038_or_2041(e, item);
}
rule OtherwiseIncludibleUnder2041Rule(e: Estate, item: Asset) defeasible {
    when general_power_2041_candidate(e, item);
    then otherwise_includible_under_2035_to_2038_or_2041(e, item);
}
@source(IRC_S2043_A, relation = formalizes, coverage = exact, quote = "there shall be included in the gross estate only the excess of the fair market value at the time of death of the property otherwise to be included on account of such transaction, over the value of the consideration received therefor by the decedent")
rule GrossEstateItemNetOfConsideration2043Rule(e: Estate, item: Asset, value: Money, c: Money) defeasible {
    label en official "where a section 2035-2038 or 2041 transfer was made for consideration but not in a bona fide sale for adequate and full consideration, only the excess of the value at death over the consideration received is included (section 2043(a))";
    when otherwise_includible_under_2035_to_2038_or_2041(e, item);
    when partial_consideration_2043(e, item);
    when value_at_death(e, item, value);
    when recognized_consideration_2043(e, item, c);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, max(0.00 USD, value - c));
}

// --- §2044 ------------------------------------------------------------------

pub relation decedent_qualifying_income_interest_for_life(e: Estate, item: Asset) kind empirical {
    label en unofficial "the decedent had a qualifying income interest for life in the property (section 2044(a))";
}
pub relation qtip_deduction_allowed_2056b7_for_transfer_to_decedent(e: Estate, item: Asset) kind empirical {
    label en unofficial "a deduction was allowed with respect to the transfer of the property to the decedent under section 2056 by reason of subsection (b)(7) thereof (section 2044(b)(1)(A))";
}
pub relation qtip_deduction_allowed_2523f_for_transfer_to_decedent(e: Estate, item: Asset) kind empirical {
    label en unofficial "a deduction was allowed with respect to the transfer of the property to the decedent under section 2523 by reason of subsection (f) thereof (section 2044(b)(1)(B))";
}
relation section_2519_applied_to_decedent_disposition(e: Estate, item: Asset) kind institutional;
rule Section2519AppliedToDecedentDispositionRule(e: Estate, item: Asset, p: Individual) defeasible {
    when decedent_individual(e, p);
    when qualifying_income_interest_disposition_is_transfer(p, item, _, _);
    then section_2519_applied_to_decedent_disposition(e, item);
}
@source(IRC_S2044_B, relation = formalizes, coverage = exact, quote = "This section applies to any property if")
pub relation section_2044_applies_to_property(e: Estate, item: Asset) kind institutional {
    label en official "section 2044 applies to the property: a QTIP deduction was allowed on the transfer to the decedent (section 2056(b)(7) or 2523(f)) and section 2519 did not apply to a disposition by the decedent (section 2044(b))";
}
rule Section2044AppliesByEstateDeductionRule(e: Estate, item: Asset) defeasible {
    when qtip_deduction_allowed_2056b7_for_transfer_to_decedent(e, item);
    when not_known(section_2519_applied_to_decedent_disposition(e, item));
    then section_2044_applies_to_property(e, item);
}
rule Section2044AppliesByGiftDeductionRule(e: Estate, item: Asset) defeasible {
    when qtip_deduction_allowed_2523f_for_transfer_to_decedent(e, item);
    when not_known(section_2519_applied_to_decedent_disposition(e, item));
    then section_2044_applies_to_property(e, item);
}
@source(IRC_S2044_A, relation = formalizes, coverage = exact, quote = "The value of the gross estate shall include the value of any property to which this section applies in which the decedent had a qualifying income interest for life.")
rule GrossEstateItemUnder2044Rule(e: Estate, item: Asset, amount: Money) defeasible {
    label en official "the gross estate includes property to which section 2044 applies in which the decedent had a qualifying income interest for life (section 2044(a))";
    when section_2044_applies_to_property(e, item);
    when decedent_qualifying_income_interest_for_life(e, item);
    when value_at_death(e, item, amount);
    when not_known(alternate_valuation_elected(e));
    then gross_estate_item(e, item, amount);
}
@source(IRC_S2044_C, relation = formalizes, coverage = exact, quote = "property includible in the gross estate of the decedent under subsection (a) shall be treated as property passing from the decedent")
pub relation property_included_under_2044_treated_as_passing_from_decedent(e: Estate, item: Asset) kind institutional {
    label en official "for purposes of chapters 11 and 13, property includible under section 2044(a) is property passing from the decedent (section 2044(c))";
}
rule PropertyIncludedUnder2044TreatedAsPassingRule(e: Estate, item: Asset) defeasible {
    when section_2044_applies_to_property(e, item);
    when decedent_qualifying_income_interest_for_life(e, item);
    then property_included_under_2044_treated_as_passing_from_decedent(e, item);
}
rule InterestPassesFromDecedentBy2044cRule(e: Estate, item: Asset, recipient: Person) defeasible {
    label en official "chapter 11 reads section 2044(c): property so included passes from the decedent to those who take it (section 2056(c) in this estate)";
    when property_included_under_2044_treated_as_passing_from_decedent(e, item);
    when section_2044_property_recipient(e, item, recipient);
    then interest_passes_from_decedent(e, item, recipient);
}

// --- §2045: "whenever made" -------------------------------------------------
// Nothing to state positively: no rule of sections 2034-2042 in this package
// tests the date of a transfer. Scenario S2045-01 pins that a 1935 transfer
// with a retained life estate is included.
