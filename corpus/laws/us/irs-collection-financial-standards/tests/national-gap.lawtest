language "law.core" version "0.2";
package us.irs.collection_financial_standards version "0.1.1";
namespace "urn:us:irs:collection_financial_standards:clir";

test "IRS-G01 filing between pinned windows yields neither" {
    given {
        context {
            legal_time @2025-08-01; decision_time @2025-08-01T09:00:00-05:00;
            knowledge_time @2025-08-01T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": case_filed_on(entity_ref("urn:test:irs:g01#case"), @2025-08-01) { origin case_input; }
        assert "f1": filing_household_size(entity_ref("urn:test:irs:g01#case"), "2") { origin case_input; }
    }
    evaluate truth(national_standard(entity_ref("urn:test:irs:g01#case"), "food", 863 USD));
    expect truth_status == NEITHER;
}

test "IRS-G02 additional-person amount, window B" {
    given {
        context {
            legal_time @2025-12-01; decision_time @2025-12-01T09:00:00-05:00;
            knowledge_time @2025-12-01T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": case_filed_on(entity_ref("urn:test:irs:g02#case"), @2025-12-01) { origin case_input; }
        assert "f1": filing_household_size(entity_ref("urn:test:irs:g02#case"), "4") { origin case_input; }
        assert "a1": "urn:us:irs:collection_financial_standards:table:national-20251101/input"("additional_person", "0") { origin case_input; }
    }
    evaluate truth(national_standard(entity_ref("urn:test:irs:g02#case"), "additional_person", 394 USD));
    expect truth_status == TRUE_ONLY;
}
