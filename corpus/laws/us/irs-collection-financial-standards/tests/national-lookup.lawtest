language "law.core" version "0.2";
package us.irs.collection_financial_standards version "0.1.1";
namespace "urn:us:irs:collection_financial_standards:clir";

test "IRS-N01 food allowance, family of four, window B" {
    given {
        context {
            legal_time @2025-12-01; decision_time @2025-12-01T09:00:00-05:00;
            knowledge_time @2025-12-01T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": case_filed_on(entity_ref("urn:test:irs:n01#case"), @2025-12-01) { origin case_input; }
        assert "f1": filing_household_size(entity_ref("urn:test:irs:n01#case"), "4") { origin case_input; }
        assert "a1": "urn:us:irs:collection_financial_standards:table:national-20251101/input"("food", "4") { origin case_input; }
        assert "a2": "urn:us:irs:collection_financial_standards:table:national-20251101/input"("total", "4") { origin case_input; }
    }
    evaluate truth(national_standard(entity_ref("urn:test:irs:n01#case"), "food", 1255 USD));
    expect truth_status == TRUE_ONLY;
}

test "IRS-N02 total allowance, one person, window A" {
    given {
        context {
            legal_time @2025-04-10; decision_time @2025-04-10T09:00:00-05:00;
            knowledge_time @2025-04-10T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": case_filed_on(entity_ref("urn:test:irs:n02#case"), @2025-04-10) { origin case_input; }
        assert "f1": filing_household_size(entity_ref("urn:test:irs:n02#case"), "1") { origin case_input; }
        assert "a1": "urn:us:irs:collection_financial_standards:table:national-20250401/input"("total", "1") { origin case_input; }
    }
    evaluate truth(national_standard(entity_ref("urn:test:irs:n02#case"), "total", 808 USD));
    expect truth_status == TRUE_ONLY;
}

test "IRS-N03 out-of-pocket under 65, window B" {
    given {
        context {
            legal_time @2026-01-15; decision_time @2026-01-15T09:00:00-05:00;
            knowledge_time @2026-01-15T09:00:00-05:00; timezone "America/New_York";
        }
        assert "f0": case_filed_on(entity_ref("urn:test:irs:n03#case"), @2026-01-15) { origin case_input; }
        assert "a1": "urn:us:irs:collection_financial_standards:table:oop-20251101/input"("under_65", "0") { origin case_input; }
    }
    evaluate truth(oop_healthcare(entity_ref("urn:test:irs:n03#case"), "under_65", 84 USD));
    expect truth_status == TRUE_ONLY;
}
