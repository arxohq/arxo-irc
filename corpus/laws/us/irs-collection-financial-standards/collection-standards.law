// IRS Collection Financial Standards — owner of the National Standards and
// out-of-pocket health care tables used by 11 U.S.C. 707(b)(2)(A)(ii)(I) (U-22).
//
// WHY THIS PACKAGE EXISTS. The means test deducts the debtor's applicable
// monthly expense amounts under the IRS National Standards by household
// size, plus out-of-pocket health care by age group. The amounts are keyed
// by (category, household size) and versioned by filing window, so the U-01
// facade cannot serve them. Values live ONLY here
// (tables/national-*.lawtable.json, tables/oop-*.lawtable.json); readers
// take sums from the pub relations below.
//
// WINDOWS mirror the UST pages that reproduce the IRS data: window A cases
// filed 2025-04-01 through 2025-05-14 inclusive; window B cases filed
// 2025-11-01 through 2026-03-31 inclusive. Local Standards (housing,
// utilities, transportation by county/FIPS) are pinned as bytes on the UST
// pages but NOT modeled: county-level lookup is BOUNDARY (see README).

language "law.core" version "0.2";
package us.irs.collection_financial_standards version "0.1.1";
namespace "urn:us:irs:collection_financial_standards:clir";

use self::{
    IRS_NATIONAL_20250401,
    IRS_NATIONAL_20251101,
    IRS_OOP_20250401,
    IRS_OOP_20251101,
};

pub entity MeansTestFiling {
    label en official "individual bankruptcy case needing an IRS standards lookup (11 U.S.C. 707(b)(2)(A)(ii))";
}

pub relation case_filed_on(filing: MeansTestFiling, day: Date) kind empirical {
    label en official "petition filing date: selects the IRS standards window";
}

pub relation filing_household_size(filing: MeansTestFiling, size: Text) kind empirical {
    label en official "household size for the National Standards lookup: one of 1, 2, 3, 4";
}

pub relation national_standard(filing: MeansTestFiling, category: Text, amount: Money) kind derived {
    label en official "IRS National Standard monthly allowance for the category and household size in the filing window";
}

pub relation oop_healthcare(filing: MeansTestFiling, age_group: Text, amount: Money) kind derived {
    label en official "IRS out-of-pocket health care monthly allowance per person in the filing window";
}

relation national_cell_w20250401(category: Text, household: Text, amount: Money) kind derived {
    label en official "April 2025 window National Standards cell (from tables/national-20250401.lawtable.json)";
}

relation national_cell_w20251101(category: Text, household: Text, amount: Money) kind derived {
    label en official "November 2025 window National Standards cell (from tables/national-20251101.lawtable.json)";
}

relation oop_cell_w20250401(age_group: Text, unused: Text, amount: Money) kind derived {
    label en official "April 2025 window out-of-pocket cell (from tables/oop-20250401.lawtable.json)";
}

relation oop_cell_w20251101(age_group: Text, unused: Text, amount: Money) kind derived {
    label en official "November 2025 window out-of-pocket cell (from tables/oop-20251101.lawtable.json)";
}

@source(IRS_NATIONAL_20250401)
rule NationalWindowA strict {
    label en official "National Standards lookup for cases filed April 1, 2025 through May 14, 2025";
    for f: MeansTestFiling;
    for cat: Text;
    for hh: Text;
    for filed: Date;
    for amt: Money;
    when case_filed_on(f, filed);
    when filing_household_size(f, hh);
    when days_between(@2025-04-01, filed) >= 0;
    when days_between(filed, @2025-05-14) >= 0;
    when national_cell_w20250401(cat, hh, amt);
    then national_standard(f, cat, amt);
}

@source(IRS_NATIONAL_20251101)
rule NationalWindowB strict {
    label en official "National Standards lookup for cases filed November 1, 2025 through March 31, 2026";
    for f: MeansTestFiling;
    for cat: Text;
    for hh: Text;
    for filed: Date;
    for amt: Money;
    when case_filed_on(f, filed);
    when filing_household_size(f, hh);
    when days_between(@2025-11-01, filed) >= 0;
    when days_between(filed, @2026-03-31) >= 0;
    when national_cell_w20251101(cat, hh, amt);
    then national_standard(f, cat, amt);
}

@source(IRS_NATIONAL_20250401)
rule NationalAdditionalA strict {
    label en official "additional-person amount for cases filed April 1, 2025 through May 14, 2025";
    for f: MeansTestFiling;
    for filed: Date;
    for amt: Money;
    when case_filed_on(f, filed);
    when days_between(@2025-04-01, filed) >= 0;
    when days_between(filed, @2025-05-14) >= 0;
    when national_cell_w20250401("additional_person", "0", amt);
    then national_standard(f, "additional_person", amt);
}

@source(IRS_NATIONAL_20251101)
rule NationalAdditionalB strict {
    label en official "additional-person amount for cases filed November 1, 2025 through March 31, 2026";
    for f: MeansTestFiling;
    for filed: Date;
    for amt: Money;
    when case_filed_on(f, filed);
    when days_between(@2025-11-01, filed) >= 0;
    when days_between(filed, @2026-03-31) >= 0;
    when national_cell_w20251101("additional_person", "0", amt);
    then national_standard(f, "additional_person", amt);
}

@source(IRS_OOP_20250401)
rule OopWindowA strict {
    label en official "out-of-pocket lookup for cases filed April 1, 2025 through May 14, 2025";
    for f: MeansTestFiling;
    for grp: Text;
    for filed: Date;
    for amt: Money;
    when case_filed_on(f, filed);
    when days_between(@2025-04-01, filed) >= 0;
    when days_between(filed, @2025-05-14) >= 0;
    when oop_cell_w20250401(grp, "0", amt);
    then oop_healthcare(f, grp, amt);
}

@source(IRS_OOP_20251101)
rule OopWindowB strict {
    label en official "out-of-pocket lookup for cases filed November 1, 2025 through March 31, 2026";
    for f: MeansTestFiling;
    for grp: Text;
    for filed: Date;
    for amt: Money;
    when case_filed_on(f, filed);
    when days_between(@2025-11-01, filed) >= 0;
    when days_between(filed, @2026-03-31) >= 0;
    when oop_cell_w20251101(grp, "0", amt);
    then oop_healthcare(f, grp, amt);
}
