pub fragment RP8756_00_11 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/00.11";
    text en official """00.11 Office Furniture, Fixtures, and Equipment:
         Includes furniture and fixtures that are not a structural component of a building. Includes
         such assets as desks, files, safes, and communications       equipment. Does not include
         communications equipment that is included in other classes                                                        10                                 10""";
    content_hash "sha256:f379749e6a4672781cf5cfcf73b6f5137a4f839da6524905e7f5b7eb5c96e86e";
    label en official "Rev. Proc. 87-56 asset class 00.11: Office Furniture, Fixtures, and Equipment:";
}

pub fragment RP8756_00_12 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/00.12";
    text en official """00.12    Information Systems:
         Includes computers and their peripheral equipment used in administering normal business
         transactions and the maintenance        of business records, their retrieval and analysis.
          Information systems are defined as:
          1) Computers: A computer is a programmable electronically activated device capable of
          accepting information, applying prescribed processes to the information, and supplying
          the results of these processes with or without human intervention. It usually consists of a
          central processing unit containing      extensive storage, logic, arithmetic,        and control
         capabilities. Excluded from this category are adding machines, electronic desk calculators,
         etc. , and other equipment described in class 00. 13.
         2) Peripheral equipment consists of the auxiliary machines which are designed to be
         placed under control of the central processing unit. Nonlimiting examples are: Card
         readers, card punches, magnetic tape feeds, high speed printers, optical character readers,
         tape cassettes, mass storage units, paper tape equipment, keypunches, data entry devices,
         teleprinters,  terminals, tape drives, disc drives, disc files, disc packs, visual image
         projector tubes, card sorters, plotters, and collators. Peripheral equipment may be used
         on-line or off-line.
         Does not include equipment that is an integral part of other capital equipment that is
         included in other classes of economic activity, i.e. , computers used primarily for process
         or production control, switching, channeling, and automating distributive trades and
         services such as point of sale (POS) computer systems. Also, does not include equipment
         of a kind used primarily for amusement or entertainment of the user. . . . . . . . . . . . . . . . . . .""";
    content_hash "sha256:c621a3a6d8e169065bba8a8eae9e18404f6ed9a2c7de675f9f41d7cdadc8fa12";
    label en official "Rev. Proc. 87-56 asset class 00.12: Information Systems:";
}

pub fragment RP8756_00_13 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/00.13";
    text en official """00.13    Data Handling Equipment, except Computers:
         Includes only typewriters, calculators, adding and accounting machines, copiers, and
         duplicating equipment.""";
    content_hash "sha256:c074434c5857c68bd84626a2a5d4066e51493de615015df4a68eafea128df9a8";
    label en official "Rev. Proc. 87-56 asset class 00.13: Data Handling Equipment, except Computers:";
}

