}

pub fragment RP8756_48_37 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.37";
    text en official """ 48.37     TOCSC-Satellite Space Segment Property:
           Includes satellites and equipment used for telemetry, tracking, control, and monttoring
           when used in satellite communications""";
    content_hash "sha256:744496e35487bb817321453aa029714c4e9f7bf2daf02ab97d990b5ab76e71ad";
    label en official "Rev. Proc. 87-56 asset class 48.37: TOCSC-Satellite Space Segment Property:";
}

pub fragment RP8756_48_38 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.38";
    text en official """ 48.38     TOCSC-Equipment Installed on Customer's Premises:
           Includes assets installed on customer's premises, such as computers, terminal equtpment,
           power generation and distribution systems, private switching center, teleprinters, facsimile
           equipment, and other associated and related equipment .                                                         10                              10""";
    content_hash "sha256:a5c7240e8e2117289c5e2b476a6572ec833794f31bd58cd7e1f2321866bdf9a2";
    label en official "Rev. Proc. 87-56 asset class 48.38: TOCSC-Equipment Installed on Customer's Premises:";
}

pub fragment RP8756_48_39 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.39";
    text en official """ 48.39     TOCSC-Support and Service Equipment:
           Includes assets used to support but not engage in communications.            Includes store,
           warehouse and shop tools, and test and laboratory assets.                                                       13.5                            13.5
           Cable Television (CATV):
           Includes communications-related     assets used to provide cable televtsion communtty
           antenna television services). Does not include assets used to provide subscribers with
           two-way communications services.""";
    content_hash "sha256:a852e9b664a170b662d4bf3c52b00bb0b967b855a88e456494d1a2fba3ee0079";
    label en official "Rev. Proc. 87-56 asset class 48.39: TOCSC-Support and Service Equipment:";
}

pub fragment RP8756_48_41 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.41";
    text en official """ 48.41     CATV-Headend:
           Includes   assets such as towers, antennas,        preamplifiers, converters,    modulation
           equipment, and program non-duplication      systems. Does not include headend buildings
           and program origination assets""";
    content_hash "sha256:9e86ea3baf96c590d1138f7e29549d037bc7ff3a09feebf49cac0c05e607e014";
    label en official "Rev. Proc. 87-56 asset class 48.41: CATV-Headend:";
}

pub fragment RP8756_48_42 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.42";
    text en official """ 48.42     CATV-Subscriber Connection and Distribution Systems:
           Includes assets such as trunk and feeder cable, connecting hardware, amplifiers, power
           equipment,    passive devices, directional taps, pedestals, pressure taps, drop cables,
           matching transformers, multiple set connector equipment, and converters. . . . . . . . . . . . . . .            10                              10""";
    content_hash "sha256:5e602f61d4df7ea2bdda1b669d71d8bdaaabfa85c0cc8a599854988a7b858b90";
    label en official "Rev. Proc. 87-56 asset class 48.42: CATV-Subscriber Connection and Distribution Systems:";
}

pub fragment RP8756_48_43 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.43";
    text en official """ 48.43     CATV-Program Origination:
           Includes assets such as cameras, film chains, video tape recorders, lighting, and remote
           location equipment excluding vehicles. Does not include buildings and their structural
           components.""";
    content_hash "sha256:a590e23756fee2a60a83093afca80d76e7cdd7c76a3d86a7d90aa4759cf4b8fd";
    label en official "Rev. Proc. 87-56 asset class 48.43: CATV-Program Origination:";
}

pub fragment RP8756_48_44 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.44";
    text en official """ 48.44     CATV-Service and Test:
           Includes assets such as oscilloscopes, field strength meters, spectrum analyzers,          and cable
           testing equipment, but does not include vehicles                                                                 8.5                             8.5""";
    content_hash "sha256:d2f2243cdc6751374ea2b7927f7285703e368bf0c1d0b38b36ab7a768dfeff7b";
    label en official "Rev. Proc. 87-56 asset class 48.44: CATV-Service and Test:";
}

pub fragment RP8756_48_45 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.45";
    text en official """ 48.45 CATV-Microwave Systems:
           Includes assets such as towers, antennas, transmitting and receiving equipment, and broad
           band microwave assets if used in the provision of cable television services. Does not
           include assets used in the provision of common carrier services.                                                 9.5                             9.5
           Electric, Gas, Water and Steam, Utility Services:
           Includes assets used in the production, transmission and distribution of electricity, gas,
           steam, or water for sale including related land improvements.""";
    content_hash "sha256:a5b6202f79502bc0906da8225fc8c883f4a1c0cc13827529a9746bcdd90b6fd7";
    label en official "Rev. Proc. 87-56 asset class 48.45: CATV-Microwave Systems:";
}

pub fragment RP8756_49_11 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/49.11";
    text en official """ 49. 11 Electric Utility Hydraulic Production Plant:
           Includes assets used in the hydraulic power production of electricity for sale, including
           related land improvements, such as dams, flumes, canals, and waterways. . . . . . . . . . . . . . .             50          20                 50""";
    content_hash "sha256:c89a9a4ff543bafeaee2dc8e1a1f09145c28eb4d2d1ddfee3fd6906756b3ce67";
    label en official "Rev. Proc. 87-56 asset class 49.11: 11 Electric Utility Hydraulic Production Plant:";
}

pub fragment RP8756_49_12 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/49.12";
    text en official """ 49.12 Electric Utility Nuclear Production Plant:
           Includes assets used in the nuclear power production and electricity for sale and related
           land improvements. Does not include nuclear fuel assemblies.                                                    20          15                 20""";
    content_hash "sha256:d5e1f3eb925d272d1b98b7cb3ed054e3f72b2932925b6a01a4fb3daf25bef47f";
    label en official "Rev. Proc. 87-56 asset class 49.12: Electric Utility Nuclear Production Plant:";
}

pub fragment RP8756_49_121 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/49.121";
    text en official """ 49. 121 Electric Utility Nuclear Fuel Assemblies:
           Includes initial core and replacement core nuclear fuel assemblies (i.e. , the composite of
           fabricated nuclear fuel and container) when used in a boiling water, pressurized water, or
          high temperature     gas reactor used in the production of electricity. Does not include
          nuclear fuel assemblies used in breeder reactors""";
    content_hash "sha256:a5783a2c919685a446dc1eddb918382d053d88ac86c93f00510d6a5713c59fd1";
    label en official "Rev. Proc. 87-56 asset class 49.121: 121 Electric Utility Nuclear Fuel Assemblies:";
}

pub fragment RP8756_49_13 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/49.13";
    text en official """ 49.13 Electric Utility Steam Production Plant:
          Includes assets used in the steam power production of electricity for sale, combustion
          turbines operated in a combined cycle with a conventional steam unit and related land
          improvements. Also includes package boilers, electric generators and related assets such as
          electricity and steam distribution systems as used by a waste reduction and resource
          recovery plant if the steam or electricity is normally for sale to others. . . . . . . . . , . . . , . . . .     28          20                 28""";
    content_hash "sha256:073c79a700fcf16655dce8afb54e423961f7249bc048ea12d3466ff18602109e";
    label en official "Rev. Proc. 87-56 asset class 49.13: Electric Utility Steam Production Plant:";
}

pub fragment RP8756_49_14 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/49.14";
    text en official """49.14 Electric Utility Transmission and Distribution Plant:
         Includes assets used in the transmission and distribution of electricity for sale and related
         land improvements.      Excludes initial clearing and grading land improvements as specified
         in Rev. Rul. 72-403, 1972-2 C. B. 102.                                                                            30          20                 30""";
    content_hash "sha256:31678ea019d122403e589ab81c984fe8a9cfefe50eef3da2ca94c1fa852fc6e8";
    label en official "Rev. Proc. 87-56 asset class 49.14: Electric Utility Transmission and Distribution Plant:";
}

pub fragment RP8756_49_15 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/49.15";
    text en official """49. 15 Electric Utility Combustion Turbine Production Plant:
         Includes assets used in the production of electricity for sale by the use of such prime
         movers as jet engines, combustion turbines, diesel engines, gasoline engines, and other
         internal combustion engines, their associated power turbines and/or generators, and
         related land improvements. Does not include combustion turbines operated in a combined
         cycle with a conventional steam unit                                                                              20          15                 20""";
    content_hash "sha256:62c4bd880f902e83bbb6bab2446d387f0344f139635befec7b256631d824dac5";
    label en official "Rev. Proc. 87-56 asset class 49.15: 15 Electric Utility Combustion Turbine Production Plant:";
}

