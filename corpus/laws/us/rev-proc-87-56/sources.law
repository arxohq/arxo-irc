pub fragment RP8756_41_0 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/41.0";
    text en official """41.0     Motor Transport-Passengers:
         Includes assets used in the urban and interurban commercial and contract carrying of
         passengers by road, except the transportation assets included in classes with the prefix
         00, 2""";
    content_hash "sha256:f4ed00bc21d4ddee0edbfd4a92f317ead862fffc3925813866d91fdac453470a";
    label en official "Rev. Proc. 87-56 asset class 41.0: Motor Transport-Passengers:";
}

pub fragment RP8756_42_0 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/42.0";
    text en official """42.0     Motor Transport-Freight:
         Includes assets used in the commercial and contract carrying of freight by road, except
         the transportation assets included in classes with the prefix 00.2""";
    content_hash "sha256:a77740dc8d446b9334063e3e8aa6fd80b016d9b134f5689140e70ba5c05b190c";
    label en official "Rev. Proc. 87-56 asset class 42.0: Motor Transport-Freight:";
}

pub fragment RP8756_44_0 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/44.0";
    text en official """44. 0    Water Transportation:
          Includes assets used in the commercial and contract carrying of freight and passengers by
          water except the transportation assets included in classes with the prefix 00.2. Includes all
          related land improvements.                                                                       20           15                 20""";
    content_hash "sha256:c82631bd4adbeffeaeba24c0b185f1a587359b39f2698830077c599f89e8bbf3";
    label en official "Rev. Proc. 87-56 asset class 44.0: 0    Water Transportation:";
}

pub fragment RP8756_45_0 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/45.0";
    text en official """45.0      Air Transport:
          Includes assets (except helicopters) used in commercial           and contract carrying of
          passengers and freight by air. For purposes of section 1.167(a)-II(d)(2)(iv)(a) of the
          regulations, expenditures for "repair, maintenance, rehabilitation, or improvement" shall
          consist of direct maintenance expenses (irrespective of airworthiness provisions or charges)
          as defined by Civil Aeronautics Board uniform accounts 5200, maintenance              burden
         (exclusive of expenses pertaining to maintenance buildings and improvements) as defined
         by Civil Aeronautics Board uniform accounts 5300, and expenditures             which are not
         "excluded additions" as defined in section 1.167(a)-ll(d)(2)(vi) of the regulations and
         which would be charged to property and equipment accounts in the Civil Aeronautics
         Board uniform system of accounts.                                                                  12                              12""";
    content_hash "sha256:23d82e0b57eccf8595d8d81c3c996cd87b176d6733d12cd27ed8f22c47596f01";
    label en official "Rev. Proc. 87-56 asset class 45.0: Air Transport:";
}

