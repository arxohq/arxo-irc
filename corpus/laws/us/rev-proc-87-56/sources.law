    kind table;
    locator "rev-proc/87-56/asset-class/49.21";
    text en official """49.21 Gas Utility Distribution Facilities:
         Includes gas water heaters and gas conversion equipment installed by utility on customers'
         premises on a rental basis                                                                                        35          20                  35

