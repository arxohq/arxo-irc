}

pub fragment RP8756_48_121 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.121";
    text en official """ 48. 121 Computer-based Telephone Central Office Switching Equipment:
           Includes equipment whose functions are those of a computer or peripheral equipment (as
          defined in section 168(i)(2)(B) of the Code) used in its capacity as telephone central office
          equipment. Does not include private branch exchange (PBX) equipment. . . . . . . . . . . . . . . .                                9.5                                 9.5""";
    content_hash "sha256:0f392695446f677e14710b1c5785d6defe5441bf527872d3ecd85eb864533e2a";
    label en official "Rev. Proc. 87-56 asset class 48.121: 121 Computer-based Telephone Central Office Switching Equipment:";
}

pub fragment RP8756_48_13 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.13";
    text en official """ 48. 13 Telephone Station Equipment:
          Includes such station apparatus and connections as teletypewriters,                                   telephones, booths,
          private exchanges, and comparable equipment as defined in Federal Communications
          Commission Part 31 Account Nos. 231, 232, and 234 .                                                                              10                                  10*""";
    content_hash "sha256:fdd5aad6ae39285f1ccf8898a8d88d51be289a21a15fbf658e09acc885cfa60d";
    label en official "Rev. Proc. 87-56 asset class 48.13: 13 Telephone Station Equipment:";
}

pub fragment RP8756_48_14 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.14";
    text en official """ 48. 14 Telephone Distribution Plant:
          Includes such assets as pole lines, cable, aerial wire, underground                                         conduits, and
          comparable       equipment,             and related                land improvements           as defined      in Federal
          Communications Commission Part 31 Account Nos. 241, 242. 1, 242, 2, 242. 3, 242. 4, 243,
          and 244 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .                                                  24                15                24""";
    content_hash "sha256:3644aa55c7808a9f59147b1755965b63cd0a17252fe227dd7be6ed449e21d07d";
    label en official "Rev. Proc. 87-56 asset class 48.14: 14 Telephone Distribution Plant:";
}

pub fragment RP8756_48_2 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.2";
    text en official """ 48.2     Radio and Television Broadcastings:
          Includes assets used in radio and television broadcasting, except transmitting towers . . . . .
          Telegraph,       Ocean           Cable,           and         Satellite         Communications       (TOCSC) includes
          communications-related              assets used to provide domestic and international radio-telegraph,
          wire-telegraph,      ocean-cable, and satellite communications services; also includes related
          land improvements.                                                                     —
                                         If property described in Classes 48. 31 48.45 is comparable to
          telephone distribution plant described in Class 48. 14 and used for 2-way exchange of
          voice and data communication which is the equivalent of telephone communication, such
          property is assigned a class life of 24 years under this revenue procedure. Comparable
          equipment     does not include cable television equipment                                   used primarily      for I-way
          communication.""";
    content_hash "sha256:c2d95f5e18778f9c5d4d64cc9258bbeb6bcc47ef0dc798f99781ed44ec4b97da";
    label en official "Rev. Proc. 87-56 asset class 48.2: Radio and Television Broadcastings:";
}

pub fragment RP8756_48_31 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.31";
    text en official """48.31 TOCSC-Electric Power Generating and Distribution Systems:
          Includes assets used in the provision of electric power by generation, modulation,
          rectification, channelization, control, and distribution, Does not include these assets when
          they are installed on customers premises.                                                                                         19               10                19""";
    content_hash "sha256:205aa8304458f020573d44cca7322804c85f063ef2c20f7a607dae3f43263f4e";
    label en official "Rev. Proc. 87-56 asset class 48.31: TOCSC-Electric Power Generating and Distribution Systems:";
}

pub fragment RP8756_48_32 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.32";
    text en official """48.32 TOCSC-High Frequency Radio and Microwave Systems:
          Includes assets such as transmitters                             and receivers, antenna           supporting     structures,
         antennas, transmission lines from equipment to antenna, transmitter cooling systems, and
         control and amplification equipment. Does not include cable and long-line systems . . . . . .                                      13                                 13""";
    content_hash "sha256:d1364efcab3a13bab9c10fc10e48a1afe5bd424a00a1ee7d6145fdc95150ccf4";
    label en official "Rev. Proc. 87-56 asset class 48.32: TOCSC-High Frequency Radio and Microwave Systems:";
}

pub fragment RP8756_48_33 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.33";
    text en official """48.33 TOCSC-Cable and Long-line Systems:
         Includes assets such as transmission lines, pole lines, ocean cables, buried cable and
         conduit, repeaters, repeater stations, and other related assets. Does not include high
         frequency radio or microwave systems                                                                                              26. 5             20                26. 5""";
    content_hash "sha256:edaf60ab93ca8a4f816dd467287b5e229f550a232a3ac340610f7de4e33900ff";
    label en official "Rev. Proc. 87-56 asset class 48.33: TOCSC-Cable and Long-line Systems:";
}

pub fragment RP8756_48_34 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.34";
    text en official """48.34 TOCSC-Central Office Control Equipment:
         Includes assets for general control, switching, and monitoring of communications signals
         including electromechanical switching and channeling apparatus, multiplexing equipment,
         patching and monitoring facilities, in-house cabling, teleprinter equipment, and associated
         site improvemeents                                                                                                                 16.5             10                16.5""";
    content_hash "sha256:c6b04c6e8f6b531842e7bbf0319621a99301eabca1ff61c0d138c7c489ddac40";
    label en official "Rev. Proc. 87-56 asset class 48.34: TOCSC-Central Office Control Equipment:";
}

