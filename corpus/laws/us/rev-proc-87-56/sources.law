}

pub fragment RP8756_48_12 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.12";
    text en official """ 48.12 Telephone Central Office Equipment:
            Includes   central office switching                        and related equipment              as defined in Federal
            Communications Commission Part 31 Account No. 221
            Does not include computer-based telephone central office switching equipment included in
            class 48. 121. Does not include private branch exchange (PBX) equipment. . . . . . . . . . . . . . .                            18               10                 18""";
    content_hash "sha256:ef7705b5490b49a80a6cef71e9b2ec10a90a25c24d1f17bfc0488956567deb4e";
