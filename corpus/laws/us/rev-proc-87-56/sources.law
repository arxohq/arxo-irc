pub fragment RP8756_48_11 in RP8756_CB_TEXT {
    kind table;
    locator "rev-proc/87-56/asset-class/48.11";
    text en official """ 48. 11 Telephone Central Office Buildings:
            Includes assets intended to house central office equipment,                                    as defined in Federal
            Communications Commission Part 31 Account No. 212 whether section 1245 or section
            1250 property                                                                                                                   45               20                 45""";
