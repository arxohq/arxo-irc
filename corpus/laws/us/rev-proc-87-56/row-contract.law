// Public signature of the existing rp8756-life decision-table emission.
// The declaration supplies no rows, defaults, or case-selected asset class.
// Values still come exclusively from the pinned decision table.
pub relation class_life_row(asset_class: Text, sub: Text, life: Decimal) kind institutional {
    label en unofficial "class life emitted by the pinned Rev. Proc. 87-56 table for the selected class and sub-row";
}
