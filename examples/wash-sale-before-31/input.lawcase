language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

case ReaderExample {
 context { legal_time @2025-06-30; decision_time @2025-06-30T13:00:00Z; knowledge_time @2025-06-30T13:00:00Z; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
 assert "f0": us.irc.property_transactions::loss_claimed_on_sale_of_stock_or_securities(entity_ref("urn:irc:example:transaction"), entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:old"), @2025-03-01, 2000 USD) { origin case_input; }
 assert "f1": us.irc.property_transactions::acquired_substantially_identical_stock_or_securities(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:old"), entity_ref("urn:irc:example:new"), @2025-01-29) { origin case_input; }
 assert "f2": us.irc.property_transactions::quantity_acquired_not_less_than_quantity_sold(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:old")) { origin case_input; }
 assert "f3": us.irc.core::adjusted_basis(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:old"), @2025-03-01, 8000 USD) { origin case_input; }
 assert "f4": us.irc.property_transactions::stock_disposition_price_1091(entity_ref("urn:irc:example:transaction"), 6000 USD) { origin case_input; }
 assert "f5": us.irc.property_transactions::replacement_acquisition_price_1091(entity_ref("urn:irc:example:transaction"), entity_ref("urn:irc:example:new"), @2025-03-15, 5000 USD) { origin case_input; }
}
