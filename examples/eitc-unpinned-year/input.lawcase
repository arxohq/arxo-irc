language "law.core" version "0.2";
package us.irc.credits version "0.1.1";
namespace "urn:us:irc:credits:clir";

case ReaderExample {
 context { legal_time @2030-06-30; decision_time @2030-06-30T13:00:00Z; knowledge_time @2030-06-30T13:00:00Z; timezone "America/New_York"; }
 assert "f0": us.irc.credits::qualifying_child_roster_complete_32(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year")) { origin case_input; }
 assert "f1": us.irc.credits::disqualified_interest_dividends_32i2A(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 1000 USD) { origin case_input; }
