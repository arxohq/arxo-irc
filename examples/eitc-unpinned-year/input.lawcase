 assert "f3": us.irc.credits::disqualified_rent_royalty_excess_32i2C(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 0 USD) { origin case_input; }
 assert "f4": us.irc.property_transactions::capital_gain_net_income(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 2000 USD) { origin case_input; }
 assert "f5": us.irc.credits::disqualified_passive_excess_32i2E(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 0 USD) { origin case_input; }
 assert "f6": us.irc.income_individual::filing_status(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), us.irc.income_individual::Joint) { origin case_input; }
 assert "f7": us.irc.credits::eic_eligible_individual(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year")) { origin case_input; }
 assert "f8": us.irc.credits::earned_income_credit_qualifying_child(entity_ref("urn:irc:example:child1"), entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year")) { origin case_input; }
 assert "f9": us.irc.credits::earned_income_credit_qualifying_child(entity_ref("urn:irc:example:child2"), entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year")) { origin case_input; }
 assert "f10": us.irc.credits::earned_income_32(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 32000 USD) { origin case_input; }
 assert "f11": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 35000 USD) { origin case_input; }
 assert "f12": not us.irc.credits::in_disallowance_period_32k(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year")) { origin case_input; }
 assert "f13": not us.irc.credits::short_taxable_year_under_12_months_32(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year")) { origin case_input; }
