language "law.core" version "0.2";
package us.irc.property_transactions version "0.1.1";
namespace "urn:us:irc:property_transactions:clir";

case ReaderExample {
 context { legal_time @2025-06-30; decision_time @2025-06-30T13:00:00Z; knowledge_time @2025-06-30T13:00:00Z; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
 assert "f0": us.irc.property_transactions::qualified_securities_sold(entity_ref("urn:irc:example:securities-sale"), entity_ref("urn:irc:example:seller"), entity_ref("urn:irc:example:corporation"), 10000 USD, @2025-06-30) { origin case_input; }
 assert "f1": us.irc.core::civil_calendar_boundary_before(@2025-06-30, 3, us.irc.core::CalendarMonth, @2025-03-30) { origin case_input; }
}
