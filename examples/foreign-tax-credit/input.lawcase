language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

case ReaderExample {
 context { legal_time @2025-06-30; decision_time @2025-06-30T13:00:00Z; knowledge_time @2025-06-30T13:00:00Z; timezone "America/New_York"; }
 assert "f0": us.irc.international::citizen_of_us_or_domestic_corporation(entity_ref("urn:irc:example:taxpayer")) { origin case_input; }
 assert "f1": us.irc.international::foreign_tax_credit_regime_elected(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year")) { origin case_input; }
 assert "f2": us.irc.international::foreign_tax_paid_or_accrued(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 28000 USD) { origin case_input; }
 assert "f3": us.irc.international::us_tax_before_credit_input(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 30000 USD) { origin case_input; }
 assert "f4": us.irc.international::foreign_source_taxable_income_input(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 120000 USD) { origin case_input; }
 assert "f5": us.irc.international::worldwide_taxable_income_input(entity_ref("urn:irc:example:taxpayer"), entity_ref("urn:irc:example:year"), 160000 USD) { origin case_input; }
}
